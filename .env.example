# Copy this file to .env (already gitignored) and fill in real values before running
# `docker compose up`. Never commit the actual .env file.

# Signing key for the JWTs Orbit.Api issues on login/register. Must be a long, random string (at
# least 32 characters - it's used as an HMAC-SHA256 key). Generate one with, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-string-at-least-32-characters

# Every permission unlock code is derived from this (see Orbit.Core.Permissions.PermissionCodeAuthority).
# Optional locally: left unset, the API generates one on each start and logs the four codes. In the
# deployed environment the release workflow generates it and prints the codes in its run summary.
ORBIT_PERMISSION_SECRET=

# Password for the local "postgres" container's own admin user - required, docker-compose.yml refuses
# to start without it rather than falling back to a fixed, tracked default (port 5432 is published on
# the host, see docker-compose.yml's port mapping, so a hardcoded password here would be a real
# credential exposed to anything else on the same network, not just this machine). Generate one with:
#   openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-a-random-string
# Optional: only needed to change the local database/user names away from their "orbit" defaults.
POSTGRES_DB=
POSTGRES_USER=

# SMTP server Orbit.Api uses to send calendar event reminder emails (see README.md's "Calendar event
# reminders" section). Optional: leave these unset to run without email delivery - reminders are then
# just logged as a warning instead of sent, so the rest of the app still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# VAPID (RFC 8292) key pair Orbit.Api uses to send push notifications (see README.md's "Push
# notifications" section). Optional: leave these unset to run without push delivery - notifications are
# then just logged as a warning instead of sent, so the rest of the app still works. Generate a key pair
# with, e.g.:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A "mailto:" address (or HTTPS URL) identifying who is sending the push notifications - required by
# push services so they have a way to contact you about abuse.
VAPID_SUBJECT=

# Optional: set this to the origin used to reach Orbit.Web from another device on your network (e.g.
# "http://192.168.1.50:8080", using this machine's LAN IP) so that device's browser is also allowed by
# the API's CORS policy. Only matters for a client that calls Orbit.Api directly from a different
# origin (see docker-compose.yml's WebClientOrigins comment) - leave unset otherwise.
WEB_CLIENT_LAN_ORIGIN=

# Set this to the same LAN IP or hostname other devices use to reach this machine (e.g.
# "192.168.1.50") so orbit-web's self-signed TLS certificate covers that address - see README.md's
# "Accessing Orbit.Web from another device on your network" section. Required for the chat's
# end-to-end encryption to work from another device, since that needs a secure context (HTTPS), which
# plain http://<LAN IP>:8080 doesn't provide - orbit-web redirects that to https://<LAN IP>:8443
# automatically.
TLS_CERTIFICATE_HOSTNAME=

# Connection string for the Application Insights resource that receives Orbit.Api's OpenTelemetry
# traces when running in Azure Container Apps. Optional for local development - leave unset and traces
# keep going to the local Aspire dashboard instead (see OTEL_EXPORTER_OTLP_ENDPOINT above). Find this
# value in the Azure Portal under the Application Insights resource's Overview > Connection String.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# OAuth client id for "sign in with Google", from Google Cloud Console > APIs & Services > Credentials
# (create an "OAuth client ID" of type "Web application", and add this app's origin to its authorized
# JavaScript origins). Only the client id is needed - Orbit verifies an ID token the browser already
# obtained rather than running a server-side code exchange, so there is no client secret to store.
# Optional: leave it unset to run without Google sign-in - the button is then hidden entirely.
GOOGLE_CLIENT_ID=
