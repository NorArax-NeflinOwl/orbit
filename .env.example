# Copy this file to .env (already gitignored) and fill in real values before running
# `docker compose up`. Never commit the actual .env file.

# Signing key for the JWTs Orbit.Api issues on login/register. Must be a long, random string (at
# least 32 characters - it's used as an HMAC-SHA256 key). Generate one with, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-string-at-least-32-characters

# SMTP server Orbit.Api uses to send calendar event reminder emails (see README.md's "Calendar event
# reminders" section). Optional: leave these unset to run without email delivery - reminders are then
# just logged as a warning instead of sent, so the rest of the app still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Optional: set this to the origin used to reach Orbit.Web from another device on your network (e.g.
# "http://192.168.1.50:8080", using this machine's LAN IP) so that device's browser is also allowed by
# the API's CORS policy. Only matters for a client that calls Orbit.Api directly from a different
# origin (see docker-compose.yml's WebClientOrigins comment) - leave unset otherwise.
WEB_CLIENT_LAN_ORIGIN=

# Set this to the same LAN IP or hostname other devices use to reach this machine (e.g.
# "192.168.1.50") so orbit-web's self-signed TLS certificate covers that address - see README.md's
# "Accessing Orbit.Web from another device on your network" section. Required for the chat's
# end-to-end encryption to work from another device, since that needs a secure context (HTTPS), which
# plain http://<LAN IP>:8080 doesn't provide - orbit-web redirects that to https://<LAN IP>:8443
# automatically.
TLS_CERTIFICATE_HOSTNAME=
