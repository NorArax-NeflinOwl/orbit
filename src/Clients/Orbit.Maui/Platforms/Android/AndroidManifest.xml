<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- allowBackup="false" against the template's true. Android's automatic backup restores an app's
	shared preferences to a new device, but not the Keystore entry that opens them - and SecureStorage,
	which holds the session and the chat key, is exactly that pair. A restored phone would come up with
	credentials it cannot read, failing in the one situation the feature exists for. Orbit is offline-first
	with the server as the source of truth: a new phone signs in and restores the password-wrapped chat
	key, which is the path that already exists (see OwnEncryptionKeyProvider), and a local database
	carried over from another device would be the wrong one anyway - see LocalStoreOwner. -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Asked for at the moment the map is opened, never at install - see Platform/PhoneLocation.cs for
	why it is the "when in use" pair rather than background access. Coarse alongside fine because from
	Android 12 the reader may grant only the approximate one, and a street-level fix is all a shared
	position needs. -->
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<!-- A runtime permission from Android 13 on. Declared even though nothing is delivered yet, because
	the check that decides whether to ask throws without it - see Platforms/Android/PhonePushNotifications.cs. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
