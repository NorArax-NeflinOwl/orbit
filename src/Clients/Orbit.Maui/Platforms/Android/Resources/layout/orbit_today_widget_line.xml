<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the widget: when, then what. Inflated once per line and added to widgetLines, which is
     what RemoteViews allows instead of a list - a scrolling one would mean a collection widget, with a
     service and a factory behind it, for four rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetLine"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/widgetLineWhen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        android:paddingEnd="8dp"
        android:textColor="@color/orbitWidgetSubtleText"
        android:textSize="12sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widgetLineWhat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/orbitWidgetText"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
