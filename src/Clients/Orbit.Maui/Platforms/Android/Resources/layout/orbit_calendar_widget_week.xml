<?xml version="1.0" encoding="utf-8"?>
<!-- One week: a row the seven day squares are added into. Its own layout rather than seven views with
     seven ids in the month's own, so the grid is built by the same loop that works it out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetWeek"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal" />
