<?xml version="1.0" encoding="utf-8"?>
<!-- The card the widget is drawn on. Rounded to the radius Android asks widgets for from API 31, and
     painted rather than left transparent so the text stays readable over whatever wallpaper is behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/orbitWidgetBackground" />
</shape>
