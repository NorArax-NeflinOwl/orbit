<?xml version="1.0" encoding="utf-8"?>
<!-- The ring round today's number on the calendar widget. An outline rather than a filled disc: the
     widget is drawn over whatever wallpaper is behind it, and a filled accent square was the one solid
     block of colour on a card that is otherwise all hairlines - the same call the chat bubbles make. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <stroke android:width="1dp" android:color="@color/orbitWidgetAccent" />
</shape>
