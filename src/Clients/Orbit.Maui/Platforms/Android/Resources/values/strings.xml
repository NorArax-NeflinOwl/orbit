<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the launcher's widget picker, before Orbit has run at all - which is why it is here rather
     than in the app's own dictionary (Orbit.Localization). Android picks the language from the phone's
     settings; values-pl carries the Polish. -->
<resources>
    <!-- What the picker calls each widget. Both said "Orbit" until 2026-09-20, which is no way to tell
         two of them apart in a list of every widget on the phone. -->
    <string name="orbit_widget_label">Orbit today</string>
    <string name="orbit_calendar_widget_label">Orbit calendar</string>
    <string name="orbit_widget_description">Today\'s appointments and what is due</string>
    <string name="orbit_calendar_widget_description">The month, with a dot on every day something wants</string>
</resources>
