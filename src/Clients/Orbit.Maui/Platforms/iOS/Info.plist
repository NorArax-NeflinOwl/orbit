<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Transport Security refuses plaintext HTTP, which is what a development server on the Mac
	speaks. NSAllowsLocalNetworking is the narrow exception for that: it permits local and loopback
	hosts only, and leaves the refusal of plaintext to anything on the public internet in place.
	NSAllowsArbitraryLoads would have done the job by removing the protection entirely. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Shown verbatim in the system prompt, so it says what Orbit does with a position rather than
	     asking for permission in the abstract. "When in use" only: see PhoneLocation. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Orbit uses your location to record where you are and to share it with people you choose. It is encrypted for them before it leaves your phone.</string>
</dict>
</plist>
