<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Tasks.TaskListDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:common="clr-namespace:Orbit.Mobile.Screens;assembly=Orbit.Mobile"
    xmlns:tasks="clr-namespace:Orbit.Maui.Features.Tasks"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Tasks;assembly=Orbit.Mobile"
    xmlns:calendar="clr-namespace:Orbit.Mobile.Screens.Calendar;assembly=Orbit.Mobile"
    x:DataType="screens:TaskListDetailViewModel"
    x:Name="Page"
    Title="{Binding ScreenName}">

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20,14,20,0" RowSpacing="10">

        <!-- The list's own name and what it is, behind "Edit" in the menu under the screen's name. The
             screen is the entries and nothing else at rest - this was three fields and a switch above
             them, which is a form for the reader who is changing the list and clutter for the ninety-
             nine who are ticking something off it. -->
        <controls:TitledDescription Grid.Row="0" x:Name="ListFields" IsVisible="False"
                                    Title="{Binding Title, Mode=TwoWay}" TitleLabel="{controls:Translate 'Title'}"
                                    TitlePlaceholder="{controls:Translate 'Untitled'}"
                                    SaveTitleCommand="{Binding SaveListCommand}"
                                    Description="{Binding Description, Mode=TwoWay}"
                                    CommitDescriptionCommand="{Binding CommitDescriptionCommand}"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    ShowsDescription="{Binding IsNotPrivate}">
            <controls:TitledDescription.Suggestions>
                <controls:NameSuggestionChips BindingContext="{Binding TitleSuggestions}" />
            </controls:TitledDescription.Suggestions>

        </controls:TitledDescription>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                   FontSize="12" TextColor="{DynamicResource Accent}" LineBreakMode="WordWrap" />
            <controls:CopyOffer IsOffered="{Binding IsCopyOffered}"
                                TakeCommand="{Binding CopyForEditingCommand}"
                                DeclineCommand="{Binding DeclineCopyCommand}" />
        </VerticalStackLayout>

        <!-- Unfolded by the plus over the foot of the list, like every other screen's add form - see
             NewItemForm. Gated on CanEdit like every other control on this page: a list somebody else
             can change must not offer a box to type into and an Add that can only refuse. -->
        <VerticalStackLayout x:Name="AddRow" Grid.Row="2" Spacing="6" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                <Entry x:Name="AddField" Grid.Column="0" Placeholder="{controls:Translate 'New item'}"
                       Text="{Binding NewItemDescription}"
                       ReturnType="Done" ReturnCommand="{Binding AddItemCommand}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Command="{Binding AddItemCommand}" />
            </Grid>

            <!-- Under the box an errand is written in, which on a phone is where they are actually typed.
                 Wrapped because the panel's own BindingContext would decide its IsVisible too - the same
                 reason the stock-check panel below is wrapped. -->
            <VerticalStackLayout IsVisible="{Binding CanEdit}">
                <controls:NameSuggestionChips BindingContext="{Binding Suggestions}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="Checklist" Grid.Row="3" ItemsSource="{Binding Items}" IsVisible="{Binding IsShowingList}">

            <CollectionView.EmptyView>
                <Label Text="{controls:Translate 'Nothing on this list yet.'}" Padding="0,12" Style="{StaticResource EmptyHint}" />
            </CollectionView.EmptyView>

            <!-- RelativeSource walks the *visual* tree, so the ancestor named here has to be an element:
                 the page, whose BindingContext is the view model. Naming the view model type instead
                 compiles and then silently binds to nothing. -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="screens:TaskItemRow">
                    <!-- A hairline above every row, as every list in this design has - see ItemCard's
                         row shape, which is the same rule drawn by a different control. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8" RowDefinitions="Auto">
                        <BoxView Grid.ColumnSpan="3" Style="{StaticResource Hairline}" VerticalOptions="Start"
                                 Margin="0,-8,0,0" />
                        <controls:CheckCircle Grid.Column="0" Diameter="22" VerticalOptions="Center"
                                              IsChecked="{Binding IsCompleted}"
                                              IsFailed="{Binding IsFailed}"
                                              Description="{Binding Description}"
                                              Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ToggleItemCommand, x:DataType=tasks:TaskListDetailPage}"
                                              CommandParameter="{Binding .}" />
                        <!-- Tapping the line opens the rest of the entry: when it is due, what it
                             says when it is late, whether it repeats daily. -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.EditItemCommand, x:DataType=tasks:TaskListDetailPage}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Description}" LineBreakMode="WordWrap">
                                <Label.Triggers>
                                    <!-- Struck through and quietened once it is done, which is what the
                                         design does and what a paper list does. The circle says the
                                         same thing; a reader scanning a long list reads the line. -->
                                    <!-- Struck through once it is finished with, either way: the circle
                                         says which of the two it was. -->
                                    <DataTrigger TargetType="Label" Binding="{Binding IsResolved}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- What it is filed under, under what it says: the tasks page narrows by
                                 these, and a row that does not carry them leaves the reader to take
                                 that page's word for why it is still on screen. -->
                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasCategories}"
                                                   BindableLayout.ItemsSource="{Binding Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Style="{StaticResource FilterChip}" Padding="6,2">
                                            <Label Text="{Binding .}" Style="{StaticResource FilterChipLabel}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11"
                                   LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Whether the appointment behind this entry is anywhere but here yet.
                                 Said on the row because it is otherwise invisible: an appointment made
                                 with no connection looks exactly like one everybody can already see. -->
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{controls:Translate 'offline'}" FontSize="10" Padding="6,1"
                                       IsVisible="{Binding IsWaitingToReachTheServer}"
                                       Style="{StaticResource SubtleLabel}" />
                                <Label Text="{controls:Translate 'online'}" FontSize="10" Padding="6,1"
                                       IsVisible="{Binding HasReachedTheServer}"
                                       Style="{StaticResource SubtleLabel}" />
                            </HorizontalStackLayout>

                            <!-- Where an inventory errand points: the shelf it is about, and any other
                                 list asking for the same product. Buttons rather than labels, for the
                                 reason Orbit.Web gives about its own chips - the reason to say it is to
                                 be able to go and look. Outside the tap that opens the entry, so one
                                 does not swallow the other. -->
                            <FlexLayout Wrap="Wrap" Direction="Row" IsVisible="{Binding HasReferences}"
                                        BindableLayout.ItemsSource="{Binding References}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="screens:TaskItemReference">
                                        <Button Text="{Binding Label}" FontSize="11" Padding="8,2" Margin="0,2,6,0"
                                                Style="{StaticResource LinkButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.OpenReferenceCommand, x:DataType=tasks:TaskListDetailPage}"
                                                CommandParameter="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <controls:OverflowMenu Grid.Column="2" VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowItemMenuCommand, x:DataType=tasks:TaskListDetailPage}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- In place of the list, one entry at a time - see TaskListDetailViewModel.BeingEdited. -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsEditingItem}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Padding="0,8" Spacing="10" BindingContext="{Binding BeingEdited}"
                                 x:DataType="screens:TaskItemEditor">
                <Entry Placeholder="{controls:Translate 'Checklist item'}" Text="{Binding Description}" />
                <!-- Errands this account has already written, offered as this one is typed. -->
                <controls:NameSuggestionChips BindingContext="{Binding Suggestions}" />

                <!-- What the entry is about, as many as apply, on one line - the same box the browser
                     offers and the same rule behind it, see CategoryText. Kept for every kind: an
                     appointment is about something the same way an errand is, and the tasks screen
                     looks for an entry among every list by these. -->
                <Entry Placeholder="{controls:Translate 'Categories, separated by commas'}"
                       Text="{Binding Categories}"
                       SemanticProperties.Description="{controls:Translate 'Categories'}" />

                <!-- What this entry is. On the entry rather than on the list, because a day's plan holds
                     two errands and an appointment - see TaskItemKind. -->
                <Label Text="{controls:Translate 'Type'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                <Picker ItemsSource="{Binding Kinds}" SelectedItem="{Binding ChosenKind}"
                        ItemDisplayBinding="{Binding Name, x:DataType=screens:TaskItemKindChoice}"
                        SemanticProperties.Description="{controls:Translate 'Type'}" />

                <!-- Where the entry is, shown for the two kinds that have anywhere to be: an appointment,
                     and a Location entry, which is a place and nothing more - see CanSayWhereItHappens.
                     Outside the event form below, because a Location entry has one of these and none of
                     the rest. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding CanSayWhereItHappens}">
                    <Entry Placeholder="{controls:Translate 'Where this happens'}" Text="{Binding Location}" />
                    <!-- Typing an address is one way; pointing at it is the other, and the one that
                         works when nobody knows what the street is called. -->
                    <Button Text="{controls:Translate 'Show map'}" FontSize="13" HorizontalOptions="Start"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ShowMapCommand, x:DataType=tasks:TaskListDetailPage}" />
                </VerticalStackLayout>

                <!-- A Calendar entry is the appointment rather than a pointer at one, so this is the
                     event's own form - the same fields Orbit.Web's task editor shows. Saving the entry
                     is what puts it in the calendar. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsCalendarEntry}">
                    <VerticalStackLayout Spacing="10" BindingContext="{Binding Event}"
                                         x:DataType="screens:TaskItemEventForm">
                        <Editor Placeholder="{controls:Translate 'Description'}" Text="{Binding Description}"
                                AutoSize="TextChanges" MinimumHeightRequest="60" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{controls:Translate 'All-day event'}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsAllDay}" VerticalOptions="Center"
                                    SemanticProperties.Description="{controls:Translate 'All-day event'}" />
                        </Grid>

                        <Label Text="{controls:Translate 'Starts'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                        <DatePicker Date="{Binding StartDate}" Format="{controls:DatePattern}"
                                SemanticProperties.Description="{controls:Translate 'Starts'}" />
                        <TimePicker Time="{Binding StartTime}" IsVisible="{Binding ShowsTimes}" Format="{controls:TimePattern}"
                                SemanticProperties.Description="{controls:Translate 'Starts'}" />

                        <Label Text="{controls:Translate 'Ends'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                        <DatePicker Date="{Binding EndDate}" Format="{controls:DatePattern}"
                                SemanticProperties.Description="{controls:Translate 'Ends'}" />
                        <TimePicker Time="{Binding EndTime}" IsVisible="{Binding ShowsTimes}" Format="{controls:TimePattern}"
                                SemanticProperties.Description="{controls:Translate 'Ends'}" />

                        <Label Text="{controls:Translate 'Repeats'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                        <Picker ItemsSource="{Binding Recurrences}" SelectedItem="{Binding ChosenRecurrence}"
                                Title="{controls:Translate 'Never'}"
                                ItemDisplayBinding="{Binding Name, x:DataType=calendar:RecurrenceChoice}"
                                SemanticProperties.Description="{controls:Translate 'Repeats'}" />

                        <Label Text="{controls:Translate 'Remind before'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                        <Picker ItemsSource="{Binding Reminders}" SelectedItem="{Binding ChosenReminder}"
                                Title="{controls:Translate 'No reminder'}"
                                ItemDisplayBinding="{Binding Name, x:DataType=calendar:ReminderChoice}"
                                SemanticProperties.Description="{controls:Translate 'Remind before'}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- An errand about a product opens the product itself, so correcting an amount does
                     not mean leaving the list and finding the inventory again. The same form the
                     inventory screen shows, and saving here saves it there - see TaskItemShelfProduct. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsShelfEntry}">
                    <Label Text="{Binding WhereTheProductLives}" FontSize="12" LineBreakMode="WordWrap"
                           Style="{StaticResource SubtleLabel}" />
                    <controls:ShelfProductFields BindingContext="{Binding Shelf.Product}" />
                </VerticalStackLayout>

                <!-- An errand whose product this phone has not got - an inventory no longer shared, or
                     one not synced yet. Said, rather than left as an empty form that looks broken. -->
                <Label Text="{Binding NoProductMessage}"
                       IsVisible="{Binding HasNoProductToEdit}" FontSize="12" LineBreakMode="WordWrap"
                       Style="{StaticResource SubtleLabel}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{controls:Translate 'Due date'}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding HasDueDate}" VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Due date'}" />
                </Grid>
                <DatePicker Date="{Binding DueDate}" IsVisible="{Binding HasDueDate}" Format="{controls:DatePattern}"
                        SemanticProperties.Description="{controls:Translate 'Due date'}" />

                <Label Text="{controls:Translate 'When it is overdue'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                <Picker ItemsSource="{Binding Channels}"
                        SelectedItem="{Binding ChosenOverdueNotificationChannel}"
                        ItemDisplayBinding="{Binding Name, x:DataType=common:NotificationChannelChoice}"
                        SemanticProperties.Description="{controls:Translate 'When it is overdue'}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{controls:Translate 'Remind me daily'}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding RemindDaily}" VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Remind me daily'}" />
                </Grid>
                <!-- Named apart from the switch above it and the picker below: three controls all
                     announcing "Remind me daily" say there is one question here, when there are three. -->
                <TimePicker Time="{Binding DailyReminderTime}" Format="{controls:TimePattern}"
                            IsVisible="{Binding HasDailyReminderTime}"
                            SemanticProperties.Description="{controls:Translate 'Comes round at'}" />
                <!-- Shown in the picker's place for an entry that arrived without an hour. A picker
                     already showing nine o'clock is one somebody accepts by not touching it, and that
                     would record nothing - see TaskItemEditor.ChooseAReminderTime. -->
                <Button Text="{controls:Translate 'Choose a time'}" HorizontalOptions="Start"
                        FontSize="12" Padding="12,6" Style="{StaticResource SecondaryButton}"
                        IsVisible="{Binding HasSomethingMissing}"
                        Command="{Binding ChooseAReminderTimeCommand}" />
                <!-- An hour is required once a daily reminder is on. Refused rather than quietly
                     corrected: one nobody chose would be sent at midnight - see TaskItemEditor. -->
                <Label Text="{Binding WhatIsMissing}" IsVisible="{Binding HasSomethingMissing}"
                       FontSize="12" LineBreakMode="WordWrap" TextColor="{DynamicResource Accent}" />
                <Picker ItemsSource="{Binding Channels}"
                        SelectedItem="{Binding ChosenDailyReminderNotificationChannel}"
                        ItemDisplayBinding="{Binding Name, x:DataType=common:NotificationChannelChoice}"
                        IsVisible="{Binding RemindDaily}"
                        SemanticProperties.Description="{controls:Translate 'How the daily reminder arrives'}" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="4" Spacing="10" IsVisible="{Binding IsEditingItem}">

            <!-- What this entry stands for. A group list gathers other lists through entries pointing
                 at them, so without this a group made on the phone gathered nothing. Inside the form,
                 unlike moving: it is a fact about the entry, and it is saved with it. -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding BeingEdited.CanBeLinked}">
                <Label Text="{controls:Translate 'Link to list'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                <!-- The picker says what to add next rather than what is already there: one entry may
                     stand for several lists, and choosing adds one and clears the picker. -->
                <Picker x:Name="LinkedTaskListPicker" ItemsSource="{Binding BeingEdited.LinkableTaskListsLeft}"
                        ItemDisplayBinding="{Binding Name, x:DataType=screens:TaskListChoice}"
                        SelectedIndexChanged="OnLinkedTaskListPicked"
                        SemanticProperties.Description="{controls:Translate 'Link to list'}" />

                <!-- What it stands for now, each with a way off. Orbit.Web draws the same pair. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BeingEdited.LinkedTaskLists}"
                                     IsVisible="{Binding BeingEdited.IsALinkToOtherLists}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="screens:TaskListChoice">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Button Grid.Column="1" Text="✕" FontSize="14" WidthRequest="44" Padding="0"
                                        BackgroundColor="Transparent" BorderWidth="0"
                                        SemanticProperties.Description="{controls:Translate 'Remove'}"
                                        TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}"
                                        Command="{Binding ViewModel.BeingEdited.UnlinkCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=tasks:TaskListDetailPage}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- The order the work on this list has to be done in - "hang the door" after "fit the
                 hinges". A different thing from the lists above: that is one entry meaning whole other
                 lists, this is where this entry stands among the others here. Offered whatever the
                 entry's kind, because the rule reads it off every one of them - see TaskListSteps, and
                 Orbit.Web's editor, which draws the same pair in the same order. -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding BeingEdited.CanWaitForAnything}">
                <Label Text="{controls:Translate 'Waits for'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                <!-- Says what to add next rather than what is already there, like the link picker: one
                     entry may wait for several, and choosing adds one and clears the picker. -->
                <Picker x:Name="StepPicker" ItemsSource="{Binding BeingEdited.WaitableEntriesLeft}"
                        ItemDisplayBinding="{Binding Description, x:DataType=screens:TaskEntryChoice}"
                        SelectedIndexChanged="OnStepPicked"
                        SemanticProperties.Description="{controls:Translate 'Waits for'}" />

                <!-- What it waits for now, each with a way off. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BeingEdited.WaitsFor}"
                                     IsVisible="{Binding BeingEdited.WaitsForAnything}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="screens:TaskEntryChoice">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Description}" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Button Grid.Column="1" Text="✕" FontSize="14" WidthRequest="44" Padding="0"
                                        BackgroundColor="Transparent" BorderWidth="0"
                                        SemanticProperties.Description="{controls:Translate 'Remove'}"
                                        TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}"
                                        Command="{Binding ViewModel.BeingEdited.StopWaitingForCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=tasks:TaskListDetailPage}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Outside the entry's own form, because moving is a change to two lists rather than to
                 the entry: choosing a list does it there and then, and this form's Save is not involved. -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding CanMoveItem}">
                <Label Text="{controls:Translate 'Move to list'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                <Picker Title="{controls:Translate 'Move to…'}" ItemsSource="{Binding MoveTargetsForTheEntry}"
                        SelectedIndexChanged="OnMoveTargetChosen"
                        ItemDisplayBinding="{Binding Name, x:DataType=screens:TaskListChoice}"
                        SemanticProperties.Description="{controls:Translate 'Move to list'}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="16">
                <Button Text="{controls:Translate 'Save'}" Command="{Binding SaveItemCommand}" />
                <Button Text="{controls:Translate 'Cancel'}" Style="{StaticResource LinkButton}"
                        Command="{Binding CancelItemEditCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- What the list itself is, rather than what is on it - behind "Edit" in the menu under the
             screen's name, with the fields at the top of the page. The panel's own BindingContext would
             decide its IsVisible too, so the visibility lives on a wrapper that still reads the view
             model. -->
        <VerticalStackLayout x:Name="ListSettings" Grid.Row="4" Spacing="10" IsVisible="False">

            <!-- Orbit.Web's "Group list": a list that gathers the lists its items link to rather than
                 holding work of its own. It is also what makes the stock check below worth asking. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                <Label Grid.Column="0" Text="{controls:Translate 'Group list'}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsGroup}" VerticalOptions="Center"
                        SemanticProperties.Description="{controls:Translate 'Group list'}" />
            </Grid>

            <!-- The same checkbox Orbit.Web's task editor has: what it turns on is real encryption, so
                 the row says what it costs rather than only what it is. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{controls:Translate 'Private'}" />
                    <Label Text="{controls:Translate 'Only you can read it, and it cannot be shared.'}"
                           FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding IsPrivate}" VerticalOptions="Center"
                        SemanticProperties.Description="{controls:Translate 'Private'}" />
            </Grid>

            <!-- How much this list matters. The phone could sort by it from the day it could list
                 anything, and had no way to see one or set one - see PriorityChoice. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                <Label Grid.Column="0" Text="{controls:Translate 'Priority'}" VerticalOptions="Center" />
                <Picker Grid.Column="1" WidthRequest="160" ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding ChosenPriority}"
                        ItemDisplayBinding="{Binding Name, x:DataType=screens:PriorityChoice}"
                        SemanticProperties.Description="{controls:Translate 'Priority'}" />
            </Grid>

            <!-- "Can this be done?" - what this list's work costs against an inventory, as Orbit.Web's
                 task list page asks it. Only a group list gathers enough work to be worth counting.

                 The same card everything else is drawn with, folded by its heading: the question is
                 about a shelf, which is not what somebody working through the list is looking at. -->
            <controls:ItemCard BindingContext="{Binding StockCheck}" x:DataType="screens:StockCheckPanel"
                               IsVisible="{Binding IsOffered}"
                               Name="{controls:Translate 'Can this be done?'}"
                               NameCommand="{Binding ToggleFoldCommand}">
                <controls:ItemCard.Collapse>
                    <Button Text="{Binding FoldGlyph}" SemanticProperties.Description="{Binding FoldDescription}"
                            FontSize="12" Padding="2,0" WidthRequest="44" VerticalOptions="Center"
                            Style="{StaticResource LinkButton}" Command="{Binding ToggleFoldCommand}" />
                </controls:ItemCard.Collapse>

                <controls:ItemCard.Menu>
                    <!-- What order the rows are read in, as Orbit.Web keeps it behind this card's own
                         menu. An action sheet rather than a panel - one choice, then done.

                         The drawn three dots, like every other menu in the app. It used to write the
                         character "⋯", which neither text face carries - IBM Plex Sans and Space
                         Grotesk both lack U+22EF - so Android was substituting a system font for it,
                         and this was the last place in the app a menu was a character rather than a
                         drawing. -->
                    <controls:OverflowMenu VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Sort'}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ChooseStockOrderCommand, x:DataType=tasks:TaskListDetailPage}" />
                </controls:ItemCard.Menu>

                <controls:ItemCard.Body>
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNotFolded}">
                        <!-- Both questions here are the server's to answer, so neither is offered while there
                             is nobody to ask - see ConnectionRequirement. -->
                        <Label Text="{Binding Connection.Explanation}" IsVisible="{Binding Connection.IsNotMet}"
                               FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

                        <Label Text="{Binding Summary}" IsVisible="{Binding HasSummary}" FontSize="13"
                               LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

                        <!-- Beside a summary that says the answer never came, and only then. Nothing
                             else on this card asks the question a second time. -->
                        <Button Text="{controls:Translate 'Try again'}" IsVisible="{Binding CouldNotBeAnswered}"
                                IsEnabled="{Binding Connection.IsMet}" HorizontalOptions="Start"
                                FontSize="12" Padding="12,6" Style="{StaticResource LinkButton}"
                                Command="{Binding AskAgainCommand}" />

                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Requirements}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="screens:StockRequirementRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Padding="0,6">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                               LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Required}" FontSize="13"
                                               WidthRequest="40" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Available}" FontSize="13"
                                               WidthRequest="40" HorizontalTextAlignment="End" VerticalOptions="Center"
                                               Style="{StaticResource SubtleLabel}" />
                                        <!-- Only what is short is written in the last column, and only that
                                             column is coloured - a row that is covered says nothing. -->
                                        <Label Grid.Column="3" Text="{Binding Missing}" FontSize="13"
                                               WidthRequest="40" HorizontalTextAlignment="End" VerticalOptions="Center"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Text="{controls:Translate 'Add what is missing to the restock list'}"
                                IsEnabled="{Binding Connection.IsMet}"
                                IsVisible="{Binding IsShortOfSomething}" HorizontalOptions="Start"
                                FontSize="12" Padding="12,6" LineBreakMode="WordWrap"
                                Command="{Binding RaiseShortfallsCommand}" />

                        <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource Accent}" />
                    </VerticalStackLayout>
                </controls:ItemCard.Body>

                <!-- Which shelf this is counted against, at the foot rather than inside the body: it is
                     how the panel gets linked in the first place, and unreachable while folded would
                     mean unreachable before it has anything to fold. -->
                <controls:ItemCard.Extras>
                    <!-- A sheet rather than a picker, for the reason the event editor's three are:
                         iOS docks a picker's wheel at the bottom of the screen, which here covers the
                         sharing links and the way back. -->
                    <Button Text="{Binding LinkedInventory.Name}" HorizontalOptions="Start"
                            FontSize="13" Padding="12,6" Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding Connection.IsMet}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ChooseInventoryCommand, x:DataType=tasks:TaskListDetailPage}" />
                </controls:ItemCard.Extras>
            </controls:ItemCard>

        </VerticalStackLayout>

        <!-- Opened from the list's own menu rather than standing at the foot of every list: sharing is
             something somebody does once. It hides itself for a private list, as Orbit.Web's editor
             hides it - there is no readable copy on the server to hand anybody, see SharePanel. -->
        <controls:SharePanel Grid.Row="4" x:Name="Sharing" IsVisible="False"
                             BindingContext="{Binding Share}" Margin="0,4" />

    </Grid>

        <!-- No Save: a tick is written the moment it is made, which is what a checklist is for. So the
             bar carries the way out, whatever this list has to say for itself, and one menu holding
             both how to read it and what can be done to it - the same rail Orbit.Web's checklist has.
             What else can be done to this list - its order, generating an inventory, its own fields,
             sharing it, deleting it - hangs under its name. See ITitleMenu. -->

        <controls:Fab x:Name="AddButton" Grid.Row="1" IsVisible="{Binding IsShowingList}"
                      Description="{controls:Translate 'New item'}" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=tasks:TaskListDetailPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
