<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Tasks.TasksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:tasks="clr-namespace:Orbit.Maui.Features.Tasks"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Tasks;assembly=Orbit.Mobile"
    x:DataType="screens:TasksViewModel"
    Title="{controls:Translate 'Tasks'}">

    <ContentPage.Resources>
        <controls:PinGlyphConverter x:Key="PinGlyph" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="10">


        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="{controls:Translate 'New list'}" Text="{Binding NewListTitle}"
                   ReturnType="Done" ReturnCommand="{Binding AddListCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Command="{Binding AddListCommand}" />
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding TaskLists}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenListCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'No task lists yet.'}" Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:TaskListRow">
                        <VerticalStackLayout Padding="0,12" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Title}" FontSize="17" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding IsPinned, Converter={StaticResource PinGlyph}}"
                                        FontSize="16" Padding="10,0" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.TogglePinCommand, x:DataType=tasks:TasksPage}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <Label Text="{Binding Progress}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <!-- Why a list is waiting, or why it cannot be edited right now. -->
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <Button Grid.Row="3" Text="{controls:Translate 'Back to dashboard'}" Command="{Binding GoBackCommand}"
                Style="{StaticResource LinkButton}" />

    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
