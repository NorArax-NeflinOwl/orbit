<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Tasks.TasksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:tasks="clr-namespace:Orbit.Maui.Features.Tasks"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Tasks;assembly=Orbit.Mobile"
    x:DataType="screens:TasksViewModel"
    Title="{controls:Translate 'Tasks'}">

    <ContentPage.Resources>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20" RowSpacing="10">


        <controls:PageHeader Grid.Row="0" Title="{controls:Translate 'Tasks'}">
            <controls:PageHeader.Subtitle>
                <controls:Translate Text="Every list you own or someone shared with you." />
            </controls:PageHeader.Subtitle>
        </controls:PageHeader>

        <!-- Chips and a stepping button rather than a dropdown: the web has room for a select, a phone
             has a thumb. Each chip carries what it would leave, which is what makes it worth tapping. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <!-- Scrolls sideways: five filters do not fit across a phone. A filled pill half off the
                 edge reads as "there is more this way", which the old text-only chips did not - they
                 just looked like a word had been cut in half. -->
            <ScrollView Grid.Column="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Filters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="screens:TaskListFilter">
                            <Border Style="{StaticResource FilterChip}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.FilterByCommand, x:DataType=tasks:TasksPage}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsChosen}" Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="Stroke"
                                                Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Label Text="{Binding Label}" Style="{StaticResource FilterChipLabel}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsChosen}" Value="True">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource AccentOnLight}, Dark={StaticResource AccentOnDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Button Grid.Column="1" Text="{Binding SortDescription}" FontSize="12" Padding="8,4"
                    VerticalOptions="Start" Style="{StaticResource LinkButton}"
                    Command="{Binding NextSortOrderCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="{controls:Translate 'New list'}" Text="{Binding NewListTitle}"
                   ReturnType="Done" ReturnCommand="{Binding AddListCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Command="{Binding AddListCommand}" />
        </Grid>

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding TaskLists}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenListCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'No task lists yet.'}" Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:TaskListRow">
                        <VerticalStackLayout Padding="0,12" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Title}" FontSize="17" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <!-- Only where it says something: a badge on every list, most of them
                                     Normal, would mark nothing out - see PriorityChoice.IsWorthSaying. -->
                                <Border Grid.Column="1" Style="{StaticResource FilterChip}" Padding="8,3"
                                        IsVisible="{Binding HasPriority}" VerticalOptions="Center">
                                    <Label Text="{Binding Priority}" Style="{StaticResource FilterChipLabel}" />
                                </Border>
                                <!-- Where the list stands, in the same words as the chips above it. -->
                                <Border Grid.Column="2" Style="{StaticResource FilterChip}" Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding State}" Style="{StaticResource FilterChipLabel}" />
                                </Border>
                                <controls:PinButton Grid.Column="3" IsPinned="{Binding IsPinned}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.TogglePinCommand, x:DataType=tasks:TasksPage}"
                                                    CommandParameter="{Binding .}" />
                            </Grid>
                            <Label Text="{Binding Progress}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />

                            <!-- One line, and the one worth having: what is still to be done on this
                                 list. A row that only points at another list is not work itself, so what
                                 it stands for is looked up there and that list is named beside it. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasNextThing}"
                                  Margin="0,4,0,0">
                                <Label Grid.Column="0" Text="{Binding NextThing}" FontSize="13"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding NextThingOnList}" FontSize="11"
                                       IsVisible="{Binding IsNextThingOnAnotherList}" VerticalOptions="Center"
                                       Style="{StaticResource SubtleLabel}" />
                            </Grid>
                            <Label Text="{controls:Translate 'Nothing left to do.'}" FontSize="13" Margin="0,4,0,0"
                                   IsVisible="{Binding HasNothingLeftToDo}" Style="{StaticResource SubtleLabel}" />
                            <!-- Why a list is waiting, or why it cannot be edited right now. -->
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <BoxView HeightRequest="1" Margin="0,12,0,0"
                                     Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>


    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
