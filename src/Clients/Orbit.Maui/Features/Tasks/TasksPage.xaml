<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Tasks.TasksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tasks="clr-namespace:Orbit.Maui.Features.Tasks"
    x:DataType="tasks:TasksViewModel"
    Title="Tasks">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="10">

        <Label Grid.Row="0" Text="{Binding SyncStatus}" FontSize="12" TextColor="{StaticResource Gray500}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="New list" Text="{Binding NewListTitle}"
                   ReturnType="Done" ReturnCommand="{Binding AddListCommand}" />
            <Button Grid.Column="1" Text="Add" Command="{Binding AddListCommand}" />
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding TaskLists}">

                <CollectionView.EmptyView>
                    <Label Text="No task lists yet." Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="tasks:TaskListRow">
                        <VerticalStackLayout Padding="0,12" Spacing="2">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Progress}" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <!-- Why a list is waiting, or why it cannot be edited right now. -->
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                   FontSize="12" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <Button Grid.Row="3" Text="Back to notes" Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

    </Grid>

</ContentPage>
