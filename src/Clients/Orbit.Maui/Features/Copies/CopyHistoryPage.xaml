<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Copies.CopyHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:copies="clr-namespace:Orbit.Maui.Features.Copies"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Copies;assembly=Orbit.Mobile"
    x:DataType="screens:CopyHistoryViewModel"
    Title="{Binding SubjectTitle}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="20,14,20,0" RowSpacing="12">

            <VerticalStackLayout Grid.Row="0" Spacing="10">
                <Label Text="{controls:Translate 'Nothing has been copied from this.'}" IsVisible="{Binding HasNothing}"
                       Style="{StaticResource EmptyHint}" HorizontalOptions="Center" Margin="0,20,0,0" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
                <!-- The rule under the last row, so the column ends rather than stopping mid-air. -->
                <CollectionView.Footer>
                    <BoxView Style="{StaticResource Hairline}" IsVisible="{Binding HasAny}" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:HistoryRow">
                        <!-- The row is the button, as everywhere else in the app: tapping a copy opens
                             it. The one extra thing a row can do - go to what it came from - is a link
                             under it rather than a second button beside the title. -->
                        <!-- The hairline goes above the row, not under it, so a list reads as one
                             column closed at the foot - see ItemCard's row shape, which is the same
                             rule drawn by a different control. -->
                        <VerticalStackLayout Padding="0,14" Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.OpenCommand, x:DataType=copies:CopyHistoryPage}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <BoxView Style="{StaticResource Hairline}" Margin="0,-14,0,8" />
                            <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding Description}" FontSize="12" LineBreakMode="WordWrap"
                                   Style="{StaticResource SubtleLabel}" />

                            <!-- A copy nobody has answered for yet is part of what happened here too,
                                 and saying so is what stops the window reading as settled history. -->
                            <Label Text="{controls:Translate 'Still waiting to be reviewed'}"
                                   IsVisible="{Binding IsAwaitingReview}" FontSize="12"
                                   TextColor="{DynamicResource Accent}" />

                            <Button Text="{controls:Translate 'Open the original'}" IsVisible="{Binding HasOriginal}"
                                    FontSize="12" Padding="0,2" HorizontalOptions="Start"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.OpenOriginalCommand, x:DataType=copies:CopyHistoryPage}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- The thing's own name is in the bar, and what the screen is about it is behind the "?"
             beside that name - see NavigationBar.Description. -->
        <controls:NavigationBar Grid.Row="0"
                                Description="{controls:Translate 'Copies of this, and what each came from.'}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
