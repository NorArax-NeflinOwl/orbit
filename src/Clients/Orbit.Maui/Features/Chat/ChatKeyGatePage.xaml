<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Chat.ChatKeyGatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Chat;assembly=Orbit.Mobile"
    x:DataType="screens:ChatKeyGateViewModel"
    Title="{controls:Translate 'Chat key'}">

    <Grid RowDefinitions="Auto,*,Auto">


    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- A Google account that never set a password: there is nothing to wrap the key with yet. -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSettingFirstPassword}">
                <Label Text="{controls:Translate 'Set a password to use chat'}" FontSize="24" FontAttributes="Bold" />
                <Label LineBreakMode="WordWrap">
                    <Label.Text>
                        <controls:Translate Text="Chat is end-to-end encrypted and your key is protected with a password. This account signs in with Google and doesn't have one yet, so pick one now - it's also what lets you read your messages on another device." />
                    </Label.Text>
                </Label>
                <Label Text="{controls:Translate 'Nobody can recover it for you: forget it and your chat history becomes unreadable.'}"
                       TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" LineBreakMode="WordWrap" />
                <Entry Placeholder="{controls:Translate 'Password'}" Text="{Binding Password}" IsPassword="True" />
                <Entry Placeholder="{controls:Translate 'Repeat password'}" Text="{Binding RepeatPassword}" IsPassword="True" />
                <Button Text="{controls:Translate 'Set password'}" Command="{Binding SetFirstPasswordCommand}" />
            </VerticalStackLayout>

            <!-- The ordinary case: the account has a password, this device just hasn't got the key. -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEnteringPassword}">
                <Label Text="{controls:Translate 'Unlock chat'}" FontSize="24" FontAttributes="Bold" />
                <Label LineBreakMode="WordWrap">
                    <Label.Text>
                        <controls:Translate Text="This device doesn't have a copy of your encryption key yet. Enter your password to restore it from your encrypted backup - it never leaves this device." />
                    </Label.Text>
                </Label>
                <Entry Placeholder="{controls:Translate 'Password'}" Text="{Binding Password}" IsPassword="True"
                       ReturnType="Go" ReturnCommand="{Binding UnlockCommand}" />
                <Button Text="{controls:Translate 'Unlock'}" Command="{Binding UnlockCommand}" />
                <Button Text="{controls:Translate 'I forgot my password'}"
                        Command="{Binding StartResetCommand}"
                        IsVisible="{Binding CanReset}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsResetting}">
                <Label Text="{controls:Translate 'Reset your password'}" FontSize="24" FontAttributes="Bold" />
                <!-- Said before the code is even sent: this is the one path that throws a key away. -->
                <Label TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                       LineBreakMode="WordWrap">
                    <Label.Text>
                        <controls:Translate Text="Setting a new password starts your chat over: messages encrypted under the old one stay unreadable, because Orbit's servers never had the key to them." />
                    </Label.Text>
                </Label>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding AwaitingCodeRequest}">
                    <Label Text="{Binding ResetCodeDestination}"
                           LineBreakMode="WordWrap" />
                    <Button Text="{controls:Translate 'Send code'}" Command="{Binding SendResetCodeCommand}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding CodeSent}">
                    <Entry Placeholder="{controls:Translate 'Code from the email'}" Text="{Binding Code}" Keyboard="Numeric" />
                    <Entry Placeholder="{controls:Translate 'New password'}" Text="{Binding Password}" IsPassword="True" />
                    <Entry Placeholder="{controls:Translate 'Repeat new password'}" Text="{Binding RepeatPassword}" IsPassword="True" />
                    <Button Text="{controls:Translate 'Set password and start chat over'}" Command="{Binding ResetPasswordCommand}" />
                </VerticalStackLayout>
                <Button Text="{controls:Translate 'Back'}" Command="{Binding CancelResetCommand}"
                        Style="{StaticResource LinkButton}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsUnlocked}">
                <Label Text="{controls:Translate 'Chat is unlocked'}" FontSize="24" FontAttributes="Bold" />
                <Label Text="{controls:Translate 'This device now holds your encryption key.'}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" LineBreakMode="WordWrap" />


        </VerticalStackLayout>
    </ScrollView>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
