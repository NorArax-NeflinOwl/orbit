<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Chat.ConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:data="clr-namespace:Orbit.Mobile.Data;assembly=Orbit.Mobile"
    xmlns:mobile="clr-namespace:Orbit.Mobile.Chat;assembly=Orbit.Mobile"
    xmlns:chat="clr-namespace:Orbit.Maui.Features.Chat"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Chat;assembly=Orbit.Mobile"
    x:DataType="screens:ConversationViewModel"
    x:Name="Page"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <controls:WidthFractionConverter x:Key="WidthFraction" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="16,16,16,28" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Grid.Column="0" Text="{Binding Title}" FontFamily="OrbitDisplay" FontSize="15"
                   FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center" />

            <!-- Who this is, apart from what they have said - the conversation's own menu, in the
                 corner Orbit.Web's thread header keeps it in. -->
            <controls:OverflowMenu Grid.Column="1"
                                   Command="{Binding ShowThreadMenuCommand, Source={x:Reference Page}, x:DataType=chat:ConversationPage}" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" LineBreakMode="WordWrap" />

            <!-- Orbit.Web's .chat-request-banner: a conversation still waiting on somebody says so at
                 the top, rather than letting the reader write and find out when the send is refused. -->
            <Border Style="{StaticResource CardBorder}" Padding="14,12" IsVisible="{Binding HasRequestNotice}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding RequestNotice}" FontSize="13" LineBreakMode="WordWrap" />
                    <Button Text="{controls:Translate 'Allow chatting'}" HorizontalOptions="Start"
                            FontSize="13" Padding="12,6" IsVisible="{Binding CanApproveRequest}"
                            Command="{Binding ApproveRequestCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="2" IsVisible="{Binding IsNotForwarding}"
                     IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView x:Name="Thread" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'No messages yet.'}" Padding="0,12" Style="{StaticResource EmptyHint}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="mobile:ReadableChatMessage">
                        <!-- One message, drawn as Orbit.Web draws it: a bubble on the side of the thread
                             it belongs to - the reader's own at the right in the accent, everybody
                             else's at the left on the quiet fill - at most 70% of the thread's width,
                             with what the message says about itself in small print underneath.

                             The phone used to stack every message flat down the left, which reads as a
                             transcript rather than as a conversation: nothing but the small print said
                             who had written which line. -->
                        <VerticalStackLayout Spacing="3" Margin="0,0,0,10" HorizontalOptions="Start"
                                             MaximumWidthRequest="{Binding Width, Source={x:Reference Thread}, Converter={StaticResource WidthFraction}, ConverterParameter=0.7, x:DataType=CollectionView}">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsMine}" Value="True">
                                    <Setter Property="HorizontalOptions" Value="End" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>

                            <Label IsVisible="{Binding WasForwarded}" Style="{StaticResource RowMeta}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{controls:Translate 'Forwarded from'}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding ForwardedFromDisplayName}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- What this message is answering. The quote travels with the reply rather
                                 than being looked up, so it still reads right after the original was
                                 edited or deleted - see ReplyMessagePayload. -->
                            <Border IsVisible="{Binding IsReply}" Padding="8,4" StrokeThickness="0"
                                    BackgroundColor="{DynamicResource AccentSubtle}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding QuotedPreview}" FontSize="12" LineBreakMode="TailTruncation"
                                       MaxLines="2" Style="{StaticResource SubtleLabel}" />
                            </Border>

                            <!-- The bubble itself. One corner is squared off on the side it was written
                                 from, which is the whole of what says which way a message is going -
                                 see .chat-bubble's border-bottom-*-radius. -->
                            <Border Padding="13,9" StrokeThickness="0"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14,14,4,14" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                        <Setter Property="StrokeShape">
                                            <RoundRectangle CornerRadius="14,14,14,4" />
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Text}" FontSize="13.5" LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource AccentOn}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Somebody asking to be allowed to change something of yours. Nothing to
                                         accept in one tap: widening access means sharing it again. -->
                                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsEditAccessRequest}">
                                        <Label Text="{controls:Translate 'Asked to edit'}" FontSize="12"
                                               Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding EditAccessRequestName}" FontAttributes="Bold"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <!-- An offer to share something, which arrives as an ordinary message whose
                                         plaintext is structured. Before this the phone showed the JSON. -->
                                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsInvitation}">
                                        <Label Text="{controls:Translate 'Shared something with you'}" FontSize="12"
                                               Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding InvitationName}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                        <Button Text="{controls:Translate 'Accept'}" FontSize="12" Padding="12,4"
                                                HorizontalOptions="Start" IsVisible="{Binding CanBeAccepted}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.AcceptShareCommand, x:DataType=chat:ConversationPage}"
                                                CommandParameter="{Binding .}" />
                                        <Label Text="{controls:Translate 'Already accepted'}" FontSize="12"
                                               IsVisible="{Binding WasAccepted}" Style="{StaticResource SubtleLabel}" />
                                    </VerticalStackLayout>

                                    <!-- A message sealed under a key pair since replaced can never be opened. -->
                                    <Label IsVisible="{Binding CannotBeOpened}" FontSize="12"
                                           Style="{StaticResource SubtleLabel}">
                                        <Label.Text>
                                            <controls:Translate Text="This message can't be opened on this device." />
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>

                            <!-- .chat-bubble-meta: when it was sent, whether it has landed, and the one
                                 trigger for everything else that can be done to it. -->
                            <HorizontalStackLayout Spacing="8">
                                <HorizontalStackLayout.Triggers>
                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                    </DataTrigger>
                                </HorizontalStackLayout.Triggers>

                                <Label Text="{Binding SentAt}" FontSize="10.5" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
                                <Label Text="{controls:Translate 'Waiting to send'}" IsVisible="{Binding IsWaitingToSend}"
                                       FontSize="10.5" VerticalOptions="Center" TextColor="{DynamicResource Accent}" />
                                <!-- Only ever on the reader's own messages - see ReadableChatMessage. -->
                                <Label Text="{controls:Translate 'Read'}" IsVisible="{Binding IsReadByThem}"
                                       FontSize="10.5" VerticalOptions="Center" TextColor="{DynamicResource Accent}" />

                                <!-- One trigger rather than three buttons, as Orbit.Web's bubbles have. -->
                                <controls:OverflowMenu IsVisible="{Binding HasActions}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowMessageMenuCommand, x:DataType=chat:ConversationPage}"
                                                       CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- Picking where to pass a message on to. Replaces the conversation rather than sitting over
             it, the same way choosing who to add to a group does. -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsForwarding}">
            <Label Grid.Row="0" Text="{controls:Translate 'Forward to'}" FontAttributes="Bold" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding ForwardTargets}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:LocalContact">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}" FontSize="17" />
                                <Label Text="{Binding UserName, StringFormat='@{0}'}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{controls:Translate 'Send'}" FontSize="13" Padding="14,4"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ForwardToCommand, x:DataType=chat:ConversationPage}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button Grid.Row="3" Text="{controls:Translate 'Cancel'}" Command="{Binding CancelForwardingCommand}"
                IsVisible="{Binding IsForwarding}"
                Style="{StaticResource LinkButton}" />

        <!-- Somebody who has never opened chat has no key to encrypt for. Saying so is the difference
             between a screen that is waiting on them and a screen that looks broken. -->
        <Label Grid.Row="3" Text="{Binding CannotWriteReason}" IsVisible="{Binding CannotWrite}"
               FontSize="13" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

        <VerticalStackLayout Grid.Row="3" Spacing="4" IsVisible="{Binding CanCompose}">
            <!-- What the box is answering, said above it: a reply that named nothing on screen would
                 leave the reader guessing what they were about to answer. -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasReplyingTo}">
                <Label Grid.Column="0" Text="{controls:Translate 'Replying to'}" FontSize="12"
                       VerticalOptions="Center" Style="{StaticResource SubtleLabel}" />
                <Label Grid.Column="1" Text="{Binding ReplyingToPreview}" FontSize="12"
                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="✕" SemanticProperties.Description="{controls:Translate 'Cancel reply'}" FontSize="12" Padding="6,0" MinimumWidthRequest="0"
                        Command="{Binding CancelReplyingCommand}" Style="{StaticResource LinkButton}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="{controls:Translate 'Message'}" Text="{Binding Draft}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                       ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Send'}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SendCommand}" />
                <Button Grid.Column="2" Text="{controls:Translate 'Cancel'}" IsVisible="{Binding IsEditing}"
                        Command="{Binding CancelEditingCommand}"
                        Style="{StaticResource LinkButton}" />
            </Grid>
        </VerticalStackLayout>

        <!-- These screens replace each other rather than stacking, so there is no navigation bar to go
             back through - every screen carries its own way out. -->
        <Button Grid.Row="4" Text="{controls:Translate 'Back to chat'}" Command="{Binding GoBackCommand}"
                Style="{StaticResource LinkButton}" />

    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=chat:ConversationPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
