<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Chat.ContactsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:data="clr-namespace:Orbit.Mobile.Data;assembly=Orbit.Mobile"
    xmlns:chat="clr-namespace:Orbit.Maui.Features.Chat"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Chat;assembly=Orbit.Mobile"
    x:DataType="screens:ContactsViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Contacts'}">

    <Grid RowDefinitions="Auto,*,Auto">


        <!-- In place of the whole section when this account has not unlocked it. -->
        <controls:FeatureLocked Grid.Row="1" Margin="20" VerticalOptions="Start"
                                IsVisible="{Binding IsLocked}"
                                Explanation="{Binding LockedExplanation}"
                                OpenAccountCommand="{Binding OpenAccountCommand}" />

    <!-- A search field and the column of everybody this reader can talk to - people and groups in one
         list, which is the same question asked twice otherwise. What is put away is behind the menu
         under the screen's name, where it is a way of reading the list rather than a switch above it. -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="20,14,20,0" RowSpacing="12"
          IsVisible="{Binding IsUnlocked}">

        <!-- The list below only holds people already spoken to, so without this there is no way to
             start a conversation at all from this device. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="{controls:Translate 'Email address or login'}"
                   Text="{Binding SearchQuery}" Keyboard="Email"
                   ReturnType="Search" ReturnCommand="{Binding SearchCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Find'}" IsEnabled="{Binding Connection.IsMet}"
                    Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasFoundSomebody}">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding FoundPerson.DisplayName}" Style="{StaticResource ItemCardName}" />
                <Label Text="{Binding FoundPerson.UserName, StringFormat='@{0}'}" Style="{StaticResource RowMeta}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <!-- Who they are, before deciding whether to write to them at all. -->
                <Button Text="{controls:Translate 'Info'}" FontSize="13" Padding="12,4"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenContactInfoCommand}"
                        CommandParameter="{Binding FoundPerson.UserId}" />
                <Button Text="{controls:Translate 'Message'}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenConversationCommand}"
                        CommandParameter="{Binding FoundPerson}" />
            </HorizontalStackLayout>
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Contacts}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenConversationCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{Binding Message}" Padding="0,12" LineBreakMode="WordWrap" Style="{StaticResource EmptyHint}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:LocalContact">
                        <VerticalStackLayout Padding="0,6" Spacing="2">
                            <!-- The same row every list of people is drawn with - see PersonRow. -->
                            <controls:PersonRow SubjectId="{Binding UserId}" Name="{Binding DisplayName}"
                                                Subtitle="{Binding UserName, StringFormat='@{0}'}"
                                                Status="{Binding PresenceStatus}"
                                                UnreadCount="{Binding UnreadCount}"
                                                HasUnseenAction="{Binding HasSomethingWaiting}">
                                <!-- Kept at the top of the list, and said on the row so it is clear why
                                     it is up there. The slot PersonRow keeps for it, in the place the
                                     browser puts its own pin. -->
                                <controls:PersonRow.Pin>
                                    <Label Text="📌" FontSize="11" IsVisible="{Binding IsPinned}"
                                           SemanticProperties.Description="{controls:Translate 'Pinned'}" />
                                </controls:PersonRow.Pin>
                                <controls:PersonRow.Menu>
                                    <!-- Putting one away, bringing it back, and emptying it - the three
                                         the browser keeps behind a row's own menu. Its own button rather
                                         than a swipe: a swipe is undiscoverable and this list is also
                                         read by somebody who cannot see it. -->
                                    <controls:OverflowMenu
                                        Command="{Binding ShowContactMenuCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=chat:ContactsPage}"
                                        CommandParameter="{Binding .}" />
                                </controls:PersonRow.Menu>
                            </controls:PersonRow>

                            <!-- Under the row rather than in it: what is waiting on an answer is about
                                 this conversation's state, not about who the person is. -->
                            <Label Text="{controls:Translate 'Waiting for them to accept your request'}"
                                   IsVisible="{Binding IsPendingApprovalFromOtherParty}"
                                   FontSize="12" TextColor="{DynamicResource Accent}" />
                            <Label Text="{controls:Translate 'Wants to chat with you'}"
                                   IsVisible="{Binding RequiresApprovalFromCurrentUser}"
                                   FontSize="12" TextColor="{DynamicResource Accent}" />
                            <!-- The command lives on the page's view model, not on the row, and a
                                 RelativeSource walks the *visual* tree - so this names the page and
                                 goes through its typed ViewModel property. -->
                            <Button Text="{controls:Translate 'Accept'}"
                                    IsVisible="{Binding RequiresApprovalFromCurrentUser}"
                                    HorizontalOptions="Start" Padding="16,4" FontSize="13"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ViewModel.AcceptCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=chat:ContactsPage}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- The groups this reader is in, under the people, in the same column and scrolling
                     with them - the design puts contacts and groups in one list, and they were two
                     screens with a button between them. In the footer rather than in a list of their
                     own so the column reads as one thing. -->
                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="0" Padding="0,4,0,0"
                                         BindableLayout.ItemsSource="{Binding Groups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="data:LocalChatGroup">
                                <!-- The press is a Button over the row rather than a gesture on it: a
                                     layout carrying a gesture is focusable to a screen reader but not
                                     clickable, so the double tap that activates a control does nothing
                                     to it. See ItemCard, which does the same over its whole card. -->
                                <Grid>
                                    <controls:PersonRow SubjectId="{Binding Id}" Name="{Binding Name}"
                                                        UnreadCount="{Binding UnreadCount}"
                                                        HasUnseenAction="{Binding HasSomethingWaiting}" />
                                    <Button BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                            MinimumHeightRequest="0" MinimumWidthRequest="0"
                                            SemanticProperties.Description="{Binding Name}"
                                            Command="{Binding ViewModel.OpenGroupCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=chat:ContactsPage}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

    </Grid>
        <!-- Across the foot, under everything the page itself draws - see AdBanner, and .ad-banner
             in Orbit.Web's app.css, which is the same bar on a narrow window. -->
        <controls:AdBanner Grid.Row="2" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=chat:ContactsPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
