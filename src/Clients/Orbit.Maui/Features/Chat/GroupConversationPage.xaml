<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Chat.GroupConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:mobile="clr-namespace:Orbit.Mobile.Chat;assembly=Orbit.Mobile"
    xmlns:chat="clr-namespace:Orbit.Maui.Features.Chat"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Chat;assembly=Orbit.Mobile"
    x:DataType="screens:GroupConversationViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <controls:GroupDeliveryConverter x:Key="GroupDelivery" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Padding="20" RowSpacing="10">

        <Label Grid.Row="0" Text="{Binding Title}" FontSize="22" FontAttributes="Bold" />
        <!-- The member list doubles as the way into managing it, the way the web's header does. -->
        <Button Grid.Row="1" Text="{Binding Members}" Command="{Binding OpenMembersCommand}"
                FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" BackgroundColor="Transparent"
                Padding="0" HorizontalOptions="Start" LineBreakMode="TailTruncation" />
        <Label Grid.Row="2" Text="{Binding Status}" IsVisible="{Binding HasStatus}"
               FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" LineBreakMode="WordWrap" />

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'No messages yet.'}" Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="mobile:ReadableChatMessage">
                        <VerticalStackLayout Padding="0,8" Spacing="2">
                            <!-- Who wrote it, which a one-to-one conversation gets from the title. -->
                            <Label Text="{Binding SenderName}" IsVisible="{Binding HasSenderName}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{Binding Text}" LineBreakMode="WordWrap" />
                            <Label IsVisible="{Binding CannotBeOpened}"
                                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                <Label.Text>
                                    <controls:Translate Text="This message can't be opened on this device." />
                                </Label.Text>
                            </Label>
                            <Label Text="{Binding SentAtUtc, StringFormat='{0:g}'}"
                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <Label Text="{controls:Translate 'Waiting to send'}" IsVisible="{Binding IsWaitingToSend}"
                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <!-- How far this got. Read means every other member has seen it - one still
                                 behind and it is only delivered, which is the honest reading. -->
                            <Label IsVisible="{Binding HasGroupDelivery}" FontSize="11"
                                   Text="{Binding IsReadByTheWholeGroup, Converter={StaticResource GroupDelivery}}"
                                   TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <!-- One trigger rather than a row of buttons, as the web's group chat now
                                 does it and as a one-to-one conversation here already did. Only on the
                                 reader's own messages, and only once the server has one - see
                                 ReadableChatMessage.CanBeChanged. -->
                            <!-- On anybody's message, not only the reader's own: "who has read this"
                                 is worth asking about a message somebody else wrote too. -->
                            <Button Text="⋯" FontSize="18" Padding="10,0" BackgroundColor="Transparent"
                                    HorizontalOptions="Start" IsVisible="{Binding IsInAGroup}"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowMessageMenuCommand, x:DataType=chat:GroupConversationPage}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding CanWrite}">
            <Entry Grid.Column="0" Placeholder="{controls:Translate 'Message'}" Text="{Binding Draft}"
                   ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Send'}" Command="{Binding SendCommand}" />
            <Button Grid.Column="2" Text="{controls:Translate 'Cancel'}" IsVisible="{Binding IsEditing}"
                    Command="{Binding CancelEditingCommand}"
                    Style="{StaticResource LinkButton}" />
        </Grid>

        <Button Grid.Row="5" Text="{controls:Translate 'Back to groups'}" Command="{Binding GoBackCommand}"
                Style="{StaticResource LinkButton}" />

    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
