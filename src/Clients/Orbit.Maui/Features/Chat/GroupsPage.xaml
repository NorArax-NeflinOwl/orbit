<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Chat.GroupsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:data="clr-namespace:Orbit.Mobile.Data;assembly=Orbit.Mobile"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Chat;assembly=Orbit.Mobile"
    xmlns:chat="clr-namespace:Orbit.Maui.Features.Chat"
    x:DataType="screens:GroupsViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Groups'}">

    <ContentPage.Resources>
        <controls:GroupSizeConverter x:Key="GroupSize" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">


        <!-- In place of the whole section when this account has not unlocked it. -->
        <controls:FeatureLocked Grid.Row="1" Margin="20" VerticalOptions="Start"
                                IsVisible="{Binding IsLocked}"
                                Explanation="{Binding LockedExplanation}"
                                OpenAccountCommand="{Binding OpenAccountCommand}" />

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Padding="16,16,16,28" RowSpacing="12"
          IsVisible="{Binding IsUnlocked}">

        <!-- The plus left of the name, where every other list screen keeps it and where Orbit.Web's
             chat list keeps its own "new group". It opens the picker below rather than a screen: a
             group is who is in it, and that is chosen from the same list this page already draws. -->
        <controls:PageHeader Grid.Row="0" Title="{controls:Translate 'Groups'}">
            <controls:PageHeader.LeadingAction>
                <controls:IconButton Variant="Add" Data="M10,4 V16 M4,10 H16"
                                     IsVisible="{Binding IsNotCreating}"
                                     Description="{controls:Translate 'New group'}"
                                     Command="{Binding StartCreatingCommand}" />
            </controls:PageHeader.LeadingAction>
            <controls:PageHeader.Subtitle>
                <controls:Translate Text="Conversations with more than one other person." />
            </controls:PageHeader.Subtitle>
        </controls:PageHeader>
        <Label Grid.Row="1" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
               LineBreakMode="WordWrap" Style="{StaticResource InfoLabel}" />

        <!-- Offered only once something has been put away - see ContactsPage for the rule. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasArchive}">
            <Label Grid.Column="0" Text="{controls:Translate 'Show what is put away'}" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding IsShowingArchive}" VerticalOptions="Center"
                    SemanticProperties.Description="{controls:Translate 'Show what is put away'}" />
        </Grid>

        <RefreshView Grid.Row="3" IsVisible="{Binding IsNotCreating}"
                     IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Groups}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenGroupCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <!-- No EmptyView: the label above already says why the list is empty, and a second
                     copy of the same sentence read as a bug. -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:LocalChatGroup">
                        <!-- The same row every list of people is drawn with - see PersonRow. A group
                             carries no presence dot: a group is not somewhere anybody is or is not. -->
                        <controls:PersonRow Id="{Binding Id}" Name="{Binding Name}"
                                            Subtitle="{Binding Members.Count, Converter={StaticResource GroupSize}}">
                            <!-- <inheritdoc cref="ContactsPage" /> - the same mark, in the same slot. -->
                            <controls:PersonRow.Pin>
                                <Label Text="📌" FontSize="11" IsVisible="{Binding IsPinned}"
                                       SemanticProperties.Description="{controls:Translate 'Pinned'}" />
                            </controls:PersonRow.Pin>
                            <controls:PersonRow.Menu>
                                <!-- Putting a group away, bringing it back, and leaving it - see
                                     ContactsPage for why this is a button rather than a swipe. -->
                                <controls:OverflowMenu
                                    Command="{Binding ShowGroupMenuCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=chat:GroupsPage}"
                                    CommandParameter="{Binding .}" />
                            </controls:PersonRow.Menu>
                        </controls:PersonRow>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- Choosing who a new group holds. Replaces the list rather than sitting above it, so the
             checkboxes are not competing with a second scrolling area on a phone screen. -->
        <Grid Grid.Row="3" IsVisible="{Binding IsCreating}" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <Entry Grid.Row="0" Placeholder="{controls:Translate 'Group name'}" Text="{Binding NewGroupName}" />
            <Label Grid.Row="1" Text="{controls:Translate 'Who is in it'}" FontAttributes="Bold" />
            <CollectionView Grid.Row="2" ItemsSource="{Binding Candidates}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:SelectableContact">
                        <Grid ColumnDefinitions="Auto,*" Padding="0,8" ColumnSpacing="8">
                            <!-- Named after the person it is beside, not after the section: every row would
                                 otherwise announce the same thing. -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                      SemanticProperties.Description="{Binding DisplayName}" />
                            <Label Grid.Column="1" Text="{Binding DisplayName}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Beside the list rather than over it: this row is where "New group" sits when nobody is
             creating one, and in the row the picker fills it stretched to the picker's full height,
             putting a button over every name in it. -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCreating}">
            <Button Grid.Column="0" Text="{controls:Translate 'Create'}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Cancel'}" Command="{Binding CancelCreatingCommand}"
                    Style="{StaticResource LinkButton}" />
        </Grid>

        <Button Grid.Row="5" Text="{controls:Translate 'Back to chat'}" Command="{Binding GoBackCommand}"
                Style="{StaticResource LinkButton}" />

    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=chat:GroupsPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
