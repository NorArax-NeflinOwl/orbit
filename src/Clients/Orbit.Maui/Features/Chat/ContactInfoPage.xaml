<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Chat.ContactInfoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Chat;assembly=Orbit.Mobile"
    x:DataType="screens:ContactInfoViewModel"
    Title="{controls:Translate 'Contact'}">

    <Grid RowDefinitions="Auto,*,Auto">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,28" Spacing="14">

                <controls:PageHeader Title="{Binding DisplayName}">
                    <controls:PageHeader.Subtitle>
                        <controls:Translate Text="Who this is, and how to reach them." />
                    </controls:PageHeader.Subtitle>
                </controls:PageHeader>

                <!-- The same row every list of people is drawn with, so the person reads the same here
                     as in the list this was opened from - see PersonRow. -->
                <Border Style="{StaticResource CardBorder}" Padding="18,14">
                    <VerticalStackLayout Spacing="10">
                        <controls:PersonRow Id="{Binding UserIdShown}" Name="{Binding DisplayName}"
                                            Subtitle="{Binding UserName}" Status="{Binding PresenceStatus}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="6"
                              RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{controls:Translate 'Email address'}"
                                   IsVisible="{Binding HasEmail}" FontSize="13" Style="{StaticResource SubtleLabel}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Email}" IsVisible="{Binding HasEmail}"
                                   FontSize="13" LineBreakMode="TailTruncation" HorizontalTextAlignment="End" />

                            <Label Grid.Row="1" Grid.Column="0" Text="{controls:Translate 'Status'}"
                                   FontSize="13" Style="{StaticResource SubtleLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Presence}" FontSize="13"
                                   HorizontalTextAlignment="End" />

                            <Label Grid.Row="2" Grid.Column="0" Text="{controls:Translate 'Last message'}"
                                   IsVisible="{Binding HasLastMessage}" FontSize="13" Style="{StaticResource SubtleLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding LastMessage}"
                                   IsVisible="{Binding HasLastMessage}" FontSize="13" HorizontalTextAlignment="End" />
                        </Grid>

                        <!-- What is waiting on somebody, said plainly rather than left to be discovered
                             by a message that goes nowhere. -->
                        <Label Text="{Binding WaitingOn}" IsVisible="{Binding IsWaitingOnSomebody}"
                               FontSize="12" LineBreakMode="WordWrap" TextColor="{DynamicResource Accent}" />

                        <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                               FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The one thing there is to do with a person. Offered only where there is a
                     conversation to open and this account may chat at all. -->
                <!-- The one thing there is to do with a person, and the only thing this screen is
                     for - so it is the filled button (.btn-primary), not one of three that look alike.
                     Offered only where there is a conversation to open and this account may chat. -->
                <Button Text="{controls:Translate 'Open chat'}" IsVisible="{Binding IsConversationOffered}"
                        HorizontalOptions="Start" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenConversationCommand}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Read, never filled in, so the bar carries no Save - only the way out. -->
        <controls:EditorRail Grid.Row="2" CancelCommand="{Binding GoBackCommand}" />

        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
