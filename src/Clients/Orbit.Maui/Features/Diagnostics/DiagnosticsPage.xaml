<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Diagnostics.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Diagnostics;assembly=Orbit.Mobile"
    x:DataType="screens:DiagnosticsViewModel"
    Title="{controls:Translate 'Diagnostics'}">

    <Grid RowDefinitions="Auto,*,Auto">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,28" Spacing="12">

                <Label Text="{controls:Translate 'Diagnostics'}" FontSize="26" FontAttributes="Bold" />
                <Label FontSize="13" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}">
                    <Label.Text>
                        <controls:Translate Text="Orbit's own log, on this phone. Nothing leaves it unless you send it." />
                    </Label.Text>
                </Label>

                <Label Text="{Binding DeviceSummary}" FontSize="12" LineBreakMode="WordWrap"
                       Style="{StaticResource SubtleLabel}" />

                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12"
                       LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{controls:Translate 'Record everything'}" />
                        <Label Text="{controls:Translate 'Warnings and errors otherwise. Goes back to that on the next launch.'}"
                               FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding IsVerbose}" VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Record everything'}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="{controls:Translate 'Send to Orbit'}" Command="{Binding SendCommand}" />
                    <Button Grid.Column="1" Text="{controls:Translate 'Clear'}" Command="{Binding ClearCommand}"
                            Style="{StaticResource DestructiveButton}" />
                </Grid>

                <Label Text="{controls:Translate 'Nothing has been logged yet.'}" IsVisible="{Binding HasNothing}"
                       Style="{StaticResource SubtleLabel}" HorizontalOptions="Center" Margin="0,20" />

                <!-- Monospaced and horizontally scrollable: a log line is a fixed shape, and wrapping one
                     makes the timestamps stop lining up, which is most of how a log is read. -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Default">
                    <!-- Whatever monospace the platform has, which is what Orbit.Web asks for too - its
                         stack ends in the generic `monospace` rather than naming one face. "Menlo" is
                         a real font on an iPhone and nothing at all on Android, where asking for it by
                         name threw from inside the font manager every time a log line was drawn. -->
                    <Label Text="{Binding Preview}" FontSize="10" LineBreakMode="NoWrap"
                           FontFamily="{OnPlatform Android=monospace, iOS=Menlo, Default=monospace}" />
                </ScrollView>

                <Button Text="{controls:Translate 'Back to account'}" Command="{Binding GoBackCommand}"
                        Style="{StaticResource LinkButton}" />

            </VerticalStackLayout>
        </ScrollView>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
