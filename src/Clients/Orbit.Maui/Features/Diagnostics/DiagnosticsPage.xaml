<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Diagnostics.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Diagnostics;assembly=Orbit.Mobile"
    x:DataType="screens:DiagnosticsViewModel"
    Title="{controls:Translate 'Diagnostics'}">

    <Grid RowDefinitions="Auto,*,Auto">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18,20,28" Spacing="12">

                <!-- No heading of its own: the screen's name is in the bar, and this page was the last
                     one still drawing it twice. -->
                <Label Text="{Binding DeviceSummary}" FontSize="12" LineBreakMode="WordWrap"
                       Style="{StaticResource SubtleLabel}" />

                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12"
                       LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                <controls:OrbitLoading IsRunning="{Binding IsBusy}" RingSize="30" HorizontalOptions="Start" />

                <!-- One setting, so it is a row between hairlines rather than a card of one - the
                     account screen's own shape, at the one-row size. -->
                <Grid ColumnDefinitions="*,Auto" Padding="0,14" Margin="0,4,0,0">
                    <BoxView Grid.ColumnSpan="2" Style="{StaticResource Hairline}" VerticalOptions="Start"
                             Margin="0,-14,0,0" />
                    <BoxView Grid.ColumnSpan="2" Style="{StaticResource Hairline}" VerticalOptions="End"
                             Margin="0,0,0,-14" />
                    <controls:FieldHint Grid.Column="0" VerticalOptions="Center"
                                        Label="{controls:Translate 'Record everything'}"
                                        Text="{controls:Translate 'Warnings and errors otherwise. Goes back to that on the next launch.'}" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsVerbose}" VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Record everything'}" />
                </Grid>

                <!-- What the screen is for is outlined in the accent; what cannot be undone is outlined
                     in the danger colour. Neither is filled, like every other button in this design. -->
                <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                    <Button Text="{controls:Translate 'Send to Orbit'}" Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Text="{controls:Translate 'Clear'}" Command="{Binding ClearCommand}"
                            Style="{StaticResource DangerButton}" />
                </HorizontalStackLayout>

                <Label Text="{controls:Translate 'Nothing has been logged yet.'}" IsVisible="{Binding HasNothing}"
                       Style="{StaticResource EmptyHint}" HorizontalOptions="Center" Margin="0,20" />

                <!-- The log itself, in a hairline box: it is a thing being looked at rather than
                     something the page is saying, and without an edge it read as loose text under the
                     buttons. The one monospaced thing left in the app, and deliberately - a log line is
                     a fixed shape and the timestamps have to line up. -->
                <Border StrokeThickness="1" Padding="10,8" BackgroundColor="Transparent"
                        IsVisible="{Binding HasSomething}"
                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Default">
                        <!-- Whatever monospace the platform has, which is what Orbit.Web asks for too -
                             its stack ends in the generic `monospace` rather than naming one face.
                             "Menlo" is a real font on an iPhone and nothing at all on Android, where
                             asking for it by name threw from inside the font manager every time a log
                             line was drawn. -->
                        <Label Text="{Binding Preview}" FontSize="10" LineBreakMode="NoWrap"
                               FontFamily="{OnPlatform Android=monospace, iOS=Menlo, Default=monospace}" />
                    </ScrollView>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        <!-- What the screen is for, behind the "?" beside its name - see NavigationBar.Description. The
             element form because the sentence has an apostrophe, which the quoted form cannot carry. -->
        <controls:NavigationBar Grid.Row="0">
            <controls:NavigationBar.Description>
                <controls:Translate Text="Orbit's own log, on this phone. Nothing leaves it unless you send it." />
            </controls:NavigationBar.Description>
        </controls:NavigationBar>
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
