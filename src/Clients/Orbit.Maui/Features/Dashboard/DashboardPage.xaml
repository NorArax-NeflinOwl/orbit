<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:dashboard="clr-namespace:Orbit.Maui.Features.Dashboard"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Dashboard;assembly=Orbit.Mobile"
    x:DataType="screens:DashboardViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Dashboard'}">

    <Grid RowDefinitions="Auto,*,Auto">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,28" Spacing="14">

                <!-- What is happening today, rather than how much there is in total. The whole strip is
                     the way to the calendar: it is a summary of a day, and the page that shows a day is
                     the calendar.

                     It opens the screen rather than sitting under a heading, because the heading is in
                     the bar now - and the date set large in the display face is what the design puts
                     first on this screen. No card around it: a rule under the date carries the same
                     separation for none of the weight. -->
                <Grid Margin="0,4,0,0">
                    <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="0">
                        <VerticalStackLayout Spacing="10" BindingContext="{Binding Today}"
                                             x:DataType="screens:TodaySummary">
                            <Label Text="{controls:Translate 'Today'}" Style="{StaticResource PanelHeading}"
                                   TextColor="{DynamicResource Accent}" />
                            <!-- 28, not the design's 34: the design was drawn in Cormorant Garamond,
                                 which is a narrow face, and Space Grotesk at 34 breaks
                                 "Wednesday, 9 September" over two lines - the biggest thing on the
                                 app's first screen, wrapping. -->
                            <Label Text="{Binding Date}" FontFamily="OrbitDisplayLight" FontSize="28" />
                            <BoxView Style="{StaticResource Hairline}" Margin="0,2,0,4" />

                            <!-- One baseline, not three columns: a coloured dot, the number, and what
                                 it counts beside it - which is the design's shape, and Orbit.Web's own.
                                 Stacked, the label sat under its number in small caps and read as a
                                 heading over the next one along rather than as part of its own.

                                 The colour is the dot's, so the numbers are all one colour and it is the
                                 dot that says which of the three a glance has landed on - a number in
                                 the task colour beside a number in the accent reads as two kinds of
                                 emphasis rather than as two subjects.

                                 The labels are shorter than the web's for the width: three of "tasks due
                                 today" side by side do not fit in 412 points, and the heading over them
                                 already says "Today". -->
                            <HorizontalStackLayout Spacing="16">
                                <HorizontalStackLayout Spacing="7">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                             VerticalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource TaskLight}, Dark={StaticResource TaskDark}}" />
                                    <Label Text="{Binding TasksDueTodayReads}" FontFamily="OrbitDisplay"
                                           FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="{controls:Translate 'tasks due'}" FontSize="12"
                                           VerticalOptions="Center" Style="{StaticResource ItemCardBody}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="7">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                             VerticalOptions="Center" Color="{DynamicResource Accent}" />
                                    <Label Text="{Binding EventsTodayReads}" FontFamily="OrbitDisplay"
                                           FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="{controls:Translate 'events'}" FontSize="12"
                                           VerticalOptions="Center" Style="{StaticResource ItemCardBody}" />
                                </HorizontalStackLayout>

                                <!-- Only when somebody is actually waiting to be answered, as Orbit.Web
                                     has it: a standing "0 new chat requests" is not news. -->
                                <HorizontalStackLayout Spacing="7" IsVisible="{Binding HasChatRequests}">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                             VerticalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    <Label Text="{Binding PendingChatRequests}" FontFamily="OrbitDisplay"
                                           FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="{controls:Translate 'chat requests'}" FontSize="12"
                                           VerticalOptions="Center" Style="{StaticResource ItemCardBody}" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Over the card rather than around it: a Border is not a control, and wrapping the
                         whole strip in a Button would take the card's own look with it. -->
                    <Button BackgroundColor="Transparent" BorderWidth="0"
                            SemanticProperties.Description="{controls:Translate 'Open the calendar'}"
                            Command="{Binding OpenCalendarCommand}" />
                </Grid>

                <Label Text="{controls:Translate 'Nothing here yet. Add a note or a task to get started.'}"
                       IsVisible="{Binding HasNothing}" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}"
                       HorizontalOptions="Center" Margin="0,20" LineBreakMode="WordWrap" />

                <!-- Which is a different thing from having nothing, and Orbit.Web says so in the same
                     place: an account full of work told to add a note reads as work that has been lost. -->
                <Label Text="{controls:Translate 'Everything here is hidden. The menu at the top right brings it back.'}"
                       IsVisible="{Binding EverythingIsHidden}" Style="{StaticResource EmptyHint}"
                       HorizontalOptions="Center" Margin="0,20" LineBreakMode="WordWrap" />

                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Cards}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="screens:DashboardCard">
                            <!-- The same card every list of things is drawn with - see ItemCard. The
                                 heading is the way into the section itself, as it is on Orbit.Web: the
                                 dashboard shows the few most relevant rows and the section has the
                                 rest. The rows below open their own things, which is why the name
                                 carries the press rather than the whole card. -->
                            <controls:ItemCard Name="{Binding Title}"
                                               HasUnseenAction="{Binding HasUnseenAction}"
                                               IsPinned="{Binding IsPinned}"
                                               NameCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.OpenSectionCommand, x:DataType=dashboard:DashboardPage}"
                                               NameCommandParameter="{Binding .}">
                                <controls:ItemCard.Pin>
                                    <controls:PinButton IsPinned="{Binding IsPinned}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.TogglePinCommand, x:DataType=dashboard:DashboardPage}"
                                                        CommandParameter="{Binding .}" />
                                </controls:ItemCard.Pin>

                                <controls:ItemCard.Menu>
                                    <!-- The card's own overflow, as Orbit.Web's CardFilterMenu is: what
                                         this card is narrowed to. One choice and then done, unlike the
                                         page's menu above, which is a row of settings. -->
                                    <controls:OverflowMenu
                                        IsVisible="{Binding CanBeFiltered}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowCardFilterCommand, x:DataType=dashboard:DashboardPage}"
                                        CommandParameter="{Binding .}" />
                                </controls:ItemCard.Menu>

                                <controls:ItemCard.Body>
                                    <VerticalStackLayout Spacing="0">
                                        <!-- What the filter left, said where the rows would be. A card
                                             narrowed to nothing keeps its menu in its header, so the
                                             choice that emptied it can be undone from the page that
                                             made it - see Orbit.Web's own hint in the same place. -->
                                        <Label Text="{controls:Translate 'Nothing here matches the filter. Change it above to see the rest.'}"
                                               Style="{StaticResource EmptyHint}"
                                               IsVisible="{Binding HasNothingMatching}" />

                                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Rows}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="screens:DashboardRow">
                                                    <!-- The row every list of facts is drawn with - see
                                                         Row, and Orbit.Web's .list-row, which draws
                                                         these rows there too. -->
                                                    <!-- [name .... tags priority] [when]: what it is
                                                         called, the reader's own tags for it (notes and
                                                         lists only, in the account's colours, as
                                                         Orbit.Web's TagChips on the same rows), the
                                                         priority where it says something, and when it
                                                         last mattered.

                                                         The design gives this row three more - a colour
                                                         dot, an initials ring with a presence dot on it,
                                                         and a 48x3 progress bar - and they are left off
                                                         deliberately. A card here holds six rows to be
                                                         glanced down and the section itself is one press
                                                         away for the rest, so three ornaments on every
                                                         row of five cards is most of the first screen
                                                         given over to furniture. -->
                                                    <controls:Row Title="{Binding Title}"
                                                                  HasNews="{Binding HasNews}"
                                                                  HasDivider="False"
                                                                  PressedCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.OpenCommand, x:DataType=dashboard:DashboardPage}"
                                                                  PressedCommandParameter="{Binding .}">
                                                        <controls:Row.Trailing>
                                                            <HorizontalStackLayout Spacing="8">
                                                                <controls:TagChipsView BindingContext="{Binding Tags}"
                                                                                       VerticalOptions="Center" />
                                                                <!-- Only where it says something, as
                                                                     Orbit.Web badges the same rows -
                                                                     see PriorityChoice.IsWorthSaying. -->
                                                                <Border Style="{StaticResource FilterChip}"
                                                                        Padding="7,2" VerticalOptions="Center"
                                                                        IsVisible="{Binding HasPriority}">
                                                                    <Label Text="{Binding Priority}" Style="{StaticResource FilterChipLabel}" />
                                                                </Border>
                                                                <Label Text="{Binding Detail}" Style="{StaticResource RowMeta}"
                                                                       VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </controls:Row.Trailing>
                                                    </controls:Row>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </controls:ItemCard.Body>

                                <!-- How many things are on the card, at its foot and aligned with the
                                     name - where Orbit.Web puts it, and where a card with nothing to
                                     say leaves nothing floating against the right margin. -->
                                <controls:ItemCard.Extras>
                                    <Border Style="{StaticResource CardCount}" HorizontalOptions="Start">
                                        <Label Text="{Binding Count}" Style="{StaticResource CardCountLabel}" />
                                    </Border>
                                </controls:ItemCard.Extras>
                            </controls:ItemCard>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
        <!-- Across the foot, under everything the page itself draws - see AdBanner, and .ad-banner
             in Orbit.Web's app.css, which is the same bar on a narrow window. -->
        <controls:AdBanner Grid.Row="2" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=dashboard:DashboardPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
