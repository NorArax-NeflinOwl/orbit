<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Sharing.InvitationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:sharing="clr-namespace:Orbit.Mobile.Screens.Sharing;assembly=Orbit.Mobile"
    x:DataType="sharing:InvitationViewModel"
    Title="{controls:Translate 'Shared with you'}">

    <Grid RowDefinitions="Auto,*">
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18,20,28" Spacing="14">

                <controls:OrbitLoading IsRunning="{Binding IsLoading}" HorizontalOptions="Center" />

                <!-- Kind first, then the thing's own name in the display face - the shape the link
                     screen beside this one opens with, and the shape a note opens with. -->
                <Label Text="{Binding Kind}" IsVisible="{Binding WasFound}" Style="{StaticResource PanelHeading}" />

                <Label Text="{Binding Title}" IsVisible="{Binding HasTitle}" FontFamily="OrbitDisplay"
                       FontSize="30" FontAttributes="Bold" LineBreakMode="WordWrap" Margin="0,-8,0,0" />

                <Label Text="{Binding SharedBy}" IsVisible="{Binding WasFound}" FontSize="12"
                       Style="{StaticResource SubtleLabel}" />

                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" LineBreakMode="WordWrap" />

                <Button Text="{controls:Translate 'Accept'}" IsVisible="{Binding CanBeAccepted}"
                        IsEnabled="{Binding IsNotAccepting}"
                        HorizontalOptions="Start" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AcceptCommand}" />

                <Label Text="{controls:Translate 'Accepting puts a copy in your account. It appears once Orbit next syncs.'}"
                       IsVisible="{Binding CanBeAccepted}" FontSize="12" LineBreakMode="WordWrap"
                       Style="{StaticResource SubtleLabel}" />

                <Button Text="{controls:Translate 'Open where it landed'}" IsVisible="{Binding IsHeld}"
                        HorizontalOptions="Start" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenWhereItLandedCommand}" />

                <!-- Where this notification led before this screen existed: the conversation with
                     whoever offered it, which is also where the offer's own chat message sits. -->
                <Button Text="{controls:Translate 'Who shared it'}" IsVisible="{Binding HasSharer}"
                        HorizontalOptions="Start" Style="{StaticResource SecondaryButton}"
                        Command="{Binding MessageThemCommand}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
