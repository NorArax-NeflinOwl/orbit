<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Sharing.SharedLinkPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:sharing="clr-namespace:Orbit.Mobile.Screens.Sharing;assembly=Orbit.Mobile"
    x:DataType="sharing:SharedLinkViewModel"
    Title="{controls:Translate 'Shared with a link'}">

    <Grid RowDefinitions="Auto,*">
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18,20,28" Spacing="14">

                <controls:OrbitLoading IsRunning="{Binding IsLoading}" HorizontalOptions="Center" />

                <!-- What kind of thing this is, then the thing's own name in the display face - the
                     shape a note opens with. The bar says what the *screen* is ("Shared with a link");
                     this says what is on it. -->
                <Label Text="{Binding Kind}" IsVisible="{Binding WasFound}" Style="{StaticResource PanelHeading}" />

                <Label Text="{Binding Title}" FontFamily="OrbitDisplay" FontSize="30" FontAttributes="Bold"
                       LineBreakMode="WordWrap" Margin="0,-8,0,0" />

                <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" LineBreakMode="WordWrap"
                       Style="{StaticResource SubtleLabel}" />

                <Label Text="{Binding SharedBy}" IsVisible="{Binding WasFound}" FontSize="12"
                       Style="{StaticResource SubtleLabel}" />

                <Label Text="{controls:Translate 'Nothing in it yet.'}" IsVisible="{Binding HasNothingInIt}"
                       Style="{StaticResource SubtleLabel}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="sharing:SharedLine">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <!-- Disabled rather than absent, as on the web: the reader can see what
                                     is done without being offered a control that would do nothing. -->
                                <!-- Named after the line it belongs to: a screen reader lands on the box
                                     itself, and "ticked" on its own says nothing about what is done. -->
                                <controls:CheckCircle Grid.Column="0" Diameter="20" IsChecked="{Binding IsTicked}"
                                                      IsVisible="{Binding IsChecklistItem}" VerticalOptions="Center"
                                                      Description="{Binding Text}" />
                                <!-- The mark at the head of a line of a list, in the box's own column and
                                     never shown at the same time as a box - the rule the note's own
                                     screen has. See NoteLineLook. -->
                                <Label Grid.Column="0" Text="{Binding ListMark}" VerticalOptions="Center"
                                       IsVisible="{Binding ShowsListMark}"
                                       Style="{StaticResource SubtleLabel}" />

                                <!-- A heading read through a link is the heading it was written as. The
                                     bold half is a trigger because Orbit.Mobile is plain net10.0 and
                                     knows nothing about MAUI's own types - see SharedLine.IsDrawnBold. -->
                                <!-- The words with their marks, where a note's line has any - see MarkedLabel. -->
                                <controls:MarkedLabel Grid.Column="1" Words="{Binding Text}" Marks="{Binding AllMarks}"
                                                      LineBreakMode="WordWrap" IsVisible="{Binding ShowsWords}"
                                                      FontSize="{Binding DrawnFontSize}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="controls:MarkedLabel" Binding="{Binding IsDrawnBold}" Value="True">
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </controls:MarkedLabel>

                                <!-- A table, drawn as the grid of its cells' words - see NoteLineRow.TableRows /
                                     SharedLine.TableRows. Two nested BindableLayouts rather than a Grid, because
                                     a Grid's rows and columns are declared and a table's are whatever the note
                                     says. Hairlines between cells, as the browser draws them. Every cell one
                                     width, scrolled sideways when wider than the page - see NoteDetailPage.xaml. -->
                                <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                                            IsVisible="{Binding IsATable}" Margin="0,8">
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Start"
                                                     BindableLayout.ItemsSource="{Binding TableRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="sys:Object">
                                            <HorizontalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding .}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Padding="8,6" StrokeThickness="1" WidthRequest="{StaticResource NoteTableCellWidth}"
                                                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}">
                                                            <Label Text="{Binding .}" LineBreakMode="WordWrap" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                </ScrollView>

                                <!-- A picture of the note, fetched through the link - see SharedLine.PictureBytes. -->
                                <Image Grid.Column="1" Aspect="AspectFit" HorizontalOptions="Start"
                                       MaximumHeightRequest="360" Margin="0,8"
                                       IsVisible="{Binding ShowsPicture}"
                                       Source="{Binding PictureBytes, Converter={StaticResource PictureBytes}}" />
                                <Label Grid.Column="1" Text="{Binding PictureNote}"
                                       IsVisible="{Binding ShowsPictureNote}" VerticalOptions="Center"
                                       Style="{StaticResource SubtleLabel}" />
                                <!-- A rule across the note, drawn as the note's own screen draws it - see
                                     NoteDetailPage.xaml, and Orbit.Core.Notes.NoteSeparatorLine. -->
                                <Grid Grid.Column="1" Margin="0,10" IsVisible="{Binding IsASeparator}">
                                    <BoxView HeightRequest="1" VerticalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
                                    <Label Text="{Binding StampOnTheSeparator}" IsVisible="{Binding ShowsSeparatorStamp}"
                                           HorizontalOptions="Center" Padding="8,0"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                                           Style="{StaticResource SubtleLabel}" />
                                </Grid>

                                <Label Grid.Column="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                       FontSize="12" VerticalOptions="Center" Style="{StaticResource SubtleLabel}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" LineBreakMode="WordWrap" />

                <!-- The one action, and it needs an account: a copy has to belong to somebody. -->
                <Button Text="{controls:Translate 'Save to my account'}" IsVisible="{Binding CanBeKept}"
                        HorizontalOptions="Start" Style="{StaticResource PrimaryButton}"
                        Command="{Binding KeepCommand}" />

                <Label Text="{controls:Translate 'You get your own read-only copy. Nothing you do changes theirs.'}"
                       IsVisible="{Binding CanBeKept}" FontSize="12" LineBreakMode="WordWrap"
                       Style="{StaticResource SubtleLabel}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
