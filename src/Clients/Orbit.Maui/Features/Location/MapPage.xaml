<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Location.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:data="clr-namespace:Orbit.Mobile.Data;assembly=Orbit.Mobile"
    xmlns:location="clr-namespace:Orbit.Maui.Features.Location"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Location;assembly=Orbit.Mobile"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:DataType="screens:MapViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Map'}">

    <Grid RowDefinitions="Auto,*,Auto">


        <!-- In place of the whole section when this account has not unlocked it. -->
        <controls:FeatureLocked Grid.Row="1" Margin="20" VerticalOptions="Start"
                                IsVisible="{Binding IsLocked}"
                                Explanation="{Binding LockedExplanation}"
                                OpenAccountCommand="{Binding OpenAccountCommand}" />

    <!-- The map takes the screen. It was a 260-tall window at the top of a column of panels - the one
         thing this screen is actually for, given a sixth of it, with what to do about it stacked
         underneath. What was in those panels is under the screen's name now: how to share where you
         are, who can see you, and who is sharing with you. The last two open as screens of their own,
         because a list is a list.

         Pins are built in code-behind: the control's pin carries a platform Location, and keeping that
         out of the view model is what lets the view model be tested at all. Held in a container the
         code-behind can empty, because a build with no map key must not create the control at all -
         see MapAvailability. -->
    <Grid Grid.Row="1" IsVisible="{Binding IsUnlocked}">
        <ContentView x:Name="MapArea">
            <maps:Map x:Name="PositionsMap" IsShowingUser="False" />
        </ContentView>

        <!-- Over the tiles rather than under them, and only where there is something to say: where the
             reader was last read to be, and whatever the last press could not do. A card, because
             writing straight onto a map is unreadable over half the maps there are.

             It stops short on the right - 80 rather than 12 - because the crosshair is up here now, and
             a card the full width of the screen runs underneath it. A long address is what shows that:
             the button is 56 across and keeps 18 off the edge, so the card ends 8 before it starts. -->
        <Border Style="{StaticResource CardBorder}" Margin="12,10,80,10" VerticalOptions="Start"
                IsVisible="{Binding HasSomethingToSay}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding OwnPositionDescription}" LineBreakMode="WordWrap" FontSize="13" />
                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                       LineBreakMode="WordWrap" FontSize="12" Style="{StaticResource SubtleLabel}" />
                <controls:OrbitLoading IsRunning="{Binding IsBusy}" RingSize="30" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Border>

        <!-- Choosing who to share with, over the map rather than under it: it is the answer to a press
             that was just made, and the map is what it is about. -->
        <Border Style="{StaticResource CardBorder}" Margin="12" VerticalOptions="Center"
                IsVisible="{Binding IsChoosingWhoToShareWith}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{controls:Translate 'Share with'}" Style="{StaticResource PanelHeading}" />
                <CollectionView ItemsSource="{Binding Candidates}" HeightRequest="220">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:LocalContact">
                            <controls:Row Title="{Binding DisplayName}">
                                <controls:Row.Trailing>
                                    <Button Text="{controls:Translate 'Share'}" FontSize="13" Padding="14,4"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ShareWithCommand, x:DataType=location:MapPage}"
                                            CommandParameter="{Binding .}" />
                                </controls:Row.Trailing>
                            </controls:Row>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="{controls:Translate 'Cancel'}" Command="{Binding CancelSharingCommand}"
                        HorizontalOptions="Start" Style="{StaticResource LinkButton}" />
            </VerticalStackLayout>
        </Border>
    </Grid>

        <!-- Across the foot, under everything the page itself draws - see AdBanner, and .ad-banner
             in Orbit.Web's app.css, which is the same bar on a narrow window. -->
        <controls:AdBanner Grid.Row="2" />
        <!-- The one thing this screen is for: reading where the phone is. At the top right, which is the
             one corner of a map that is ours - Android draws the zoom buttons along the bottom right and
             Google's logo along the bottom left, both itself, and the crosshair was covering the zoom
             buttons and taking their presses. -->
        <controls:Fab Grid.Row="1" IsAtTheTop="True" IsVisible="{Binding IsUnlocked}"
                      Data="M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M8,12 A4,4 0 1 1 16,12 A4,4 0 1 1 8,12 Z"
                      Description="{controls:Translate 'Read my position'}"
                      Command="{Binding ReadMyPositionCommand}" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=location:MapPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
