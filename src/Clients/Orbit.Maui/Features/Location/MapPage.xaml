<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Location.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:data="clr-namespace:Orbit.Mobile.Data;assembly=Orbit.Mobile"
    xmlns:mobile="clr-namespace:Orbit.Mobile.Location;assembly=Orbit.Mobile"
    xmlns:location="clr-namespace:Orbit.Maui.Features.Location"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Location;assembly=Orbit.Mobile"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:DataType="screens:MapViewModel"
    Title="{controls:Translate 'Location'}">

    <Grid RowDefinitions="Auto,*,Auto">


    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{controls:Translate 'Location'}" FontSize="26" FontAttributes="Bold" />
            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" LineBreakMode="WordWrap" />

            <!-- Pins are built in code-behind: the control's pin carries a platform Location, and
                 keeping that out of the view model is what lets the view model be tested at all. -->
            <maps:Map x:Name="PositionsMap" HeightRequest="260" IsShowingUser="False" />

            <Label Text="{controls:Translate 'Where you are'}" FontAttributes="Bold" />
            <Label Text="{Binding OwnPositionDescription}" LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <!-- Wrapping rather than truncating: a translated label is routinely longer than the
                 English it replaces, and a button that reads "Odczytaj moje położen" is worse than one
                 that takes two lines. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsNotChoosing}">
                <Button Grid.Column="0" Text="{controls:Translate 'Read my position'}" FontSize="14"
                        LineBreakMode="WordWrap" Command="{Binding ReadMyPositionCommand}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Share it'}" FontSize="14"
                        LineBreakMode="WordWrap" Command="{Binding StartSharingCommand}"
                        IsEnabled="{Binding HasOwnPosition}" />
            </Grid>

            <!-- Choosing who to share with replaces the buttons above rather than stacking under them. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsChoosingWhoToShareWith}">
                <Label Text="{controls:Translate 'Share with'}" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding Candidates}" HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:LocalContact">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,8" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding DisplayName}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{controls:Translate 'Share'}" FontSize="13" Padding="14,4"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ShareWithCommand, x:DataType=location:MapPage}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="{controls:Translate 'Cancel'}" Command="{Binding CancelSharingCommand}"
                        Style="{StaticResource LinkButton}" />
            </VerticalStackLayout>

            <Label Text="{controls:Translate 'Who can see you'}" FontAttributes="Bold" Margin="0,12,0,0" />
            <CollectionView ItemsSource="{Binding SharingWith}" HeightRequest="180">
                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'Nobody.'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:SharingWithRow">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}" FontSize="16" />
                                <Label Text="{Binding Detail}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{controls:Translate 'Stop'}" FontSize="13" Padding="14,4"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.StopSharingWithCommand, x:DataType=location:MapPage}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{controls:Translate 'Shared with you'}" FontAttributes="Bold" Margin="0,12,0,0" />
            <CollectionView ItemsSource="{Binding SharedWithMe}" HeightRequest="200">
                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'Nobody is sharing their position with you.'}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" LineBreakMode="WordWrap" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="mobile:ReceivedPosition">
                        <VerticalStackLayout Padding="0,10" Spacing="2">
                            <Label Text="{Binding SharerDisplayName}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Position.Address}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding Position.RecordedAtUtc, StringFormat='{0:g}'}"
                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <!-- Listed rather than dropped: that somebody is sharing and it cannot be
                                 opened is worth seeing. -->
                            <Label IsVisible="{Binding CannotBeOpened}"
                                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                <Label.Text>
                                    <controls:Translate Text="This position can't be opened on this device." />
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="{controls:Translate 'Back to dashboard'}" Command="{Binding GoBackCommand}"
                    Style="{StaticResource LinkButton}" />

        </VerticalStackLayout>
    </ScrollView>
        <controls:StatusStrip Grid.Row="2" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
