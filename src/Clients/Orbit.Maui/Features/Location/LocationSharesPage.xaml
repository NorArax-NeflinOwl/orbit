<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Location.LocationSharesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:mobile="clr-namespace:Orbit.Mobile.Location;assembly=Orbit.Mobile"
    xmlns:location="clr-namespace:Orbit.Maui.Features.Location"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Location;assembly=Orbit.Mobile"
    x:DataType="screens:MapViewModel"
    x:Name="Page">

    <!-- One of the map's two lists of people, on a screen of its own - which is what the design asks
         for, and what stops a list of names being drawn over the map it is about. Which of the two it
         is comes from the navigator; both read the same view model, which loads both either way. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Who can see the reader, each with a way to stop. -->
        <CollectionView Grid.Row="1" x:Name="Mine" IsVisible="False" Margin="20,14,20,0"
                        ItemsSource="{Binding SharingWith}">
            <CollectionView.EmptyView>
                <Label Text="{controls:Translate 'Nobody.'}" Padding="0,12" Style="{StaticResource EmptyHint}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="screens:SharingWithRow">
                    <controls:Row Title="{Binding DisplayName}">
                        <controls:Row.Trailing>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Detail}" Style="{StaticResource RowMeta}" />
                                <Button Text="{controls:Translate 'Stop'}" FontSize="13" Padding="14,4"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.StopSharingWithCommand, x:DataType=location:LocationSharesPage}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </controls:Row.Trailing>
                    </controls:Row>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- And where everybody sharing with the reader is. -->
        <CollectionView Grid.Row="1" x:Name="Theirs" IsVisible="False" Margin="20,14,20,0"
                        ItemsSource="{Binding SharedWithMe}">
            <CollectionView.EmptyView>
                <Label Text="{controls:Translate 'Nobody is sharing their position with you.'}"
                       Padding="0,12" LineBreakMode="WordWrap" Style="{StaticResource EmptyHint}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mobile:ReceivedPosition">
                    <VerticalStackLayout Padding="0,10" Spacing="2">
                        <BoxView Style="{StaticResource Hairline}" Margin="0,-10,0,4" />
                        <Label Text="{Binding SharerDisplayName}" Style="{StaticResource ItemCardName}" />
                        <Label Text="{Binding Position.Address}" LineBreakMode="WordWrap" FontSize="13" />
                        <Label Text="{Binding RecordedAt}" IsVisible="{Binding HasRecordedAt}"
                               Style="{StaticResource ItemCardFooter}" />
                        <!-- The way off this screen and onto a real map. A button rather than a tappable
                             line, and what makes a shared position reachable on a build that cannot draw
                             a map at all: the phone's own map app knows where that is either way. -->
                        <Button Text="{controls:Translate 'Open in Maps'}" HorizontalOptions="Start"
                                FontSize="14" Style="{StaticResource LinkButton}"
                                IsVisible="{Binding CanBeOpened}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=OpenInMapsCommand, x:DataType=location:LocationSharesPage}"
                                CommandParameter="{Binding .}" />
                        <!-- Listed rather than dropped: that somebody is sharing and it cannot be opened
                             is worth seeing. -->
                        <Label IsVisible="{Binding CannotBeOpened}" Style="{StaticResource ItemCardFooter}">
                            <Label.Text>
                                <controls:Translate Text="This position can't be opened on this device." />
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:AdBanner Grid.Row="2" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
