<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Startup.StartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Startup;assembly=Orbit.Mobile"
    x:DataType="screens:StartupViewModel">

    <Grid RowDefinitions="*,Auto,*" Padding="32">
        <VerticalStackLayout Grid.Row="1" Spacing="24" HorizontalOptions="Center">

            <!-- While it checks, the turning ring with Orbit's icon in it stands where the mark stands -
                 the web's boot screen, which is the ring and the name - rather than a spinner under a
                 second copy of the mark. See OrbitLoading. -->
            <controls:OrbitMark MarkSize="88" HorizontalOptions="Center">
                <controls:OrbitMark.Triggers>
                    <DataTrigger TargetType="controls:OrbitMark" Binding="{Binding IsChecking}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </controls:OrbitMark.Triggers>
            </controls:OrbitMark>
            <controls:OrbitLoading IsRunning="{Binding IsChecking}" RingSize="88" HorizontalOptions="Center" />

            <Label Text="{controls:Translate 'Orbit'}" FontSize="44" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- The whole blocked state. There is no navigation away from this page, by design. -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsBlocked}">
                <Label Text="{Binding BlockedMessage}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
                <Button Text="{controls:Translate 'Update Orbit'}"
                        Command="{Binding OpenUpdateCommand}"
                        IsVisible="{Binding CanOpenUpdate}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
