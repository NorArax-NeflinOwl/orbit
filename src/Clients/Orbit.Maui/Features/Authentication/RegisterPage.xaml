<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Authentication.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Authentication;assembly=Orbit.Mobile"
    x:DataType="screens:RegisterViewModel"
    Title="{controls:Translate 'Create an account'}">

    <!-- A heading and five named boxes. Ranged left rather than centred: this is a form to work down,
         and centred labels over left-aligned boxes make a column that reads as neither.

         Five, where the design draws four - it has no Login, and this account has one. A display name
         is what other people see and a login is what you sign in with; dropping the box would not
         simplify the form, it would make the account unreachable. -->
    <ContentPage.Resources>
        <Style x:Key="ScreenHeading" TargetType="Label">
            <Setter Property="FontFamily" Value="OrbitDisplay" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="32,40" Spacing="14" VerticalOptions="Center">

            <!-- The screen's name is drawn here because there is no bar above it to carry it, so what
                 the account is goes behind a "?" beside this heading rather than under it - see
                 FieldHint, and NavigationBar.Description for the screens that do have a bar. -->
            <controls:FieldHint Margin="0,0,0,8" LabelStyle="{StaticResource ScreenHeading}"
                                Label="{controls:Translate 'Create an account'}"
                                Text="{controls:Translate 'One account for the browser and this phone.'}" />

            <!-- Said up front rather than after four fields have been filled in. -->
            <Label Text="{controls:Translate 'Creating an account needs a connection to Orbit.'}"
                   IsVisible="{Binding IsOffline}"
                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                   LineBreakMode="WordWrap" />

            <VerticalStackLayout Spacing="5">
                <Label Text="{controls:Translate 'Display name'}" Style="{StaticResource FormFieldLabel}" />
                <Entry Text="{Binding DisplayName}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="{controls:Translate 'Email address'}" Style="{StaticResource FormFieldLabel}" />
                <Entry Text="{Binding EmailAddress}" Keyboard="Email" IsSpellCheckEnabled="False" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="{controls:Translate 'Login'}" Style="{StaticResource FormFieldLabel}" />
                <!-- Plain, not the default text keyboard: iOS capitalises the first letter of a sentence,
                     which silently turns a typed username into a different one. -->
                <Entry Text="{Binding UserName}" Keyboard="Plain" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="{controls:Translate 'Password'}" Style="{StaticResource FormFieldLabel}" />
                <Entry Text="{Binding Password}" IsPassword="True" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <!-- Asked a second time, as the browser's form asks: a password nobody can read back is a
                     password nobody can check, and one mistyped here locks somebody out of the account
                     they are making. -->
                <Label Text="{controls:Translate 'Repeat password'}" Style="{StaticResource FormFieldLabel}" />
                <Entry Text="{Binding RepeatedPassword}" IsPassword="True"
                       ReturnType="Go" ReturnCommand="{Binding RegisterCommand}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                   LineBreakMode="WordWrap" />

            <!-- The one thing this screen is for, so it is outlined in the accent as sign-in's is. -->
            <Button Text="{controls:Translate 'Create account'}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding RegisterCommand}" Margin="0,6,0,0" />

            <ActivityIndicator IsRunning="{Binding RegisterCommand.IsRunning}"
                               IsVisible="{Binding RegisterCommand.IsRunning}"
                               HorizontalOptions="Center" />

            <Button Text="{controls:Translate 'I already have an account'}"
                    Command="{Binding GoToSignInCommand}"
                    Style="{StaticResource LinkButton}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
