<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Authentication.PasswordResetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Authentication;assembly=Orbit.Mobile"
    x:DataType="screens:PasswordResetViewModel"
    Title="{controls:Translate 'Forgotten password'}">

    <ContentPage.Resources>
        <Style x:Key="ScreenHeading" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

            <!-- What the first step asks for, behind a "?" beside the heading rather than under it - the
                 same fold Orbit.Web's forgotten-password page makes, and for as long: once the password
                 is set there is no step left to explain, so the heading stands on its own. -->
            <controls:FieldHint HorizontalOptions="Center" IsVisible="{Binding IsNotDone}"
                                LabelStyle="{StaticResource ScreenHeading}"
                                Label="{controls:Translate 'Forgotten password'}"
                                Text="{controls:Translate 'Enter the account, and Orbit emails a code to the address it was registered with.'}" />
            <Label Text="{controls:Translate 'Forgotten password'}" Style="{StaticResource ScreenHeading}"
                   HorizontalOptions="Center" IsVisible="{Binding IsDone}" />

            <!-- Said up front: none of this can be queued - see AccountClient. -->
            <Label Text="{controls:Translate 'Getting back into an account needs a connection to Orbit.'}"
                   IsVisible="{Binding IsOffline}"
                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsNotDone}">
                <!-- Plain rather than the default text keyboard, for the same reason the register form
                     gives: a capitalised first letter is a different username. -->
                <Entry Placeholder="{controls:Translate 'Email or login'}" Text="{Binding EmailOrUserName}"
                       Keyboard="Plain" IsSpellCheckEnabled="False" />

                <Button Text="{controls:Translate 'Send a code'}" Command="{Binding SendCodeCommand}" />

                <controls:OrbitLoading IsRunning="{Binding SendCodeCommand.IsRunning}" RingSize="30"
                                       HorizontalOptions="Center" />

                <!-- Shown once a code has been asked for, and left in place afterwards: somebody who
                     already has one from an earlier attempt should not have to ask for another. -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding CodeWasRequested}">
                    <Entry Placeholder="{controls:Translate 'Code'}" Text="{Binding Code}" Keyboard="Plain"
                           IsSpellCheckEnabled="False" />
                    <Entry Placeholder="{controls:Translate 'New password'}" Text="{Binding Password}" IsPassword="True" />
                    <!-- Typed twice because there is nothing to check it against: the old password is
                         forgotten by definition, so a typo would lock the account a second time. -->
                    <Entry Placeholder="{controls:Translate 'Repeat new password'}" Text="{Binding RepeatedPassword}"
                           IsPassword="True" ReturnType="Go" ReturnCommand="{Binding SetPasswordCommand}" />

                    <Label Text="{controls:Translate 'A new password starts your chat over: messages sealed with the old one stay unreadable, because Orbit never had their key.'}"
                           FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

                    <Button Text="{controls:Translate 'Set the new password'}" Command="{Binding SetPasswordCommand}" />

                    <controls:OrbitLoading IsRunning="{Binding SetPasswordCommand.IsRunning}" RingSize="30"
                                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

            <Button Text="{controls:Translate 'Back to signing in'}" Command="{Binding GoToSignInCommand}"
                    Style="{StaticResource LinkButton}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
