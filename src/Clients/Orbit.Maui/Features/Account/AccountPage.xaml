<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Account.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:notifications="clr-namespace:Orbit.Mobile.Screens.Notifications;assembly=Orbit.Mobile"
    xmlns:account="clr-namespace:Orbit.Maui.Features.Account"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Account;assembly=Orbit.Mobile"
    x:DataType="screens:AccountViewModel"
    Title="{controls:Translate 'Settings'}">

    <Grid RowDefinitions="Auto,*,Auto">

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16,16,16,28" Spacing="18">

            <controls:PageHeader Title="{controls:Translate 'Settings'}">
                <controls:PageHeader.Subtitle>
                    <controls:Translate Text="Who you are to Orbit, and what this device is allowed to do." />
                </controls:PageHeader.Subtitle>
            </controls:PageHeader>

            <!-- Tabs rather than one long scroll, as Orbit.Web's Options page has: changing a password
                 and unlocking a feature are different errands. -->
            <Grid RowDefinitions="Auto,Auto">
                <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Tabs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="screens:AccountTabRow">
                                <!-- The chosen one is underlined as well as coloured, which is what
                                     .options-tab.active does: colour alone is one signal, and this row
                                     scrolls sideways on a phone so the reader may only see part of it. -->
                                <Grid RowDefinitions="Auto,Auto">
                                    <Button Grid.Row="0" Text="{Binding Name}" Style="{StaticResource SettingsTab}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ChooseTabCommand, x:DataType=account:AccountPage}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsChosen}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <BoxView Grid.Row="1" HeightRequest="2" Color="Transparent">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsChosen}" Value="True">
                                                <Setter Property="Color" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <BoxView Grid.Row="1" Style="{StaticResource Hairline}" />
            </Grid>

            <!-- How Orbit looks on this device. Kept here rather than on the server for the same reason
                 the web keeps it in the browser: a phone in a pocket and a browser at a desk want
                 different answers. The language stays in the avatar's menu, where it was asked for. -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsShowingAppearance}">
                <Label Text="{controls:Translate 'Appearance'}" Style="{StaticResource SectionHeading}" />
                <Label Text="{controls:Translate 'Choose how Orbit looks on this device.'}" FontSize="12"
                       LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding ChosenThemeOption}"
                        ItemDisplayBinding="{Binding Name, x:DataType=screens:ThemeChoice}"
                        SemanticProperties.Description="{controls:Translate 'Appearance'}" />

                <!-- The colour Orbit highlights things in, as swatches rather than a list of names:
                     what the reader is choosing is how it looks, and eight words would say less than
                     eight colours do. Orbit.Web offers the same eight the same way. -->
                <Label Text="{controls:Translate 'Accent colour'}" Style="{StaticResource SectionHeading}"
                       Margin="0,6,0,0" />
                <Label Text="{controls:Translate 'The colour Orbit highlights things in. Kept on this device, like the theme.'}"
                       LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Accents}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="screens:AccentChoice">
                            <Border Margin="0,0,10,10" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{Binding Swatch}" StrokeThickness="3"
                                    StrokeShape="RoundRectangle 22"
                                    AutomationProperties.Name="{Binding Name}">
                                <!-- The one in force is ringed rather than ticked: a tick drawn on the
                                     swatch would be legible on some of the eight and not on others. -->
                                <Border.Stroke>
                                    <SolidColorBrush Color="Transparent" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsChosen}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource AccentOn}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <!-- The tap is a Button inside the swatch rather than a gesture on it: a
                                     Border carrying a gesture is not a clickable node to Android. -->
                                <Button BackgroundColor="Transparent" BorderWidth="0" CornerRadius="22"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ChooseAccentCommand, x:DataType=account:AccountPage}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- How Orbit is allowed to interrupt, which Orbit.Web keeps in this same tab. -->
                <VerticalStackLayout Spacing="14" Margin="0,10,0,0" BindingContext="{Binding Notifications}"
                                     x:DataType="notifications:NotificationSettingsViewModel">
                    <Label Text="{controls:Translate 'Notifications'}" Style="{StaticResource SectionHeading}" />
                    <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12"
                           LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

                    <!-- .options-card: the settings in one frame with hairlines between them, rather
                         than loose on the page. -->
                    <Border Style="{StaticResource SettingsCard}">
                        <VerticalStackLayout Spacing="0">
                            <controls:SettingRow Title="{controls:Translate 'Notify me'}"
                                                 Description="{controls:Translate 'Off means nothing is recorded or sent at all.'}">
                                <controls:SettingRow.Trailing>
                                    <Switch IsToggled="{Binding AllowNotifications}"
                                            SemanticProperties.Description="{controls:Translate 'Notify me'}" />
                                </controls:SettingRow.Trailing>
                            </controls:SettingRow>

                            <!-- Hidden rather than disabled: with the master switch off these do nothing
                                 at all, and a switch that can be moved without effect is worse than one
                                 not offered. -->
                            <VerticalStackLayout Spacing="0" IsVisible="{Binding CanChooseChannels}">
                                <controls:SettingRow Title="{controls:Translate 'Push to this phone'}">
                                    <controls:SettingRow.Trailing>
                                        <Switch IsToggled="{Binding AllowPush}"
                                                SemanticProperties.Description="{controls:Translate 'Push to this phone'}" />
                                    </controls:SettingRow.Trailing>
                                </controls:SettingRow>

                                <controls:SettingRow Title="{controls:Translate 'Email'}">
                                    <controls:SettingRow.Trailing>
                                        <Switch IsToggled="{Binding AllowEmail}"
                                                SemanticProperties.Description="{controls:Translate 'Email'}" />
                                    </controls:SettingRow.Trailing>
                                </controls:SettingRow>

                                <controls:SettingRow Title="{controls:Translate 'When something is shared with me'}"
                                                     Description="{controls:Translate 'It always appears in your notifications. This also pushes or emails.'}">
                                    <controls:SettingRow.Trailing>
                                        <Switch IsToggled="{Binding AllowShareNotifications}"
                                                SemanticProperties.Description="{controls:Translate 'When something is shared with me'}" />
                                    </controls:SettingRow.Trailing>
                                </controls:SettingRow>

                                <!-- The phone's own banner, which until now could only be turned on and
                                     off from a browser - see ForegroundNotices for what obeys it. -->
                                <controls:SettingRow Title="{controls:Translate 'Banner while Orbit is open'}"
                                                     Description="{controls:Translate 'Shows what arrived at the top of the screen instead of only in the tray.'}">
                                    <controls:SettingRow.Trailing>
                                        <Switch IsToggled="{Binding AllowMobileBanner}"
                                                SemanticProperties.Description="{controls:Translate 'Banner while Orbit is open'}" />
                                    </controls:SettingRow.Trailing>
                                </controls:SettingRow>

                                <!-- Steppers rather than number fields: both settings are clamped rather
                                     than refused (see BannerTiming), and a stepper cannot produce a value
                                     to clamp. -->
                                <VerticalStackLayout Spacing="0" IsVisible="{Binding CanChooseBannerTiming}">
                                    <controls:SettingRow Title="{controls:Translate 'How long it stays'}">
                                        <controls:SettingRow.Trailing>
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding BannerVisibleSeconds, StringFormat='{0} s'}"
                                                       VerticalOptions="Center" Style="{StaticResource RowMeta}" />
                                                <Stepper Value="{Binding BannerVisibleSeconds}"
                                                         Minimum="{Binding ShortestBannerSeconds}" Maximum="{Binding LongestBannerSeconds}"
                                                         Increment="1" VerticalOptions="Center"
                                                         SemanticProperties.Description="{controls:Translate 'How long it stays'}" />
                                            </HorizontalStackLayout>
                                        </controls:SettingRow.Trailing>
                                    </controls:SettingRow>

                                    <controls:SettingRow Title="{controls:Translate 'Quiet gap before the next one'}">
                                        <controls:SettingRow.Trailing>
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding BannerMinimumGapSeconds, StringFormat='{0} s'}"
                                                       VerticalOptions="Center" Style="{StaticResource RowMeta}" />
                                                <Stepper Value="{Binding BannerMinimumGapSeconds}"
                                                         Minimum="{Binding ShortestBannerSeconds}" Maximum="{Binding LongestGapSeconds}"
                                                         Increment="5" VerticalOptions="Center"
                                                         SemanticProperties.Description="{controls:Translate 'Quiet gap before the next one'}" />
                                            </HorizontalStackLayout>
                                        </controls:SettingRow.Trailing>
                                    </controls:SettingRow>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Outside the master switch, as Orbit.Web has it: what is already in the
                                 feed goes on ageing out whether or not anything new is being recorded.
                                 Last in the card, so it draws no line under itself. -->
                            <controls:SettingRow HasDivider="False"
                                                 Title="{controls:Translate 'Keep notifications for'}"
                                                 Description="{controls:Translate 'Clearing the panel only tidies them away. This is what deletes them for good.'}">
                                <controls:SettingRow.Trailing>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding RetentionDays, StringFormat='{0} d'}"
                                               VerticalOptions="Center" Style="{StaticResource RowMeta}" />
                                        <Stepper Value="{Binding RetentionDays}"
                                                 Minimum="{Binding FewestRetentionDays}" Maximum="{Binding MostRetentionDays}"
                                                 Increment="1" VerticalOptions="Center"
                                                 SemanticProperties.Description="{controls:Translate 'Keep notifications for'}" />
                                    </HorizontalStackLayout>
                                </controls:SettingRow.Trailing>
                            </controls:SettingRow>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="{controls:Translate 'Save'}" HorizontalOptions="Start" FontSize="13" Padding="14,6"
                            Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- One statement for the whole screen: none of this can happen without the server. -->
            <Label Text="{controls:Translate 'Changing your username, email address or password needs a connection to Orbit. None of it is saved to send later.'}"
                   IsVisible="{Binding Connection.IsNotMet}"
                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                   LineBreakMode="WordWrap" />

            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" LineBreakMode="WordWrap" />

            <VerticalStackLayout Spacing="8" IsEnabled="{Binding Connection.IsMet}" IsVisible="{Binding IsShowingAccount}">
                <Label Text="{controls:Translate 'Login'}" Style="{StaticResource SectionHeading}" />
                <!-- See RegisterPage for why this is not the default text keyboard. -->
                <Entry Placeholder="{controls:Translate 'New username'}" Text="{Binding UserName}" Keyboard="Plain" />
                <Entry Placeholder="{controls:Translate 'Display name'}" Text="{Binding DisplayName}" />
                <Button Text="{controls:Translate 'Change username'}" Command="{Binding ChangeUserNameCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsEnabled="{Binding Connection.IsMet}" IsVisible="{Binding IsShowingAccount}">
                <Label Text="{controls:Translate 'Email address'}" Style="{StaticResource SectionHeading}" />
                <!-- The address in use today and whether anybody has stood behind it, which Orbit.Web
                     shows above this same form. Read from the server rather than the session - see
                     AccountViewModel.ShowAccountAsync. -->
                <Label Text="{Binding EmailAddress}" FontSize="14" />
                <Label Text="{Binding EmailVerificationLabel}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                <Entry Placeholder="{controls:Translate 'New email address'}" Text="{Binding NewEmailAddress}" Keyboard="Email" IsSpellCheckEnabled="False" />
                <Button Text="{controls:Translate 'Send confirmation code'}" Command="{Binding RequestEmailChangeCommand}" />
                <Entry Placeholder="{controls:Translate 'Confirmation code'}" Text="{Binding EmailConfirmationCode}" Keyboard="Numeric" />
                <Button Text="{controls:Translate 'Confirm new address'}" Command="{Binding ConfirmEmailChangeCommand}" />
            </VerticalStackLayout>

            <!-- What this phone hands to Google, which is a different question from what the account is
                 connected to: turning these off leaves a connected account connected. Offered only
                 where the account may use them at all - see GoogleIntegrationAccess. -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding CanChooseGoogleExtras}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{controls:Translate 'Google extras'}"
                           Style="{StaticResource SectionHeading}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding AllowsGoogleExtras}"
                            SemanticProperties.Description="{controls:Translate 'Google extras'}" />
                </Grid>
                <Label Text="{controls:Translate 'Adds links that open Google Calendar or Google Maps with the details filled in. Orbit never writes to your calendar.'}"
                       LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />
                <Label Text="{controls:Translate 'Kept on this device.'}"
                       FontSize="12" Style="{StaticResource SubtleLabel}" />
            </VerticalStackLayout>

            <!-- Directly above the password form, as Orbit.Web has it: the warning below says "set one
                 below before disconnecting", and that has to be true of this screen too. Absent where
                 the deployment has no Google client id for this app - see GoogleAccountLink. -->
            <VerticalStackLayout IsEnabled="{Binding Connection.IsMet}" IsVisible="{Binding IsShowingAccount}">
                <VerticalStackLayout Spacing="8"
                                     BindingContext="{Binding GoogleLink}" x:DataType="screens:GoogleAccountLink"
                                     IsVisible="{Binding IsOffered}">
                    <Label Text="Google" Style="{StaticResource SectionHeading}" />
                    <Label Text="{controls:Translate 'Connecting Google lets you sign in with it as well as with your password.'}"
                           LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />
                    <Label Text="{controls:Translate 'Your account has no password yet, so Google is currently the only way in - set one below before disconnecting.'}"
                           IsVisible="{Binding IsOnlyWayIn}" FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                    <Button Text="{controls:Translate 'Continue with Google'}" HorizontalOptions="Start"
                            IsVisible="{Binding CanConnect}" Command="{Binding ConnectCommand}" />
                    <Button Text="{controls:Translate 'Disconnect'}" HorizontalOptions="Start"
                            IsVisible="{Binding IsLinked}" Command="{Binding DisconnectCommand}" />
                    <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                           FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{DynamicResource Accent}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsEnabled="{Binding Connection.IsMet}" IsVisible="{Binding IsShowingAccount}">
                <Label Text="{controls:Translate 'Password'}" Style="{StaticResource SectionHeading}" />
                <Entry Placeholder="{controls:Translate 'Current password'}" Text="{Binding CurrentPassword}" IsPassword="True" />
                <Entry Placeholder="{controls:Translate 'New password'}" Text="{Binding NewPassword}" IsPassword="True" />
                <!-- <inheritdoc cref="RegisterPage" /> - the same second answer, for the same reason. -->
                <Entry Placeholder="{controls:Translate 'Repeat new password'}" Text="{Binding RepeatedNewPassword}"
                       IsPassword="True" />
                <Button Text="{controls:Translate 'Change password'}" Command="{Binding ChangePasswordCommand}" />
                <Label Text="{controls:Translate 'Changing it also re-encrypts your chat key backup, so your messages stay readable when you next sign in elsewhere.'}"
                       LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />
                <Button Text="{controls:Translate 'Chat key'}" Command="{Binding GoToChatKeyCommand}"
                        HorizontalOptions="Start" Style="{StaticResource LinkButton}" />
            </VerticalStackLayout>

            <!-- A file somebody keeps, not a copy the app maintains. Importing creates new things
                 rather than restoring old ones, so it never puts what is already here at risk. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsShowingAccount}">
                <Label Text="{controls:Translate 'Export'}" Style="{StaticResource SectionHeading}" />
                <Label Text="{controls:Translate 'Downloads what you choose below as one file. Things shared with you are left out, and a private item travels sealed.'}"
                       LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />

                <!-- All four to begin with, which is what an export meant before there was anything to
                     choose - see ExportChoice. -->
                <Border Style="{StaticResource SettingsCard}" BindingContext="{Binding Export}">
                    <VerticalStackLayout Spacing="0">
                        <controls:SettingRow Title="{controls:Translate 'Notes'}">
                            <controls:SettingRow.Trailing>
                                <Switch IsToggled="{Binding IncludesNotes}"
                                        SemanticProperties.Description="{controls:Translate 'Notes'}" />
                            </controls:SettingRow.Trailing>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{controls:Translate 'Task lists'}">
                            <controls:SettingRow.Trailing>
                                <Switch IsToggled="{Binding IncludesTaskLists}"
                                        SemanticProperties.Description="{controls:Translate 'Task lists'}" />
                            </controls:SettingRow.Trailing>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{controls:Translate 'Calendar events'}">
                            <controls:SettingRow.Trailing>
                                <Switch IsToggled="{Binding IncludesCalendarEvents}"
                                        SemanticProperties.Description="{controls:Translate 'Calendar events'}" />
                            </controls:SettingRow.Trailing>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{controls:Translate 'Storages'}" HasDivider="False">
                            <controls:SettingRow.Trailing>
                                <Switch IsToggled="{Binding IncludesInventories}"
                                        SemanticProperties.Description="{controls:Translate 'Storages'}" />
                            </controls:SettingRow.Trailing>
                        </controls:SettingRow>
                    </VerticalStackLayout>
                </Border>

                <Button Text="{controls:Translate 'Export'}" HorizontalOptions="Start"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanExport}" Command="{Binding ExportCommand}" />

                <Label Text="{controls:Translate 'Import'}" Style="{StaticResource SectionHeading}" Margin="0,8,0,0" />
                <Label Text="{controls:Translate 'Adds everything in a file to this account. Nothing is replaced, so importing the same file twice leaves two copies.'}"
                       LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />
                <Button x:Name="ImportButton" Text="{controls:Translate 'Import'}" HorizontalOptions="Start"
                        IsEnabled="{Binding Connection.IsMet}" Clicked="OnImportClicked" />

                <Label Text="{Binding TransferMessage}" IsVisible="{Binding HasTransferMessage}"
                       FontSize="12" LineBreakMode="WordWrap"
                       TextColor="{DynamicResource Accent}" />
            </VerticalStackLayout>

            <!-- The one irreversible thing this screen can do, so it is last, filled red rather than the
                 quiet DestructiveButton the per-item deletes use, and asks for the password again on its
                 own line - see AccountViewModel.DeleteAccountPassword. The confirmation itself is the
                 page's job: it is a platform prompt. -->
            <Border Style="{StaticResource DangerCard}" Padding="18,16" Margin="0,8,0,0"
                    IsEnabled="{Binding Connection.IsMet}" IsVisible="{Binding IsShowingAccount}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{controls:Translate 'Delete account'}" Style="{StaticResource SectionHeading}" />
                    <Label Text="{controls:Translate 'Permanently deletes your account and everything in it - notes, tasks, calendar events, inventory, and chat history. This cannot be undone.'}"
                           LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />
                    <Entry Placeholder="{controls:Translate 'Password'}" Text="{Binding DeleteAccountPassword}" IsPassword="True"
                           IsVisible="{Binding RequiresPasswordToDelete}" />
                    <Button x:Name="DeleteAccountButton" Text="{controls:Translate 'Delete account'}" HorizontalOptions="Start"
                            Style="{StaticResource DangerButton}" Clicked="OnDeleteAccountClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- The same list Orbit.Web puts under Options, Permissions, and the same wording: what each
                 part of Orbit is, whether it is unlocked, and what it needs first when it is not. -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsShowingPermissions}">
                <Label Text="{controls:Translate 'Permissions'}" Style="{StaticResource SectionHeading}" />

                <!-- One row per part of Orbit, in the card the browser's own permissions table sits
                     in - what it is, what it is for, and whether this account has it. -->
                <Border Style="{StaticResource SettingsCard}">
                    <CollectionView ItemsSource="{Binding Permissions}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="screens:PermissionRow">
                                <controls:SettingRow Title="{Binding Name}" Description="{Binding Explanation}">
                                    <controls:SettingRow.Trailing>
                                        <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                               LineBreakMode="WordWrap" Style="{StaticResource RowMeta}" />
                                    </controls:SettingRow.Trailing>
                                </controls:SettingRow>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Label Text="{Binding PermissionMessage}" IsVisible="{Binding HasPermissionMessage}"
                       FontSize="12" LineBreakMode="WordWrap"
                       TextColor="{DynamicResource Accent}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Placeholder="{controls:Translate 'Unlock code'}"
                           Text="{Binding PermissionCode}"
                           ReturnType="Go" ReturnCommand="{Binding RedeemCodeCommand}" />
                    <Button Grid.Column="1" Text="{controls:Translate 'Unlock'}"
                            Style="{StaticResource PrimaryButton}" Command="{Binding RedeemCodeCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- What Orbit reports about itself, behind the permission that opens it - see
                 AccountViewModel.Tabs. The chat key is not here: unlocking what this account sealed is
                 an ordinary thing to want, not a look inside Orbit, so it stays on the Account tab. -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsShowingDebug}">
                <Label Text="{controls:Translate 'What Orbit reports about itself. Kept on this device.'}"
                       LineBreakMode="WordWrap" Style="{StaticResource SectionSubtext}" />
                <Button Text="{controls:Translate 'Diagnostics'}" Command="{Binding GoToDiagnosticsCommand}"
                        HorizontalOptions="Start" Style="{StaticResource LinkButton}" />
            </VerticalStackLayout>


        </VerticalStackLayout>
    </ScrollView>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
