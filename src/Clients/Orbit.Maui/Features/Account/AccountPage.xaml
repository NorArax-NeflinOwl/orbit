<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Account.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Account;assembly=Orbit.Mobile"
    x:DataType="screens:AccountViewModel"
    Title="Account">

    <Grid RowDefinitions="Auto,*,Auto">
        <controls:NavigationBar Grid.Row="0" />


    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Account" FontSize="26" FontAttributes="Bold" />

            <!-- One statement for the whole screen: none of this can happen without the server. -->
            <Label Text="Changing your username, email address or password needs a connection to Orbit. None of it is saved to send later."
                   IsVisible="{Binding IsOffline}"
                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                   LineBreakMode="WordWrap" />

            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" LineBreakMode="WordWrap" />

            <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsOnline}">
                <Label Text="Username" FontAttributes="Bold" />
                <!-- See RegisterPage for why this is not the default text keyboard. -->
                <Entry Placeholder="New username" Text="{Binding UserName}" Keyboard="Plain" />
                <Entry Placeholder="Display name" Text="{Binding DisplayName}" />
                <Button Text="Change username" Command="{Binding ChangeUserNameCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsOnline}">
                <Label Text="Email address" FontAttributes="Bold" />
                <Entry Placeholder="New email address" Text="{Binding NewEmailAddress}" Keyboard="Email" IsSpellCheckEnabled="False" />
                <Button Text="Send confirmation code" Command="{Binding RequestEmailChangeCommand}" />
                <Entry Placeholder="Confirmation code" Text="{Binding EmailConfirmationCode}" Keyboard="Numeric" />
                <Button Text="Confirm new address" Command="{Binding ConfirmEmailChangeCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsOnline}">
                <Label Text="Password" FontAttributes="Bold" />
                <Entry Placeholder="Current password" Text="{Binding CurrentPassword}" IsPassword="True" />
                <Entry Placeholder="New password" Text="{Binding NewPassword}" IsPassword="True" />
                <Button Text="Change password" Command="{Binding ChangePasswordCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Status" FontAttributes="Bold" />
                <!-- Two choices rather than a toggle: "available" and "unavailable" are both things
                     somebody picks, and a switch makes one of them look like the absence of the other. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Available" FontSize="13"
                            Command="{Binding ChooseAvailableCommand}" IsEnabled="{Binding IsUnavailable}" />
                    <Button Grid.Column="1" Text="Unavailable" FontSize="13"
                            Command="{Binding ChooseUnavailableCommand}" IsEnabled="{Binding IsAvailable}" />
                </Grid>
                <Label Text="{Binding AvailabilityDescription}" FontSize="12" LineBreakMode="WordWrap"
                       Style="{StaticResource SubtleLabel}" />
            </VerticalStackLayout>

            <Button Text="Chat key"
                    Command="{Binding GoToChatKeyCommand}"
                    Style="{StaticResource LinkButton}" />

            <Button Text="Sign out" Command="{Binding SignOutCommand}"
                    Style="{StaticResource DestructiveButton}" />

            <Button Text="Back to dashboard"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource LinkButton}" />

        </VerticalStackLayout>
    </ScrollView>
        <controls:StatusStrip Grid.Row="2" />
    </Grid>

</ContentPage>
