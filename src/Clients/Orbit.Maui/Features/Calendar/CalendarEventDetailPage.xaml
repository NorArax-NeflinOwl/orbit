<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Calendar.CalendarEventDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:calendar="clr-namespace:Orbit.Maui.Features.Calendar"
    xmlns:common="clr-namespace:Orbit.Mobile.Screens;assembly=Orbit.Mobile"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Calendar;assembly=Orbit.Mobile"
    xmlns:tasks="clr-namespace:Orbit.Mobile.Screens.Tasks;assembly=Orbit.Mobile"
    x:DataType="screens:CalendarEventDetailViewModel"
    x:Name="Page"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">

    <ScrollView Grid.Row="1">
        <!-- Room at the foot for the two floating buttons, which stand over the page rather than in it -
             the same 96 the note editor leaves for its pair. Scrolled all the way down, the last thing
             on this form was underneath them: the switch that says whether to be told as the event
             starts sat exactly under Save, so pressing it saved the event instead of setting it, and
             there was nowhere further to scroll to get it out from under. -->
        <VerticalStackLayout Padding="16,16,16,96" Spacing="12">

            <!-- The event's own colour down the left of its name, which is what the design gives this
                 screen and what a calendar row already carries - so an event opened from the list is
                 recognisably the same thing that was pressed. The bar is the whole of the heading's
                 decoration: no box around the name, because the name is the screen. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <BoxView Grid.Column="0" WidthRequest="3" CornerRadius="2"
                         Color="{DynamicResource Accent}" />
                <Entry Grid.Column="1" Text="{Binding Title}" FontFamily="OrbitDisplay" FontSize="24"
                       FontAttributes="Bold" IsReadOnly="{Binding IsReadOnly}"
                       controls:BareField.IsBare="True"
                       Placeholder="{controls:Translate 'Untitled event'}" />
            </Grid>

            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="12" LineBreakMode="WordWrap"
                   TextColor="{DynamicResource Accent}" />

            <Label Text="{Binding ReadOnlyReason}" IsVisible="{Binding HasReadOnlyReason}"
                   FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

            <controls:CopyOffer IsOffered="{Binding IsCopyOffered}"
                                TakeCommand="{Binding CopyForEditingCommand}"
                                DeclineCommand="{Binding DeclineCopyCommand}" />

            <!-- A box while it can be written in, and words while it cannot: a text box cannot hold a
                 link at all, so an address in an appointment somebody shared read-only was there to be
                 retyped rather than pressed. See LinkedLabel, which shares the browser's own rule about
                 what counts as an address. -->
            <Editor Text="{Binding Description}" HeightRequest="110" IsVisible="{Binding CanEdit}"
                    Placeholder="{controls:Translate 'Description'}" />
            <controls:LinkedLabel Words="{Binding Description}" LineBreakMode="WordWrap"
                                  IsVisible="{Binding IsReadOnly}"
                                  SemanticProperties.Description="{controls:Translate 'Description'}" />

            <!-- Where it is. Orbit.Web picks the point off a map; a phone already knows where it is,
                 and a place is a point with an optional label - so the name alone is not a location. -->
            <Label Text="{controls:Translate 'Location'}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding LocationAddress}" IsReadOnly="{Binding IsReadOnly}"
                   Placeholder="{controls:Translate 'Name of the place'}"
                   ReturnType="Done" ReturnCommand="{Binding SaveCommand}" />
            <!-- Said rather than left to be discovered, which is what Orbit.Web's rebuild added beside
                 its own box: the name is the reader's, and taking the point keeps it. -->
            <Label Text="{controls:Translate 'The name is yours to write - the point is kept either way.'}"
                   IsVisible="{Binding CanEdit}" FontSize="12" LineBreakMode="WordWrap"
                   Style="{StaticResource SubtleLabel}" />
            <!-- Everything that can be done about the place, on one line of links under the box it is
                 typed in - which is the design's own arrangement, and takes a row off a screen that is
                 already six fields long. They were two outlined buttons over two links before, so the
                 same four things read as two kinds of control and filled two rows doing it.

                 The last two are the hand-offs Orbit.Web puts beside the address in its list: the place,
                 and the way there. Hidden unless the account qualifies - see GoogleIntegrationAccess. -->
            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                <Button Text="{controls:Translate 'Use my location'}" FontSize="13" Margin="0,0,16,0"
                        IsVisible="{Binding CanEdit}"
                        Style="{StaticResource LinkButton}" Command="{Binding UseMyLocationCommand}" />
                <Button Text="{controls:Translate 'Remove location'}" FontSize="13" Margin="0,0,16,0"
                        IsVisible="{Binding CanRemoveLocation}"
                        Style="{StaticResource LinkButton}" Command="{Binding RemoveLocationCommand}" />
                <Button Text="{controls:Translate 'Open in Google Maps'}" FontSize="13" Margin="0,0,16,0"
                        IsVisible="{Binding CanOpenLocationInGoogleMaps}"
                        Style="{StaticResource LinkButton}" Clicked="OnOpenLocationInGoogleMapsClicked" />
                <Button Text="{controls:Translate 'Directions'}" FontSize="13"
                        IsVisible="{Binding CanOpenLocationInGoogleMaps}"
                        Style="{StaticResource LinkButton}" Clicked="OnOpenDirectionsClicked" />
            </FlexLayout>

            <Label Text="{controls:Translate 'When'}" Style="{StaticResource FieldLabel}" />

            <!-- Two boxes side by side, Starts and Ends, each holding its own day and its own time -
                 which is what the design draws and is the right pairing. The four pickers used to be
                 two rows of two: the start's day beside the end's day, then the start's time beside the
                 end's time. That reads as two ranges rather than as two moments, and it is why an event
                 spanning days looks like a mistake on the screen that is meant to show it.

                 The day and the time are stacked inside a box rather than on one line as the design has
                 them ("Tue 8 Sep · 14:30"): the design's is a label and these are two things to press,
                 and two pickers side by side in half of 412 points do not fit.

                 Both are bare - see BareField. A picker draws Orbit's own hairline box, and a box
                 inside a box is two edges saying the same thing; the design's "When" has one, with the
                 values plain inside it. -->

            <!-- Two dates, not one: the end used to be taken from the start, so an event spanning days
                 was quietly shortened the first time anybody edited it. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12,8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{controls:Translate 'Starts'}" Style="{StaticResource CardBadgeLabel}" />
                        <!-- Which is which. Two date pickers both announcing "When" leave a reader who
                             cannot see them no way to tell the start from the end. -->
                        <DatePicker Date="{Binding StartDate}" IsEnabled="{Binding CanEdit}" Format="{controls:DatePattern}"
                                    controls:BareField.IsBare="True"
                                    SemanticProperties.Description="{controls:Translate 'Starts'}" />
                        <!-- Hidden rather than disabled for an all-day event: there is no time to show,
                             and a greyed time reads as something that could be set and simply is not. -->
                        <TimePicker Time="{Binding StartTime}" IsEnabled="{Binding CanEdit}" Format="{controls:TimePattern}"
                                    IsVisible="{Binding IsNotAllDay}" controls:BareField.IsBare="True"
                                    SemanticProperties.Description="{controls:Translate 'Starts'}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12,8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{controls:Translate 'Ends'}" Style="{StaticResource CardBadgeLabel}" />
                        <DatePicker Date="{Binding EndDate}" IsEnabled="{Binding CanEdit}" Format="{controls:DatePattern}"
                                    controls:BareField.IsBare="True"
                                    SemanticProperties.Description="{controls:Translate 'Ends'}" />
                        <TimePicker Time="{Binding EndTime}" IsEnabled="{Binding CanEdit}" Format="{controls:TimePattern}"
                                    IsVisible="{Binding IsNotAllDay}" controls:BareField.IsBare="True"
                                    SemanticProperties.Description="{controls:Translate 'Ends'}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{controls:Translate 'All day'}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsAllDay}" IsEnabled="{Binding CanEdit}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{controls:Translate 'All day'}" />
            </Grid>

            <!-- Whether it repeats, and how. The three frequencies are Orbit.Core's own. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{controls:Translate 'Recurring event'}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsRecurring}" IsEnabled="{Binding CanEdit}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{controls:Translate 'Recurring event'}" />
            </Grid>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsRecurring}">
                <Label Text="{controls:Translate 'Frequency'}" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Frequencies}" SelectedItem="{Binding ChosenFrequency}"
                        IsEnabled="{Binding CanEdit}"
                        ItemDisplayBinding="{Binding Name, x:DataType=screens:RecurrenceChoice}"
                        SemanticProperties.Description="{controls:Translate 'Frequency'}" />

                <Label Text="{controls:Translate 'Every'}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding RecurrenceIntervalCount}" Keyboard="Numeric"
                       IsReadOnly="{Binding IsReadOnly}" ReturnType="Done" ReturnCommand="{Binding SaveCommand}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{controls:Translate 'Repeat until (optional)'}"
                           VerticalOptions="Center" LineBreakMode="WordWrap" />
                    <Switch Grid.Column="1" IsToggled="{Binding RecurrenceEnds}" IsEnabled="{Binding CanEdit}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Repeat until (optional)'}" />
                </Grid>
                <DatePicker Date="{Binding RecurrenceUntil}" IsVisible="{Binding RecurrenceEnds}"
                            IsEnabled="{Binding CanEdit}" Format="{controls:DatePattern}"
                        SemanticProperties.Description="{controls:Translate 'Repeat until (optional)'}" />

                <!-- The other way of saying when to stop. Both may be given, and whichever comes first
                     wins - the rule is Orbit.Core's, see CalendarEventOccurrenceGenerator. Zero is the
                     empty box on the web: no limit of this kind. -->
                <Label Text="{controls:Translate 'Repeat how many times'}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding RecurrenceCount}" Keyboard="Numeric" IsReadOnly="{Binding IsReadOnly}"
                       Placeholder="{controls:Translate 'no limit'}"
                       ReturnType="Done" ReturnCommand="{Binding SaveCommand}" />
            </VerticalStackLayout>

            <!-- What is set, then what can be added. Picking from the list adds it: an "add" button
                 after a picker is a second press for a choice already made. -->
            <!-- Who is coming, and who could be. The same two lists Orbit.Web shows. -->
            <!-- A palette rather than the browser's colour picker, which a phone has no equivalent of.
                 The chosen one is ringed; "no colour" is the empty first swatch. -->
            <!-- What sorts this event against the others, and what the dashboard's filter reads. The
                 same three choices Orbit.Web's editor has always had - see PriorityChoice. Below the
                 times rather than among them: it is a fact about the event, not about when it is. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{controls:Translate 'Priority'}" VerticalOptions="Center" />
                <Picker Grid.Column="1" WidthRequest="160" ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding ChosenPriority}" IsEnabled="{Binding CanEdit}"
                        ItemDisplayBinding="{Binding Name, x:DataType=tasks:PriorityChoice}"
                        SemanticProperties.Description="{controls:Translate 'Priority'}" />
            </Grid>

            <Label Text="{controls:Translate 'Color'}" Style="{StaticResource FieldLabel}" />
            <FlexLayout Wrap="Wrap" Direction="Row" AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Colours}" IsVisible="{Binding CanEdit}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:EventColourChoice">
                        <Border WidthRequest="34" HeightRequest="34" Margin="0,0,8,8" StrokeThickness="2"
                                Stroke="Transparent" BackgroundColor="{Binding Value}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <!-- The tap is a Button inside the swatch rather than a gesture on it: a
                                 Border carrying a gesture is not a clickable node to Android, so a
                                 screen reader could neither reach it nor activate it. -->
                            <Button BackgroundColor="Transparent" BorderWidth="0" CornerRadius="17"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ChooseColourCommand, x:DataType=calendar:CalendarEventDetailPage}"
                                    CommandParameter="{Binding .}"
                                    SemanticProperties.Description="{Binding Name}" />
                            <Border.Triggers>
                                <!-- No colour is an outline, so the swatch is visible at all. -->
                                <DataTrigger TargetType="Border" Binding="{Binding HasColour}" Value="False">
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsChosen}" Value="True">
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="{controls:Translate 'Guests'}" Style="{StaticResource FieldLabel}" />
            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Guests}">
                <BindableLayout.EmptyView>
                    <Label Text="{controls:Translate 'No guests.'}" FontSize="12" Style="{StaticResource SubtleLabel}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:GuestRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{controls:Translate 'Remove'}" FontSize="12" Padding="10,4"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.UninviteCommand, x:DataType=calendar:CalendarEventDetailPage}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{controls:Translate 'Add a guest from contacts'}" Style="{StaticResource FieldLabel}"
                   IsVisible="{Binding CanEdit}" />
            <Label IsVisible="{Binding HasNobodyToInvite}" FontSize="12" LineBreakMode="WordWrap"
                   Style="{StaticResource SubtleLabel}">
                <Label.Text>
                    <controls:Translate Text="No contacts. A contact will appear here once you start a chat with someone." />
                </Label.Text>
            </Label>
            <VerticalStackLayout Spacing="6" IsVisible="{Binding CanEdit}"
                                 BindableLayout.ItemsSource="{Binding ContactsToInvite}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:GuestRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{controls:Translate 'Invite'}" FontSize="12" Padding="10,4"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.InviteCommand, x:DataType=calendar:CalendarEventDetailPage}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{controls:Translate 'Reminders'}" Style="{StaticResource FieldLabel}" />
            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Reminders}">
                <BindableLayout.EmptyView>
                    <Label Text="{controls:Translate 'No reminders.'}" FontSize="12"
                           Style="{StaticResource SubtleLabel}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:ReminderRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{controls:Translate 'Remove'}" FontSize="12" Padding="10,4"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.RemoveReminderCommand, x:DataType=calendar:CalendarEventDetailPage}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <!-- A sheet rather than a picker. iOS docks a picker's wheel at the bottom of the screen,
                 which on a form this long covers Save - and its "Done" lands on top of that button. -->
            <Button Text="{controls:Translate 'Add reminder'}" HorizontalOptions="Start"
                    FontSize="12" Padding="12,6" IsVisible="{Binding CanEdit}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ChooseReminderCommand, x:DataType=calendar:CalendarEventDetailPage}" />

            <Label Text="{controls:Translate 'Notification as the event approaches'}"
                   Style="{StaticResource FieldLabel}" />
            <Button Text="{Binding ReminderChannel.Name}" HorizontalOptions="Start" FontSize="13" Padding="12,6"
                    IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ChooseReminderChannelCommand, x:DataType=calendar:CalendarEventDetailPage}" />

            <!-- A different question from the reminders above: those say it is coming, this says it has
                 begun. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{controls:Translate 'Also when it starts'}" VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
                <Switch Grid.Column="1" IsToggled="{Binding NotifyAtStart}" IsEnabled="{Binding CanEdit}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{controls:Translate 'Also when it starts'}" />
            </Grid>

            <!-- Opened from the event's own menu rather than standing at the foot of the form: sharing
                 is something somebody does once, and this form is long enough already. -->
            <controls:SharePanel x:Name="Sharing" IsVisible="False" BindingContext="{Binding Share}" />

            <!-- Hands the event to Google Calendar as a filled-in form, which is what Orbit.Web offers
                 here too - a link rather than an API call, see GoogleCalendarEventLink. Hidden unless
                 the account qualifies; see GoogleIntegrationAccess. -->
            <Button Text="{controls:Translate 'Add to Google Calendar'}" HorizontalOptions="Start" FontSize="14"
                    Style="{StaticResource LinkButton}"
                    IsVisible="{Binding CanAddToGoogleCalendar}"
                    Clicked="OnAddToGoogleCalendarClicked" />

        </VerticalStackLayout>
    </ScrollView>

        <!-- What the event can have done to it hangs under its name in the bar. The two answers this
             form takes are drawn as buttons over its foot, one in each corner: the tick on the right,
             where the thumb is, and leaving it alone on the left. Words before, at the end of a form
             long enough that neither was on screen while anybody was filling it in - this is the one
             screen in the app that writes on a Save rather than as it goes. -->
        <controls:Fab Grid.Row="1" IsAboveAdBar="False" Data="M5,12 L10,17 L19,7"
                      Description="{controls:Translate 'Save'}"
                      Command="{Binding SaveCommand}" />
        <controls:Fab Grid.Row="1" IsAboveAdBar="False" IsOnTheLeft="True" Diameter="44"
                      Data="M6,6 L18,18 M18,6 L6,18"
                      Description="{controls:Translate 'Cancel'}"
                      Command="{Binding GoBackCommand}" />

        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=calendar:CalendarEventDetailPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
