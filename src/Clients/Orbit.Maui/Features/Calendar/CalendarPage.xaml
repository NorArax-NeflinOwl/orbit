<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Calendar.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:calendar="clr-namespace:Orbit.Maui.Features.Calendar"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Calendar;assembly=Orbit.Mobile"
    x:DataType="screens:CalendarViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Calendar'}">

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,16,16,28" RowSpacing="10">

        <!-- The month at a glance, or the year. Orbit.Web offers day, month and year; the day here is
             this grid with one of its days chosen, so the switch beneath is the rest of it. -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <!-- The plus left of the name and the reading order behind the three dots at the other
                 end, which is where Orbit.Web's Calendar header keeps both. -->
            <controls:PageHeader Title="{controls:Translate 'Calendar'}">
                <controls:PageHeader.LeadingAction>
                    <controls:IconButton Variant="Add" Data="M10,4 V16 M4,10 H16"
                                         Description="{controls:Translate 'Add event'}"
                                         Command="{Binding ToggleAddCommand, Source={x:Reference Page}, x:DataType=calendar:CalendarPage}" />
                </controls:PageHeader.LeadingAction>
                <controls:PageHeader.Actions>
                    <controls:OverflowMenu Command="{Binding ChooseSortOrderCommand, Source={x:Reference Page}, x:DataType=calendar:CalendarPage}" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                <Button Grid.Column="0" Text="‹" SemanticProperties.Description="{controls:Translate 'Earlier'}" FontSize="20" Padding="10,0" Style="{StaticResource LinkButton}"
                        Command="{Binding ShowEarlierCommand}" />
                <Label Grid.Column="1" Text="{Binding PeriodLabel}" FontSize="17" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="›" SemanticProperties.Description="{controls:Translate 'Later'}" FontSize="20" Padding="10,0" Style="{StaticResource LinkButton}"
                        Command="{Binding ShowLaterCommand}" />
                <Button Grid.Column="3" Text="{controls:Translate 'Today'}" FontSize="12" Padding="8,0"
                        Style="{StaticResource LinkButton}" Command="{Binding ShowTodayCommand}" />
            </Grid>

            <!-- Which of the three is showing, the same three the browser offers. The ones not showing
                 go quiet, the way the days either side of the month do - bold alone is too fine a
                 difference at this size to read. -->
            <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                <Button Text="{controls:Translate 'Day'}" FontSize="13" Padding="4,0"
                        Style="{StaticResource LinkButton}" Command="{Binding ShowDayCommand}"
                        Opacity="0.4">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsShowingDay}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{controls:Translate 'Month'}" FontSize="13" Padding="4,0"
                        Style="{StaticResource LinkButton}" Command="{Binding ShowMonthCommand}"
                        Opacity="0.4">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsShowingMonth}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{controls:Translate 'Year'}" FontSize="13" Padding="4,0"
                        Style="{StaticResource LinkButton}" Command="{Binding ShowYearCommand}"
                        Opacity="0.4">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsShowingYear}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <!-- A seventh of the row each, for both the names and the days beneath them - see the day
                 cell below for why this is a fraction rather than a width. -->
            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding WeekdayNames}"
                        IsVisible="{Binding IsShowingMonth}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" FontSize="10" FlexLayout.Basis="14.28%"
                               HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Days}"
                        IsVisible="{Binding IsShowingMonth}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:CalendarDay">
                        <!-- A seventh of the row, not a fixed 46. A week is seven days by construction;
                             with a width it was seven only on the screens the width happened to suit,
                             and the grid ran eight days to a row on a phone slightly wider than that.
                             Just under a seventh so seven always fit: 7 x 14.29% overflows and wraps at
                             six, which is the same bug the other way. -->
                        <Grid FlexLayout.Basis="14.28%" HeightRequest="40" RowDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ChooseDayCommand, x:DataType=calendar:CalendarPage}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Row="0" Text="{Binding DayNumber}" FontSize="13" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <!-- The days either side that fill the first and last weeks are shown
                                         but quiet: a grid with holes is harder to read than one with
                                         soft edges. -->
                                    <DataTrigger TargetType="Label" Binding="{Binding IsInMonth}" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="FontAttributes" Value="Bold" />
                                        <Setter Property="TextColor"
                                                Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- One dot for "something happens here", not a count: the number is in the
                                 list beneath, and a grid cell this size cannot carry both. -->
                            <Ellipse Grid.Row="1" WidthRequest="5" HeightRequest="5" HorizontalOptions="Center"
                                     IsVisible="{Binding HasEvents}"
                                     Fill="{DynamicResource Accent}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- The year: twelve months and what each holds. Tapping one opens it. -->
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Months}" IsVisible="{Binding IsShowingYear}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:CalendarYearMonth">
                        <Grid WidthRequest="104" HeightRequest="58" Margin="2" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ChooseMonthCommand, x:DataType=calendar:CalendarPage}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Row="0" Text="{Binding Name}" FontSize="14" HorizontalTextAlignment="Center"
                                   VerticalOptions="End">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsThisMonth}" Value="True">
                                        <Setter Property="FontAttributes" Value="Bold" />
                                        <Setter Property="TextColor"
                                                Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- A count rather than a dot: twelve cells this size can carry the number,
                                 and "how busy" is what a year is read for. -->
                            <Label Grid.Row="1" Text="{Binding EventCount}" FontSize="11" IsVisible="{Binding HasEvents}"
                                   HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <Grid x:Name="AddRow" IsVisible="False" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="AddField" Grid.Column="0" Placeholder="{controls:Translate 'New event'}"
                   Text="{Binding NewEventTitle}"
                   ReturnType="Done" ReturnCommand="{Binding AddEventCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddEventCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <!-- When the event above starts. Named, because the two sit under the box it is
                     typed into rather than under headings of their own. -->
            <DatePicker Grid.Column="0" Date="{Binding NewEventDate}" Format="{controls:DatePattern}"
                        SemanticProperties.Description="{controls:Translate 'Starts'}" />
            <TimePicker Grid.Column="1" Time="{Binding NewEventTime}" Format="{controls:TimePattern}"
                        SemanticProperties.Description="{controls:Translate 'Starts'}" />
        </Grid>

        <!-- The chosen day on the clock, under the grid that chose it. Orbit.Web swaps its grid for this
             because it has a sidebar to pick the next day from; a phone has only the grid, so the two
             stack. Built in code-behind for the reason MapPage gives about its pins: where a block goes
             is a layout measurement, and keeping that out of the view model is what leaves the
             placement testable - see CalendarDayTimeline. -->
        <VerticalStackLayout Grid.Row="3" Spacing="6" IsVisible="{Binding HasDayTimeline}">
                <FlexLayout x:Name="AllDayRow" Wrap="Wrap" Direction="Row" />
                <!-- The hours down the left, the day itself beside them. Blocks are placed with
                     proportional widths, because how wide a lane is depends on a measurement this page
                     does not have until it is laid out. As tall as the day needs and no taller - see
                     CalendarDayTimeline.HoursWorthDrawing. -->
                <Grid x:Name="DayClock" ColumnDefinitions="42,*">
                    <Grid x:Name="HourLabels" Grid.Column="0" />
                    <AbsoluteLayout x:Name="DayBlocks" Grid.Column="1" />
                </Grid>
        </VerticalStackLayout>

        <!-- One list, whatever kind of thing is on it. Appointments and deadlines answer the same
             question - what is happening in this period - and two lists one under the other made the
             reader merge them by eye, in a period where they interleave by definition. Orbit.Web's
             calendar draws them together for the same reason - see CalendarListEntry. -->
        <RefreshView Grid.Row="4" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Listed}"
                            Scrolled="OnListScrolled"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenListedCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'Nothing coming up.'}" Padding="0,12" Style="{StaticResource EmptyHint}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:CalendarListEntry">
                        <!-- The same card every list of things is drawn with - see ItemCard. -->
                        <controls:ItemCard Name="{Binding Name}">
                            <controls:ItemCard.Tags>
                                <HorizontalStackLayout Spacing="6">
                                    <!-- Which kind of thing this is, now that both kinds share one list. -->
                                    <Border Style="{StaticResource FilterChip}" Padding="6,3" IsVisible="{Binding IsEvent}">
                                        <Label Text="{controls:Translate 'Event'}" Style="{StaticResource FilterChipLabel}" />
                                    </Border>
                                    <Border Style="{StaticResource FilterChip}" Padding="6,3" IsVisible="{Binding IsDeadline}">
                                        <Label Text="{controls:Translate 'Task'}" Style="{StaticResource FilterChipLabel}" />
                                    </Border>
                                    <!-- Two cards with the same title are otherwise indistinguishable, and
                                         the reader has no way of telling which one they wrote in. -->
                                    <Label Text="{controls:Translate 'copy'}" IsVisible="{Binding IsCopy}"
                                           FontSize="11" VerticalOptions="Center" Style="{StaticResource SubtleLabel}" />
                                </HorizontalStackLayout>
                            </controls:ItemCard.Tags>

                            <controls:ItemCard.Body>
                                <Label Text="{Binding When}" FontSize="12" Style="{StaticResource SubtleLabel}">
                                    <Label.Triggers>
                                        <!-- Struck through rather than hidden: a day whose errands are all
                                             ticked reads differently from an empty one. -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </controls:ItemCard.Body>

                            <controls:ItemCard.Extras>
                                <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="12"
                                       LineBreakMode="WordWrap" TextColor="{DynamicResource Accent}" />
                            </controls:ItemCard.Extras>
                        </controls:ItemCard>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=calendar:CalendarPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
