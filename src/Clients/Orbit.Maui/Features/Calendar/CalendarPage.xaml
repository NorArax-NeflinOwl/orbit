<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Calendar.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:calendar="clr-namespace:Orbit.Maui.Features.Calendar"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Calendar;assembly=Orbit.Mobile"
    x:DataType="screens:CalendarViewModel"
    x:Name="Page"
    Title="{Binding PeriodLabel}">

    <ContentPage.Resources>
        <!-- The bar down the left of a row in the list - see EventColourConverter, which hands over a
             brush rather than a colour because a Shape's Fill takes one. -->
        <controls:EventColourConverter x:Key="EventColour" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,14,20,0" RowSpacing="10">

        <!-- One row of controls and then the calendar itself. Which of the four is showing on the left,
             and where in it on the right - the design's own first line, and what used to be two rows: a
             period name with arrows either side, and the view switch under it. The period name is in
             the bar now, where the screen's name goes. -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <!-- The ones not showing go quiet, the way the days either side of the month do - bold
                     alone is too fine a difference at this size to read. -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Button Text="{controls:Translate 'Day'}" FontSize="13" Padding="2,0"
                            Style="{StaticResource LinkButton}" Command="{Binding ShowDayCommand}"
                            Opacity="0.4">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsShowingDay}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="{controls:Translate 'Week'}" FontSize="13" Padding="2,0"
                            Style="{StaticResource LinkButton}" Command="{Binding ShowWeekCommand}"
                            Opacity="0.4">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsShowingWeek}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="{controls:Translate 'Month'}" FontSize="13" Padding="2,0"
                            Style="{StaticResource LinkButton}" Command="{Binding ShowMonthCommand}"
                            Opacity="0.4">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsShowingMonth}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="{controls:Translate 'Year'}" FontSize="13" Padding="2,0"
                            Style="{StaticResource LinkButton}" Command="{Binding ShowYearCommand}"
                            Opacity="0.4">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsShowingYear}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="0">
                    <Button Text="‹" SemanticProperties.Description="{controls:Translate 'Earlier'}"
                            FontSize="20" Padding="8,0" Style="{StaticResource LinkButton}"
                            Command="{Binding ShowEarlierCommand}" />
                    <Button Text="{controls:Translate 'Today'}" FontSize="12" Padding="4,0"
                            Style="{StaticResource LinkButton}" Command="{Binding ShowTodayCommand}" />
                    <Button Text="›" SemanticProperties.Description="{controls:Translate 'Later'}"
                            FontSize="20" Padding="8,0" Style="{StaticResource LinkButton}"
                            Command="{Binding ShowLaterCommand}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- A seventh of the row each, for both the names and the days beneath them - see the day
                 cell below for why this is a fraction rather than a width. -->
            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding WeekdayNames}"
                        IsVisible="{Binding IsShowingAGrid}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" FlexLayout.Basis="14.28%"
                               Style="{StaticResource CalendarWeekday}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Six rows of it for a month, one for a week - the same cells either way, which is what
                 makes stepping between the two views read as one calendar rather than two. -->
            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Days}"
                        IsVisible="{Binding IsShowingAGrid}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:CalendarDay">
                        <!-- A seventh of the row, not a fixed 46. A week is seven days by construction;
                             with a width it was seven only on the screens the width happened to suit,
                             and the grid ran eight days to a row on a phone slightly wider than that.
                             Just under a seventh so seven always fit: 7 x 14.29% overflows and wraps at
                             six, which is the same bug the other way. -->
                        <Border FlexLayout.Basis="14.28%" HeightRequest="44"
                                Style="{StaticResource CalendarDayCell}">
                            <Border.Triggers>
                                <!-- The days either side that fill the first and last weeks are shown
                                     but quiet, which the number itself says (see the label's own
                                     trigger) - a grid with holes is harder to read than one with soft
                                     edges, and filling those cells drew a grey block on either end of
                                     an otherwise open grid. -->
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid RowDefinitions="*,Auto" Padding="4">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ChooseDayCommand, x:DataType=calendar:CalendarPage}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Label Grid.Row="0" Text="{Binding DayNumber}" FontSize="13.5"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsInMonth}" Value="False">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- One dot for "something happens here", not a count or a chip: the
                                     phone's grid is a fraction of the browser's height on purpose - it
                                     gets out of the way as the list beneath it is read (see
                                     info/orbit-maui-plan.md §14.1) - and a cell this size carries one
                                     mark or nothing. -->
                                <Ellipse Grid.Row="1" WidthRequest="5" HeightRequest="5" HorizontalOptions="Center"
                                         IsVisible="{Binding HasEvents}"
                                         Fill="{DynamicResource Accent}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- The year: twelve months and what each holds. Tapping one opens it. -->
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Months}" IsVisible="{Binding IsShowingYear}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="screens:CalendarYearMonth">
                        <Grid WidthRequest="104" HeightRequest="58" Margin="2" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ChooseMonthCommand, x:DataType=calendar:CalendarPage}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Row="0" Text="{Binding Name}" FontSize="14" HorizontalTextAlignment="Center"
                                   VerticalOptions="End">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsThisMonth}" Value="True">
                                        <Setter Property="FontAttributes" Value="Bold" />
                                        <Setter Property="TextColor"
                                                Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- A count rather than a dot: twelve cells this size can carry the number,
                                 and "how busy" is what a year is read for. -->
                            <Label Grid.Row="1" Text="{Binding EventCount}" FontSize="11" IsVisible="{Binding HasEvents}"
                                   HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <Grid x:Name="AddRow" IsVisible="False" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="AddField" Grid.Column="0" Placeholder="{controls:Translate 'New event'}"
                   Text="{Binding NewEventTitle}"
                   ReturnType="Done" ReturnCommand="{Binding AddEventCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddEventCommand}" />
        </Grid>

        <!-- Folded away with the box above them: these two say when the event being typed in starts,
             and on their own under a header with no box they were two dates about nothing. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8"
              IsVisible="{Binding IsVisible, Source={x:Reference AddRow}, x:DataType=Grid}">
            <!-- When the event above starts. Named, because the two sit under the box it is
                     typed into rather than under headings of their own. -->
            <DatePicker Grid.Column="0" Date="{Binding NewEventDate}" Format="{controls:DatePattern}"
                        SemanticProperties.Description="{controls:Translate 'Starts'}" />
            <TimePicker Grid.Column="1" Time="{Binding NewEventTime}" Format="{controls:TimePattern}"
                        SemanticProperties.Description="{controls:Translate 'Starts'}" />
        </Grid>

        <Label Grid.Row="3" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
               LineBreakMode="WordWrap" VerticalOptions="End" Style="{StaticResource ErrorLabel}" />

        <!-- The chosen day: the whole clock, midnight to midnight, and under it the things that have no
             hour to be drawn at. Nothing else - the list of the period every other view draws would be
             the same things again, one under the other.

             The clock is always twenty-four hours. It used to be cropped to the hours something was in,
             and a clock whose length changes with what is on it cannot be read at a glance, because
             nine o'clock is somewhere different on every day of the week. The screen opens scrolled to
             the day's first thing instead, which answers the same objection without moving the hours.

             Built in code-behind for the reason MapPage gives about its pins: where a block goes is a
             layout measurement, and keeping that out of the view model is what leaves the placement
             testable - see CalendarDayTimeline. -->
        <ScrollView x:Name="DayScroll" Grid.Row="4" IsVisible="{Binding HasDayTimeline}">
            <VerticalStackLayout Spacing="6" Padding="0,0,0,24">
                <!-- The hours down the left, the day itself beside them. Blocks are placed with
                     proportional widths, because how wide a lane is depends on a measurement this page
                     does not have until it is laid out. -->
                <Grid x:Name="DayClock" ColumnDefinitions="42,*">
                    <Grid x:Name="HourLabels" Grid.Column="0" />
                    <AbsoluteLayout x:Name="DayBlocks" Grid.Column="1" />
                </Grid>

                <!-- What is on this day and not at a time: an all-day event, and anything falling due,
                     which the calendar files by its date alone. Hairline rows under a small-caps
                     heading, which is what the design draws under its own day. -->
                <VerticalStackLayout Spacing="0" Margin="0,10,0,0">
                    <Label Text="{controls:Translate 'All day'}" Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,8" />

                    <Label Text="{controls:Translate 'Nothing all day.'}" Padding="0,10"
                           IsVisible="{Binding HasNothingWithoutAnHour}" Style="{StaticResource EmptyHint}" />

                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding WithoutAnHour}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="screens:CalendarListEntry">
                                <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="12" Padding="0,11">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.OpenListedCommand, x:DataType=calendar:CalendarPage}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <BoxView Grid.ColumnSpan="3" Style="{StaticResource Hairline}"
                                             VerticalOptions="Start" Margin="0,-11,0,0" />

                                    <!-- A dot rather than the list's own bar: there is no date column
                                         here for it to stand beside, and a day is one day. -->
                                    <Ellipse Grid.Column="0" WidthRequest="8" HeightRequest="8"
                                             VerticalOptions="Center"
                                             Fill="{Binding Colour, Converter={StaticResource EventColour}}" />

                                    <Label Grid.Column="1" Text="{Binding Headline}" FontSize="14"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Grid.Column="2" Text="{Binding Where}" IsVisible="{Binding HasWhere}"
                                           FontSize="12" VerticalOptions="Center"
                                           LineBreakMode="TailTruncation" Style="{StaticResource ItemCardFooter}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- One list, whatever kind of thing is on it. Appointments and deadlines answer the same
             question - what is happening in this period - and two lists one under the other made the
             reader merge them by eye, in a period where they interleave by definition. Orbit.Web's
             calendar draws them together for the same reason - see CalendarListEntry. -->
        <RefreshView Grid.Row="4" IsVisible="{Binding IsNotShowingOneDay}"
                     IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Listed}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenListedCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'Nothing coming up.'}" Padding="0,12" Style="{StaticResource EmptyHint}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:CalendarListEntry">
                        <!-- [ Fri 5 ] | [ what it is called      ] [Task] [⋯]
                             [ 12:00 ] | [ and where, or the list ]

                             The design's own row, and a real improvement on what it replaced: the date
                             column down the left is what makes a list of a period readable at all, and
                             the deadline that used to read "Weekend errands: Flour, rice, olive oil"
                             with a WEEKEND ERRANDS badge under it now says the list once, in the line
                             the design keeps for where something is. A list is where you would go to
                             tick a deadline off, which is the nearest thing it has to somewhere.

                             Not an ItemCard: a card's anatomy has nowhere to put a leading column of
                             two lines, and this list leads with when. -->
                        <Grid ColumnDefinitions="58,3,*,Auto" ColumnSpacing="12" Padding="0,10">
                            <!-- The hairline above it, which is what separates one row from the next
                                 everywhere in this design - see ItemCard's row shape. -->
                            <BoxView Grid.ColumnSpan="4" Style="{StaticResource Hairline}"
                                     VerticalOptions="Start" Margin="0,-10,0,0" />

                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Day}" FontSize="13" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Time}" FontSize="11" LineBreakMode="TailTruncation"
                                       Style="{StaticResource ItemCardFooter}" />
                            </VerticalStackLayout>

                            <!-- The event's own colour, which is what a card used to paint down its
                                 edge. An entry falling due has none of its own and takes the accent -
                                 see EventColourConverter, and Orbit.Web's dot, which falls back the
                                 same way; the chip on the right is what says which kind it is. -->
                            <Rectangle Grid.Column="1" RadiusX="2" RadiusY="2"
                                       Fill="{Binding Colour, Converter={StaticResource EventColour}}" />

                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Headline}" FontSize="14" LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <!-- Struck through rather than hidden: a day whose errands are
                                             all ticked reads differently from an empty one. -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="{Binding Where}" IsVisible="{Binding HasWhere}" FontSize="12"
                                       LineBreakMode="TailTruncation" Style="{StaticResource ItemCardFooter}" />

                                <!-- Why it cannot be changed from here just now, and whether it is a
                                     copy taken while offline - two things about this row's own state
                                     rather than about the thing it stands for. -->
                                <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                       LineBreakMode="WordWrap" Style="{StaticResource ItemCardFooter}"
                                       TextColor="{DynamicResource Accent}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                                <!-- Two rows with the same words are otherwise indistinguishable, and
                                     the reader has no way of telling which one they wrote in. -->
                                <Border Style="{StaticResource CardBadge}" IsVisible="{Binding IsCopy}">
                                    <Label Text="{controls:Translate 'copy'}" Style="{StaticResource CardBadgeLabel}" />
                                </Border>
                                <!-- Which kind of thing this is, now that both kinds share one list.
                                     Only on a deadline: an appointment is what a calendar is for, and
                                     an EVENT chip on every second row says nothing. -->
                                <Border Style="{StaticResource CardBadge}" IsVisible="{Binding IsDeadline}">
                                    <Label Text="{controls:Translate 'Task'}" Style="{StaticResource CardBadgeLabel}" />
                                </Border>

                                <!-- What can be done to it without opening it, in the corner every row
                                     keeps its menu in - see Orbit.Web's calendar cards. -->
                                <controls:OverflowMenu
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowCardMenuCommand, x:DataType=calendar:CalendarPage}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
        <!-- Across the foot, under everything the page itself draws - see AdBanner, and .ad-banner
             in Orbit.Web's app.css, which is the same bar on a narrow window. -->
        <controls:AdBanner Grid.Row="2" />
        <controls:Fab x:Name="AddButton" Grid.Row="1" IsAboveAdBar="True"
                      Description="{controls:Translate 'Add event'}" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=calendar:CalendarPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
