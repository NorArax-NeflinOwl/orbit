<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Notifications.NotificationFeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:notifications="clr-namespace:Orbit.Maui.Features.Notifications"
    xmlns:feed="clr-namespace:Orbit.Maui.Features.Notifications"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Notifications;assembly=Orbit.Mobile"
    x:DataType="screens:NotificationFeedViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Notifications'}">

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="20,14,20,0" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <!-- What is done *to* this list - marking it read, clearing it, showing what was already
                 read - hangs under the screen's name now (see ITitleMenu). Three link buttons in a row
                 above the feed read as part of it, and the one under them said "Back", which is what
                 the bar's own arrow is. -->
            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" LineBreakMode="WordWrap" />
            <controls:OrbitLoading IsRunning="{Binding IsBusy}" RingSize="30" HorizontalOptions="Start" />

            <Label Text="{controls:Translate 'Nothing here yet.'}" IsVisible="{Binding HasNothing}"
                   Style="{StaticResource EmptyHint}" Margin="0,20,0,0" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="screens:NotificationRow">
                    <!-- The row is the button, as everywhere else in the app and in every other phone
                         app: a notification that leads somewhere is tapped, not accompanied by an
                         "Open". One that leads nowhere simply does not respond. -->
                    <Grid ColumnDefinitions="Auto,*" Padding="0,10" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.OpenCommand, x:DataType=feed:NotificationFeedPage}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!-- An unread entry is the only thing worth drawing the eye to, so it is the only
                             thing marked. A read one carries no dot rather than a greyed-out one. -->
                        <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 VerticalOptions="Start" Margin="0,6,0,0"
                                 Color="{DynamicResource Accent}" IsVisible="{Binding IsUnread}" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Body}" FontSize="13" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
        <!-- Across the foot, under everything the page itself draws - see AdBanner, and .ad-banner
             in Orbit.Web's app.css, which is the same bar on a narrow window. -->
        <controls:AdBanner Grid.Row="2" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3" 
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=notifications:NotificationFeedPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
