<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Notifications.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Notifications;assembly=Orbit.Mobile"
    x:DataType="screens:NotificationSettingsViewModel"
    Title="Notification settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Notifications" FontSize="26" FontAttributes="Bold" />
            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                   FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Notify me" FontAttributes="Bold" />
                    <Label Text="Off means nothing is recorded or sent at all." FontSize="12"
                           TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding AllowNotifications}" VerticalOptions="Center" />
            </Grid>

            <!-- Hidden rather than disabled: with the master switch off these do nothing at all, and a
                 switch that can be moved without effect is worse than one that is not offered. -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding CanChooseChannels}">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Push to this phone" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding AllowPush}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Email" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding AllowEmail}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="When something is shared with me" />
                        <Label Text="It always appears in your notifications. This also pushes or emails."
                               FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AllowShareNotifications}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Back" Command="{Binding GoBackCommand}" BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
