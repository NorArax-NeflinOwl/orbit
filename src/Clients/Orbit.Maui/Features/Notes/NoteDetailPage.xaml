<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Notes.NoteDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:notes="clr-namespace:Orbit.Maui.Features.Notes"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Notes;assembly=Orbit.Mobile"
    x:DataType="screens:NoteDetailViewModel"
    x:Name="Page"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="20,10,20,0" RowSpacing="8">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <controls:CopyOffer IsOffered="{Binding IsCopyOffered}"
                                TakeCommand="{Binding CopyForEditingCommand}"
                                DeclineCommand="{Binding DeclineCopyCommand}" />

            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                   FontSize="12" LineBreakMode="WordWrap"
                   TextColor="{DynamicResource Accent}" />
            <!-- Why this note cannot be changed, which is the answer to every press that does nothing. -->
            <Label Text="{Binding ReadOnlyReason}" IsVisible="{Binding IsReadOnly}"
                   LineBreakMode="WordWrap" Style="{StaticResource ItemCardFooter}" />

            <!-- While boxes are being chosen to change together: how many are, what a press on one of
                 them will do, and the way out - see NoteDetailViewModel.IsPickingLines. Over the note
                 rather than beside the boxes, where it would push the writing about. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsPickingLines}">
                <Label Grid.Column="0" Text="{Binding PickingHint}" LineBreakMode="WordWrap"
                       Style="{StaticResource ItemCardFooter}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{controls:Translate 'Finish selecting'}"
                        Command="{Binding StopPickingLinesCommand}" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- Opened from the note's own menu rather than standing at the foot of every note: sharing is
             something somebody does once, and the design gives the screen to what the note says. -->
        <controls:SharePanel Grid.Row="1" x:Name="Sharing" IsVisible="False"
                             BindingContext="{Binding Share}" />

        <!-- One surface. The first line is the note's name, set larger and bold, and everything under it
             is the note - which is what the design draws, and what anybody who has written a note on a
             phone expects. It is a column of bare fields rather than one text box because a line can
             carry a real tick box and no text box can hold a control; nothing else about it is meant to
             read as a list - no rules, no spacing, no boxes.

             Enter starts the next line, keeping the indentation of the one above; backspace at the very
             start of a line joins it to the one above, and the arrows walk the caret from one line to
             the next keeping the column - all three as they would anywhere else, see NoteLineKeys.
             Typing "[]" at the head of a line turns it into a tick box, which is the design's own way in
             and the reason there is no toolbar. -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="0" Padding="0,4,0,96">
                <!-- The name is the note's first line, so the key at the end of it goes on into the
                     writing rather than finishing anything. Left to itself a single-line field says
                     "Done" and the keyboard's own key is a tick, which is what pressing Enter here
                     looked like it did: it closed the keyboard and the note stayed as it was. -->
                <Entry x:Name="TitleField" Text="{Binding Title}" FontFamily="OrbitDisplay"
                       FontSize="22" FontAttributes="Bold" IsReadOnly="{Binding IsReadOnly}"
                       Placeholder="{controls:Translate 'Untitled'}" ReturnType="Next"
                       Completed="OnTitleCompleted"
                       controls:BareField.IsBare="True" Margin="0,0,0,6" />

                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Lines}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="screens:NoteLineRow">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <controls:CheckCircle Grid.Column="0" Diameter="19" Margin="0,9,8,0"
                                                      VerticalOptions="Start" IsVisible="{Binding IsChecklistItem}"
                                                      IsChecked="{Binding IsChecked}"
                                                      IsFailed="{Binding IsFailed}"
                                                      Description="{Binding Text}"
                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ToggleCheckedCommand, x:DataType=notes:NoteDetailPage}"
                                                      LongPressCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.PickThisLineCommand, x:DataType=notes:NoteDetailPage}"
                                                      CommandParameter="{Binding .}" />

                                <!-- The mark at the head of a line of a list - a dot, a dash, or the
                                     line's number. Drawn beside the words rather than typed into them,
                                     so it is never part of what is stored and never carried by a copy
                                     of the line. In the box's own column, and never shown at the same
                                     time as a box: see NoteLineRow.ShowsListMark. -->
                                <Label Grid.Column="0" Text="{Binding ListMark}" Margin="0,10,8,0"
                                       VerticalOptions="Start" IsVisible="{Binding ShowsListMark}"
                                       Style="{StaticResource SubtleLabel}" />

                                <Entry Grid.Column="1" Text="{Binding Text}" VerticalOptions="Center"
                                       FontSize="{Binding DrawnFontSize}"
                                       IsVisible="{Binding IsOpenForWriting}"
                                       controls:BareField.IsBare="True" ReturnType="Next"
                                       IsReadOnly="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.IsReadOnly, x:DataType=notes:NoteDetailPage}"
                                       controls:NoteLineKeys.JoinsTheLineAbove="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=JoinTheLineAboveCommand, x:DataType=notes:NoteDetailPage}"
                                       controls:NoteLineKeys.GoesToTheLineAbove="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=GoToTheLineAboveCommand, x:DataType=notes:NoteDetailPage}"
                                       controls:NoteLineKeys.GoesToTheLineBelow="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=GoToTheLineBelowCommand, x:DataType=notes:NoteDetailPage}"
                                       controls:NoteLineKeys.IndentsTheLine="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=IndentTheLineCommand, x:DataType=notes:NoteDetailPage}"
                                       controls:NoteLineKeys.OutdentsTheLine="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=OutdentTheLineCommand, x:DataType=notes:NoteDetailPage}"
                                       Completed="OnLineCompleted" Focused="OnLineFocused"
                                       Unfocused="OnLineUnfocused" Loaded="OnLineLoaded">
                                    <!-- A heading is bold. A trigger rather than a bound
                                         FontAttributes, because Orbit.Mobile is plain net10.0 and knows
                                         nothing about MAUI's own types - see NoteLineRow.IsDrawnBold. -->
                                    <Entry.Triggers>
                                        <DataTrigger TargetType="Entry" Binding="{Binding IsDrawnBold}" Value="True">
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Entry.Triggers>
                                </Entry>

                                <!-- A ticked line is struck through, from its box rightwards - which on
                                     a line whose box is at its head is the whole line. A Label rather
                                     than the field above, because MAUI puts TextDecorations on a Label
                                     and on nothing else.

                                     Pressing it opens the field in its place. Without that a ticked line
                                     cannot be reached by the keyboard at all - there is no field to put
                                     a caret in - so backspace did nothing on one and the only way to be
                                     rid of it was to untick it first. -->
                                <Label Grid.Column="1" Text="{Binding Text}" VerticalOptions="Center"
                                       IsVisible="{Binding IsStruckThrough}" Margin="0,10"
                                       FontSize="{Binding DrawnFontSize}"
                                       TextDecorations="Strikethrough" LineBreakMode="WordWrap"
                                       Style="{StaticResource SubtleLabel}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=OpenForWritingCommand, x:DataType=notes:NoteDetailPage}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>


                                <!-- Words with marks on stretches of them - bold, italic, underlined,
                                     struck through - drawn by MarkedLabel while the line is not being
                                     written in, because a field renders one face for the whole of it.
                                     Pressing it opens the field, as pressing a struck-through line does;
                                     the marks are kept over the right words while somebody types and
                                     come back with the label - see NoteLineRow.Marks. -->
                                <controls:MarkedLabel Grid.Column="1" Words="{Binding Text}" Marks="{Binding Marks}"
                                                      IsVisible="{Binding ShowsMarkedWords}" Margin="0,10"
                                                      FontSize="{Binding DrawnFontSize}" VerticalOptions="Center"
                                                      LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="controls:MarkedLabel" Binding="{Binding IsDrawnBold}" Value="True">
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=OpenForWritingCommand, x:DataType=notes:NoteDetailPage}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </controls:MarkedLabel>

                                <!-- A table, drawn as the grid of its cells' words - see NoteLineRow.TableRows /
                                     SharedLine.TableRows. Two nested BindableLayouts rather than a Grid, because
                                     a Grid's rows and columns are declared and a table's are whatever the note
                                     says. Hairlines between cells, as the browser draws them. -->
                                <VerticalStackLayout Grid.Column="1" Spacing="0" Margin="0,8"
                                                     IsVisible="{Binding IsATable}"
                                                     BindableLayout.ItemsSource="{Binding TableRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="sys:Object">
                                            <HorizontalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding .}">
                                                <BindableLayout.ItemTemplate>
                                                    <!-- A cell is a field, bare as a line's is, so the table is
                                                         written in where it is read. What it says goes into the
                                                         table through NoteTableCellField; the table's own menu
                                                         (a row, a column, the table) is the table button over
                                                         the foot, once a cell has the caret - see UseTheTableTool. -->
                                                    <DataTemplate x:DataType="screens:NoteTableCellField">
                                                        <Border Padding="8,0" StrokeThickness="1" MinimumWidthRequest="72"
                                                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}">
                                                            <Entry Text="{Binding Text}" controls:BareField.IsBare="True"
                                                                   ReturnType="Done" MinimumWidthRequest="56"
                                                                   IsReadOnly="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.IsReadOnly, x:DataType=notes:NoteDetailPage}"
                                                                   Focused="OnCellFocused" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- A picture the note holds, fetched once and kept on the handset - see
                                     NoteLineRow.PictureBytes and NotePictureCache. Drawn at the note's
                                     width and no taller than a screen's worth, as the browser draws it.
                                     While there are no bytes - on their way, or not to be had - a line
                                     says so in its place (NoteLineRow.PictureNote), so the reader knows
                                     there is something here rather than seeing a blank. -->
                                <Image Grid.Column="1" Aspect="AspectFit" HorizontalOptions="Start"
                                       MaximumHeightRequest="360" Margin="0,8"
                                       IsVisible="{Binding ShowsPicture}"
                                       Source="{Binding PictureBytes, Converter={StaticResource PictureBytes}}" />
                                <Label Grid.Column="1" Text="{Binding PictureNote}"
                                       IsVisible="{Binding ShowsPictureNote}" Margin="0,10"
                                       Style="{StaticResource SubtleLabel}" />

                                <!-- A rule across the note, with what was written on it when it was made -
                                     see Orbit.Core.Notes.NoteSeparatorLine. A hairline and the stamp over
                                     it, the way the browser draws the same line; a plain rule is the same
                                     thing with nothing written, so one template draws both. Nothing is
                                     typed into it, which is why it is drawn rather than offered as a
                                     field. -->
                                <Grid Grid.Column="1" Margin="0,10" IsVisible="{Binding IsASeparator}">
                                    <BoxView HeightRequest="1" VerticalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
                                    <Label Text="{Binding SeparatorStamp}" IsVisible="{Binding ShowsSeparatorStamp}"
                                           HorizontalOptions="Center" Padding="8,0"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                                           Style="{StaticResource SubtleLabel}" />
                                </Grid>

                                <!-- The mark that chooses a box to change together with the others,
                                     beside every box while boxes are being chosen and nowhere else. At
                                     the line's end, away from the box it is about, so choosing a line
                                     is never mistaken for ticking it. -->
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsPicked}"
                                          IsVisible="{Binding ShowsPickMark}" VerticalOptions="Start"
                                          SemanticProperties.Description="{controls:Translate 'Select this line'}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Under the writing, quiet, and the only place the trick is written down: typing "[]"
                     at the head of a line turns it into a tick box, which is the design's own way in and
                     the reason there is no toolbar. A reader who never finds that never finds it at all.

                     The left half is the design's other half of the foot: who shared the note in, when
                     somebody did, and when it last changed - see NoteDetailViewModel.Footnote. It stays on
                     a note nobody can edit, where the trick has nothing to offer.

                     The hairline runs between the two so the line reads as a foot rather than as another
                     line of the note. -->
                <!-- What the note is about in a word or two, under the writing rather than in it - see
                     TagsForm. Saved with the note, by the button in the corner; a colour is saved there
                     and then, for the whole account. -->
                <controls:TagsFieldView BindingContext="{Binding Tags}" Margin="0,20,0,0" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,24,0,0">
                    <Label Grid.Column="0" Text="{Binding Footnote}"
                           Style="{StaticResource ItemCardFooter}" VerticalOptions="Center" />
                    <BoxView Grid.Column="1" Style="{StaticResource Hairline}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{controls:Translate 'Type [] for a checkbox'}"
                           IsVisible="{Binding CanEdit}"
                           Style="{StaticResource ItemCardFooter}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

        <!-- Across the foot, under everything the page itself draws. -->
        <controls:AdBanner Grid.Row="2" />

        <!-- Two buttons over the foot of the note, which is the one screen in Orbit with a button in
             each corner. Save on the right, where the thumb is: this screen is prose being typed, so it
             is written down when the writer says so rather than line by line. The tick box on the left,
             smaller because it is the lesser of the two - pressed, it puts a box on the line being
             written in and keeps putting one on each new line until it is pressed again. -->
        <controls:Fab x:Name="SaveButton" Grid.Row="1" IsAboveAdBar="True"
                      IsVisible="{Binding CanEdit}"
                      Data="M5,12 L10,17 L19,7"
                      Command="{Binding SaveLinesCommand}"
                      Description="{controls:Translate 'Save'}" />
        <controls:Fab x:Name="ChecklistButton" Grid.Row="1" IsAboveAdBar="True" IsOnTheLeft="True"
                      Diameter="44" IsVisible="{Binding CanEdit}"
                      IsOn="{Binding IsWritingAChecklist}"
                      Data="M4,5 H20 M4,5 V19 H20 V5 M8,12 L11,15 L16,9"
                      Description="{controls:Translate 'Checklist item'}" />

        <!-- Undo and redo, beside the tick-box button: a phone has no Ctrl+Z, and these are the writing's
             own tools as the tick box is. Dimmed while there is nothing to undo or redo - see
             NoteDetailViewModel.CanUndo. 44 across, the tick-box button's own size and the thumb target
             the phone's style gives every other control (see IconButton.TouchSize) - they were 30, the
             icon buttons' size in a card's head, which is a target for a pointer rather than a thumb.
             Level with the tick-box button (the same 72 up), 8 to its right, and touching each other
             rather than spaced: the drawings stay 18, so two 44 targets side by side still read as two
             glyphs a little apart. Where the row ends is the ScrollView's business - see below. -->
        <!-- Scrolled sideways, and stopped short of Save: 82 on the right is Save's 56 across, its 18
             from the edge and 8 of air. With the table and the separator the row is seven 44s, which is
             more than a phone has between the two corners, and laid out loose the last tool sat under
             Save - its drawing showing through Save's tick, and half of it pressing Save instead. A tool
             cut off at the edge says there is more to swipe to; one under another button says nothing. -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    HorizontalOptions="Fill" VerticalOptions="End" Margin="70,0,82,72"
                    IsVisible="{Binding CanEdit}">
        <HorizontalStackLayout Spacing="0" HorizontalOptions="Start">
            <controls:IconButton Data="M7,4 L3,8 L7,12 M3,8 H12 A4.5,4.5 0 0 1 12,17 H8" TouchSize="44"
                                 Command="{Binding UndoCommand}" IsEnabledForPress="{Binding CanUndo}"
                                 Description="{controls:Translate 'Undo'}" />
            <controls:IconButton Data="M13,4 L17,8 L13,12 M17,8 H8 A4.5,4.5 0 0 0 8,17 H12" TouchSize="44"
                                 Command="{Binding RedoCommand}" IsEnabledForPress="{Binding CanRedo}"
                                 Description="{controls:Translate 'Redo'}" />
            <!-- One level more at the head of the line being written in, and one level less. A soft
                 keyboard has no Tab key, so on a phone these are the only way to indent at all - the
                 browser's Tab and Shift+Tab have had it since 2026-09-11. Drawn as lines with an arrow
                 pointing the way the writing moves, which is how every editor draws the pair. Their
                 command is set in the code-behind, not bound here, because it is the line the caret is
                 in that they act on and only the page knows which that is - see PutABoxOnThisLine,
                 the tick-box button beside them, which is told the same thing the same way. -->
            <controls:IconButton x:Name="IndentButton" TouchSize="44"
                                 Data="M4,5 H16 M8,10 H16 M8,15 H16 M2,8 L5,10.5 L2,13"
                                 Description="{controls:Translate 'Indent'}" />
            <controls:IconButton x:Name="OutdentButton" TouchSize="44"
                                 Data="M4,5 H16 M8,10 H16 M8,15 H16 M5,8 L2,10.5 L5,13"
                                 Description="{controls:Translate 'Outdent'}" />
            <!-- What the line being written in is - a heading, a line of a list, ordinary writing. The
                 browser's "Aa" control, as a sheet: eight choices in a row over the writing would be
                 most of the writing on a phone. Drawn as a large A and a small one, which is how every
                 editor draws this. -->
            <controls:IconButton x:Name="StyleButton" TouchSize="44"
                                 Data="M2,16 L6,5 L10,16 M3.2,12.5 H8.8 M12,16 L14.6,9 L17.2,16 M12.8,14 H16.4"
                                 Description="{controls:Translate 'Text style'}" />
            <!-- The browser's table tool, which means two things told apart by where the caret is:
                 outside a table it puts one where the line being written in is, inside one it opens a
                 sheet of what can be done to that table. Drawn as a grid, which is how every editor
                 draws it. Its command is set in the code-behind for the reason the buttons beside it
                 give - only the page knows whether a cell has the caret. -->
            <controls:IconButton x:Name="TableButton" TouchSize="44"
                                 Data="M3,4 H17 V16 H3 Z M3,8 H17 M3,12 H17 M8,4 V16 M13,4 V16"
                                 Description="{controls:Translate 'Table'}" />
            <!-- A rule across the note, which asks what to write on it before it puts one in - see
                 NoteDetailViewModel.SeparatorChoices. A sheet again, for the reason the style button
                 gives; its command is set in the code-behind like the rest of this row. Drawn as the
                 rule itself, faint writing above and below it. -->
            <controls:IconButton x:Name="SeparatorButton" TouchSize="44"
                                 Data="M2,10 H18 M5,5.5 H15 M5,14.5 H15"
                                 Description="{controls:Translate 'Separator'}" />
        </HorizontalStackLayout>
        </ScrollView>

        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=notes:NoteDetailPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
