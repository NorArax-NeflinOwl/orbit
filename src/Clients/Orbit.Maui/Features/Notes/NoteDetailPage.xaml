<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Notes.NoteDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:notes="clr-namespace:Orbit.Maui.Features.Notes"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Notes;assembly=Orbit.Mobile"
    xmlns:tasks="clr-namespace:Orbit.Mobile.Screens.Tasks;assembly=Orbit.Mobile"
    x:DataType="screens:NoteDetailViewModel"
    x:Name="Page"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Padding="16,16,16,12" RowSpacing="10">

        <!-- The title is the note's own, so it is edited in place rather than shown twice. -->
        <Entry Grid.Row="0" Text="{Binding Title}" FontSize="20" FontAttributes="Bold" IsReadOnly="{Binding IsReadOnly}"
               Placeholder="{controls:Translate 'Untitled'}"
               ReturnType="Done" ReturnCommand="{Binding RenameCommand}" />

        <Label Grid.Row="1" Text="{Binding ReadOnlyReason}" IsVisible="{Binding IsReadOnly}"
               FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

        <controls:CopyOffer Grid.Row="2" IsOffered="{Binding IsCopyOffered}"
                            TakeCommand="{Binding CopyForEditingCommand}"
                            DeclineCommand="{Binding DeclineCopyCommand}" />

        <Label Grid.Row="3" Text="{Binding Status}" IsVisible="{Binding HasStatus}"
               FontSize="12" LineBreakMode="WordWrap"
               TextColor="{DynamicResource Accent}" />

        <VerticalStackLayout Grid.Row="4" Spacing="8" IsVisible="{Binding CanEdit}">
            <!-- How much this note matters. The phone's own dashboard filters by it and there was no
                 way to set one here - see PriorityChoice. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{controls:Translate 'Priority'}" VerticalOptions="Center" />
                <Picker Grid.Column="1" WidthRequest="160" ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding ChosenPriority}"
                        ItemDisplayBinding="{Binding Name, x:DataType=tasks:PriorityChoice}"
                        SemanticProperties.Description="{controls:Translate 'Priority'}" />
            </Grid>

            <!-- The same checkbox Orbit.Web's note editor has: what it turns on is real encryption, so
                 the row says what it costs rather than only what it is. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{controls:Translate 'Private'}" />
                    <Label Text="{controls:Translate 'Only you can read it, and it cannot be shared.'}"
                           FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding IsPrivate}"
                        SemanticProperties.Description="{controls:Translate 'Private'}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="{controls:Translate 'New line'}" Text="{Binding NewLine}"
                       ReturnType="Done" ReturnCommand="{Binding AddLineCommand}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddLineCommand}" />
            </Grid>
            <Button Text="{controls:Translate 'Checklist item'}" HorizontalOptions="Start"
                    FontSize="12" Padding="12,6" Style="{StaticResource SecondaryButton}"
                    Command="{Binding AddChecklistItemCommand}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="5" ItemsSource="{Binding Lines}">

            <CollectionView.EmptyView>
                <Label Text="{controls:Translate 'Nothing written here yet.'}" Padding="0,12"
                       Style="{StaticResource EmptyHint}" />
            </CollectionView.EmptyView>

            <!-- RelativeSource walks the visual tree, so the ancestor named here is the page, whose
                 BindingContext is the view model - see TaskListDetailPage for the same note. -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="screens:NoteLineRow">
                    <!-- The tick box leads the line, as it does in Orbit.Web's editor, and the line
                         itself is written in rather than read: it was a label here, so a line could be
                         written once and never corrected. Everything else a line can have done to it is
                         behind one "⋯", the way a chat message's options are. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Padding="0,4">
                        <Button Grid.Column="0" Text="{Binding CompletionMark}" WidthRequest="36" FontSize="17"
                                Padding="0" BackgroundColor="Transparent" BorderWidth="0" IsVisible="{Binding IsChecklistItem}"
                                TextColor="{DynamicResource Accent}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.ToggleCheckedCommand, x:DataType=notes:NoteDetailPage}"
                                CommandParameter="{Binding .}" />

                        <Entry Grid.Column="1" Text="{Binding Text}" VerticalOptions="Center"
                               BackgroundColor="Transparent" ReturnType="Done"
                               IsReadOnly="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.IsReadOnly, x:DataType=notes:NoteDetailPage}"
                               ReturnCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.SaveLinesCommand, x:DataType=notes:NoteDetailPage}" />

                        <controls:OverflowMenu Grid.Column="2"
                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.CanEdit, x:DataType=notes:NoteDetailPage}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowLineMenuCommand, x:DataType=notes:NoteDetailPage}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- The panel hides itself for a private note, as Orbit.Web's editor hides it: there is no
             readable copy on the server to hand anybody - see SharePanel.CanShare. -->
        <controls:SharePanel Grid.Row="6" BindingContext="{Binding Share}" Margin="0,4" />

    </Grid>

        <!-- No Save: a note is written down as it is written, line by line, so the bar carries what
             leaves the screen and what else can be done to the note - deleting it, and where its own
             copies are found again. -->
        <controls:EditorRail Grid.Row="2" CancelCommand="{Binding GoBackCommand}">
            <controls:EditorRail.Child>
                <controls:OverflowMenu Command="{Binding ShowNoteMenuCommand, Source={x:Reference Page}, x:DataType=notes:NoteDetailPage}" />
            </controls:EditorRail.Child>
        </controls:EditorRail>

        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=notes:NoteDetailPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
