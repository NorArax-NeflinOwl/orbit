<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Notes.NotesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:notes="clr-namespace:Orbit.Maui.Features.Notes"
    x:DataType="notes:NotesViewModel"
    Title="Notes">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding Greeting}" FontSize="14" TextColor="{StaticResource Gray500}" />
            <Label Text="{Binding SyncStatus}" FontSize="12" TextColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Placeholder="New note"
                   Text="{Binding NewNoteTitle}"
                   ReturnType="Done"
                   ReturnCommand="{Binding AddNoteCommand}" />
            <Button Grid.Column="1" Text="Add" Command="{Binding AddNoteCommand}" />
        </Grid>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Notes}">

                <CollectionView.EmptyView>
                    <Label Text="No notes yet." Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="notes:NoteListItem">
                        <VerticalStackLayout Padding="0,12" Spacing="2">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding UpdatedAtUtc, StringFormat='Updated {0:g}'}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                            <!-- Why a note is waiting, or why it cannot be edited right now. -->
                            <Label Text="{Binding Status}"
                                   IsVisible="{Binding HasStatus}"
                                   FontSize="12"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6">
            <Button Grid.Row="0" Grid.Column="0" Text="Tasks" Command="{Binding GoToTasksCommand}" />
            <Button Grid.Row="0" Grid.Column="1" Text="Calendar" Command="{Binding GoToCalendarCommand}" />
            <Button Grid.Row="0" Grid.Column="2" Text="Chat" Command="{Binding GoToChatCommand}" />
            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Account" Command="{Binding GoToAccountCommand}" />
            <Button Grid.Row="1" Grid.Column="2" Text="Sign out" Command="{Binding SignOutCommand}" />
        </Grid>

    </Grid>

</ContentPage>
