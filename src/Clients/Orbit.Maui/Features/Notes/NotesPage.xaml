<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Notes.NotesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:notes="clr-namespace:Orbit.Maui.Features.Notes"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Notes;assembly=Orbit.Mobile"
    x:DataType="screens:NotesViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Notes'}">

    <ContentPage.Resources>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Padding="16,16,16,28" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <!-- The plus is where Orbit.Web puts it, left of the name, and it does what the web's
                 does: it opens the form for a new one. The form is one field here rather than a screen
                 of its own, so it unfolds under the header instead of navigating - but the screen at
                 rest is what the web shows, its name and its cards, rather than a box asking to be
                 filled in before anything has been read. -->
            <controls:PageHeader Title="{controls:Translate 'Notes'}">
                <controls:PageHeader.LeadingAction>
                    <controls:IconButton Variant="Add" Data="M10,4 V16 M4,10 H16"
                                         Description="{controls:Translate 'Add note'}"
                                         Command="{Binding ToggleAddCommand, Source={x:Reference Page}, x:DataType=notes:NotesPage}" />
                </controls:PageHeader.LeadingAction>
            </controls:PageHeader>

            <!-- The one thing this screen has to say for itself, which today is only about pinning.
                 It was set and never shown, so pinning with no connection did nothing and said
                 nothing - see NotesViewModel.HasMessage. -->
            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                   LineBreakMode="WordWrap" Style="{StaticResource InfoLabel}" />

            <Grid x:Name="AddRow" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="AddField" Grid.Column="0"
                       Placeholder="{controls:Translate 'New note'}"
                       Text="{Binding NewNoteTitle}"
                       ReturnType="Done"
                       ReturnCommand="{Binding AddNoteCommand}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddNoteCommand}" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Notes}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'No notes.'}" Padding="0,12" Style="{StaticResource EmptyHint}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:NoteListItem">
                        <!-- The card every list of things is drawn with - see ItemCard for its anatomy,
                             and Orbit.Web's own for where the shape came from. The row used to draw its
                             own stack of labels with a hairline under it. -->
                        <controls:ItemCard Name="{Binding DisplayTitle}">
                            <controls:ItemCard.Pin>
                                <!-- Filled when it is set, outlined when it is not, so the card says
                                     which without a word - and absent on a note somebody else owns,
                                     whose order is theirs. -->
                                <controls:PinButton IsVisible="{Binding CanBePinned}"
                                                    IsPinned="{Binding IsPinned}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.TogglePinCommand, x:DataType=notes:NotesPage}"
                                                    CommandParameter="{Binding .}" />
                            </controls:ItemCard.Pin>

                            <controls:ItemCard.Tags>
                                <!-- Two cards with the same title are otherwise indistinguishable, and
                                     the reader has no way of telling which one they wrote in. -->
                                <Label Text="{controls:Translate 'copy'}" IsVisible="{Binding IsCopy}"
                                       Style="{StaticResource RowMeta}" />
                            </controls:ItemCard.Tags>

                            <controls:ItemCard.Body>
                                <!-- A hidden card keeps its place - a note vanishing from the list would
                                     look deleted - but says nothing about itself until unlocked. -->
                                <Button Text="{controls:Translate 'Unlock'}" IsVisible="{Binding IsHidden}"
                                        FontSize="12" Padding="12,2" HorizontalOptions="Start"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.UnlockPrivateCommand, x:DataType=notes:NotesPage}" />
                            </controls:ItemCard.Body>

                            <controls:ItemCard.Extras>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Updated}" IsVisible="{Binding CanBeOpened}"
                                           Style="{StaticResource ItemCardFooter}" />
                                    <!-- Why a note is waiting, or why it cannot be edited right now. -->
                                    <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                           LineBreakMode="WordWrap" Style="{StaticResource ItemCardFooter}"
                                           TextColor="{DynamicResource Accent}" />
                                </VerticalStackLayout>
                            </controls:ItemCard.Extras>
                        </controls:ItemCard>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>


    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
