<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Notes.NotesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Notes;assembly=Orbit.Mobile"
    x:DataType="screens:NotesViewModel"
    Title="Notes">

    <Grid RowDefinitions="Auto,*,Auto">
        <controls:NavigationBar Grid.Row="0" />


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding Greeting}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Placeholder="New note"
                   Text="{Binding NewNoteTitle}"
                   ReturnType="Done"
                   ReturnCommand="{Binding AddNoteCommand}" />
            <Button Grid.Column="1" Text="Add" Command="{Binding AddNoteCommand}" />
        </Grid>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Notes}">

                <CollectionView.EmptyView>
                    <Label Text="No notes yet." Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:NoteListItem">
                        <VerticalStackLayout Padding="0,12" Spacing="2">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding UpdatedAtUtc, StringFormat='Updated {0:g}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <!-- Why a note is waiting, or why it cannot be edited right now. -->
                            <Label Text="{Binding Status}"
                                   IsVisible="{Binding HasStatus}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>


    </Grid>
        <controls:StatusStrip Grid.Row="2" />
    </Grid>

</ContentPage>
