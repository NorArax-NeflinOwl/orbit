<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Inventory.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inventory="clr-namespace:Orbit.Maui.Features.Inventory"
    x:DataType="inventory:InventoryViewModel"
    Title="Inventory">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="10">

        <Label Grid.Row="0" Text="{Binding SyncStatus}" FontSize="12" TextColor="{StaticResource Gray500}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="New warehouse" Text="{Binding NewWarehouseName}"
                   ReturnType="Done" ReturnCommand="{Binding AddWarehouseCommand}" />
            <Button Grid.Column="1" Text="Add" Command="{Binding AddWarehouseCommand}" />
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Warehouses}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenWarehouseCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="No warehouses yet." Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="inventory:WarehouseRow">
                        <VerticalStackLayout Padding="0,12" Spacing="2">
                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Contents}" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                   FontSize="12" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <Button Grid.Row="3" Text="Back to notes" Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

    </Grid>

</ContentPage>
