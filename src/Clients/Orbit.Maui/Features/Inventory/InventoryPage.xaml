<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Inventory.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Inventory;assembly=Orbit.Mobile"
    x:DataType="screens:InventoryViewModel"
    Title="{controls:Translate 'Inventory'}">

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20" RowSpacing="10">


        <controls:PageHeader Grid.Row="0" Title="{controls:Translate 'Inventory'}">
            <controls:PageHeader.Subtitle>
                <controls:Translate Text="Keep separate stocks in separate warehouses, and share one with someone over chat." />
            </controls:PageHeader.Subtitle>
        </controls:PageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="{controls:Translate 'New warehouse'}" Text="{Binding NewWarehouseName}"
                   ReturnType="Done" ReturnCommand="{Binding AddWarehouseCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Command="{Binding AddWarehouseCommand}" />
        </Grid>

        <!-- "Which warehouse is the flour in?" - the one question this page could not answer, since it
             lists shelves and not what is on them. -->
        <Entry Grid.Row="2" Placeholder="{controls:Translate 'Find an item in any warehouse'}"
               Text="{Binding SearchedItemName}" ClearButtonVisibility="WhileEditing" ReturnType="Search" />

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                     IsVisible="{Binding IsShowingWarehouses}">
            <CollectionView ItemsSource="{Binding Warehouses}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenWarehouseCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'No warehouses yet.'}" Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:WarehouseRow">
                        <VerticalStackLayout Padding="0,12" Spacing="2">
                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Contents}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                   FontSize="12" TextColor="{DynamicResource Accent}" />
                            <BoxView HeightRequest="1" Margin="0,12,0,0"
                                     Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- The answer replaces the shelf list rather than sitting under it: a search is asked instead
             of reading the shelves, not as well as. -->
        <Grid Grid.Row="3" RowDefinitions="*,Auto" IsVisible="{Binding IsSearchingItems}">
            <CollectionView Grid.Row="0" ItemsSource="{Binding ItemMatches}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenMatchCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'Nothing on any shelf matches that.'}"
                           Padding="24" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:InventoryItemMatch">
                        <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount}" FontSize="15" VerticalOptions="Center" />
                            <!-- Where it is, which is what was asked. -->
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding WarehouseName}"
                                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="1" Margin="0,12,0,0" VerticalOptions="End"
                                     Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label Grid.Row="1" Text="{Binding ItemMatchSummary}" FontSize="12" LineBreakMode="WordWrap"
                   IsVisible="{Binding IsSearchingItems}" Style="{StaticResource SubtleLabel}" />
        </Grid>


    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
