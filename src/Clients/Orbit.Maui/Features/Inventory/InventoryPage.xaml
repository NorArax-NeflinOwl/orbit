<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Inventory.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:inventory="clr-namespace:Orbit.Maui.Features.Inventory"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Inventory;assembly=Orbit.Mobile"
    x:DataType="screens:InventoryViewModel"
    x:Name="Page"
    Title="{controls:Translate 'Inventory'}">

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,16,16,28" RowSpacing="10">


        <!-- The plus left of the name, as Orbit.Web's Inventory header has it. -->
        <controls:PageHeader Grid.Row="0" Title="{controls:Translate 'Inventory'}">
            <controls:PageHeader.LeadingAction>
                <controls:IconButton x:Name="AddButton" Variant="Add" Data="M10,4 V16 M4,10 H16"
                                     Description="{controls:Translate 'Add inventory'}" />
            </controls:PageHeader.LeadingAction>
        </controls:PageHeader>

        <Grid x:Name="AddRow" IsVisible="False" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="AddField" Grid.Column="0" Placeholder="{controls:Translate 'New inventory'}"
                   Text="{Binding NewInventoryName}"
                   ReturnType="Done" ReturnCommand="{Binding AddInventoryCommand}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddInventoryCommand}" />
        </Grid>

        <!-- "Which inventory is the flour in?" - the one question this page could not answer, since it
             lists shelves and not what is on them. -->
        <Entry Grid.Row="2" Placeholder="{controls:Translate 'Find an item in any inventory'}"
               Text="{Binding SearchedItemName}" ClearButtonVisibility="WhileEditing" ReturnType="Search" />

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                     IsVisible="{Binding IsShowingInventories}">
            <CollectionView ItemsSource="{Binding Inventories}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenInventoryCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'No inventories yet.'}" Padding="0,12" Style="{StaticResource EmptyHint}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:InventoryRow">
                        <!-- The same card every list of things is drawn with - see ItemCard. -->
                        <controls:ItemCard Name="{Binding DisplayName}">
                            <controls:ItemCard.Tags>
                                <!-- Two cards with the same name are otherwise indistinguishable, and
                                     the reader has no way of telling which one they wrote in. -->
                                <Label Text="{controls:Translate 'copy'}" IsVisible="{Binding IsCopy}"
                                       Style="{StaticResource RowMeta}" />
                            </controls:ItemCard.Tags>

                            <controls:ItemCard.Body>
                                <VerticalStackLayout Spacing="2">
                                    <!-- A hidden card keeps its place - an inventory vanishing would look
                                         like it had been deleted - but says nothing until unlocked. -->
                                    <Button Text="{controls:Translate 'Unlock'}" IsVisible="{Binding IsHidden}"
                                            FontSize="12" Padding="12,2" HorizontalOptions="Start"
                                            Style="{StaticResource LinkButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.UnlockPrivateCommand, x:DataType=inventory:InventoryPage}" />
                                    <Label Text="{Binding Contents}" IsVisible="{Binding CanBeOpened}"
                                           Style="{StaticResource ItemCardBody}" />
                                </VerticalStackLayout>
                            </controls:ItemCard.Body>

                            <controls:ItemCard.Extras>
                                <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                       LineBreakMode="WordWrap" Style="{StaticResource ItemCardFooter}"
                                       TextColor="{DynamicResource Accent}" />
                            </controls:ItemCard.Extras>
                        </controls:ItemCard>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- The answer replaces the shelf list rather than sitting under it: a search is asked instead
             of reading the shelves, not as well as. -->
        <Grid Grid.Row="3" RowDefinitions="*,Auto" IsVisible="{Binding IsSearchingItems}">
            <CollectionView Grid.Row="0" ItemsSource="{Binding ItemMatches}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding OpenMatchCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}">

                <CollectionView.EmptyView>
                    <Label Text="{controls:Translate 'Nothing on any shelf matches that.'}"
                           Padding="0,12" Style="{StaticResource EmptyHint}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="screens:InventoryItemMatch">
                        <controls:Row Title="{Binding Name}">
                            <controls:Row.Trailing>
                                <!-- How much, and then where it is - which is what was asked. -->
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Amount}" Style="{StaticResource RowMeta}" />
                                    <Label Text="{Binding InventoryName}" Style="{StaticResource RowMeta}" />
                                </HorizontalStackLayout>
                            </controls:Row.Trailing>
                        </controls:Row>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label Grid.Row="1" Text="{Binding ItemMatchSummary}" LineBreakMode="WordWrap"
                   IsVisible="{Binding IsSearchingItems}" Style="{StaticResource EmptyHint}" />
        </Grid>


    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
