<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Inventory.InventoryDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:inventoryScreens="clr-namespace:Orbit.Mobile.Screens.Inventory;assembly=Orbit.Mobile"
    xmlns:common="clr-namespace:Orbit.Mobile.Screens;assembly=Orbit.Mobile"
    xmlns:contracts="clr-namespace:Orbit.Contracts.Inventories;assembly=Orbit.Contracts"
    xmlns:inventory="clr-namespace:Orbit.Maui.Features.Inventory"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Inventory;assembly=Orbit.Mobile"
    x:DataType="screens:InventoryDetailViewModel"
    x:Name="Page"
    Title="{Binding Name}">

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Padding="20,14,20,0" RowSpacing="10">

        <controls:TitledDescription Grid.Row="0" x:Name="ShelfFields" IsVisible="False"
                                    Title="{Binding Name, Mode=TwoWay}" TitleLabel="{controls:Translate 'Name'}"
                                    TitlePlaceholder="{controls:Translate 'Untitled'}"
                                    SaveTitleCommand="{Binding RenameCommand}"
                                    Description="{Binding Description, Mode=TwoWay}"
                                    CommitDescriptionCommand="{Binding CommitDescriptionCommand}"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    ShowsDescription="{Binding IsNotPrivate}">
            <controls:TitledDescription.Suggestions>
                <controls:NameSuggestionChips BindingContext="{Binding InventoryNameSuggestions}" />
            </controls:TitledDescription.Suggestions>
        </controls:TitledDescription>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                   FontSize="12" TextColor="{DynamicResource Accent}" LineBreakMode="WordWrap" />
            <Label Text="{Binding ReadOnlyReason}" IsVisible="{Binding HasReadOnlyReason}"
                   FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

            <controls:CopyOffer IsOffered="{Binding IsCopyOffered}"
                                TakeCommand="{Binding CopyForEditingCommand}"
                                DeclineCommand="{Binding DeclineCopyCommand}" />
        </VerticalStackLayout>

        <!-- Unfolded by the plus over the foot of the shelf, like every other list screen's add form -
             see NewItemForm. The screen at rest is the shelf itself. -->
        <VerticalStackLayout x:Name="AddRow" Grid.Row="2" Spacing="8" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="AddField" Grid.Column="0" Placeholder="{controls:Translate 'New item'}"
                       Text="{Binding NewItemName}"
                       ReturnType="Done" ReturnCommand="{Binding AddItemCommand}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Command="{Binding AddItemCommand}" />
            </Grid>

            <!-- Under the box a new product is named in, which on a phone is where names are actually
                 typed - the editor below is mostly for changing one. -->
            <controls:NameSuggestionChips BindingContext="{Binding Suggestions}" />
        </VerticalStackLayout>

        <!-- What the shelf itself is, rather than what is on it - behind "Edit" in the menu under the
             screen's name, with the fields at the top of the page. -->
        <VerticalStackLayout x:Name="ShelfSettings" Grid.Row="2" Spacing="8" IsVisible="False">
            <!-- The same checkbox Orbit.Web's inventory editor has: what it turns on is real
                 encryption, so the row says what it costs rather than only what it is. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{controls:Translate 'Private'}" />
                    <Label Text="{controls:Translate 'Only you can read it, and it cannot be shared.'}"
                           FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding IsPrivate}" VerticalOptions="Center"
                        SemanticProperties.Description="{controls:Translate 'Private'}" />
            </Grid>

            <!-- Narrows what is on screen, never what is saved: the whole list still goes back on save,
                 so a filter that reached it would delete the rows it hid. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding CanNarrow}">
                <!-- Each picker appears only where something on the shelf is filed under it - one whose
                     only answer is "any" leads nowhere. Searching by name is always offered: a name is
                     typed, and every item has one. -->
                <Picker Title="{controls:Translate 'Product type'}" IsVisible="{Binding CanNarrowByProductType}"
                        ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding ChosenProductType}"
                        SemanticProperties.Description="{controls:Translate 'Private'}" />
                <Picker Title="{controls:Translate 'Category'}" IsVisible="{Binding CanNarrowByCategory}"
                        ItemsSource="{Binding Categories}" SelectedItem="{Binding ChosenCategory}"
                        SemanticProperties.Description="{controls:Translate 'Private'}" />
                <!-- The browser writes "Search" above this box; a phone has no room for the label, so
                     the name a screen reader hears carries it instead. -->
                <Entry Placeholder="{controls:Translate 'Item name'}" Text="{Binding SearchedName}"
                       SemanticProperties.Description="{controls:Translate 'Search items by name'}"
                       ClearButtonVisibility="WhileEditing" ReturnType="Search" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsNarrowed}">
                <Label Grid.Column="0" Text="{Binding FilterNote}" FontSize="11" VerticalOptions="Center"
                       LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Show everything'}" FontSize="12"
                        Style="{StaticResource LinkButton}" Command="{Binding ShowEverythingCommand}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView x:Name="Shelf" Grid.Row="3" ItemsSource="{Binding Items}" IsVisible="{Binding IsShowingList}">

            <CollectionView.EmptyView>
                <!-- Bound rather than fixed: an empty shelf and a shelf narrowed down to nothing need
                     different words. See InventoryDetailViewModel.EmptyMessage. -->
                <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.EmptyMessage, x:DataType=inventory:InventoryDetailPage}"
                       Padding="0,12" LineBreakMode="WordWrap" Style="{StaticResource EmptyHint}" />
            </CollectionView.EmptyView>

            <!-- RelativeSource walks the visual tree, so the ancestor has to be an element - the page,
                 whose ViewModel property is typed for compiled bindings. Naming the view model type
                 instead compiles and then silently binds to nothing. -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="screens:InventoryItemRow">
                    <!-- The row this shelf was opened for gets the accent bar and tint the browser's own
                         highlighted row has - see InventoryItemRow.IsPointedAt. -->
                    <Border StrokeThickness="0" Padding="0" BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPointedAt}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                            </DataTrigger>
                        </Border.Triggers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <BoxView WidthRequest="3" Color="{DynamicResource Accent}"
                                 IsVisible="{Binding IsPointedAt}" />
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                        <BoxView Grid.ColumnSpan="3" Style="{StaticResource Hairline}" VerticalOptions="Start"
                                 Margin="0,-8,0,0" />

                        <!-- How many, and the two ways to change it, as one bordered group at the head
                             of the row - which is where the design puts the count, because on a shelf
                             the number is the fact and the name is what it is a number of. The two
                             buttons used to be loose at the far end, 44 apart, with the count adrift
                             between them and the name. -->
                        <Border Grid.Column="0" StrokeThickness="1" Padding="0" VerticalOptions="Center"
                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                BackgroundColor="Transparent">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="40,Auto,40" HeightRequest="40">
                                <Button Grid.Column="0" Text="{controls:Translate '−'}" Padding="0"
                                        MinimumWidthRequest="0" MinimumHeightRequest="0" BorderWidth="0"
                                        FontFamily="OrbitBody" FontSize="17"
                                        TextColor="{DynamicResource Accent}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.RemoveOneCommand, x:DataType=inventory:InventoryDetailPage}"
                                        CommandParameter="{Binding .}" />

                                <!-- Below its own minimum, which is the whole reason to set one. -->
                                <Label Grid.Column="1" Text="{Binding Amount}" MinimumWidthRequest="30"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center" Padding="4,0"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsRunningLow}" Value="True">
                                            <Setter Property="FontAttributes" Value="Bold" />
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <BoxView WidthRequest="1" HorizontalOptions="Start" Grid.Column="1" Margin="-1,0,0,0"
                                         Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
                                <BoxView WidthRequest="1" HorizontalOptions="End" Grid.Column="1" Margin="0,0,-1,0"
                                         Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />

                                <Button Grid.Column="2" Text="{controls:Translate '+'}" Padding="0"
                                        MinimumWidthRequest="0" MinimumHeightRequest="0" BorderWidth="0"
                                        FontFamily="OrbitBody" FontSize="17"
                                        TextColor="{DynamicResource Accent}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.AddOneCommand, x:DataType=inventory:InventoryDetailPage}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>

                        <!-- Tapping the name opens what the shelf actually says about it: kind,
                             minimum, expiry - none of which the phone could show before. -->
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.EditItemCommand, x:DataType=inventory:InventoryDetailPage}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Name}" LineBreakMode="TailTruncation"
                                   SemanticProperties.Description="{Binding NameForAReader}" />
                            <Label Text="{Binding Detail}" FontSize="11" LineBreakMode="WordWrap"
                                   Style="{StaticResource SubtleLabel}" />
                            <Label Text="{Binding Expiry}" IsVisible="{Binding HasExpiry}" FontSize="11"
                                   Style="{StaticResource SubtleLabel}" />
                            <!-- A row is a batch: two of one name are two deliveries, and when each
                                 arrived is what tells them apart. See InventoryItemRow.Arrived. -->
                            <Label Text="{Binding Arrived}" IsVisible="{Binding HasArrived}" FontSize="11"
                                   Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>

                        <controls:OverflowMenu Grid.Column="2" VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowItemMenuCommand, x:DataType=inventory:InventoryDetailPage}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                    </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Shown in place of the list, one item at a time. See InventoryDetailViewModel.BeingEdited. -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsEditingItem}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Padding="0,8" Spacing="10" BindingContext="{Binding BeingEdited}"
                                 x:DataType="screens:InventoryItemEditor">
                <controls:ShelfProductFields />
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="4" Spacing="16" IsVisible="{Binding IsEditingItem}">
            <Button Text="{controls:Translate 'Save'}"
                    Command="{Binding SaveItemCommand}" />
            <Button Text="{controls:Translate 'Cancel'}" Style="{StaticResource LinkButton}"
                    Command="{Binding CancelItemEditCommand}" />
        </HorizontalStackLayout>

        <!-- The panel's own BindingContext would decide its IsVisible too, so the visibility lives on a
             wrapper that still reads the view model. -->
        <VerticalStackLayout x:Name="ShelfExtras" Grid.Row="4" IsVisible="False">
            <!-- What this shelf's restock list asks for, and when it comes round. At the bottom because
                 it is about the list the inventory keeps rather than about the shelf somebody came here
                 to edit - which is where Orbit.Web puts it too. -->
            <VerticalStackLayout BindingContext="{Binding RestockList}" Spacing="8" Margin="0,4"
                                 x:DataType="inventoryScreens:RestockListSettingsPanel"
                                 IsVisible="{Binding IsOffered}">
                <Label Text="{controls:Translate 'Restock list'}" Style="{StaticResource FieldLabel}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{controls:Translate 'Only what a dated task is waiting on'}"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding RuleDescription}" FontSize="12" LineBreakMode="WordWrap"
                               Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding OnlyLinkedWithDueDate}" VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Only what a dated task is waiting on'}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{controls:Translate 'Comes round at'}" VerticalOptions="Center" />
                        <Label Text="{controls:Translate 'When the standing &quot;Update stock levels&quot; reminder arrives.'}"
                               FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                    <TimePicker Grid.Column="1" Time="{Binding RefreshTime}" VerticalOptions="Center"
                                SemanticProperties.Description="{controls:Translate 'Comes round at'}" />
                </Grid>

                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12"
                       LineBreakMode="WordWrap" TextColor="{DynamicResource Accent}" />

                <!-- Greyed out rather than offered and refused, as everything needing a connection is. -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Start">
                    <Button Grid.Column="0" Text="{controls:Translate 'Save settings'}" FontSize="12" Padding="6,4"
                            Style="{StaticResource LinkButton}" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding Connection.IsMet}" />
                    <Button Grid.Column="1" Text="{controls:Translate 'Refresh'}" FontSize="12" Padding="6,4"
                            Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding Connection.IsMet}" />
                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- Opened from the shelf's own menu rather than standing at the foot of every one: sharing is
             something somebody does once. It hides itself for a private inventory, as Orbit.Web's
             editor hides it - there is no readable copy to hand anybody, see SharePanel.CanShare. -->
        <controls:SharePanel Grid.Row="4" x:Name="Sharing" IsVisible="False"
                             BindingContext="{Binding Share}" Margin="0,4" />

        <!-- What this shelf can have done to it hangs under its name in the bar now - see
             ShowShelfMenu, and the two buttons that used to stand here at the foot of a long page. -->

    </Grid>
        <controls:Fab x:Name="AddButton" Grid.Row="1" IsVisible="{Binding IsShowingList}"
                      Description="{controls:Translate 'New item'}" />
        <controls:NavigationBar Grid.Row="0" />
        <controls:MenuOverlay Grid.Row="0" Grid.RowSpan="3"
                              BindingContext="{Binding Menu, Source={x:Reference Page}, x:DataType=inventory:InventoryDetailPage}" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
        <controls:Drawer Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
