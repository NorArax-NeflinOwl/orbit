<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Inventory.WarehouseDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contracts="clr-namespace:Orbit.Contracts.Inventory;assembly=Orbit.Contracts"
    xmlns:inventory="clr-namespace:Orbit.Maui.Features.Inventory"
    x:DataType="inventory:WarehouseDetailViewModel"
    Title="{Binding Name}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20" RowSpacing="10">

        <Label Grid.Row="0" Text="{Binding Name}" FontSize="22" FontAttributes="Bold" />

        <Label Grid.Row="1" Text="{Binding Status}" IsVisible="{Binding HasStatus}"
               FontSize="12" TextColor="{StaticResource Primary}" LineBreakMode="WordWrap" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
            <Entry Grid.Column="0" Placeholder="New item" Text="{Binding NewItemName}"
                   ReturnType="Done" ReturnCommand="{Binding AddItemCommand}" />
            <Button Grid.Column="1" Text="Add" Command="{Binding AddItemCommand}" />
        </Grid>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}">

            <CollectionView.EmptyView>
                <Label Text="Nothing in this warehouse yet." Padding="24" HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <!-- RelativeSource walks the visual tree, so the ancestor has to be an element - the page,
                 whose ViewModel property is typed for compiled bindings. Naming the view model type
                 instead compiles and then silently binds to nothing. -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="contracts:WarehouseItemDto">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6" Padding="0,10">
                        <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Label Grid.Column="1" Text="{Binding Quantity}" VerticalOptions="Center"
                               TextColor="{StaticResource Gray500}" />
                        <Button Grid.Column="2" Text="−" WidthRequest="44" BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.RemoveOneCommand, x:DataType=inventory:WarehouseDetailPage}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="3" Text="+" WidthRequest="44" BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.AddOneCommand, x:DataType=inventory:WarehouseDetailPage}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="4" Text="✕" WidthRequest="44" BackgroundColor="Transparent"
                                TextColor="{StaticResource Gray500}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.RemoveItemCommand, x:DataType=inventory:WarehouseDetailPage}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button Grid.Row="4" Text="Back" Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

    </Grid>

</ContentPage>
