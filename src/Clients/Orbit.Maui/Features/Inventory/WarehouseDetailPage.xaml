<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Orbit.Maui.Features.Inventory.WarehouseDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:inventoryScreens="clr-namespace:Orbit.Mobile.Screens.Inventory;assembly=Orbit.Mobile"
    xmlns:common="clr-namespace:Orbit.Mobile.Screens;assembly=Orbit.Mobile"
    xmlns:contracts="clr-namespace:Orbit.Contracts.Inventory;assembly=Orbit.Contracts"
    xmlns:inventory="clr-namespace:Orbit.Maui.Features.Inventory"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Inventory;assembly=Orbit.Mobile"
    x:DataType="screens:WarehouseDetailViewModel"
    Title="{Binding Name}">

    <Grid RowDefinitions="Auto,*,Auto">


    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Padding="20" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Entry Text="{Binding Name}" FontSize="20" FontAttributes="Bold"
                   IsReadOnly="{Binding IsReadOnly}" Placeholder="{controls:Translate 'Untitled'}"
                   ReturnType="Done" ReturnCommand="{Binding RenameCommand}" />

            <!-- Warehouse names already in use, offered as this one is typed - its own strip, because
                 the box below is a different field and is on screen at the same time. -->
            <controls:NameSuggestionChips BindingContext="{Binding WarehouseNameSuggestions}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                   FontSize="12" TextColor="{DynamicResource Accent}" LineBreakMode="WordWrap" />
            <Label Text="{Binding ReadOnlyReason}" IsVisible="{Binding HasReadOnlyReason}"
                   FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />

            <controls:CopyOffer IsOffered="{Binding IsCopyOffered}"
                                TakeCommand="{Binding CopyForEditingCommand}"
                                DeclineCommand="{Binding DeclineCopyCommand}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding IsShowingList}">
            <!-- The same checkbox Orbit.Web's warehouse editor has: what it turns on is real
                 encryption, so the row says what it costs rather than only what it is. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{controls:Translate 'Private'}" />
                    <Label Text="{controls:Translate 'Only you can read it, and it cannot be shared.'}"
                           FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding IsPrivate}" VerticalOptions="Center"
                        SemanticProperties.Description="{controls:Translate 'Private'}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="{controls:Translate 'New item'}" Text="{Binding NewItemName}"
                       ReturnType="Done" ReturnCommand="{Binding AddItemCommand}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Add'}" Command="{Binding AddItemCommand}" />
            </Grid>

            <!-- Under the box a new product is named in, which on a phone is where names are actually
                 typed - the editor below is mostly for changing one. -->
            <controls:NameSuggestionChips BindingContext="{Binding Suggestions}" />

            <!-- Narrows what is on screen, never what is saved: the whole list still goes back on save,
                 so a filter that reached it would delete the rows it hid. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding CanNarrow}">
                <!-- Each picker appears only where something on the shelf is filed under it - one whose
                     only answer is "any" leads nowhere. Searching by name is always offered: a name is
                     typed, and every item has one. -->
                <Picker Title="{controls:Translate 'Product type'}" IsVisible="{Binding CanNarrowByProductType}"
                        ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding ChosenProductType}" />
                <Picker Title="{controls:Translate 'Category'}" IsVisible="{Binding CanNarrowByCategory}"
                        ItemsSource="{Binding Categories}" SelectedItem="{Binding ChosenCategory}" />
                <Entry Placeholder="{controls:Translate 'Item name'}" Text="{Binding SearchedName}"
                       ClearButtonVisibility="WhileEditing" ReturnType="Search" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsNarrowed}">
                <Label Grid.Column="0" Text="{Binding FilterNote}" FontSize="11" VerticalOptions="Center"
                       LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                <Button Grid.Column="1" Text="{controls:Translate 'Show everything'}" FontSize="12"
                        Style="{StaticResource LinkButton}" Command="{Binding ShowEverythingCommand}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" IsVisible="{Binding IsShowingList}">

            <CollectionView.EmptyView>
                <!-- Bound rather than fixed: an empty shelf and a shelf narrowed down to nothing need
                     different words. See WarehouseDetailViewModel.EmptyMessage. -->
                <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.EmptyMessage, x:DataType=inventory:WarehouseDetailPage}"
                       Padding="24" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            </CollectionView.EmptyView>

            <!-- RelativeSource walks the visual tree, so the ancestor has to be an element - the page,
                 whose ViewModel property is typed for compiled bindings. Naming the view model type
                 instead compiles and then silently binds to nothing. -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="screens:WarehouseItemRow">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6" Padding="0,10">
                        <!-- Tapping the name opens what the shelf actually says about it: kind,
                             minimum, expiry - none of which the phone could show before. -->
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.EditItemCommand, x:DataType=inventory:WarehouseDetailPage}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Name}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding Detail}" FontSize="11" LineBreakMode="WordWrap"
                                   Style="{StaticResource SubtleLabel}" />
                            <Label Text="{Binding Expiry}" IsVisible="{Binding HasExpiry}" FontSize="11"
                                   Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                        <!-- Below its own minimum, which is the whole reason to set one. -->
                        <Label Grid.Column="1" Text="{Binding Amount}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsRunningLow}" Value="True">
                                    <Setter Property="FontAttributes" Value="Bold" />
                                    <Setter Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Button Grid.Column="2" Text="{controls:Translate '−'}" WidthRequest="44" BackgroundColor="Transparent"
                                TextColor="{DynamicResource Accent}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.RemoveOneCommand, x:DataType=inventory:WarehouseDetailPage}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="3" Text="{controls:Translate '+'}" WidthRequest="44" BackgroundColor="Transparent"
                                TextColor="{DynamicResource Accent}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ViewModel.AddOneCommand, x:DataType=inventory:WarehouseDetailPage}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="4" Text="⋯" SemanticProperties.Description="{controls:Translate 'More'}" FontSize="18" WidthRequest="44" Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ShowItemMenuCommand, x:DataType=inventory:WarehouseDetailPage}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Shown in place of the list, one item at a time. See WarehouseDetailViewModel.BeingEdited. -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsEditingItem}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Padding="0,8" Spacing="10" BindingContext="{Binding BeingEdited}"
                                 x:DataType="screens:WarehouseItemEditor">
                <controls:ShelfProductFields />
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="4" Spacing="16" IsVisible="{Binding IsEditingItem}">
            <Button Text="{controls:Translate 'Save'}"
                    Command="{Binding SaveItemCommand}" />
            <Button Text="{controls:Translate 'Cancel'}" Style="{StaticResource LinkButton}"
                    Command="{Binding CancelItemEditCommand}" />
        </HorizontalStackLayout>

        <!-- The panel's own BindingContext would decide its IsVisible too, so the visibility lives on a
             wrapper that still reads the view model. -->
        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding IsShowingList}">
            <!-- What this shelf's restock list asks for, and when it comes round. At the bottom because
                 it is about the list the warehouse keeps rather than about the shelf somebody came here
                 to edit - which is where Orbit.Web puts it too. -->
            <VerticalStackLayout BindingContext="{Binding RestockList}" Spacing="8" Margin="0,4"
                                 x:DataType="inventoryScreens:RestockListSettingsPanel"
                                 IsVisible="{Binding IsOffered}">
                <Label Text="{controls:Translate 'Restock list'}" Style="{StaticResource FieldLabel}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{controls:Translate 'Only what a dated task is waiting on'}"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding RuleDescription}" FontSize="12" LineBreakMode="WordWrap"
                               Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding OnlyLinkedWithDueDate}" VerticalOptions="Center"
                            SemanticProperties.Description="{controls:Translate 'Only what a dated task is waiting on'}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{controls:Translate 'Comes round at'}" VerticalOptions="Center" />
                        <Label Text="{controls:Translate 'When the standing &quot;Update stock levels&quot; reminder arrives.'}"
                               FontSize="12" LineBreakMode="WordWrap" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                    <TimePicker Grid.Column="1" Time="{Binding RefreshTime}" VerticalOptions="Center"
                                SemanticProperties.Description="{controls:Translate 'Comes round at'}" />
                </Grid>

                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12"
                       LineBreakMode="WordWrap" TextColor="{DynamicResource Accent}" />

                <!-- Greyed out rather than offered and refused, as everything needing a connection is. -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Start">
                    <Button Grid.Column="0" Text="{controls:Translate 'Save settings'}" FontSize="12" Padding="6,4"
                            Style="{StaticResource LinkButton}" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding Connection.IsMet}" />
                    <Button Grid.Column="1" Text="{controls:Translate 'Refresh'}" FontSize="12" Padding="6,4"
                            Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding Connection.IsMet}" />
                </Grid>
            </VerticalStackLayout>

            <!-- The panel hides itself for a private warehouse, as Orbit.Web's editor hides it: there
                 is no readable copy on the server to hand anybody - see SharePanel.CanShare. -->
            <controls:SharePanel BindingContext="{Binding Share}" Margin="0,4" />
        </VerticalStackLayout>

        <!-- Back and away, laid out as the other three detail screens lay them out. -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsShowingList}">
            <Button Grid.Column="0" Text="{controls:Translate 'Back to inventory'}" Command="{Binding GoBackCommand}"
                    Style="{StaticResource LinkButton}" />
            <Button Grid.Column="1" Text="{controls:Translate 'Delete warehouse'}" Command="{Binding DeleteCommand}"
                    IsVisible="{Binding CanEdit}" Style="{StaticResource DestructiveButton}" />
            <!-- Where this thing's own copies are found again - see CopyHistoryViewModel. Only once
                 there is one, and here rather than in the account's menu: a history belongs to the
                 thing it is the history of. -->
            <Button Grid.Column="2" Text="{controls:Translate 'History'}" IsVisible="{Binding HasHistory}"
                    Command="{Binding GoToHistoryCommand}" Style="{StaticResource LinkButton}" />
        </Grid>

    </Grid>
        <controls:NavigationBar Grid.Row="0" />
        <controls:AvatarMenu Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</ContentPage>
