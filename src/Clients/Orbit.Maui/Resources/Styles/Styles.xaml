    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!-- Secondary text: captions, statuses, timestamps. -->
    <Style x:Key="SubtleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- One line of a diff on the copy-review screen. Grey by default - most lines did not change and
         should recede - with green for what was added and red for what went. The sign in the margin
         says the same thing (see DiffLine.Display), so the colour is a second telling, not the only one. -->
    <Style x:Key="DiffLineLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsAdded}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding IsRemoved}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Text that warns without being an error: destructive actions, irreversible consequences. -->
    <Style x:Key="WarningLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
    </Style>

    <!-- A button that reads as a link: no fill, accent text. Back buttons and the like. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- A link button has no fill to grey, so only its text can say it is unavailable.
                         Without this an action disabled for want of a connection looked exactly like one
                         that works, and the only clue was that tapping it did nothing. -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- The same, for something that destroys data. -->
    <Style x:Key="DestructiveButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- A link button has no fill to grey, so only its text can say it is unavailable.
                         Without this an action disabled for want of a connection looked exactly like one
                         that works, and the only clue was that tapping it did nothing. -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- The one content container: a hairline and nothing else. Unfilled, because a page whose sections
         are told apart by rules rather than by panels can hold more without looking crowded - which is
         the whole reason most of the lists in the app are not cards any more at all. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="16,14,16,10" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>

    <!-- The heading on a card (.card-title): the display face at the size app.css sets. The phone
         used to draw it at 17 "because a card is read at arm's length", which is exactly the kind of
         local improvement that makes one product look like two. -->
    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OrbitDisplay" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- .card-count: how many, in a quiet pill rather than beside the title as plain text. -->
    <Style x:Key="CardCount" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="3" />
        </Setter>
    </Style>

    <Style x:Key="CardCountLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
    </Style>

    <!-- .page-header h1 and .page-subtitle: what every screen opens with. -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OrbitDisplay" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- The one thing a screen is for - Save, Send, Sign in. Outlined in the accent and written in it,
         on nothing: the design applies colour as stroke, and a filled block of accent on a page whose
         structure is all hairlines is the one thing that would break it. What makes this button the
         important one is that its edge is the only coloured line on the screen. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
        <Setter Property="BorderColor" Value="{DynamicResource Accent}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- The second choice beside it. Identical to the plain button, and kept as a name so that a screen
         can say which of its buttons is the one it is not for. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- The one irreversible action a screen offers, outlined in the danger colour on the same terms.
         It used to be a filled red block, which was the loudest thing in the app by some distance -
         louder than Save, and on the account screen it sat under a heading nobody presses by accident. -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- The web's inputs are boxes: a hairline and the same lifted background a card has. MAUI's Entry
         draws none of its own, so a screen that wants one wraps it in this. -->
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>

    <!-- Orbit.Web's .filter-chip: a bordered pill, and the chosen one filled with the accent. The
         phone marked its chosen filter with text colour alone, which is a lot to ask of a reader
         glancing at five words in a row.

         A Border rather than a Button: MAUI's implicit Button style owns BackgroundColor through its
         VisualStateManager, and a VSM setter beats both a style setter and a trigger - so a Button
         here takes the trigger's text colour and refuses its fill, which is the worst of both. -->
    <Style x:Key="FilterChip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="3" />
        </Setter>
    </Style>

    <Style x:Key="FilterChipLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- .card-badge: a short fact about a card - what kind of thing it is, who shared it, how much it
         matters. Quieter and tighter than a filter chip, which is a control: this is a label. The phone
         drew these with FilterChip, so a card carrying three of them read as a row of things to press. -->
    <Style x:Key="CardBadge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="3" />
        </Setter>
    </Style>

    <Style x:Key="CardBadgeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- A month grid's day cell. Open, in this design: no surface, no edge, and the number sitting on
         the page like everything else. What a day is - today, chosen, not this month, something on it -
         is said by a tint, a ring, a quieter number or a dot, all of which read on an open grid and
         none of which needs a box. The old cell was a lifted surface with a hairline all round, which
         drew 42 boxes above every calendar. -->
    <Style x:Key="CalendarDayCell" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>

    <!-- .calendar-month-grid-weekday: the seven names above the grid. -->
    <Style x:Key="CalendarWeekday" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- .options-card: the frame a run of settings sits in, with hairlines between the rows rather
         than around each of them. Padding of its own is zero - a row carries its own. -->
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- .options-card-danger: the one section of a screen where a wrong press cannot be undone. -->
    <Style x:Key="DangerCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <!-- .options-tab: the four errands the account screen is divided into. The chosen one is underlined
         in the accent rather than only coloured - a colour alone is one signal, and the row of them
         scrolls sideways on a phone. -->
    <Style x:Key="SettingsTab" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontFamily" Value="OrbitDisplay" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- .map-panel-section: one group on the map screen, which is a card of its own rather than a
         heading with things loose underneath it. -->
    <Style x:Key="PanelSection" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>

    <!-- .map-panel-heading: what a panel section is about, in small caps with wide tracking. -->
    <Style x:Key="PanelHeading" TargetType="Label">
        <Setter Property="FontFamily" Value="OrbitDisplay" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1.1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
    </Style>

    <!-- A form field's own name, above it. Orbit.Web sets these in small caps with wide tracking, which
         is most of what makes its forms read as forms. -->
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1.1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
    </Style>

    <!-- The name of a box somebody types in, sitting above it. Quieter and plainer than FieldLabel,
         which is the small-caps heading over a *group* of things: a form asks "Email or login", in the
         words the reader would use, and shouting it in capitals over every box makes a form of six of
         them unreadable. Sign-in and registration are where the design uses it. -->
    <Style x:Key="FormFieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- One section on the navigation bar. 44pt is Apple's minimum tap target, and it is what lets six
         of them sit on a phone without becoming a row of things nobody can hit. -->
    <Style x:Key="NavigationBarIcon" TargetType="Grid">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- The drawing inside one. Every icon is authored on a 20x20 canvas, so one scale serves all. -->
    <Style x:Key="NavigationBarIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="21" />
        <Setter Property="HeightRequest" Value="21" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ========================================================================================
         The rest of Orbit.Web's shared vocabulary, ported by name. Every size, radius and padding
         below is the number app.css writes, so a screen a reader knows from the browser is the same
         screen here rather than a family resemblance. -->

    <!-- .icon-btn: a bare glyph with a press target around it, no fill and no edge. -->
    <Style x:Key="IconButtonFrame" TargetType="Border">
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>


    <!-- .page-add: the one control that makes another of whatever a list holds. Outlined in the accent,
         because as a bare glyph beside a 26pt heading it disappears. -->
    <Style x:Key="PageAddBorder" TargetType="Border">
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>


    <!-- The drawing inside an .icon-btn. Authored on the same 20x20 canvas the navigation bar's are. -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- The same drawing where the button it sits in is outlined in the accent: it takes the accent
         too, or the edge and the glyph inside it disagree about how much the button matters. -->
    <Style x:Key="IconPathAccent" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    </Style>



    <!-- .overflow-menu-dropdown: the panel a three-dot menu opens. -->
    <Style x:Key="MenuPanel" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
        <Setter Property="Padding" Value="0,6,0,8" />
        <Setter Property="MinimumWidthRequest" Value="220" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>

    <!-- .overflow-menu-heading: says what a menu of settings is about, above its entries. -->
    <Style x:Key="MenuHeading" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="Padding" Value="8,6,8,4" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
    </Style>

    <!-- .row-title and .row-meta: the two halves of a .list-row - a fact and its value. -->
    <Style x:Key="RowTitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="RowMeta" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
    </Style>

    <!-- .empty-hint: what a list says when there is nothing in it. -->
    <Style x:Key="EmptyHint" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Italic" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TertiaryTextLight}, Dark={StaticResource TertiaryTextDark}}" />
    </Style>

    <!-- .error and .info: something refused, and something that turned out to be already done. -->
    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <Style x:Key="InfoLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
    </Style>

    <!-- .options-heading and .options-subtext: one section of a long screen of settings. -->
    <Style x:Key="SectionHeading" TargetType="Label">
        <Setter Property="FontFamily" Value="OrbitDisplay" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SectionSubtext" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- The three sizes an ItemCard is written in: .item-card-name, .item-card-body and the footnote
         under the hairline. -->
    <Style x:Key="ItemCardName" TargetType="Label">
        <Setter Property="FontFamily" Value="OrbitDisplay" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="ItemCardBody" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <Style x:Key="ItemCardFooter" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <!-- The hairline app.css draws with a 1px border: under a .list-row, and above an item card's
         footnote. One colour, one thickness, wherever a line separates two things. -->
    <Style x:Key="Hairline" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
    </Style>

</ResourceDictionary>
