<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Orbit.Web's palette, converted from its oklch tokens (see wwwroot/css/app.css's :root) to the
         hex MAUI reads. Same colours in both clients, so a person who uses Orbit in a browser and on
         their phone is looking at one product rather than two.

         Roles, not shades: every one is a Light/Dark pair, because a screen asking for "subtle text"
         should get something legible either way rather than asking for a grey and being unreadable on
         one of the two backgrounds.

         Note: for Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- The four accent colours, and the only ones in this file the reader can change: App.ApplyAccent
         writes them from the hue they picked, and everything that paints with them asks for them by
         DynamicResource so the change reaches a screen already on display.

         One key each rather than a light one and a dark one, because they now vary in two directions -
         theme and hue - and AppThemeBinding only knows about the first. Applying the accent takes the
         theme into account instead, which is why these values are the light theme's: they are what
         shows for the moment between the resources loading and App applying the stored choice.

         The values below are Orbit's own purple, and they are also exactly what AccentPalette works out
         for hue 288 - which AccentColorTests pins down, so a change to either is caught here. -->
    <!-- accent. Named Primary as well, because that is what MAUI's own control styles look for. -->
    <Color x:Key="Accent">#7260CB</Color>
    <Color x:Key="Primary">#7260CB</Color>
    <!-- accent-hover: the same, one step further in, for something being pressed. -->
    <Color x:Key="AccentHover">#624BBC</Color>
    <!-- accent-subtle: a tint of the accent to sit behind it, not beside it. -->
    <Color x:Key="AccentSubtle">#E6E5FF</Color>
    <!-- accent-on: what is legible written on the accent. -->
    <Color x:Key="AccentOn">#FBFBFF</Color>

    <!-- bg: what the whole page sits on. Warm rather than pure white or pure black, which is most of
         why the web looks like itself. -->
    <Color x:Key="PageBackgroundLight">#FAF6F2</Color>
    <Color x:Key="PageBackgroundDark">#1B1410</Color>
    <!-- bg-elevated: a card or panel lifted off that background. -->
    <Color x:Key="SurfaceLight">#FFFDFB</Color>
    <Color x:Key="SurfaceDark">#251D19</Color>
    <!-- bg-subtle: a quiet fill inside a card - a count pill, a chosen row. -->
    <Color x:Key="SurfaceSubtleLight">#F2EEE7</Color>
    <Color x:Key="SurfaceSubtleDark">#312823</Color>
    <!-- border -->
    <Color x:Key="CardStrokeLight">#DFDAD2</Color>
    <Color x:Key="CardStrokeDark">#3C332E</Color>

    <!-- text-primary / text-secondary / text-tertiary. SubtleText is the secondary one: the line
         under a title, which is what the phone reaches for most. -->
    <Color x:Key="TextPrimaryLight">#251E19</Color>
    <Color x:Key="TextPrimaryDark">#F1EEEA</Color>
    <Color x:Key="SubtleTextLight">#60564F</Color>
    <Color x:Key="SubtleTextDark">#BCB6AF</Color>
    <Color x:Key="TertiaryTextLight">#8D847E</Color>
    <Color x:Key="TertiaryTextDark">#7F7973</Color>

    <!-- task: the colour tasks are marked in, distinct from the accent. -->
    <Color x:Key="TaskLight">#A34D00</Color>
    <Color x:Key="TaskDark">#E28D4F</Color>
    <!-- success -->
    <Color x:Key="SuccessLight">#348F4F</Color>
    <Color x:Key="SuccessDark">#69BA7C</Color>
    <!-- danger. The web has one red, and the phone's "warning" and "danger" are both it: a line
         saying something is wrong and a button that destroys something want the same colour. -->
    <Color x:Key="DangerLight">#C74B47</Color>
    <Color x:Key="DangerDark">#ED756E</Color>
    <Color x:Key="WarningLight">#C74B47</Color>
    <Color x:Key="WarningDark">#ED756E</Color>
    <!-- away -->
    <Color x:Key="AwayLight">#D9A514</Color>
    <Color x:Key="AwayDark">#E7B643</Color>

    <!-- The dot on the avatar. Green, amber and red all mean reachable; grey means the phone cannot
         reach Orbit at all, whatever its owner chose. Drawn from the same four web tokens. -->
    <Color x:Key="PresenceActiveLight">#348F4F</Color>
    <Color x:Key="PresenceActiveDark">#69BA7C</Color>
    <Color x:Key="PresenceIdleLight">#D9A514</Color>
    <Color x:Key="PresenceIdleDark">#E7B643</Color>
    <Color x:Key="PresenceUnavailableLight">#C74B47</Color>
    <Color x:Key="PresenceUnavailableDark">#ED756E</Color>
    <Color x:Key="PresenceOfflineLight">#8D847E</Color>
    <Color x:Key="PresenceOfflineDark">#7F7973</Color>

    <!-- Kept because MAUI's own control styles in Styles.xaml name them. Nothing Orbit draws should
         reach for a bare shade - the roles above are what a screen asks for. -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>
    <Color x:Key="PrimaryDarkText">#090811</Color>
    <Color x:Key="OffBlack">#1B1410</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Accent}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>
