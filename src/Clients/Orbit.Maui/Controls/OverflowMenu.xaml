<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.OverflowMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    x:Name="Root">

    <!-- The three dots a screen keeps its extra actions behind - the trigger only. What the menu holds
         is the screen's ScreenMenu, drawn by the one MenuOverlay the page carries. -->
    <controls:IconButton
        Data="M11.6,4 A1.6,1.6 0 1 1 8.4,4 A1.6,1.6 0 1 1 11.6,4 Z M11.6,10 A1.6,1.6 0 1 1 8.4,10 A1.6,1.6 0 1 1 11.6,10 Z M11.6,16 A1.6,1.6 0 1 1 8.4,16 A1.6,1.6 0 1 1 11.6,16 Z"
        Description="{controls:Translate 'More'}"
        Command="{Binding Command, Source={x:Reference Root}, x:DataType=controls:OverflowMenu}"
        CommandParameter="{Binding CommandParameter, Source={x:Reference Root}, x:DataType=controls:OverflowMenu}" />
</ContentView>
