<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.AvatarCircle"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <!-- How somebody is drawn where there is no picture to draw them with - Orbit.Web's .avatar and
         .avatar-sm: up to two initials on a circle whose colour is theirs and stays theirs, with a
         presence dot on its edge where the thing it stands for is somewhere at all.

         One control rather than a shape each list draws for itself, because the same person appears on
         the chat list, the contact list and the dashboard, and an avatar that is one colour on one
         screen and another elsewhere is not an avatar. What the initials and the hue are is settled
         further in still - see Orbit.Mobile's Avatar, which Orbit.Web's AvatarHelper agrees with. -->
    <Grid x:Name="AvatarFrame">
        <!-- Outlined in this person's hue with the initials written in it, rather than filled with it
             and the initials in white. Colour is stroke everywhere else in this design, and an avatar
             is the one place it was still a solid disc - a list of six conversations was six coloured
             blobs down its left edge. The hue is still theirs and still the one the web gives them. -->
        <Border x:Name="Circle" StrokeThickness="1" BackgroundColor="Transparent"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.StrokeShape>
                <shapes:RoundRectangle x:Name="Round" />
            </Border.StrokeShape>
            <Label x:Name="InitialsLabel" FontFamily="OrbitDisplay" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <!-- Top right, which is where app.css puts it on both sizes of circle, and the same 10 across
             at both - a dot that grew with the circle would sit over the initials on the small one.
             Ringed in the surface behind it so a dark dot on a dark avatar still reads as a separate
             thing: the 2 of stroke is the ring app.css draws with a box-shadow, and MAUI draws a
             border inwards, so 14 across leaves the 10 the browser fills. It hangs over the edge, as
             app.css hangs its own over by a pixel - inside the circle its ring clipped the second
             initial on the small size. -->
        <Border x:Name="PresenceDot" HeightRequest="14" WidthRequest="14" StrokeThickness="2" IsVisible="False"
                Stroke="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                Margin="0,-2,-2,0" HorizontalOptions="End" VerticalOptions="Start">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="7" />
            </Border.StrokeShape>
        </Border>

        <!-- How many messages are waiting from this person - Orbit.Web's UnreadBadge, on the bottom-left
             edge where app.css puts .notif-badge, so it never sits on the presence dot at the top right.
             The same danger ground with the accent's light letters, hanging over the edge by the same
             2. Nothing at all at nought: an empty badge is a mark, and a mark means something. -->
        <Border x:Name="UnreadBadge" IsVisible="False" HeightRequest="16" MinimumWidthRequest="16"
                Padding="3,0" StrokeThickness="0" Margin="-2,0,0,-2"
                HorizontalOptions="Start" VerticalOptions="End"
                BackgroundColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label x:Name="UnreadLabel" FontSize="10" FontAttributes="Bold"
                   TextColor="{StaticResource AccentOn}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>

</ContentView>
