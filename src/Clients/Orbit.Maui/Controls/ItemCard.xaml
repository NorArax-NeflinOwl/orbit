<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.ItemCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- One anatomy, used by every list that shows things - notes, task lists, events, inventories -
         and drawn two ways. The shape is fixed so that a reader who learns it once knows where to look
         on every screen: the name is always in the same place, the menu is always in the same corner,
         and what a card carries beyond that is what differs between them.

         Bordered, it is a card, which is what the dashboard's sections are. Unbordered, it is a row
         with a hairline above it and nothing else - which is what the lists are now, because a screenful
         of boxes inside boxes is what the redesign set out to be rid of. See IsBordered.

             [handle][pin][action][name ..........][trailing][collapse][menu]
             [tags .................................................]
             [body, or what is on it]
             [.........................extras.......................]

         Everything except the name is optional and is left out rather than drawn empty. The same
         anatomy Orbit.Web settled on - see its Components/ItemCard.razor. -->
    <Border x:Name="CardFrame" StrokeThickness="1" Padding="0" Margin="0,5"
            Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
            BackgroundColor="Transparent">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>

        <!-- The strip down the left is a colour this card is *about* - an event's own. Painted along
             the edge rather than shown as a dot beside the name: a dot is one more thing in a row
             already holding badges, and the point of the colour is to be findable without reading,
             which an edge does and a dot does not. Its own column rather than a border, because a
             Border paints all four sides or none. -->
        <Grid RowDefinitions="Auto,Auto">
        <!-- What separates one row from the next where the cards have been taken away - see IsBordered.
             Hidden on a card, which has an edge all the way round instead. -->
        <BoxView x:Name="TopRule" Grid.Row="0" Style="{StaticResource Hairline}" IsVisible="False" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
        <BoxView x:Name="AccentEdge" Grid.Column="0" WidthRequest="4" IsVisible="False" />

        <VerticalStackLayout x:Name="Inside" Grid.Column="1" Padding="14,12" Spacing="8">

            <!-- No column spacing: the two marks before the name are optional, and a column that is
                 empty must cost nothing at all - spacing kept for a pin nobody can see pushed every
                 name in the list to the right of it. They carry their own margins instead. -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <!-- Where the order can actually be changed, and nowhere else. -->
                    <ContentView x:Name="HandleHost" IsVisible="False" VerticalOptions="Center" />
                    <ContentView x:Name="PinHost" IsVisible="False" VerticalOptions="Center" />

                    <!-- Something happened here that the reader has not seen. Before the name because
                         that is where the eye already is reading down a list, and it is about this card
                         rather than about the page. -->
                    <Ellipse x:Name="ActionMark" WidthRequest="9" HeightRequest="9" IsVisible="False"
                             VerticalOptions="Center" Margin="0,0,2,0"
                             Fill="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                </HorizontalStackLayout>

                <Grid Grid.Column="1">
                    <Label x:Name="NameLabel" Style="{StaticResource ItemCardName}" MaxLines="2"
                           VerticalOptions="Center" LineBreakMode="TailTruncation" />

                    <!-- The name on its own opens what the card is a way into, where the card holds
                         entries with targets of their own and pressing the whole block would take the
                         press away from them - the dashboard's columns. See NameCommand. -->
                    <Button x:Name="NameButton" BackgroundColor="Transparent" BorderWidth="0" IsVisible="False"
                            MinimumHeightRequest="0" MinimumWidthRequest="0" />
                </Grid>

                <HorizontalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <!-- The one short fact that belongs beside the name rather than under it - a note's
                         priority, an entry's tag. The design puts it at the right-hand end of the name's
                         own line, which is where a reader scanning a column of names finds it without
                         reading any of them. Its own slot rather than Tags, which is the line below. -->
                    <ContentView x:Name="TrailingHost" IsVisible="False" VerticalOptions="Center"
                                 Margin="8,0,0,0" />
                    <!-- Folding a card to its heading, where there is something underneath to fold. -->
                    <ContentView x:Name="CollapseHost" IsVisible="False" VerticalOptions="Center" />
                    <ContentView x:Name="MenuHost" IsVisible="False" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Every slot starts hidden: what nobody fills is not drawn, and an empty one still
                 took its spacing - see Fill, which turns a slot back on with what goes in it. -->
            <ContentView x:Name="TagsHost" IsVisible="False" />
            <ContentView x:Name="BodyHost" IsVisible="False" />
            <VerticalStackLayout x:Name="Footer" IsVisible="False" Spacing="8">
                <!-- The line between what a card says and its footnote. A row does not draw it: it
                     already has a hairline above it, and a second one four lines down turns one row
                     into two. -->
                <BoxView x:Name="FooterRule" Style="{StaticResource Hairline}" />
                <ContentView x:Name="ExtrasHost" />
            </VerticalStackLayout>

            <!-- The whole card opens what it names, rather than only the words: on a card this size the
                 block is the target, and asking somebody to hit a word is the difference between one tap
                 and three. Over everything, so the pin and the menu keep their own presses - they are
                 declared after it in the visual tree and take the press first. -->
            <!-- MinimumHeightRequest of 0 against the implicit Button style's 44: this button is laid
                 over the whole card and must take its height from it, not give it one. On a row - which
                 has no padding to spare - the difference was a third of the height again. -->
            <Button x:Name="OpenButton" BackgroundColor="Transparent" BorderWidth="0" IsVisible="False"
                    MinimumHeightRequest="0" MinimumWidthRequest="0" />
        </VerticalStackLayout>
        </Grid>
        </Grid>
    </Border>

</ContentView>
