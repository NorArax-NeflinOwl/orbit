<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.ItemCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- One card, used by every list that shows things - notes, task lists, events, warehouses. The
         shape is fixed so that a reader who learns it once knows where to look on every screen: the name
         is always in the same place, the menu is always in the same corner, and what a card carries
         beyond that is what differs between them.

             [handle][pin][action][name ....................][collapse][menu]
             [tags .................................................]
             [body, or what is on it]
             [.........................extras.......................]

         Everything except the name is optional and is left out rather than drawn empty. The same
         anatomy Orbit.Web settled on - see its Components/ItemCard.razor. -->
    <Border StrokeThickness="1" Padding="14,12" Margin="0,4"
            Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="6">

            <!-- No column spacing: the two marks before the name are optional, and a column that is
                 empty must cost nothing at all - spacing kept for a pin nobody can see pushed every
                 name in the list to the right of it. They carry their own margins instead. -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <!-- Where the order can actually be changed, and nowhere else. -->
                    <ContentView x:Name="HandleHost" IsVisible="False" VerticalOptions="Center" />
                    <ContentView x:Name="PinHost" IsVisible="False" VerticalOptions="Center" />

                    <!-- Something happened here that the reader has not seen. Before the name because
                         that is where the eye already is reading down a list, and it is about this card
                         rather than about the page. -->
                    <Ellipse x:Name="ActionMark" WidthRequest="8" HeightRequest="8" IsVisible="False"
                             VerticalOptions="Center" Margin="0,0,2,0"
                             Fill="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                </HorizontalStackLayout>

                <Label x:Name="NameLabel" Grid.Column="1" FontSize="17" FontAttributes="Bold"
                       VerticalOptions="Center" LineBreakMode="TailTruncation" />

                <HorizontalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <!-- Folding a card to its heading, where there is something underneath to fold. -->
                    <ContentView x:Name="CollapseHost" IsVisible="False" VerticalOptions="Center" />
                    <ContentView x:Name="MenuHost" IsVisible="False" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Every slot starts hidden: what nobody fills is not drawn, and an empty one still
                 took its spacing - see Fill, which turns a slot back on with what goes in it. -->
            <ContentView x:Name="TagsHost" IsVisible="False" />
            <ContentView x:Name="BodyHost" IsVisible="False" />
            <ContentView x:Name="ExtrasHost" IsVisible="False" />

            <!-- The whole card opens what it names, rather than only the words: on a card this size the
                 block is the target, and asking somebody to hit a word is the difference between one tap
                 and three. Over everything, so the pin and the menu keep their own presses - they are
                 declared after it in the visual tree and take the press first. -->
            <Button x:Name="OpenButton" BackgroundColor="Transparent" IsVisible="False" />
        </VerticalStackLayout>
    </Border>

</ContentView>
