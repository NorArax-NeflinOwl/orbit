<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.PinButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- One pin for every list that can pin something, exactly as Orbit.Web has one PinButton shared by
         notes, task lists and dashboard cards - so the control means the same thing and looks the same
         wherever a person meets it. The filled pin is the pinned state; the outlined one is the offer to
         pin. The drawing is the web's, on the same 20x20 canvas.

         Head and tail are two figures of one Path rather than two Paths: Uniform scales each Path to its
         own bounds, which would size the tail as though it were the whole drawing and pull the two
         apart. Filling the pair costs nothing - the tail is a straight line and encloses no area. -->
    <Grid WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>

        <Path x:Name="Pin" Aspect="Uniform" WidthRequest="18" HeightRequest="18"
              HorizontalOptions="Center" VerticalOptions="Center"
              Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
              StrokeThickness="1.5" Fill="Transparent"
              Data="M12.3,2.4 L17.6,7.7 L15.5,8.3 A3,3 0 0 0 14,9.2 L11.6,11.9 L12.6,12.9 A1,1 0 0 1 11.2,14.3 L5.7,9.8 A1,1 0 0 1 7.1,8.4 L8.1,9.4 L10.8,7 A3,3 0 0 0 11.7,5.5 Z M7.4,12.6 L3.4,16.6" />
    </Grid>
</ContentView>
