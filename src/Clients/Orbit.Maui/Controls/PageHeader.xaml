<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    x:Name="Root">

    <!-- What every screen in Orbit.Web opens with (.page-header): its name, and one line saying what
         it holds. The phone had it on the dashboard only, so every other screen began mid-sentence. -->
    <VerticalStackLayout Spacing="2" Margin="0,0,0,6">
        <Label Text="{Binding Title, Source={x:Reference Root}, x:DataType=controls:PageHeader}"
               Style="{StaticResource PageTitle}" />
        <Label Text="{Binding Subtitle, Source={x:Reference Root}, x:DataType=controls:PageHeader}"
               Style="{StaticResource PageSubtitle}" LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentView>
