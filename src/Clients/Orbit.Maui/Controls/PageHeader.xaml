<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    x:Name="Root">

    <!-- What every screen in Orbit.Web opens with (.page-header): the one control that makes another
         of whatever the screen lists, and whatever belongs at the far end - a menu of how to read the
         page, usually.

             [+]                                                    [...]

         Each part is left out rather than drawn empty. The line saying what the screen holds is gone:
         a screen's sentence is behind the "?" beside its name in the bar (NavigationBar.Description). -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,16">

        <ContentView x:Name="LeadingHost" Grid.Column="0" IsVisible="False" HorizontalOptions="Start" />

        <ContentView x:Name="ActionsHost" Grid.Column="1" IsVisible="False" VerticalOptions="Center" />
    </Grid>
</ContentView>
