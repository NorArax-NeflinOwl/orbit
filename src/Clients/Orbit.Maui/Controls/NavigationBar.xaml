<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.NavigationBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Navigation;assembly=Orbit.Mobile"
    x:DataType="screens:NavigationBarViewModel">

    <ContentView.Resources>
        <controls:PresenceColorConverter x:Key="PresenceColor" />

        <!-- The same drawings Orbit.Web uses in its sidebar, as path data rather than SVG elements.
             Each is on a 20x20 canvas, so one size fits all of them. Rectangles and circles are written
             out as arcs because Path.Data takes path syntax only. -->
        <x:String x:Key="NotesIcon">M5,2.5 H12 L15,5.5 V17.5 A1,1 0 0 1 14,18.5 H5 A1,1 0 0 1 4,17.5 V3.5 A1,1 0 0 1 5,2.5 Z M12,2.5 V5.5 H15 M6.5,11 H13.5 M6.5,14 H13.5 M6.5,8 H9.5</x:String>
        <x:String x:Key="TasksIcon">M6,3 H14 A3,3 0 0 1 17,6 V14 A3,3 0 0 1 14,17 H6 A3,3 0 0 1 3,14 V6 A3,3 0 0 1 6,3 Z M6.5,10.2 L8.8,12.5 L13.5,7.8</x:String>
        <x:String x:Key="CalendarIcon">M5,4 H15 A2.5,2.5 0 0 1 17.5,6.5 V15 A2.5,2.5 0 0 1 15,17.5 H5 A2.5,2.5 0 0 1 2.5,15 V6.5 A2.5,2.5 0 0 1 5,4 Z M2.5,8 H17.5 M6.5,2 V5.5 M13.5,2 V5.5</x:String>
        <x:String x:Key="InventoryIcon">M3,6.2 L10,2.8 L17,6.2 V13.8 L10,17.2 L3,13.8 Z M3,6.2 L10,9.6 M10,9.6 L17,6.2 M10,9.6 V17.2</x:String>
        <x:String x:Key="MapIcon">M10,17.5 C10,17.5 15.5,12.5 15.5,8.5 A5.5,5.5 0 1 0 4.5,8.5 C4.5,12.5 10,17.5 10,17.5 Z M8,8.5 A2,2 0 1 1 12,8.5 A2,2 0 1 1 8,8.5 Z</x:String>
        <x:String x:Key="ContactsIcon">M4,6.5 A3,3 0 1 1 10,6.5 A3,3 0 1 1 4,6.5 Z M1.5,17 C1.5,14 4,12 7,12 C10,12 12.5,14 12.5,17 M12.7,7.5 A2.3,2.3 0 1 1 17.3,7.5 A2.3,2.3 0 1 1 12.7,7.5 Z M13.7,12.2 C16.1,12.5 17.8,14.2 17.8,16.8</x:String>
    </ContentView.Resources>

    <!-- The same shape Orbit.Web takes on a narrow window: logo, then the section icons without their
         labels, then the avatar pushed to the far right. See app.css's 680px breakpoint. -->
    <Grid RowDefinitions="Auto,Auto">

    <!-- A push that arrived while somebody was looking at the app. Under the bar rather than over it,
         so it pushes the page down for the few seconds it is up instead of covering what somebody is
         reading - see ForegroundNotices for why a banner and not a second tray notification. -->
    <Border Grid.Row="1" IsVisible="{Binding HasBanner}" Margin="8,0,8,6" Padding="12,8" StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="{Binding BannerTitle}" FontAttributes="Bold" FontSize="13"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding BannerBody}" FontSize="12" LineBreakMode="TailTruncation"
                       Style="{StaticResource SubtleLabel}" />
            </VerticalStackLayout>

            <!-- The banner is the button, as a notification row is: tapping it opens what it names. -->
            <Button Grid.Column="0" BackgroundColor="Transparent" Command="{Binding OpenBannerCommand}"
                    SemanticProperties.Description="{Binding BannerTitle}" />

            <Button Grid.Column="1" Text="✕" FontSize="13" Padding="8,0" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}"
                    Command="{Binding DismissBannerCommand}"
                    SemanticProperties.Description="{controls:Translate 'Dismiss'}" />
        </Grid>
    </Border>

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,10" ColumnSpacing="6"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

        <!-- The logo is the way back to the dashboard, exactly as it is on the web at this width. -->
        <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
            <controls:OrbitMark MarkSize="26" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <Button Command="{Binding GoToDashboardCommand}" BackgroundColor="Transparent"
                    SemanticProperties.Description="{controls:Translate 'Dashboard'}" />
        </Grid>

        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    VerticalOptions="Center">
            <HorizontalStackLayout Spacing="2">
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Path Data="{StaticResource NotesIcon}" Style="{StaticResource NavigationBarIconPath}" InputTransparent="True" />
                    <Button Command="{Binding GoToNotesCommand}" BackgroundColor="Transparent"
                            SemanticProperties.Description="{controls:Translate 'Notes'}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Path Data="{StaticResource TasksIcon}" Style="{StaticResource NavigationBarIconPath}" InputTransparent="True" />
                    <Button Command="{Binding GoToTasksCommand}" BackgroundColor="Transparent"
                            SemanticProperties.Description="{controls:Translate 'Tasks'}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Path Data="{StaticResource CalendarIcon}" Style="{StaticResource NavigationBarIconPath}" InputTransparent="True" />
                    <Button Command="{Binding GoToCalendarCommand}" BackgroundColor="Transparent"
                            SemanticProperties.Description="{controls:Translate 'Calendar'}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Path Data="{StaticResource InventoryIcon}" Style="{StaticResource NavigationBarIconPath}" InputTransparent="True" />
                    <Button Command="{Binding GoToInventoryCommand}" BackgroundColor="Transparent"
                            SemanticProperties.Description="{controls:Translate 'Inventory'}" />
                </Grid>
                <!-- Hidden rather than shown-and-refused, as the web's sidebar does it: a link that
                     only ever leads to "not unlocked" is not a link. -->
                <Grid Style="{StaticResource NavigationBarIcon}" IsVisible="{Binding CanUseLocation}">
                    <Path Data="{StaticResource MapIcon}" Style="{StaticResource NavigationBarIconPath}" InputTransparent="True" />
                    <Button Command="{Binding GoToMapCommand}" BackgroundColor="Transparent"
                            SemanticProperties.Description="{controls:Translate 'Map'}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}" IsVisible="{Binding CanUseConversations}">
                    <Path Data="{StaticResource ContactsIcon}" Style="{StaticResource NavigationBarIconPath}" InputTransparent="True" />
                    <Button Command="{Binding GoToContactsCommand}" BackgroundColor="Transparent"
                            SemanticProperties.Description="{controls:Translate 'Contacts'}" />
                </Grid>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Initials rather than a picture: Orbit has no avatars to show, and the web does the same. -->
        <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">

            <Border StrokeThickness="0" BackgroundColor="{DynamicResource Accent}"
                    HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>
                <Label Text="{Binding Initials}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Border IsVisible="{Binding HasUnread}" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                    HeightRequest="18" MinimumWidthRequest="18" Padding="4,0"
                    HorizontalOptions="Start" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <Label Text="{Binding UnreadLabel}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" FontSize="10" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Border HeightRequest="13" WidthRequest="13" StrokeThickness="2"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    BackgroundColor="{Binding Appearance, Converter={StaticResource PresenceColor}}"
                    HorizontalOptions="End" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7" />
                </Border.StrokeShape>
            </Border>

            <!-- Over the initials, the badge and the presence dot rather than around them: a Grid with a
                 gesture on it is focusable to a screen reader but not clickable, so the double tap that
                 activates a control does nothing to it. A Button is both. -->
            <Button Command="{Binding ToggleMenuCommand}" BackgroundColor="Transparent"
                    SemanticProperties.Description="{controls:Translate 'Account menu'}" />
        </Grid>
    </Grid>
    </Grid>
</ContentView>
