<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.NavigationBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Navigation;assembly=Orbit.Mobile"
    x:DataType="screens:NavigationBarViewModel">

    <ContentView.Resources>
        <controls:PresenceColorConverter x:Key="PresenceColor" />
    </ContentView.Resources>

    <!-- Three things wide, and no more: the way sideways, where you are, who you are.
             [≡]            ‹ Notes ▾ ›                               [AK]
         The six section icons that used to sit between them are in the drawer now, where their names
         fit beside them - eight targets in a 412px row is a row nobody can hit, and it left the screen
         with no name on it at all. -->
    <Grid RowDefinitions="Auto,Auto">

    <!-- A push that arrived while somebody was looking at the app. Under the bar rather than over it,
         so it pushes the page down for the few seconds it is up instead of covering what somebody is
         reading - see ForegroundNotices for why a banner and not a second tray notification. -->
    <Border Grid.Row="1" IsVisible="{Binding HasBanner}" Margin="8,0,8,6" Padding="12,8" StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="{Binding BannerTitle}" FontFamily="OrbitDisplay" FontAttributes="Bold" FontSize="15"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding BannerBody}" FontSize="12" LineBreakMode="TailTruncation"
                       Style="{StaticResource SubtleLabel}" />
            </VerticalStackLayout>
            <!-- The banner is the button, as a notification row is: tapping it opens what it names. -->
            <Button Grid.Column="0" BackgroundColor="Transparent" BorderWidth="0" Command="{Binding OpenBannerCommand}"
                    SemanticProperties.Description="{Binding BannerTitle}" />
            <Button Grid.Column="1" Text="✕" FontSize="13" Padding="8,0" BackgroundColor="Transparent" BorderWidth="0"
                    TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}"
                    Command="{Binding DismissBannerCommand}"
                    SemanticProperties.Description="{controls:Translate 'Dismiss'}" />
        </Grid>
    </Border>

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="6" ColumnSpacing="4">
        <!-- A hairline under the bar, and no fill: the bar is on the page rather than above it. -->
        <BoxView Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Hairline}"
                 VerticalOptions="End" Margin="-6,0,-6,-6" />

        <!-- The drawer's three lines, on every screen without exception. There used to be a back arrow
             here instead on anything that was not a section, and there is none any more: going back is
             the navigation stack's job and the phone's own gesture pops it - see ScreenHistory. A
             second way to do the same thing, in the corner the only way sideways lives in, was one
             control too many. -->
        <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
            <Path Data="M4,6 H20 M4,12 H20 M4,18 H20" Style="{StaticResource NavigationBarIconPath}"
                  InputTransparent="True" />
            <Button Command="{Binding ToggleDrawerCommand}"
                    BackgroundColor="Transparent" BorderWidth="0"
                    SemanticProperties.Description="{controls:Translate 'Menu'}" />
        </Grid>

        <!-- [previous] [the screen's name and its menu] [next]. The name is bound in the code-behind to
             the page's Title, so a screen named after what it is showing - a conversation, a chosen day
             - says that rather than a fixed word; the two arrows are the page's own, and are there only
             where the screen is one of a series. See ITitleSteps and ITitleMenu. -->
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="2"
              HorizontalOptions="Center" VerticalOptions="Center">
            <Grid x:Name="PreviousStep" Grid.Column="0" WidthRequest="32" HeightRequest="40"
                  IsVisible="False" VerticalOptions="Center">
                <Path Data="M15,18 L9,12 L15,6" Style="{StaticResource NavigationBarIconPath}"
                      WidthRequest="16" HeightRequest="16" InputTransparent="True" />
                <Button x:Name="PreviousPress" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        MinimumHeightRequest="0" MinimumWidthRequest="0" />
            </Grid>

            <Grid Grid.Column="1">
                <HorizontalStackLayout Spacing="6" InputTransparent="True" VerticalOptions="Center">
                    <!-- Capped, or a long name pushes the bar apart instead of being cut: this cluster
                         is sized to its contents so that it can sit centred, and an Auto column grows
                         to whatever is in it. A screen called "Restock supplies - Workshop" shoved the
                         menu button against the edge and clipped the avatar off the other side.

                         200 is what is left of a 411-wide bar once the menu, the avatar, their padding,
                         both optional arrows and this label's own chevron have taken theirs - the worst
                         case, so a screen that shows the arrows truncates at the same width as one that
                         does not, rather than at a width that depends on what else is in the bar. -->
                    <Label x:Name="TitleLabel" FontFamily="OrbitDisplay" FontSize="22" FontAttributes="Bold"
                           LineBreakMode="TailTruncation" MaximumWidthRequest="200"
                           VerticalOptions="Center" />
                    <Path x:Name="TitleChevron" Data="M6,9 L12,15 L18,9" IsVisible="False"
                          Style="{StaticResource IconPathAccent}" WidthRequest="14" HeightRequest="14"
                          VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button x:Name="TitlePress" IsVisible="False" BackgroundColor="Transparent" BorderWidth="0"
                        MinimumHeightRequest="44" />
            </Grid>

            <Grid x:Name="NextStep" Grid.Column="2" WidthRequest="32" HeightRequest="40"
                  IsVisible="False" VerticalOptions="Center">
                <Path Data="M9,6 L15,12 L9,18" Style="{StaticResource NavigationBarIconPath}"
                      WidthRequest="16" HeightRequest="16" InputTransparent="True" />
                <Button x:Name="NextPress" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        MinimumHeightRequest="0" MinimumWidthRequest="0" />
            </Grid>
        </Grid>

        <!-- Initials rather than a picture: Orbit has no avatars to show. Outlined in the accent, like
             everything else the design colours. -->
        <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
            <Border StrokeThickness="1" Stroke="{DynamicResource Accent}" BackgroundColor="Transparent"
                    HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label Text="{Binding Initials}" TextColor="{DynamicResource Accent}" FontFamily="OrbitDisplay"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border HeightRequest="13" WidthRequest="13" StrokeThickness="2"
                    Stroke="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                    BackgroundColor="{Binding Appearance, Converter={StaticResource PresenceColor}}"
                    HorizontalOptions="End" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7" />
                </Border.StrokeShape>
            </Border>
            <!-- Over the initials and the presence dot rather than around them: a Grid with a gesture on
                 it is focusable to a screen reader but not clickable, so the double tap that activates a
                 control does nothing to it. A Button is both. -->
            <Button Command="{Binding ToggleMenuCommand}" BackgroundColor="Transparent" BorderWidth="0"
                    SemanticProperties.Description="{controls:Translate 'Account menu'}" />
        </Grid>
    </Grid>
    </Grid>
</ContentView>
