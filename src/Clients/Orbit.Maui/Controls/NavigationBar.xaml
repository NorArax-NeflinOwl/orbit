<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Orbit.Maui.Controls.NavigationBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Orbit.Maui.Controls"
    xmlns:screens="clr-namespace:Orbit.Mobile.Screens.Navigation;assembly=Orbit.Mobile"
    x:DataType="screens:NavigationBarViewModel">

    <ContentView.Resources>
        <controls:PresenceColorConverter x:Key="PresenceColor" />

        <!-- The same drawings Orbit.Web uses in its sidebar, as path data rather than SVG elements.
             Each is on a 20x20 canvas, so one size fits all of them. Rectangles and circles are written
             out as arcs because Path.Data takes path syntax only. -->
        <x:String x:Key="NotesIcon">M5,2.5 H12 L15,5.5 V17.5 A1,1 0 0 1 14,18.5 H5 A1,1 0 0 1 4,17.5 V3.5 A1,1 0 0 1 5,2.5 Z M12,2.5 V5.5 H15 M6.5,11 H13.5 M6.5,14 H13.5 M6.5,8 H9.5</x:String>
        <x:String x:Key="TasksIcon">M6,3 H14 A3,3 0 0 1 17,6 V14 A3,3 0 0 1 14,17 H6 A3,3 0 0 1 3,14 V6 A3,3 0 0 1 6,3 Z M6.5,10.2 L8.8,12.5 L13.5,7.8</x:String>
        <x:String x:Key="CalendarIcon">M5,4 H15 A2.5,2.5 0 0 1 17.5,6.5 V15 A2.5,2.5 0 0 1 15,17.5 H5 A2.5,2.5 0 0 1 2.5,15 V6.5 A2.5,2.5 0 0 1 5,4 Z M2.5,8 H17.5 M6.5,2 V5.5 M13.5,2 V5.5</x:String>
        <x:String x:Key="InventoryIcon">M3,6.2 L10,2.8 L17,6.2 V13.8 L10,17.2 L3,13.8 Z M3,6.2 L10,9.6 M10,9.6 L17,6.2 M10,9.6 V17.2</x:String>
        <x:String x:Key="MapIcon">M10,17.5 C10,17.5 15.5,12.5 15.5,8.5 A5.5,5.5 0 1 0 4.5,8.5 C4.5,12.5 10,17.5 10,17.5 Z M8,8.5 A2,2 0 1 1 12,8.5 A2,2 0 1 1 8,8.5 Z</x:String>
        <x:String x:Key="ContactsIcon">M4,6.5 A3,3 0 1 1 10,6.5 A3,3 0 1 1 4,6.5 Z M1.5,17 C1.5,14 4,12 7,12 C10,12 12.5,14 12.5,17 M12.7,7.5 A2.3,2.3 0 1 1 17.3,7.5 A2.3,2.3 0 1 1 12.7,7.5 Z M13.7,12.2 C16.1,12.5 17.8,14.2 17.8,16.8</x:String>
    </ContentView.Resources>

    <!-- Covers the whole page so the menu can hang over it, but transparent to input except where its
         children actually are - otherwise a closed menu would swallow every tap on the page beneath. -->
    <Grid RowDefinitions="Auto,*" InputTransparent="True" CascadeInputTransparent="False">

    <!-- The same shape Orbit.Web takes on a narrow window: logo, then the section icons without their
         labels, then the avatar pushed to the far right. See app.css's 680px breakpoint. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,10" ColumnSpacing="6"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

        <!-- The logo is the way back to the dashboard, exactly as it is on the web at this width. -->
        <Grid Grid.Column="0" WidthRequest="34" HeightRequest="34" VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToDashboardCommand}" />
            </Grid.GestureRecognizers>
            <Ellipse WidthRequest="22" HeightRequest="11" Rotation="-28"
                     Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                     StrokeThickness="1.6" Fill="Transparent"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            <Ellipse WidthRequest="6" HeightRequest="6"
                     Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    VerticalOptions="Center">
            <HorizontalStackLayout Spacing="2">
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotesCommand}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource NotesIcon}" Style="{StaticResource NavigationBarIconPath}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToTasksCommand}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource TasksIcon}" Style="{StaticResource NavigationBarIconPath}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCalendarCommand}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource CalendarIcon}" Style="{StaticResource NavigationBarIconPath}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToInventoryCommand}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource InventoryIcon}" Style="{StaticResource NavigationBarIconPath}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToMapCommand}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource MapIcon}" Style="{StaticResource NavigationBarIconPath}" />
                </Grid>
                <Grid Style="{StaticResource NavigationBarIcon}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToContactsCommand}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource ContactsIcon}" Style="{StaticResource NavigationBarIconPath}" />
                </Grid>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Initials rather than a picture: Orbit has no avatars to show, and the web does the same. -->
        <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>

            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>
                <Label Text="{Binding Initials}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Border IsVisible="{Binding HasUnread}" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                    HeightRequest="18" MinimumWidthRequest="18" Padding="4,0"
                    HorizontalOptions="Start" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <Label Text="{Binding UnreadLabel}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" FontSize="10" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Border HeightRequest="13" WidthRequest="13" StrokeThickness="2"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    BackgroundColor="{Binding Appearance, Converter={StaticResource PresenceColor}}"
                    HorizontalOptions="End" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7" />
                </Border.StrokeShape>
            </Border>
        </Grid>
    </Grid>

        <!-- The avatar's menu, as Orbit.Web's dropdown: who you are, then the things that hang off the
             account. Anchored under the avatar rather than centred, so it reads as belonging to it. -->
        <Grid Grid.Row="1" IsVisible="{Binding IsMenuOpen}">

            <!-- Tapping anywhere else closes it, which is what a dropdown does everywhere. -->
            <BoxView Color="Black" Opacity="0.35">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseMenuCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Style="{StaticResource CardBorder}" Margin="0,4,12,0" Padding="0"
                    WidthRequest="250" HorizontalOptions="End" VerticalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Padding="14" Spacing="10">
                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />

                    <!-- Folded by default, and readable folded: the row says what is currently set, and
                         opens the two choices only when somebody wants to change it. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleStatusCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="Status" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ChosenDescription}" FontSize="12"
                               VerticalOptions="Center" Style="{StaticResource SubtleLabel}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding IsStatusExpanded}">
                        <Button Grid.Column="0" Text="Available" FontSize="12" Padding="6,4"
                                Command="{Binding ChooseAvailableCommand}" IsEnabled="{Binding IsUnavailable}" />
                        <Button Grid.Column="1" Text="Unavailable" FontSize="12" Padding="6,4"
                                Command="{Binding ChooseUnavailableCommand}" IsEnabled="{Binding IsAvailable}" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="Notifications" VerticalOptions="Center" />
                        <Border Grid.Column="1" IsVisible="{Binding HasUnread}" StrokeThickness="0"
                                HeightRequest="18" MinimumWidthRequest="18" Padding="5,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>
                            <Label Text="{Binding UnreadLabel}" FontSize="10" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label Text="Account">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAccountCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Sign out"
                           TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SignOutCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
