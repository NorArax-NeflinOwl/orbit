<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orbit.Web</RootNamespace>
    <!-- Served from a plain nginx container with no Brotli content negotiation set up; publishing
         uncompressed keeps the static files directly servable without extra nginx configuration. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <!-- The client half of the live connection (see LiveUpdatesConnection). Not part of the framework
         reference the way the server half is, so it is a package here and not in Orbit.Api. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence the footer links to, served beside the app so it can be read on this site rather
         than on GitHub - see Pages/License.razor. Copied in from the repository's own LICENSE by the
         target below rather than kept as a second copy, so the page cannot fall behind the file.

         Removed from the default wwwroot glob and declared again, so there is exactly one item whether
         or not the copy already existed when this project was evaluated - which it does not on the
         first build after a fresh checkout. -->
    <Content Remove="wwwroot\LICENSE.txt" />
    <Content Include="wwwroot\LICENSE.txt" />
  </ItemGroup>

  <!-- Before AssignTargetPaths, which is where the static web assets are worked out: an asset whose
       file is not under wwwroot when that runs is served as an empty response by `dotnet run`'s dev
       server, which is a licence page saying nothing. -->
  <Target Name="CopyTheLicenceIntoWwwroot" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\LICENSE"
          DestinationFiles="$(MSBuildThisFileDirectory)wwwroot\LICENSE.txt"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Orbit.Contracts\Orbit.Contracts.csproj" />
    <!-- Only for ClientActionCategory (see Services/Logging/ClientActionLoggerExtensions.cs) - reuses
         the same enum LoggingDispatcher tags server-side "[ACTION:{Category}]" log lines with, so
         client and server logs read the same way when scanned together. Orbit.Core itself only depends
         on the logging/DI abstraction packages, both already used by this WASM app, so this stays
         build-compatible with Blazor WebAssembly. -->
    <ProjectReference Include="..\..\Shared\Orbit.Core\Orbit.Core.csproj" />
    <ProjectReference Include="..\..\Shared\Orbit.Localization\Orbit.Localization.csproj" />
  </ItemGroup>

</Project>
