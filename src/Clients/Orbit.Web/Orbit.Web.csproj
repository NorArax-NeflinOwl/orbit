<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orbit.Web</RootNamespace>
    <!-- Served from a plain nginx container with no Brotli content negotiation set up; publishing
         uncompressed keeps the static files directly servable without extra nginx configuration. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the translation dictionary can be checked as a whole rather than one string at a time: a
         duplicate key throws at type-init and takes the app down the moment somebody switches to
         Polish, and a placeholder that does not match its English throws when the line is formatted.
         Neither is reachable through the public indexer, which can only be asked about keys a test
         already knows. See PolishTranslationsTests. -->
    <InternalsVisibleTo Include="Orbit.Web.Tests" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Orbit.Contracts\Orbit.Contracts.csproj" />
    <!-- Only for ClientActionCategory (see Services/Logging/ClientActionLoggerExtensions.cs) - reuses
         the same enum LoggingDispatcher tags server-side "[ACTION:{Category}]" log lines with, so
         client and server logs read the same way when scanned together. Orbit.Core itself only depends
         on the logging/DI abstraction packages, both already used by this WASM app, so this stays
         build-compatible with Blazor WebAssembly. -->
    <ProjectReference Include="..\..\Shared\Orbit.Core\Orbit.Core.csproj" />
  </ItemGroup>

</Project>
