@inherits LayoutComponentBase
@implements IDisposable
@using System.Globalization
@using Orbit.Contracts.Notifications
@using Orbit.Core.Abstractions
@using Orbit.Core.Users
@using Orbit.Web.Services
@inject AuthApiClient AuthApiClient
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject TokenStore TokenStore
@inject TokenRefreshService TokenRefreshService
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject NotificationsApiClient NotificationsApiClient
@inject ClientFlagsApiClient ClientFlagsApiClient
@inject NotificationFeedState NotificationFeedState
@inject ClientExceptionLog ClientExceptionLog
@inject ThemeService ThemeService
@inject DevicePreferences DevicePreferences
@inject PresenceService Presence
@inject Translations T
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<MainLayout> Logger

<div class="app-shell">
    @if (_isBannerVisible && _bannerEntry is not null)
    {
        <div class="notification-banner" role="status">
            <strong>@_bannerEntry.Title</strong>
            <span>@_bannerEntry.Body</span>
        </div>
    }
    @if (_isAuthenticated)
    {
            <aside class="sidebar @(_sidebarCollapsed ? "collapsed" : "")">
                <div class="sidebar-logo" role="button" tabindex="0" title="@(T["Collapse sidebar"])"
                     @onclick="OnLogoClickAsync" @onkeydown="OnLogoKeyDown">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 26 26">
                        <circle cx="13" cy="13" r="3" fill="var(--accent)" />
                        <ellipse cx="13" cy="13" rx="11" ry="5.5" fill="none" stroke="var(--accent)" stroke-width="1.6" transform="rotate(-28 13 13)" />
                    </svg>
                    <span class="sidebar-logo-text">Orbit</span>
                </div>

                <nav class="sidebar-nav">
                    <NavLink class="nav-item nav-item-dashboard" href="/" Match="NavLinkMatch.All" title="@(T["Dashboard"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="6" height="6" rx="1.5" /><rect x="11.5" y="2.5" width="6" height="6" rx="1.5" /><rect x="2.5" y="11.5" width="6" height="6" rx="1.5" /><rect x="11.5" y="11.5" width="6" height="6" rx="1.5" /></svg>
                        <span class="label">@T["Dashboard"]</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/notes" title="@(T["Notes"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2.5h7l3 3v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-14a1 1 0 0 1 1-1Z" /><path d="M12 2.5v3h3" /><path d="M6.5 11h7M6.5 14h7M6.5 8h3" /></svg>
                        <span class="label">@T["Notes"]</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/tasks" title="@(T["Tasks"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="14" height="14" rx="3" /><path d="M6.5 10.2l2.3 2.3L13.5 7.8" /></svg>
                        <span class="label">@T["Tasks"]</span>
                        @RenderSectionBadge("/tasks")
                    </NavLink>
                    <NavLink class="nav-item" href="/calendar" title="@(T["Calendar"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="15" height="13.5" rx="2.5" /><path d="M2.5 8h15M6.5 2v3.5M13.5 2v3.5" /></svg>
                        <span class="label">@T["Calendar"]</span>
                        @RenderSectionBadge("/calendar")
                    </NavLink>
                    <NavLink class="nav-item" href="/inventory" title="@(T["Inventory"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.2l7-3.4 7 3.4v7.6l-7 3.4-7-3.4V6.2Z" /><path d="M3 6.2l7 3.4M10 9.6l7-3.4M10 9.6v7.6" /></svg>
                        <span class="label">@T["Inventory"]</span>
                        @RenderSectionBadge("/inventory")
                    </NavLink>
                    <NavLink class="nav-item" href="/map" title="@(T["Map"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17.5s5.5-5 5.5-9a5.5 5.5 0 1 0-11 0c0 4 5.5 9 5.5 9Z" /><circle cx="10" cy="8.5" r="2" /></svg>
                        <span class="label">@T["Map"]</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/contacts" title="@(T["Contacts"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="6.5" r="3" /><path d="M1.5 17c0-3 2.5-5 5.5-5s5.5 2 5.5 5" /><circle cx="15" cy="7.5" r="2.3" /><path d="M13.7 12.2c2.4.3 4.1 2 4.1 4.6" /></svg>
                        <span class="label">@T["Contacts"]</span>
                        @RenderSectionBadge("/chat")
                    </NavLink>

                    <div class="nav-divider"></div>

                    <NavLink class="nav-item options-nav-item" href="/options" title="@(T["Options"])">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="10" cy="10" r="3.4" />
                            <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" />
                            <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(60 10 10)" />
                            <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(120 10 10)" />
                            <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(180 10 10)" />
                            <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(240 10 10)" />
                            <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(300 10 10)" />
                        </svg>
                        <span class="label">@T["Options"]</span>
                    </NavLink>
                </nav>

                <div class="sidebar-footer">
                    <button type="button" class="avatar-trigger" @onclick="ToggleAvatarMenu" @onclick:stopPropagation="true">
                        <span class="avatar">
                            @GetInitials(_userName)
                            @if (_unreadCount > 0)
                            {
                                <span class="notif-badge">@FormatUnreadCount(_unreadCount)</span>
                            }
                            <PresenceDot Status="OwnStatus" />
                        </span>
                        <span class="user-meta">
                            <span class="user-name">@_userName</span>
                        </span>
                    </button>

                    @if (_avatarMenuOpen)
                    {
                        <div class="avatar-dropdown" @onclick:stopPropagation="true">
                            <div class="avatar-dropdown-header">
                                <span class="avatar">
                                    @GetInitials(_userName)
                                    <PresenceDot Status="OwnStatus" />
                                </span>
                                <span class="user-meta">
                                    <span class="user-name">@_userName</span>
                                </span>
                            </div>
                            <div class="availability-picker">
                                <button type="button"
                                        class="availability-choice @(Presence.Availability == PresenceAvailability.Available ? "availability-choice-selected" : "")"
                                        @onclick="() => SetAvailabilityAsync(PresenceAvailability.Available)">
                                    <PresenceDot Status="PresenceStatus.Available" />
                                    @T["Available"]
                                </button>
                                <button type="button"
                                        class="availability-choice @(Presence.Availability == PresenceAvailability.DoNotDisturb ? "availability-choice-selected" : "")"
                                        @onclick="() => SetAvailabilityAsync(PresenceAvailability.DoNotDisturb)">
                                    <PresenceDot Status="PresenceStatus.DoNotDisturb" />
                                    @T["Do not disturb"]
                                </button>
                            </div>
                            <div class="avatar-dropdown-divider"></div>
                            <a class="avatar-dropdown-item options-only" href="/options">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="10" cy="10" r="3.4" />
                                    <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" />
                                    <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(60 10 10)" />
                                    <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(120 10 10)" />
                                    <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(180 10 10)" />
                                    <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(240 10 10)" />
                                    <rect x="9.15" y="3.9" width="1.7" height="3" rx="0.5" fill="currentColor" stroke="none" transform="rotate(300 10 10)" />
                                </svg>
                                @T["Options"]
                            </a>
                            <button type="button" class="avatar-dropdown-item" @onclick="ToggleNotificationsMenuAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5c-2.5 0-4 2-4 4.5v3l-1.5 2.5h11L14 10V7c0-2.5-1.5-4.5-4-4.5Z" /><path d="M8.3 15.5a1.8 1.8 0 0 0 3.4 0" /></svg>
                                @T["Notifications"]
                                @if (_unreadCount > 0)
                                {
                                    <span class="avatar-dropdown-item-badge">@FormatUnreadCount(_unreadCount)</span>
                                }
                            </button>
                            <button type="button" class="avatar-dropdown-item" @onclick="LogoutAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 17H4.5a1.5 1.5 0 0 1-1.5-1.5v-11A1.5 1.5 0 0 1 4.5 3H8" /><path d="M13 14l4-4-4-4" /><path d="M17 10H8" /></svg>
                                @T["Log out"]
                            </button>
                        </div>
                    }

                    @if (_notificationsMenuOpen)
                    {
                        <div class="notifications-panel" @onclick:stopPropagation="true">
                            <div class="notifications-panel-header">
                                <span>@T["Notifications"]</span>
                                <button type="button" class="notifications-panel-clear" disabled="@_isClearingNotifications"
                                        @onclick="ClearNotificationsAsync">@T["Clear"]</button>
                            </div>
                            <NotificationList IsLoading="_isLoadingNotifications" Entries="_recentEntries"
                                              ExceptionEntries="_clientExceptionEntries"
                                              OnEntrySelected="OpenNotificationEntry" />
                            <div class="notifications-panel-footer">
                                <a href="/notifications" @onclick="CloseNotificationsMenu" @onclick:preventDefault="false">
                                    @T["See all notifications"]
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </aside>
    }

    <main class="main-content" @onclick="CloseAvatarMenu">
        @Body
    </main>
</div>

@code {
    private const string SidebarCollapsedStorageKey = "orbit.sidebarCollapsed";



    private bool _sidebarCollapsed;
    private bool _avatarMenuOpen;
    private PeriodicTimer? _sessionHeartbeatTimer;
    private CancellationTokenSource? _sessionHeartbeatCancellation;

    private bool _notificationsMenuOpen;
    private bool _isClearingNotifications;

    /// <summary>Derived from the shared feed state, so the avatar badge and the per-section badges can never disagree.</summary>
    private int _unreadCount => NotificationFeedState.UnreadCount;
    private bool _isLoadingNotifications;
    private IReadOnlyList<NotificationEntryDto> _recentEntries = [];
    private IReadOnlyList<ClientLogEntry> _clientExceptionEntries = [];
    private bool _showExceptionsSection;
    private NotificationSettingsDto _notificationSettings = new(true, true, true, true, true, BannerVisibleSeconds: 5, BannerMinimumGapSeconds: 5);
    private NotificationEntryDto? _bannerEntry;
    private bool _isBannerVisible;
    private DateTimeOffset? _lastBannerShownAtUtc;
    private PeriodicTimer? _notificationPollTimer;
    private CancellationTokenSource? _notificationPollCancellation;

    /// <summary>
    /// How often MainLayout checks for new notifications while a tab is open - fast enough that a toast
    /// banner (see ShowBannerForNewestEntryAsync) feels prompt. The banner's own visible duration and
    /// minimum gap are per-user settings (see BannerMinimumGap/BannerVisibleDuration below), so this
    /// poll cadence is only a floor on how quickly a new entry can be noticed, not on banner pacing.
    /// </summary>
    private static readonly TimeSpan NotificationPollInterval = TimeSpan.FromSeconds(10);

    private TimeSpan BannerMinimumGap => TimeSpan.FromSeconds(_notificationSettings.BannerMinimumGapSeconds);
    private TimeSpan BannerVisibleDuration => TimeSpan.FromSeconds(_notificationSettings.BannerVisibleSeconds);

    /// <summary>
    /// Whether to render the sidebar at all, and <see cref="_userName"/> for its avatar/name. Tracked
    /// explicitly here instead of via a nested &lt;AuthorizeView&gt; so the sidebar's visibility doesn't
    /// depend on anything but this component's own, always-correctly-scoped AuthenticationStateProvider
    /// instance (see the DI registration notes in Program.cs and AuthorizationMessageHandler's class
    /// remarks for the scoping pitfall that motivated this). Updated directly off the same
    /// AuthenticationStateChanged event this component already subscribes to (see
    /// EnsureEncryptionKeyIfAuthenticatedAsync's use of it below).
    /// </summary>
    private bool _isAuthenticated;
    private string? _userName;

    /// <summary>
    /// How often MainLayout re-checks whether the stored access token is still valid while the SPA sits
    /// idle. Well under JwtSettings.ExpiryMinutes (15 minutes today), so a tab left open past that point
    /// notices within about a minute instead of indefinitely - nothing else re-evaluates authentication
    /// state on its own, since Blazor's cascading AuthenticationState only updates when
    /// NotifyAuthenticationStateChanged is called, which otherwise only happens on an explicit
    /// login/logout action.
    /// </summary>
    private static readonly TimeSpan SessionHeartbeatInterval = TimeSpan.FromSeconds(60);

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        _sidebarCollapsed = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", SidebarCollapsedStorageKey) == "true";
        await RefreshAuthenticationDisplayStateAsync();
        // Syncs ThemeService.Current to whatever index.html's inline anti-flash script already applied
        // (see ThemeService's class comment) - runs once per app load, regardless of auth state, since
        // theme applies to the login/register pages too.
        await ThemeService.InitializeAsync();
        await DevicePreferences.InitializeAsync();
        // Translations is already loaded - Program.cs reads it before the first render, so the very
        // first paint is in the right language. This only subscribes, so that changing it in Options
        // re-renders every page below this layout at once instead of on the next navigation.
        T.Changed += OnLanguageChanged;
        await EnsureEncryptionKeyIfAuthenticatedAsync();
        StartSessionHeartbeat();
        if (_isAuthenticated)
        {
            Presence.Changed += OnPresenceChanged;
            await Presence.StartAsync();
        }
        await RefreshNotificationStateIfAuthenticatedAsync();
        StartNotificationPoll();
    }

    /// <summary>
    /// Fetches this user's notification settings (needed for the banner's AllowMobileBanner gate) and
    /// current unread count - best-effort, since a transient failure here shouldn't block the rest of
    /// the page from loading. Called once at startup and, implicitly, by every NotificationPollTickAsync
    /// tick thereafter.
    /// </summary>
    /// <summary>
    /// The dot on this account's own avatar. Somebody looking at their own page is by definition here,
    /// so this only ever reflects what they chose - the away and offline states are what *other* people
    /// see once the heartbeat stops, and showing them to yourself would be showing you a version of
    /// yourself that only exists after you have left.
    /// </summary>
    private PresenceStatus OwnStatus => Presence.Availability == PresenceAvailability.DoNotDisturb
        ? PresenceStatus.DoNotDisturb
        : PresenceStatus.Available;

    private async Task SetAvailabilityAsync(PresenceAvailability availability)
    {
        Logger.LogInformation("User set their availability to {Availability}", availability);
        await Presence.SetAvailabilityAsync(availability);
    }

    private void OnPresenceChanged() => InvokeAsync(StateHasChanged);

    private async Task RefreshNotificationStateIfAuthenticatedAsync()
    {
        if (!_isAuthenticated)
        {
            return;
        }

        try
        {
            _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
            NotificationFeedState.Set(await NotificationsApiClient.GetUnreadAsync());
            StateHasChanged();
        }
        catch (HttpRequestException)
        {
            // Transient (API unreachable, session lapsed mid-request, ...) - the next poll tick retries.
        }
    }

    /// <summary>
    /// Reads the current authentication state and updates <see cref="_isAuthenticated"/>/<see cref="_userName"/>
    /// (see their doc comment for why this deliberate, explicit read replaces a nested AuthorizeView).
    /// Called from OnInitializedAsync for the very first render, and from OnAuthenticationStateChanged -
    /// which fires for every subsequent NotifyAuthenticationStateChanged call, from login, logout, the
    /// session heartbeat, and AuthorizationMessageHandler alike.
    /// </summary>
    private async Task RefreshAuthenticationDisplayStateAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;
        _userName = _isAuthenticated ? authenticationState.User.Identity!.Name : null;
        StateHasChanged();
    }

    /// <summary>
    /// Generates and publishes this browser's E2EE key pair the moment the user is known to be signed
    /// in, rather than waiting for them to open the chat page - this is what lets someone else message
    /// this user without first waiting for them to visit chat themselves (see OwnEncryptionKeyProvider
    /// for what "ensure" does). Runs both on a page load where a token is already stored, and again
    /// whenever the auth state changes (fresh sign-in or registration - see the event subscription
    /// above), since this layout is only ever initialized once per SPA session.
    /// </summary>
    private async Task EnsureEncryptionKeyIfAuthenticatedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            await OwnEncryptionKeyProvider.EnsurePublicKeyAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // IsAuthenticated above only reflects the stored token's claims, never its expiry (see
            // OrbitAuthenticationStateProvider) - the server has already rejected it and
            // AuthorizationMessageHandler's silent refresh also failed. This runs on every route via
            // MainLayout, so without this catch a stale session would break the very first page the
            // user lands on instead of sending them back to sign in.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // Any other failure here (API unreachable, DNS, CORS, ...) surfaces with no HTTP status at
            // all rather than 401, so the catch above doesn't apply. Publishing the public key is a
            // best-effort step, not a precondition for using the app, and this runs on every route via
            // MainLayout - letting it propagate would crash navigation entirely instead of just leaving
            // the key unpublished until the next successful retry (next page load, or Chat.razor's own
            // call when the user opens a conversation).
            Logger.LogWarning(exception, "Failed to publish the local E2EE public key");
        }
        catch (JSException exception)
        {
            // crypto.subtle (which e2eeChat.js needs to generate the key pair) is only exposed by
            // browsers in a secure context - HTTPS, or the special-cased "localhost"/"127.0.0.1" hosts -
            // so opening Orbit.Web over plain HTTP via a LAN IP address makes this throw every time (see
            // README.md's "Accessing Orbit.Web from another device on your network"). Same reasoning as
            // the HttpRequestException catch above: best-effort, not a precondition for using the app.
            Logger.LogWarning(exception, "End-to-end encryption is unavailable in this browsing context");
        }
        catch (EncryptionKeyLockedException)
        {
            // This browser has no local private key for the signed-in user (see
            // OwnEncryptionKeyProvider.EnsurePublicKeyAsync) - restoring it needs the account password,
            // which isn't available here since this runs on every page load, not just right after
            // sign-in. Left unpublished until the user opens Chat.razor, which has a dedicated UI for
            // this and, unlike here, offers a way to resolve it by signing in again.
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> newState)
    {
        _ = HandleAuthenticationStateChangedAsync();
    }

    /// <summary>
    /// Runs everything that needs to react to a fresh sign-in, logout, or silent-refresh outcome, in
    /// order - notably RefreshNotificationStateIfAuthenticatedAsync only fetches this user's own
    /// notification settings/unread count once _isAuthenticated (set by RefreshAuthenticationDisplayStateAsync)
    /// is up to date, instead of racing it as a separate fire-and-forget call would.
    /// </summary>
    private async Task HandleAuthenticationStateChangedAsync()
    {
        await RefreshAuthenticationDisplayStateAsync();
        await EnsureEncryptionKeyIfAuthenticatedAsync();
        // Restarts the heartbeat after a fresh sign-in that follows an explicit logout (StopSessionHeartbeat
        // above) - MainLayout itself is never recreated across that transition, so nothing else would.
        // A no-op while it's already running (StartSessionHeartbeat only starts one if none exists yet).
        StartSessionHeartbeat();
        await RefreshNotificationStateIfAuthenticatedAsync();
        StartNotificationPoll();
    }

    /// <summary>
    /// Closes the avatar/notifications menus on navigation, so neither stays open across an unrelated
    /// route change, and marks read whatever notification pointed at wherever the reader just arrived.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_avatarMenuOpen || _notificationsMenuOpen)
        {
            _avatarMenuOpen = false;
            _notificationsMenuOpen = false;
            InvokeAsync(StateHasChanged);
        }

        InvokeAsync(() => MarkNotificationsForCurrentPageReadAsync(e.Location));
    }

    /// <summary>
    /// Reaching the page a notification was about is the same as having read it, however the reader got
    /// there - before this, only clicking the entry in the panel counted, so opening the task from the
    /// task list left the badge lit over a notification about the page already being looked at.
    ///
    /// Skipped entirely when nothing is unread, which is the usual case: an ordinary click around the
    /// app should not cost a request per navigation.
    /// </summary>
    private async Task MarkNotificationsForCurrentPageReadAsync(string location)
    {
        if (!_isAuthenticated || NotificationFeedState.UnreadCount == 0)
        {
            return;
        }

        var path = new Uri(location, UriKind.Absolute).AbsolutePath;
        if (!NotificationFeedState.HasUnreadFor(path))
        {
            return;
        }

        if (await NotificationsApiClient.MarkReadAtUrlAsync(path))
        {
            NotificationFeedState.MarkReadFor(path);
            StateHasChanged();
        }
    }

    private async Task ToggleSidebarCollapsedAsync()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", SidebarCollapsedStorageKey, _sidebarCollapsed ? "true" : "false");
    }

    /// <summary>
    /// On a mobile viewport the sidebar is a horizontal top bar (see app.css's @media (max-width: 680px)
    /// block) rather than the desktop collapse-to-icon-rail layout, so "collapse sidebar" doesn't apply
    /// there - the logo instead acts as a shortcut back to the Dashboard, mirroring the now-hidden
    /// Dashboard nav item (.nav-item-dashboard) it replaces on that breakpoint.
    /// </summary>
    private async Task OnLogoClickAsync()
    {
        if (await IsMobileViewportAsync())
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await ToggleSidebarCollapsedAsync();
    }

    /// <summary>Matches app.css's own mobile breakpoint - see wwwroot/js/viewport.js, the single place both check it.</summary>
    private async Task<bool> IsMobileViewportAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("OrbitViewport.isMobile");
        }
        catch (JSException exception)
        {
            // Treated as desktop: the popup still works there, it is just less comfortable.
            Logger.LogWarning(exception, "Failed to read the viewport size");
            return false;
        }
    }

    private async Task OnLogoKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            await OnLogoClickAsync();
        }
    }

    private void ToggleAvatarMenu() => _avatarMenuOpen = !_avatarMenuOpen;

    private void StartSessionHeartbeat()
    {
        if (_sessionHeartbeatTimer is not null)
        {
            return;
        }

        _sessionHeartbeatCancellation = new CancellationTokenSource();
        _sessionHeartbeatTimer = new PeriodicTimer(SessionHeartbeatInterval);
        _ = SessionHeartbeatLoopAsync(_sessionHeartbeatCancellation.Token);
    }

    private void StopSessionHeartbeat()
    {
        _sessionHeartbeatCancellation?.Cancel();
        _sessionHeartbeatCancellation?.Dispose();
        _sessionHeartbeatCancellation = null;
        _sessionHeartbeatTimer?.Dispose();
        _sessionHeartbeatTimer = null;
    }

    private async Task SessionHeartbeatLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _sessionHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await CheckSessionHeartbeatAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when DisposeAsync/logout cancels the heartbeat.
        }
        catch (ObjectDisposedException)
        {
            // The timer was disposed by StopSessionHeartbeat between a tick starting and this loop checking again.
        }
    }

    /// <summary>
    /// Re-checks the stored access token's own "exp" claim (see OrbitAuthenticationStateProvider) and,
    /// if it has lapsed, tries a silent refresh before treating this as a real sign-out - the same
    /// on-demand recovery AuthorizationMessageHandler already does for a live API call, so a tab merely
    /// left idle past the access token's short lifetime doesn't lose a session that's still well within
    /// the refresh token's much longer one (30 days - see RefreshTokenService). Either way,
    /// NotifyAuthenticationStateChanged is what actually makes this sidebar and every [Authorize]-gated
    /// route notice - on success it just confirms the (now-renewed) signed-in state; on failure it's
    /// what finally hides the sidebar and redirects to /login instead of leaving both looking
    /// signed-in indefinitely.
    /// </summary>
    private async Task CheckSessionHeartbeatAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            return;
        }

        var refreshToken = await TokenStore.GetRefreshTokenAsync();
        if (string.IsNullOrEmpty(refreshToken))
        {
            // Nothing has ever signed in on this browser (or a real logout already ran) - nothing
            // lapsed, so there's nothing to notify. Avoids a spurious re-render of the cascading
            // authentication state (and whatever's on /login right now) every tick on a browser that
            // was never signed in to begin with.
            return;
        }

        await TokenRefreshService.TryRefreshAsync();
        AuthenticationStateProvider.NotifyAuthenticationStateChanged();
    }

    private void StartNotificationPoll()
    {
        if (!_isAuthenticated || _notificationPollTimer is not null)
        {
            return;
        }

        _notificationPollCancellation = new CancellationTokenSource();
        _notificationPollTimer = new PeriodicTimer(NotificationPollInterval);
        _ = NotificationPollLoopAsync(_notificationPollCancellation.Token);
    }

    private void StopNotificationPoll()
    {
        _notificationPollCancellation?.Cancel();
        _notificationPollCancellation?.Dispose();
        _notificationPollCancellation = null;
        _notificationPollTimer?.Dispose();
        _notificationPollTimer = null;
    }

    private async Task NotificationPollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _notificationPollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await NotificationPollTickAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when DisposeAsync/logout cancels the poll.
        }
        catch (ObjectDisposedException)
        {
            // The timer was disposed by StopNotificationPoll between a tick starting and this loop checking again.
        }
    }

    /// <summary>
    /// Refreshes settings/unread count every tick (so a change made on the Options page - e.g. turning
    /// the banner off - takes effect within one poll interval) and, if the count just went up, shows a
    /// toast banner for the newest entry - subject to AllowMobileBanner and the separate
    /// BannerMinimumGap rate limit (see CanShowBannerNow).
    /// </summary>
    private async Task NotificationPollTickAsync()
    {
        var previousUnreadCount = _unreadCount;
        await RefreshNotificationStateIfAuthenticatedAsync();

        if (_unreadCount > previousUnreadCount && _notificationSettings.AllowMobileBanner && CanShowBannerNow())
        {
            await ShowBannerForNewestEntryAsync();
        }
    }

    private bool CanShowBannerNow() => _lastBannerShownAtUtc is null || DateTimeOffset.UtcNow - _lastBannerShownAtUtc >= BannerMinimumGap;

    private async Task ShowBannerForNewestEntryAsync()
    {
        try
        {
            var recent = await NotificationsApiClient.GetRecentAsync();
            if (recent.Count == 0)
            {
                return;
            }

            _bannerEntry = recent[0];
            _isBannerVisible = true;
            _lastBannerShownAtUtc = DateTimeOffset.UtcNow;
            StateHasChanged();

            await Task.Delay(BannerVisibleDuration);
            _isBannerVisible = false;
            StateHasChanged();
        }
        catch (HttpRequestException)
        {
            // Transient - simply no banner shows for this tick's new notification.
        }
    }

    /// <summary>
    /// Opens (or closes) the panel; opening it loads the recent feed and this browser's own client-side
    /// exception log, marks everything server-side as read, and zeros the badge immediately - matches
    /// "opening Notifications resets the unread counter" rather than waiting for the next poll tick.
    ///
    /// On a phone the popup is the wrong shape for this - a 320px panel anchored to a top bar leaves
    /// almost nothing readable - so there it navigates to the full-page Notifications route instead,
    /// mirroring how the logo becomes a Dashboard shortcut on the same breakpoint (see OnLogoClickAsync).
    /// </summary>
    private async Task ToggleNotificationsMenuAsync()
    {
        _avatarMenuOpen = false;

        if (await IsMobileViewportAsync())
        {
            _notificationsMenuOpen = false;
            NavigationManager.NavigateTo("/notifications");
            return;
        }

        _notificationsMenuOpen = !_notificationsMenuOpen;
        if (!_notificationsMenuOpen)
        {
            return;
        }

        _isLoadingNotifications = true;
        StateHasChanged();
        try
        {
            _recentEntries = await NotificationsApiClient.GetRecentAsync();
            await LoadClientExceptionEntriesAsync();
            await NotificationsApiClient.MarkAllReadAsync();
            NotificationFeedState.Clear();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to load notifications");
        }
        finally
        {
            _isLoadingNotifications = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Empties the feed: the server-side entries and this browser's own captured errors, because the
    /// panel presents them as one list and clearing half of it would look broken. Discards rather than
    /// marks read - "Clear" is about getting rid of the list, not about the unread count.
    /// </summary>
    private async Task ClearNotificationsAsync()
    {
        _isClearingNotifications = true;
        try
        {
            await NotificationsApiClient.ClearAsync();
            await ClientExceptionLog.ClearAsync();
            _recentEntries = [];
            _clientExceptionEntries = [];
            NotificationFeedState.Clear();

            // The panel now has nothing in it, so leaving it open would show the reader an empty box
            // they have to dismiss themselves.
            _notificationsMenuOpen = false;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to clear notifications");
        }
        finally
        {
            _isClearingNotifications = false;
        }
    }

    /// <summary>
    /// The unread badge for one nav section, keyed off the Url its notifications carry ("/tasks/{id}",
    /// "/chat/{userId}", ...) - so a reminder shows up on the section it came from, not only on the
    /// avatar. Renders nothing when that section has no unread notifications.
    /// </summary>
    private RenderFragment? RenderSectionBadge(string urlPrefix)
    {
        var count = NotificationFeedState.CountForSection(urlPrefix);
        if (count == 0)
        {
            return null;
        }

        return builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "nav-item-badge");
            builder.AddContent(2, FormatUnreadCount(count));
            builder.CloseElement();
        };
    }

    /// <summary>
    /// Every feed entry carries the same in-app Url its push notification would deep-link to (see
    /// PushNotificationPayload) - clicking the panel row navigates there and closes the panel, so the
    /// panel isn't a dead end compared to the push path. Entries without a Url stay inert.
    /// </summary>
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void CloseNotificationsMenu() => _notificationsMenuOpen = false;

    private void OpenNotificationEntry(NotificationEntryDto entry)
    {
        if (entry.Url is null)
        {
            return;
        }

        _notificationsMenuOpen = false;
        NavigationManager.NavigateTo(entry.Url);
    }

    /// <summary>
    /// Reads this browser's own captured Warning+/Error client-side log (see clientLogging.js's
    /// appendLog, mirrored here by PersistentLoggerProvider) - purely local per-device diagnostics, never
    /// sent to the server, unlike the push/chat entries in _recentEntries above. Gated on both the
    /// server's environment flag and the reader asking for them - either through this account's
    /// ShowExceptionDetails preference or by putting this browser in Debug mode (see
    /// DevicePreferences.DiagnosticsMode). The server's flag stays the outer gate whichever way they
    /// asked, so a Production deployment never shows this section regardless of what anyone has set.
    /// </summary>
    private async Task LoadClientExceptionEntriesAsync()
    {
        var exceptionDetailsAllowedByServer = await ClientFlagsApiClient.GetExceptionDetailsAllowedAsync();
        var readerAskedForThem = _notificationSettings.ShowExceptionDetails
            || DevicePreferences.DiagnosticsMode == DiagnosticsMode.Debug;
        _showExceptionsSection = exceptionDetailsAllowedByServer && readerAskedForThem;
        if (!_showExceptionsSection)
        {
            _clientExceptionEntries = [];
            return;
        }

        _clientExceptionEntries = await ClientExceptionLog.GetRecentErrorsAsync();
    }

    private static string FormatUnreadCount(int count) => count > 9 ? "9+" : count.ToString(CultureInfo.InvariantCulture);

    private string FormatEntryTime(DateTimeOffset timestampUtc) => timestampUtc.ToLocalTime().ToString("MMM d, HH:mm", T.DisplayCulture);

    /// <summary>
    /// Bound to a click anywhere in the main content area, so clicking outside the dropdown closes it
    /// without needing JS interop for outside-click detection - the trigger and dropdown itself both
    /// stop propagation (see the markup above) so this only ever fires for genuine outside clicks.
    /// </summary>
    private void CloseAvatarMenu()
    {
        _avatarMenuOpen = false;
        _notificationsMenuOpen = false;
    }

    private async Task LogoutAsync()
    {
        _avatarMenuOpen = false;
        _notificationsMenuOpen = false;
        _isAuthenticated = false;
        _userName = null;
        NotificationFeedState.Clear();
        StopSessionHeartbeat();
        StopNotificationPoll();
        await AuthApiClient.LogoutAsync();
        AuthenticationStateProvider.NotifyAuthenticationStateChanged();
        NavigationManager.NavigateTo("/login");
    }

    /// <summary>Two-letter initials for the avatar badge - "Alex Kowalski" to "AK", a single-word name to its first two letters.</summary>
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[1][..1]).ToUpperInvariant()
        };
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        T.Changed -= OnLanguageChanged;
        Presence.Changed -= OnPresenceChanged;
        StopSessionHeartbeat();
        StopNotificationPoll();
    }
}
