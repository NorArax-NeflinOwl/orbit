@inherits LayoutComponentBase
@using Orbit.Web.Services
@inject AuthApiClient AuthApiClient
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="page">
    <main>
        <AuthorizeView>
            <Authorized>
                <nav class="main-nav">
                    <NavLink href="/" Match="NavLinkMatch.All">Notatki</NavLink>
                    <NavLink href="/tasks">Zadania</NavLink>
                    <NavLink href="/calendar">Kalendarz</NavLink>
                </nav>
                <div class="user-bar">
                    <span>@context.User.Identity?.Name</span>
                    <button @onclick="LogoutAsync">Wyloguj</button>
                </div>
            </Authorized>
        </AuthorizeView>
        @Body
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        AuthenticationStateProvider.NotifyAuthenticationStateChanged();
        NavigationManager.NavigateTo("/login");
    }
}
