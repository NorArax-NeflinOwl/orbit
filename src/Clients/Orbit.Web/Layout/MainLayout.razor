@inherits LayoutComponentBase
@implements IDisposable
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@using Orbit.Web.Services.Logging
@inject AuthApiClient AuthApiClient
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject PushNotificationManager PushNotificationManager
@inject NavigationManager NavigationManager
@inject ILogger<MainLayout> Logger

<div class="page">
    <main>
        <AuthorizeView>
            <Authorized>
                <nav class="main-nav">
                    <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
                    <NavLink href="/notes">Notes</NavLink>
                    <NavLink href="/tasks">Tasks</NavLink>
                    <NavLink href="/calendar">Calendar</NavLink>
                    <NavLink href="/contacts">Contacts</NavLink>
                </nav>
                <div class="user-bar">
                    <span>@context.User.Identity?.Name</span>
                    @if (_pushNotificationsSupported == true)
                    {
                        <button @onclick="TogglePushNotificationsAsync" disabled="@_pushNotificationActionInProgress">
                            @(_pushNotificationsEnabled ? "Disable push notifications" : "Enable push notifications")
                        </button>
                    }
                    <button @onclick="LogoutAsync">Log out</button>
                </div>
                @if (_pushNotificationErrorMessage is not null)
                {
                    <p class="error">@_pushNotificationErrorMessage</p>
                }
            </Authorized>
        </AuthorizeView>
        @Body
    </main>
</div>

@code {
    private bool? _pushNotificationsSupported;
    private bool _pushNotificationsEnabled;
    private bool _pushNotificationActionInProgress;
    private string? _pushNotificationErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await EnsureEncryptionKeyIfAuthenticatedAsync();
        await RefreshPushNotificationStateIfAuthenticatedAsync();
    }

    /// <summary>
    /// Generates and publishes this browser's E2EE key pair the moment the user is known to be signed
    /// in, rather than waiting for them to open the chat page - this is what lets someone else message
    /// this user without first waiting for them to visit chat themselves (see OwnEncryptionKeyProvider
    /// for what "ensure" does). Runs both on a page load where a token is already stored, and again
    /// whenever the auth state changes (fresh sign-in or registration - see the event subscription
    /// above), since this layout is only ever initialized once per SPA session.
    /// </summary>
    private async Task EnsureEncryptionKeyIfAuthenticatedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            await OwnEncryptionKeyProvider.EnsurePublicKeyAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // IsAuthenticated above only reflects the stored token's claims, never its expiry (see
            // OrbitAuthenticationStateProvider) - the server has already rejected it and
            // AuthorizationMessageHandler's silent refresh also failed. This runs on every route via
            // MainLayout, so without this catch a stale session would break the very first page the
            // user lands on instead of sending them back to sign in.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // Any other failure here (API unreachable, DNS, CORS, ...) surfaces with no HTTP status at
            // all rather than 401, so the catch above doesn't apply. Publishing the public key is a
            // best-effort step, not a precondition for using the app, and this runs on every route via
            // MainLayout - letting it propagate would crash navigation entirely instead of just leaving
            // the key unpublished until the next successful retry (next page load, or Chat.razor's own
            // call when the user opens a conversation).
            Logger.LogWarning(exception, "Failed to publish the local E2EE public key");
        }
        catch (JSException exception)
        {
            // crypto.subtle (which e2eeChat.js needs to generate the key pair) is only exposed by
            // browsers in a secure context - HTTPS, or the special-cased "localhost"/"127.0.0.1" hosts -
            // so opening Orbit.Web over plain HTTP via a LAN IP address makes this throw every time (see
            // README.md's "Accessing Orbit.Web from another device on your network"). Same reasoning as
            // the HttpRequestException catch above: best-effort, not a precondition for using the app.
            Logger.LogWarning(exception, "End-to-end encryption is unavailable in this browsing context");
        }
        catch (EncryptionKeyLockedException)
        {
            // This browser has no local private key for the signed-in user (see
            // OwnEncryptionKeyProvider.EnsurePublicKeyAsync) - restoring it needs the account password,
            // which isn't available here since this runs on every page load, not just right after
            // sign-in. Left unpublished until the user opens Chat.razor, which has a dedicated UI for
            // this and, unlike here, offers a way to resolve it by signing in again.
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> newState)
    {
        _ = EnsureEncryptionKeyIfAuthenticatedAsync();
        _ = RefreshPushNotificationStateIfAuthenticatedAsync();
    }

    /// <summary>
    /// Determines whether the "enable/disable push notifications" button should be shown at all (the
    /// browser must support push - see PushNotificationManager.IsSupportedAsync), and, if so, whether
    /// this browser already has an active subscription - so a page reload doesn't show "Enable..." for a
    /// browser that already enabled push notifications in an earlier session.
    /// </summary>
    private async Task RefreshPushNotificationStateIfAuthenticatedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            _pushNotificationsSupported = await PushNotificationManager.IsSupportedAsync();
            _pushNotificationsEnabled = _pushNotificationsSupported == true && await PushNotificationManager.IsEnabledAsync();
        }
        catch (JSException exception)
        {
            // Same secure-context restriction as e2eeChat.js's crypto.subtle - see
            // EnsureEncryptionKeyIfAuthenticatedAsync's matching catch. Best-effort: simply hides the
            // button rather than breaking navigation.
            _pushNotificationsSupported = false;
            Logger.LogWarning(exception, "Push notifications are unavailable in this browsing context");
        }

        StateHasChanged();
    }

    private async Task TogglePushNotificationsAsync()
    {
        _pushNotificationActionInProgress = true;
        _pushNotificationErrorMessage = null;
        StateHasChanged();

        try
        {
            if (_pushNotificationsEnabled)
            {
                await PushNotificationManager.DisableAsync();
                _pushNotificationsEnabled = false;
            }
            else
            {
                _pushNotificationsEnabled = await PushNotificationManager.EnableAsync();
                if (!_pushNotificationsEnabled)
                {
                    // EnableAsync returns false, rather than throwing, when the user denies browser
                    // permission or Orbit.Api has no VAPID key configured - both silent by design up to
                    // this point, so without this the button would otherwise just do nothing visible.
                    _pushNotificationErrorMessage =
                        "Failed to enable push notifications. Check your browser permissions and try again.";
                }
            }
        }
        catch (HttpRequestException exception)
        {
            // Registering/removing the subscription with Orbit.Api failed (API unreachable, expired
            // session, ...) - logged rather than surfaced as a crash, same reasoning as
            // EnsureEncryptionKeyIfAuthenticatedAsync's HttpRequestException catch.
            Logger.LogActionFailed(ClientActionCategory.PushNotificationToggle, "Push notification toggle", exception);
            _pushNotificationErrorMessage = "Failed to update the push notification subscription. Try again.";
        }
        catch (JSException exception)
        {
            // Same secure-context restriction as RefreshPushNotificationStateIfAuthenticatedAsync -
            // IsSupportedAsync can pass (the browser APIs exist) while actually subscribing still fails
            // outside a secure context. Also covers a stale browser-level subscription conflict that
            // pushNotifications.js's requestPermissionAndSubscribe can no longer avoid on its own (e.g.
            // an unusual failure clearing the old subscription first), and a push service rejecting the
            // subscription outright (e.g. Brave with Google's push service disabled - see
            // info/instructions.md).
            Logger.LogActionFailed(ClientActionCategory.PushNotificationToggle, "Push notification toggle", exception);
            _pushNotificationErrorMessage = "Failed to update the push notification subscription. Try again.";
        }
        finally
        {
            _pushNotificationActionInProgress = false;
        }
    }

    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        AuthenticationStateProvider.NotifyAuthenticationStateChanged();
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
