@page "/calendar"
@attribute [Authorize]
@using System.Globalization
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Users
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Tasks
@using Orbit.Web.Services
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject TasksApiClient TasksApiClient
@inject PanelPreferences Panels
@inject UsersApiClient UsersApiClient
@inject NavigationManager NavigationManager
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject IJSRuntime JSRuntime
@inject ILogger<Calendar> Logger
@inject Translations T

<PageTitle>@T["Orbit — Calendar"]</PageTitle>

<div class="page-header">
    <div class="page-heading">
        <button type="button" class="icon-btn page-add" title="@(T["Add event"])" aria-label="@(T["Add event"])"
                @onclick="GoToAddEvent">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
        </button>
        <h1>@T["Calendar"]</h1>
    </div>
</div>

<div class="calendar-layout">
    <div class="calendar-event-list-panel">
        @* One list, whatever kind of thing is on it. Events and deadlines answer the same
           question - what is happening in this period - and two lists side by side made the
           reader merge them by eye, in a period where they interleave by definition. *@
        @if (_events is null || _dueTasks is null)
        {
            <p>@T["Loading…"]</p>
        }
        else if (ListedThings.Count == 0)
        {
            <p>@T["Nothing in this period."]</p>
        }
        else
        {
            <div class="item-card-list">
                @foreach (var thing in ListedThings)
                {
                    @if (thing.Event is { } calendarEvent)
                    {
                        <ItemCard Name="@calendarEvent.Details.Title"
                        OnNameSelected="() => GoToEditEvent(calendarEvent.Id)"
                        IsCollapsed="@(!IsEventExpanded(calendarEvent.Id))"
                        OnCollapseToggled="@(HasDetails(calendarEvent.Details) ? EventCallback.Factory.Create(this, () => ToggleEventExpanded(calendarEvent.Id)) : default)">
                        <Tags>
                            @* Which kind of thing this is, now that both kinds share one list. *@
                            <span class="card-badge card-badge-event">@T["Event"]</span>
                            @* The event's own colour, which is how a busy list is read at a glance
                               before any of it is read properly. *@
                            <span class="stat-dot" style="background:@(string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? "var(--accent)" : calendarEvent.Details.Color)"></span>
                            @if (calendarEvent.IsShared)
                            {
                                <span class="card-badge">@T.Format("Shared by {0}", calendarEvent.SharedByUserName)</span>
                            }
                        </Tags>
                        <Menu>
                        <OverflowMenu>
                        <button type="button" class="avatar-dropdown-item" @onclick="() => GoToEditEvent(calendarEvent.Id)">@(calendarEvent.IsShared ? T["View"] : T["Edit"])</button>
                        <button type="button" class="avatar-dropdown-item" @onclick="() => DeleteEventAsync(calendarEvent)">@T["Delete"]</button>
                        </OverflowMenu>
                        </Menu>
                        <Body>
                            @* When, first: it is the one thing every row on this list has, and the
                               reason somebody is reading the list at all. *@
                            <p class="event-when">@WhenItHappens(calendarEvent.Details)</p>
                            <div class="editor-item-details">
                        @if (calendarEvent.Details.Location is { } location)
                        {
                        <span>
                        <strong>@T["Location:"]</strong>
                        @* The address itself is the link, so the place is one click away rather than
                        something to copy out - see GoogleMapsLink. *@
                        @if (_hasGoogleExtras)
                        {
                        <a href="@GoogleMapsLink.ToPlace(location.Latitude, location.Longitude)" target="_blank" rel="noopener">@FormatLocation(location)</a>
                        <a class="google-link" href="@GoogleMapsLink.ToDirections(location.Latitude, location.Longitude)" target="_blank" rel="noopener">@T["Directions"]</a>
                        }
                        else
                        {
                        @FormatLocation(location)
                        }
                        </span>
                        }
                        @if (_hasGoogleExtras)
                        {
                        <span class="field-break"></span>
                        <a class="google-link" href="@GoogleCalendarLinkFor(calendarEvent)" target="_blank" rel="noopener">@T["Add to Google Calendar"]</a>
                        }
                        @if (calendarEvent.Details.Recurrence is { } recurrence)
                        {
                        <span><strong>@T["Repeats:"]</strong> @FormatRecurrence(recurrence)</span>
                        }
                        @if (calendarEvent.Details.Guests.Count > 0)
                        {
                        <span><strong>@T["Guests:"]</strong> @string.Join(", ", calendarEvent.Details.Guests.Select(GetGuestDisplayName))</span>
                        }
                        </div>
                        </Body>
                        </ItemCard>
                    }
                    else if (thing.DueTask is { } dueTask)
                    {
                        <ItemCard Name="@Written(dueTask.Description)"
                                  OnNameSelected="() => GoToDueTask(dueTask)"
                                  ExtraClass="@(dueTask.IsCompleted ? "item-card-done" : null)">
                            <Tags>
                                <span class="card-badge card-badge-task">@T["Task"]</span>
                                <span class="card-badge">@Written(dueTask.TaskListTitle)</span>
                            </Tags>
                            <Body>
                                <span class="event-when">@WhenItIsDue(dueTask)</span>
                            </Body>
                        </ItemCard>
                    }
                }
            </div>
        }
    </div>
    }

    <div class="calendar-visualization-panel">
        <div class="calendar-visualization-toolbar">
            <div class="calendar-visualization-toolbar-navigation">
                <button @onclick="GoToPreviousPeriod">‹</button>
                <button @onclick="GoToToday">@T["Today"]</button>
                <button @onclick="GoToNextPeriod">›</button>
                <h2 class="calendar-period-label">@_viewState.PeriodLabel(T.DisplayCulture)</h2>
            </div>
            <div class="calendar-view-switch">
                <button aria-pressed="@AriaPressed(CalendarViewMode.Day)" @onclick="() => SwitchView(CalendarViewMode.Day)">@T["Day"]</button>
                <button aria-pressed="@AriaPressed(CalendarViewMode.Month)" @onclick="() => SwitchView(CalendarViewMode.Month)">@T["Month"]</button>
                <button aria-pressed="@AriaPressed(CalendarViewMode.Year)" @onclick="() => SwitchView(CalendarViewMode.Year)">@T["Year"]</button>
            </div>
        </div>

        @switch (_viewState.ViewMode)
        {
            case CalendarViewMode.Day:
                <CalendarDayGrid Grid="CalendarGridBuilder.BuildDayGrid(_viewState.ReferenceDate, _events ?? [], _dueTasks ?? [])" OnEventSelected="GoToEditEvent" OnTaskSelected="GoToDueTask" />
                break;
            case CalendarViewMode.Year:
                <CalendarYearGrid Months="CalendarGridBuilder.BuildYearGrid(_viewState.ReferenceDate.Year, _events ?? [], _viewState.ShowDueTasksInYearView ? _dueTasks ?? [] : [])" OnDaySelected="GoToDay" />
                break;
            default:
                <CalendarMonthGrid Weeks="CalendarGridBuilder.BuildMonthGrid(_viewState.ReferenceDate, _events ?? [], _dueTasks ?? [])" OnDaySelected="GoToDay" />
                break;
        }
    </div>
</div>

@if (_viewState.ViewMode == CalendarViewMode.Year)
{
    <div class="calendar-year-view-options">
        <label>
            <input id="showDueTasksInYearView" type="checkbox" checked="@_viewState.ShowDueTasksInYearView" @onchange="ToggleShowDueTasksInYearView" />@T["Show tasks in year view"]</label>
    </div>
}

@code {
    /// <summary>Event ids whose location/repeat/guest lines are unfolded. Independent per event here: unlike an editor, this is for reading, and comparing two days' events at once is the point.</summary>
    private readonly HashSet<Guid> _expandedEventIds = [];

    private bool IsEventExpanded(Guid eventId) => _expandedEventIds.Contains(eventId);

    private void ToggleEventExpanded(Guid eventId)
    {
        if (!_expandedEventIds.Add(eventId))
        {
            _expandedEventIds.Remove(eventId);
        }
    }

    /// <summary>Whether an event has anything worth unfolding - no toggle is drawn when it hasn't.</summary>
    private static bool HasDetails(CalendarEventDetailsDto details)
        => details.Location is not null || details.Recurrence is not null || details.Guests.Count > 0;

    private IReadOnlyList<CalendarEventDto>? _events;
    private IReadOnlyList<DueTaskDto>? _dueTasks;

    /// <summary>
    /// Every list the due tasks came from, kept from that same read - it is what says which list a
    /// clicked deadline belongs to, and which list gathers that one (see GoToTaskList).
    /// </summary>
    private IReadOnlyList<TaskDto> _taskLists = [];
    private IReadOnlyList<ContactDto> _contacts = [];
    private readonly CalendarViewState _viewState = new();

    /// <summary>
    /// The events the list beside the grid shows: the ones touching the period on screen, soonest first.
    /// Listing the whole calendar meant scrolling past last spring to find next week.
    /// </summary>
    private IReadOnlyList<CalendarEventDto> _listedEvents
    {
        get
        {
            var (from, toExclusive) = _viewState.ListedPeriod();
            // An event that starts before the period and runs into it belongs to it as much as one that
            // starts inside it.
            return [.. (_events ?? [])
                .Where(calendarEvent => DateOnly.FromDateTime(calendarEvent.Details.StartUtc.LocalDateTime) < toExclusive
                    && DateOnly.FromDateTime(calendarEvent.Details.EndUtc.LocalDateTime) >= from)
                .OrderBy(calendarEvent => calendarEvent.Details.StartUtc)];
        }
    }

    /// <summary>The due tasks in the same period, by when they are due.</summary>
    private IReadOnlyList<DueTaskDto> _listedDueTasks
    {
        get
        {
            var (from, toExclusive) = _viewState.ListedPeriod();
            return [.. (_dueTasks ?? [])
                .Where(dueTask => DateOnly.FromDateTime(dueTask.DueDateUtc.LocalDateTime) is var due
                    && due >= from && due < toExclusive)
                .OrderBy(dueTask => dueTask.DueDateUtc)];
        }
    }

    /// <summary>
    /// Login of every guest not found among <see cref="_contacts"/>, resolved once via UsersApiClient
    /// and cached here instead of being looked up again on every render - see
    /// ResolveMissingGuestDisplayNamesAsync.
    /// </summary>
    private readonly Dictionary<Guid, string> _resolvedGuestUserNames = [];

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Calendar page opened, loading events");
        // Before the first render, so the panels come back open rather than opening a moment later.
        await Panels.InitializeAsync();
        try
        {
            _events = await CalendarApiClient.GetCalendarEventsAsync();
            _contacts = await ChatApiClient.GetContactsAsync();

            // Best-effort: the page works without the Google links, so neither call is allowed to stop
            // it loading.
            _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
            _dueTasks = await LoadDueTasksAsync();
            await ResolveMissingGuestDisplayNamesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {EventCount} calendar events", _events.Count);
        Logger.LogInformation("Loaded {DueTaskCount} tasks with a due date", _dueTasks.Count);
    }

    /// <summary>
    /// Flattens every task list's items down to just the ones with a due date, so they can be placed onto
    /// the calendar grids and event list alongside CalendarEventDto entries - see CalendarGridBuilder.DueTaskDto.
    /// </summary>
    private async Task<IReadOnlyList<DueTaskDto>> LoadDueTasksAsync()
    {
        _taskLists = await TasksApiClient.GetTaskListsAsync();
        return _taskLists
            .SelectMany(taskList => taskList.Items.Select(item => (taskList, item)))
            .Where(pair => pair.item.DueDateUtc is not null)
            .Select(pair => new DueTaskDto(
                pair.taskList.Id, pair.item.Id, pair.taskList.Title, pair.item.Description,
                pair.item.DueDateUtc!.Value, pair.item.IsCompleted, HasPlace(pair.item),
                pair.item.LinkedCalendarEventId))
            .OrderBy(dueTask => dueTask.DueDateUtc)
            .ToList();
    }

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    /// <summary>
    /// Looks up guestUserId's login for display, preferring the already-loaded contact list and falling
    /// back to the id itself if the user can no longer be resolved (e.g. a deleted account).
    /// </summary>
    private string GetGuestDisplayName(Guid guestUserId)
    {
        var contact = _contacts.FirstOrDefault(candidate => candidate.UserId == guestUserId);
        if (contact is not null)
        {
            return contact.UserName;
        }

        return _resolvedGuestUserNames.TryGetValue(guestUserId, out var userName) ? userName : guestUserId.ToString();
    }

    /// <summary>
    /// A guest might not be among the current user's contacts (e.g. they were removed as a contact
    /// after being invited) - this resolves those remaining guests' logins directly via UsersApiClient
    /// so the guest list never falls back to showing a raw id.
    /// </summary>
    private async Task ResolveMissingGuestDisplayNamesAsync()
    {
        var missingGuestUserIds = (_events ?? [])
            .SelectMany(calendarEvent => calendarEvent.Details.Guests)
            .Where(guestUserId => _contacts.All(contact => contact.UserId != guestUserId))
            .Distinct();

        foreach (var guestUserId in missingGuestUserIds)
        {
            var user = await UsersApiClient.GetUserAsync(guestUserId);
            if (user is not null)
            {
                _resolvedGuestUserNames[guestUserId] = user.UserName;
            }
        }
    }

    private void GoToAddEvent()
    {
        Logger.LogInformation("User clicked 'Add event'");
        NavigationManager.NavigateTo("/calendar/new");
    }

    private void GoToEditEvent(Guid eventId)
    {
        Logger.LogInformation("User clicked 'Edit' for calendar event {EventId}", eventId);
        NavigationManager.NavigateTo($"/calendar/{eventId}");
    }

    /// <summary>
    /// Opens the checklist rather than the deep editor: clicking a deadline on a calendar is a move
    /// towards ticking it off, not towards rewriting the list it is on.
    /// </summary>
    /// <summary>
    /// What clicking a deadline opens. Somewhere to be opens as its own summary, with the time and a map
    /// - the checklist is the right landing for something to tick off and the wrong one for something
    /// you have to get to. Everything else opens as the list, at the shallow level.
    /// </summary>
    private void GoToDueTask(DueTaskDto dueTask)
    {
        if (dueTask.HasPlace)
        {
            Logger.LogInformation(
                "User opened the summary of task item {TaskItemId} from the calendar", dueTask.TaskItemId);
            NavigationManager.NavigateTo($"/tasks/{dueTask.TaskListId}/items/{dueTask.TaskItemId}");
            return;
        }

        GoToTaskList(dueTask.TaskListId);
    }

    /// <summary>Whether this entry is somewhere as well as at some time - see TaskItemKind.</summary>
    private static bool HasPlace(TaskItemDto item)
        => item.LinkedCalendarEventId is not null || item.Location.Length > 0;

    private void GoToTaskList(Guid taskListId)
    {
        var opened = WhicheverListGathersIt(taskListId);
        Logger.LogInformation(
            "User clicked a due-task entry on the calendar for task list {TaskListId}, opening {OpenedTaskListId}",
            taskListId, opened);
        NavigationManager.NavigateTo($"/tasks/{opened}");
    }

    /// <summary>
    /// The list to actually open: one gathered by a group list is read as part of that group, so the
    /// group opens instead - and the group's own group above that, up to the top of the tree. A list
    /// nothing gathers is its own answer.
    ///
    /// The already-seen set is what stops a pair of lists that gather each other from looping forever.
    /// </summary>
    private Guid WhicheverListGathersIt(Guid taskListId)
    {
        var alreadySeen = new HashSet<Guid> { taskListId };
        while (Gatherer(taskListId) is { } gatherer && alreadySeen.Add(gatherer))
        {
            taskListId = gatherer;
        }

        return taskListId;
    }

    private Guid? Gatherer(Guid taskListId)
        => _taskLists
            .FirstOrDefault(candidate => candidate.IsGroup
                && candidate.Items.Any(item => item.LinkedTaskListId == taskListId))
            ?.Id;

    private async Task DeleteEventAsync(CalendarEventDto calendarEvent)
    {
        Logger.LogInformation("User clicked 'Delete' for calendar event {EventId}", calendarEvent.Id);
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete event \"{calendarEvent.Details.Title}\"?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await CalendarApiClient.DeleteCalendarEventAsync(calendarEvent.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete calendar event {EventId}", calendarEvent.Id);
            return;
        }

        _events = _events!.Where(existingEvent => existingEvent.Id != calendarEvent.Id).ToList();
        Logger.LogInformation("Calendar event {EventId} deleted", calendarEvent.Id);
    }



    private void ToggleShowDueTasksInYearView()
    {
        _viewState.ShowDueTasksInYearView = !_viewState.ShowDueTasksInYearView;
        Logger.LogInformation("User set 'Show tasks in year view' to {ShowDueTasksInYearView}", _viewState.ShowDueTasksInYearView);
    }

    private void SwitchView(CalendarViewMode viewMode)
    {
        Logger.LogInformation("User switched the calendar visualization to {ViewMode} view", viewMode);
        _viewState.SwitchView(viewMode);
    }

    private void GoToPreviousPeriod() => _viewState.StepBackward();

    private void GoToNextPeriod() => _viewState.StepForward();

    private void GoToToday() => _viewState.GoToToday();

    /// <summary>
    /// aria-pressed needs a lowercase "true"/"false" string - Blazor's bool-attribute shorthand (which
    /// would render "True"/"False") only applies to recognized HTML boolean attributes like disabled,
    /// not to arbitrary ARIA ones.
    /// </summary>
    private string AriaPressed(CalendarViewMode viewMode) => AriaBool(_viewState.ViewMode == viewMode);

    /// <summary>aria-* boolean attributes need a lowercase "true"/"false" string - see AriaPressed's own comment above.</summary>
    private static string AriaBool(bool value) => value.ToString(CultureInfo.InvariantCulture).ToLowerInvariant();

    /// <summary>Jumps the visualization into Day view for date - used when a day is clicked in the month or year grid.</summary>
    private void GoToDay(DateOnly date)
    {
        _viewState.ReferenceDate = date;
        _viewState.SwitchView(CalendarViewMode.Day);
    }

    /// <summary>
    /// When an event happens, said the shortest way that is still unambiguous. Something starting and
    /// ending on one day - which is nearly everything - says its date once and then the two times:
    /// "01.09.2026 19:30 – 20:30". Printing the date twice for a one-hour appointment is most of the
    /// line spent saying the same thing again.
    /// </summary>
    private string WhenItHappens(CalendarEventDetailsDto details)
    {
        var start = details.StartUtc.LocalDateTime;
        var end = details.EndUtc.LocalDateTime;

        if (details.IsAllDay)
        {
            return start.Date == end.Date
                ? T.Format("{0} (all day)", start.ToString("dd.MM.yyyy"))
                : $"{start:dd.MM.yyyy} – {end:dd.MM.yyyy}";
        }

        return start.Date == end.Date
            ? $"{start:dd.MM.yyyy} {start:HH:mm} – {end:HH:mm}"
            : $"{start:dd.MM.yyyy HH:mm} – {end:dd.MM.yyyy HH:mm}";
    }

    /// <summary>When a deadline falls. One instant, so there is no range to shorten.</summary>
    private static string WhenItIsDue(DueTaskDto dueTask)
        => dueTask.DueDateUtc.LocalDateTime.ToString("dd.MM.yyyy HH:mm");

    /// <summary>
    /// Everything in this period, both kinds together and in the order they happen. Two lists made the
    /// reader interleave them by eye, which is the one thing a calendar is meant to have done already.
    /// </summary>
    private IReadOnlyList<ListedThing> ListedThings
        => [.. _listedEvents.Select(calendarEvent => new ListedThing(calendarEvent.Details.StartUtc, calendarEvent, null))
            .Concat(_listedDueTasks.Select(dueTask => new ListedThing(dueTask.DueDateUtc, null, dueTask)))
            .OrderBy(thing => thing.At)];

    /// <summary>One row of the list: an event or a deadline, and when it is, which is what orders them.</summary>
    private sealed record ListedThing(DateTimeOffset At, CalendarEventDto? Event, DueTaskDto? DueTask);

    /// <summary>
    /// Whether to offer the Google links at all - see GoogleIntegrationAccess for who qualifies and why.
    /// </summary>
    private bool _hasGoogleExtras;

    private string GoogleCalendarLinkFor(CalendarEventDto calendarEvent)
        => GoogleCalendarEventLink.ForEvent(
            calendarEvent.Details.Title, calendarEvent.Details.StartUtc, calendarEvent.Details.EndUtc,
            calendarEvent.Details.IsAllDay, calendarEvent.Details.Description,
            calendarEvent.Details.Location is { } location ? FormatLocation(location) : null,
            calendarEvent.Details.Recurrence);

    private string FormatLocation(EventLocationDto location)
        => string.IsNullOrWhiteSpace(location.Address)
            // Invariant culture, not the browser/thread's current culture: these are coordinates meant
            // to be pasted into a map, so they must always use a period as the decimal separator
            // rather than the comma pl-PL (and other cultures) format doubles with.
            ? $"{location.Latitude.ToString("F5", CultureInfo.InvariantCulture)}, {location.Longitude.ToString("F5", CultureInfo.InvariantCulture)}"
            : location.Address;

    private string FormatRecurrence(RecurrenceDto recurrence)
    {
        var frequencyLabel = recurrence.Frequency switch
        {
            "Daily" => T["daily"],
            "Weekly" => T["weekly"],
            "Monthly" => T["monthly"],
            _ => recurrence.Frequency
        };
        var intervalLabel = recurrence.IntervalCount > 1 ? $"{frequencyLabel} (every {recurrence.IntervalCount})" : frequencyLabel;
        return recurrence.UntilUtc is { } until ? $"{intervalLabel}, until {until.LocalDateTime:dd.MM.yyyy}" : intervalLabel;
    }

    private enum CalendarViewMode
    {
        Day,
        Month,
        Year
    }

    /// <summary>
    /// The calendar visualization's own state - which period is showing, at what zoom level, and whether
    /// the event list panel is open. Kept as one mutable object, distinct from the read-only _events data,
    /// since SwitchView/StepBackward/StepForward/GoToToday all read and update it together (see the
    /// "grouping variables" project convention).
    /// </summary>
    private sealed class CalendarViewState
    {
        public CalendarViewMode ViewMode { get; private set; } = CalendarViewMode.Month;
        public DateOnly ReferenceDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        /// <summary>
        /// Whether due-task dots are mixed in with event dots on the compact year view - each day cell
        /// there is tiny, so this lets the user opt back out if the combined dots feel too cluttered.
        /// </summary>
        public bool ShowDueTasksInYearView { get; set; } = true;

        /// <summary>
        /// Takes the culture rather than holding one: which period is showing is this object's business,
        /// what language it is written in is the page's. The year is invariant on purpose - a year is a
        /// number, and no culture should give it a thousands separator.
        /// </summary>
        public string PeriodLabel(CultureInfo displayCulture) => ViewMode switch
        {
            CalendarViewMode.Day => ReferenceDate.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", displayCulture),
            CalendarViewMode.Month => ReferenceDate.ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", displayCulture),
            CalendarViewMode.Year => ReferenceDate.Year.ToString(CultureInfo.InvariantCulture),
            _ => string.Empty
        };

        /// <summary>
        /// The stretch of time the lists beside the grid cover. A year in the year view, and the whole
        /// month otherwise - including the day view, where a single day's worth is usually too little to
        /// be worth a panel and the month around it is what somebody is actually planning against.
        /// </summary>
        public (DateOnly From, DateOnly ToExclusive) ListedPeriod()
        {
            if (ViewMode == CalendarViewMode.Year)
            {
                var yearStart = new DateOnly(ReferenceDate.Year, 1, 1);
                return (yearStart, yearStart.AddYears(1));
            }

            var monthStart = new DateOnly(ReferenceDate.Year, ReferenceDate.Month, 1);
            return (monthStart, monthStart.AddMonths(1));
        }

        public void SwitchView(CalendarViewMode viewMode) => ViewMode = viewMode;

        public void GoToToday() => ReferenceDate = DateOnly.FromDateTime(DateTime.Today);

        public void StepBackward() => ReferenceDate = Step(-1);

        public void StepForward() => ReferenceDate = Step(1);

        private DateOnly Step(int direction) => ViewMode switch
        {
            CalendarViewMode.Day => ReferenceDate.AddDays(direction),
            CalendarViewMode.Month => ReferenceDate.AddMonths(direction),
            CalendarViewMode.Year => ReferenceDate.AddYears(direction),
            _ => ReferenceDate
        };
    }
}
