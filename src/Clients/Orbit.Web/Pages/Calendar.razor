@page "/calendar"
@implements IDisposable
@attribute [Authorize]
@using System.Globalization
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Users
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Tasks
@using Orbit.Web.Services
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject TasksApiClient TasksApiClient
@inject PanelPreferences Panels
@inject CalendarListOrder ListOrder
@inject UsersApiClient UsersApiClient
@inject NavigationManager NavigationManager
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject IJSRuntime JSRuntime
@inject ILogger<Calendar> Logger
@inject NotificationFeedState NotificationFeedState
@inject Translations T

<PageTitle>@T["Orbit — Calendar"]</PageTitle>

<PageHeader>
    <LeadingAction>
        <button type="button" class="icon-btn page-add" title="@(T["Add event"])" aria-label="@(T["Add event"])"
                @onclick="GoToAddEvent">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
        </button>
    </LeadingAction>
    <Title>@T["Calendar"]</Title>
    <Actions>
        @* The order the list beside the grid comes in. Behind the menu rather than in a control across
           the top, the same as every other list in the app - it is something a reader sets once and
           then reads by. Stays open while they try one order and then another. *@
        <OverflowMenu StaysOpen="true">
            <span class="overflow-menu-heading">@T["Sort"]</span>
            @foreach (var sortOrder in Enum.GetValues<CalendarListSortOrder>())
            {
                <button type="button" class="avatar-dropdown-item @(sortOrder == ListOrder.SortOrder ? "chosen" : "")"
                        @onclick="() => SetSortOrderAsync(sortOrder)">
                    <span class="card-filter-mark">@(sortOrder == ListOrder.SortOrder ? "✓" : "")</span>
                    @DescribeSortOrder(sortOrder)
                </button>
            }

            @* What a calendar is read for is what is coming, so the list leaves out what is over: a task
               already ticked off, an event that has already ended. The grid beside it still draws them -
               a day with something in it should say so whether or not it has been - and this is how the
               list is asked for them too. *@
            @* Ticked and unpressable in the day and week views, which show everything whatever this
               says - see ShowsEverythingInThisView. A mark that read "off" while a finished appointment
               sat on the screen would be the control lying about what is in front of somebody; greyed
               with a reason on it says which it is. *@
            <span class="overflow-menu-heading">@T["Show"]</span>
            <button type="button" class="avatar-dropdown-item @(ShowsEverythingInThisView ? "chosen" : "")"
                    disabled="@IsAStretchToAccountFor"
                    title="@(IsAStretchToAccountFor ? T["A day and a week show everything that fell in them."] : null)"
                    @onclick="ToggleShowsEverythingAsync">
                <span class="card-filter-mark">@(ShowsEverythingInThisView ? "✓" : "")</span>
                @T["Everything, including what is over"]
            </button>
        </OverflowMenu>
    </Actions>
</PageHeader>

<div class="calendar-layout">
    <div class="calendar-event-list-panel">
        @* One list, whatever kind of thing is on it. Events and deadlines answer the same
           question - what is happening in this period - and two lists side by side made the
           reader merge them by eye, in a period where they interleave by definition. *@
        @if (_events is null || _dueTasks is null)
        {
            <p>@T["Loading…"]</p>
        }
        else if (ListedThings.Count == 0)
        {
            <p>@T["Nothing in this period."]</p>
        }
        else
        {
            <div class="item-card-list">
                @foreach (var thing in ListedThings)
                {
                    @if (thing.Event is { } calendarEvent)
                    {
                        @* An event a task list made is opened as that entry rather than as the event: the
                           list is where it is worked from, and the full event form is a different thing
                           from ticking a step off. The entry itself is not listed - see _listedDueTasks.

                           Struck through and greyed once that entry is ticked off (item-card-done), the
                           same mark a done deadline carries below, so the two read alike where "show
                           everything" puts them side by side. *@
                        <ItemCard Name="@calendarEvent.Details.Title"
                        OnNameSelected="() => OpenTheEvent(calendarEvent)"
                        OnBodySelected="() => OpenTheEvent(calendarEvent)"
                        AccentColour="@(string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? null : calendarEvent.Details.Color)"
                        ExtraClass="@(IsTickedOff(calendarEvent) ? "item-card-done" : null)"
                        HasUnseenAction="@HasNewsAbout(calendarEvent)"
                        IsCollapsed="@(!IsEventExpanded(calendarEvent.Id))"
                        OnCollapseToggled="@(HasDetails(calendarEvent.Details) ? EventCallback.Factory.Create(this, () => ToggleEventExpanded(calendarEvent.Id)) : default)">
                        <Tags>
                            @* Which kind of thing this is, now that both kinds share one list. *@
                            <span class="card-badge card-badge-event">@T["Event"]</span>
                            @* And which list it belongs to, where one made it. The entry used to carry
                               this and the event did not, so folding the two into one card lost it. *@
                            @if (TheEntryBehind(calendarEvent) is { } entry)
                            {
                                <span class="card-badge">@Written(entry.TaskListTitle)</span>
                            }
                            @if (calendarEvent.IsShared)
                            {
                                <span class="card-badge">@T.Format("Shared by {0}", calendarEvent.SharedByUserName)</span>
                            }
                        </Tags>
                        <Menu>
                        @* An event reached through a share is somebody else's, so there is nothing here
                           to duplicate: a copy would be an appointment in this reader's calendar that
                           its owner never put there - see DuplicateCalendarEventCommand. *@
                        <ObjectMenu EditLabel="@(calendarEvent.IsShared ? T["View"] : T["Edit"])"
                                    OnEdit="() => GoToEditEvent(calendarEvent.Id)"
                                    DuplicateLabel="@(calendarEvent.IsShared ? null : T["Duplicate"])"
                                    OnDuplicate="() => DuplicateEventAsync(calendarEvent)"
                                    DeleteLabel="@T["Delete"]" OnDelete="() => DeleteEventAsync(calendarEvent)" />
                        </Menu>
                        <Body>
                            @* When, first: it is the one thing every row on this list has, and the
                               reason somebody is reading the list at all. *@
                            <p class="event-when">@WhenItHappens(calendarEvent.Details)</p>
                            <div class="editor-item-details">
                        @if (calendarEvent.Details.Location is { } location)
                        {
                        <span>
                        <strong>@T["Location:"]</strong>
                        @* The address itself is the link, so the place is one click away rather than
                        something to copy out - see GoogleMapsLink. *@
                        @if (_hasGoogleExtras)
                        {
                        <a href="@GoogleMapsLink.ToPlace(location.Latitude, location.Longitude)" target="_blank" rel="noopener">@FormatLocation(location)</a>
                        <a class="google-link" href="@GoogleMapsLink.ToDirections(location.Latitude, location.Longitude)" target="_blank" rel="noopener">@T["Directions"]</a>
                        }
                        else
                        {
                        @FormatLocation(location)
                        }
                        </span>
                        }
                        @if (_hasGoogleExtras)
                        {
                        <span class="field-break"></span>
                        <a class="google-link" href="@GoogleCalendarLinkFor(calendarEvent)" target="_blank" rel="noopener">@T["Add to Google Calendar"]</a>
                        }
                        @if (calendarEvent.Details.Recurrence is { } recurrence)
                        {
                        <span><strong>@T["Repeats:"]</strong> @FormatRecurrence(recurrence)</span>
                        }
                        @if (calendarEvent.Details.Guests.Count > 0)
                        {
                        <span><strong>@T["Guests:"]</strong> @string.Join(", ", calendarEvent.Details.Guests.Select(GetGuestDisplayName))</span>
                        }
                        </div>
                        </Body>
                        </ItemCard>
                    }
                    else if (thing.DueTask is { } dueTask)
                    {
                        <ItemCard Name="@Written(dueTask.Description)"
                                  OnNameSelected="() => GoToDueTask(dueTask)"
                                  OnBodySelected="() => GoToDueTask(dueTask)"
                                  HasUnseenAction="@HasNewsAbout(dueTask)"
                                  ExtraClass="@(dueTask.IsCompleted ? "item-card-done" : null)">
                            @* The same two actions an event carries. A deadline is a thing on this list
                               like any other, and having to go and find the list it lives on to change
                               or drop it was the one row here that answered differently. *@
                            <Menu>
                                <OverflowMenu>
                                    <button type="button" class="avatar-dropdown-item" @onclick="() => GoToDueTask(dueTask)">@T["Edit"]</button>
                                    <button type="button" class="avatar-dropdown-item" @onclick="() => DeleteDueTaskAsync(dueTask)">@T["Delete"]</button>
                                </OverflowMenu>
                            </Menu>
                            <Tags>
                                <span class="card-badge card-badge-task">@T["Task"]</span>
                                <span class="card-badge">@Written(dueTask.TaskListTitle)</span>
                            </Tags>
                            <Body>
                                <span class="event-when">@WhenItIsDue(dueTask)</span>
                            </Body>
                        </ItemCard>
                    }
                }
            </div>
        }
    </div>

    <div class="calendar-visualization-panel">
        <div class="calendar-visualization-toolbar">
            <div class="calendar-visualization-toolbar-navigation">
                <button @onclick="GoToPreviousPeriod">‹</button>
                <button @onclick="GoToToday">@T["Today"]</button>
                <button @onclick="GoToNextPeriod">›</button>
                <h2 class="calendar-period-label">@_viewState.PeriodLabel(T.DisplayCulture)</h2>
            </div>
            <div class="calendar-view-switch">
                <button aria-pressed="@AriaPressed(CalendarViewMode.Day)" @onclick="() => SwitchView(CalendarViewMode.Day)">@T["Day"]</button>
                <button aria-pressed="@AriaPressed(CalendarViewMode.Week)" @onclick="() => SwitchView(CalendarViewMode.Week)">@T["Week"]</button>
                <button aria-pressed="@AriaPressed(CalendarViewMode.Month)" @onclick="() => SwitchView(CalendarViewMode.Month)">@T["Month"]</button>
                <button aria-pressed="@AriaPressed(CalendarViewMode.Year)" @onclick="() => SwitchView(CalendarViewMode.Year)">@T["Year"]</button>
            </div>
        </div>

        @switch (_viewState.ViewMode)
        {
            case CalendarViewMode.Day:
                <CalendarDayGrid Grid="CalendarGridBuilder.BuildDayGrid(_viewState.ReferenceDate, EventsOnTheGrid, DueTasksOnTheGrid)" OnEventSelected="OpenTheEvent" OnTaskSelected="GoToDueTask" TickedOffEventIds="TickedOffEventIds" />
                break;
            @* The month grid with one row in it, so a week reads as a row of a month rather than as a
               fourth thing to learn - see CalendarGridBuilder.BuildWeekGrid. *@
            case CalendarViewMode.Week:
                <CalendarMonthGrid Weeks="CalendarGridBuilder.BuildWeekGrid(_viewState.ReferenceDate, EventsOnTheGrid, DueTasksOnTheGrid)" OnDaySelected="GoToDay" TickedOffEventIds="TickedOffEventIds" IsRoomy="true" />
                break;
            case CalendarViewMode.Year:
                <CalendarYearGrid Months="CalendarGridBuilder.BuildYearGrid(_viewState.ReferenceDate.Year, EventsOnTheGrid, _viewState.ShowDueTasksInYearView ? DueTasksOnTheGrid : [])" OnDaySelected="GoToDay" TickedOffEventIds="TickedOffEventIds" />
                break;
            default:
                <CalendarMonthGrid Weeks="CalendarGridBuilder.BuildMonthGrid(_viewState.ReferenceDate, EventsOnTheGrid, DueTasksOnTheGrid)" OnDaySelected="GoToDay" TickedOffEventIds="TickedOffEventIds" />
                break;
        }
    </div>
</div>

@if (_viewState.ViewMode == CalendarViewMode.Year)
{
    <div class="calendar-year-view-options">
        <label>
            <input id="showDueTasksInYearView" type="checkbox" checked="@_viewState.ShowDueTasksInYearView" @onchange="ToggleShowDueTasksInYearView" />@T["Show tasks in year view"]</label>
    </div>
}

@code {
    /// <summary>
    /// Which view to open in, named the way the buttons above are - "day", "week", "month", "year".
    /// Anything else, including nothing, opens the month the page has always opened in.
    ///
    /// It exists so a page that has already narrowed something down can hand that over rather than
    /// making somebody narrow it again: the dashboard's summary of today is a count of today, and
    /// pressing it used to arrive at the month with today somewhere in it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    /// <summary>
    /// The day to open on, defaulting to today. Read alongside <see cref="View"/> - "the week of the
    /// 3rd" needs both, and either alone is half a request.
    /// </summary>
    [SupplyParameterFromQuery(Name = "on")] public DateOnly? On { get; set; }

    /// <summary>
    /// What the query string last asked for, so it is obeyed once rather than on every render. Without
    /// it, pressing Month on a page reached as ?view=day would put the view straight back to day: the
    /// parameters are still what they were, and nothing distinguishes "asked again" from "still there".
    /// </summary>
    private (string? View, DateOnly? On)? _openedAs;

    /// <summary>Event ids whose location/repeat/guest lines are unfolded. Independent per event here: unlike an editor, this is for reading, and comparing two days' events at once is the point.</summary>
    private readonly HashSet<Guid> _expandedEventIds = [];

    private bool IsEventExpanded(Guid eventId) => _expandedEventIds.Contains(eventId);

    private void ToggleEventExpanded(Guid eventId)
    {
        if (!_expandedEventIds.Add(eventId))
        {
            _expandedEventIds.Remove(eventId);
        }
    }

    /// <summary>Whether an event has anything worth unfolding - no toggle is drawn when it hasn't.</summary>
    private static bool HasDetails(CalendarEventDetailsDto details)
        => details.Location is not null || details.Recurrence is not null || details.Guests.Count > 0;

    private IReadOnlyList<CalendarEventDto>? _events;
    private IReadOnlyList<DueTaskDto>? _dueTasks;

    /// <summary>
    /// Every list the due tasks came from, kept from that same read - it is what says which list a
    /// pressed deadline belongs to, and which entry an appointment was made by (see TheEntryBehind).
    /// </summary>
    private IReadOnlyList<TaskDto> TaskLists
    {
        get => _taskLists;
        set
        {
            _taskLists = value;
            // Indexed on the way in rather than searched on the way out: TheEntryBehind is asked once
            // per event while the list is filtered and again while each card is drawn, and walking every
            // entry of every list each time is a scan per row of a page that redraws on every tick.
            _entriesByEventId = value
                .SelectMany(taskList => taskList.Items.Select(item => (taskList, item)))
                .Where(pair => pair.item.LinkedCalendarEventId is not null)
                .GroupBy(pair => pair.item.LinkedCalendarEventId!.Value)
                .ToDictionary(byEvent => byEvent.Key, byEvent => byEvent.First());
        }
    }

    private IReadOnlyList<TaskDto> _taskLists = [];

    /// <summary>The entry each event was made by, where a task list made it - see TheEntryBehind.</summary>
    private Dictionary<Guid, (TaskDto TaskList, TaskItemDto Item)> _entriesByEventId = [];
    private IReadOnlyList<ContactDto> _contacts = [];
    private readonly CalendarViewState _viewState = new();

    /// <summary>
    /// The events the list beside the grid shows: the ones touching the period on screen, soonest first.
    /// Listing the whole calendar meant scrolling past last spring to find next week.
    /// </summary>
    private IReadOnlyList<CalendarEventDto> _listedEvents
    {
        get
        {
            var (from, toExclusive) = _viewState.ListedPeriod();
            // An event that starts before the period and runs into it belongs to it as much as one that
            // starts inside it.
            var nowUtc = DateTimeOffset.UtcNow;
            return [.. (_events ?? [])
                .Where(calendarEvent => DateOnly.FromDateTime(calendarEvent.Details.StartUtc.LocalDateTime) < toExclusive
                    && DateOnly.FromDateTime(calendarEvent.Details.EndUtc.LocalDateTime) >= from)
                // An event that has already ended is over. Left out unless the reader asked for
                // everything - see CalendarListOrder.ShowsEverything.
                .Where(calendarEvent => ShowsEverythingInThisView || calendarEvent.Details.EndUtc >= nowUtc)
                // And so is one whose entry has been ticked off, whenever it happens to fall. A task
                // list's appointment is a thing to do as much as a thing to be at, and one already done
                // was staying on the list for as long as its date was still ahead - which is most of the
                // time somebody would tick it off early. The deadlines beside it have always been
                // filtered this way; only the events had nothing asking the question, because an event
                // of its own has nothing to tick. See IsTickedOff.
                .Where(calendarEvent => ShowsEverythingInThisView || !IsTickedOff(calendarEvent))
                .OrderBy(calendarEvent => calendarEvent.Details.StartUtc)];
        }
    }

    /// <summary>The due tasks in the same period, by when they are due.</summary>
    private IReadOnlyList<DueTaskDto> _listedDueTasks
    {
        get
        {
            var (from, toExclusive) = _viewState.ListedPeriod();
            // An entry tied to an event is that event, so the list shows one of them rather than the
            // same appointment twice, one card under the other. The grids have always done this - see
            // CalendarGridBuilder.DueTasksOnDate - and the list beside them had not.
            var listedEventIds = _listedEvents.Select(calendarEvent => calendarEvent.Id).ToHashSet();
            return [.. (_dueTasks ?? [])
                .Where(dueTask => DateOnly.FromDateTime(dueTask.DueDateUtc.LocalDateTime) is var due
                    && due >= from && due < toExclusive)
                .Where(dueTask => dueTask.LinkedCalendarEventId is not { } eventId || !listedEventIds.Contains(eventId))
                // Done is done. A deadline that has passed and is still not ticked off stays: it is the
                // one thing on this page that most needs saying, and hiding it would hide the work.
                .Where(dueTask => ShowsEverythingInThisView || !dueTask.IsCompleted)
                .OrderBy(dueTask => dueTask.DueDateUtc)];
        }
    }

    /// <summary>
    /// Login of every guest not found among <see cref="_contacts"/>, resolved once via UsersApiClient
    /// and cached here instead of being looked up again on every render - see
    /// ResolveMissingGuestDisplayNamesAsync.
    /// </summary>
    private readonly Dictionary<Guid, string> _resolvedGuestUserNames = [];

    /// <summary>
    /// Obeys the query string, once per thing it asks for - see <see cref="_openedAs"/>. Before the
    /// first render, so the page draws the view it was asked for rather than the month and then the
    /// view a moment later.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_openedAs == (View, On))
        {
            return;
        }

        _openedAs = (View, On);
        if (On is { } date)
        {
            _viewState.ReferenceDate = date;
        }

        if (ViewModeNamed(View) is { } viewMode)
        {
            _viewState.SwitchView(viewMode);
        }
    }

    /// <summary>
    /// The view one of the query string's names asks for, or null for a name this version of Orbit does
    /// not know - which opens the month, the way a link with no view at all does. A link is a thing
    /// somebody may have kept; one naming a view that has since gone should still open the calendar.
    /// </summary>
    private static CalendarViewMode? ViewModeNamed(string? name)
        => Enum.TryParse<CalendarViewMode>(name, ignoreCase: true, out var viewMode) ? viewMode : null;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Calendar page opened, loading events");
        // MainLayout owns the polling; this only listens. An appointment somebody has just shared is
        // one this page has never read, so hearing about it has to mean reading again - see
        // OnNotificationsChanged.
        NotificationFeedState.Changed += OnNotificationsChanged;
        // Before the first render, so the panels come back open rather than opening a moment later, and
        // the list is in the order it was left in rather than jumping into it.
        await Panels.InitializeAsync();
        await ListOrder.InitializeAsync();
        try
        {
            _events = await CalendarApiClient.GetCalendarEventsAsync();
            _contacts = await ChatApiClient.GetContactsAsync();

            // Best-effort: the page works without the Google links, so neither call is allowed to stop
            // it loading.
            _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
            _dueTasks = await LoadDueTasksAsync();
            await ResolveMissingGuestDisplayNamesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {EventCount} calendar events", _events.Count);
        Logger.LogInformation("Loaded {DueTaskCount} tasks with a due date", _dueTasks.Count);
    }

    /// <summary>
    /// Flattens every task list's items down to just the ones with a due date, so they can be placed onto
    /// the calendar grids and event list alongside CalendarEventDto entries - see CalendarGridBuilder.DueTaskDto.
    /// </summary>
    private async Task<IReadOnlyList<DueTaskDto>> LoadDueTasksAsync()
    {
        TaskLists = await TasksApiClient.GetTaskListsAsync();
        return _taskLists
            .SelectMany(taskList => taskList.Items.Select(item => (taskList, item)))
            .Where(pair => pair.item.DueDateUtc is not null)
            .Select(pair => new DueTaskDto(
                pair.taskList.Id, pair.item.Id, pair.taskList.Title, pair.item.Description,
                // An entry on a list its owner has closed is done, whatever its own tick says: marking
                // a list finished with work still on it is a way of saying "no more of this" (see
                // TaskList.IsMarkedCompleted), and the calendar would otherwise keep the deadlines it
                // was closed to be rid of.
                // Finished with either way: a deadline somebody gave up on has stopped being owed.
                pair.item.DueDateUtc!.Value, pair.item.IsCompleted || pair.item.IsFailed || pair.taskList.IsCompleted,
                pair.item.LinkedCalendarEventId))
            .OrderBy(dueTask => dueTask.DueDateUtc)
            .ToList();
    }

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    /// <summary>
    /// Looks up guestUserId's login for display, preferring the already-loaded contact list and falling
    /// back to the id itself if the user can no longer be resolved (e.g. a deleted account).
    /// </summary>
    private string GetGuestDisplayName(Guid guestUserId)
    {
        var contact = _contacts.FirstOrDefault(candidate => candidate.UserId == guestUserId);
        if (contact is not null)
        {
            return contact.UserName;
        }

        return _resolvedGuestUserNames.TryGetValue(guestUserId, out var userName) ? userName : guestUserId.ToString();
    }

    /// <summary>
    /// A guest might not be among the current user's contacts (e.g. they were removed as a contact
    /// after being invited) - this resolves those remaining guests' logins directly via UsersApiClient
    /// so the guest list never falls back to showing a raw id.
    /// </summary>
    private async Task ResolveMissingGuestDisplayNamesAsync()
    {
        var missingGuestUserIds = (_events ?? [])
            .SelectMany(calendarEvent => calendarEvent.Details.Guests)
            .Where(guestUserId => _contacts.All(contact => contact.UserId != guestUserId))
            .Distinct();

        foreach (var guestUserId in missingGuestUserIds)
        {
            var user = await UsersApiClient.GetUserAsync(guestUserId);
            if (user is not null)
            {
                _resolvedGuestUserNames[guestUserId] = user.UserName;
            }
        }
    }

    private void GoToAddEvent()
    {
        Logger.LogInformation("User clicked 'Add event'");
        NavigationManager.NavigateTo("/calendar/new");
    }

    /// <summary>
    /// The form, which is a named press - pressing the card itself lands on what the appointment is,
    /// see CalendarEventDestination.
    /// </summary>
    private void GoToEditEvent(Guid eventId)
    {
        Logger.LogInformation("User clicked 'Edit' for calendar event {EventId}", eventId);
        NavigationManager.NavigateTo(ReturnTo.Link($"/calendar/{eventId}/edit", "/calendar"));
    }

    /// <summary>
    /// Whether the bell is talking about this appointment. Two addresses, because an appointment a task
    /// list raised is opened as that entry while the reminder for it is the event's and says so (see
    /// EventReminderPushContent) - reading only one of them left exactly those cards unmarked. The same
    /// pair the dashboard's Upcoming card asks about the same things.
    /// </summary>
    private bool HasNewsAbout(CalendarEventDto calendarEvent)
        => NotificationFeedState.HasNewsAbout($"/calendar/{calendarEvent.Id}")
            || (TheEntryBehind(calendarEvent) is { } entry && HasNewsAbout(entry));

    /// <summary>
    /// The same question for a deadline, which is a task entry - so it is asked at the entry's own page
    /// and at the list it is on, the way a notification about either one points.
    /// </summary>
    private bool HasNewsAbout(DueTaskDto dueTask)
        => NotificationFeedState.HasNewsAbout($"/tasks/{dueTask.TaskListId}/items/{dueTask.TaskItemId}")
            || NotificationFeedState.HasNewsAbout($"/tasks/{dueTask.TaskListId}");

    /// <summary>
    /// The task entry this event is, when a task list made it. Read from the lists themselves rather
    /// than from the due tasks: an appointment on a list carries no due date of its own - the event says
    /// when it is - so it is not among them at all.
    /// </summary>
    private DueTaskDto? TheEntryBehind(CalendarEventDto calendarEvent)
        => _entriesByEventId.TryGetValue(calendarEvent.Id, out var pair)
            ? new DueTaskDto(
                pair.TaskList.Id, pair.Item.Id, pair.TaskList.Title, pair.Item.Description,
                pair.Item.DueDateUtc ?? calendarEvent.Details.StartUtc, pair.Item.IsCompleted || pair.Item.IsFailed,
                pair.Item.LinkedCalendarEventId)
            : null;

    /// <summary>
    /// What the grids draw: everything on the calendar, less what has been done. An appointment whose
    /// entry on a task list is ticked off, and a deadline that is ticked off, both leave - the same
    /// answer the list beside them gives, and the same menu brings them back.
    ///
    /// **What is merely *over* stays.** That is the one place this parts company with the list, and it
    /// is deliberate: the list answers "what is coming", so an event that has ended is no longer its
    /// subject, while a grid is a picture of the period - a month drawn with every past day empty would
    /// be a month that had not happened. Done is a different fact from past, and only the first of them
    /// is somebody saying "I am finished with this".
    /// </summary>
    /// <summary>
    /// Whether what is over is drawn alongside what is still to come. Normally the reader's own choice
    /// (CalendarListOrder.ShowsEverything) - a calendar is mostly read forwards, so a finished
    /// appointment and a ticked-off deadline are out of the way by default.
    ///
    /// The day and the week are the exception, whatever that choice says. Opening one particular day -
    /// or one particular week - is asking what happened in it, and half an answer to that is worse than
    /// none: a day showing three of the five things on it looks like a day with three things on it,
    /// with nothing saying otherwise, and a week does the same over seven columns.
    ///
    /// The month and the year are not the same question. They are read to find something rather than to
    /// account for a stretch, and a month drawn full of struck-through appointments is exactly what the
    /// default is keeping out of the way.
    /// </summary>
    private bool ShowsEverythingInThisView
        => ListOrder.ShowsEverything || IsAStretchToAccountFor;

    /// <summary>A view small enough that what it leaves out would not be noticed - see ShowsEverythingInThisView.</summary>
    private bool IsAStretchToAccountFor
        => _viewState.ViewMode is CalendarViewMode.Day or CalendarViewMode.Week;

    private IReadOnlyList<CalendarEventDto> EventsOnTheGrid
        => ShowsEverythingInThisView
            ? _events ?? []
            : [.. (_events ?? []).Where(calendarEvent => !IsTickedOff(calendarEvent))];

    /// <inheritdoc cref="EventsOnTheGrid"/>
    private IReadOnlyList<DueTaskDto> DueTasksOnTheGrid
        => ShowsEverythingInThisView
            ? _dueTasks ?? []
            : [.. (_dueTasks ?? []).Where(dueTask => !dueTask.IsCompleted)];

    /// <summary>
    /// The events the grids draw as done. Only reached when the reader has asked for everything: by
    /// default such an appointment is not on the grid at all (see EventsOnTheGrid), and this is what it
    /// looks like when it comes back - struck through and greyed, the mark a finished deadline has
    /// always carried there.
    /// </summary>
    private IReadOnlySet<Guid> TickedOffEventIds
        => _entriesByEventId
            .Where(pair => pair.Value.Item.IsCompleted || pair.Value.Item.IsFailed || pair.Value.TaskList.IsCompleted)
            .Select(pair => pair.Key)
            .ToHashSet();

    /// <summary>
    /// Whether the entry that made this event has been ticked off. An event of its own has nothing to
    /// tick, so it is never done - it is only ever over, which is a different question and a different
    /// filter. See the list below.
    /// </summary>
    private bool IsTickedOff(CalendarEventDto calendarEvent)
        => _entriesByEventId.TryGetValue(calendarEvent.Id, out var pair)
            && (pair.Item.IsCompleted || pair.TaskList.IsCompleted);

    /// <summary>
    /// Where an event leads from this list: to the entry that made it where there is one, and to the
    /// event's own form otherwise.
    /// </summary>
    private void OpenTheEvent(CalendarEventDto calendarEvent) => OpenTheEvent(calendarEvent.Id);

    /// <summary>
    /// Wherever an event is pressed on this page - a card in the list, a chip in the day grid - it
    /// leads to the same place, which is the entry behind it where a task list made it. See
    /// CalendarEventDestination, which the dashboard reads too.
    /// </summary>
    private void OpenTheEvent(Guid calendarEventId)
    {
        // "Come back here" only where the press leads out of the calendar. An appointment a task list
        // made opens as its entry, and the edit that follows used to end on /tasks (see ReturnTo); an
        // event of its own opens the calendar's own form, which ends here anyway - saying so again
        // would be an address carrying a parameter nothing reads.
        var destination = CalendarEventDestination.For(calendarEventId, _taskLists);
        if (CalendarEventDestination.RaisedBy(calendarEventId, _taskLists) is not null)
        {
            destination = ReturnTo.Link(destination, "/calendar");
        }

        Logger.LogInformation(
            "User opened calendar event {EventId} from the calendar, going to {Destination}", calendarEventId, destination);
        NavigationManager.NavigateTo(destination);
    }

    /// <summary>
    /// What pressing a deadline opens: the entry itself, whatever kind of entry it is. It used to fork
    /// on whether the entry had somewhere to be - one with a place opened as itself, one without opened
    /// as the *list* it sits on - so the same press on this one list meant two different objects, and
    /// which one you got depended on a field nothing on the card mentions. The entry's own page answers
    /// for both: when, where, what it is about, who is coming, and whether it is already done. Ticking
    /// it off is still done on the list, which that page's way out leads to.
    /// </summary>
    private void GoToDueTask(DueTaskDto dueTask)
    {
        Logger.LogInformation(
            "User opened the summary of task item {TaskItemId} from the calendar", dueTask.TaskItemId);
        // Saying where this came from, so finishing the edit comes back to the calendar rather
        // than ending on /tasks - see ReturnTo.
        NavigationManager.NavigateTo(ReturnTo.Link(
            $"/tasks/{dueTask.TaskListId}/items/{dueTask.TaskItemId}", "/calendar"));
    }

    /// <summary>
    /// Removes one deadline from the list it lives on. There is no endpoint for a single entry - a list
    /// is saved whole - so this sends the list back without it, carrying every other entry through
    /// TaskItemRequest.From so that nothing else on it is quietly changed by the trip.
    /// </summary>
    private async Task DeleteDueTaskAsync(DueTaskDto dueTask)
    {
        Logger.LogInformation("User clicked 'Delete' for task item {TaskItemId} from the calendar", dueTask.TaskItemId);
        if (_taskLists.FirstOrDefault(list => list.Id == dueTask.TaskListId) is not { } taskList)
        {
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", T.Format("Delete \"{0}\"?", dueTask.Description)))
        {
            return;
        }

        var items = taskList.Items
            .Where(item => item.Id != dueTask.TaskItemId)
            .Select(TaskItemRequest.From)
            .ToList();

        try
        {
            await TasksApiClient.UpdateTaskListAsync(
                taskList.Id, new UpdateTaskRequest(taskList.Title, items, taskList.IsGroup, taskList.IsPrivate));
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete task item {TaskItemId}", dueTask.TaskItemId);
            return;
        }

        // Dropped from what is already loaded rather than fetched again, the way deleting an event
        // does: nothing else about the period changed, and a reload here would cost a round trip to
        // learn what this method already knows.
        TaskLists = _taskLists
            .Select(list => list.Id == taskList.Id
                ? list with { Items = [.. list.Items.Where(item => item.Id != dueTask.TaskItemId)] }
                : list)
            .ToList();
        _dueTasks = _dueTasks?.Where(due => due.TaskItemId != dueTask.TaskItemId).ToList();
    }

    /// <summary>
    /// A second appointment saying the same thing, named for the one it came from and with nobody
    /// invited - see DuplicateCalendarEventCommandHandler for why the guests are left behind. The whole
    /// calendar is read again afterwards: the copy has to land in the grid as well as in the list, and
    /// where it lands is not this page's to work out.
    /// </summary>
    private async Task DuplicateEventAsync(CalendarEventDto calendarEvent)
    {
        Logger.LogInformation("User clicked 'Duplicate' for calendar event {EventId}", calendarEvent.Id);
        try
        {
            await CalendarApiClient.DuplicateCalendarEventAsync(
                calendarEvent.Id, T.Format("{0} (copy)", calendarEvent.Details.Title));
            _events = await CalendarApiClient.GetCalendarEventsAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to duplicate calendar event {EventId}", calendarEvent.Id);
        }
    }

    private async Task DeleteEventAsync(CalendarEventDto calendarEvent)
    {
        Logger.LogInformation("User clicked 'Delete' for calendar event {EventId}", calendarEvent.Id);
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm", T.Format("Delete event \"{0}\"?", calendarEvent.Details.Title));
        if (!confirmed)
        {
            return;
        }

        try
        {
            await CalendarApiClient.DeleteCalendarEventAsync(calendarEvent.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete calendar event {EventId}", calendarEvent.Id);
            return;
        }

        _events = _events!.Where(existingEvent => existingEvent.Id != calendarEvent.Id).ToList();
        Logger.LogInformation("Calendar event {EventId} deleted", calendarEvent.Id);
    }



    private void ToggleShowDueTasksInYearView()
    {
        _viewState.ShowDueTasksInYearView = !_viewState.ShowDueTasksInYearView;
        Logger.LogInformation("User set 'Show tasks in year view' to {ShowDueTasksInYearView}", _viewState.ShowDueTasksInYearView);
    }

    private void SwitchView(CalendarViewMode viewMode)
    {
        Logger.LogInformation("User switched the calendar visualization to {ViewMode} view", viewMode);
        _viewState.SwitchView(viewMode);
    }

    private void GoToPreviousPeriod() => _viewState.StepBackward();

    private void GoToNextPeriod() => _viewState.StepForward();

    private void GoToToday() => _viewState.GoToToday();

    /// <summary>
    /// aria-pressed needs a lowercase "true"/"false" string - Blazor's bool-attribute shorthand (which
    /// would render "True"/"False") only applies to recognized HTML boolean attributes like disabled,
    /// not to arbitrary ARIA ones.
    /// </summary>
    private string AriaPressed(CalendarViewMode viewMode) => AriaBool(_viewState.ViewMode == viewMode);

    /// <summary>aria-* boolean attributes need a lowercase "true"/"false" string - see AriaPressed's own comment above.</summary>
    private static string AriaBool(bool value) => value.ToString(CultureInfo.InvariantCulture).ToLowerInvariant();

    /// <summary>Jumps the visualization into Day view for date - used when a day is clicked in the month or year grid.</summary>
    private void GoToDay(DateOnly date)
    {
        _viewState.ReferenceDate = date;
        _viewState.SwitchView(CalendarViewMode.Day);
    }

    /// <summary>
    /// When an event happens, said the shortest way that is still unambiguous. Something starting and
    /// ending on one day - which is nearly everything - says its date once and then the two times:
    /// "01.09.2026 19:30 – 20:30". Printing the date twice for a one-hour appointment is most of the
    /// line spent saying the same thing again.
    /// </summary>
    /// <summary>The one wording, shared with the entry's own page - see EventWhen.</summary>
    private string WhenItHappens(CalendarEventDetailsDto details) => EventWhen.Reads(details, T);

    /// <summary>When a deadline falls. One instant, so there is no range to shorten.</summary>
    private static string WhenItIsDue(DueTaskDto dueTask)
        => dueTask.DueDateUtc.LocalDateTime.ToString("dd.MM.yyyy HH:mm");

    /// <summary>
    /// Everything in this period, both kinds together and in the order they happen. Two lists made the
    /// reader interleave them by eye, which is the one thing a calendar is meant to have done already.
    /// </summary>
    private IReadOnlyList<ListedThing> ListedThings
        => [.. InOrder(
            _listedEvents
                .Select(calendarEvent => new ListedThing(
                    calendarEvent.Details.StartUtc, calendarEvent.Details.Title, calendarEvent, null))
                .Concat(_listedDueTasks.Select(dueTask => new ListedThing(
                    dueTask.DueDateUtc, Written(dueTask.Description), null, dueTask))))];

    /// <summary>
    /// Whichever order the reader chose. When is the fallback within the other two as well: two things
    /// that sort the same by kind or by name are still most usefully read soonest first.
    /// </summary>
    private IEnumerable<ListedThing> InOrder(IEnumerable<ListedThing> things) => ListOrder.SortOrder switch
    {
        CalendarListSortOrder.Type => things
            .OrderBy(thing => thing.Event is null)
            .ThenBy(thing => thing.At),
        CalendarListSortOrder.Alphabetical => things
            .OrderBy(thing => thing.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(thing => thing.At),
        _ => things.OrderBy(thing => thing.At)
    };

    private string DescribeSortOrder(CalendarListSortOrder sortOrder) => sortOrder switch
    {
        CalendarListSortOrder.Type => T["By type"],
        CalendarListSortOrder.Alphabetical => T["Alphabetical"],
        _ => T["By when"]
    };

    private Task ToggleShowsEverythingAsync() => ListOrder.ShowEverythingAsync(!ListOrder.ShowsEverything);

    private async Task SetSortOrderAsync(CalendarListSortOrder sortOrder)
    {
        Logger.LogInformation("User sorted the calendar list by {SortOrder}", sortOrder);
        await ListOrder.SetSortOrderAsync(sortOrder);
    }

    /// <summary>One row of the list: an event or a deadline, when it is, and what it is called.</summary>
    private sealed record ListedThing(DateTimeOffset At, string Name, CalendarEventDto? Event, DueTaskDto? DueTask);

    /// <summary>
    /// Whether to offer the Google links at all - see GoogleIntegrationAccess for who qualifies and why.
    /// </summary>
    private bool _hasGoogleExtras;

    private string GoogleCalendarLinkFor(CalendarEventDto calendarEvent)
    {
        var details = calendarEvent.Details;
        return GoogleCalendarEventLink.ForEvent(new GoogleCalendarEvent(details.Title, details.StartUtc, details.EndUtc)
        {
            IsAllDay = details.IsAllDay,
            Description = details.Description,
            Location = details.Location is { } location ? FormatLocation(location) : null,
            Recurrence = details.Recurrence,
            TaskListTitle = TheEntryBehind(calendarEvent) is { } entry ? Written(entry.TaskListTitle) : null,
            GuestEmailAddresses = GoogleGuestAddresses(details.Guests),
            ReminderMinutesBeforeStart = details.ReminderMinutesBeforeStart,
            NotifyAtStart = details.NotifyAtStart
        });
    }

    /// <summary>
    /// The guests Google can actually invite. An address Google has not verified is one it cannot match
    /// to an account, so the invitation would go nowhere - see ContactDto.HasGoogleVerifiedEmail.
    /// </summary>
    private IReadOnlyList<string> GoogleGuestAddresses(IReadOnlyList<Guid> guests)
        => [.. _contacts
            .Where(contact => contact.HasGoogleVerifiedEmail && guests.Contains(contact.UserId))
            .Select(contact => contact.Email)];

    private string FormatLocation(EventLocationDto location)
        => string.IsNullOrWhiteSpace(location.Address)
            // Invariant culture, not the browser/thread's current culture: these are coordinates meant
            // to be pasted into a map, so they must always use a period as the decimal separator
            // rather than the comma pl-PL (and other cultures) format doubles with.
            ? $"{location.Latitude.ToString("F5", CultureInfo.InvariantCulture)}, {location.Longitude.ToString("F5", CultureInfo.InvariantCulture)}"
            : location.Address;

    private string FormatRecurrence(RecurrenceDto recurrence)
    {
        var frequencyLabel = recurrence.Frequency switch
        {
            "Daily" => T["daily"],
            "Weekly" => T["weekly"],
            "Monthly" => T["monthly"],
            _ => recurrence.Frequency
        };
        var intervalLabel = recurrence.IntervalCount > 1 ? $"{frequencyLabel} (every {recurrence.IntervalCount})" : frequencyLabel;
        return recurrence.UntilUtc is { } until ? $"{intervalLabel}, until {until.LocalDateTime:dd.MM.yyyy}" : intervalLabel;
    }

    private enum CalendarViewMode
    {
        Day,
        Week,
        Month,
        Year
    }

    /// <summary>
    /// The calendar visualization's own state - which period is showing, at what zoom level, and whether
    /// the event list panel is open. Kept as one mutable object, distinct from the read-only _events data,
    /// since SwitchView/StepBackward/StepForward/GoToToday all read and update it together (see the
    /// "grouping variables" project convention).
    /// </summary>
    private sealed class CalendarViewState
    {
        public CalendarViewMode ViewMode { get; private set; } = CalendarViewMode.Month;
        public DateOnly ReferenceDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        /// <summary>
        /// Whether due-task dots are mixed in with event dots on the compact year view - each day cell
        /// there is tiny, so this lets the user opt back out if the combined dots feel too cluttered.
        /// </summary>
        public bool ShowDueTasksInYearView { get; set; } = true;

        /// <summary>
        /// Takes the culture rather than holding one: which period is showing is this object's business,
        /// what language it is written in is the page's. The year is invariant on purpose - a year is a
        /// number, and no culture should give it a thousands separator.
        /// </summary>
        public string PeriodLabel(CultureInfo displayCulture) => ViewMode switch
        {
            CalendarViewMode.Day => ReferenceDate.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", displayCulture),
            CalendarViewMode.Week => WeekLabel(displayCulture),
            CalendarViewMode.Month => ReferenceDate.ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", displayCulture),
            CalendarViewMode.Year => ReferenceDate.Year.ToString(CultureInfo.InvariantCulture),
            _ => string.Empty
        };

        /// <summary>
        /// Both ends of the week, with the month named once when both ends share it - "8 - 14 September
        /// 2026" rather than "8 September 2026 - 14 September 2026", which is the same fact written
        /// twice. A week straddling a month or a year says both, because then they differ.
        /// </summary>
        private string WeekLabel(CultureInfo displayCulture)
        {
            var start = CalendarGridBuilder.StartOfWeek(ReferenceDate);
            var end = start.AddDays(6);
            var startFormat = start.Year != end.Year ? "d MMMM yyyy" : start.Month != end.Month ? "d MMMM" : "d";
            return $"{start.ToDateTime(TimeOnly.MinValue).ToString(startFormat, displayCulture)} - "
                + $"{end.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", displayCulture)}";
        }

        /// <summary>
        /// The stretch of time the lists beside the grid cover: whatever the grid itself is showing.
        ///
        /// The day view used to list the whole month around the day instead, on the grounds that one
        /// day's worth is too little to be worth a panel. It is not, now that a day shows everything
        /// that fell on it (see ShowsEverythingInThisView): somebody who opened a particular day asked
        /// about that day, and the month around it buries the answer in four weeks of other days.
        /// </summary>
        public (DateOnly From, DateOnly ToExclusive) ListedPeriod()
        {
            if (ViewMode == CalendarViewMode.Year)
            {
                var yearStart = new DateOnly(ReferenceDate.Year, 1, 1);
                return (yearStart, yearStart.AddYears(1));
            }

            if (ViewMode == CalendarViewMode.Day)
            {
                return (ReferenceDate, ReferenceDate.AddDays(1));
            }

            if (ViewMode == CalendarViewMode.Week)
            {
                var weekStart = CalendarGridBuilder.StartOfWeek(ReferenceDate);
                return (weekStart, weekStart.AddDays(7));
            }

            var monthStart = new DateOnly(ReferenceDate.Year, ReferenceDate.Month, 1);
            return (monthStart, monthStart.AddMonths(1));
        }

        public void SwitchView(CalendarViewMode viewMode) => ViewMode = viewMode;

        public void GoToToday() => ReferenceDate = DateOnly.FromDateTime(DateTime.Today);

        public void StepBackward() => ReferenceDate = Step(-1);

        public void StepForward() => ReferenceDate = Step(1);

        private DateOnly Step(int direction) => ViewMode switch
        {
            CalendarViewMode.Day => ReferenceDate.AddDays(direction),
            CalendarViewMode.Week => ReferenceDate.AddDays(7 * direction),
            CalendarViewMode.Month => ReferenceDate.AddMonths(direction),
            CalendarViewMode.Year => ReferenceDate.AddYears(direction),
            _ => ReferenceDate
        };
    }
    /// <summary>
    /// Something reached the bell, so what this page draws is read again - the events and the deadlines
    /// both, since either can be the thing that was shared. Redrawing alone would not do: an appointment
    /// somebody has just shared is one this page does not hold, and a share that only appears on the
    /// next reload is a share that looks like it did not arrive.
    ///
    /// A read per notification is affordable because a notification is rare - one arrives when somebody
    /// does something, not on a timer.
    /// </summary>
    private void OnNotificationsChanged()
        => InvokeAsync(async () =>
        {
            try
            {
                _events = await CalendarApiClient.GetCalendarEventsAsync();
                _dueTasks = await LoadDueTasksAsync();
            }
            catch (HttpRequestException exception)
            {
                // Already drawn, and still correct about everything it knew a moment ago. Nobody asked
                // for this read, so nothing is said about its failing.
                Logger.LogWarning(exception, "Couldn't re-read the calendar after a notification");
            }

            StateHasChanged();
        });

    public void Dispose() => NotificationFeedState.Changed -= OnNotificationsChanged;

}
