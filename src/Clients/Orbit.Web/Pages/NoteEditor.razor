    };

    /// <summary>
    /// Sets the style and closes the list. Closed because a style is chosen once and then written in -
    /// unlike the tick box, whose button is a switch that stays on while a checklist is being typed.
    /// </summary>
    private async Task SetStyleAsync(NoteLineStyle style)
