@page "/notes/new"
@* Where a note is met, full stop. It used to be one press further in than the note itself, the way a
   task list's editor is, and the note's own page (NoteSummary.razor) was what opening one landed on:
   its lines as they were, with the checklist ones tickable, and "Edit" a named press from there.

   That page is gone - asked for on 2026-09-20. A note is writing, and every press on one was a press
   towards writing in it: the reading rung answered a question nobody was asking and put a press
   between the reader and the one thing the page is for. The surface here draws the same lines with the
   same real tick boxes, so nothing that could be done there is lost. Both addresses land here, because
   the note's own address is the one every notification, share and dashboard row already carries. *@
@page "/notes/{Id:guid}"
@page "/notes/{Id:guid}/edit"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Notes
@using Orbit.Core.Abstractions
@using Orbit.Core.Folders
@using Orbit.Core.Notes
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject NotePicturesApiClient NotePicturesApiClient
@inject NotePictureSource NotePictureSource
@inject PrivateContentSealer PrivateContentSealer
@inject FolderState Folders
@inject ChatApiClient ChatApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject NavigationTrail NavigationTrail
@inject NoteDrafts Drafts
@inject IJSRuntime JSRuntime
@inject ILogger<NoteEditor> Logger
@inject Clipboard Clipboard
@inject Translations T

<PageTitle>@(IsNewNote ? T["New note"] : T["Edit note"])</PageTitle>

@* Save and Cancel at the top beside the name rather than at the foot of the form. A note is written
   from the top down and the form has no fixed height, so the buttons used to be wherever the writing
   happened to end - which on a long note is off the screen. Icons, because two words there would
   compete with the one thing the page is called. *@
@* Three columns on a wide screen, not two: the notes in this folder on the far left, then the note
   itself with its own pair - the writing, and the panel that does not scroll. The column of notes is
   how a note app is read: what is being written is one of a set, and moving between them should not
   mean going back to a page of cards each time. It is dropped below 1100px, where a fifth of the width
   is too narrow to name a note in and the writing needs everything there is. *@
<div class="note-workspace">
@if (!_isLoading)
{
    @* Most recently changed first under a heading per folder - see NoteWorkspaceList, which the note's
       own page draws too. *@
    <NoteWorkspaceList ChosenNoteId="Id" OnChosen="GoToNote" />
}

@* Two panels: the form on the left, which scrolls, and the panel on the right, which does not - see
   EditorRail. On a narrow screen the right one becomes a bar along the foot of the window. *@
<div class="editor-page">
<div class="editor-page-body">

<PageHeader Hint="@Optional(!HasSomethingToSave && !_isLoading ? T["Write something in it."] : null)">
    <Title>@(IsNewNote ? T["New note"] : T["Edit note"])</Title>
</PageHeader>

@if (_isLoading)
{
    <Loading />
}
else
{
    @if (_isShared)
    {
        <p class="shared-note-banner">@T["This note was shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
        @if (_access.CanAskToEdit && _originalOwnerUserId is { } ownerUserId)
        {
            <RequestEditAccessButton ItemType="Note" ItemId="Id!.Value" ItemTitle="@_formModel.Title"
                                     OwnerUserId="ownerUserId" OwnUserId="_ownUserId"
                                     OwnerDisplayName="@(_sharedByUserName ?? "them")" />
        }
    }

    @* Said when the note opens holding writing the server has not got: the reader left it for another
       note and has come back. A page that quietly showed unsaved work as though it were saved would be
       the worse half of losing it. See NoteDrafts. *@
    @if (_draftMessage is not null)
    {
        <p class="info">@_draftMessage</p>
    }

    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="editor-form note-editor-form">
        <fieldset disabled="@(_isSharedReadOnly || _lockedByUserName is not null || _isSaving)">
            @* One field for the whole note, and nothing else on this side of the screen. The first line
               is its title and is drawn as one - a separate title box asked twice for something people
               write once, and left the two able to disagree about what the note is called. The phone's
               note screen is the same surface; this is that shape brought back to the browser. *@
            <div class="note-editor-surface">
                <ChecklistTextEditor @ref="_checklistEditorRef" CssClass="note-editor-content note-editor-titled note-editor-page"
                                     IsReadOnly="@(_isSharedReadOnly || _lockedByUserName is not null)"
                                     TakesTab="true" TakesStyles="true" FocusesAtTheEnd="true"
                                     SelectedTicksChanged="count => _selectedTicks = count"
                                     CaretInTableChanged="inTable => OnCaretInTableChanged(inTable)"
                                     PicturePasted="OnPicturePastedAsync"
                                     PictureUrlFor="ResolvePictureUrlAsync"
                                     @bind-Lines="_formModel.Lines" />

                @* Over the corner of the writing rather than above it: a toolbar at the top of a note
                   is a strip of the page given to controls before a word has been written. The styles
                   and the tick box work; the table and the attachment are drawn because the row they
                   belong to is the row this design has, and each says so when it is pressed rather than
                   being greyed out with nothing to explain it. *@
                @if (!_isSharedReadOnly && _lockedByUserName is null)
                {
                    @if (_isEditingTable)
                    {
                        @* What can be done to the table the caret is in. The same panel the styles use,
                           because it is the same kind of thing: a short list over the writing, opened
                           from the row. *@
                        <div class="note-style-menu note-table-menu" role="menu">
                            @foreach (var (action, name) in TableActions)
                            {
                                <button type="button" role="menuitem" class="note-style-menu-item"
                                        @onclick="() => EditTableAsync(action)">@name</button>
                            }
                        </div>
                    }
                    @if (_isChoosingStyle)
                    {
                        @* Each entry drawn in the style it sets, which is how a reader tells a heading
                           from a subheading without reading the words. Pressing the one a line already
                           is takes it back to Body - see NoteSurfaceEdits.Restyle. *@
                        <div class="note-style-menu" role="menu">
                            @* The four marks first, as Apple Notes has them: they answer a selection,
                               where the styles answer a line, and a press with nothing selected does
                               nothing (see NoteSurfaceEdits.Mark). Drawn as the letter each one makes,
                               which is how every editor draws them. *@
                            <div class="note-mark-row">
                                @foreach (var mark in MarksOffered)
                                {
                                    <button type="button" class="note-mark @MarkClass(mark)"
                                            title="@DescribeMark(mark)" aria-label="@DescribeMark(mark)"
                                            @onclick="() => MarkAsync(mark)">A</button>
                                }
                            </div>
                            @foreach (var style in StylesOffered)
                            {
                                <button type="button" role="menuitem"
                                        class="note-style-menu-item note-style-@style.ToString().ToLowerInvariant()"
                                        @onclick="() => SetStyleAsync(style)">@DescribeStyle(style)</button>
                            }
                        </div>
                    }
                    @if (_isChoosingSeparator)
                    {
                        @* What to write on the rule, which is the whole of what a separator has to
                           decide. The same panel again, for the same reason the table's uses it. *@
                        <div class="note-style-menu note-separator-menu" role="menu">
                            <button type="button" role="menuitem" class="note-style-menu-item"
                                    @onclick="() => InsertSeparatorAsync(dated: true)">@T["Date and time"]</button>
                            <button type="button" role="menuitem" class="note-style-menu-item"
                                    @onclick="() => InsertSeparatorAsync(dated: false)">@T["Plain line"]</button>
                        </div>
                    }
                    <div class="note-editor-tools">
                        @* The same bubble says what a press on one of several selected boxes will do,
                           while they are selected - see SelectionHint. *@
                        @if ((_toolBeingExplained ?? SelectionHint) is { } explained)
                        {
                            <span class="note-tool-bubble" role="status">@explained</span>
                        }
                        @* What a line is - a heading, a list, monospaced. Apple Notes' own Format menu,
                           which is what this follows; the styles themselves are NoteLineStyle. Opened
                           from the row rather than laid out in it: eight choices in a bar over the
                           writing is a bar that is most of the writing. *@
                        <button type="button" class="note-tool note-tool-letters @(_isChoosingStyle ? "note-tool-on" : null)"
                                title="@TextStyleLabel" aria-label="@TextStyleLabel"
                                aria-expanded="@_isChoosingStyle.ToString().ToLowerInvariant()"
                                @onclick="() => { _isChoosingStyle = !_isChoosingStyle; _isEditingTable = false; _isChoosingSeparator = false; }">Aa</button>
                        @* The one that works: it types "[]", which the surface turns into a tick box -
                           the same way somebody who never finds this row gets one. *@
                        <button type="button" class="note-tool" title="@T["Checklist item"]"
                                aria-label="@T["Checklist item"]" @onclick="InsertChecklistItemAsync">
                            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="5" cy="6" r="2.6" /><path d="m3.6 6 1 1 1.8-2" /><path d="M10 6h7" />
                                <circle cx="5" cy="14" r="2.6" /><path d="M10 14h7" />
                            </svg>
                        </button>
                        @* Outside a table the tool inserts one; inside a table it opens what can be
                           done to this one - the two things a table button means, told apart by where
                           the caret is (see ChecklistTextEditor.CaretInTableChanged). *@
                        <button type="button" class="note-tool @(_isEditingTable ? "note-tool-on" : null)"
                                title="@TableLabel" aria-label="@TableLabel"
                                aria-expanded="@(_caretIsInATable ? _isEditingTable.ToString().ToLowerInvariant() : null)"
                                @onclick="OnTableToolPressedAsync">
                            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2.5" y="4" width="15" height="12" rx="1.5" /><path d="M2.5 8.5h15" /><path d="M10 8.5V16" />
                            </svg>
                        </button>
                        @* A picture, from a file - the same road a pasted or dropped one takes once it
                           is chosen (see OnPicturePastedAsync). *@
                        <button type="button" class="note-tool" title="@AttachmentLabel" aria-label="@AttachmentLabel"
                                @onclick="PickPictureAsync">
                            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14.5 9.5 9 15a3 3 0 0 1-4.2-4.2l6.4-6.4a2 2 0 0 1 2.8 2.8l-6.4 6.4a1 1 0 0 1-1.4-1.4l5.7-5.7" />
                            </svg>
                        </button>
                        @* A rule across the note, opened from the row because it has something to
                           decide - what is written on it. See NoteSeparatorLine. *@
                        <button type="button" class="note-tool @(_isChoosingSeparator ? "note-tool-on" : null)"
                                title="@SeparatorLabel" aria-label="@SeparatorLabel"
                                aria-expanded="@_isChoosingSeparator.ToString().ToLowerInvariant()"
                                @onclick="OnSeparatorToolPressed">
                            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2.5 10h15" /><path d="M5 5.5h10" stroke-opacity="0.45" /><path d="M5 14.5h10" stroke-opacity="0.45" />
                            </svg>
                        </button>
                    </div>
                }
            </div>

            @* What the note is about in a word or two, under the writing rather than in it - see
               TagsField. Inside the fieldset, so a note this reader cannot change offers nothing to add. *@
            <div class="field note-editor-tags">
                <TagsField Values="_formModel.Tags" ValuesChanged="values => _formModel.Tags = [.. values]"
                           Known="_knownNoteTags" IsReadOnly="@(_isSharedReadOnly || _lockedByUserName is not null)" />
            </div>

        </fieldset>
    </EditForm>
}

</div>
@* Drawn for a note nobody can write to as well, with Save greyed - the same rule the other editors
   follow. It is where the reason lives: a panel that vanished along with the form's buttons took the
   sentence saying why they were gone with it. *@
@if (!_isLoading)
{
    <EditorRail OnSave="SaveAsync" OnCancel="CancelAsync"
                Notice="@(_lockedByUserName is null ? null : T.Format("{0} is currently editing this note - you can't edit it right now.", _lockedByUserName))"
                ErrorMessage="@_saveErrorMessage"
                SaveDisabled="@(_isSharedReadOnly || _lockedByUserName is not null || !HasSomethingToSave || _isSaving)">
        @* Beside the button that failed rather than at the end of a form that is taller than the
           screen: a save that did not happen and a note somebody else is holding are both answers to
           "why has Save done nothing", and an answer nobody scrolls to is not one. *@
        <ChildContent>
            @* Everything that is about the note rather than in it: how much it matters, where it will
               be found, and who may read it. They used to sit under the writing, which is a form
               somebody had to scroll past to reach the end of what they were writing - and before that
               above it, so a page opened to write on began with three questions nobody had an answer to
               yet. In the panel they are one press from anywhere in the note and out of the way until
               then. Stays open, because it is a menu of settings rather than of actions: closing after
               each one would make changing two a chore. *@
            <OverflowMenu StaysOpen="true" @ref="_menu">
                <div class="editor-settings-menu">
                    @* Plain controls rather than the EditForm's own: this panel sits outside the form,
                       and InputSelect/InputCheckbox need its EditContext to exist at all. *@
                    <div class="field">
                        <label for="notePrioritySelect">@T["Priority"]<FieldHint>@T["Sorts this note against the others, and is what the dashboard's filter reads."]</FieldHint></label>
                        <select id="notePrioritySelect" value="@_formModel.Priority" disabled="@IsSettingsDisabled"
                                @onchange="OnPriorityChosen">
                            <option value="Low">@T["Low"]</option>
                            <option value="Normal">@T["Normal"]</option>
                            <option value="High">@T["High"]</option>
                        </select>
                    </div>

                    @* Where it will be found. Only the owner files a note: one reached through a share
                       sits in its owner's folder on their page, and this reader's tabs are their own. *@
                    @if (!_isShared)
                    {
                        <FolderField Page="FolderPage.Notes" Value="_formModel.FolderId" ValueChanged="folderId => _formModel.FolderId = folderId"
                                     Hint="@(T["Without one it is in Public, or in Private when it is sealed."])" />
                    }

                    @* Only the owner may turn this on: a note reached through a share belongs to someone
                       else, and "private" means private to its creator. *@
                    @if (!_isShared)
                    {
                        <div class="field">
                            <label>
                                <input type="checkbox" checked="@_formModel.IsPrivate" disabled="@IsSettingsDisabled"
                                       @onchange="args => _formModel.IsPrivate = args.Value is true" />@T["Private"]<FieldHint>@T["Encrypted in this browser, so Orbit can't read it. It can't be shared, and losing your password loses it."]</FieldHint></label>
                        </div>
                    }
                </div>

                @* The note on the clipboard, whole or narrowed to one state of its boxes - see
                   WhatToCopy, which is the same four every other kind of thing offers. What is copied
                   is what the form holds, unsaved lines included: it is the note in front of them.
                   Under a line with the actions, being one. *@
                <div class="editor-settings-divider"></div>
                @foreach (var what in CopiedParts.All)
                {
                    <button type="button" class="avatar-dropdown-item"
                            @onclick="() => CopyTheTextAsync(what)">@(_copied == what ? T["Copied"] : T[what.Label()])</button>
                }
                @* The other half of the copies above - see PasteFromTheClipboardAsync. Not offered where the
                   note cannot be written in. *@
                @if (!_isSharedReadOnly && _lockedByUserName is null)
                {
                    <button type="button" class="avatar-dropdown-item"
                            @onclick="PasteFromTheClipboardAsync">@T["Paste from the clipboard"]</button>
                }

                @* The two ways of handing the note on, under a line because they are actions rather than
                   settings: each closes the menu and opens its panel over the page. They used to be two
                   more sections under the writing, a form below a form. Offered on the same terms as
                   then - only for a note that has been saved, since there is nothing to hand on before,
                   and never for a sealed one, which Orbit cannot read and so cannot give anybody. *@
                @if (CanOfferSharing || CanOfferALink)
                {
                    <div class="editor-settings-divider"></div>
                    @if (CanOfferSharing)
                    {
                        <button type="button" class="avatar-dropdown-item" @onclick="OpenSharing">@T["Share"]</button>
                    }
                    @if (CanOfferALink)
                    {
                        <button type="button" class="avatar-dropdown-item" @onclick="OpenTheShareLink">@T["Share link"]</button>
                    }
                }

                @* The two ways out of the note, and the way back to all of them. They lived on the
                   note's own page until this form became that page - a note is opened to be written in
                   now, with nothing to read first - so what that page carried is here.

                   Put away rather than deleted, and Delete only once it has been: the rule every card
                   follows, see ObjectMenu.IsArchived. Somebody else's note is neither - it comes off
                   this reader's own pages and stays on the owner's, so it says that instead. *@
                @if (!IsNewNote)
                {
                    <div class="editor-settings-divider"></div>
                    <button type="button" class="avatar-dropdown-item" @onclick="GoToNotes">@T["All notes"]</button>
                    @if (!_isShared)
                    {
                        <button type="button" class="avatar-dropdown-item" disabled="@_isArchiving"
                                @onclick="() => SetArchivedAsync(!_isArchived)">
                            @(_isArchived ? T["Put back"] : T["Archive"])
                        </button>
                    }
                    @if (!_isShared && _isArchived)
                    {
                        <button type="button" class="avatar-dropdown-item" disabled="@_isDeleting"
                                @onclick="DeleteAsync">@T["Delete"]</button>
                    }
                    @if (_isShared)
                    {
                        <button type="button" class="avatar-dropdown-item" disabled="@_isDeleting"
                                @onclick="DeleteAsync">@T["Remove from my list"]</button>
                    }
                }
            </OverflowMenu>
        </ChildContent>
    </EditorRail>
}
</div>
</div>

@* Handing the note to a contact, over the page rather than in it - see the menu entry above. Kept to
   the same rule as the entry, so ticking Private while it is open takes it away too. *@
@if (_isSharingOpen && CanOfferSharing)
{
    <Dialog Title="@T["Share"]" OnClosed="() => _isSharingOpen = false">
        @if (_shareableContacts.Count == 0)
        {
            <p>@T["No contacts. A contact will appear here once you start a chat with someone."]</p>
        }
        else
        {
            <div class="field-row">
                <select id="shareContactSelect" @bind="_selectedContactUserId">
                    <option value="">@T["-- select a contact --"]</option>
                    @foreach (var contact in _shareableContacts)
                    {
                        <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                    }
                </select>
                <select id="shareAccessLevelSelect" @bind="_selectedAccessLevel">
                    <option value="ReadOnly">@T["Read-only"]</option>
                    <option value="Share">@T["Can share"]</option>
                    @if (_canGrantEditOnly)
                    {
                        <option value="EditOnly">@T["Can edit, but not share editing"]</option>
                    }
                    @if (_canGrantCanEdit)
                    {
                        <option value="CanEdit">@T["Can edit"]</option>
                    }
                </select>
                <button type="button" id="shareNoteButton" class="btn-primary" disabled="@_isSharing" @onclick="ShareAsync">@T["Share"]</button>
            </div>
        }
        @if (_shareErrorMessage is not null)
        {
            <p class="error">@_shareErrorMessage</p>
        }
        @if (_shareInfoMessage is not null)
        {
            <p class="info">@_shareInfoMessage</p>
        }
    </Dialog>
}

@if (_isShareLinkOpen && CanOfferALink && Id is { } noteId)
{
    <Dialog Title="@T["Share link"]" OnClosed="() => _isShareLinkOpen = false">
        <ShareLinkButton ItemType="Note" ItemId="noteId" />
    </Dialog>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// The page that sent the reader here, so finishing returns them to it rather than to /notes -
    /// the same answer the task list's form gives, and the same rule about what may be followed. See
    /// ReturnTo.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = ReturnTo.QueryName)]
    public string? ComeBackTo { get; set; }

    /// <summary>
    /// Where saving, cancelling and deleting all end. /notes when nobody said otherwise, which is
    /// what every route here did before and is still right for somebody who typed the address.
    /// </summary>
    private string WhenFinished => ReturnTo.Or(ComeBackTo, "/notes");

    private bool IsNewNote => Id is null;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSharing;
    private NoteFormModel _formModel = new();

    /// <summary>Every tag already on one of this account's notes, for the tags field - see TagsField.</summary>
    private IReadOnlyList<string> _knownNoteTags = [];
    private bool _isShared;
    private bool _isSharedReadOnly;
    private bool _canShare;
    private bool _canGrantCanEdit;
    private bool _canGrantEditOnly;
    private SharedItemAccess _access = new(IsShared: false, ShareAccessLevel.CanEdit);
    private Guid? _originalOwnerUserId;
    private string? _sharedByUserName;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private string? _shareErrorMessage;
    private string? _shareInfoMessage;
    private string? _saveErrorMessage;
    private Guid _ownUserId;
    private ChecklistTextEditor? _checklistEditorRef;

    /// <summary>
    /// Whether this note has been put away - see Orbit.Core.Folders.BuiltInFolder.Archived. What decides
    /// whether the menu says Archive or Put back, and whether it offers Delete at all: Delete is reached
    /// from the archive and nowhere else (see ObjectMenu.IsArchived, which every card follows).
    /// </summary>
    private bool _isArchived;
    private bool _isArchiving;
    private bool _isDeleting;

    /// <summary>Whether the note's own settings may be changed - the same answer the writing surface gets.</summary>
    private bool IsSettingsDisabled => _isSharedReadOnly || _lockedByUserName is not null || _isSaving;

    /// <summary>The panel's menu, so the two entries that open something over the page can close it behind them.</summary>
    private OverflowMenu? _menu;

    /// <summary>Which of the four was copied, so that entry says so until the menu is left.</summary>
    private WhatToCopy? _copied;

    /// <summary>
    /// The note being written, on the clipboard - see NoteWords, which writes it out. The lines are
    /// taken from the form rather than from what was last saved, since the form is the note in front of
    /// the reader.
    /// </summary>
    private async Task CopyTheTextAsync(WhatToCopy what)
    {
        var words = NoteWords.Of(_formModel.Title, _formModel.Lines.ToSurfaceLines(), what);

        if (await Clipboard.TryWriteAsync(words))
        {
            _copied = what;
            return;
        }

        _saveErrorMessage = T["The text could not be copied. Your browser did not allow it."];
    }

    /// <summary>
    /// What is on the clipboard, put into the note where the caret was - or at its end, which is where a
    /// press on the menu leaves it - as a paste would put it: "[x] " and "- " lines come in as boxes, so a
    /// list or a note copied out of Orbit comes back as the lines it was. Asked for as a menu entry because
    /// the system's paste needs the caret in the note first and a keyboard to press it with.
    /// </summary>
    private async Task PasteFromTheClipboardAsync()
    {
        _menu?.Close();
        if (await Clipboard.TryReadAsync() is not { } pasted)
        {
            _saveErrorMessage = T["The clipboard could not be read. Your browser did not allow it."];
            return;
        }

        if (pasted.Trim().Length == 0 || _checklistEditorRef is null)
        {
            _saveErrorMessage = T["There is nothing on the clipboard to paste."];
            return;
        }

        _saveErrorMessage = null;
        await _checklistEditorRef.PasteTextAsync(pasted);
    }

    /// <summary>
    /// Whether this reader may hand the note to a contact: a saved note, a share that allows passing it
    /// on, and not sealed - the server refuses to share a private note, so it is not offered.
    /// </summary>
    private bool CanOfferSharing => !IsNewNote && _canShare && !_formModel.IsPrivate;

    /// <summary>Whether a public link may be made: a saved note that is not sealed. Who may publish is the server's answer - see ShareLinkButton.</summary>
    private bool CanOfferALink => !IsNewNote && !_formModel.IsPrivate;

    private bool _isSharingOpen;
    private bool _isShareLinkOpen;

    private void OpenSharing()
    {
        _menu?.Close();
        _isSharingOpen = true;
    }

    private void OpenTheShareLink()
    {
        _menu?.Close();
        _isShareLinkOpen = true;
    }

    /// <summary>
    /// What the last press of a tool that does not exist yet was about, in the reader's language. Null
    /// while nothing has been pressed. Said rather than greyed: a row of three dead buttons explains
    /// nothing, and the row is the row this design draws.
    /// </summary>
    private string? _toolBeingExplained;

    /// <summary>
    /// How many boxes the selection in the writing covers, when it covers several - see
    /// ChecklistTextEditor.SelectedTicksChanged. Zero otherwise.
    /// </summary>
    private int _selectedTicks;

    /// <summary>
    /// What a press on one of several selected boxes will do, said while they are selected. The rings
    /// round the boxes show which ones; this says why - a selection of lines is otherwise only
    /// highlighted text, and nothing about it suggests the boxes in it now answer together.
    /// </summary>
    private string? SelectionHint
        => _selectedTicks >= 2 ? T.Format("{0} selected items - ticking one ticks them all.", _selectedTicks.ToString()) : null;

    private void OnPriorityChosen(ChangeEventArgs args)
        => _formModel.Priority = args.Value?.ToString() is { Length: > 0 } chosen ? chosen : NoteFormModel.NormalPriority;

    /// <summary>
    /// A picture pasted, dropped or picked: stored first, sealed if the note is, then put where the
    /// caret is. A note that has never been saved has nowhere to keep one - a picture belongs to a note,
    /// and there is no note yet - so it says to save first, which is the one thing Apple Notes does not
    /// have to say because it saves as you type.
    /// </summary>
    private async Task OnPicturePastedAsync(ChecklistTextEditor.PastedPicture pasted)
    {
        if (IsNewNote)
        {
            _toolBeingExplained = T["Save the note first, then add pictures."];
            return;
        }

        var bytes = pasted.Bytes;
        if (_formModel.IsPrivate)
        {
            try
            {
                bytes = await PrivateContentSealer.SealBytesAsync(bytes);
            }
            catch (EncryptionKeyLockedException)
            {
                _toolBeingExplained = T["Unlock your encryption key to add a picture to a private note."];
                return;
            }
        }

        var outcome = await NotePicturesApiClient.UploadAsync(Id!.Value, bytes, pasted.ContentType, _formModel.IsPrivate);
        if (outcome.Kind == NotePictureUploadOutcomeKind.TooLarge)
        {
            _toolBeingExplained = T["This note already holds all the pictures it may - 50 MB."];
            return;
        }

        if (outcome.Picture is null)
        {
            _toolBeingExplained = T["The picture could not be stored. Try again."];
            return;
        }

        if (_checklistEditorRef is not null)
        {
            await _checklistEditorRef.InsertPictureAsync(
                new NotePictureLineDto(outcome.Picture.Id, pasted.ContentType, pasted.WidthPixels, pasted.HeightPixels));
        }
    }

    /// <summary>Where a picture's bytes are drawn from - see NotePictureSource, which opens a sealed one.</summary>
    private Task<string?> ResolvePictureUrlAsync(Guid pictureId)
    {
        if (Id is null)
        {
            return Task.FromResult<string?>(null);
        }

        var line = _formModel.Lines.Select(line => line.Picture).FirstOrDefault(picture => picture?.PictureId == pictureId);
        return line is null
            ? Task.FromResult<string?>(null)
            : NotePictureSource.UrlForAsync(Id.Value, line, _formModel.IsPrivate);
    }

    private async Task PickPictureAsync()
    {
        if (IsNewNote)
        {
            _toolBeingExplained = T["Save the note first, then add pictures."];
            return;
        }

        if (_checklistEditorRef is not null)
        {
            await _checklistEditorRef.PickPictureAsync();
        }
    }

    /// <summary>The pictures the note still names, told to the save so the rest are swept - see UpdateNoteRequest.PictureIds.</summary>
    private IReadOnlyList<Guid> PictureIdsKept
        => [.. _formModel.Lines.Where(line => line.Picture is not null).Select(line => line.Picture!.PictureId)];

    /// <summary>Whether the list of styles is open under the "Aa" button.</summary>
    private bool _isChoosingStyle;

    /// <summary>Whether the caret is inside a table, which is what the table tool's press means by.</summary>
    private bool _caretIsInATable;

    /// <summary>Whether the table's own list - rows, columns, taking it away - is open under the table tool.</summary>
    private bool _isEditingTable;

    /// <summary>
    /// What can be done to the table the caret is in, as the commands ChecklistTextEditor.Edit knows
    /// them, under the words the reader sees. Rows and columns are added after the caret's, which is
    /// what "below" and "right" mean.
    /// </summary>
    private IReadOnlyList<(string Action, string Name)> TableActions =>
    [
        ("tableRowBelow", T["Add row below"]),
        ("tableColumnRight", T["Add column right"]),
        ("tableRowRemoved", T["Delete row"]),
        ("tableColumnRemoved", T["Delete column"]),
        ("tableRemoved", T["Delete table"])
    ];

