@page "/notes/new"
@* One press further in than the note itself, the way a task list's editor is - see NoteSummary.razor,
   which is what opening a note lands on. *@
@page "/notes/{Id:guid}/edit"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Notes
@using Orbit.Core.Abstractions
@using Orbit.Core.Folders
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject FolderState Folders
@inject ChatApiClient ChatApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject NavigationTrail NavigationTrail
@inject ILogger<NoteEditor> Logger
@inject Translations T

<PageTitle>@(IsNewNote ? T["New note"] : T["Edit note"])</PageTitle>

@* Save and Cancel at the top beside the name rather than at the foot of the form. A note is written
   from the top down and the form has no fixed height, so the buttons used to be wherever the writing
   happened to end - which on a long note is off the screen. Icons, because two words there would
   compete with the one thing the page is called. *@
@* Three columns on a wide screen, not two: the notes in this folder on the far left, then the note
   itself with its own pair - the writing, and the panel that does not scroll. The column of notes is
   how a note app is read: what is being written is one of a set, and moving between them should not
   mean going back to a page of cards each time. It is dropped below 1100px, where a fifth of the width
   is too narrow to name a note in and the writing needs everything there is. *@
<div class="note-workspace">
@if (!_isLoading)
{
    <aside class="note-workspace-list">
        @* Most recently changed first, which is the order the notes page itself opens in - the one being
           written in is nearly always the one at the top. *@
        <h2 class="note-workspace-list-heading">@T["Notes"]</h2>
        @if (_notesBeside.Count == 0)
        {
            <p class="empty-hint empty-list">@T["No notes yet."]</p>
        }
        @foreach (var note in _notesBeside)
        {
            <button type="button" class="note-workspace-row @(note.Id == Id ? "chosen" : null)"
                    @onclick="() => GoToNote(note.Id)">
                <span class="note-workspace-row-title">@NameOf(note)</span>
                <span class="row-meta">@note.UpdatedAtUtc.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span>
            </button>
        }
    </aside>
}

@* Two panels: the form on the left, which scrolls, and the panel on the right, which does not - see
   EditorRail. On a narrow screen the right one becomes a bar along the foot of the window. *@
<div class="editor-page">
<div class="editor-page-body">

<PageHeader Hint="@Optional(!HasSomethingToSave && !_isLoading ? T["Write something in it."] : null)">
    <Title>@(IsNewNote ? T["New note"] : T["Edit note"])</Title>
</PageHeader>

@if (_isLoading)
{
    <Loading />
}
else
{
    @if (_isShared)
    {
        <p class="shared-note-banner">@T["This note was shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
        @if (_access.CanAskToEdit && _originalOwnerUserId is { } ownerUserId)
        {
            <RequestEditAccessButton ItemType="Note" ItemId="Id!.Value" ItemTitle="_formModel.Title"
                                     OwnerUserId="ownerUserId" OwnUserId="_ownUserId"
                                     OwnerDisplayName="@(_sharedByUserName ?? "them")" />
        }
    }

    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="editor-form note-editor-form">
        <fieldset disabled="@(_isSharedReadOnly || _lockedByUserName is not null || _isSaving)">
            @* One field for the whole note, and nothing else on this side of the screen. The first line
               is its title and is drawn as one - a separate title box asked twice for something people
               write once, and left the two able to disagree about what the note is called. The phone's
               note screen is the same surface; this is that shape brought back to the browser. *@
            <div class="note-editor-surface">
                <ChecklistTextEditor @ref="_checklistEditorRef" CssClass="note-editor-content note-editor-titled note-editor-page"
                                     IsReadOnly="@(_isSharedReadOnly || _lockedByUserName is not null)"
                                     TakesTab="true"
                                     SelectedTicksChanged="count => _selectedTicks = count"
                                     @bind-Lines="_formModel.Lines" />

                @* Over the corner of the writing rather than above it: a toolbar at the top of a note
                   is a strip of the page given to controls before a word has been written. Only the
                   tick box does anything today - the other three are drawn because the row they belong
                   to is the row this design has, and each says so when it is pressed rather than being
                   greyed out with nothing to explain it. *@
                @if (!_isSharedReadOnly && _lockedByUserName is null)
                {
                    <div class="note-editor-tools">
                        @* The same bubble says what a press on one of several selected boxes will do,
                           while they are selected - see SelectionHint. *@
                        @if ((_toolBeingExplained ?? SelectionHint) is { } explained)
                        {
                            <span class="note-tool-bubble" role="status">@explained</span>
                        }
                        <button type="button" class="note-tool note-tool-letters" title="@TextStyleLabel"
                                aria-label="@TextStyleLabel" @onclick="() => NotImplementedYet(TextStyleLabel)">Aa</button>
                        @* The one that works: it types "[]", which the surface turns into a tick box -
                           the same way somebody who never finds this row gets one. *@
                        <button type="button" class="note-tool" title="@T["Checklist item"]"
                                aria-label="@T["Checklist item"]" @onclick="InsertChecklistItemAsync">
                            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="5" cy="6" r="2.6" /><path d="m3.6 6 1 1 1.8-2" /><path d="M10 6h7" />
                                <circle cx="5" cy="14" r="2.6" /><path d="M10 14h7" />
                            </svg>
                        </button>
                        <button type="button" class="note-tool" title="@TableLabel" aria-label="@TableLabel"
                                @onclick="() => NotImplementedYet(TableLabel)">
                            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2.5" y="4" width="15" height="12" rx="1.5" /><path d="M2.5 8.5h15" /><path d="M10 8.5V16" />
                            </svg>
                        </button>
                        <button type="button" class="note-tool" title="@AttachmentLabel" aria-label="@AttachmentLabel"
                                @onclick="() => NotImplementedYet(AttachmentLabel)">
                            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14.5 9.5 9 15a3 3 0 0 1-4.2-4.2l6.4-6.4a2 2 0 0 1 2.8 2.8l-6.4 6.4a1 1 0 0 1-1.4-1.4l5.7-5.7" />
                            </svg>
                        </button>
                    </div>
                }
            </div>

        </fieldset>
    </EditForm>
}

</div>
@* Drawn for a note nobody can write to as well, with Save greyed - the same rule the other editors
   follow. It is where the reason lives: a panel that vanished along with the form's buttons took the
   sentence saying why they were gone with it. *@
@if (!_isLoading)
{
    <EditorRail OnSave="SaveAsync" OnCancel="CancelAsync"
                Notice="@(_lockedByUserName is null ? null : T.Format("{0} is currently editing this note - you can't edit it right now.", _lockedByUserName))"
                ErrorMessage="@_saveErrorMessage"
                SaveDisabled="@(_isSharedReadOnly || _lockedByUserName is not null || !HasSomethingToSave || _isSaving)">
        @* Beside the button that failed rather than at the end of a form that is taller than the
           screen: a save that did not happen and a note somebody else is holding are both answers to
           "why has Save done nothing", and an answer nobody scrolls to is not one. *@
        <ChildContent>
            @* Everything that is about the note rather than in it: how much it matters, where it will
               be found, and who may read it. They used to sit under the writing, which is a form
               somebody had to scroll past to reach the end of what they were writing - and before that
               above it, so a page opened to write on began with three questions nobody had an answer to
               yet. In the panel they are one press from anywhere in the note and out of the way until
               then. Stays open, because it is a menu of settings rather than of actions: closing after
               each one would make changing two a chore. *@
            <OverflowMenu StaysOpen="true" @ref="_menu">
                <div class="editor-settings-menu">
                    @* Plain controls rather than the EditForm's own: this panel sits outside the form,
                       and InputSelect/InputCheckbox need its EditContext to exist at all. *@
                    <div class="field">
                        <label for="notePrioritySelect">@T["Priority"]<FieldHint>@T["Sorts this note against the others, and is what the dashboard's filter reads."]</FieldHint></label>
                        <select id="notePrioritySelect" value="@_formModel.Priority" disabled="@IsSettingsDisabled"
                                @onchange="OnPriorityChosen">
                            <option value="Low">@T["Low"]</option>
                            <option value="Normal">@T["Normal"]</option>
                            <option value="High">@T["High"]</option>
                        </select>
                    </div>

                    @* Where it will be found. Only the owner files a note: one reached through a share
                       sits in its owner's folder on their page, and this reader's tabs are their own. *@
                    @if (!_isShared)
                    {
                        <FolderField Page="FolderPage.Notes" Value="_formModel.FolderId" ValueChanged="folderId => _formModel.FolderId = folderId"
                                     Hint="@(T["Without one it is in Public, or in Private when it is sealed."])" />
                    }

                    @* Only the owner may turn this on: a note reached through a share belongs to someone
                       else, and "private" means private to its creator. *@
                    @if (!_isShared)
                    {
                        <div class="field">
                            <label>
                                <input type="checkbox" checked="@_formModel.IsPrivate" disabled="@IsSettingsDisabled"
                                       @onchange="args => _formModel.IsPrivate = args.Value is true" />@T["Private"]<FieldHint>@T["Encrypted in this browser, so Orbit can't read it. It can't be shared, and losing your password loses it."]</FieldHint></label>
                        </div>
                    }
                </div>

                @* The two ways of handing the note on, under a line because they are actions rather than
                   settings: each closes the menu and opens its panel over the page. They used to be two
                   more sections under the writing, a form below a form. Offered on the same terms as
                   then - only for a note that has been saved, since there is nothing to hand on before,
                   and never for a sealed one, which Orbit cannot read and so cannot give anybody. *@
                @if (CanOfferSharing || CanOfferALink)
                {
                    <div class="editor-settings-divider"></div>
                    @if (CanOfferSharing)
                    {
                        <button type="button" class="avatar-dropdown-item" @onclick="OpenSharing">@T["Share"]</button>
                    }
                    @if (CanOfferALink)
                    {
                        <button type="button" class="avatar-dropdown-item" @onclick="OpenTheShareLink">@T["Share link"]</button>
                    }
                }
            </OverflowMenu>
        </ChildContent>
    </EditorRail>
}
</div>
</div>

@* Handing the note to a contact, over the page rather than in it - see the menu entry above. Kept to
   the same rule as the entry, so ticking Private while it is open takes it away too. *@
@if (_isSharingOpen && CanOfferSharing)
{
    <Dialog Title="@T["Share"]" OnClosed="() => _isSharingOpen = false">
        @if (_shareableContacts.Count == 0)
        {
            <p>@T["No contacts. A contact will appear here once you start a chat with someone."]</p>
        }
        else
        {
            <div class="field-row">
                <select id="shareContactSelect" @bind="_selectedContactUserId">
                    <option value="">@T["-- select a contact --"]</option>
                    @foreach (var contact in _shareableContacts)
                    {
                        <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                    }
                </select>
                <select id="shareAccessLevelSelect" @bind="_selectedAccessLevel">
                    <option value="ReadOnly">@T["Read-only"]</option>
                    <option value="Share">@T["Can share"]</option>
                    @if (_canGrantEditOnly)
                    {
                        <option value="EditOnly">@T["Can edit, but not share editing"]</option>
                    }
                    @if (_canGrantCanEdit)
                    {
                        <option value="CanEdit">@T["Can edit"]</option>
                    }
                </select>
                <button type="button" id="shareNoteButton" class="btn-primary" disabled="@_isSharing" @onclick="ShareAsync">@T["Share"]</button>
            </div>
        }
        @if (_shareErrorMessage is not null)
        {
            <p class="error">@_shareErrorMessage</p>
        }
        @if (_shareInfoMessage is not null)
        {
            <p class="info">@_shareInfoMessage</p>
        }
    </Dialog>
}

@if (_isShareLinkOpen && CanOfferALink && Id is { } noteId)
{
    <Dialog Title="@T["Share link"]" OnClosed="() => _isShareLinkOpen = false">
        <ShareLinkButton ItemType="Note" ItemId="noteId" />
    </Dialog>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// The page that sent the reader here, so finishing returns them to it rather than to /notes -
    /// the same answer the task list's form gives, and the same rule about what may be followed. See
    /// ReturnTo.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = ReturnTo.QueryName)]
    public string? ComeBackTo { get; set; }

    /// <summary>
    /// Where saving, cancelling and deleting all end. /notes when nobody said otherwise, which is
    /// what every route here did before and is still right for somebody who typed the address.
    /// </summary>
    private string WhenFinished => ReturnTo.Or(ComeBackTo, "/notes");

    private bool IsNewNote => Id is null;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSharing;
    private NoteFormModel _formModel = new();
    private bool _isShared;
    private bool _isSharedReadOnly;
    private bool _canShare;
    private bool _canGrantCanEdit;
    private bool _canGrantEditOnly;
    private SharedItemAccess _access = new(IsShared: false, ShareAccessLevel.CanEdit);
    private Guid? _originalOwnerUserId;
    private string? _sharedByUserName;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private string? _shareErrorMessage;
    private string? _shareInfoMessage;
    private string? _saveErrorMessage;
    private Guid _ownUserId;
    private ChecklistTextEditor? _checklistEditorRef;

    /// <summary>Whether the note's own settings may be changed - the same answer the writing surface gets.</summary>
    private bool IsSettingsDisabled => _isSharedReadOnly || _lockedByUserName is not null || _isSaving;

    /// <summary>The panel's menu, so the two entries that open something over the page can close it behind them.</summary>
    private OverflowMenu? _menu;

    /// <summary>
    /// Whether this reader may hand the note to a contact: a saved note, a share that allows passing it
    /// on, and not sealed - the server refuses to share a private note, so it is not offered.
    /// </summary>
    private bool CanOfferSharing => !IsNewNote && _canShare && !_formModel.IsPrivate;

    /// <summary>Whether a public link may be made: a saved note that is not sealed. Who may publish is the server's answer - see ShareLinkButton.</summary>
    private bool CanOfferALink => !IsNewNote && !_formModel.IsPrivate;

    private bool _isSharingOpen;
    private bool _isShareLinkOpen;

    private void OpenSharing()
    {
        _menu?.Close();
        _isSharingOpen = true;
    }

    private void OpenTheShareLink()
    {
        _menu?.Close();
        _isShareLinkOpen = true;
    }

    /// <summary>
    /// What the last press of a tool that does not exist yet was about, in the reader's language. Null
    /// while nothing has been pressed. Said rather than greyed: a row of three dead buttons explains
    /// nothing, and the row is the row this design draws.
    /// </summary>
    private string? _toolBeingExplained;

    /// <summary>
    /// How many boxes the selection in the writing covers, when it covers several - see
    /// ChecklistTextEditor.SelectedTicksChanged. Zero otherwise.
    /// </summary>
    private int _selectedTicks;

    /// <summary>
    /// What a press on one of several selected boxes will do, said while they are selected. The rings
    /// round the boxes show which ones; this says why - a selection of lines is otherwise only
    /// highlighted text, and nothing about it suggests the boxes in it now answer together.
    /// </summary>
    private string? SelectionHint
        => _selectedTicks >= 2 ? T.Format("{0} selected items - ticking one ticks them all.", _selectedTicks.ToString()) : null;

    private void OnPriorityChosen(ChangeEventArgs args)
        => _formModel.Priority = args.Value?.ToString() is { Length: > 0 } chosen ? chosen : NoteFormModel.NormalPriority;

    private void NotImplementedYet(string tool)
        => _toolBeingExplained = T.Format("{0}: not implemented yet.", tool);

    @* Read once each rather than written into the attributes: a string in quotes inside an attribute's
       own quotes is what Razor cannot parse - see the same trap in the task editor. *@
    private string TextStyleLabel => T["Text style"];

    private string TableLabel => T["Table"];

    private string AttachmentLabel => T["Attachment"];

    /// <summary>Who else currently holds the edit lock, if anyone - see AcquireLockAsync. Null means this browser holds it (or the note isn't editable at all, so no lock was ever sought).</summary>
    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;

    /// <summary>
    /// How often this browser re-acquires its own edit lock while the editor stays open - well under
    /// AcquireNoteLockCommandHandler's LockDuration (60s) so the lock never lapses under normal network
    /// conditions.
    /// </summary>
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    /// <summary>
    /// Contacts eligible as a share target: everyone except the note's original owner when re-sharing a
    /// received copy - see ShareNoteCommandHandler's class comment for why sharing back to them is
    /// blocked server-side too. Not filtered at all when the current user is the true owner (no
    /// OriginalOwnerUserId to exclude).
    /// </summary>
    private IReadOnlyList<ContactDto> _shareableContacts
        => _originalOwnerUserId is { } originalOwnerUserId
            ? _contacts.Where(contact => contact.UserId != originalOwnerUserId).ToList()
            : _contacts;

    /// <summary>Explains what the current user can do with this shared copy, for the "shared by X" banner.</summary>
    private string SharedAccessDescription => T[_access.Description];

    /// <summary>
    /// Which note is on the surface, so opening another one from the list beside it actually swaps the
    /// note. Blazor keeps the component when only a route parameter changes, so a page that loaded in
    /// OnInitializedAsync would have shown the first note under the second one's address - see
    /// OnParametersSetAsync.
    /// </summary>
    private Guid? _loadedId;

    private bool _hasLoaded;

    /// <summary>
    /// Whether the writing surface is still showing the note before this one. It owns its content from
    /// the moment it appears and nothing about a changed parameter reaches it, so a swap has to be
    /// handed over - see ChecklistTextEditor.SetLinesAsync.
    /// </summary>
    private bool _surfaceNeedsTheNote;

    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoaded && _loadedId == Id)
        {
            return;
        }

        // The note being left behind is not being edited any more, and somebody else may want it.
        if (_hasLoaded && _loadedId is { } previousNoteId)
        {
            await ReleaseLockAsync(previousNoteId);
        }

        _hasLoaded = true;
        _loadedId = Id;
        _isLoading = true;
        _formModel = new NoteFormModel();
        _isShared = false;
        _isSharedReadOnly = false;
        _canShare = false;
        _canGrantCanEdit = false;
        _canGrantEditOnly = false;
        _access = new SharedItemAccess(IsShared: false, ShareAccessLevel.CanEdit);
        _originalOwnerUserId = null;
        _sharedByUserName = null;
        _lockedByUserName = null;
        _saveErrorMessage = null;
        _shareErrorMessage = null;
        _shareInfoMessage = null;
        _toolBeingExplained = null;
        await LoadTheNoteAsync();
        _surfaceNeedsTheNote = true;
    }

    private async Task LoadTheNoteAsync()
    {
        var currentUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        _ownUserId = currentUserId.Value;

        if (Id is { } noteId)
        {
            Logger.LogInformation("Note editor opened for note {NoteId}", noteId);
            try
            {
                var note = await NotesApiClient.GetNoteByIdAsync(noteId);
                if (note is not null)
                {
                    _formModel = new NoteFormModel
                    {
                        // Put back together the way it is written: the title as the first line, the
                        // rest after it. Not a checklist line - a title is not something to tick off.
                        Lines = [new NoteContentLineDto(note.Title, false, false), .. note.Content],
                        IsPrivate = note.IsPrivate,
                        Priority = note.Priority,
                        FolderId = note.FolderId
                    };
                    _savedFolderId = note.FolderId;
                    _isShared = note.IsShared;
                    _access = SharedItemAccess.For(note.IsShared, note.AccessLevel);
                    _isSharedReadOnly = note.IsShared && !_access.CanEdit;
                    _canShare = _access.CanShare;
                    _canGrantCanEdit = _access.CanGrantCanEdit;
                    _canGrantEditOnly = _access.CanGrantEditOnly;
                    _originalOwnerUserId = note.OriginalOwnerUserId;
                    _sharedByUserName = note.SharedByUserName;

                    if (!_isSharedReadOnly)
                    {
                        await AcquireLockAsync(noteId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(noteId);
                        }
                    }
                }

                _contacts = await ChatApiClient.GetContactsAsync();
            }
            catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
                // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
                // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
                NavigationManager.NavigateTo("/login");
                return;
            }
        }
        else
        {
            Logger.LogInformation("Note editor opened for a new note");
            // Made where the reader is standing: somebody who pressed the plus while reading their
            // "Work" tab means this note to be in Work, and having to file it afterwards is a step that
            // only ever gets skipped. The built-in tabs file nothing - which one a note is in follows
            // from what it is - so from Private what carries over is the thing that puts a note there:
            // it starts sealed, rather than being written in the open and landing under Public.
            await Folders.EnsureLoadedAsync();
            var chosen = Folders.ChosenOn(FolderPage.Notes);
            _formModel.FolderId = chosen.FolderId;
            _formModel.IsPrivate = chosen == FolderKey.Of(BuiltInFolder.Private);
        }

        _isLoading = false;
        await ListTheNotesBesideItAsync();
    }

    /// <summary>
    /// The other notes in the same folder as this one, most recently changed first - the column beside
    /// the writing. Read from the same list the notes page reads: the folder is the only thing that
    /// narrows it, so a note filed nowhere is listed beside the other notes filed nowhere.
    ///
    /// Best effort: a list that will not load leaves the column empty rather than taking the note being
    /// written down with it.
    /// </summary>
    private async Task ListTheNotesBesideItAsync()
    {
        try
        {
            _notesBeside =
            [
                .. (await NotesApiClient.GetNotesAsync())
                    .Where(note => note.FolderId == _formModel.FolderId)
                    .OrderByDescending(note => note.UpdatedAtUtc)
            ];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't list the notes beside the one being edited");
            _notesBeside = [];
        }
    }

    /// <summary>The notes in this note's folder - see ListTheNotesBesideItAsync.</summary>
    private IReadOnlyList<NoteDto> _notesBeside = [];

    /// <summary>
    /// What to call a note in the column. A private one is named by its own title like any other: it
    /// travels sealed, and this browser opens it on the way in (see NotesApiClient.OpenIfPrivateAsync),
    /// so the title is here to show. It used to read "Private note" for every one of them, on the belief
    /// that the page held no key - which left a column of identical rows nobody could tell apart, and
    /// the phone has never done it (see NoteListItem, which hides a title only while private items are
    /// locked).
    ///
    /// The fallback is still there for the two cases that have no title to show: a note nobody has named
    /// yet, and one sealed under a key pair that has since been replaced - that one arrives already
    /// saying so, and says it here.
    /// </summary>
    private string NameOf(NoteDto note)
        => string.IsNullOrWhiteSpace(note.Title) ? T["Private note"] : note.Title;

    /// <summary>
    /// Opens another note from the column, in place of this one: whatever has not been saved here is not
    /// kept. It replaces this form rather than stacking a second on top of it, so finishing the next one
    /// still ends where this one was opened from, and Back from there does not walk through every note
    /// looked at on the way - see NavigationTrail.
    /// </summary>
    ///
    /// The way back it hands on is this note's own, except when that is this note's page - then it is
    /// that page's way back instead, or finishing the next note would end on this one's page. See
    /// ReturnTo.PastThePageOf.
    private Task GoToNote(Guid noteId)
        => NavigationTrail.FinishAsync(ReturnTo.Link(
            $"/notes/{noteId}/edit",
            Id is { } leaving ? ReturnTo.PastThePageOf(ComeBackTo, $"/notes/{leaving}") : ComeBackTo));

    /// <summary>
    /// Hands the note to the writing surface after a swap. It cannot be done where the note is loaded:
    /// the surface is a child component and does not exist yet on the first pass.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_surfaceNeedsTheNote || _checklistEditorRef is null)
        {
            return;
        }

        _surfaceNeedsTheNote = false;
        await _checklistEditorRef.SetLinesAsync(_formModel.Lines);
    }

    /// <summary>
    /// Mirrors Note.EnsureSomethingToRead, which is what actually refuses the save - a title on its own
    /// is a whole note, and a private one is exempt because its readable fields travel empty by design.
    /// </summary>
    private bool HasSomethingToSave
        => _formModel.IsPrivate
            || _formModel.Lines.Any(line => !string.IsNullOrWhiteSpace(line.Text));

    /// <summary>The folder the note was in when it was read, so a save knows whether it has been moved.</summary>
    private Guid? _savedFolderId;

    private async Task SaveAsync()
    {
        Logger.LogInformation(
            "User clicked 'Save' ({Mode}, NoteId={NoteId})", IsNewNote ? "create" : "update", Id);
        _saveErrorMessage = null;

        // Blocks the button for the duration of the save (see the button above), so a second click or a
        // double Enter-press can't fire this again while the first request is still in flight and create
        // a duplicate note.
        _isSaving = true;
        try
        {
            if (IsNewNote)
            {
                var newNoteId = await NotesApiClient.CreateNoteAsync(new CreateNoteRequest(
                    _formModel.Title, _formModel.Content, _formModel.IsPrivate, Priority: _formModel.Priority,
                    FolderId: _formModel.FolderId));
                Logger.LogInformation("Note {NoteId} created", newNoteId);
            }
            else
            {
                var outcome = await NotesApiClient.UpdateNoteAsync(Id!.Value, new UpdateNoteRequest(_formModel.Title, _formModel.Content, _formModel.IsPrivate, Priority: _formModel.Priority));
                if (outcome.Kind == EditOutcomeKind.Locked)
                {
                    _lockedByUserName = outcome.LockedByUserName;
                    StopLockHeartbeat();
                    _saveErrorMessage = T.Format("{0} is currently editing this note - try again in a moment.", outcome.LockedByUserName);
                    return;
                }

                if (outcome.Kind == EditOutcomeKind.Refused)
                {
                    _saveErrorMessage = outcome.Reason;
                    return;
                }

                if (outcome.Kind == EditOutcomeKind.NotFound)
                {
                    _saveErrorMessage = T["Failed to save the note. Try again."];
                    return;
                }

                Logger.LogInformation("Note {NoteId} updated", Id);
                // Filing travels separately from the note itself - see MoveToFolderRequest - so it is
                // sent only when it actually changed, rather than on every save. The answer is read for
                // the reason TaskEditor's own copy of this gives at length.
                if (_formModel.FolderId != _savedFolderId)
                {
                    if (await NotesApiClient.MoveToFolderAsync(Id.Value, _formModel.FolderId))
                    {
                        _savedFolderId = _formModel.FolderId;
                    }
                    else
                    {
                        Logger.LogWarning(
                            "Note {NoteId} was saved but could not be filed under folder {FolderId}",
                            Id, _formModel.FolderId);
                        _saveErrorMessage = T["The note was saved, but it couldn't be filed under that folder. Choose it again."];
                        return;
                    }
                }

                await ReleaseLockAsync(Id.Value);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to {Mode} note {NoteId}", IsNewNote ? "create" : "update", Id);
            _saveErrorMessage = T["Failed to save the note. Try again."];
            return;
        }
        finally
        {
            _isSaving = false;
        }

        // Without this form left behind it: Back after saving a new note would open the form again, one
        // press from saving it twice. See NavigationTrail.
        await NavigationTrail.FinishAsync(WhenFinished);
    }

    /// <summary>
    /// Shares the already-saved note with the selected contact and notifies them with an encrypted chat
    /// message carrying an "Accept" action (see NoteShareMessagePayload) - mirrors
    /// CalendarEventEditor.ShareWithNewlyAddedContactsAsync, minus the "defer until Save" batching, since
    /// notes have no "guests" field to piggyback the share list on.
    /// </summary>
    private async Task ShareAsync()
    {
        if (!Guid.TryParse(_selectedContactUserId, out var recipientUserId) || Id is not { } noteId)
        {
            return;
        }

        _shareErrorMessage = null;
        _shareInfoMessage = null;
        _isSharing = true;
        try
        {
            var result = await NotesApiClient.ShareNoteAsync(noteId, recipientUserId, _selectedAccessLevel);
            if (result is null)
            {
                _shareErrorMessage = T["Failed to share the note."];
                return;
            }

            var payloadJson = JsonSerializer.Serialize(new NoteShareMessagePayload(result.ShareId, _formModel.Title));
            await EncryptedChatMessageSender.SendAsync(
                _ownUserId, recipientUserId, payloadJson, isShareInvitation: true, announcesShareId: result.ShareId);
            _shareInfoMessage = result.AlreadyShared ? T["Already shared with that contact - sent a reminder."] : null;
            _selectedContactUserId = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to share note {NoteId} with user {RecipientUserId}", noteId, recipientUserId);
            _shareErrorMessage = T["Failed to share the note."];
        }
        finally
        {
            _isSharing = false;
        }
    }

    private async Task CancelAsync()
    {
        Logger.LogInformation("User clicked 'Cancel'");
        if (Id is { } noteId)
        {
            await ReleaseLockAsync(noteId);
        }

        await NavigationTrail.FinishAsync(WhenFinished);
    }

    /// <summary>Starts a new checklist line in the editor - the actual line-splitting/marker logic lives in checklistTextEditor.js.</summary>
    private async Task InsertChecklistItemAsync()
    {
        // The one tool that works, so nothing is left being explained.
        _toolBeingExplained = null;
        if (_checklistEditorRef is not null)
        {
            await _checklistEditorRef.InsertChecklistItemAsync();
        }
    }

    /// <summary>
    /// Acquires (or refreshes) this browser's edit lock on noteId - a no-op call otherwise, since the
    /// server only bothers checking/granting a lock for a note the caller could edit anyway (see
    /// AcquireNoteLockCommandHandler). Sets _lockedByUserName to whoever holds it if someone else does,
    /// or null if this browser now holds it (or the note has become inaccessible - see NotFound).
    /// </summary>
    private async Task AcquireLockAsync(Guid noteId)
    {
        try
        {
            var outcome = await NotesApiClient.AcquireNoteLockAsync(noteId);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Best-effort - if this fails, the lock's own TTL (Note.LockExpiresAtUtc) expires it within a few LockHeartbeatInterval multiples anyway.</summary>
    private async Task ReleaseLockAsync(Guid noteId)
    {
        StopLockHeartbeat();
        if (_isSharedReadOnly)
        {
            return;
        }

        try
        {
            await NotesApiClient.ReleaseNoteLockAsync(noteId);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat(Guid noteId)
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(noteId, _lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(Guid noteId, CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync(noteId);
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    // Our own lock lapsed (e.g. a suspended background tab) and someone else grabbed it -
                    // nothing left to refresh, so stop polling instead of repeatedly re-checking a lock
                    // we no longer hold.
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away or DisposeAsync cancels the heartbeat.
        }
        catch (ObjectDisposedException)
        {
            // The timer was disposed by StopLockHeartbeat between a tick starting and this loop checking again.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (Id is { } noteId)
        {
            await ReleaseLockAsync(noteId);
        }
        else
        {
            StopLockHeartbeat();
        }
    }

    private sealed class NoteFormModel
    {
        /// <summary>
        /// Everything written in the note, first line first. Line one is the title - which is why
        /// there is no separate box for it: a note is written as one thing, and two fields let the
        /// name and the note disagree about what it is called.
        /// </summary>
        public IReadOnlyList<NoteContentLineDto> Lines { get; set; } = [];

        /// <summary>The first line, which is what the note is called everywhere else.</summary>
        public string Title => Lines.Count > 0 ? Lines[0].Text.Trim() : string.Empty;

        /// <summary>Everything after it, which is what the API and the list preview call the content.</summary>
        public IReadOnlyList<NoteContentLineDto> Content => [.. Lines.Skip(1)];

        /// <summary>Encrypt this note so only its owner can read it - see PrivateContentSealer.</summary>
        public bool IsPrivate { get; set; }

        /// <summary>What a note is worth unless somebody says otherwise - see ItemPriority.</summary>
        public const string NormalPriority = "Normal";

        /// <summary>ItemPriority by name, the way the API takes it - see NoteDto.Priority.</summary>
        public string Priority { get; set; } = NormalPriority;

        /// <summary>The folder it is filed under, or null for none - see NoteDto.FolderId.</summary>
        public Guid? FolderId { get; set; }
    }
}
