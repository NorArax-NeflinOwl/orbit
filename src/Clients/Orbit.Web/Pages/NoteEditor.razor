        _isChoosingSeparator = !_isChoosingSeparator;
    }

    /// <summary>
    /// Puts a rule where the caret is and closes the choices. The stamp is worked out **here**, once,
    /// and travels with the line from now on - see NoteSeparatorLine.Stamp, which says why: a date
    /// re-read at draw time would make yesterday's separator say today. Written in the reader's own
    /// language and format, because it is written by the reader making it.
    /// </summary>
    private async Task InsertSeparatorAsync(bool dated)
