        {
            await _checklistEditorRef.EditTableAsync(action);
        }
    }

    /// <summary>
    /// The styles offered, in the order Apple Notes lists them - biggest first, then the plain ones,
    /// then the lists. Body is in it on purpose: it is how somebody takes a heading off without having
    /// to know that pressing Heading again does the same thing.
    /// </summary>
