@page "/notes/new"
@page "/notes/{Id:guid}"
@attribute [Authorize]
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Notes
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject ChatApiClient ChatApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<NoteEditor> Logger

<PageTitle>@(IsNewNote ? "New note" : "Edit note")</PageTitle>

<h1>@(IsNewNote ? "New note" : "Edit note")</h1>

@if (_isLoading)
{
    <p>Loading…</p>
}
else
{
    @if (_isSharedReadOnly)
    {
        <p class="shared-note-banner">
            This note was shared by <strong>@_sharedByUserName</strong> - read-only.
        </p>
    }

    <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
        <fieldset disabled="@(_isSharedReadOnly || _isSaving)">
            <div>
                <label>Title</label>
                <InputText @bind-Value="_formModel.Title" />
            </div>
            <div>
                <label>Content</label>
                <InputTextArea @bind-Value="_formModel.Content" />
            </div>
            <button type="submit">Save</button>
            <button type="button" @onclick="Cancel">Cancel</button>
        </fieldset>
    </EditForm>

    @if (!IsNewNote)
    {
        <h2>Sharing</h2>
        @if (_contacts.Count == 0)
        {
            <p>No contacts. A contact will appear here once you start a chat with someone.</p>
        }
        else
        {
            <select id="shareContactSelect" @bind="_selectedContactUserId">
                <option value="">-- select a contact --</option>
                @foreach (var contact in _contacts)
                {
                    <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                }
            </select>
            <select id="shareAccessLevelSelect" @bind="_selectedAccessLevel">
                <option value="ReadOnly">Read-only</option>
                <option value="CanEdit">Can edit</option>
            </select>
            <button type="button" id="shareNoteButton" disabled="@_isSharing" @onclick="ShareAsync">Share</button>
        }
        @if (_shareErrorMessage is not null)
        {
            <p class="error">@_shareErrorMessage</p>
        }
    }
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewNote => Id is null;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSharing;
    private NoteFormModel _formModel = new();
    private bool _isSharedReadOnly;
    private string? _sharedByUserName;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private string? _shareErrorMessage;
    private Guid _ownUserId;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _ownUserId = Guid.Parse(authenticationState.User.FindFirst("sub")!.Value);

        if (Id is { } noteId)
        {
            Logger.LogInformation("Note editor opened for note {NoteId}", noteId);
            try
            {
                var note = await NotesApiClient.GetNoteByIdAsync(noteId);
                if (note is not null)
                {
                    _formModel = new NoteFormModel { Title = note.Title, Content = note.Content };
                    _isSharedReadOnly = note.IsShared && note.AccessLevel == "ReadOnly";
                    _sharedByUserName = note.SharedByUserName;
                }

                _contacts = await ChatApiClient.GetContactsAsync();
            }
            catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
                // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
                // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
                NavigationManager.NavigateTo("/login");
                return;
            }
        }
        else
        {
            Logger.LogInformation("Note editor opened for a new note");
        }

        _isLoading = false;
    }

    private async Task SaveAsync()
    {
        Logger.LogInformation(
            "User clicked 'Save' ({Mode}, NoteId={NoteId})", IsNewNote ? "create" : "update", Id);

        // Blocks the button for the duration of the save (see the button above), so a second click or a
        // double Enter-press can't fire this again while the first request is still in flight and create
        // a duplicate note.
        _isSaving = true;
        try
        {
            if (IsNewNote)
            {
                var newNoteId = await NotesApiClient.CreateNoteAsync(new CreateNoteRequest(_formModel.Title, _formModel.Content));
                Logger.LogInformation("Note {NoteId} created", newNoteId);
            }
            else
            {
                await NotesApiClient.UpdateNoteAsync(Id!.Value, new UpdateNoteRequest(_formModel.Title, _formModel.Content));
                Logger.LogInformation("Note {NoteId} updated", Id);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to {Mode} note {NoteId}", IsNewNote ? "create" : "update", Id);
            return;
        }
        finally
        {
            _isSaving = false;
        }

        NavigationManager.NavigateTo("/notes");
    }

    /// <summary>
    /// Shares the already-saved note with the selected contact and notifies them with an encrypted chat
    /// message carrying an "Accept" action (see NoteShareMessagePayload) - mirrors
    /// CalendarEventEditor.ShareWithNewlyAddedContactsAsync, minus the "defer until Save" batching, since
    /// notes have no "guests" field to piggyback the share list on.
    /// </summary>
    private async Task ShareAsync()
    {
        if (!Guid.TryParse(_selectedContactUserId, out var recipientUserId) || Id is not { } noteId)
        {
            return;
        }

        _shareErrorMessage = null;
        _isSharing = true;
        try
        {
            var shareId = await NotesApiClient.ShareNoteAsync(noteId, recipientUserId, _selectedAccessLevel);
            if (shareId is null)
            {
                _shareErrorMessage = "Failed to share the note.";
                return;
            }

            var payloadJson = JsonSerializer.Serialize(new NoteShareMessagePayload(shareId.Value, _formModel.Title));
            await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson);
            _selectedContactUserId = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to share note {NoteId} with user {RecipientUserId}", noteId, recipientUserId);
            _shareErrorMessage = "Failed to share the note.";
        }
        finally
        {
            _isSharing = false;
        }
    }

    private void Cancel()
    {
        Logger.LogInformation("User clicked 'Cancel'");
        NavigationManager.NavigateTo("/notes");
    }

    private sealed class NoteFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }
}
