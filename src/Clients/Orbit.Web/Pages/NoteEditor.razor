    @* Read once each rather than written into the attributes: a string in quotes inside an attribute's
       own quotes is what Razor cannot parse - see the same trap in the task editor. *@
    private string TextStyleLabel => T["Text style"];

    private string TableLabel => T["Table"];

    private string AttachmentLabel => T["Attachment"];

    private string SeparatorLabel => T["Separator"];

    /// <summary>Who else currently holds the edit lock, if anyone - see AcquireLockAsync. Null means this browser holds it (or the note isn't editable at all, so no lock was ever sought).</summary>
    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;

    /// <summary>
    /// How often this browser re-acquires its own edit lock while the editor stays open - well under
    /// AcquireNoteLockCommandHandler's LockDuration (60s) so the lock never lapses under normal network
    /// conditions.
    /// </summary>
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    /// <summary>
    /// Contacts eligible as a share target: everyone except the note's original owner when re-sharing a
    /// received copy - see ShareNoteCommandHandler's class comment for why sharing back to them is
    /// blocked server-side too. Not filtered at all when the current user is the true owner (no
    /// OriginalOwnerUserId to exclude).
    /// </summary>
    private IReadOnlyList<ContactDto> _shareableContacts
        => _originalOwnerUserId is { } originalOwnerUserId
            ? _contacts.Where(contact => contact.UserId != originalOwnerUserId).ToList()
            : _contacts;

    /// <summary>Explains what the current user can do with this shared copy, for the "shared by X" banner.</summary>
    private string SharedAccessDescription => T[_access.Description];

    /// <summary>
    /// Which note is on the surface, so opening another one from the list beside it actually swaps the
    /// note. Blazor keeps the component when only a route parameter changes, so a page that loaded in
    /// OnInitializedAsync would have shown the first note under the second one's address - see
    /// OnParametersSetAsync.
    /// </summary>
    private Guid? _loadedId;

    private bool _hasLoaded;

    /// <summary>
    /// Whether the writing surface is still showing the note before this one. It owns its content from
    /// the moment it appears and nothing about a changed parameter reaches it, so a swap has to be
    /// handed over - see ChecklistTextEditor.SetLinesAsync.
    /// </summary>
    private bool _surfaceNeedsTheNote;

    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoaded && _loadedId == Id)
        {
            return;
        }

        // The note being left behind is not being edited any more, and somebody else may want it.
        if (_hasLoaded && _loadedId is { } previousNoteId)
        {
            // What was written in it and not saved is kept first - see NoteDrafts. Pressing another
            // note in the column beside the writing is moving your eyes, not abandoning this one.
            KeepWhatIsUnsaved(previousNoteId);
            await ReleaseLockAsync(previousNoteId);
        }

        _hasLoaded = true;
        _loadedId = Id;
        _isLoading = true;
        _formModel = new NoteFormModel();
        _isShared = false;
        _isSharedReadOnly = false;
        _canShare = false;
        _canGrantCanEdit = false;
        _canGrantEditOnly = false;
        _access = new SharedItemAccess(IsShared: false, ShareAccessLevel.CanEdit);
        _originalOwnerUserId = null;
        _sharedByUserName = null;
        _lockedByUserName = null;
        _saveErrorMessage = null;
        _shareErrorMessage = null;
        _shareInfoMessage = null;
        _toolBeingExplained = null;
        await LoadTheNoteAsync();
        _surfaceNeedsTheNote = true;
    }

    /// <summary>
    /// The tags this account's notes already carry, so tagging this one is picking a word already in use.
    /// Private notes' come too: the list is opened in this browser. Empty rather than failing when it cannot
    /// be read - a tags box with no suggestions still takes tags, and a note that would not open over a
    /// suggestion list would be a note lost for nothing.
    /// </summary>
    private async Task<IReadOnlyList<string>> KnownNoteTagsAsync()
    {
        try
        {
            return [.. (await NotesApiClient.GetNotesAsync())
                .SelectMany(note => note.AllTags)
                .Distinct(StringComparer.CurrentCultureIgnoreCase)
                .OrderBy(tag => tag, StringComparer.CurrentCultureIgnoreCase)];
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException
            or NotSupportedException or InvalidOperationException)
        {
            Logger.LogWarning(exception, "Failed to read the tags this account's notes already carry");
            return [];
        }
    }

    private async Task LoadTheNoteAsync()
    {
        var currentUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        _ownUserId = currentUserId.Value;
        _knownNoteTags = await KnownNoteTagsAsync();

        if (Id is { } noteId)
        {
            Logger.LogInformation("Note editor opened for note {NoteId}", noteId);
            try
            {
                var note = await NotesApiClient.GetNoteByIdAsync(noteId);
                if (note is not null)
                {
                    _formModel = new NoteFormModel
                    {
                        // Put back together the way it is written: the title as the first line, the
                        // rest after it. Not a checklist line - a title is not something to tick off.
                        Lines = [new NoteContentLineDto(note.Title, false, false), .. note.Content],
                        IsPrivate = note.IsPrivate,
                        Priority = note.Priority,
                        FolderId = note.FolderId,
                        Tags = [.. note.AllTags]
                    };
                    _savedFolderId = note.FolderId;
                    _isShared = note.IsShared;
                    _access = SharedItemAccess.For(note.IsShared, note.AccessLevel);
                    _isSharedReadOnly = note.IsShared && !_access.CanEdit;
                    _canShare = _access.CanShare;
                    _canGrantCanEdit = _access.CanGrantCanEdit;
                    _canGrantEditOnly = _access.CanGrantEditOnly;
                    _originalOwnerUserId = note.OriginalOwnerUserId;
                    _sharedByUserName = note.SharedByUserName;
                    _isArchived = note.IsArchived;
                    StampTheEndIfItHasBeenAWhile(note);

                    if (!_isSharedReadOnly)
                    {
                        await AcquireLockAsync(noteId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(noteId);
                        }
                    }
                }

                _contacts = await ChatApiClient.GetContactsAsync();
            }
            catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
                // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
                // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
                NavigationManager.NavigateTo("/login");
                return;
            }
        }
        else
        {
            Logger.LogInformation("Note editor opened for a new note");
            // Made where the reader is standing: somebody who pressed the plus while reading their
            // "Work" tab means this note to be in Work, and having to file it afterwards is a step that
            // only ever gets skipped. The built-in tabs file nothing - which one a note is in follows
            // from what it is - so from Private what carries over is the thing that puts a note there:
            // it starts sealed, rather than being written in the open and landing under Public.
            await Folders.EnsureLoadedAsync();
            var chosen = Folders.ChosenOn(FolderPage.Notes);
            _formModel.FolderId = chosen.FolderId;
            _formModel.IsPrivate = chosen == FolderKey.Of(BuiltInFolder.Private);
        }

        // What the note says as it is stored, to compare against when this form is left - see
        // KeepWhatIsUnsaved. Taken before any draft is put back, so a draft is still read as unsaved.
        _asStored = WhatTheFormHolds();

        // And what was written here before and never saved, if there is any: the reader left this note
        // for another one and has come back to it. Said out loud - a note that opens saying something
        // the server does not hold has to say why.
        if (Id is { } openedId && Drafts.For(openedId) is { } unsaved)
        {
            _formModel.Lines = unsaved.Lines;
            _formModel.IsPrivate = unsaved.IsPrivate;
            _formModel.Priority = unsaved.Priority;
            _formModel.FolderId = unsaved.FolderId;
            _formModel.Tags = [.. unsaved.Tags];
            _draftMessage = T["What you had written here is back. It still has to be saved."];
        }
        else
        {
            _draftMessage = null;
        }

        _isLoading = false;
    }

    /// <summary>The note as the server holds it, for telling whether this form has been written in.</summary>
    private NoteDrafts.Draft? _asStored;

    /// <summary>
    /// Watches for the page being left, so that writing nobody saved is not thrown away silently - see
    /// NoteDrafts. Held so it can be let go of with the page; a handler left registered would ask about
    /// notes on every navigation for the rest of the session.
    /// </summary>
    private IDisposable? _watchingForTheWayOut;

    protected override void OnInitialized()
        => _watchingForTheWayOut = NavigationManager.RegisterLocationChangingHandler(AskBeforeLeavingAsync);

    /// <summary>
    /// Leaving the editor with writing nobody saved: says which notes it is and lets the reader stop.
    ///
    /// Moving to another note's editor is not leaving - that is the column beside the writing, and what
    /// is in the form is kept for it (see OnParametersSetAsync). Everything else is the way out: the
    /// drafts are named, and going anyway is what throws them away, which is the one moment anybody can
    /// cheaply not do that.
    /// </summary>
    private async ValueTask AskBeforeLeavingAsync(LocationChangingContext leaving)
    {
        if (IsAnotherNotesEditor(leaving.TargetLocation))
        {
            return;
        }

        if (_loadedId is { } noteId)
        {
            KeepWhatIsUnsaved(noteId);
        }

        if (!Drafts.HasAny)
        {
            return;
        }

        var unsaved = string.Join(", ", Drafts.Names);
        if (await Confirms(T.Format("Not saved yet: {0}. Leave and lose what you wrote?", unsaved)))
        {
            Drafts.ForgetEverything();
            return;
        }

        leaving.PreventNavigation();
    }

    /// <summary>Whether this address is another note's own editor - the column beside the writing.</summary>
    private static bool IsAnotherNotesEditor(string target)
        => target.Contains("/notes/", StringComparison.OrdinalIgnoreCase)
            && target.Contains("/edit", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The browser's own question. A confirm rather than a dialog of Orbit's: this is asked while a
    /// navigation is being held, and anything drawn on the page would need the navigation to finish
    /// first to be pressed.
    /// </summary>
    private async Task<bool> Confirms(string question)
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("confirm", question);
        }
        catch (JSException)
        {
            // Nothing to ask with, so the reader is not held on a page they asked to leave.
            return true;
        }
    }

    /// <summary>Said when a note opens holding writing the server does not have - see LoadTheNoteAsync.</summary>
    private string? _draftMessage;

    /// <summary>Everything about this note the form can change, in the shape a draft is kept in.</summary>
    private NoteDrafts.Draft WhatTheFormHolds()
        => new(
            _formModel.Title.Length > 0 ? _formModel.Title : T["Untitled"],
            _formModel.Lines,
            _formModel.IsPrivate,
            _formModel.Priority,
            _formModel.FolderId,
            _formModel.Tags);

    /// <summary>
    /// Keeps what is in the form as this note is left, or drops what was kept for it when the form says
    /// nothing the stored note does not - see NoteDrafts, which decides which of the two it is.
    ///
    /// A note this reader cannot write in is never kept: there is nothing of theirs in it to lose, and a
    /// warning naming it would be about a note they did not change.
    /// </summary>
    private void KeepWhatIsUnsaved(Guid noteId)
    {
        if (_isSharedReadOnly || _lockedByUserName is not null || _asStored is not { } stored)
        {
            return;
        }

        Drafts.Keep(noteId, WhatTheFormHolds(), stored);
    }

    /// <summary>
    /// Opens another note from the column, in place of this one: whatever has not been saved here is not
    /// kept. It replaces this form rather than stacking a second on top of it, so finishing the next one
    /// still ends where this one was opened from, and Back from there does not walk through every note
    /// looked at on the way - see NavigationTrail.
    /// </summary>
    ///
    /// The way back it hands on is this note's own, except when that is this note's page - then it is
    /// that page's way back instead, or finishing the next note would end on this one's page. See
    /// ReturnTo.PastThePageOf.
    private Task GoToNote(Guid noteId)
        => NavigationTrail.FinishAsync(ReturnTo.Link(
            $"/notes/{noteId}/edit",
            Id is { } leaving ? ReturnTo.PastThePageOf(ComeBackTo, $"/notes/{leaving}") : ComeBackTo));

    /// <summary>
    /// Hands the note to the writing surface after a swap. It cannot be done where the note is loaded:
    /// the surface is a child component and does not exist yet on the first pass.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_surfaceNeedsTheNote || _checklistEditorRef is null)
        {
            return;
        }

        _surfaceNeedsTheNote = false;
        await _checklistEditorRef.SetLinesAsync(_formModel.Lines);
    }

    /// <summary>
    /// Mirrors Note.EnsureSomethingToRead, which is what actually refuses the save - a title on its own
    /// is a whole note, and a private one is exempt because its readable fields travel empty by design.
    /// </summary>
    private bool HasSomethingToSave
        => _formModel.IsPrivate
            || _formModel.Lines.Any(line => !string.IsNullOrWhiteSpace(line.Text));

    /// <summary>The folder the note was in when it was read, so a save knows whether it has been moved.</summary>
    private Guid? _savedFolderId;

    private async Task SaveAsync()
    {
        Logger.LogInformation(
            "User clicked 'Save' ({Mode}, NoteId={NoteId})", IsNewNote ? "create" : "update", Id);
        _saveErrorMessage = null;

        // Blocks the button for the duration of the save (see the button above), so a second click or a
        // double Enter-press can't fire this again while the first request is still in flight and create
        // a duplicate note.
        _isSaving = true;
        try
        {
            if (IsNewNote)
            {
                var newNoteId = await NotesApiClient.CreateNoteAsync(new CreateNoteRequest(
                    _formModel.Title, _formModel.Content, _formModel.IsPrivate, Priority: _formModel.Priority,
                    FolderId: _formModel.FolderId, Tags: _formModel.Tags));
                Logger.LogInformation("Note {NoteId} created", newNoteId);
            }
            else
            {
                // Not _formModel.Content: a stamp this opening put at the end and nobody wrote under is
                // taken back out on the way - see WithoutAStampNobodyWroteUnder. It is left on the
                // surface, so the reader can still write under it; what the server keeps is the note.
                var outcome = await NotesApiClient.UpdateNoteAsync(Id!.Value, new UpdateNoteRequest(
                    _formModel.Title, ContentToSave, _formModel.IsPrivate, Priority: _formModel.Priority, Tags: _formModel.Tags,
                    PictureIds: PictureIdsKept));
                if (outcome.Kind == EditOutcomeKind.Locked)
                {
                    _lockedByUserName = outcome.LockedByUserName;
                    StopLockHeartbeat();
                    _saveErrorMessage = T.Format("{0} is currently editing this note - try again in a moment.", outcome.LockedByUserName);
                    return;
                }

                if (outcome.Kind == EditOutcomeKind.Refused)
                {
                    _saveErrorMessage = outcome.Reason;
                    return;
                }

                if (outcome.Kind == EditOutcomeKind.NotFound)
                {
                    _saveErrorMessage = T["Failed to save the note. Try again."];
                    return;
                }

                Logger.LogInformation("Note {NoteId} updated", Id);
                // Filing travels separately from the note itself - see MoveToFolderRequest - so it is
                // sent only when it actually changed, rather than on every save. The answer is read for
                // the reason TaskEditor's own copy of this gives at length.
                if (_formModel.FolderId != _savedFolderId)
                {
                    if (await NotesApiClient.MoveToFolderAsync(Id.Value, _formModel.FolderId))
                    {
                        _savedFolderId = _formModel.FolderId;
                    }
                    else
                    {
                        Logger.LogWarning(
                            "Note {NoteId} was saved but could not be filed under folder {FolderId}",
                            Id, _formModel.FolderId);
                        _saveErrorMessage = T["The note was saved, but it couldn't be filed under that folder. Choose it again."];
                        return;
                    }
                }

                await ReleaseLockAsync(Id.Value);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to {Mode} note {NoteId}", IsNewNote ? "create" : "update", Id);
            _saveErrorMessage = T["Failed to save the note. Try again."];
            return;
        }
        finally
        {
            _isSaving = false;
        }

        // Saved is saved: there is nothing unsaved left in this note to warn about or to put back the
        // next time it is opened - see NoteDrafts. What the server holds is now what the form holds, and
        // saying so is what stops the way out from asking about the note that was just saved: leaving
        // compares the form against this, and a copy taken when the note was opened would read every
        // saved change as unsaved writing.
        _asStored = WhatTheFormHolds();
        if (Id is { } savedNoteId)
        {
            Drafts.Forget(savedNoteId);
        }

        _draftMessage = null;

        // Without this form left behind it: Back after saving a new note would open the form again, one
        // press from saving it twice. See NavigationTrail.
        await NavigationTrail.FinishAsync(WhenFinished);
    }

    /// <summary>
    /// Shares the already-saved note with the selected contact and notifies them with an encrypted chat
    /// message carrying an "Accept" action (see NoteShareMessagePayload) - mirrors
    /// CalendarEventEditor.ShareWithNewlyAddedContactsAsync, minus the "defer until Save" batching, since
    /// notes have no "guests" field to piggyback the share list on.
    /// </summary>
    private async Task ShareAsync()
    {
        if (!Guid.TryParse(_selectedContactUserId, out var recipientUserId) || Id is not { } noteId)
        {
            return;
        }

        _shareErrorMessage = null;
        _shareInfoMessage = null;
        _isSharing = true;
        try
        {
            var result = await NotesApiClient.ShareNoteAsync(noteId, recipientUserId, _selectedAccessLevel);
            if (result is null)
            {
                _shareErrorMessage = T["Failed to share the note."];
                return;
            }

            var payloadJson = JsonSerializer.Serialize(new NoteShareMessagePayload(result.ShareId, _formModel.Title));
            await EncryptedChatMessageSender.SendAsync(
                _ownUserId, recipientUserId, payloadJson, isShareInvitation: true, announcesShareId: result.ShareId);
            _shareInfoMessage = result.AlreadyShared ? T["Already shared with that contact - sent a reminder."] : null;
            _selectedContactUserId = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to share note {NoteId} with user {RecipientUserId}", noteId, recipientUserId);
            _shareErrorMessage = T["Failed to share the note."];
        }
        finally
        {
            _isSharing = false;
        }
    }

    /// <summary>
    /// How long a note has to have been left alone before coming back to it counts as coming back to it
    /// rather than carrying on. Asked for as sixteen hours on 2026-09-20 - long enough that a day's
    /// writing is one stretch, short enough that yesterday and today are told apart.
    /// </summary>
    private static readonly TimeSpan LongEnoughToBeANewSitting = TimeSpan.FromHours(16);

    /// <summary>
    /// The stamp put at the end when this note was opened after a long enough gap, or null when none
    /// was. Kept so a save can take it back out again if nothing was written under it - see
    /// <see cref="WithoutAStampNobodyWroteUnder"/>.
    /// </summary>
    private string? _stampWaitingForWriting;

    /// <summary>
    /// A note opened long after it was last written in gets a dated rule at its end and an empty line
    /// under it, with the caret landing there (the surface opens at the end). So what is written next
    /// is written under a line saying when - old writing, the time, new writing - which is what was
    /// asked for on 2026-09-20.
    ///
    /// Only what is already written gets one: a note with nothing in it has no old half to separate
    /// from the new. Only the reader's own, or one they may write in - a stamp on a note held read-only
    /// would be a change nobody can save. And it is taken back out on the way to the server if nothing
    /// was written under it, which is the "if new text was added" half of the ask: opening a note and
    /// leaving without writing must not add a line to it.
    /// </summary>
    private void StampTheEndIfItHasBeenAWhile(NoteDto note)
    {
        if (_isSharedReadOnly
            || DateTimeOffset.UtcNow - note.UpdatedAtUtc < LongEnoughToBeANewSitting
            || _formModel.Lines.All(line => line.Text.Length == 0 && line.Table is null
                && line.Picture is null && line.Separator is null))
        {
            return;
        }

        // The same words the separator tool writes - see InsertSeparatorAsync. Written once, here,
        // and stored as words rather than as an instant: see NoteSeparatorLine.Stamp.
        var stamp = DateTime.Now.ToString("f", CultureInfo.CurrentCulture);
        _formModel.Lines =
        [
            .. _formModel.Lines,
            new NoteContentLineDto(string.Empty, IsChecklistItem: false, IsChecked: false,
                Separator: new NoteSeparatorLineDto(stamp)),
            new NoteContentLineDto(string.Empty, IsChecklistItem: false, IsChecked: false)
        ];
        _stampWaitingForWriting = stamp;
    }

    /// <summary>
    /// What to send: the lines as they are, unless the stamp this opening added is still the last thing
    /// in the note with nothing but blank lines under it - then it goes, along with those blank lines.
    /// A reader who opened an old note, changed a word higher up and saved gets the stamp taken out
    /// too, which is right: the stamp says "what follows was written now", and nothing follows it.
    /// </summary>
    private IReadOnlyList<NoteContentLineDto> WithoutAStampNobodyWroteUnder(IReadOnlyList<NoteContentLineDto> lines)
    {
        if (_stampWaitingForWriting is not { } stamp)
        {
            return lines;
        }

        var stampedAt = -1;
        for (var at = lines.Count - 1; at >= 0; at--)
        {
            if (lines[at].Separator?.Stamp == stamp)
            {
                stampedAt = at;
                break;
            }

            // Anything written under it - a word, a picture, a table, another rule - means it is doing
            // its job and stays.
            if (lines[at].Text.Length > 0 || lines[at].Table is not null
                || lines[at].Picture is not null || lines[at].Separator is not null
                || lines[at].IsChecklistItem)
            {
                return lines;
            }
        }

        return stampedAt < 0 ? lines : [.. lines.Take(stampedAt)];
    }

    /// <summary>Everything after the title, as the server takes it, with an unused stamp left out.</summary>
    private IReadOnlyList<NoteContentLineDto> ContentToSave
        => [.. WithoutAStampNobodyWroteUnder(_formModel.Lines).Skip(1)];

    /// <summary>Every note of this reader's, which is where this form's menu leads back to.</summary>
    private void GoToNotes() => NavigationManager.NavigateTo("/notes");

    /// <summary>
    /// Puts the note away, or takes it back out. Said on the page when it fails: a press that quietly
    /// does nothing reads as one that never registered.
    /// </summary>
    private async Task SetArchivedAsync(bool isArchived)
    {
        if (Id is not { } noteId || _isArchiving)
        {
            return;
        }

        _isArchiving = true;
        _saveErrorMessage = null;
        try
        {
            if (await NotesApiClient.SetArchivedAsync(noteId, isArchived))
            {
                _isArchived = isArchived;
                Logger.LogInformation(
                    "Note {NoteId} was {Action}", noteId, isArchived ? "archived" : "put back");
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't change whether note {NoteId} is archived", noteId);
            _saveErrorMessage = T["Couldn't change that. Try again."];
        }
        finally
        {
            _isArchiving = false;
        }
    }

    /// <summary>
    /// Deletes the note - or, for one somebody shared, drops this reader's own grant and leaves the
    /// owner's alone (see DeleteNoteCommandHandler). Asked first, and asked with the name: a note
    /// deleted by accident is gone. It leaves for the notes without this form behind it in the history,
    /// which would otherwise open on a note that no longer exists.
    /// </summary>
    private async Task DeleteAsync()
    {
        if (Id is not { } noteId || _isDeleting)
        {
            return;
        }

        var named = _formModel.Title.Length > 0 ? _formModel.Title : T["Untitled"];
        if (!await JSRuntime.InvokeAsync<bool>(
            "confirm",
            _isShared
                ? T.Format("Remove \"{0}\" from your list? The owner keeps it.", named)
                : T.Format("Delete \"{0}\"?", named)))
        {
            return;
        }

        _isDeleting = true;
        _saveErrorMessage = null;
        try
        {
            // The lock goes first: a note that turns out not to be deletable should not be left held by
            // a form that has gone.
            await ReleaseLockAsync(noteId);
            await NotesApiClient.DeleteNoteAsync(noteId);
            // Nothing is unsaved about a note that no longer exists. Both halves of that: the draft
            // kept for it goes, and the copy the way out compares against becomes what the form holds -
            // otherwise leaving would keep the draft again on its way and ask about a deleted note.
            Drafts.Forget(noteId);
            _asStored = WhatTheFormHolds();
            await NavigationTrail.FinishAfterDeletingAsync($"/notes/{noteId}", WhenFinished, "/notes");
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't delete note {NoteId}", noteId);
            _saveErrorMessage = T["Failed to delete the note. Try again."];
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task CancelAsync()
    {
        Logger.LogInformation("User clicked 'Cancel'");
        if (Id is { } noteId)
        {
            // Cancel is this note's answer to "keep what I wrote?" and the answer is no, so nothing of
            // it is kept for the next time it is opened. Another note's unsaved writing is not this
            // press's business, and the warning on the way out still names it.
            Drafts.Forget(noteId);
            await ReleaseLockAsync(noteId);
        }

        await NavigationTrail.FinishAsync(WhenFinished);
    }

    /// <summary>Starts a new checklist line in the editor - the actual line-splitting/marker logic lives in checklistTextEditor.js.</summary>
    private async Task InsertChecklistItemAsync()
    {
        // The one tool that works, so nothing is left being explained.
        _toolBeingExplained = null;
        if (_checklistEditorRef is not null)
        {
            await _checklistEditorRef.InsertChecklistItemAsync();
        }
    }

    /// <summary>
    /// Acquires (or refreshes) this browser's edit lock on noteId - a no-op call otherwise, since the
    /// server only bothers checking/granting a lock for a note the caller could edit anyway (see
    /// AcquireNoteLockCommandHandler). Sets _lockedByUserName to whoever holds it if someone else does,
    /// or null if this browser now holds it (or the note has become inaccessible - see NotFound).
    /// </summary>
    private async Task AcquireLockAsync(Guid noteId)
    {
        try
        {
            var outcome = await NotesApiClient.AcquireNoteLockAsync(noteId);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Best-effort - if this fails, the lock's own TTL (Note.LockExpiresAtUtc) expires it within a few LockHeartbeatInterval multiples anyway.</summary>
    private async Task ReleaseLockAsync(Guid noteId)
    {
        StopLockHeartbeat();
        if (_isSharedReadOnly)
        {
            return;
        }

        try
        {
            await NotesApiClient.ReleaseNoteLockAsync(noteId);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat(Guid noteId)
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(noteId, _lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(Guid noteId, CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync(noteId);
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    // Our own lock lapsed (e.g. a suspended background tab) and someone else grabbed it -
                    // nothing left to refresh, so stop polling instead of repeatedly re-checking a lock
                    // we no longer hold.
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away or DisposeAsync cancels the heartbeat.
        }
        catch (ObjectDisposedException)
        {
            // The timer was disposed by StopLockHeartbeat between a tick starting and this loop checking again.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _watchingForTheWayOut?.Dispose();

        if (Id is { } noteId)
        {
            await ReleaseLockAsync(noteId);
        }
        else
        {
            StopLockHeartbeat();
        }
    }

    private sealed class NoteFormModel
    {
        /// <summary>
        /// Everything written in the note, first line first. Line one is the title - which is why
        /// there is no separate box for it: a note is written as one thing, and two fields let the
        /// name and the note disagree about what it is called.
        /// </summary>
        public IReadOnlyList<NoteContentLineDto> Lines { get; set; } = [];

        /// <summary>The first line, which is what the note is called everywhere else.</summary>
        public string Title => Lines.Count > 0 ? Lines[0].Text.Trim() : string.Empty;

        /// <summary>Everything after it, which is what the API and the list preview call the content.</summary>
        public IReadOnlyList<NoteContentLineDto> Content => [.. Lines.Skip(1)];

        /// <summary>Encrypt this note so only its owner can read it - see PrivateContentSealer.</summary>
        public bool IsPrivate { get; set; }

        /// <summary>What a note is worth unless somebody says otherwise - see ItemPriority.</summary>
        public const string NormalPriority = "Normal";

        /// <summary>ItemPriority by name, the way the API takes it - see NoteDto.Priority.</summary>
        public string Priority { get; set; } = NormalPriority;

        /// <summary>The folder it is filed under, or null for none - see NoteDto.FolderId.</summary>
        public Guid? FolderId { get; set; }

        /// <summary>The words it is tagged with - see NoteDto.Tags. Always sent, since this form has a box for them.</summary>
        public List<string> Tags { get; set; } = [];
    }
}
