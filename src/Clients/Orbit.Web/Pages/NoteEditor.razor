    [
        NoteLineStyle.Title, NoteLineStyle.Heading, NoteLineStyle.Subheading, NoteLineStyle.Body,
        NoteLineStyle.Monospaced, NoteLineStyle.Bulleted, NoteLineStyle.Dashed, NoteLineStyle.Numbered
    ];

    /// <summary>
    /// The marks offered, in the order every editor puts them in. None is not among them: it is what a
    /// mark this build does not know reads as, never something to ask for - see NoteTextMark.
    /// </summary>
    private static readonly IReadOnlyList<NoteTextMark> MarksOffered =
    [
        NoteTextMark.Bold, NoteTextMark.Italic, NoteTextMark.Underlined, NoteTextMark.StruckThrough
    ];

    private string DescribeMark(NoteTextMark mark) => mark switch
    {
        NoteTextMark.Italic => T["Italic"],
        NoteTextMark.Underlined => T["Underline"],
        NoteTextMark.StruckThrough => T["Strikethrough"],
