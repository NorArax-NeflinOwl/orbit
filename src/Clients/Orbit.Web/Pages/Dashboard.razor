    /// A place is met on the map - there is no page of its own for one - so the row takes its pin with
    /// it and the map opens on that place rather than on wherever it usually opens. See MapPage.Place.
    /// </summary>
    private void GoToPlace(Guid placeId)
    {
        Logger.LogInformation("User clicked a kept place on the dashboard ({PlaceId})", placeId);
        NavigationManager.NavigateTo($"/map?place={placeId}");
    }

    /// <summary>The colour its pin is drawn in, or the one places take when nobody chose - see MapPage.</summary>
    private static string PlaceColour(PlaceDto place)
        => place.Colour.Length > 0 ? place.Colour : "var(--accent)";

    private void GoToInventory(Guid inventoryId)
    {
        Logger.LogInformation("User clicked an inventory on the dashboard ({InventoryId})", inventoryId);
        NavigationManager.NavigateTo(ReturnTo.Link($"/inventory/{inventoryId}", "/"));
    }
}
