@page "/"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Notes
@using Orbit.Contracts.Tasks
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject TasksApiClient TasksApiClient
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard> Logger
@inject Translations T

<PageTitle>Orbit — Dashboard</PageTitle>

<div class="page-header">
    <div>
        <h1>@T["Dashboard"]</h1>
        <p class="page-subtitle">@T["Everything on your plate, in one place."]</p>
    </div>
</div>

@if (_loadErrorMessage is not null)
{
    <p>@_loadErrorMessage</p>
}
else if (_notes is null || _taskLists is null || _events is null || _contacts is null || _groups is null)
{
    <p>@T["Loading…"]</p>
}
else if (_notes.Count == 0 && _taskLists.Count == 0 && _events.Count == 0 && _contacts.Count == 0 && _groups.Count == 0)
{
    <p>@T["Nothing to show."]</p>
}
else
{
    <div class="today-strip">
        <span class="today-strip-date">@DateTime.Today.ToString("dddd, d MMMM", T.DisplayCulture)</span>
        <span class="today-stat"><span class="stat-dot" style="background:var(--task)"></span><strong>@TasksDueTodayCount</strong> tasks due today</span>
        <span class="today-stat"><span class="stat-dot" style="background:var(--accent)"></span><strong>@EventsTodayCount</strong> events today</span>
        <span class="today-stat"><span class="stat-dot" style="background:var(--success)"></span><strong>@PendingChatRequestCount</strong> new chat requests</span>
    </div>

    <div class="card-grid">
        @if (_notes.Count > 0)
        {
            <div class="card">
                <div class="card-header"><span class="card-title">@T["Notes"]</span><span class="card-count">@_notes.Count</span></div>
                @foreach (var note in _notes)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToEditNote(note.Id)">
                        <span class="row-title">@note.Title</span>
                        <span class="row-meta">@FormatRelative(note.UpdatedAtUtc)</span>
                    </button>
                }
            </div>
        }

        @if (_taskLists.Count > 0)
        {
            <div class="card">
                <div class="card-header"><span class="card-title">@T["Tasks"]</span><span class="card-count">@_taskLists.Count lists</span></div>
                @foreach (var taskList in _taskLists)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToTaskList(taskList.Id)">
                        <span class="row-title">@taskList.Title</span>
                        @if (taskList.Items.Count > 0)
                        {
                            <span class="progress-track"><span class="progress-fill" style="width:@(CompletionPercent(taskList))%"></span></span>
                            <span class="row-meta">@taskList.Items.Count(item => item.IsCompleted)/@taskList.Items.Count</span>
                        }
                        else if (taskList.IsCompleted)
                        {
                            <span class="row-meta">@T["Done"]</span>
                        }
                    </button>
                }
            </div>
        }

        @if (_events.Count > 0)
        {
            <div class="card">
                <div class="card-header"><span class="card-title">@T["Upcoming"]</span><span class="card-count">@_events.Count</span></div>
                @foreach (var calendarEvent in _events.OrderBy(e => e.Details.StartUtc).Take(6))
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToEditEvent(calendarEvent.Id)">
                        <span class="stat-dot" style="background:@(string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? "var(--accent)" : calendarEvent.Details.Color)"></span>
                        <span class="row-title">
                            @calendarEvent.Details.Title @(calendarEvent.IsShared ? "(shared)" : "")
                        </span>
                        <span class="row-meta">@FormatEventMeta(calendarEvent.Details)</span>
                    </button>
                }
            </div>
        }

        @if (_groups.Count > 0)
        {
            <div class="card">
                <div class="card-header"><span class="card-title">@T["Groups"]</span><span class="card-count">@_groups.Count</span></div>
                @foreach (var group in _groups)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToGroup(group.Id)">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(group.Id)">@AvatarHelper.GetInitials(group.Name)</span>
                        <span class="row-title">@group.Name</span>
                        @if (group.OwnRole == AdminRole)
                        {
                            <span class="card-badge">@T["Admin"]</span>
                        }
                        <span class="row-meta">@group.Members.Count</span>
                    </button>
                }
            </div>
        }

        @if (_contacts.Count > 0)
        {
            <div class="card">
                <div class="card-header"><span class="card-title">@T["Recent chats"]</span></div>
                @foreach (var contact in _recentContacts.Take(6))
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToChat(contact.UserId)">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)</span>
                        <span class="row-title">@contact.DisplayName</span>
                        <span class="row-meta">@FormatRelative(contact.LastMessageAtUtc)</span>
                    </button>
                }
            </div>

            <div class="card">
                <div class="card-header"><span class="card-title">@T["Contacts"]</span><span class="card-count">@_contactsAlphabetically.Count()</span></div>
                @foreach (var contact in _contactsAlphabetically)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToChat(contact.UserId)">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)</span>
                        <span class="row-title">@contact.DisplayName</span>
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// The UI copy is English throughout, but Blazor WASM derives CultureInfo.CurrentCulture from the
    /// browser's own locale by default - pinning en-US here keeps the day name in sync with the rest of
    /// the page instead of leaking whatever language the visitor's browser is set to (mirrors
    /// Calendar.razor's own DisplayCulture).
    /// </summary>
    private static readonly CultureInfo DisplayCulture = CultureInfo.GetCultureInfo("en-US");

    private IReadOnlyList<NoteDto>? _notes;
    private IReadOnlyList<TaskDto>? _taskLists;
    private IReadOnlyList<CalendarEventDto>? _events;
    private IReadOnlyList<ContactDto>? _contacts;
    private IReadOnlyList<ChatGroupDto>? _groups;

    /// <summary>Matches Orbit.Core.Chat.Groups.ChatGroupRole.Admin, which the API sends by name.</summary>
    private const string AdminRole = "Admin";

    /// <summary>The "Chats" column's ordering - most recently active conversation first.</summary>
    private IEnumerable<ContactDto> _recentContacts
        => (_contacts ?? []).OrderByDescending(contact => contact.LastMessageAtUtc);

    /// <summary>
    /// The "Contacts" column's ordering - a plain directory rather than a recency-based list. Excludes
    /// any conversation that isn't fully established yet (a request either party still needs to approve),
    /// so an unanswered chat only shows up once, in the "Chats" column, instead of in both.
    /// </summary>
    private IEnumerable<ContactDto> _contactsAlphabetically
        => (_contacts ?? [])
        .Where(contact => contact is { RequiresApprovalFromCurrentUser: false, IsPendingApprovalFromOtherParty: false })
        .OrderBy(contact => contact.DisplayName, StringComparer.CurrentCultureIgnoreCase);

    private int TasksDueTodayCount => (_taskLists ?? [])
        .SelectMany(taskList => taskList.Items)
        .Count(item => !item.IsCompleted && item.DueDateUtc is { } due && due.ToLocalTime().Date == DateTime.Today);

    private int EventsTodayCount => (_events ?? [])
        .Count(calendarEvent => calendarEvent.Details.StartUtc.ToLocalTime().Date == DateTime.Today);

    private int PendingChatRequestCount => (_contacts ?? []).Count(contact => contact.RequiresApprovalFromCurrentUser);

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCancellation;
    private string? _loadErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Dashboard opened, loading notes/task lists/events/contacts/groups");
        try
        {
            // Loaded together rather than one after another, so the dashboard's total load time is the
            // slowest single call instead of the sum of all of them.
            await Task.WhenAll(
                LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync(), LoadGroupsAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            // Any other failure (a transient 404/5xx, API unreachable, DNS, ...) used to propagate out
            // of OnInitializedAsync uncaught, crashing the whole WASM renderer - PollOnceAsync already
            // treats the same failure as transient (see its own matching catch below); the initial load
            // should too, showing an error instead of taking the whole page down.
            Logger.LogError(exception, "Failed to load the dashboard");
            _loadErrorMessage = "Couldn't load the dashboard. Check your connection and try again.";
            return;
        }
        Logger.LogInformation(
            "Dashboard loaded {NoteCount} notes, {TaskListCount} task lists, {EventCount} events, {ContactCount} contacts",
            _notes!.Count, _taskLists!.Count, _events!.Count, _contacts!.Count);

        StartPolling();
    }

    private void StartPolling()
    {
        _pollCancellation = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollAsync(_pollCancellation.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await PollOnceAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away and Dispose cancels polling.
        }
    }

    /// <summary>
    /// A single poll tick's worth of work, isolated so a transient failure (a brief server hiccup, or
    /// the session having just expired) only gives up on this one tick instead of silently killing the
    /// whole poll loop - and with it, live updates - for the rest of the time the dashboard stays open.
    /// </summary>
    private async Task PollOnceAsync()
    {
        try
        {
            await Task.WhenAll(LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Session expired while the dashboard was already open and polling - same handling as the
            // initial load in OnInitializedAsync, just reached from the background poll loop instead.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to poll for dashboard updates");
        }
    }

    private async Task LoadNotesAsync() => _notes = await NotesApiClient.GetNotesAsync();

    private async Task LoadTaskListsAsync() => _taskLists = await TasksApiClient.GetTaskListsAsync();

    private async Task LoadEventsAsync() => _events = await CalendarApiClient.GetCalendarEventsAsync();

    private async Task LoadContactsAsync() => _contacts = await ChatApiClient.GetContactsAsync();

    private async Task LoadGroupsAsync() => _groups = await ChatApiClient.GetGroupsAsync();

    private static int CompletionPercent(TaskDto taskList)
        => taskList.Items.Count == 0 ? 0 : (int)Math.Round(100.0 * taskList.Items.Count(item => item.IsCompleted) / taskList.Items.Count);

    /// <summary>A short, human "when" label for a card row - "2h ago" / "Yesterday" / "Wed" / "Aug 12".</summary>
    private static string FormatRelative(DateTimeOffset valueUtc)
    {
        var value = valueUtc.ToLocalTime();
        var now = DateTimeOffset.Now;
        var diff = now - value;

        if (diff < TimeSpan.FromMinutes(1))
        {
            return "just now";
        }
        if (diff < TimeSpan.FromHours(1))
        {
            return $"{(int)diff.TotalMinutes}m ago";
        }
        if (value.Date == now.Date)
        {
            return $"{(int)diff.TotalHours}h ago";
        }
        if (value.Date == now.Date.AddDays(-1))
        {
            return "Yesterday";
        }
        if (diff < TimeSpan.FromDays(7))
        {
            return value.ToString("ddd");
        }
        return value.ToString("MMM d");
    }

    /// <summary>A compact "when" label for an upcoming event row - "Today 10:00" / "Tomorrow 15:30" / "Fri 19:00".</summary>
    private static string FormatEventMeta(CalendarEventDetailsDto details)
    {
        var start = details.StartUtc.ToLocalTime();
        var today = DateTime.Today;
        var dayLabel = start.Date == today ? "Today" : start.Date == today.AddDays(1) ? "Tomorrow" : start.ToString("ddd d");
        return details.IsAllDay ? dayLabel : $"{dayLabel} {start:HH:mm}";
    }

    public void Dispose()
    {
        _pollCancellation?.Cancel();
        _pollTimer?.Dispose();
    }

    private void GoToGroup(Guid groupId)
    {
        Logger.LogInformation("User clicked a group on the dashboard ({GroupId})", groupId);
        NavigationManager.NavigateTo($"/chat/groups/{groupId}");
    }

    private void GoToChat(Guid contactUserId)
    {
        Logger.LogInformation("User clicked a contact on the dashboard ({ContactUserId})", contactUserId);
        NavigationManager.NavigateTo($"/chat/{contactUserId}");
    }

    private void GoToEditNote(Guid noteId)
    {
        Logger.LogInformation("User clicked a note on the dashboard ({NoteId})", noteId);
        NavigationManager.NavigateTo($"/notes/{noteId}");
    }

    /// <summary>
    /// Opens the checklist rather than the full editor. Clicking a list on the dashboard means "let me
    /// get on with it", which is ticking things off - reworking the list's own settings is a deliberate
    /// trip to the editor, one click further on from there.
    /// </summary>
    private void GoToTaskList(Guid taskListId)
    {
        Logger.LogInformation("User clicked a task list on the dashboard ({TaskListId})", taskListId);
        NavigationManager.NavigateTo($"/tasks/{taskListId}/checklist");
    }

    private void GoToEditEvent(Guid eventId)
    {
        Logger.LogInformation("User clicked a calendar event on the dashboard ({EventId})", eventId);
        NavigationManager.NavigateTo($"/calendar/{eventId}");
    }
}
