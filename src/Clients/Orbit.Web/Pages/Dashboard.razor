@page "/"
@attribute [Authorize]
@implements IDisposable
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Users
@using Orbit.Core.Abstractions
@using Orbit.Core.Users
@using Orbit.Contracts.Inventories
@using Orbit.Contracts.Notes
@using Orbit.Contracts.Places
@using Orbit.Contracts.Tasks
@using Orbit.Core.Folders
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject FolderState Folders
@inject InventoryApiClient InventoryApiClient
@inject PlacesApiClient PlacesApiClient
@inject TasksApiClient TasksApiClient
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject UsersApiClient UsersApiClient
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard> Logger
@inject UserPermissionState Permissions
@inject Translations T
@inject DashboardPinService DashboardPins
@inject DashboardCardPreferences CardPreferences
@inject NotificationFeedState NotificationFeed

<PageTitle>@T["Orbit — Dashboard"]</PageTitle>

<PageHeader>
    <Title>@T["Dashboard"]</Title>
    <Description>@T["Everything on your plate, in one place."]</Description>
    <Actions>
        @* Which parts of this page are wanted at all. A menu of settings rather than of actions, so it
           stays open while several are changed - see OverflowMenu.StaysOpen. *@
        <OverflowMenu StaysOpen="true">
            <span class="overflow-menu-heading">@T["Show on the dashboard"]</span>
            @foreach (var part in DashboardParts)
            {
                <label class="avatar-dropdown-item">
                    <input type="checkbox" checked="@CardPreferences.IsVisible(part.Key)"
                           @onchange="args => SetPartVisibleAsync(part.Key, (bool)args.Value!)" />
                    @T[part.Name]
                </label>
            }
        </OverflowMenu>
    </Actions>
</PageHeader>

@if (_loadErrorMessage is not null)
{
    <p>@_loadErrorMessage</p>
}
else if (_notes is null || _taskLists is null || _events is null || _contacts is null || _groups is null
    || _sharedLocations is null || _inventories is null || _places is null)
{
    <Loading />
}
else if (_notes.Count == 0 && _taskLists.Count == 0 && _events.Count == 0 && _contacts.Count == 0 && _groups.Count == 0
    && _inventories.Count == 0 && _places.Count == 0)
{
    <p>@T["Nothing to show."]</p>
}
else
{
    @if (CardPreferences.IsVisible("today"))
    {
        @* The whole strip is the way to the calendar: it is a summary of a day, and the page that shows
           a day is the calendar. A button rather than a link so it reads as one thing to press. *@
        <button type="button" class="today-strip today-strip-button" title="@(T["Open the calendar"])"
                @onclick="GoToCalendar">
            <span class="today-strip-date">@DateTime.Today.ToString("dddd, d MMMM", T.DisplayCulture)</span>
            @* Both counts read "done of all" rather than "how many are left". A bare number answered
               "how much is there" and never "how far through it am I", which is the question somebody
               glancing at a day actually has - and a day whose work is finished says 3/3 rather than
               falling silent. *@
            <span class="today-stat"><span class="stat-dot" style="background:var(--task)"></span><strong>@TasksDoneTodayCount/@TasksDueTodayCount</strong>@T["tasks due today"]</span>
            <span class="today-stat"><span class="stat-dot" style="background:var(--accent)"></span><strong>@EventsOverTodayCount/@EventsTodayCount</strong>@T["events today"]</span>
            @* Only when somebody is actually waiting to be answered. A standing "0 new chat requests" is
               not news, and an account that cannot be found by anyone will never have one. *@
            @if (PendingChatRequestCount > 0)
            {
                <span class="today-stat"><span class="stat-dot" style="background:var(--success)"></span><strong>@PendingChatRequestCount</strong>@T["new chat requests"]</span>
            }
        </button>
    }

    @* The tabs from both of the pages this one gathers, above the two cards they narrow: notes and
       lists are the things that live in folders. Everything else on this page - the day, what is coming
       up, the people - is not filed anywhere and is left alone by it. Read-only, and no Finished tab:
       nothing here is filed from this page, so there is no folder to make - see FolderPages. On a phone
       it folds into one Menu button - see PhoneToolbar, which is nothing at all on a wider screen. *@
    <PhoneToolbar Page="FolderPage.Dashboard">
        <FolderTabs Page="FolderPage.Dashboard" />
    </PhoneToolbar>

    <div class="card-grid">
        @if (NotesUnderTheOpenTab.Count > 0 && ShowsCard("notes"))
        {
            <ItemCard Name="@(T["Notes"])" OnNameSelected='() => NavigationManager.NavigateTo("/notes")'
                      ExtraClass="@(DashboardPins.IsPinned("notes") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("notes")' OnPinnedChanged='pinned => SetCardPinnedAsync("notes", pinned)' />
                </Pin>
                <Menu>
                    <CardFilterMenu Filter='FilterFor("notes")' Options="PinnableOptions" FilterChanged='filter => SetCardFilterAsync("notes", filter)' />
                </Menu>
                <Extras>
                    <span class="card-count">@(NotesToShow.Count)</span>
                </Extras>
                <Body>
                @if (NotesToShow.Count == 0)
                {
                    <p class="empty-hint empty-list">@T["Nothing here matches the filter. Change it above to see the rest."]</p>
                }
                @foreach (var note in NotesToShow)
                {
                    <Row Title="@note.Title" OnPressed="() => GoToNote(note.Id)">
                        <Trailing>
                            @RenderPriorityBadge(note.Priority)
                            <span class="row-meta">@FormatRelative(note.UpdatedAtUtc)</span>
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (TaskListsUnderTheOpenTab.Count > 0 && ShowsCard("tasks"))
        {
                        <ItemCard Name="@(T["Tasks"])" OnNameSelected='() => NavigationManager.NavigateTo("/tasks")'
                      HasUnseenAction="@TaskListsToShow.Any(taskList => HasNewsAbout(taskList.Id, "/tasks"))"
                      ExtraClass="@(DashboardPins.IsPinned("tasks") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("tasks")' OnPinnedChanged='pinned => SetCardPinnedAsync("tasks", pinned)' />
                </Pin>
                <Menu>
                    <CardFilterMenu Filter='FilterFor("tasks")' Options="PinnableOptions" FilterChanged='filter => SetCardFilterAsync("tasks", filter)' />
                </Menu>
                <Extras>
                    <span class="card-count">@(T.Format("{0} lists", TaskListsToShow.Count))</span>
                </Extras>
                <Body>
                @if (TaskListsToShow.Count == 0)
                {
                    <p class="empty-hint empty-list">@T["Nothing here matches the filter. Change it above to see the rest."]</p>
                }
                @foreach (var taskList in TaskListsToShow)
                {
                    @* Struck through where it is finished - which on this card means pinned, since an
                       unpinned finished list is not shown at all. See TaskListsToShow. *@
                    <Row Title="@Written(taskList.Title)" OnPressed="() => GoToTaskList(taskList.Id)"
                         AdditionalClass="@RowClasses(taskList.IsCompleted ? "completed" : null, HasNewsAbout(taskList.Id, "/tasks"))">
                        <Trailing>
                            @RenderPriorityBadge(taskList.Priority)
                            @if (taskList.Items.Count > 0)
                            {
                                <span class="progress-track"><span class="progress-fill" style="width:@(CompletionPercent(taskList))%"></span></span>
                                <span class="row-meta">@taskList.Items.Count(item => item.IsCompleted)/@taskList.Items.Count</span>
                            }
                            else if (taskList.IsCompleted)
                            {
                                <span class="row-meta">@T["Done"]</span>
                            }
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @* Worked out once here rather than read twice below: expanding every recurring event is the
           expensive part of this page, and the card needs both "is anything coming up at all" and
           "what survives the filter". *@
        @{ var everythingUpcoming = Upcoming().ToList(); }
        @* Gated on the first of those, not the second. Gating on the filter was the bug: choosing
           "High" with nothing high coming up removed the whole card, and the filter menu lives in its
           header - so the choice could not be undone from the page that made it. All three cards
           follow the same rule now. *@
        @if (everythingUpcoming.Count > 0 && ShowsCard("upcoming"))
        {
                        <ItemCard Name="@(T["Upcoming"])" OnNameSelected='() => NavigationManager.NavigateTo("/calendar")'
                      HasUnseenAction="@UpcomingToShow.Any(HasNewsAboutIt)"
                      ExtraClass="@(DashboardPins.IsPinned("upcoming") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("upcoming")' OnPinnedChanged='pinned => SetCardPinnedAsync("upcoming", pinned)' />
                </Pin>
                <Menu>
                    <CardFilterMenu Filter='FilterFor("upcoming")' Options="PriorityOptions" FilterChanged='filter => SetCardFilterAsync("upcoming", filter)' />
                </Menu>
                <Extras>
                    <span class="card-count">@(UpcomingToShow.Count)</span>
                </Extras>
                <Body>
                @if (UpcomingToShow.Count == 0)
                {
                    <p class="empty-hint empty-list">@T["Nothing here matches the filter. Change it above to see the rest."]</p>
                }
                @foreach (var entry in UpcomingToShow.Take(6))
                {
                    @* A reminder about an appointment or a deadline points at the thing itself, so the
                       row it is about carries the mark - see HasNewsAboutIt for why a row has two
                       addresses. *@
                    <Row Title="@entry.Title" OnPressed="() => OpenUpcoming(entry)"
                         AdditionalClass="@RowClasses(null, HasNewsAboutIt(entry))">
                        <Leading><span class="stat-dot" style="background:@entry.Colour"></span></Leading>
                        <Trailing>
                            @RenderPriorityBadge(entry.Priority)
                            <span class="row-meta">@entry.When</span>
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @* The shelves themselves, beside the lists they feed. Everything else this page draws was
           reachable from it and this was not, so the one part of Orbit that answers "have we run out"
           could only be found through the side navigation. Nothing here is pinned or prioritised - an
           inventory carries neither - so it has no filter menu, like the locations card below. *@
        @if (InventoriesUnderTheOpenTab.Count > 0 && ShowsCard("inventories"))
        {
            @* The row as well as the card: something about to go off names the storage it is on now
               (InventoryExpiryPushContent), so this says which shelf rather than leaving the reader to
               open all of them. *@
            <ItemCard Name="@(T["Inventory"])" OnNameSelected='() => NavigationManager.NavigateTo("/inventory")'
                      HasUnseenAction="@NotificationFeed.HasNewsAbout("/inventory")"
                      ExtraClass="@(DashboardPins.IsPinned("inventories") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("inventories")' OnPinnedChanged='pinned => SetCardPinnedAsync("inventories", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(InventoriesUnderTheOpenTab.Count)</span>
                </Extras>
                <Body>
                @foreach (var inventory in InventoriesUnderTheOpenTab)
                {
                    <Row Title="@inventory.Name" OnPressed="() => GoToInventory(inventory.Id)"
                         AdditionalClass="@RowClasses(null, HasNewsAbout(inventory.Id, "/inventory"))">
                        <Trailing>
                            @if (inventory.IsPrivate)
                            {
                                <span class="card-badge">@T["Private"]</span>
                            }
                            @if (inventory.IsShared)
                            {
                                <span class="card-badge">@T["Shared"]</span>
                            }
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @* Somewhere kept for its own sake, with no date on it and nobody standing there - see
           Orbit.Core.Places.Place. Its own card rather than a row of Upcoming, which is a list of things
           happening at a time. The card and every row go to the map, which is where a place is met: the
           row takes its own pin with it, so pressing one arrives at that place rather than at the map's
           usual view. *@
        @if (_places!.Count > 0 && ShowsCard("places"))
        {
            <ItemCard Name="@(T["Places you keep"])" OnNameSelected='() => NavigationManager.NavigateTo("/map")'
                      ExtraClass="@(DashboardPins.IsPinned("places") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("places")' OnPinnedChanged='pinned => SetCardPinnedAsync("places", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_places.Count)</span>
                </Extras>
                <Body>
                @foreach (var place in _places)
                {
                    <Row Title="@place.Name" OnPressed="() => GoToPlace(place.Id)">
                        @* The same colour as its pin on the map, which is what says which row is which
                           without opening any of them - the map panel's own rows are marked the same. *@
                        <Leading>
                            <span class="map-place-dot" style="background:@PlaceColour(place)" aria-hidden="true"></span>
                        </Leading>
                        <Trailing>
                            @RenderPriorityBadge(place.Priority)
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_groups.Count > 0 && ShowsCard("groups"))
        {
                        <ItemCard Name="@(T["Groups"])" OnNameSelected='() => NavigationManager.NavigateTo("/chat/groups")'
                      HasUnseenAction="@_groups.Any(group => HasNewsAbout(group.Id, "/chat/groups"))"
                      ExtraClass="@(DashboardPins.IsPinned("groups") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("groups")' OnPinnedChanged='pinned => SetCardPinnedAsync("groups", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_groups.Count)</span>
                </Extras>
                <Body>
                @foreach (var group in _groups)
                {
                    @* An invitation to a group points at that group (see ChatGroupInvitationPushContent),
                       so the row it is about can say so rather than leaving the card to say it over all
                       of them. *@
                    <Row Title="@group.Name" OnPressed="() => GoToGroup(group.Id)"
                         AdditionalClass="@RowClasses(null, HasNewsAbout(group.Id, "/chat/groups"))">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(group.Id)">@AvatarHelper.GetInitials(group.Name)</span></Leading>
                        <Trailing>
                            @if (group.OwnRole == AdminRole)
                            {
                                <span class="card-badge">@T["Admin"]</span>
                            }
                            <span class="row-meta">@group.Members.Count</span>
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_sharedLocations!.Count > 0 && ShowsCard("locations"))
        {
            @* The card again, and for the same reason: a shared position points at "/map" and names
               nobody (SharedItemNotifier.UrlFor), so no row here can be the one it means. *@
            <ItemCard Name="@(T["Shared with you"])" OnNameSelected='() => NavigationManager.NavigateTo("/map")'
                      HasUnseenAction="@NotificationFeed.HasNewsAbout("/map")"
                      ExtraClass="@(DashboardPins.IsPinned("locations") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("locations")' OnPinnedChanged='pinned => SetCardPinnedAsync("locations", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_sharedLocations!.Count)</span>
                </Extras>
                <Body>
                @foreach (var share in _sharedLocations!)
                {
                    <Row Title="@DisplayNameFor(share.SharerUserId)" OnPressed="GoToMap">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(share.SharerUserId)">@AvatarHelper.GetInitials(DisplayNameFor(share.SharerUserId))</span></Leading>
                        <Trailing><span class="row-meta">@(share.IsContinuous ? T["live"] : T["sent once"])</span></Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_contacts.Count > 0 && ShowsCard("chats"))
        {
            <ItemCard Name="@(T["Recent chats"])" OnNameSelected='() => NavigationManager.NavigateTo("/contacts")'
                      HasUnseenAction="@_recentContacts.Any(contact => contact.UnreadCount > 0)"
                      ExtraClass="@(DashboardPins.IsPinned("chats") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("chats")' OnPinnedChanged='pinned => SetCardPinnedAsync("chats", pinned)' />
                </Pin>
                <Body>
                @* Who is waiting on you, said here as well as on the chat page - this card is the first
                   thing a visit looks at, and one that knows a message is waiting and does not say so
                   reads as nobody waiting. *@
                @foreach (var contact in _recentContacts.Take(6))
                {
                    <Row Title="@contact.DisplayName" OnPressed="() => GoToChat(contact.UserId)"
                         AdditionalClass="@RowClasses(contact.UnreadCount > 0 ? "unread" : null, contact.UnreadCount > 0)">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<UnreadBadge Count="contact.UnreadCount" /><PresenceDot Status="Conversation.PresenceOf(contact)" /></span></Leading>
                        <Trailing><span class="row-meta">@FormatRelative(contact.LastMessageAtUtc)</span></Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_contacts.Count > 0 && ShowsCard("contacts"))
        {
            <ItemCard Name="@(T["Contacts"])" OnNameSelected='() => NavigationManager.NavigateTo("/contacts")'
                      ExtraClass="@(DashboardPins.IsPinned("contacts") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("contacts")' OnPinnedChanged='pinned => SetCardPinnedAsync("contacts", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_contactsAlphabetically.Count())</span>
                </Extras>
                <Body>
                @* To the person's card, not into a conversation with them - that is what the "Recent
                   chats" card above is for, and two cards that do the same thing are one card. *@
                @foreach (var contact in _contactsAlphabetically)
                {
                    <Row Title="@contact.DisplayName" OnPressed="() => GoToContactInfo(contact.UserId)">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<PresenceDot Status="Conversation.PresenceOf(contact)" /></span></Leading>
                    </Row>
                }
                </Body>
            </ItemCard>
        }
    </div>

    @* A tab that narrows the page down to nothing. Every card is now drawn only where it has something
       under the open tab, so without this an empty folder - or Private on an account that has sealed
       nothing - is a row of tabs above a blank page. *@
    @if (HasNothingUnderTheOpenTab)
    {
        <p class="empty-hint empty-list">
            @(IsReadingWhatIsPrivate ? T["Nothing here is private yet."] : T["This folder is empty."])
        </p>
    }

    @if (!CardPreferences.IsAnythingVisible(DashboardParts.Select(part => part.Key)))
    {
        <p class="empty-hint empty-list">@T["Everything here is hidden. The menu at the top right brings it back."]</p>
    }
}

@code {

    private IReadOnlyList<NoteDto>? _notes;
    private IReadOnlyList<TaskDto>? _taskLists;
    private IReadOnlyList<CalendarEventDto>? _events;
    private IReadOnlyList<ContactDto>? _contacts;
    private IReadOnlyList<ChatGroupDto>? _groups;
    private IReadOnlyList<SharedLocationDto>? _sharedLocations;
    private IReadOnlyList<InventoryDto>? _inventories;

    /// <summary>
    /// Somewhere kept for its own sake - see Orbit.Core.Places.Place. Its own card rather than a corner
    /// of Upcoming: everything on that one is happening at a time, and a place has none, which is the
    /// whole point of it.
    /// </summary>
    private IReadOnlyList<PlaceDto>? _places;

    /// <summary>One part of the dashboard that can be put away, and what the menu calls it.</summary>
    private sealed record DashboardPart(string Key, string Name);

    /// <summary>
    /// Everything the menu offers to hide, in the order the page draws it. The keys are the ones the
    /// cards already carry for pinning, so a card is one thing to both of them.
    /// </summary>
    private static readonly IReadOnlyList<DashboardPart> DashboardParts =
    [
        new("today", "Today"),
        new("notes", "Notes"),
        new("tasks", "Tasks"),
        new("upcoming", "Upcoming"),
        new("inventories", "Inventory"),
        new("places", "Places you keep"),
        new("groups", "Groups"),
        new("locations", "Shared with you"),
        new("chats", "Recent chats"),
        new("contacts", "Contacts")
    ];

    /// <summary>What a card whose items can be pinned offers to filter by.</summary>
    private static readonly IReadOnlyList<DashboardCardFilter> PinnableOptions =
    [
        DashboardCardFilter.All, DashboardCardFilter.Pinned, DashboardCardFilter.HighPriority,
        DashboardCardFilter.NormalPriority, DashboardCardFilter.LowPriority
    ];

    /// <summary>The same, without the pin - a calendar event has a priority but nothing to pin it to.</summary>
    private static readonly IReadOnlyList<DashboardCardFilter> PriorityOptions =
    [
        DashboardCardFilter.All, DashboardCardFilter.HighPriority, DashboardCardFilter.NormalPriority,
        DashboardCardFilter.LowPriority
    ];

    /// <summary>
    /// The notes under the open tab, before the card's own filter has narrowed them. What decides
    /// whether the card is drawn at all: a card with nothing under this tab is not "nothing matches the
    /// filter", it is a card about somewhere the reader is not standing.
    /// </summary>
    private IReadOnlyList<NoteDto> NotesUnderTheOpenTab =>
        [.. (_notes ?? [])
            .Where(note => Folders.ShowsUnderTheChosenTab(FolderPage.Dashboard, note.FolderId, note.IsPrivate))];

    private IReadOnlyList<NoteDto> NotesToShow =>
        [.. NotesUnderTheOpenTab.Where(note => Matches("notes", note.IsPinned, note.Priority))];

    /// <summary>
    /// A finished list is off this card unless it has been pinned. The dashboard is what is still on
    /// your plate, and a list that has been done stays done for as long as it exists - so left in, it
    /// silts the card up with work nobody has to think about again. Pinning is the way to say "keep
    /// this in front of me anyway", and a pinned one that is finished is drawn struck through rather
    /// than looking like the rest.
    ///
    /// There is no Finished tab here to ask for them back - see FolderPages.HasAFinishedTab. That also
    /// means a finished list is placed by its folder, its privacy and nothing else, so a pinned one
    /// stays under the tab its owner filed it under instead of falling out of every tab this page draws.
    /// </summary>
    /// <inheritdoc cref="NotesUnderTheOpenTab"/>
    private IReadOnlyList<TaskDto> TaskListsUnderTheOpenTab =>
        [.. (_taskLists ?? [])
            .Where(taskList => Folders.ShowsUnderTheChosenTab(FolderPage.Dashboard, taskList.FolderId, taskList.IsPrivate))
            .Where(taskList => !taskList.IsCompleted || taskList.IsPinned)];

    private IReadOnlyList<TaskDto> TaskListsToShow =>
        [.. TaskListsUnderTheOpenTab.Where(taskList => Matches("tasks", taskList.IsPinned, taskList.Priority))];

    /// <summary>
    /// The shelves under the open tab. An inventory is not filed into a folder somebody made - there is
    /// no tab for one on the inventory page - but it can be sealed, so Public and Private tell them
    /// apart here the same way they tell notes and lists apart. Without this the Private tab drew every
    /// shelf the account has, which is the opposite of what the tab says.
    /// </summary>
    private IReadOnlyList<InventoryDto> InventoriesUnderTheOpenTab =>
        [.. (_inventories ?? []).Where(inventory => inventory.IsPrivate == IsReadingWhatIsPrivate)];

    private IReadOnlyList<UpcomingEntry> UpcomingToShow =>
        [.. Upcoming().Where(entry => Matches("upcoming", isPinned: false, entry.Priority))];

    /// <summary>
    /// One thing coming up - an event, or a task item with a deadline. Both, because this card and the
    /// calendar answer the same question and were answering it differently: the calendar shows deadlines
    /// beside events, and a card headed "Upcoming" that left them out was not what is coming up.
    /// </summary>
    /// <param name="When">Already written for reading; the sort happens on <paramref name="At"/>.</param>
    /// <param name="Url">Where pressing the row goes.</param>
    /// <param name="NewsUrl">
    /// Where a notification about this row would point, which is not always where the row goes. An
    /// appointment a task list made is opened as that entry - the list is where it is worked from - but
    /// the reminder for it is the event's, and says so (EventReminderPushContent). Reading only the
    /// destination would leave exactly those rows unmarked.
    /// </param>
    private sealed record UpcomingEntry(
        DateTimeOffset At, string Title, string When, string Colour, string Priority, string Url, string NewsUrl);

    /// <summary>
    /// Everything still ahead, soonest first. A recurring event is taken at its next occurrence rather
    /// than at the date it happens to be stored under - the calendar has always drawn it that way (see
    /// CalendarEventOccurrenceExpander), so a weekly standup entered months ago was plainly visible
    /// there and missing from here. Only the next one: this card answers "what is coming up", not "every
    /// time this will ever happen again".
    /// </summary>
    private IEnumerable<UpcomingEntry> Upcoming()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        var entries = (_events ?? [])
            .Where(IsStillToDo)
            .Select(calendarEvent => NextOccurrenceOf(calendarEvent, nowUtc))
            .OfType<CalendarEventDto>()
            .Select(ToUpcomingEntry)
            .Concat(UpcomingDeadlines(nowUtc));
        return entries.OrderBy(entry => entry.At);
    }

    /// <summary>
    /// Whether an appointment is still ahead of the reader rather than done with. An appointment a task
    /// list raised is finished when that entry is ticked off - the entry is where the work is, and the
    /// event is when it happens - so this card was listing appointments somebody had already crossed
    /// off, which is exactly what a card headed "what is coming up" must not do. The calendar's own list
    /// has left them out since 2026-09-06 (see Calendar.IsTickedOff); this asks the same question of the
    /// same lookup.
    ///
    /// A deadline is filtered where it is built - see UpcomingDeadlines.
    /// </summary>
    private bool IsStillToDo(CalendarEventDto calendarEvent)
        => CalendarEventDestination.RaisedBy(calendarEvent.Id, _taskLists) is not ({ Entry.IsCompleted: true } or { Entry.IsFailed: true }
            or { List.IsCompleted: true });

    /// <summary>
    /// How far ahead a repeat is looked for. A year covers what the calendar's own year view shows, and
    /// bounds the walk for a daily event that has been running since forever.
    /// </summary>
    private static readonly TimeSpan UpcomingWindow = TimeSpan.FromDays(365);

    private static CalendarEventDto? NextOccurrenceOf(CalendarEventDto calendarEvent, DateTimeOffset nowUtc)
        => calendarEvent.Details.Recurrence is null
            ? calendarEvent.Details.EndUtc >= nowUtc ? calendarEvent : null
            : CalendarEventOccurrenceExpander
                .ExpandOccurrences(calendarEvent, nowUtc, nowUtc + UpcomingWindow)
                .FirstOrDefault(occurrence => occurrence.Details.EndUtc >= nowUtc);

    /// <summary>
    /// One row on the Upcoming card. An event a task list raised is named "Shopping: Milk", the way a
    /// deadline from the same list already was - this card gathers things from everywhere, so an entry
    /// that does not say where it came from is the one entry on it that has lost something. It also
    /// opens as that list's entry rather than as the event, which it always did.
    /// </summary>
    private UpcomingEntry ToUpcomingEntry(CalendarEventDto calendarEvent)
    {
        var raisedBy = CalendarEventDestination.RaisedBy(calendarEvent.Id, _taskLists);
        var name = raisedBy is { } origin
            ? $"{Written(origin.List.Title)}: {calendarEvent.Details.Title}"
            : calendarEvent.Details.Title;

        return new UpcomingEntry(
            calendarEvent.Details.StartUtc,
            name + (calendarEvent.IsShared ? " " + T["(shared)"] : string.Empty),
            FormatEventMeta(calendarEvent.Details),
            string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? "var(--accent)" : calendarEvent.Details.Color,
            calendarEvent.Details.Priority,
            CalendarEventDestination.For(calendarEvent.Id, _taskLists),
            $"/calendar/{calendarEvent.Id}");
    }

    /// <summary>
    /// The deadlines on task lists, named the way the calendar names them - "Shopping: Milk", since a
    /// card gathering things from everywhere has to say where each one came from. Finished ones are left
    /// out: this is what is still ahead, and something already ticked off is not.
    ///
    /// A row leads to the entry it names rather than to the list it sits on, which is what pressing a
    /// thing means everywhere else - the row said "Shopping: Milk" and opened Shopping. The reminder
    /// behind it still points at the list, so the two addresses differ here and both are carried: see
    /// NewsUrl, which is what decides whether the row is marked.
    /// </summary>
    private IEnumerable<UpcomingEntry> UpcomingDeadlines(DateTimeOffset nowUtc)
        => (_taskLists ?? [])
            .SelectMany(taskList => taskList.Items.Select(item => (taskList, item)))
            // A list somebody closed is closed, whatever is still unticked on it. Marking one finished
            // with work still on it is a way of saying "no more of this" (TaskList.IsMarkedCompleted),
            // and a card headed "what is coming up" that kept listing its deadlines would be arguing.
            .Where(pair => !pair.taskList.IsCompleted)
            .Where(pair => !pair.item.IsCompleted && !pair.item.IsFailed
                && pair.item.AllLinkedTaskListIds.Count == 0
                && pair.item.DueDateUtc is { } dueDate && dueDate >= nowUtc)
            .Select(pair => new UpcomingEntry(
                pair.item.DueDateUtc!.Value,
                $"{Written(pair.taskList.Title)}: {Written(pair.item.Description)}",
                pair.item.DueDateUtc!.Value.LocalDateTime.ToString("dd.MM.yyyy HH:mm"),
                "var(--task)",
                pair.taskList.Priority,
                $"/tasks/{pair.taskList.Id}/items/{pair.item.Id}",
                // A deadline's reminder points at the list it is on, not at the entry the row opens.
                $"/tasks/{pair.taskList.Id}"));

    /// <summary>
    /// The High/Low mark beside a row, when a reader has said this one is not like the others. Normal is
    /// the default and says nothing, so it is drawn as nothing rather than as a badge on every line.
    /// </summary>
    private RenderFragment? RenderPriorityBadge(string priority)
    {
        var parsed = PriorityOf(priority);
        if (parsed == ItemPriority.Normal)
        {
            return null;
        }

        return builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"card-badge card-badge-priority-{parsed.ToString().ToLowerInvariant()}");
            builder.AddContent(2, parsed == ItemPriority.High ? T["High"] : T["Low"]);
            builder.CloseElement();
        };
    }

    /// <summary>
    /// Whether one item survives its card's filter. Priorities arrive as names, the way everything else
    /// crosses the wire - an unreadable one is treated as Normal rather than hidden, since a filter is
    /// no place to make something disappear over a word nobody recognises.
    /// </summary>
    private bool Matches(string cardKey, bool isPinned, string priority) => FilterFor(cardKey) switch
    {
        DashboardCardFilter.Pinned => isPinned,
        DashboardCardFilter.HighPriority => PriorityOf(priority) == ItemPriority.High,
        DashboardCardFilter.NormalPriority => PriorityOf(priority) == ItemPriority.Normal,
        DashboardCardFilter.LowPriority => PriorityOf(priority) == ItemPriority.Low,
        _ => true
    };

    private static ItemPriority PriorityOf(string priority)
        => Enum.TryParse<ItemPriority>(priority, out var parsed) ? parsed : ItemPriority.Normal;

    /// <summary>
    /// What a card is filtered to under the folder tab that is open - each tab keeps its own, see
    /// DashboardCardPreferences.FilterFor.
    /// </summary>
    private DashboardCardFilter FilterFor(string cardKey)
        => CardPreferences.FilterFor(cardKey, Folders.ChosenOn(FolderPage.Dashboard));

    private async Task SetCardFilterAsync(string cardKey, DashboardCardFilter filter)
    {
        var folder = Folders.ChosenOn(FolderPage.Dashboard);
        Logger.LogInformation("User filtered dashboard card {CardKey} to {Filter} under {Folder}", cardKey, filter, folder);
        await CardPreferences.SetFilterAsync(cardKey, folder, filter);
    }

    /// <summary>
    /// Takes one part of the dashboard off this reader's page, or puts it back - on this device, for the
    /// same reason pinning is not stored server-side.
    /// </summary>
    private async Task SetPartVisibleAsync(string cardKey, bool isVisible)
    {
        Logger.LogInformation("User {Action} dashboard card {CardKey}", isVisible ? "showed" : "hid", cardKey);
        await CardPreferences.SetVisibleAsync(cardKey, isVisible);
    }

    /// <summary>
    /// Moves a card to the top of the page for this reader, on this device - see DashboardPinService for
    /// why that is not stored server-side the way a pinned note or task list is.
    /// </summary>
    private async Task SetCardPinnedAsync(string cardKey, bool isPinned)
    {
        Logger.LogInformation("User clicked '{Action}' for dashboard card {CardKey}", isPinned ? "Pin" : "Unpin", cardKey);
        await DashboardPins.SetPinnedAsync(cardKey, isPinned);
    }

    /// <summary>Matches Orbit.Core.Chat.Groups.ChatGroupRole.Admin, which the API sends by name.</summary>
    private const string AdminRole = "Admin";

    /// <summary>The "Chats" column's ordering - most recently active conversation first.</summary>
    private IEnumerable<ContactDto> _recentContacts
        => (_contacts ?? []).OrderByDescending(contact => contact.LastMessageAtUtc);

    /// <summary>
    /// The "Contacts" column's ordering - a plain directory rather than a recency-based list. Excludes
    /// any conversation that isn't fully established yet (a request either party still needs to approve),
    /// so an unanswered chat only shows up once, in the "Chats" column, instead of in both.
    /// </summary>
    private IEnumerable<ContactDto> _contactsAlphabetically
        => (_contacts ?? [])
        .Where(contact => contact is { RequiresApprovalFromCurrentUser: false, IsPendingApprovalFromOtherParty: false })
        .OrderBy(contact => contact.DisplayName, StringComparer.CurrentCultureIgnoreCase);

    /// <summary>
    /// Whether a card is drawn at all. Two answers in one: whether this reader has put it away
    /// (see DashboardCardPreferences), and whether the tab they have open is about it.
    ///
    /// A tab that is a folder somebody made belongs to one kind of thing - recipes are task lists,
    /// receipts are notes - so opening it leaves the card of that kind standing and nothing else. Every
    /// other card is about something the folder cannot hold, and a page that kept drawing them answered
    /// "show me this folder" with the whole dashboard and one card narrowed inside it.
    ///
    /// Private is about one thing too - what is sealed - and only three kinds of card can hold anything
    /// that is: notes, task lists and shelves. An appointment, a person, a group and a shared position
    /// are none of them sealed, so a page that kept drawing those answered "show me what is private"
    /// with a screen mostly made of things that are not. Public is the other half of the same rule and
    /// is left alone: it is where everything is unless it was filed or sealed, which is the whole page.
    /// </summary>
    private bool ShowsCard(string cardKey)
        => CardPreferences.IsVisible(cardKey) && IsAboutTheOpenTab(cardKey);

    /// <summary>Whether the reader is standing in the built-in Private tab - see PrivateCards.</summary>
    private bool IsReadingWhatIsPrivate
        => Folders.ChosenOn(FolderPage.Dashboard) == FolderKey.Of(BuiltInFolder.Private);

    /// <summary>
    /// The only cards that can hold something sealed. Named rather than worked out from the data,
    /// because it is a fact about what Orbit can seal rather than about what this account happens to
    /// have: an empty Private tab must still hide the appointments, not merely draw no notes.
    /// </summary>
    private static readonly IReadOnlySet<string> PrivateCards =
        new HashSet<string>(StringComparer.Ordinal) { "notes", "tasks", "inventories" };

    /// <summary>
    /// Whether the tab that is open narrows the page to nothing at all. Only asked of the tabs that
    /// narrow it - Private, and a folder somebody made - because Public is the whole page, and an
    /// account with nothing in it is answered further up by "Nothing to show".
    /// </summary>
    private bool HasNothingUnderTheOpenTab
        => (IsReadingWhatIsPrivate || Folders.ChosenOn(FolderPage.Dashboard).FolderId is not null)
        && !(NotesUnderTheOpenTab.Count > 0 && IsAboutTheOpenTab("notes"))
        && !(TaskListsUnderTheOpenTab.Count > 0 && IsAboutTheOpenTab("tasks"))
        && !(InventoriesUnderTheOpenTab.Count > 0 && IsAboutTheOpenTab("inventories"));

    private bool IsAboutTheOpenTab(string cardKey)
    {
        if (Folders.ChosenOn(FolderPage.Dashboard).FolderId is not { } folderId)
        {
            return !IsReadingWhatIsPrivate || PrivateCards.Contains(cardKey);
        }

        // A stale id - a folder deleted on its own page while the dashboard held it open - narrows to
        // nothing rather than quietly to the task lists. The row of tabs drops it on the next render.
        return Folders.ScopeOf(folderId) switch
        {
            FolderScope.Notes => cardKey == "notes",
            FolderScope.Tasks => cardKey == "tasks",
            _ => false
        };
    }

    /// <summary>
    /// Everything due today, done or not - the denominator of the strip's fraction. It used to count
    /// only what was still owed, which answered "how much is there" and never "how far through it am
    /// I": a day whose work was all ticked off read "0 tasks due today", which is three tasks that
    /// disappeared rather than three that were done.
    ///
    /// A list closed <b>while work was still unticked on it</b> owes nothing, whatever is left on it -
    /// the same answer the Upcoming card gives. Asked that way round rather than of IsCompleted alone,
    /// which is also true of a list whose entries simply all got ticked - and those are exactly the
    /// entries this fraction exists to show. The phone works it out from the same two facts, which is
    /// why it is not asked of Completion: nothing hands that to the phone.
    /// </summary>
    private int TasksDueTodayCount => EntriesDueToday.Count();

    /// <summary>How many of those are crossed off - the numerator.</summary>
    private int TasksDoneTodayCount => EntriesDueToday.Count(item => item.IsCompleted);

    private IEnumerable<TaskItemDto> EntriesDueToday => (_taskLists ?? [])
        .Where(taskList => !ClosedWithWorkLeft(taskList))
        .SelectMany(taskList => taskList.Items)
        .Where(item => item.DueDateUtc is { } due && due.ToLocalTime().Date == DateTime.Today);

    /// <summary>
    /// Whether the reader has closed this list over entries that are still open. Both clients ask it
    /// this way - see EntriesDueToday.
    /// </summary>
    private static bool ClosedWithWorkLeft(TaskDto taskList)
        => taskList.IsCompleted && taskList.Items.Any(item => !item.IsCompleted && !item.IsFailed);

    private int EventsTodayCount => EventsToday.Count();

    /// <summary>
    /// How many of today's appointments are behind the reader. An event carries no tick of its own, so
    /// "done" is the clock's answer: one that has ended is one nobody has to get to any more.
    /// </summary>
    private int EventsOverTodayCount
        => EventsToday.Count(calendarEvent => calendarEvent.Details.EndUtc.ToLocalTime() <= DateTime.Now);

    private IEnumerable<CalendarEventDto> EventsToday => (_events ?? [])
        .Where(calendarEvent => calendarEvent.Details.StartUtc.ToLocalTime().Date == DateTime.Today);

    /// <summary>
    /// How many conversations somebody else has started and this reader has not answered yet. Zero for
    /// an account without Chat, which cannot answer one and so should not be told about it.
    /// </summary>
    private int PendingChatRequestCount
        => Permissions.Has(ApplicationPermission.Chat)
            ? (_contacts ?? []).Count(contact => contact.RequiresApprovalFromCurrentUser)
            : 0;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCancellation;
    private string? _loadErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Dashboard opened, loading notes/task lists/events/contacts/groups");
        // Before the loads below, which each ask whether this account has unlocked what they are
        // for - asked too early, every gated card would be missing from a page that had them.
        NotificationFeed.Changed += OnNotificationsChanged;
        // The tabs are shared with the notes and the task lists - pressing one there re-filters the two
        // cards here that hold folderable things.
        Folders.Changed += OnFoldersChanged;
        await Permissions.EnsureLoadedAsync();
        await DashboardPins.InitializeAsync();
        await CardPreferences.InitializeAsync();
        try
        {
            // Loaded together rather than one after another, so the dashboard's total load time is the
            // slowest single call instead of the sum of all of them.
            await Task.WhenAll(
                LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync(), LoadGroupsAsync(),
                LoadSharedLocationsAsync(), LoadInventoriesAsync(), LoadPlacesAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            // Any other failure (a transient 404/5xx, API unreachable, DNS, ...) used to propagate out
            // of OnInitializedAsync uncaught, crashing the whole WASM renderer - PollOnceAsync already
            // treats the same failure as transient (see its own matching catch below); the initial load
            // should too, showing an error instead of taking the whole page down.
            Logger.LogError(exception, "Failed to load the dashboard");
            _loadErrorMessage = T["Couldn't load the dashboard. Check your connection and try again."];
            return;
        }
        Logger.LogInformation(
            "Dashboard loaded {NoteCount} notes, {TaskListCount} task lists, {EventCount} events, {ContactCount} contacts",
            _notes!.Count, _taskLists!.Count, _events!.Count, _contacts!.Count);

        StartPolling();
    }

    private void StartPolling()
    {
        _pollCancellation = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollAsync(_pollCancellation.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await PollOnceAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away and Dispose cancels polling.
        }
    }

    /// <summary>
    /// A single poll tick's worth of work, isolated so a transient failure (a brief server hiccup, or
    /// the session having just expired) only gives up on this one tick instead of silently killing the
    /// whole poll loop - and with it, live updates - for the rest of the time the dashboard stays open.
    /// </summary>
    private async Task PollOnceAsync()
    {
        try
        {
            await Task.WhenAll(
                LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync(), LoadSharedLocationsAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Session expired while the dashboard was already open and polling - same handling as the
            // initial load in OnInitializedAsync, just reached from the background poll loop instead.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to poll for dashboard updates");
        }
    }

    private async Task LoadNotesAsync() => _notes = await NotesApiClient.GetNotesAsync();

    private async Task LoadTaskListsAsync() => _taskLists = await TasksApiClient.GetTaskListsAsync();

    private async Task LoadEventsAsync() => _events = await CalendarApiClient.GetCalendarEventsAsync();

    // Not asked at all without the permission for it, rather than asked and refused: the dashboard is
    // one page made of several separate questions, and a card nobody unlocked should be absent, not the
    // reason the whole page says it could not load.
    private async Task LoadContactsAsync()
        => _contacts = Permissions.Has(ApplicationPermission.Contacts) ? await ChatApiClient.GetContactsAsync() : [];

    private async Task LoadGroupsAsync()
        => _groups = Permissions.Has(ApplicationPermission.Chat) ? await ChatApiClient.GetGroupsAsync() : [];

    // Read once when the page opens rather than on every poll tick, the same as the groups above: a
    // shelf changes when somebody edits it, not by itself, and a private one costs a decryption per
    // inventory to read at all.
    private async Task LoadInventoriesAsync() => _inventories = await InventoryApiClient.GetInventoriesAsync();

    /// <summary>
    /// Only behind the permission that draws the map at all: a place is a point, and an account that may
    /// not be shown a map has nowhere to be sent when one is pressed.
    /// </summary>
    private async Task LoadPlacesAsync()
        => _places = Permissions.Has(ApplicationPermission.Location) ? await PlacesApiClient.GetPlacesAsync() : [];

    /// <summary>
    /// Only who is sharing, not where they are. Opening a position means decrypting it, which is the
    /// map page's job and needs this reader's key - the dashboard is a list of what is waiting, so it
    /// says who and sends them there.
    /// </summary>
    private async Task LoadSharedLocationsAsync()
        => _sharedLocations = Permissions.Has(ApplicationPermission.Location) && Permissions.Has(ApplicationPermission.Contacts)
            ? await UsersApiClient.GetLocationsSharedWithMeAsync()
            : [];

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    private static int CompletionPercent(TaskDto taskList)
        => taskList.Items.Count == 0 ? 0 : (int)Math.Round(100.0 * taskList.Items.Count(item => item.IsCompleted) / taskList.Items.Count);

    /// <summary>A short, human "when" label for a card row - "2h ago" / "Yesterday" / "Wed" / "Aug 12".</summary>
    private string FormatRelative(DateTimeOffset valueUtc)
    {
        var value = valueUtc.ToLocalTime();
        var now = DateTimeOffset.Now;
        var diff = now - value;

        if (diff < TimeSpan.FromMinutes(1))
        {
            return T["just now"];
        }
        if (diff < TimeSpan.FromHours(1))
        {
            return T.Format("{0}m ago", (int)diff.TotalMinutes);
        }
        if (value.Date == now.Date)
        {
            return T.Format("{0}h ago", (int)diff.TotalHours);
        }
        if (value.Date == now.Date.AddDays(-1))
        {
            return T["Yesterday"];
        }
        if (diff < TimeSpan.FromDays(7))
        {
            return value.ToString("ddd", T.DisplayCulture);
        }
        return value.ToString("MMM d", T.DisplayCulture);
    }

    /// <summary>A compact "when" label for an upcoming event row - "Today 10:00" / "Tomorrow 15:30" / "Fri 19:00".</summary>
    private string FormatEventMeta(CalendarEventDetailsDto details)
    {
        var start = details.StartUtc.ToLocalTime();
        var today = DateTime.Today;
        var dayLabel = start.Date == today ? T["Today"]
            : start.Date == today.AddDays(1) ? T["Tomorrow"]
            : start.ToString("ddd d", T.DisplayCulture);
        return details.IsAllDay ? dayLabel : $"{dayLabel} {start:HH:mm}";
    }

    /// <summary>
    /// Whether the bell is talking about this particular thing - see NotificationFeedState.HasNewsAbout.
    /// A card saying "something happened here" over a list of six rows leaves the reader to open all six;
    /// this is what lets the row itself say it.
    /// </summary>
    private bool HasNewsAbout(Guid id, string section) => NotificationFeed.HasNewsAbout($"{section}/{id}");

    /// <summary>
    /// The same question for a row on Upcoming, which has two addresses - see UpcomingEntry.NewsUrl.
    /// Both are asked, because for both kinds of row the thing it opens and the thing a reminder about
    /// it names are two different addresses: an appointment a list raised opens as that entry while its
    /// reminder is the event's, and a deadline opens as its entry while its reminder is the list's.
    /// </summary>
    private bool HasNewsAboutIt(UpcomingEntry entry)
        => NotificationFeed.HasNewsAbout(entry.Url) || NotificationFeed.HasNewsAbout(entry.NewsUrl);

    /// <summary>
    /// A row's own classes plus the mark for one with news waiting, dropping the blanks - two conditions
    /// written into one attribute is how a row ended up with class="  unseen" and a rule that did not
    /// match.
    /// </summary>
    private static string? RowClasses(string? existing, bool hasNews)
    {
        var classes = new[] { existing, hasNews ? "row-unseen" : null }.Where(name => !string.IsNullOrEmpty(name));
        var joined = string.Join(' ', classes);
        return joined.Length == 0 ? null : joined;
    }

    private void OnFoldersChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NotificationFeed.Changed -= OnNotificationsChanged;
        Folders.Changed -= OnFoldersChanged;
        _pollCancellation?.Cancel();
        _pollTimer?.Dispose();
    }

    /// <summary>
    /// The bell's own poll lives in MainLayout, and every badge reads the same shared set (see
    /// NotificationFeedState). Subscribing here is what makes a row light up the moment a notification
    /// arrives, and go out the moment it is read, without this page asking the server anything of its own.
    /// </summary>
    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

