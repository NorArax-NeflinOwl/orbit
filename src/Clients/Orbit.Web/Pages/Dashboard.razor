    /// <summary>Matches Orbit.Core.Chat.Groups.ChatGroupRole.Admin, which the API sends by name.</summary>
    private const string AdminRole = "Admin";

    /// <summary>The "Chats" column's ordering - most recently active conversation first.</summary>
    private IEnumerable<ContactDto> _recentContacts
        => (_contacts ?? []).OrderByDescending(contact => contact.LastMessageAtUtc);

    /// <summary>
    /// The "Contacts" column's ordering - a plain directory rather than a recency-based list. Excludes
    /// any conversation that isn't fully established yet (a request either party still needs to approve),
    /// so an unanswered chat only shows up once, in the "Chats" column, instead of in both.
    /// </summary>
    private IEnumerable<ContactDto> _contactsAlphabetically
        => (_contacts ?? [])
        .Where(contact => contact is { RequiresApprovalFromCurrentUser: false, IsPendingApprovalFromOtherParty: false })
        .OrderBy(contact => contact.DisplayName, StringComparer.CurrentCultureIgnoreCase);

    private int TasksDueTodayCount => (_taskLists ?? [])
        .SelectMany(taskList => taskList.Items)
        .Count(item => !item.IsCompleted && item.DueDateUtc is { } due && due.ToLocalTime().Date == DateTime.Today);


    private int EventsTodayCount => (_events ?? [])
        .Count(calendarEvent => calendarEvent.Details.StartUtc.ToLocalTime().Date == DateTime.Today);

    /// <summary>
    /// How many conversations somebody else has started and this reader has not answered yet. Zero for
    /// an account without Chat, which cannot answer one and so should not be told about it.
    /// </summary>
    private int PendingChatRequestCount
        => Permissions.Has(ApplicationPermission.Chat)
            ? (_contacts ?? []).Count(contact => contact.RequiresApprovalFromCurrentUser)
            : 0;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCancellation;
    private string? _loadErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Dashboard opened, loading notes/task lists/events/contacts/groups");
        // Before the loads below, which each ask whether this account has unlocked what they are
        // for - asked too early, every gated card would be missing from a page that had them.
        NotificationFeed.Changed += OnNotificationsChanged;
        await Permissions.EnsureLoadedAsync();
        await DashboardPins.InitializeAsync();
        await CardPreferences.InitializeAsync();
        try
        {
            // Loaded together rather than one after another, so the dashboard's total load time is the
            // slowest single call instead of the sum of all of them.
            await Task.WhenAll(
                LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync(), LoadGroupsAsync(),
                LoadSharedLocationsAsync(), LoadInventoriesAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            // Any other failure (a transient 404/5xx, API unreachable, DNS, ...) used to propagate out
            // of OnInitializedAsync uncaught, crashing the whole WASM renderer - PollOnceAsync already
            // treats the same failure as transient (see its own matching catch below); the initial load
            // should too, showing an error instead of taking the whole page down.
            Logger.LogError(exception, "Failed to load the dashboard");
            _loadErrorMessage = T["Couldn't load the dashboard. Check your connection and try again."];
            return;
        }
        Logger.LogInformation(
            "Dashboard loaded {NoteCount} notes, {TaskListCount} task lists, {EventCount} events, {ContactCount} contacts",
            _notes!.Count, _taskLists!.Count, _events!.Count, _contacts!.Count);

        StartPolling();
    }

    private void StartPolling()
    {
        _pollCancellation = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollAsync(_pollCancellation.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await PollOnceAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away and Dispose cancels polling.
        }
    }

    /// <summary>
    /// A single poll tick's worth of work, isolated so a transient failure (a brief server hiccup, or
    /// the session having just expired) only gives up on this one tick instead of silently killing the
    /// whole poll loop - and with it, live updates - for the rest of the time the dashboard stays open.
    /// </summary>
    private async Task PollOnceAsync()
    {
        try
        {
            await Task.WhenAll(
                LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync(), LoadSharedLocationsAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Session expired while the dashboard was already open and polling - same handling as the
            // initial load in OnInitializedAsync, just reached from the background poll loop instead.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to poll for dashboard updates");
        }
    }

    private async Task LoadNotesAsync() => _notes = await NotesApiClient.GetNotesAsync();

    private async Task LoadTaskListsAsync() => _taskLists = await TasksApiClient.GetTaskListsAsync();

    private async Task LoadEventsAsync() => _events = await CalendarApiClient.GetCalendarEventsAsync();

    // Not asked at all without the permission for it, rather than asked and refused: the dashboard is
    // one page made of several separate questions, and a card nobody unlocked should be absent, not the
    // reason the whole page says it could not load.
    private async Task LoadContactsAsync()
        => _contacts = Permissions.Has(ApplicationPermission.Contacts) ? await ChatApiClient.GetContactsAsync() : [];

    private async Task LoadGroupsAsync()
        => _groups = Permissions.Has(ApplicationPermission.Chat) ? await ChatApiClient.GetGroupsAsync() : [];

    // Read once when the page opens rather than on every poll tick, the same as the groups above: a
    // shelf changes when somebody edits it, not by itself, and a private one costs a decryption per
    // inventory to read at all.
    private async Task LoadInventoriesAsync() => _inventories = await InventoryApiClient.GetInventoriesAsync();

    /// <summary>
    /// Only who is sharing, not where they are. Opening a position means decrypting it, which is the
    /// map page's job and needs this reader's key - the dashboard is a list of what is waiting, so it
    /// says who and sends them there.
    /// </summary>
    private async Task LoadSharedLocationsAsync()
        => _sharedLocations = Permissions.Has(ApplicationPermission.Location) && Permissions.Has(ApplicationPermission.Contacts)
            ? await UsersApiClient.GetLocationsSharedWithMeAsync()
            : [];

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    private static int CompletionPercent(TaskDto taskList)
        => taskList.Items.Count == 0 ? 0 : (int)Math.Round(100.0 * taskList.Items.Count(item => item.IsCompleted) / taskList.Items.Count);

    /// <summary>A short, human "when" label for a card row - "2h ago" / "Yesterday" / "Wed" / "Aug 12".</summary>
    private string FormatRelative(DateTimeOffset valueUtc)
    {
        var value = valueUtc.ToLocalTime();
        var now = DateTimeOffset.Now;
        var diff = now - value;

        if (diff < TimeSpan.FromMinutes(1))
        {
            return T["just now"];
        }
        if (diff < TimeSpan.FromHours(1))
        {
            return T.Format("{0}m ago", (int)diff.TotalMinutes);
        }
        if (value.Date == now.Date)
        {
            return T.Format("{0}h ago", (int)diff.TotalHours);
        }
        if (value.Date == now.Date.AddDays(-1))
        {
            return T["Yesterday"];
        }
        if (diff < TimeSpan.FromDays(7))
        {
            return value.ToString("ddd", T.DisplayCulture);
        }
        return value.ToString("MMM d", T.DisplayCulture);
    }

    /// <summary>A compact "when" label for an upcoming event row - "Today 10:00" / "Tomorrow 15:30" / "Fri 19:00".</summary>
    private string FormatEventMeta(CalendarEventDetailsDto details)
    {
        var start = details.StartUtc.ToLocalTime();
        var today = DateTime.Today;
        var dayLabel = start.Date == today ? T["Today"]
            : start.Date == today.AddDays(1) ? T["Tomorrow"]
            : start.ToString("ddd d", T.DisplayCulture);
        return details.IsAllDay ? dayLabel : $"{dayLabel} {start:HH:mm}";
    }

    /// <summary>
    /// Whether the bell is talking about this particular thing - see NotificationFeedState.HasNewsAbout.
    /// A card saying "something happened here" over a list of six rows leaves the reader to open all six;
    /// this is what lets the row itself say it.
    /// </summary>
    private bool HasNewsAbout(Guid id, string section) => NotificationFeed.HasNewsAbout($"{section}/{id}");

    /// <summary>
    /// The same question for a row on Upcoming, which has two addresses - see UpcomingEntry.NewsUrl.
    /// Both are asked: the destination catches a reminder about the list an entry sits on, and the
    /// news address catches the one about the appointment itself.
    /// </summary>
    private bool HasNewsAboutIt(UpcomingEntry entry)
        => NotificationFeed.HasNewsAbout(entry.Url) || NotificationFeed.HasNewsAbout(entry.NewsUrl);

    /// <summary>
    /// A row's own classes plus the mark for one with news waiting, dropping the blanks - two conditions
    /// written into one attribute is how a row ended up with class="  unseen" and a rule that did not
    /// match.
    /// </summary>
    private static string? RowClasses(string? existing, bool hasNews)
    {
        var classes = new[] { existing, hasNews ? "row-unseen" : null }.Where(name => !string.IsNullOrEmpty(name));
        var joined = string.Join(' ', classes);
        return joined.Length == 0 ? null : joined;
    }

    public void Dispose()
    {
        NotificationFeed.Changed -= OnNotificationsChanged;
        _pollCancellation?.Cancel();
        _pollTimer?.Dispose();
    }

    /// <summary>
    /// The bell's own poll lives in MainLayout, and every badge reads the same shared set (see
    /// NotificationFeedState). Subscribing here is what makes a row light up the moment a notification
    /// arrives, and go out the moment it is read, without this page asking the server anything of its own.
    /// </summary>
    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
