@page "/"
@attribute [Authorize]
@implements IDisposable
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Users
@using Orbit.Core.Abstractions
@using Orbit.Core.Users
@using Orbit.Contracts.Notes
@using Orbit.Contracts.Tasks
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject TasksApiClient TasksApiClient
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject UsersApiClient UsersApiClient
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard> Logger
@inject UserPermissionState Permissions
@inject Translations T
@inject DashboardPinService DashboardPins
@inject DashboardCardPreferences CardPreferences

<PageTitle>@T["Orbit — Dashboard"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@T["Dashboard"]</h1>
        <p class="page-subtitle">@T["Everything on your plate, in one place."]</p>
    </div>
    <div class="page-header-actions">
        @* Which parts of this page are wanted at all. A menu of settings rather than of actions, so it
           stays open while several are changed - see OverflowMenu.StaysOpen. *@
        <OverflowMenu StaysOpen="true">
            <span class="overflow-menu-heading">@T["Show on the dashboard"]</span>
            @foreach (var part in DashboardParts)
            {
                <label class="avatar-dropdown-item">
                    <input type="checkbox" checked="@CardPreferences.IsVisible(part.Key)"
                           @onchange="args => SetPartVisibleAsync(part.Key, (bool)args.Value!)" />
                    @T[part.Name]
                </label>
            }
        </OverflowMenu>
    </div>
</div>

@if (_loadErrorMessage is not null)
{
    <p>@_loadErrorMessage</p>
}
else if (_notes is null || _taskLists is null || _events is null || _contacts is null || _groups is null
    || _sharedLocations is null)
{
    <p>@T["Loading…"]</p>
}
else if (_notes.Count == 0 && _taskLists.Count == 0 && _events.Count == 0 && _contacts.Count == 0 && _groups.Count == 0)
{
    <p>@T["Nothing to show."]</p>
}
else
{
    @if (CardPreferences.IsVisible("today"))
    {
        @* The whole strip is the way to the calendar: it is a summary of a day, and the page that shows
           a day is the calendar. A button rather than a link so it reads as one thing to press. *@
        <button type="button" class="today-strip today-strip-button" title="@(T["Open the calendar"])"
                @onclick="GoToCalendar">
            <span class="today-strip-date">@DateTime.Today.ToString("dddd, d MMMM", T.DisplayCulture)</span>
            <span class="today-stat"><span class="stat-dot" style="background:var(--task)"></span><strong>@TasksDueTodayCount</strong>@T["tasks due today"]</span>
            <span class="today-stat"><span class="stat-dot" style="background:var(--accent)"></span><strong>@EventsTodayCount</strong>@T["events today"]</span>
            @* Only when somebody is actually waiting to be answered. A standing "0 new chat requests" is
               not news, and an account that cannot be found by anyone will never have one. *@
            @if (PendingChatRequestCount > 0)
            {
                <span class="today-stat"><span class="stat-dot" style="background:var(--success)"></span><strong>@PendingChatRequestCount</strong>@T["new chat requests"]</span>
            }
        </button>
    }

    <div class="card-grid">
        @if (_notes.Count > 0 && CardPreferences.IsVisible("notes"))
        {
            <div class="card @(DashboardPins.IsPinned("notes") ? "card-pinned" : "")">
                <div class="card-header"><span class="card-title">@T["Notes"]</span><span class="card-header-end"><span class="card-count">@NotesToShow.Count</span><PinButton IsPinned='DashboardPins.IsPinned("notes")' OnPinnedChanged='pinned => SetCardPinnedAsync("notes", pinned)' /><CardFilterMenu Filter='CardPreferences.FilterFor("notes")' Options="PinnableOptions" FilterChanged='filter => SetCardFilterAsync("notes", filter)' /></span></div>
                @foreach (var note in NotesToShow)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToEditNote(note.Id)">
                        <span class="row-title">@note.Title</span>
                        @RenderPriorityBadge(note.Priority)
                        <span class="row-meta">@FormatRelative(note.UpdatedAtUtc)</span>
                    </button>
                }
            </div>
        }

        @if (_taskLists.Count > 0 && CardPreferences.IsVisible("tasks"))
        {
            <div class="card @(DashboardPins.IsPinned("tasks") ? "card-pinned" : "")">
                <div class="card-header"><span class="card-title">@T["Tasks"]</span><span class="card-header-end"><span class="card-count">@T.Format("{0} lists", TaskListsToShow.Count)</span><PinButton IsPinned='DashboardPins.IsPinned("tasks")' OnPinnedChanged='pinned => SetCardPinnedAsync("tasks", pinned)' /><CardFilterMenu Filter='CardPreferences.FilterFor("tasks")' Options="PinnableOptions" FilterChanged='filter => SetCardFilterAsync("tasks", filter)' /></span></div>
                @foreach (var taskList in TaskListsToShow)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToTaskList(taskList.Id)">
                        <span class="row-title">@Written(taskList.Title)</span>
                        @RenderPriorityBadge(taskList.Priority)
                        @if (taskList.Items.Count > 0)
                        {
                            <span class="progress-track"><span class="progress-fill" style="width:@(CompletionPercent(taskList))%"></span></span>
                            <span class="row-meta">@taskList.Items.Count(item => item.IsCompleted)/@taskList.Items.Count</span>
                        }
                        else if (taskList.IsCompleted)
                        {
                            <span class="row-meta">@T["Done"]</span>
                        }
                    </button>
                }
            </div>
        }

        @if (UpcomingToShow.Count > 0 && CardPreferences.IsVisible("upcoming"))
        {
            <div class="card @(DashboardPins.IsPinned("upcoming") ? "card-pinned" : "")">
                <div class="card-header"><span class="card-title">@T["Upcoming"]</span><span class="card-header-end"><span class="card-count">@UpcomingToShow.Count</span><PinButton IsPinned='DashboardPins.IsPinned("upcoming")' OnPinnedChanged='pinned => SetCardPinnedAsync("upcoming", pinned)' /><CardFilterMenu Filter='CardPreferences.FilterFor("upcoming")' Options="PriorityOptions" FilterChanged='filter => SetCardFilterAsync("upcoming", filter)' /></span></div>
                @foreach (var entry in UpcomingToShow.Take(6))
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => NavigationManager.NavigateTo(entry.Url)">
                        <span class="stat-dot" style="background:@entry.Colour"></span>
                        <span class="row-title">@entry.Title</span>
                        @RenderPriorityBadge(entry.Priority)
                        <span class="row-meta">@entry.When</span>
                    </button>
                }
            </div>
        }

        @if (_groups.Count > 0 && CardPreferences.IsVisible("groups"))
        {
            <div class="card @(DashboardPins.IsPinned("groups") ? "card-pinned" : "")">
                <div class="card-header"><span class="card-title">@T["Groups"]</span><span class="card-header-end"><span class="card-count">@_groups.Count</span><PinButton IsPinned='DashboardPins.IsPinned("groups")' OnPinnedChanged='pinned => SetCardPinnedAsync("groups", pinned)' /></span></div>
                @foreach (var group in _groups)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToGroup(group.Id)">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(group.Id)">@AvatarHelper.GetInitials(group.Name)</span>
                        <span class="row-title">@group.Name</span>
                        @if (group.OwnRole == AdminRole)
                        {
                            <span class="card-badge">@T["Admin"]</span>
                        }
                        <span class="row-meta">@group.Members.Count</span>
                    </button>
                }
            </div>
        }

        @if (_sharedLocations!.Count > 0 && CardPreferences.IsVisible("locations"))
        {
            <div class="card @(DashboardPins.IsPinned("locations") ? "card-pinned" : "")">
                <div class="card-header">
                    <span class="card-title">@T["Shared with you"]</span>
                    <span class="card-header-end">
                        <span class="card-count">@_sharedLocations!.Count</span>
                        <PinButton IsPinned='DashboardPins.IsPinned("locations")'
                                   OnPinnedChanged='pinned => SetCardPinnedAsync("locations", pinned)' />
                    </span>
                </div>
                @foreach (var share in _sharedLocations!)
                {
                    <button type="button" class="list-row list-row-button" @onclick="GoToMap">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(share.SharerUserId)">@AvatarHelper.GetInitials(DisplayNameFor(share.SharerUserId))</span>
                        <span class="row-title">@DisplayNameFor(share.SharerUserId)</span>
                        <span class="row-meta">@(share.IsContinuous ? T["live"] : T["sent once"])</span>
                    </button>
                }
            </div>
        }

        @if (_contacts.Count > 0 && CardPreferences.IsVisible("chats"))
        {
            <div class="card @(DashboardPins.IsPinned("chats") ? "card-pinned" : "")">
                <div class="card-header"><span class="card-title">@T["Recent chats"]</span><span class="card-header-end"><PinButton IsPinned='DashboardPins.IsPinned("chats")' OnPinnedChanged='pinned => SetCardPinnedAsync("chats", pinned)' /></span></div>
                @* Who is waiting on you, said here as well as on the chat page - this card is the first
                   thing a visit looks at, and one that knows a message is waiting and does not say so
                   reads as nobody waiting. *@
                @foreach (var contact in _recentContacts.Take(6))
                {
                    <button type="button" class="list-row list-row-button @(contact.UnreadCount > 0 ? "unread" : "")"
                            @onclick="() => GoToChat(contact.UserId)">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<UnreadBadge Count="contact.UnreadCount" /><PresenceDot Status="Conversation.PresenceOf(contact)" /></span>
                        <span class="row-title">@contact.DisplayName</span>
                        <span class="row-meta">@FormatRelative(contact.LastMessageAtUtc)</span>
                    </button>
                }
            </div>
        }

        @if (_contacts.Count > 0 && CardPreferences.IsVisible("contacts"))
        {
            <div class="card @(DashboardPins.IsPinned("contacts") ? "card-pinned" : "")">
                <div class="card-header"><span class="card-title">@T["Contacts"]</span><span class="card-header-end"><span class="card-count">@_contactsAlphabetically.Count()</span><PinButton IsPinned='DashboardPins.IsPinned("contacts")' OnPinnedChanged='pinned => SetCardPinnedAsync("contacts", pinned)' /></span></div>
                @* To the person's card, not into a conversation with them - that is what the "Recent
                   chats" card above is for, and two cards that do the same thing are one card. *@
                @foreach (var contact in _contactsAlphabetically)
                {
                    <button type="button" class="list-row list-row-button" @onclick="() => GoToContactInfo(contact.UserId)">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<PresenceDot Status="Conversation.PresenceOf(contact)" /></span>
                        <span class="row-title">@contact.DisplayName</span>
                    </button>
                }
            </div>
        }
    </div>

    @if (!CardPreferences.IsAnythingVisible(DashboardParts.Select(part => part.Key)))
    {
        <p class="empty-hint">@T["Everything here is hidden. The menu at the top right brings it back."]</p>
    }
}

@code {

    private IReadOnlyList<NoteDto>? _notes;
    private IReadOnlyList<TaskDto>? _taskLists;
    private IReadOnlyList<CalendarEventDto>? _events;
    private IReadOnlyList<ContactDto>? _contacts;
    private IReadOnlyList<ChatGroupDto>? _groups;
    private IReadOnlyList<SharedLocationDto>? _sharedLocations;

    /// <summary>One part of the dashboard that can be put away, and what the menu calls it.</summary>
    private sealed record DashboardPart(string Key, string Name);

    /// <summary>
    /// Everything the menu offers to hide, in the order the page draws it. The keys are the ones the
    /// cards already carry for pinning, so a card is one thing to both of them.
    /// </summary>
    private static readonly IReadOnlyList<DashboardPart> DashboardParts =
    [
        new("today", "Today"),
        new("notes", "Notes"),
        new("tasks", "Tasks"),
        new("upcoming", "Upcoming"),
        new("groups", "Groups"),
        new("locations", "Shared with you"),
        new("chats", "Recent chats"),
        new("contacts", "Contacts")
    ];

    /// <summary>What a card whose items can be pinned offers to filter by.</summary>
    private static readonly IReadOnlyList<DashboardCardFilter> PinnableOptions =
    [
        DashboardCardFilter.All, DashboardCardFilter.Pinned, DashboardCardFilter.HighPriority,
        DashboardCardFilter.NormalPriority, DashboardCardFilter.LowPriority
    ];

    /// <summary>The same, without the pin - a calendar event has a priority but nothing to pin it to.</summary>
    private static readonly IReadOnlyList<DashboardCardFilter> PriorityOptions =
    [
        DashboardCardFilter.All, DashboardCardFilter.HighPriority, DashboardCardFilter.NormalPriority,
        DashboardCardFilter.LowPriority
    ];

    private IReadOnlyList<NoteDto> NotesToShow =>
        [.. (_notes ?? []).Where(note => Matches("notes", note.IsPinned, note.Priority))];

    private IReadOnlyList<TaskDto> TaskListsToShow =>
        [.. (_taskLists ?? []).Where(taskList => Matches("tasks", taskList.IsPinned, taskList.Priority))];

    private IReadOnlyList<UpcomingEntry> UpcomingToShow =>
        [.. Upcoming().Where(entry => Matches("upcoming", isPinned: false, entry.Priority))];

    /// <summary>
    /// One thing coming up - an event, or a task item with a deadline. Both, because this card and the
    /// calendar answer the same question and were answering it differently: the calendar shows deadlines
    /// beside events, and a card headed "Upcoming" that left them out was not what is coming up.
    /// </summary>
    /// <param name="When">Already written for reading; the sort happens on <paramref name="At"/>.</param>
    private sealed record UpcomingEntry(
        DateTimeOffset At, string Title, string When, string Colour, string Priority, string Url);

    /// <summary>
    /// Everything still ahead, soonest first. A recurring event is taken at its next occurrence rather
    /// than at the date it happens to be stored under - the calendar has always drawn it that way (see
    /// CalendarEventOccurrenceExpander), so a weekly standup entered months ago was plainly visible
    /// there and missing from here. Only the next one: this card answers "what is coming up", not "every
    /// time this will ever happen again".
    /// </summary>
    private IEnumerable<UpcomingEntry> Upcoming()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        var entries = (_events ?? [])
            .Select(calendarEvent => NextOccurrenceOf(calendarEvent, nowUtc))
            .OfType<CalendarEventDto>()
            .Select(ToUpcomingEntry)
            .Concat(UpcomingDeadlines(nowUtc));
        return entries.OrderBy(entry => entry.At);
    }

    /// <summary>
    /// How far ahead a repeat is looked for. A year covers what the calendar's own year view shows, and
    /// bounds the walk for a daily event that has been running since forever.
    /// </summary>
    private static readonly TimeSpan UpcomingWindow = TimeSpan.FromDays(365);

    private static CalendarEventDto? NextOccurrenceOf(CalendarEventDto calendarEvent, DateTimeOffset nowUtc)
        => calendarEvent.Details.Recurrence is null
            ? calendarEvent.Details.EndUtc >= nowUtc ? calendarEvent : null
            : CalendarEventOccurrenceExpander
                .ExpandOccurrences(calendarEvent, nowUtc, nowUtc + UpcomingWindow)
                .FirstOrDefault(occurrence => occurrence.Details.EndUtc >= nowUtc);

    private UpcomingEntry ToUpcomingEntry(CalendarEventDto calendarEvent) => new(
        calendarEvent.Details.StartUtc,
        calendarEvent.Details.Title + (calendarEvent.IsShared ? " " + T["(shared)"] : string.Empty),
        FormatEventMeta(calendarEvent.Details),
        string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? "var(--accent)" : calendarEvent.Details.Color,
        calendarEvent.Details.Priority,
        $"/calendar/{calendarEvent.Id}");

    /// <summary>
    /// The deadlines on task lists, named the way the calendar names them - "Shopping: Milk", since a
    /// card gathering things from everywhere has to say where each one came from. Finished ones are left
    /// out: this is what is still ahead, and something already ticked off is not.
    /// </summary>
    private IEnumerable<UpcomingEntry> UpcomingDeadlines(DateTimeOffset nowUtc)
        => (_taskLists ?? [])
            .SelectMany(taskList => taskList.Items.Select(item => (taskList, item)))
            .Where(pair => !pair.item.IsCompleted
                && pair.item.LinkedTaskListId is null
                && pair.item.DueDateUtc is { } dueDate && dueDate >= nowUtc)
            .Select(pair => new UpcomingEntry(
                pair.item.DueDateUtc!.Value,
                $"{Written(pair.taskList.Title)}: {Written(pair.item.Description)}",
                pair.item.DueDateUtc!.Value.LocalDateTime.ToString("dd.MM.yyyy HH:mm"),
                "var(--task)",
                pair.taskList.Priority,
                $"/tasks/{pair.taskList.Id}"));

    /// <summary>
    /// The High/Low mark beside a row, when a reader has said this one is not like the others. Normal is
    /// the default and says nothing, so it is drawn as nothing rather than as a badge on every line.
    /// </summary>
    private RenderFragment? RenderPriorityBadge(string priority)
    {
        var parsed = PriorityOf(priority);
        if (parsed == ItemPriority.Normal)
        {
            return null;
        }

        return builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"card-badge card-badge-priority-{parsed.ToString().ToLowerInvariant()}");
            builder.AddContent(2, parsed == ItemPriority.High ? T["High"] : T["Low"]);
            builder.CloseElement();
        };
    }

    /// <summary>
    /// Whether one item survives its card's filter. Priorities arrive as names, the way everything else
    /// crosses the wire - an unreadable one is treated as Normal rather than hidden, since a filter is
    /// no place to make something disappear over a word nobody recognises.
    /// </summary>
    private bool Matches(string cardKey, bool isPinned, string priority) => CardPreferences.FilterFor(cardKey) switch
    {
        DashboardCardFilter.Pinned => isPinned,
        DashboardCardFilter.HighPriority => PriorityOf(priority) == ItemPriority.High,
        DashboardCardFilter.NormalPriority => PriorityOf(priority) == ItemPriority.Normal,
        DashboardCardFilter.LowPriority => PriorityOf(priority) == ItemPriority.Low,
        _ => true
    };

    private static ItemPriority PriorityOf(string priority)
        => Enum.TryParse<ItemPriority>(priority, out var parsed) ? parsed : ItemPriority.Normal;

    private async Task SetCardFilterAsync(string cardKey, DashboardCardFilter filter)
    {
        Logger.LogInformation("User filtered dashboard card {CardKey} to {Filter}", cardKey, filter);
        await CardPreferences.SetFilterAsync(cardKey, filter);
    }

    /// <summary>
    /// Takes one part of the dashboard off this reader's page, or puts it back - on this device, for the
    /// same reason pinning is not stored server-side.
    /// </summary>
    private async Task SetPartVisibleAsync(string cardKey, bool isVisible)
    {
        Logger.LogInformation("User {Action} dashboard card {CardKey}", isVisible ? "showed" : "hid", cardKey);
        await CardPreferences.SetVisibleAsync(cardKey, isVisible);
    }

    /// <summary>
    /// Moves a card to the top of the page for this reader, on this device - see DashboardPinService for
    /// why that is not stored server-side the way a pinned note or task list is.
    /// </summary>
    private async Task SetCardPinnedAsync(string cardKey, bool isPinned)
    {
        Logger.LogInformation("User clicked '{Action}' for dashboard card {CardKey}", isPinned ? "Pin" : "Unpin", cardKey);
        await DashboardPins.SetPinnedAsync(cardKey, isPinned);
    }

    /// <summary>Matches Orbit.Core.Chat.Groups.ChatGroupRole.Admin, which the API sends by name.</summary>
    private const string AdminRole = "Admin";

    /// <summary>The "Chats" column's ordering - most recently active conversation first.</summary>
    private IEnumerable<ContactDto> _recentContacts
        => (_contacts ?? []).OrderByDescending(contact => contact.LastMessageAtUtc);

    /// <summary>
    /// The "Contacts" column's ordering - a plain directory rather than a recency-based list. Excludes
    /// any conversation that isn't fully established yet (a request either party still needs to approve),
    /// so an unanswered chat only shows up once, in the "Chats" column, instead of in both.
    /// </summary>
    private IEnumerable<ContactDto> _contactsAlphabetically
        => (_contacts ?? [])
        .Where(contact => contact is { RequiresApprovalFromCurrentUser: false, IsPendingApprovalFromOtherParty: false })
        .OrderBy(contact => contact.DisplayName, StringComparer.CurrentCultureIgnoreCase);

    private int TasksDueTodayCount => (_taskLists ?? [])
        .SelectMany(taskList => taskList.Items)
        .Count(item => !item.IsCompleted && item.DueDateUtc is { } due && due.ToLocalTime().Date == DateTime.Today);


    private int EventsTodayCount => (_events ?? [])
        .Count(calendarEvent => calendarEvent.Details.StartUtc.ToLocalTime().Date == DateTime.Today);

    /// <summary>
    /// How many conversations somebody else has started and this reader has not answered yet. Zero for
    /// an account without Chat, which cannot answer one and so should not be told about it.
    /// </summary>
    private int PendingChatRequestCount
        => Permissions.Has(ApplicationPermission.Chat)
            ? (_contacts ?? []).Count(contact => contact.RequiresApprovalFromCurrentUser)
            : 0;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCancellation;
    private string? _loadErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Dashboard opened, loading notes/task lists/events/contacts/groups");
        // Before the loads below, which each ask whether this account has unlocked what they are
        // for - asked too early, every gated card would be missing from a page that had them.
        await Permissions.EnsureLoadedAsync();
        await DashboardPins.InitializeAsync();
        await CardPreferences.InitializeAsync();
        try
        {
            // Loaded together rather than one after another, so the dashboard's total load time is the
            // slowest single call instead of the sum of all of them.
            await Task.WhenAll(
                LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync(), LoadGroupsAsync(),
                LoadSharedLocationsAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            // Any other failure (a transient 404/5xx, API unreachable, DNS, ...) used to propagate out
            // of OnInitializedAsync uncaught, crashing the whole WASM renderer - PollOnceAsync already
            // treats the same failure as transient (see its own matching catch below); the initial load
            // should too, showing an error instead of taking the whole page down.
            Logger.LogError(exception, "Failed to load the dashboard");
            _loadErrorMessage = T["Couldn't load the dashboard. Check your connection and try again."];
            return;
        }
        Logger.LogInformation(
            "Dashboard loaded {NoteCount} notes, {TaskListCount} task lists, {EventCount} events, {ContactCount} contacts",
            _notes!.Count, _taskLists!.Count, _events!.Count, _contacts!.Count);

        StartPolling();
    }

    private void StartPolling()
    {
        _pollCancellation = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollAsync(_pollCancellation.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await PollOnceAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away and Dispose cancels polling.
        }
    }

    /// <summary>
    /// A single poll tick's worth of work, isolated so a transient failure (a brief server hiccup, or
    /// the session having just expired) only gives up on this one tick instead of silently killing the
    /// whole poll loop - and with it, live updates - for the rest of the time the dashboard stays open.
    /// </summary>
    private async Task PollOnceAsync()
    {
        try
        {
            await Task.WhenAll(
                LoadNotesAsync(), LoadTaskListsAsync(), LoadEventsAsync(), LoadContactsAsync(), LoadSharedLocationsAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Session expired while the dashboard was already open and polling - same handling as the
            // initial load in OnInitializedAsync, just reached from the background poll loop instead.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to poll for dashboard updates");
        }
    }

    private async Task LoadNotesAsync() => _notes = await NotesApiClient.GetNotesAsync();

    private async Task LoadTaskListsAsync() => _taskLists = await TasksApiClient.GetTaskListsAsync();

    private async Task LoadEventsAsync() => _events = await CalendarApiClient.GetCalendarEventsAsync();

    // Not asked at all without the permission for it, rather than asked and refused: the dashboard is
    // one page made of several separate questions, and a card nobody unlocked should be absent, not the
    // reason the whole page says it could not load.
    private async Task LoadContactsAsync()
        => _contacts = Permissions.Has(ApplicationPermission.Contacts) ? await ChatApiClient.GetContactsAsync() : [];

    private async Task LoadGroupsAsync()
        => _groups = Permissions.Has(ApplicationPermission.Chat) ? await ChatApiClient.GetGroupsAsync() : [];

    /// <summary>
    /// Only who is sharing, not where they are. Opening a position means decrypting it, which is the
    /// map page's job and needs this reader's key - the dashboard is a list of what is waiting, so it
    /// says who and sends them there.
    /// </summary>
    private async Task LoadSharedLocationsAsync()
        => _sharedLocations = Permissions.Has(ApplicationPermission.Location) && Permissions.Has(ApplicationPermission.Contacts)
            ? await UsersApiClient.GetLocationsSharedWithMeAsync()
            : [];

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(T, name);

    private static int CompletionPercent(TaskDto taskList)
        => taskList.Items.Count == 0 ? 0 : (int)Math.Round(100.0 * taskList.Items.Count(item => item.IsCompleted) / taskList.Items.Count);

    /// <summary>A short, human "when" label for a card row - "2h ago" / "Yesterday" / "Wed" / "Aug 12".</summary>
    private string FormatRelative(DateTimeOffset valueUtc)
    {
        var value = valueUtc.ToLocalTime();
        var now = DateTimeOffset.Now;
        var diff = now - value;

        if (diff < TimeSpan.FromMinutes(1))
        {
            return T["just now"];
        }
        if (diff < TimeSpan.FromHours(1))
        {
            return T.Format("{0}m ago", (int)diff.TotalMinutes);
        }
        if (value.Date == now.Date)
        {
            return T.Format("{0}h ago", (int)diff.TotalHours);
        }
        if (value.Date == now.Date.AddDays(-1))
        {
            return T["Yesterday"];
        }
        if (diff < TimeSpan.FromDays(7))
        {
            return value.ToString("ddd", T.DisplayCulture);
        }
        return value.ToString("MMM d", T.DisplayCulture);
    }

    /// <summary>A compact "when" label for an upcoming event row - "Today 10:00" / "Tomorrow 15:30" / "Fri 19:00".</summary>
    private string FormatEventMeta(CalendarEventDetailsDto details)
    {
        var start = details.StartUtc.ToLocalTime();
        var today = DateTime.Today;
        var dayLabel = start.Date == today ? T["Today"]
            : start.Date == today.AddDays(1) ? T["Tomorrow"]
            : start.ToString("ddd d", T.DisplayCulture);
        return details.IsAllDay ? dayLabel : $"{dayLabel} {start:HH:mm}";
    }

    public void Dispose()
