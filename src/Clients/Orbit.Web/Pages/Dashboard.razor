@page "/"
@attribute [Authorize]
@implements IDisposable
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Users
@using Orbit.Core.Abstractions
@using Orbit.Core.Users
@using Orbit.Contracts.Inventories
@using Orbit.Contracts.Notes
@using Orbit.Contracts.Tasks
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject InventoryApiClient InventoryApiClient
@inject TasksApiClient TasksApiClient
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject UsersApiClient UsersApiClient
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard> Logger
@inject UserPermissionState Permissions
@inject Translations T
@inject DashboardPinService DashboardPins
@inject DashboardCardPreferences CardPreferences
@inject NotificationFeedState NotificationFeed

<PageTitle>@T["Orbit — Dashboard"]</PageTitle>

<PageHeader>
    <Title>@T["Dashboard"]</Title>
    <Subtitle>@T["Everything on your plate, in one place."]</Subtitle>
    <Actions>
        @* Which parts of this page are wanted at all. A menu of settings rather than of actions, so it
           stays open while several are changed - see OverflowMenu.StaysOpen. *@
        <OverflowMenu StaysOpen="true">
            <span class="overflow-menu-heading">@T["Show on the dashboard"]</span>
            @foreach (var part in DashboardParts)
            {
                <label class="avatar-dropdown-item">
                    <input type="checkbox" checked="@CardPreferences.IsVisible(part.Key)"
                           @onchange="args => SetPartVisibleAsync(part.Key, (bool)args.Value!)" />
                    @T[part.Name]
                </label>
            }
        </OverflowMenu>
    </Actions>
</PageHeader>

@if (_loadErrorMessage is not null)
{
    <p>@_loadErrorMessage</p>
}
else if (_notes is null || _taskLists is null || _events is null || _contacts is null || _groups is null
    || _sharedLocations is null || _inventories is null)
{
    <p>@T["Loading…"]</p>
}
else if (_notes.Count == 0 && _taskLists.Count == 0 && _events.Count == 0 && _contacts.Count == 0 && _groups.Count == 0
    && _inventories.Count == 0)
{
    <p>@T["Nothing to show."]</p>
}
else
{
    @if (CardPreferences.IsVisible("today"))
    {
        @* The whole strip is the way to the calendar: it is a summary of a day, and the page that shows
           a day is the calendar. A button rather than a link so it reads as one thing to press. *@
        <button type="button" class="today-strip today-strip-button" title="@(T["Open the calendar"])"
                @onclick="GoToCalendar">
            <span class="today-strip-date">@DateTime.Today.ToString("dddd, d MMMM", T.DisplayCulture)</span>
            <span class="today-stat"><span class="stat-dot" style="background:var(--task)"></span><strong>@TasksDueTodayCount</strong>@T["tasks due today"]</span>
            <span class="today-stat"><span class="stat-dot" style="background:var(--accent)"></span><strong>@EventsTodayCount</strong>@T["events today"]</span>
            @* Only when somebody is actually waiting to be answered. A standing "0 new chat requests" is
               not news, and an account that cannot be found by anyone will never have one. *@
            @if (PendingChatRequestCount > 0)
            {
                <span class="today-stat"><span class="stat-dot" style="background:var(--success)"></span><strong>@PendingChatRequestCount</strong>@T["new chat requests"]</span>
            }
        </button>
    }

    <div class="card-grid">
        @if (_notes.Count > 0 && CardPreferences.IsVisible("notes"))
        {
            <ItemCard Name="@(T["Notes"])" OnNameSelected='() => NavigationManager.NavigateTo("/notes")'
                      ExtraClass="@(DashboardPins.IsPinned("notes") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("notes")' OnPinnedChanged='pinned => SetCardPinnedAsync("notes", pinned)' />
                </Pin>
                <Menu>
                    <CardFilterMenu Filter='CardPreferences.FilterFor("notes")' Options="PinnableOptions" FilterChanged='filter => SetCardFilterAsync("notes", filter)' />
                </Menu>
                <Extras>
                    <span class="card-count">@(NotesToShow.Count)</span>
                </Extras>
                <Body>
                @if (NotesToShow.Count == 0)
                {
                    <p class="empty-hint">@T["Nothing here matches the filter. Change it above to see the rest."]</p>
                }
                @foreach (var note in NotesToShow)
                {
                    <Row Title="@note.Title" OnPressed="() => GoToNote(note.Id)">
                        <Trailing>
                            @RenderPriorityBadge(note.Priority)
                            <span class="row-meta">@FormatRelative(note.UpdatedAtUtc)</span>
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_taskLists.Count > 0 && CardPreferences.IsVisible("tasks"))
        {
                        <ItemCard Name="@(T["Tasks"])" OnNameSelected='() => NavigationManager.NavigateTo("/tasks")'
                      HasUnseenAction="@TaskListsToShow.Any(taskList => HasNewsAbout(taskList.Id, "/tasks"))"
                      ExtraClass="@(DashboardPins.IsPinned("tasks") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("tasks")' OnPinnedChanged='pinned => SetCardPinnedAsync("tasks", pinned)' />
                </Pin>
                <Menu>
                    <CardFilterMenu Filter='CardPreferences.FilterFor("tasks")' Options="PinnableOptions" FilterChanged='filter => SetCardFilterAsync("tasks", filter)' />
                </Menu>
                <Extras>
                    <span class="card-count">@(T.Format("{0} lists", TaskListsToShow.Count))</span>
                </Extras>
                <Body>
                @if (TaskListsToShow.Count == 0)
                {
                    <p class="empty-hint">@T["Nothing here matches the filter. Change it above to see the rest."]</p>
                }
                @foreach (var taskList in TaskListsToShow)
                {
                    @* Struck through where it is finished - which on this card means pinned, since an
                       unpinned finished list is not shown at all. See TaskListsToShow. *@
                    <Row Title="@Written(taskList.Title)" OnPressed="() => GoToTaskList(taskList.Id)"
                         AdditionalClass="@RowClasses(taskList.IsCompleted ? "completed" : null, HasNewsAbout(taskList.Id, "/tasks"))">
                        <Trailing>
                            @RenderPriorityBadge(taskList.Priority)
                            @if (taskList.Items.Count > 0)
                            {
                                <span class="progress-track"><span class="progress-fill" style="width:@(CompletionPercent(taskList))%"></span></span>
                                <span class="row-meta">@taskList.Items.Count(item => item.IsCompleted)/@taskList.Items.Count</span>
                            }
                            else if (taskList.IsCompleted)
                            {
                                <span class="row-meta">@T["Done"]</span>
                            }
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @* Worked out once here rather than read twice below: expanding every recurring event is the
           expensive part of this page, and the card needs both "is anything coming up at all" and
           "what survives the filter". *@
        @{ var everythingUpcoming = Upcoming().ToList(); }
        @* Gated on the first of those, not the second. Gating on the filter was the bug: choosing
           "High" with nothing high coming up removed the whole card, and the filter menu lives in its
           header - so the choice could not be undone from the page that made it. All three cards
           follow the same rule now. *@
        @if (everythingUpcoming.Count > 0 && CardPreferences.IsVisible("upcoming"))
        {
                        <ItemCard Name="@(T["Upcoming"])" OnNameSelected='() => NavigationManager.NavigateTo("/calendar")'
                      HasUnseenAction="@UpcomingToShow.Any(HasNewsAboutIt)"
                      ExtraClass="@(DashboardPins.IsPinned("upcoming") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("upcoming")' OnPinnedChanged='pinned => SetCardPinnedAsync("upcoming", pinned)' />
                </Pin>
                <Menu>
                    <CardFilterMenu Filter='CardPreferences.FilterFor("upcoming")' Options="PriorityOptions" FilterChanged='filter => SetCardFilterAsync("upcoming", filter)' />
                </Menu>
                <Extras>
                    <span class="card-count">@(UpcomingToShow.Count)</span>
                </Extras>
                <Body>
                @if (UpcomingToShow.Count == 0)
                {
                    <p class="empty-hint">@T["Nothing here matches the filter. Change it above to see the rest."]</p>
                }
                @foreach (var entry in UpcomingToShow.Take(6))
                {
                    @* A reminder about an appointment or a deadline points at the thing itself, so the
                       row it is about carries the mark - see HasNewsAboutIt for why a row has two
                       addresses. *@
                    <Row Title="@entry.Title" OnPressed="() => NavigationManager.NavigateTo(entry.Url)"
                         AdditionalClass="@RowClasses(null, HasNewsAboutIt(entry))">
                        <Leading><span class="stat-dot" style="background:@entry.Colour"></span></Leading>
                        <Trailing>
                            @RenderPriorityBadge(entry.Priority)
                            <span class="row-meta">@entry.When</span>
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @* The shelves themselves, beside the lists they feed. Everything else this page draws was
           reachable from it and this was not, so the one part of Orbit that answers "have we run out"
           could only be found through the side navigation. Nothing here is pinned or prioritised - an
           inventory carries neither - so it has no filter menu, like the locations card below. *@
        @if (_inventories.Count > 0 && CardPreferences.IsVisible("inventories"))
        {
            @* The card, not a row: something about to go off says "/inventory" and names no storage
               (InventoryExpiryPushContent), so there is nothing here that could say which shelf. *@
            <ItemCard Name="@(T["Inventory"])" OnNameSelected='() => NavigationManager.NavigateTo("/inventory")'
                      HasUnseenAction="@NotificationFeed.HasNewsAbout("/inventory")"
                      ExtraClass="@(DashboardPins.IsPinned("inventories") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("inventories")' OnPinnedChanged='pinned => SetCardPinnedAsync("inventories", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_inventories.Count)</span>
                </Extras>
                <Body>
                @foreach (var inventory in _inventories)
                {
                    <Row Title="@inventory.Name" OnPressed="() => GoToInventory(inventory.Id)">
                        <Trailing>
                            @if (inventory.IsPrivate)
                            {
                                <span class="card-badge">@T["Private"]</span>
                            }
                            @if (inventory.IsShared)
                            {
                                <span class="card-badge">@T["Shared"]</span>
                            }
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_groups.Count > 0 && CardPreferences.IsVisible("groups"))
        {
                        <ItemCard Name="@(T["Groups"])" OnNameSelected='() => NavigationManager.NavigateTo("/chat/groups")'
                      HasUnseenAction="@_groups.Any(group => HasNewsAbout(group.Id, "/chat/groups"))"
                      ExtraClass="@(DashboardPins.IsPinned("groups") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("groups")' OnPinnedChanged='pinned => SetCardPinnedAsync("groups", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_groups.Count)</span>
                </Extras>
                <Body>
                @foreach (var group in _groups)
                {
                    @* An invitation to a group points at that group (see ChatGroupInvitationPushContent),
                       so the row it is about can say so rather than leaving the card to say it over all
                       of them. *@
                    <Row Title="@group.Name" OnPressed="() => GoToGroup(group.Id)"
                         AdditionalClass="@RowClasses(null, HasNewsAbout(group.Id, "/chat/groups"))">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(group.Id)">@AvatarHelper.GetInitials(group.Name)</span></Leading>
                        <Trailing>
                            @if (group.OwnRole == AdminRole)
                            {
                                <span class="card-badge">@T["Admin"]</span>
                            }
                            <span class="row-meta">@group.Members.Count</span>
                        </Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_sharedLocations!.Count > 0 && CardPreferences.IsVisible("locations"))
        {
            @* The card again, and for the same reason: a shared position points at "/map" and names
               nobody (SharedItemNotifier.UrlFor), so no row here can be the one it means. *@
            <ItemCard Name="@(T["Shared with you"])" OnNameSelected='() => NavigationManager.NavigateTo("/map")'
                      HasUnseenAction="@NotificationFeed.HasNewsAbout("/map")"
                      ExtraClass="@(DashboardPins.IsPinned("locations") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("locations")' OnPinnedChanged='pinned => SetCardPinnedAsync("locations", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_sharedLocations!.Count)</span>
                </Extras>
                <Body>
                @foreach (var share in _sharedLocations!)
                {
                    <Row Title="@DisplayNameFor(share.SharerUserId)" OnPressed="GoToMap">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(share.SharerUserId)">@AvatarHelper.GetInitials(DisplayNameFor(share.SharerUserId))</span></Leading>
                        <Trailing><span class="row-meta">@(share.IsContinuous ? T["live"] : T["sent once"])</span></Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_contacts.Count > 0 && CardPreferences.IsVisible("chats"))
        {
            <ItemCard Name="@(T["Recent chats"])" OnNameSelected='() => NavigationManager.NavigateTo("/contacts")'
                      HasUnseenAction="@_recentContacts.Any(contact => contact.UnreadCount > 0)"
                      ExtraClass="@(DashboardPins.IsPinned("chats") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("chats")' OnPinnedChanged='pinned => SetCardPinnedAsync("chats", pinned)' />
                </Pin>
                <Body>
                @* Who is waiting on you, said here as well as on the chat page - this card is the first
                   thing a visit looks at, and one that knows a message is waiting and does not say so
                   reads as nobody waiting. *@
                @foreach (var contact in _recentContacts.Take(6))
                {
                    <Row Title="@contact.DisplayName" OnPressed="() => GoToChat(contact.UserId)"
                         AdditionalClass="@RowClasses(contact.UnreadCount > 0 ? "unread" : null, contact.UnreadCount > 0)">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<UnreadBadge Count="contact.UnreadCount" /><PresenceDot Status="Conversation.PresenceOf(contact)" /></span></Leading>
                        <Trailing><span class="row-meta">@FormatRelative(contact.LastMessageAtUtc)</span></Trailing>
                    </Row>
                }
                </Body>
            </ItemCard>
        }

        @if (_contacts.Count > 0 && CardPreferences.IsVisible("contacts"))
        {
            <ItemCard Name="@(T["Contacts"])" OnNameSelected='() => NavigationManager.NavigateTo("/contacts")'
                      ExtraClass="@(DashboardPins.IsPinned("contacts") ? "item-card-pinned" : null)">
                <Pin>
                    <PinButton IsPinned='DashboardPins.IsPinned("contacts")' OnPinnedChanged='pinned => SetCardPinnedAsync("contacts", pinned)' />
                </Pin>
                <Extras>
                    <span class="card-count">@(_contactsAlphabetically.Count())</span>
                </Extras>
                <Body>
                @* To the person's card, not into a conversation with them - that is what the "Recent
                   chats" card above is for, and two cards that do the same thing are one card. *@
                @foreach (var contact in _contactsAlphabetically)
                {
                    <Row Title="@contact.DisplayName" OnPressed="() => GoToContactInfo(contact.UserId)">
                        <Leading><span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<PresenceDot Status="Conversation.PresenceOf(contact)" /></span></Leading>
                    </Row>
                }
                </Body>
            </ItemCard>
        }
    </div>

    @if (!CardPreferences.IsAnythingVisible(DashboardParts.Select(part => part.Key)))
    {
        <p class="empty-hint">@T["Everything here is hidden. The menu at the top right brings it back."]</p>
    }
}

@code {

    private IReadOnlyList<NoteDto>? _notes;
    private IReadOnlyList<TaskDto>? _taskLists;
    private IReadOnlyList<CalendarEventDto>? _events;
    private IReadOnlyList<ContactDto>? _contacts;
    private IReadOnlyList<ChatGroupDto>? _groups;
    private IReadOnlyList<SharedLocationDto>? _sharedLocations;
    private IReadOnlyList<InventoryDto>? _inventories;

    /// <summary>One part of the dashboard that can be put away, and what the menu calls it.</summary>
    private sealed record DashboardPart(string Key, string Name);

    /// <summary>
    /// Everything the menu offers to hide, in the order the page draws it. The keys are the ones the
    /// cards already carry for pinning, so a card is one thing to both of them.
    /// </summary>
    private static readonly IReadOnlyList<DashboardPart> DashboardParts =
    [
        new("today", "Today"),
        new("notes", "Notes"),
        new("tasks", "Tasks"),
        new("upcoming", "Upcoming"),
        new("inventories", "Inventory"),
        new("groups", "Groups"),
        new("locations", "Shared with you"),
        new("chats", "Recent chats"),
        new("contacts", "Contacts")
    ];

    /// <summary>What a card whose items can be pinned offers to filter by.</summary>
    private static readonly IReadOnlyList<DashboardCardFilter> PinnableOptions =
    [
        DashboardCardFilter.All, DashboardCardFilter.Pinned, DashboardCardFilter.HighPriority,
        DashboardCardFilter.NormalPriority, DashboardCardFilter.LowPriority
    ];

    /// <summary>The same, without the pin - a calendar event has a priority but nothing to pin it to.</summary>
    private static readonly IReadOnlyList<DashboardCardFilter> PriorityOptions =
    [
        DashboardCardFilter.All, DashboardCardFilter.HighPriority, DashboardCardFilter.NormalPriority,
        DashboardCardFilter.LowPriority
    ];

    private IReadOnlyList<NoteDto> NotesToShow =>
        [.. (_notes ?? []).Where(note => Matches("notes", note.IsPinned, note.Priority))];

    /// <summary>
    /// A finished list is off this card unless it has been pinned. The dashboard is what is still on
    /// your plate, and a list that has been done stays done for as long as it exists - so left in, it
    /// silts the card up with work nobody has to think about again. Pinning is the way to say "keep
    /// this in front of me anyway", and a pinned one that is finished is drawn struck through rather
    /// than looking like the rest.
    /// </summary>
    private IReadOnlyList<TaskDto> TaskListsToShow =>
        [.. (_taskLists ?? [])
            .Where(taskList => !taskList.IsCompleted || taskList.IsPinned)
            .Where(taskList => Matches("tasks", taskList.IsPinned, taskList.Priority))];

    private IReadOnlyList<UpcomingEntry> UpcomingToShow =>
        [.. Upcoming().Where(entry => Matches("upcoming", isPinned: false, entry.Priority))];

    /// <summary>
    /// One thing coming up - an event, or a task item with a deadline. Both, because this card and the
    /// calendar answer the same question and were answering it differently: the calendar shows deadlines
    /// beside events, and a card headed "Upcoming" that left them out was not what is coming up.
    /// </summary>
    /// <param name="When">Already written for reading; the sort happens on <paramref name="At"/>.</param>
    /// <param name="Url">Where pressing the row goes.</param>
    /// <param name="NewsUrl">
    /// Where a notification about this row would point, which is not always where the row goes. An
    /// appointment a task list made is opened as that entry - the list is where it is worked from - but
    /// the reminder for it is the event's, and says so (EventReminderPushContent). Reading only the
    /// destination would leave exactly those rows unmarked.
    /// </param>
    private sealed record UpcomingEntry(
        DateTimeOffset At, string Title, string When, string Colour, string Priority, string Url, string NewsUrl);

    /// <summary>
    /// Everything still ahead, soonest first. A recurring event is taken at its next occurrence rather
    /// than at the date it happens to be stored under - the calendar has always drawn it that way (see
    /// CalendarEventOccurrenceExpander), so a weekly standup entered months ago was plainly visible
    /// there and missing from here. Only the next one: this card answers "what is coming up", not "every
    /// time this will ever happen again".
    /// </summary>
    private IEnumerable<UpcomingEntry> Upcoming()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        var entries = (_events ?? [])
            .Select(calendarEvent => NextOccurrenceOf(calendarEvent, nowUtc))
            .OfType<CalendarEventDto>()
            .Select(ToUpcomingEntry)
            .Concat(UpcomingDeadlines(nowUtc));
        return entries.OrderBy(entry => entry.At);
    }

    /// <summary>
    /// How far ahead a repeat is looked for. A year covers what the calendar's own year view shows, and
    /// bounds the walk for a daily event that has been running since forever.
    /// </summary>
    private static readonly TimeSpan UpcomingWindow = TimeSpan.FromDays(365);

    private static CalendarEventDto? NextOccurrenceOf(CalendarEventDto calendarEvent, DateTimeOffset nowUtc)
        => calendarEvent.Details.Recurrence is null
            ? calendarEvent.Details.EndUtc >= nowUtc ? calendarEvent : null
            : CalendarEventOccurrenceExpander
                .ExpandOccurrences(calendarEvent, nowUtc, nowUtc + UpcomingWindow)
                .FirstOrDefault(occurrence => occurrence.Details.EndUtc >= nowUtc);

    /// <summary>
    /// One row on the Upcoming card. An event a task list raised is named "Shopping: Milk", the way a
    /// deadline from the same list already was - this card gathers things from everywhere, so an entry
    /// that does not say where it came from is the one entry on it that has lost something. It also
    /// opens as that list's entry rather than as the event, which it always did.
    /// </summary>
    private UpcomingEntry ToUpcomingEntry(CalendarEventDto calendarEvent)
    {
        var raisedBy = CalendarEventDestination.RaisedBy(calendarEvent.Id, _taskLists);
        var name = raisedBy is { } origin
            ? $"{Written(origin.List.Title)}: {calendarEvent.Details.Title}"
            : calendarEvent.Details.Title;

        return new UpcomingEntry(
            calendarEvent.Details.StartUtc,
            name + (calendarEvent.IsShared ? " " + T["(shared)"] : string.Empty),
            FormatEventMeta(calendarEvent.Details),
            string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? "var(--accent)" : calendarEvent.Details.Color,
            calendarEvent.Details.Priority,
            CalendarEventDestination.For(calendarEvent.Id, _taskLists),
            $"/calendar/{calendarEvent.Id}");
    }

    /// <summary>
    /// The deadlines on task lists, named the way the calendar names them - "Shopping: Milk", since a
    /// card gathering things from everywhere has to say where each one came from. Finished ones are left
    /// out: this is what is still ahead, and something already ticked off is not.
    /// </summary>
    private IEnumerable<UpcomingEntry> UpcomingDeadlines(DateTimeOffset nowUtc)
        => (_taskLists ?? [])
            .SelectMany(taskList => taskList.Items.Select(item => (taskList, item)))
            .Where(pair => !pair.item.IsCompleted
                && pair.item.AllLinkedTaskListIds.Count == 0
                && pair.item.DueDateUtc is { } dueDate && dueDate >= nowUtc)
            .Select(pair => new UpcomingEntry(
                pair.item.DueDateUtc!.Value,
                $"{Written(pair.taskList.Title)}: {Written(pair.item.Description)}",
                pair.item.DueDateUtc!.Value.LocalDateTime.ToString("dd.MM.yyyy HH:mm"),
                "var(--task)",
                pair.taskList.Priority,
                $"/tasks/{pair.taskList.Id}",
                // A deadline's reminder points at the list it is on, which is where the row goes too.
                $"/tasks/{pair.taskList.Id}"));

    /// <summary>
    /// The High/Low mark beside a row, when a reader has said this one is not like the others. Normal is
    /// the default and says nothing, so it is drawn as nothing rather than as a badge on every line.
    /// </summary>
    private RenderFragment? RenderPriorityBadge(string priority)
    {
        var parsed = PriorityOf(priority);
        if (parsed == ItemPriority.Normal)
        {
            return null;
        }

        return builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"card-badge card-badge-priority-{parsed.ToString().ToLowerInvariant()}");
            builder.AddContent(2, parsed == ItemPriority.High ? T["High"] : T["Low"]);
            builder.CloseElement();
        };
    }

    /// <summary>
    /// Whether one item survives its card's filter. Priorities arrive as names, the way everything else
    /// crosses the wire - an unreadable one is treated as Normal rather than hidden, since a filter is
    /// no place to make something disappear over a word nobody recognises.
    /// </summary>
    private bool Matches(string cardKey, bool isPinned, string priority) => CardPreferences.FilterFor(cardKey) switch
    {
        DashboardCardFilter.Pinned => isPinned,
        DashboardCardFilter.HighPriority => PriorityOf(priority) == ItemPriority.High,
        DashboardCardFilter.NormalPriority => PriorityOf(priority) == ItemPriority.Normal,
        DashboardCardFilter.LowPriority => PriorityOf(priority) == ItemPriority.Low,
        _ => true
    };

    private static ItemPriority PriorityOf(string priority)
        => Enum.TryParse<ItemPriority>(priority, out var parsed) ? parsed : ItemPriority.Normal;

    private async Task SetCardFilterAsync(string cardKey, DashboardCardFilter filter)
    {
        Logger.LogInformation("User filtered dashboard card {CardKey} to {Filter}", cardKey, filter);
        await CardPreferences.SetFilterAsync(cardKey, filter);
    }

    /// <summary>
    /// Takes one part of the dashboard off this reader's page, or puts it back - on this device, for the
    /// same reason pinning is not stored server-side.
    /// </summary>
    private async Task SetPartVisibleAsync(string cardKey, bool isVisible)
    {
        Logger.LogInformation("User {Action} dashboard card {CardKey}", isVisible ? "showed" : "hid", cardKey);
        await CardPreferences.SetVisibleAsync(cardKey, isVisible);
    }

    /// <summary>
    /// Moves a card to the top of the page for this reader, on this device - see DashboardPinService for
    /// why that is not stored server-side the way a pinned note or task list is.
    /// </summary>
