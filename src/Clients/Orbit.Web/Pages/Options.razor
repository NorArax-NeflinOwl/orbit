@page "/options"
@attribute [Authorize]
@implements IDisposable
@using Orbit.Contracts.Notifications
@using Orbit.Contracts.Users
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Orbit.Core.Permissions
@using Orbit.Core.Transfer
@using Orbit.Web.Services
@inject ThemeService ThemeService
@inject AccentColorService AccentColorService
@inject TimeProvider TimeProvider
@inject Translations T
@inject PushNotificationManager PushNotificationManager
@inject NotificationsApiClient NotificationsApiClient
@inject ClientFlagsApiClient ClientFlagsApiClient
@inject UsersApiClient UsersApiClient
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject AuthApiClient AuthApiClient
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject TransferApiClient TransferApiClient
@inject DevicePreferences DevicePreferences
@inject UserPermissionState Permissions
@inject ILogger<Options> Logger

<PageTitle>@T["Orbit — Options"]</PageTitle>

<PageHeader>
    <Title>@T["Options"]</Title>
    <Description>@T["Your account, appearance, and notification preferences."]</Description>
</PageHeader>

<div class="options-page">
    @* Four tabs rather than nine sections stacked on one page: the page had grown to where finding
       the password field meant scrolling past every notification switch. Debugger is offered only to an
       account that has unlocked it - see ApplicationPermission.Debug. *@
    <div class="options-tabs" role="tablist">
        @foreach (var tab in Enum.GetValues<OptionsTab>().Where(IsOffered))
        {
            <button type="button" class="options-tab @(_activeTab == tab ? "active" : "")" role="tab"
                    aria-selected="@(_activeTab == tab)" @onclick="() => _activeTab = tab">
                @DescribeTab(tab)
            </button>
        }
    </div>

    @if (_activeTab == OptionsTab.Account)
    {
        <div class="options-section">
            @* Each section's own sentence sits behind its heading's mark, as each row's does beside its
               name - see FieldHint.razor. A page of titles each with a sentence under it read as prose
               with switches in it. *@
            <h2 class="options-heading">@T["Account"]<FieldHint>@T["Your profile, sign-in address, and password."]</FieldHint></h2>
            <div class="options-card">
                <div class="options-row options-row-stacked">
                    <div class="field">
                        <label for="displayNameInput">@T["Display name"]</label>
                        <input id="displayNameInput" @bind="_profileForm.DisplayName" />
                    </div>
                    <div class="field">
                        <label for="userNameInput">@T["Login"]</label>
                        <input id="userNameInput" @bind="_profileForm.UserName" />
                    </div>
                    <div class="field">
                        @* The badge is about the address in the box, not about the account: typing a new
                           one and saving leaves the account on its old address until the code is
                           confirmed, and a "Verified" badge beside the new address said the opposite of
                           what had happened. *@
                        <label for="emailInput">
                            @T["Email address"]
                            @if (IsTheShownAddressVerified)
                            {
                                <span class="verified-badge">@T["Verified"]</span>
                            }
                            else
                            {
                                <span class="unverified-badge">@T["Not verified"]</span>
                            }
                            <FieldHint>@T["Saving a different address doesn't move the account to it on its own - that only happens once you confirm the code sent to the new address."]</FieldHint>
                        </label>
                        <input id="emailInput" type="email" @bind="_profileForm.EmailAddress" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-primary" disabled="@_isSavingProfile" @onclick="SaveProfileAsync">@T["Save profile"]</button>
                    </div>
                    @if (_profileMessage is not null)
                    {
                        <p class="@(_profileFailed ? "error" : "info")">@_profileMessage</p>
                    }
                </div>

                @* Only while there is something to confirm. An account whose address is verified and
                   unchanged has nothing to do here, and a code box standing open invites typing into it
                   for no reason. *@
                @if (!IsTheShownAddressVerified || _emailForm.IsCodePending)
                {
                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Email verification"]<FieldHint>@T["A verified address is what a password reset is sent to, so it has to be one you can read."]</FieldHint></div>
                    </div>
                    @if (_emailForm.IsCodePending)
                    {
                        <div class="field">
                            <label for="emailCodeInput">@T["Code sent to"]@Space<strong>@_emailForm.SentToAddress</strong></label>
                            <input id="emailCodeInput" inputmode="numeric" autocomplete="one-time-code" @bind="_emailForm.Code" />
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn-primary" disabled="@_isConfirmingCode" @onclick="ConfirmEmailCodeAsync">@T["Confirm"]</button>
                            <button type="button" class="btn-secondary" disabled="@_isSendingCode" @onclick="SendEmailCodeAsync">@T["Send again"]</button>
                        </div>
                    }
                    else
                    {
                        <div class="options-row-desc">@T["The code goes to"]@Space<strong>@VerificationTargetAddress</strong>.</div>
                        <div class="form-actions">
                            <button type="button" class="btn-secondary" disabled="@_isSendingCode" @onclick="SendEmailCodeAsync">@T["Send code"]</button>
                        </div>
                    }
                    @if (_emailMessage is not null)
                    {
                        <p class="@(_emailFailed ? "error" : "info")">@_emailMessage</p>
                    }
                </div>
                }

                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">
                            @T["Google extras"]
                            @if (_account is null || !GoogleIntegrationAccess.Qualifies(_account))
                            {
                                <span class="unverified-badge">@T["Not available yet"]</span>
                            }
                            else if (DevicePreferences.AllowGoogleExtras)
                            {
                                <span class="verified-badge">@T["On"]</span>
                            }
                            else
                            {
                                <span class="unverified-badge">@T["Off"]</span>
                            }
                            <FieldHint>
                                @T["Adds links that open Google Calendar or Google Maps with the details filled in. Orbit never writes to your calendar."]
                                @T["Kept on this device."]
                            </FieldHint>
                        </div>
                    </div>
                    @* Offered only where the account qualifies: a switch for something that is not
                       available yet would turn nothing off. Kept on this device, like the location
                       switch - it is about what this browser puts in front of whoever is at it, and
                       turning it off leaves the Google account below connected. *@
                    @if (_account is not null && GoogleIntegrationAccess.Qualifies(_account))
                    {
                        <button type="button" class="switch @(DevicePreferences.AllowGoogleExtras ? "on" : "")" role="switch"
                                aria-checked="@DevicePreferences.AllowGoogleExtras" aria-label="@(T["Google extras"])"
                                @onclick="ToggleGoogleExtrasAsync">
                            <span class="switch-knob"></span>
                        </button>
                    }
                </div>

                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">
                            Google
                            @if (_account?.IsGoogleLinked == true)
                            {
                                <span class="verified-badge">@T["Connected"]</span>
                            }
                        <FieldHint>
                            @T["Connecting Google lets you sign in with it as well as with your password."]
                            @if (_account?.HasPassword == false)
                            {
                            <text>@T["Your account has no password yet, so Google is currently the only way in - set one below before disconnecting."]</text>
                            }
                        </FieldHint></div>
                    </div>
                    @if (_account?.IsGoogleLinked == true)
                    {
                        <div class="form-actions">
                            <button type="button" class="btn-secondary" disabled="@_isChangingGoogleLink" @onclick="UnlinkGoogleAsync">@T["Disconnect"]</button>
                        </div>
                    }
                    else
                    {
                        <GoogleSignInButton OnCredential="LinkGoogleAsync" />
                    }
                    @if (_googleMessage is not null)
                    {
                        <p class="@(_googleFailed ? "error" : "info")">@_googleMessage</p>
                    }
                </div>

                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Password"]<FieldHint>@T["Changing it also re-encrypts your chat key backup, so your messages stay readable when you next sign in elsewhere."]</FieldHint></div>
                    </div>
                    <div class="field">
                        <label for="currentPasswordInput">@T["Current password"]</label>
                        <input type="password" id="currentPasswordInput" @bind="_passwordForm.CurrentPassword" />
                    </div>
                    <div class="field">
                        <label for="newPasswordInput">@T["New password"]</label>
                        <input type="password" id="newPasswordInput" @bind="_passwordForm.NewPassword" />
                    </div>
                    <div class="field">
                        <label for="repeatNewPasswordInput">@T["Repeat new password"]</label>
                        <input type="password" id="repeatNewPasswordInput" @bind="_passwordForm.RepeatNewPassword" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-primary" disabled="@_isChangingPassword" @onclick="ChangePasswordAsync">@T["Change password"]</button>
                    </div>
                    @if (_passwordMessage is not null)
                    {
                        <p class="@(_passwordFailed ? "error" : "info")">@_passwordMessage</p>
                    }
                </div>
            </div>
        </div>

        <div class="options-section">
            <h2 class="options-heading">@T["Your data"]<FieldHint>@T["Everything you own — notes, task lists, events, inventories and places — as one JSON file, and back again."]</FieldHint></h2>
            <div class="options-card">
                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Export"]<FieldHint>@T["Downloads what you tick below as one file. Things shared with you are left out, and a private item travels sealed - except a place, which is opened first."]</FieldHint></div>
                    </div>
                    @* What goes in the file. The first four to begin with, which is what this used to do
                       without asking - somebody exporting their notes to read elsewhere had no way of
                       leaving three years of stock counts out of it. Places wait to be asked for: see
                       ExportChoice. *@
                    <div class="export-choices">
                        @foreach (var part in Enum.GetValues<ExportPart>())
                        {
                            <label class="field-checkbox">
                                <input type="checkbox" checked="@_exportChoice.Includes(part)"
                                       @onchange="args => _exportChoice.Set(part, (bool)args.Value!)" />@DescribeExportPart(part)
                            </label>
                        }
                    </div>
                    @* Said before the button rather than after the file, and only while places are ticked:
                       it is the one part of the file that is not sealed, and a warning printed under
                       every export would be read as boilerplate by the time it mattered. *@
                    @if (_exportChoice.Includes(ExportPart.Places))
                    {
                        <p class="export-warning">@T["Places are written to the file decrypted. The file itself is not encrypted, so anyone who gets it can read every place in it - names, addresses, coordinates and descriptions - private ones included."]</p>
                    }
                    <button type="button" class="btn-secondary" disabled="@(_isExporting || _exportChoice.IsEmpty)"
                            @onclick="ExportAsync">
                        @(_isExporting ? T["Preparing…"] : T["Export"])
                    </button>
                </div>
                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Import"]<FieldHint>@T["Adds everything in a file to this account. Nothing is replaced, so importing the same file twice leaves two copies."]</FieldHint></div>
                    </div>
                    <InputFile OnChange="ImportAsync" accept=".json,application/json" disabled="@_isImporting" />
                </div>
                @if (_transferMessage is not null)
                {
                    <p class="options-subtext">@_transferMessage</p>
                }
                @if (_transferErrorMessage is not null)
                {
                    <p class="error">@_transferErrorMessage</p>
                }
            </div>
        </div>

        <div class="options-section">
            <h2 class="options-heading">@T["Danger zone"]<FieldHint>@T["Deleting your account is permanent and cannot be undone."]</FieldHint></h2>
            <div class="options-card options-card-danger">
                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Delete account"]<FieldHint>@T["Permanently deletes your account and everything in it - notes, tasks, calendar events, inventory, and chat history. This cannot be undone."]</FieldHint></div>
                    </div>
                    @if (_account?.HasPassword == true)
                    {
                        @* Said out loud for an account that signs in with Google: it can hold a password
                           without thinking of itself as having one - chat made it set one, or the account
                           had one before Google was connected - and "Password" alone left it asking for
                           something it did not recognise, with no way forward from here. *@
                        <div class="field">
                            <label for="deleteAccountPasswordInput">
                                @T["Password"]
                                @if (_account.IsGoogleLinked)
                                {
                                    <FieldHint>@T["The password this account has besides Google - the one you set to use chat, or the one it had before Google was connected."]</FieldHint>
                                }
                            </label>
                            <input type="password" id="deleteAccountPasswordInput" @bind="_deleteAccountForm.Password" />
                            <a class="options-row-desc" id="deleteAccountForgotPassword" href="/forgot-password">@T["Forgot your password?"]</a>
                        </div>
                    }
                    else if (ConfirmsWithGoogle)
                    {
                        @* An account without a password proves it is its owner the way it signs in: with
                           Google, again, now - the server checks that the sign-in is this account's and a
                           fresh one (DeleteAccountCommandHandler). Pressing Google's button is what deletes,
                           after the confirm(), so there is no second button to press. *@
                        <div class="field" id="deleteAccountWithGoogle">
                            <span class="options-row-desc">
                                @T["Confirm with Google to delete this account"]
                                <FieldHint>@T["An account without a password proves it is yours by signing in with Google again - just now, not the sign-in that opened this page."]</FieldHint>
                            </span>
                            <GoogleSignInButton OnCredential="DeleteWithGoogleAsync" />
                        </div>
                    }
                    else if (_account is not null)
                    {
                        @* An account without a password, on a deployment with no Google sign-in to confirm
                           with: typing the address or the login is what stands between one stray press on a
                           confirm() and everything it holds. Checked here, against the account already
                           loaded - see DeleteAccountFormModel.ConfirmsAccount. *@
                        <div class="field">
                            <label for="deleteAccountConfirmationInput">
                                @T["Type your email address or login to confirm"]
                                <FieldHint>@T["An account without a password has nothing else to confirm it with, so typing this is what makes deleting it deliberate."]</FieldHint>
                            </label>
                            <input id="deleteAccountConfirmationInput" autocomplete="off" spellcheck="false"
                                   @bind="_deleteAccountForm.Confirmation" @bind:event="oninput" />
                        </div>
                    }
                    @if (!ConfirmsWithGoogle)
                    {
                        <div class="form-actions">
                            <button type="button" class="btn-danger" disabled="@_isDeletingAccount" @onclick="DeleteAccountAsync">@T["Delete account"]</button>
                        </div>
                    }
                    @if (_deleteAccountMessage is not null)
                    {
                        <p class="@(_deleteAccountFailed ? "error" : "info")">@_deleteAccountMessage</p>
                    }
                </div>
            </div>
        </div>
    }

    @if (_activeTab == OptionsTab.Appearance)
    {
        <div class="options-section">
            <h2 class="options-heading">@T["Appearance"]<FieldHint>@T["Choose how Orbit looks on this device."]</FieldHint></h2>
            <div class="theme-picker">
                <button type="button" class="theme-option @(ThemeService.Current == ThemePreference.Light ? "active" : "")"
                        @onclick="() => SetThemeAsync(ThemePreference.Light)">
                    <span class="theme-preview theme-preview-light"><span class="tp-bar"></span><span class="tp-line"></span><span class="tp-line short"></span></span>
                    <span class="theme-option-label">@T["Light"]</span>
                </button>
                <button type="button" class="theme-option @(ThemeService.Current == ThemePreference.Dark ? "active" : "")"
                        @onclick="() => SetThemeAsync(ThemePreference.Dark)">
                    <span class="theme-preview theme-preview-dark"><span class="tp-bar"></span><span class="tp-line"></span><span class="tp-line short"></span></span>
                    <span class="theme-option-label">@T["Dark"]</span>
                </button>
                <button type="button" class="theme-option @(ThemeService.Current == ThemePreference.System ? "active" : "")"
                        @onclick="() => SetThemeAsync(ThemePreference.System)">
                    <span class="theme-preview theme-preview-system"><span class="tp-bar"></span><span class="tp-line"></span><span class="tp-line short"></span></span>
                    <span class="theme-option-label">@T["System"]</span>
                </button>
            </div>
        </div>

        <div class="options-section">
            <h2 class="options-heading">@T["Accent colour"]<FieldHint>@T["The colour Orbit highlights things in. Kept on this device, like the theme."]</FieldHint></h2>
            <div class="accent-picker">
                @foreach (var accentColor in AccentColor.All)
                {
                    <button type="button" class="accent-option @(AccentColorService.Current == accentColor ? "active" : "")"
                            style="@AccentSwatchStyle(accentColor)" title="@T[accentColor.Name]"
                            aria-label="@T[accentColor.Name]" aria-pressed="@(AccentColorService.Current == accentColor)"
                            @onclick="() => SetAccentColorAsync(accentColor)">
                    </button>
                }
            </div>
        </div>

        <div class="options-section">
            <h2 class="options-heading">@T["Notifications"]</h2>
            <div class="options-card">
                <div class="options-row">
                    <div>
                        <div class="options-row-title">@T["Push notifications"]<FieldHint>@T["Instant alerts for new messages, event reminders and overdue tasks, even while Orbit isn't open."]</FieldHint></div>
                    </div>
                    @if (_pushNotificationsSupported == false)
                    {
                        <span class="options-row-desc">@T["Not supported in this browser"]</span>
                    }
                    else
                    {
                        <button type="button" class="switch @(_pushNotificationsEnabled ? "on" : "")" role="switch"
                                aria-checked="@_pushNotificationsEnabled" disabled="@(_pushNotificationsSupported is null || _pushNotificationActionInProgress)"
                                @onclick="TogglePushNotificationsAsync">
                            <span class="switch-knob"></span>
                        </button>
                    }
                </div>
                <div class="options-row">
                    <div>
                        <div class="options-row-title">@T["Allow notifications"]<FieldHint>@T["Master switch for everything below, and for the notifications panel itself."]</FieldHint></div>
                    </div>
                    <button type="button" class="switch @(_notificationSettings.AllowNotifications ? "on" : "")" role="switch"
                            aria-checked="@_notificationSettings.AllowNotifications" disabled="@_isSavingNotificationSettings"
                            @onclick="() => UpdateNotificationSettingsAsync(_notificationSettings with { AllowNotifications = !_notificationSettings.AllowNotifications })">
                        <span class="switch-knob"></span>
                    </button>
                </div>
                <div class="options-row options-row-child">
                    <div>
                        <div class="options-row-title">@T["Allow push"]<FieldHint>@T["Lets any calendar event, task, or inventory item's own push setting actually send a push notification."]</FieldHint></div>
                    </div>
                    <button type="button" class="switch @(_notificationSettings.AllowPush ? "on" : "")" role="switch"
                            aria-checked="@_notificationSettings.AllowPush"
                            disabled="@(!_notificationSettings.AllowNotifications || _isSavingNotificationSettings)"
                            @onclick="() => UpdateNotificationSettingsAsync(_notificationSettings with { AllowPush = !_notificationSettings.AllowPush })">
                        <span class="switch-knob"></span>
                    </button>
                </div>
                <div class="options-row options-row-child">
                    <div>
                        <div class="options-row-title">@T["Tell me when something is shared with me"]<FieldHint>@T["The invitation always reaches your notifications. This adds a push or email on top, so you hear about it straight away."]</FieldHint></div>
                    </div>
                    <button type="button" class="switch @(_notificationSettings.AllowShareNotifications ? "on" : "")" role="switch"
                            aria-checked="@_notificationSettings.AllowShareNotifications"
                            disabled="@(!_notificationSettings.AllowNotifications || _isSavingNotificationSettings)"
                            @onclick="() => UpdateNotificationSettingsAsync(_notificationSettings with { AllowShareNotifications = !_notificationSettings.AllowShareNotifications })">
                        <span class="switch-knob"></span>
                    </button>
                </div>
                <div class="options-row options-row-child">
                    <div>
                        <div class="options-row-title">@T["Allow email"]<FieldHint>@T["Lets any calendar event, task, or inventory item's own email setting actually send an email."]</FieldHint></div>
                    </div>
                    <button type="button" class="switch @(_notificationSettings.AllowEmail ? "on" : "")" role="switch"
                            aria-checked="@_notificationSettings.AllowEmail"
                            disabled="@(!_notificationSettings.AllowNotifications || _isSavingNotificationSettings)"
                            @onclick="() => UpdateNotificationSettingsAsync(_notificationSettings with { AllowEmail = !_notificationSettings.AllowEmail })">
                        <span class="switch-knob"></span>
                    </button>
                </div>
                <div class="options-row options-row-child">
                    <div>
                        <div class="options-row-title">@T["Allow mobile notification"]<FieldHint>@T["Shows a short banner at the top of the page when a new notification arrives while Orbit is open."]</FieldHint></div>
                    </div>
                    <button type="button" class="switch @(_notificationSettings.AllowMobileBanner ? "on" : "")" role="switch"
                            aria-checked="@_notificationSettings.AllowMobileBanner"
                            disabled="@(!_notificationSettings.AllowNotifications || _isSavingNotificationSettings)"
                            @onclick="() => UpdateNotificationSettingsAsync(_notificationSettings with { AllowMobileBanner = !_notificationSettings.AllowMobileBanner })">
                        <span class="switch-knob"></span>
                    </button>
                </div>
                <div class="options-row options-row-child">
                    <div>
                        <div class="options-row-title">@T["Banner duration (seconds)"]<FieldHint>@T["How long a notification banner stays on screen (1-30)."]</FieldHint></div>
                    </div>
                    <input type="number" id="bannerVisibleSecondsInput" class="options-number-input" min="1" max="30"
                           value="@_notificationSettings.BannerVisibleSeconds"
                           disabled="@(!_notificationSettings.AllowNotifications || !_notificationSettings.AllowMobileBanner || _isSavingNotificationSettings)"
                           @onchange="@(args => UpdateNumericSettingAsync(args, seconds => _notificationSettings with { BannerVisibleSeconds = seconds }))" />
                </div>
                <div class="options-row options-row-child">
                    <div>
                        <div class="options-row-title">@T["Banner interval (seconds)"]<FieldHint>@T["Minimum quiet time before the next banner may appear (1-300)."]</FieldHint></div>
                    </div>
                    <input type="number" id="bannerMinimumGapSecondsInput" class="options-number-input" min="1" max="300"
                           value="@_notificationSettings.BannerMinimumGapSeconds"
                           disabled="@(!_notificationSettings.AllowNotifications || !_notificationSettings.AllowMobileBanner || _isSavingNotificationSettings)"
                           @onchange="@(args => UpdateNumericSettingAsync(args, seconds => _notificationSettings with { BannerMinimumGapSeconds = seconds }))" />
                </div>
                <div class="options-row options-row-child">
                    <div>
                        <div class="options-row-title">@T["Keep notifications for (days)"]<FieldHint>@T["How long a notification stays on the"]@Space<a href="/notifications">@T["notifications page"]</a> @T["before it is deleted for good (1-90). Clearing the panel only tidies them out of the way; this is what actually removes them."]</FieldHint></div>
                    </div>
                    <input type="number" id="retentionDaysInput" class="options-number-input" min="1" max="90"
                           value="@_notificationSettings.RetentionDays"
                           disabled="@_isSavingNotificationSettings"
                           @onchange="@(args => UpdateNumericSettingAsync(args, days => _notificationSettings with { RetentionDays = days }))" />
                </div>
            </div>
            @if (_pushNotificationErrorMessage is not null)
            {
                <p class="error">@_pushNotificationErrorMessage</p>
            }
            @if (_notificationSettingsErrorMessage is not null)
            {
                <p class="error">@_notificationSettingsErrorMessage</p>
            }
        </div>
    }

    @if (_activeTab == OptionsTab.Permissions)
    {
        <div class="options-section">
            <h2 class="options-heading">@T["In Orbit"]<FieldHint>@T["Parts of Orbit this account can use. Each is unlocked separately, with its own code."]</FieldHint></h2>
            <div class="options-card">
                <table class="permissions-table">
                    <thead>
                        <tr>
                            <th scope="col">@T["Part of Orbit"]</th>
                            <th scope="col">@T["State"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permission in ListedPermissions)
                        {
                            <tr>
                                <td>
                                    <div class="options-row-title">@DescribePermission(permission)<FieldHint>@ExplainPermission(permission)</FieldHint></div>
                                </td>
                                <td>
                                    @if (Permissions.Has(permission))
                                    {
                                        <span class="verified-badge">@T["Unlocked"]</span>
                                    }
                                    else if (permission.RequiredBefore() is { } required && !Permissions.Has(required))
                                    {
                                        <span class="unverified-badge">@T.Format("Needs {0}", DescribePermission(required))</span>
                                    }
                                    else
                                    {
                                        <span class="unverified-badge">@T["Locked"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Only while something is still locked: an account that has unlocked everything has no use for
           a code box, and leaving it there would invite typing into it forever. *@
        @if (!HasEverythingUnlocked)
        {
        <div class="options-section">
            <h2 class="options-heading">@T["Unlock code"]<FieldHint>@T["One code per part of Orbit. Whoever deployed this Orbit has them - they are generated when it is built, and change every time it is."]</FieldHint></h2>
            <div class="options-card">
                <div class="options-row options-row-stacked">
                    <div class="field">
                        <label for="permissionCodeInput">@T["Code"]</label>
                        @* Bound on every keystroke: bound on losing focus instead, Unlock stays greyed
                           out while somebody types the code into the box next to it. *@
                        <input id="permissionCodeInput" class="permission-code-input" @bind="_permissionCode" @bind:event="oninput"
                               placeholder="@(T["e.g. 7Q31KS0KB4Y0"])" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-primary" disabled="@(_isRedeemingCode || _permissionCode.Trim().Length == 0)"
                                @onclick="RedeemPermissionCodeAsync">
                            @T["Unlock"]
                        </button>
                    </div>
                    @if (_permissionCodeMessage is not null)
                    {
                        <p class="@(_permissionCodeFailed ? "error" : "info")">@_permissionCodeMessage</p>
                    }
                </div>
            </div>
        </div>
        }

        <div class="options-section">
            <h2 class="options-heading">@T["Location"]<FieldHint>@T["Kept on this device, because a browser grants location per device."]</FieldHint></h2>
            <div class="options-card">
                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Use my location"]<FieldHint>@T["Lets Orbit ask this browser where you are. Until you turn it on nothing asks, and turning it on sends nothing anywhere."]</FieldHint></div>
                    </div>
                    <button type="button" class="switch @(DevicePreferences.AllowLocation ? "on" : "")" role="switch"
                            aria-checked="@DevicePreferences.AllowLocation"
                            @onclick="ToggleAllowLocationAsync">
                        <span class="switch-knob"></span>
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_activeTab == OptionsTab.Debug)
    {
        <div class="options-section">
            <h2 class="options-heading">@T["Debugger"]<FieldHint>@T["What this browser reports about Orbit itself. Kept on this device."]</FieldHint></h2>
            <div class="options-card">
                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Mode"]<FieldHint>@T["Debug shows the captured log and the detail behind an error. Release hides both."]</FieldHint></div>
                    </div>
                    <select id="diagnosticsModeSelect" class="options-select"
                            value="@DevicePreferences.DiagnosticsMode"
                            @onchange="OnDiagnosticsModeChangedAsync">
                        <option value="@DiagnosticsMode.Release">@T["Release"]</option>
                        <option value="@DiagnosticsMode.Debug">@T["Debug"]</option>
                    </select>
                </div>
                <div class="options-row options-row-stacked">
                    <div>
                        <div class="options-row-title">@T["Frontend log level"]<FieldHint>@T["The least severe line this browser keeps. Warning by default, so routine noise doesn't crowd out a real failure."]</FieldHint></div>
                    </div>
                    <select id="frontendLogLevelSelect" class="options-select"
                            value="@DevicePreferences.MinimumLogLevel"
                            @onchange="OnLogLevelChangedAsync">
                        @foreach (var level in SelectableLogLevels)
                        {
                            <option value="@level">@level</option>
                        }
                    </select>
                </div>
                @* Here rather than beside the other switches because only this tab's readers are asked:
                   an account without Debugger sees adverts whatever this says - see AdAudience. *@
                <div class="options-row">
                    <div>
                        <div class="options-row-title">
                            @T["Allow ads"]
                            <FieldHint>
                                @T["Off by default for an account with Debugger, so the adverts stay out of the way while you work on Orbit. Turn it on to see them the way everybody else does."]
                                @T["Kept on this device."]
                            </FieldHint>
                        </div>
                    </div>
                    <button type="button" id="allowAdsSwitch" class="switch @(DevicePreferences.AllowAdsForDebugger ? "on" : "")" role="switch"
                            aria-checked="@DevicePreferences.AllowAdsForDebugger" aria-label="@(T["Allow ads"])"
                            @onclick="ToggleAllowAdsAsync">
                        <span class="switch-knob"></span>
                    </button>
                </div>
            </div>
        </div>

        @if (_exceptionDetailsAllowedByServer)
        {
            <div class="options-section">
                <h2 class="options-heading">@T["Diagnostics"]<FieldHint>@T["Only shown in non-production environments."]</FieldHint></h2>
                <div class="options-card">
                    <div class="options-row">
                        <div>
                            <div class="options-row-title">@T["Show exceptions"]<FieldHint>@T["Lets the Notifications panel list this browser's own recent errors, each with a \"Copy\" button for reporting a bug."]</FieldHint></div>
                        </div>
                        <button type="button" class="switch @(_notificationSettings.ShowExceptionDetails ? "on" : "")" role="switch"
                                aria-checked="@_notificationSettings.ShowExceptionDetails" disabled="@_isSavingNotificationSettings"
                                @onclick="() => UpdateNotificationSettingsAsync(_notificationSettings with { ShowExceptionDetails = !_notificationSettings.ShowExceptionDetails })">
                            <span class="switch-knob"></span>
                        </button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    /// <summary>The four groups this page is divided into - see the tab bar above for why it is divided at all.</summary>
    private enum OptionsTab
    {
        Account,
        Appearance,
        Permissions,
        Debug
    }

    private OptionsTab _activeTab = OptionsTab.Account;

    /// <summary>
    /// Whether this account is offered a tab at all. Only Debugger is ever withheld, and only because
    /// what it shows is Orbit's own internals - see ApplicationPermission.Debug.
    /// </summary>
    private bool IsOffered(OptionsTab tab)
        => tab != OptionsTab.Debug || Permissions.Has(ApplicationPermission.Debug);

    /// <summary>
    /// The parts of Orbit this table names - see PermissionListing, which the phone's own list reads
    /// too. Debugger is not among them until it has been unlocked.
    /// </summary>
    private IEnumerable<ApplicationPermission> ListedPermissions
        => Enum.GetValues<ApplicationPermission>()
            .Where(permission => PermissionListing.IsListed(permission, Permissions.Granted));

    /// <summary>
    /// Whether the code box has nothing left to unlock. Asked of every permission there is, including
    /// the one the table above does not list: the box is the only way Debugger can ever be unlocked, so
    /// hiding it from an account that has unlocked everything else - exactly the account somebody hands
    /// that code to - would make the code impossible to use.
    /// </summary>
    private bool HasEverythingUnlocked => Enum.GetValues<ApplicationPermission>().All(Permissions.Has);

    /// <summary>What the reader has typed into the unlock field, and how the last attempt went.</summary>
    private string _permissionCode = string.Empty;
    private bool _isRedeemingCode;
    private string? _permissionCodeMessage;
    private bool _permissionCodeFailed;

    private string DescribeTab(OptionsTab tab) => tab switch
    {
        OptionsTab.Account => T["Account"],
        OptionsTab.Appearance => T["Appearance"],
        OptionsTab.Permissions => T["Permissions"],
        _ => T["Debug"]
    };

    private string DescribePermission(ApplicationPermission permission) => permission switch
    {
        ApplicationPermission.Contacts => T["Contacts"],
        ApplicationPermission.Chat => T["Chat"],
        ApplicationPermission.Location => T["Location"],
        ApplicationPermission.Debug => T["Debugger"],
        _ => T["Sharing"]
    };

    private string ExplainPermission(ApplicationPermission permission) => permission switch
    {
        ApplicationPermission.Contacts => T["Finding other people, and being found by them. Everything below needs this first."],
        ApplicationPermission.Chat => T["Conversations, with one person or with several."],
        ApplicationPermission.Location => T["Recording where you are. Sharing it, or seeing somebody else's, also needs contacts."],
        ApplicationPermission.Debug => T["What Orbit reports about itself - the Debugger settings, the captured log, and the detail behind an error."],
        _ => T["Handing a note, task list, event or inventory to somebody else."]
    };

    /// <summary>
    /// The server answers the same way for a code that matched nothing and one that matched something,
    /// so the message here is the only place the difference is said out loud - to the person who typed it.
    /// </summary>
    private async Task RedeemPermissionCodeAsync()
    {
        Logger.LogInformation("User submitted an unlock code");
        _isRedeemingCode = true;
        _permissionCodeMessage = null;
        try
        {
            var outcome = await UsersApiClient.RedeemPermissionCodeAsync(_permissionCode);
            _permissionCodeFailed = outcome.Granted is null;

            // A real code that came too early gets its own answer: the person has the right code, and
            // telling them it unlocks nothing would send them looking for a different one.
            if (outcome.MissingPrerequisite is { } missing && Enum.TryParse<ApplicationPermission>(missing, out var required))
            {
                _permissionCodeMessage = T.Format("{0} has to be unlocked first.", DescribePermission(required));
                return;
            }

            if (outcome.Granted is not { } granted)
            {
                _permissionCodeMessage = T["That code doesn't unlock anything."];
                return;
            }

            await Permissions.RefreshAsync();
            _permissionCode = string.Empty;
            _permissionCodeMessage = T.Format(
                "{0} is now unlocked.",
                Enum.TryParse<ApplicationPermission>(granted, out var permission) ? DescribePermission(permission) : granted);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to redeem an unlock code");
            _permissionCodeFailed = true;
            _permissionCodeMessage = T["Couldn't reach the server. Try again."];
        }
        finally
        {
            _isRedeemingCode = false;
        }
    }

    /// <summary>Everything above None, which would mean keeping nothing and is what turning the log off would look like - Options has no reason to offer that separately from picking Critical.</summary>
    private static readonly LogLevel[] SelectableLogLevels =
        [LogLevel.Trace, LogLevel.Debug, LogLevel.Information, LogLevel.Warning, LogLevel.Error, LogLevel.Critical];

    private Task ToggleAllowLocationAsync() => DevicePreferences.SetAllowLocationAsync(!DevicePreferences.AllowLocation);

    /// <summary>
    /// Turns the Google links on or off for this browser. The cached answer is forgotten with it, so a
    /// page opened next reads the switch rather than what it was told before it was flipped.
    /// </summary>
    private async Task ToggleGoogleExtrasAsync()
    {
        await DevicePreferences.SetAllowGoogleExtrasAsync(!DevicePreferences.AllowGoogleExtras);
        GoogleIntegrationAccess.Forget();
    }

    private Task OnDiagnosticsModeChangedAsync(ChangeEventArgs args)
        => Enum.TryParse<DiagnosticsMode>(args.Value?.ToString(), out var mode)
            ? DevicePreferences.SetDiagnosticsModeAsync(mode)
            : Task.CompletedTask;

    private Task OnLogLevelChangedAsync(ChangeEventArgs args)
        => Enum.TryParse<LogLevel>(args.Value?.ToString(), out var level)
            ? DevicePreferences.SetMinimumLogLevelAsync(level)
            : Task.CompletedTask;

    private Task ToggleAllowAdsAsync() => DevicePreferences.SetAllowAdsForDebuggerAsync(!DevicePreferences.AllowAdsForDebugger);

    /// <summary>An export of a whole account is not large by file standards, but a hand-made file could be - this is where a nonsense one stops.</summary>
    private const long MaximumImportSizeBytes = 32 * 1024 * 1024;

    /// <summary>What the next export will contain - see ExportChoice.</summary>
    private readonly ExportChoice _exportChoice = new();

    private bool _isExporting;
    private bool _isImporting;
    private string? _transferMessage;
    private string? _transferErrorMessage;

    /// <summary>
    /// Written by the browser rather than served as a download from the API: the API answers with JSON
    /// the client already has to read, and a second authenticated GET that the browser itself performs
    /// would need the token in the URL to work.
    /// </summary>
    private async Task ExportAsync()
    {
        _isExporting = true;
        _transferMessage = null;
        _transferErrorMessage = null;
        try
        {
            var everything = await TransferApiClient.ExportAsync();
            if (everything is null)
            {
                _transferErrorMessage = T["Couldn't build the export. Try again."];
                return;
            }

            // Narrowed here rather than by the server: the export is one query over an account, and
            // asking it four different ways would be four endpoints answering the same question. What
            // the file contains is what somebody ticked; the archive's shape is unchanged, so a file
            // holding only notes still imports like any other. Places are opened after narrowing, so
            // an export that left them out never reaches for the key.
            var opened = await TransferApiClient.OpenPlacesAsync(_exportChoice.Narrow(everything));
            var archive = opened.Archive;
            var json = JsonSerializer.Serialize(archive, new JsonSerializerOptions { WriteIndented = true });
            await using var downloadModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/fileDownload.js");
            await downloadModule.InvokeVoidAsync(
                "downloadText", $"orbit-export-{TimeProvider.GetLocalNow():yyyy-MM-dd}.json", "application/json", json);

            _transferMessage = T.Format(
                "Exported {0} notes, {1} task lists, {2} events, {3} inventories and {4} places.",
                archive.Notes.Count, archive.TaskLists.Count, archive.CalendarEvents.Count, archive.Inventories.Count,
                archive.AllPlaces.Count);
            if (opened.UnopenedPlaces > 0)
            {
                // Written anyway rather than refused: the rest of the file is still worth having, and
                // what is missing from it is said here rather than found when the file is opened.
                _transferErrorMessage = T.Format(
                    "{0} private places couldn't be opened in this browser and were written without their content.",
                    opened.UnopenedPlaces);
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to export the account archive");
            _transferErrorMessage = T["Couldn't build the export. Try again."];
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        _isImporting = true;
        _transferMessage = null;
        _transferErrorMessage = null;
        try
        {
            await using var stream = args.File.OpenReadStream(MaximumImportSizeBytes);
            var archive = await JsonSerializer.DeserializeAsync<OrbitArchive>(
                stream, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (archive is null)
            {
                _transferErrorMessage = T["That file didn't contain an Orbit export."];
                return;
            }

            var result = await TransferApiClient.ImportAsync(archive);
            if (result is null)
            {
                _transferErrorMessage = T["Orbit couldn't read that file. It may have been written by a different version."];
                return;
            }

            _transferMessage = T.Format(
                "Imported {0} notes, {1} task lists, {2} events, {3} inventories and {4} places.",
                result.Notes, result.TaskLists, result.CalendarEvents, result.Inventories, result.Places);
        }
        catch (JsonException)
        {
            // A file that isn't JSON at all, or is JSON of some other shape - the same message either
            // way, since neither is something the reader can act on differently.
            _transferErrorMessage = T["That file didn't contain an Orbit export."];
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to import an account archive");
            _transferErrorMessage = T["Couldn't import that file. Try again."];
        }
        finally
        {
            _isImporting = false;
        }
    }

    private bool? _pushNotificationsSupported;
    private bool _pushNotificationsEnabled;
    private bool _pushNotificationActionInProgress;
    private string? _pushNotificationErrorMessage;

    private NotificationSettingsDto _notificationSettings = new(true, true, true, true, true, BannerVisibleSeconds: 5, BannerMinimumGapSeconds: 5);
    private bool _isSavingNotificationSettings;
    private string? _notificationSettingsErrorMessage;

    /// <summary>Server-environment gate (see ClientFlagsDto) on top of _notificationSettings.ShowExceptionDetails - the Diagnostics section only ever renders when both agree, so Production never shows it regardless of what an account has stored.</summary>
    private bool _exceptionDetailsAllowedByServer;

    private AccountDto? _account;
    private readonly ProfileFormModel _profileForm = new();
    private readonly EmailFormModel _emailForm = new();

    /// <summary>Where a code requested right now would go: the address being edited, or the account's own if that box was cleared.</summary>
    private string VerificationTargetAddress
        => _profileForm.EmailAddress.Trim() is { Length: > 0 } typedAddress ? typedAddress : _account?.Email ?? string.Empty;

    /// <summary>
    /// Whether the address currently in the box is the confirmed one. Asked about the box rather than
    /// about the account, because the two part company the moment somebody types a new address: the
    /// account keeps its old one until a code sent to the new one comes back, and a "Verified" badge
    /// beside the address they just typed said something that was not true of it.
    /// </summary>
    private bool IsTheShownAddressVerified
        => _account is { IsEmailVerified: true }
            && string.Equals(_profileForm.EmailAddress.Trim(), _account.Email, StringComparison.OrdinalIgnoreCase);
    private readonly PasswordFormModel _passwordForm = new();

    private bool _isSavingProfile;
    private string? _profileMessage;
    private bool _profileFailed;

    private bool _isSendingCode;
    private bool _isConfirmingCode;
    private string? _emailMessage;
    private bool _emailFailed;

    private bool _isChangingGoogleLink;
    private string? _googleMessage;
    private bool _googleFailed;

    private bool _isChangingPassword;
    private string? _passwordMessage;
    private bool _passwordFailed;

    private readonly DeleteAccountFormModel _deleteAccountForm = new();
    private bool _isDeletingAccount;
    private string? _deleteAccountMessage;
    private bool _deleteAccountFailed;

    protected override async Task OnInitializedAsync()
    {
        // Waited for rather than raced: the tab bar decides once whether to offer Debugger, and deciding
        // before the first read landed would hide it from an account that has unlocked it - see
        // UserPermissionState.EnsureLoadedAsync.
        await Permissions.EnsureLoadedAsync();
        await LoadAccountAsync();
        ThemeService.Changed += OnThemeChanged;
        AccentColorService.Changed += OnThemeChanged;
        await RefreshPushNotificationStateAsync();
        await RefreshNotificationSettingsAsync();
    }

    private async Task RefreshNotificationSettingsAsync()
    {
        try
        {
            _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
            _exceptionDetailsAllowedByServer = await ClientFlagsApiClient.GetExceptionDetailsAllowedAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load notification settings");
            _notificationSettingsErrorMessage = T["Failed to load notification settings. Try reloading the page."];
        }
    }

    /// <summary>
    /// Parses one of the numeric notification inputs and saves the settings with buildUpdated applying
    /// the parsed value - non-numeric input is ignored (the field just re-renders the stored value); the
    /// server clamps out-of-range numbers (see BannerTiming and NotificationSettings.RetentionDays) and
    /// the response re-syncs the field.
    /// </summary>
    private async Task UpdateNumericSettingAsync(ChangeEventArgs args, Func<int, NotificationSettingsDto> buildUpdated)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return;
        }

        await UpdateNotificationSettingsAsync(buildUpdated(value));
    }

    private async Task UpdateNotificationSettingsAsync(NotificationSettingsDto updated)
    {
        _isSavingNotificationSettings = true;
        _notificationSettingsErrorMessage = null;
        try
        {
            _notificationSettings = await NotificationsApiClient.UpdateSettingsAsync(
                new UpdateNotificationSettingsRequest(
                    updated.AllowNotifications, updated.AllowPush, updated.AllowEmail, updated.AllowMobileBanner, updated.ShowExceptionDetails,
                    updated.BannerVisibleSeconds, updated.BannerMinimumGapSeconds, updated.AllowShareNotifications,
                    updated.RetentionDays));
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to update notification settings");
            _notificationSettingsErrorMessage = T["Failed to update notification settings. Try again."];
        }
        finally
        {
            _isSavingNotificationSettings = false;
        }
    }

    private async Task SetThemeAsync(ThemePreference preference)
    {
        Logger.LogInformation("User set theme preference to {ThemePreference}", preference);
        await ThemeService.SetAsync(preference);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task SetAccentColorAsync(AccentColor accentColor)
    {
        Logger.LogInformation("User set the accent colour to {AccentColor}", accentColor.Name);
        await AccentColorService.SetAsync(accentColor);
    }

    /// <summary>
    /// One swatch painted in the colour it stands for. Written against that colour's own hue rather than
    /// against --accent, which is whichever one is currently chosen - a row of eight identical swatches
    /// would be no choice at all. Invariant on purpose: this is a CSS value, not text anybody reads.
    /// </summary>
    private static string AccentSwatchStyle(AccentColor accentColor)
        => string.Create(CultureInfo.InvariantCulture, $"--accent-hue:{accentColor.Hue};");

    /// <summary>
    /// Determines whether the "push notifications" switch should be enabled at all (the browser must
    /// support push - see PushNotificationManager.IsSupportedAsync), and, if so, whether this browser
    /// already has an active subscription - so a page reload doesn't show it off for a browser that
    /// already enabled push notifications in an earlier session.
    /// </summary>
    private async Task RefreshPushNotificationStateAsync()
    {
        try
        {
            _pushNotificationsSupported = await PushNotificationManager.IsSupportedAsync();
            _pushNotificationsEnabled = _pushNotificationsSupported == true && await PushNotificationManager.IsEnabledAsync();
        }
        catch (JSException exception)
        {
            // crypto/push APIs are only exposed by browsers in a secure context - see MainLayout's
            // matching comment on the E2EE key setup for the same restriction. Best-effort: simply
            // treats push as unsupported rather than breaking the page.
            _pushNotificationsSupported = false;
            Logger.LogWarning(exception, "Push notifications are unavailable in this browsing context");
        }
    }

    private async Task TogglePushNotificationsAsync()
    {
        _pushNotificationActionInProgress = true;
        _pushNotificationErrorMessage = null;

        try
        {
            if (_pushNotificationsEnabled)
            {
                await PushNotificationManager.DisableAsync();
                _pushNotificationsEnabled = false;
            }
            else
            {
                _pushNotificationsEnabled = await PushNotificationManager.EnableAsync();
                if (!_pushNotificationsEnabled)
                {
                    // EnableAsync returns false, rather than throwing, when the user denies browser
                    // permission or Orbit.Api has no VAPID key configured - both silent by design up to
                    // this point, so without this the switch would otherwise just do nothing visible.
                    _pushNotificationErrorMessage =
                        T["Failed to enable push notifications. Check your browser permissions and try again."];
                }
            }
        }
        catch (HttpRequestException exception)
        {
            // Registering/removing the subscription with Orbit.Api failed (API unreachable, expired
            // session, ...) - logged rather than surfaced as a crash.
            Logger.LogError(exception, "Failed to update the push notification subscription");
            _pushNotificationErrorMessage = T["Failed to update the push notification subscription. Try again."];
        }
        catch (JSException exception)
        {
            // Same secure-context restriction as RefreshPushNotificationStateAsync - IsSupportedAsync
            // can pass (the browser APIs exist) while actually subscribing still fails outside a secure
            // context, or a push service rejects the subscription outright.
            Logger.LogError(exception, "Failed to update the push notification subscription");
            _pushNotificationErrorMessage = T["Failed to update the push notification subscription. Try again."];
        }
        finally
        {
            _pushNotificationActionInProgress = false;
        }
    }

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        AccentColorService.Changed -= OnThemeChanged;
    }

    private async Task LoadAccountAsync()
    {
        try
        {
            _account = await UsersApiClient.GetAccountAsync();
            await ReadWhetherGoogleCanConfirmAsync();
            if (_account is not null)
            {
                _profileForm.DisplayName = _account.DisplayName;
                _profileForm.UserName = _account.UserName;
                _profileForm.EmailAddress = _account.Email;
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the account profile");
        }
    }

    /// <summary>
    /// Saves the name and username outright, and treats a changed address as a request to move to it:
    /// the account keeps its current address until the code sent to the new one is confirmed, so this
    /// only starts that verification rather than performing the change.
    /// </summary>
    private async Task SaveProfileAsync()
    {
        _isSavingProfile = true;
        _profileMessage = null;
        try
        {
            var error = await UsersApiClient.UpdateProfileAsync(_profileForm.DisplayName, _profileForm.UserName);
            _profileFailed = error is not null;
            _profileMessage = error is null ? T["Profile saved."] : T[error];
            if (error is not null)
            {
                return;
            }

            var requestedAddress = _profileForm.EmailAddress.Trim();
            var isAddressChanged = !string.Equals(requestedAddress, _account?.Email, StringComparison.OrdinalIgnoreCase);
            await LoadAccountAsync();
            if (isAddressChanged)
            {
                // LoadAccountAsync just reset the box to the account's still-unchanged address; put the
                // requested one back so the pending change stays visible while it's being confirmed.
                _profileForm.EmailAddress = requestedAddress;
                await SendEmailCodeAsync();
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to save the account profile");
            _profileFailed = true;
            _profileMessage = T["Couldn't save your profile. Try again."];
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    /// <summary>
    /// Sends a code to the address in the profile form - the account's own (to verify it) or a new one
    /// (to change to it). Nothing about the account changes until the code comes back confirmed.
    /// </summary>
    private async Task SendEmailCodeAsync()
    {
        _isSendingCode = true;
        _emailMessage = null;
        var targetAddress = VerificationTargetAddress;
        try
        {
            var error = await UsersApiClient.RequestEmailVerificationAsync(targetAddress);
            _emailFailed = error is not null;
            _emailForm.SentToAddress = error is null ? targetAddress : string.Empty;
            _emailMessage = error is null
                ? T.Format("Code sent to {0}. It expires in 15 minutes.", targetAddress)
                : T[error];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to request an email verification code");
            _emailFailed = true;
            _emailMessage = T["Couldn't send the code. Try again."];
        }
        finally
        {
            _isSendingCode = false;
        }
    }

    private async Task ConfirmEmailCodeAsync()
    {
        _isConfirmingCode = true;
        _emailMessage = null;
        try
        {
            var error = await UsersApiClient.ConfirmEmailVerificationAsync(_emailForm.Code);
            _emailFailed = error is not null;
            _emailMessage = error is null ? T["Email address confirmed."] : T[error];
            if (error is null)
            {
                _emailForm.Clear();
                GoogleIntegrationAccess.Forget();
                await LoadAccountAsync();
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to confirm an email verification code");
            _emailFailed = true;
            _emailMessage = T["Couldn't confirm the code. Try again."];
        }
        finally
        {
            _isConfirmingCode = false;
        }
    }

    /// <summary>
    /// Changes the password, then re-wraps the chat key backup under it - see
    /// OwnEncryptionKeyProvider.RewrapAsync for why skipping that would quietly cost the user their
    /// message history on their next device.
    /// </summary>
    private async Task ChangePasswordAsync()
    {
        if (_passwordForm.NewPassword != _passwordForm.RepeatNewPassword)
        {
            _passwordFailed = true;
            _passwordMessage = T["The two new passwords don't match."];
            return;
        }

        _isChangingPassword = true;
        _passwordMessage = null;
        try
        {
            var changed = await UsersApiClient.ChangePasswordAsync(_passwordForm.CurrentPassword, _passwordForm.NewPassword);
            _passwordFailed = !changed;
            if (!changed)
            {
                _passwordMessage = T["That current password isn't right."];
                return;
            }

            await RewrapChatKeyAsync();
            _passwordMessage = T["Password changed."];
            _passwordForm.Clear();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to change the password");
            _passwordFailed = true;
            _passwordMessage = T["Couldn't change your password. Try again."];
        }
        finally
        {
            _isChangingPassword = false;
        }
    }

    /// <summary>
    /// Best-effort, and deliberately not fatal: the password has already changed by this point, so a
    /// browser that has no key to re-wrap should report that rather than pretend the change failed.
    /// </summary>
    private async Task RewrapChatKeyAsync()
    {
        try
        {
            await OwnEncryptionKeyProvider.RewrapAsync(_passwordForm.CurrentPassword, _passwordForm.NewPassword);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to re-wrap the chat key backup after a password change");
        }
    }

    /// <summary>
    /// Whether this deployment can show Google's sign-in at all - without a client id the button renders
    /// nothing, and an account with no password would be left with nothing to delete itself with. Read
    /// with the account rather than assumed: see ConfirmsWithGoogle.
    /// </summary>
    private bool _canConfirmWithGoogle;

    /// <summary>
    /// Whether this account proves it is the owner with Google rather than with a password or by typing
    /// its address: it has no password, it is linked to Google, and Google can be asked here.
    /// </summary>
    private bool ConfirmsWithGoogle
        => _account is { HasPassword: false, IsGoogleLinked: true } && _canConfirmWithGoogle;

    private async Task ReadWhetherGoogleCanConfirmAsync()
    {
        try
        {
            _canConfirmWithGoogle = (await ClientFlagsApiClient.GetGoogleClientIdAsync()).Length > 0;
        }
        catch (HttpRequestException exception)
        {
            // The typed confirmation is still there to fall back on, so this is not worth a message.
            Logger.LogWarning(exception, "Couldn't read whether Google sign-in is configured");
            _canConfirmWithGoogle = false;
        }
    }

    /// <summary>
    /// The Google button in the danger zone: a sign-in made just now, sent with the deletion for the
    /// server to check (DeleteAccountCommandHandler) - which is what proves the owner is the one asking,
    /// where a session left open somewhere could type the address as easily as the owner could.
    /// </summary>
    private async Task DeleteWithGoogleAsync(string idToken)
    {
        if (!await AskToDeleteAsync())
        {
            return;
        }

        await SendDeletionAsync(string.Empty, idToken, T["Google didn't confirm this account. Try again."]);
    }

    private async Task<bool> AskToDeleteAsync()
        => await JSRuntime.InvokeAsync<bool>(
            "confirm",
            T["Delete your account? This permanently deletes everything - notes, tasks, calendar events, inventory, and chat history. This cannot be undone."]);

    /// <summary>
    /// Asks for an explicit confirm() on top of what the account confirms itself with first - the one truly
    /// irreversible action on this page gets a stronger guard than the rest. An account with a password
    /// gives it (see DeleteAccountRequest). One without confirms with Google (see DeleteWithGoogleAsync),
    /// or - where this deployment has no Google sign-in - types its email address or login, checked here
    /// against the account already loaded, which makes the press deliberate rather than proving anything
    /// to the server. On success the account and everything it owns is already gone server-side; this
    /// only drops the local session and sends the browser to /login, mirroring MainLayout.LogoutAsync.
    /// </summary>
    private async Task DeleteAccountAsync()
    {
        // Without the account there is no telling what to ask for, and guessing "nothing" is the one
        // wrong guess that deletes something.
        if (_account is null)
        {
            _deleteAccountFailed = true;
            _deleteAccountMessage = T["Your account hasn't loaded yet. Reload the page and try again."];
            return;
        }

        if (_account.HasPassword && string.IsNullOrEmpty(_deleteAccountForm.Password))
        {
            _deleteAccountFailed = true;
            _deleteAccountMessage = T["Enter your password to confirm."];
            return;
        }

        if (!_account.HasPassword && !_deleteAccountForm.ConfirmsAccount(_account))
        {
            _deleteAccountFailed = true;
            _deleteAccountMessage = T["That isn't this account's email address or login."];
            return;
        }

        if (!await AskToDeleteAsync())
        {
            return;
        }

        // Refused although no password was asked for means one was set since this page loaded - on
        // another device, or at the chat gate in another tab.
        await SendDeletionAsync(
            _deleteAccountForm.Password, googleIdToken: null,
            _account.HasPassword
                ? T["That password isn't right."]
                : T["This account has a password now - reload the page and enter it."]);
    }

    /// <summary>
    /// Sends the deletion with whatever the account confirmed itself with, and says <paramref name="refused"/>
    /// when the server turns it down - which differs by what was offered, so the caller names it.
    /// </summary>
    private async Task SendDeletionAsync(string password, string? googleIdToken, string refused)
    {
        _isDeletingAccount = true;
        _deleteAccountMessage = null;
        try
        {
            var deleted = await UsersApiClient.DeleteAccountAsync(password, googleIdToken);
            if (!deleted)
            {
                _deleteAccountFailed = true;
                _deleteAccountMessage = refused;
                return;
            }

            await AuthApiClient.LogoutAsync();
            AuthenticationStateProvider.NotifyAuthenticationStateChanged();
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete the account");
            _deleteAccountFailed = true;
            _deleteAccountMessage = T["Couldn't delete your account. Try again."];
        }
        finally
        {
            _isDeletingAccount = false;
        }
    }

    private async Task LinkGoogleAsync(string idToken)
    {
        _isChangingGoogleLink = true;
        _googleMessage = null;
        try
        {
            var error = await UsersApiClient.LinkGoogleAsync(idToken);
            _googleFailed = error is not null;
            _googleMessage = error is null ? T["Google connected."] : T[error];
            GoogleIntegrationAccess.Forget();
            await LoadAccountAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to connect Google");
            _googleFailed = true;
            _googleMessage = T["Couldn't connect Google. Try again."];
        }
        finally
        {
            _isChangingGoogleLink = false;
        }
    }

    private async Task UnlinkGoogleAsync()
    {
        _isChangingGoogleLink = true;
        _googleMessage = null;
        try
        {
            var error = await UsersApiClient.UnlinkGoogleAsync();
            _googleFailed = error is not null;
            _googleMessage = error is null ? T["Google disconnected."] : T[error];
            GoogleIntegrationAccess.Forget();
            await LoadAccountAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to disconnect Google");
            _googleFailed = true;
            _googleMessage = T["Couldn't disconnect Google. Try again."];
        }
        finally
        {
            _isChangingGoogleLink = false;
        }
    }

    private sealed class ProfileFormModel
    {
        public string DisplayName { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;

        /// <summary>What the user wants the address to be - the account only moves to it once a code sent there is confirmed.</summary>
        public string EmailAddress { get; set; } = string.Empty;
    }

    private sealed class DeleteAccountFormModel
    {
        public string Password { get; set; } = string.Empty;

        /// <summary>What an account without a password types before it is deleted - see <see cref="ConfirmsAccount"/>.</summary>
        public string Confirmation { get; set; } = string.Empty;

        /// <summary>
        /// The address or the login, in any case and with stray spaces ignored: both are what the reader
        /// signs in with, so either is something they know without looking it up. Not a secret - the
        /// address is on this page - because what this checks is that the deletion was meant.
        /// </summary>
        public bool ConfirmsAccount(AccountDto account)
        {
            var typed = Confirmation.Trim();
            return typed.Length > 0
                && (string.Equals(typed, account.Email, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(typed, account.UserName, StringComparison.OrdinalIgnoreCase));
        }
    }

    /// <summary>The five things an account holds, as the export offers them - see OrbitArchive.</summary>
    private enum ExportPart
    {
        Notes,
        TaskLists,
        CalendarEvents,
        Inventories,
        Places
    }

    private string DescribeExportPart(ExportPart part) => part switch
    {
        ExportPart.Notes => T["Notes"],
        ExportPart.TaskLists => T["Task lists"],
        ExportPart.CalendarEvents => T["Calendar events"],
        ExportPart.Inventories => T["Inventories"],
        _ => T["Places"]
    };

    /// <summary>
    /// Which parts of the account the next export will carry. Everything but places to begin with,
    /// because that is what an export meant before there was anything to choose, and it is what somebody
    /// who does not read this row expects to get.
    ///
    /// Places are the exception because they are the one part written out opened (see ArchivedPlace):
    /// somebody pressing Export the way they always have should not come away with a readable file of
    /// where they keep the spare key. Ticking the box is the asking, and the warning beside it says what
    /// the answer costs.
    /// </summary>
    private sealed class ExportChoice
    {
        private readonly HashSet<ExportPart> _chosen =
            [.. Enum.GetValues<ExportPart>().Where(part => part != ExportPart.Places)];

        public bool Includes(ExportPart part) => _chosen.Contains(part);

        /// <summary>Nothing ticked is not an export of nothing - it is a button with no reason to be pressed.</summary>
        public bool IsEmpty => _chosen.Count == 0;

        public void Set(ExportPart part, bool included)
        {
            if (included)
            {
                _chosen.Add(part);
            }
            else
            {
                _chosen.Remove(part);
            }
        }

        /// <summary>
        /// The archive with the unticked parts emptied. Emptied rather than left out: the file's shape
        /// is what an importer reads, and one missing a list is a file an older Orbit would refuse.
        /// </summary>
        public OrbitArchive Narrow(OrbitArchive archive)
            => archive with
            {
                Notes = Includes(ExportPart.Notes) ? archive.Notes : [],
                TaskLists = Includes(ExportPart.TaskLists) ? archive.TaskLists : [],
                CalendarEvents = Includes(ExportPart.CalendarEvents) ? archive.CalendarEvents : [],
                Inventories = Includes(ExportPart.Inventories) ? archive.Inventories : [],
                Places = Includes(ExportPart.Places) ? archive.AllPlaces : []
            };
    }

    private sealed class EmailFormModel
    {
        /// <summary>
        /// Where the code in play was actually sent - kept separately from the address in the profile
        /// form, which the user may have edited again since, so the prompt never names the wrong inbox.
        /// </summary>
        public string SentToAddress { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;

        public bool IsCodePending => SentToAddress.Length > 0;

        public void Clear()
        {
            SentToAddress = string.Empty;
            Code = string.Empty;
        }
    }

    private sealed class PasswordFormModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string RepeatNewPassword { get; set; } = string.Empty;

        public void Clear()
        {
            CurrentPassword = string.Empty;
            NewPassword = string.Empty;
            RepeatNewPassword = string.Empty;
        }
    }
