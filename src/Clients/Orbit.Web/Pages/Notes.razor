@page "/notes"
@implements IDisposable
@attribute [Authorize]
@using Orbit.Contracts.Notes
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject FolderState Folders
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Notes> Logger
@inject NotificationFeedState NotificationFeedState
@inject Translations T

<PageTitle>@T["Orbit — Notes"]</PageTitle>

<PageHeader>
    <LeadingAction>
        @* The one thing this page is for, left of what the page is called. An icon rather than a labelled
           button: "Add note" on a page headed "Notes" spends a quarter of the row saying what the plus
           already says, and it is in the same place on every list. *@
        <button type="button" class="icon-btn page-add" title="@(T["Add note"])" aria-label="@(T["Add note"])"
                @onclick="GoToAddNote">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
        </button>
    </LeadingAction>
    <Title>@T["Notes"]</Title>
</PageHeader>

@if (_deleteMessage is not null)
{
    <p class="info">@_deleteMessage</p>
}

@* Which folder is being read. The notes' own folders, and only those: a folder belongs to one page, so
   the tab called "Work" here is not the tab called "Work" on the task lists - see FolderScope. On a
   phone it folds into one Menu button - see PhoneToolbar, which is nothing at all on a wider screen. *@
<PhoneToolbar Page="FolderPage.Notes">
    <FolderTabs Page="FolderPage.Notes" CountIn="CountIn" />
</PhoneToolbar>

<ObjectList IsLoading="_notes is null" IsEmpty="_notes is { Count: 0 }" EmptyMessage="@T["No notes."]">
    @if (_notes is { Count: > 0 } && VisibleNotes.Count == 0)
    {
        <p class="empty-hint">@T["Nothing in this folder."]</p>
    }
    <div class="item-card-list">
        @foreach (var note in Ordered(VisibleNotes))
        {
            <ItemCard Name="@NameOf(note)"
                      OnNameSelected="() => OpenNote(note.Id)"
                      OnBodySelected="() => OpenNote(note.Id)"
                      ExtraClass="@(note.IsPinned ? "item-card-pinned" : null)">
                @* Every card has one, and one control for both cases: the note's pin is this reader's
                   own either way. A note you own carries it on the note; one shared with you carries it
                   on your grant, which is what stops a recipient rearranging the owner's page - see
                   NoteShare.IsPinnedByRecipient. Both travel on the same request. *@
                <Pin>
                    <PinButton IsPinned="note.IsPinned" OnPinnedChanged="pinned => SetPinnedAsync(note, pinned)" />
                </Pin>
                <Menu>
                    @* The card opens the note to be read; changing what it says is a named press, the
                       same as a task list's - see NoteSummary.razor. Named for what it will actually
                       do: a note shared read-only opens in the form to be looked at, and calling that
                       "Edit" here and "View" one press further in said two different things about one
                       note. Somebody else's note is not this reader's to delete: pressing that takes it
                       off their list and leaves the owner's alone, so it says that rather than "Delete". *@
                    <ObjectMenu EditLabel="@(CanBeChanged(note) ? T["Edit"] : T["View"])" OnEdit="() => GoToEditNote(note.Id)"
                                DuplicateLabel="@(note.IsShared ? null : T["Duplicate"])"
                                OnDuplicate="() => DuplicateNoteAsync(note)"
                                DeleteLabel="@(note.IsShared ? T["Remove from my list"] : T["Delete"])"
                                OnDelete="() => DeleteNoteAsync(note)" DeleteDisabled="@(_deletingNoteId == note.Id)" />
                </Menu>
                <Extras>
                    @* When, in as few words as it takes. "Created" is gone: a note is read by when it
                       last changed, and two timestamps on a card this size is one more than anybody
                       reads. In the footer, which is where a card says things about itself. *@
                    <span>@WhenLastChanged(note.UpdatedAtUtc)</span>
                </Extras>
                <Body>
                    @* A private note is sealed - the server holds no readable line of it, and the key
                       is not on this page. Its name stands for it here and the editor opens it. *@
                    @if (!note.IsPrivate && FirstLine(note) is { } firstLine)
                    {
                        <p class="note-preview-line @(firstLine.IsChecklistItem && firstLine.IsChecked ? "completed" : "")">
                            @if (firstLine.IsChecklistItem)
                            {
                                <span class="task-preview-mark">@(firstLine.IsChecked ? "✓" : "")</span>
                            }
                            <span class="note-preview-text">@firstLine.Text</span>
                            @if (note.Content.Count > 1)
                            {
                                <span class="row-meta">@T.Format("+{0} more", note.Content.Count - 1)</span>
                            }
                        </p>
                    }
                </Body>
            </ItemCard>
        }
    </div>
</ObjectList>

@code {
    private IReadOnlyList<NoteDto>? _notes;

    /// <summary>
    /// The notes in the folder that is open. A note nobody filed is still in one - Public, or Private
    /// when it is sealed - see FolderPlacement, which decides it for every page made of cards.
    /// </summary>
    private IReadOnlyList<NoteDto> VisibleNotes
        => [.. (_notes ?? []).Where(note => Folders.ShowsUnderTheChosenTab(FolderPage.Notes, note.FolderId, note.IsPrivate))];

    /// <summary>
    /// How many notes are under each tab, drawn on the tab itself. There is no Finished tab here: a
    /// note has nothing to finish, so the tab could only ever have read zero - see
    /// FolderPages.HasAFinishedTab.
    /// </summary>
    private int CountIn(FolderKey folder)
        => (_notes ?? []).Count(note =>
            Folders.PlacementOn(FolderPage.Notes, note.FolderId, note.IsPrivate) == folder);

    /// <summary>
    /// Pinned notes first, and the rest in the order the API sent them - most recently updated first.
    /// One question with one answer now: a shared note arrives carrying *this* reader's pin, stamped
    /// off their own grant, so there is nothing here to choose between.
    /// </summary>
    private IEnumerable<NoteDto> Ordered(IReadOnlyList<NoteDto> notes)
        => notes.OrderByDescending(note => note.IsPinned);

    /// <summary>
    /// The first line that has anything on it, or null for a note with nothing written in it yet. Used
    /// instead of the whole body glued together: a preview that prints everything is not a preview.
    /// </summary>
    private static NoteContentLineDto? FirstLine(NoteDto note)
        => note.Content.FirstOrDefault(line => !string.IsNullOrWhiteSpace(line.Text));

    /// <summary>
    /// What to call a note in the list. A private one is named by its own title like any other: it
    /// travels sealed, and this browser opens it on the way in (see NotesApiClient.OpenIfPrivateAsync),
    /// so the title is here to show. It used to read "Private note" for every one of them, on the belief
    /// that the page held no key - which left a column of identical rows nobody could tell apart, and
    /// the phone has never done it (see NoteListItem, which hides a title only while private items are
    /// locked).
    ///
    /// The fallback is still there for the two cases that have no title to show: a note nobody has named
    /// yet, and one sealed under a key pair that has since been replaced - that one arrives already
    /// saying so, and says it here.
    /// </summary>
    private string NameOf(NoteDto note)
        => string.IsNullOrWhiteSpace(note.Title) ? T["Private note"] : note.Title;

    /// <summary>
    /// When it last changed, said the way somebody would say it. Within the last week the weekday is
    /// enough and reads faster than a date; past that a weekday is ambiguous - "Tuesday" could be any
    /// of them - so it becomes a date.
    /// </summary>
    private string WhenLastChanged(DateTimeOffset updatedAtUtc)
    {
        var when = updatedAtUtc.LocalDateTime;
        var daysAgo = (DateTime.Now.Date - when.Date).Days;
        return daysAgo switch
        {
            0 => T["Today"],
            1 => T["Yesterday"],
            < 7 and > 0 => when.ToString("dddd", T.DisplayCulture),
            _ => when.ToString("d", T.DisplayCulture)
        };
    }

    protected override async Task OnInitializedAsync()
    {
        // MainLayout owns the polling; this only listens. A note somebody has just shared
        // is one this page has never read, so hearing about it has to mean reading again - see
        // OnNotificationsChanged.
        NotificationFeedState.Changed += OnNotificationsChanged;
        // The tabs are shared, so pressing one anywhere re-filters this page too.
        Folders.Changed += OnFoldersChanged;
        Logger.LogInformation("Notes page opened, loading notes");
        try
        {
            _notes = await NotesApiClient.GetNotesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {NoteCount} notes", _notes.Count);
    }

    private void GoToAddNote()
    {
        Logger.LogInformation("User clicked 'Add note'");
        NavigationManager.NavigateTo("/notes/new");
    }

    /// <summary>
    /// Whether this reader may change the note, which is what the menu is named for - see NoteSummary,
    /// which asks the same question of the note it has open.
    /// </summary>
    private static bool CanBeChanged(NoteDto note)
        => !note.IsShared || SharedItemAccess.For(note.IsShared, note.AccessLevel).CanEdit;

    private void OpenNote(Guid noteId)
    {
        Logger.LogInformation("User opened note {NoteId}", noteId);
        NavigationManager.NavigateTo($"/notes/{noteId}");
    }

    private void GoToEditNote(Guid noteId)
    {
        Logger.LogInformation("User clicked 'Edit' for note {NoteId}", noteId);
        NavigationManager.NavigateTo(ReturnTo.Link($"/notes/{noteId}/edit", "/notes"));
    }

    /// <summary>
    /// Saves the pin and reflects it locally rather than reloading the whole list: nothing else about
    /// the note changed, and a reload here would throw away the reader's scroll position.
    /// </summary>
    private async Task SetPinnedAsync(NoteDto note, bool isPinned)
    {
        Logger.LogInformation("User clicked '{Action}' for note {NoteId}", isPinned ? "Pin" : "Unpin", note.Id);
        try
        {
            if (!await NotesApiClient.SetPinnedAsync(note.Id, isPinned))
            {
                return;
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to pin note {NoteId}", note.Id);
            return;
        }

        _notes = _notes!
            .Select(existingNote => existingNote.Id == note.Id ? existingNote with { IsPinned = isPinned } : existingNote)
            .ToList();
    }

    /// <summary>Which note is being deleted right now, so a second press cannot ask twice.</summary>
    private Guid? _deletingNoteId;

    /// <summary>What to say about the last delete - empty while nothing needs saying.</summary>
    private string? _deleteMessage;

    /// <summary>
    /// A second note saying the same thing, named for the one it came from. The whole list is read
    /// again afterwards rather than the copy being appended here: the server decides what a note looks
    /// like, and the page has to re-sort around the new one anyway.
    ///
    /// A sealed note keeps its name, because that name is inside a payload the browser would have to
    /// re-seal to change - see DuplicateRequest.Name.
    /// </summary>
    private async Task DuplicateNoteAsync(NoteDto note)
    {
        Logger.LogInformation("User clicked 'Duplicate' for note {NoteId}", note.Id);
        _deleteMessage = null;
        try
        {
            await NotesApiClient.DuplicateNoteAsync(note.Id, note.IsPrivate ? null : CopyOf(note.Title));
            _notes = await NotesApiClient.GetNotesAsync();
        }
        catch (HttpRequestException exception)
        {
            // Said on screen rather than only in the log: a press that copied nothing and said nothing
            // reads as a press that never registered.
            Logger.LogWarning(exception, "Couldn't duplicate note {NoteId}", note.Id);
            _deleteMessage = T["Couldn't make a copy. Try again."];
        }
    }

    /// <summary>What a copy is called - see DuplicateRequest.Name for why the client names it and not the server.</summary>
    private string CopyOf(string name) => T.Format("{0} (copy)", name);

    private async Task DeleteNoteAsync(NoteDto note)
    {
        if (_deletingNoteId is not null)
        {
            return;
        }

        Logger.LogInformation("User clicked 'Delete' for note {NoteId}", note.Id);
        _deleteMessage = null;
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            note.IsShared
                ? T.Format("Remove \"{0}\" from your list? The owner keeps it.", note.Title)
                : T.Format("Delete note \"{0}\"?", note.Title));
        if (!confirmed)
        {
            return;
        }

        _deletingNoteId = note.Id;
        try
        {
            await NotesApiClient.DeleteNoteAsync(note.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            // Already gone - deleted from another tab, or on a device that has since synced. The row was
            // being left on screen, so pressing Delete again asked about a note that no longer existed
            // and was refused again, for as long as anybody kept pressing.
            Logger.LogInformation("Note {NoteId} was already gone; taking it off the list", note.Id);
            _notes = _notes!.Where(existingNote => existingNote.Id != note.Id).ToList();
            _deleteMessage = T["That note was already gone. The list has been brought up to date."];
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete note {NoteId}", note.Id);
            _deleteMessage = T["Couldn't delete that note. Try again."];
            return;
        }
        finally
        {
            _deletingNoteId = null;
        }

        _notes = _notes!.Where(existingNote => existingNote.Id != note.Id).ToList();
        Logger.LogInformation("Note {NoteId} deleted", note.Id);
    }
    /// <summary>
    /// Something reached the bell, so the notes are read again. Redrawing alone would not do: a note
    /// somebody has just shared is one this page does not hold, and a share that only appears on the
    /// next reload is a share that looks like it did not arrive.
    ///
    /// A read per notification is affordable because a notification is rare - one arrives when somebody
    /// does something, not on a timer.
    /// </summary>
    private void OnNotificationsChanged()
        => InvokeAsync(async () =>
        {
            try
            {
                _notes = await NotesApiClient.GetNotesAsync();
            }
            catch (HttpRequestException exception)
            {
                // Already drawn, and still correct about everything it knew a moment ago. Nobody asked
                // for this read, so nothing is said about its failing.
                Logger.LogWarning(exception, "Couldn't re-read the notes after a notification");
            }

            StateHasChanged();
        });

    private void OnFoldersChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NotificationFeedState.Changed -= OnNotificationsChanged;
        Folders.Changed -= OnFoldersChanged;
    }

}
