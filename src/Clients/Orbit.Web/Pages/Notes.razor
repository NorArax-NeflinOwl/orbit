@page "/"
@attribute [Authorize]
@using Orbit.Contracts.Notes
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Notes> Logger

<PageTitle>Orbit — Notatki</PageTitle>

<h1>Notatki</h1>

<p><button @onclick="GoToAddNote">Dodaj notatkę</button></p>

@if (_notes is null)
{
    <p>Ładowanie…</p>
}
else if (_notes.Count == 0)
{
    <p>Brak notatek.</p>
}
else
{
    <ul>
        @foreach (var note in _notes)
        {
            <li>
                <strong>@note.Title</strong>
                <p>@note.Content</p>
                <small>Utworzono: @note.CreatedAtUtc.LocalDateTime</small><br>
                <small>Ostatnia zmiana: @note.UpdatedAtUtc.LocalDateTime</small><br>
                <button @onclick="() => GoToEditNote(note.Id)">Edytuj</button>
                <button @onclick="() => DeleteNoteAsync(note)">Usuń</button>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<NoteDto>? _notes;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Notes page opened, loading notes");
        try
        {
            _notes = await NotesApiClient.GetNotesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {NoteCount} notes", _notes.Count);
    }

    private void GoToAddNote()
    {
        Logger.LogInformation("User clicked 'Dodaj notatkę'");
        NavigationManager.NavigateTo("/notes/new");
    }

    private void GoToEditNote(Guid noteId)
    {
        Logger.LogInformation("User clicked 'Edytuj' for note {NoteId}", noteId);
        NavigationManager.NavigateTo($"/notes/{noteId}");
    }

    private async Task DeleteNoteAsync(NoteDto note)
    {
        Logger.LogInformation("User clicked 'Usuń' for note {NoteId}", note.Id);
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Usunąć notatkę „{note.Title}”?");
        if (!confirmed)
        {
            return;
        }

        await NotesApiClient.DeleteNoteAsync(note.Id);
        _notes = _notes!.Where(existingNote => existingNote.Id != note.Id).ToList();
        Logger.LogInformation("Note {NoteId} deleted", note.Id);
    }
}
