@page "/notes"
@attribute [Authorize]
@using Orbit.Contracts.Notes
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Notes> Logger
@inject Translations T

<PageTitle>@T["Orbit — Notes"]</PageTitle>

@* TODO(Orbit.Web.UI): still the pre-redesign markup - plain <ul>/<li>/<button>, no design-system
   classes. Restyle onto the tokens/components in wwwroot/css/app.css (.page-header, .card, .card-grid,
   .btn-primary/.btn-secondary, .list-row) the way Dashboard.razor's "Notes" card already does, instead
   of introducing new one-off classes. *@
<div class="page-header">
    <div>
        <h1>@T["Notes"]</h1>
        <p class="page-subtitle">@T["Everything you have written down, and anything shared with you."]</p>
    </div>
    <div class="page-header-actions">
        <button type="button" class="btn-primary" @onclick="GoToAddNote">@T["Add note"]</button>
    </div>
</div>

@if (_deleteMessage is not null)
{
    <p class="info">@_deleteMessage</p>
}

@if (_notes is null)
{
    <p>@T["Loading…"]</p>
}
else if (_notes.Count == 0)
{
    <p>@T["No notes."]</p>
}
else
{
    <ul>
        @foreach (var note in Ordered(_notes))
        {
            <li class="note-row @(note.IsPinned ? "note-row-pinned" : "")">
                <div class="note-row-heading">
                    <strong class="note-row-title">@note.Title</strong>
                    @* Only for a note you own: pinning moves it on its owner's page, so a recipient
                       pinning a note shared with them would be rearranging someone else's list. *@
                    @if (!note.IsShared)
                    {
                        <PinButton IsPinned="note.IsPinned" OnPinnedChanged="pinned => SetPinnedAsync(note, pinned)" />
                    }
                </div>
                @* One line, not the whole note - enough to recognise which note this is, with the
                   editor one click away for reading it. A checklist line shows whether it is done, the
                   same mark the task list preview uses. *@
                @if (FirstLine(note) is { } firstLine)
                {
                    <p class="note-preview-line @(firstLine.IsChecklistItem && firstLine.IsChecked ? "completed" : "")">
                        @if (firstLine.IsChecklistItem)
                        {
                            <span class="task-preview-mark">@(firstLine.IsChecked ? "✓" : "")</span>
                        }
                        <span class="note-preview-text">@firstLine.Text</span>
                        @if (note.Content.Count > 1)
                        {
                            <span class="row-meta">@T.Format("+{0} more", note.Content.Count - 1)</span>
                        }
                    </p>
                }
                <small>@T["Created:"] @note.CreatedAtUtc.LocalDateTime</small><br>
                <small>@T["Last updated:"] @note.UpdatedAtUtc.LocalDateTime</small><br>
                <button @onclick="() => GoToEditNote(note.Id)">@T["Edit"]</button>
                @* Somebody else's note is not this reader's to delete: pressing this takes it off their
                   list and leaves the owner's alone, so it says that rather than "Delete". *@
                <button disabled="@(_deletingNoteId == note.Id)" @onclick="() => DeleteNoteAsync(note)">@(note.IsShared ? T["Remove from my list"] : T["Delete"])</button>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<NoteDto>? _notes;

    /// <summary>Pinned notes first, and the rest in the order the API sent them - most recently updated first.</summary>
    private static IEnumerable<NoteDto> Ordered(IReadOnlyList<NoteDto> notes)
        => notes.OrderByDescending(note => note.IsPinned);

    /// <summary>Joins a note's lines back into a single line of text for the list preview, since Content is now structured rather than a flat string.</summary>
    /// <summary>
    /// The first line that has anything on it, or null for a note with nothing written in it yet. Used
    /// instead of the whole body glued together: a preview that prints everything is not a preview.
    /// </summary>
    private static NoteContentLineDto? FirstLine(NoteDto note)
        => note.Content.FirstOrDefault(line => !string.IsNullOrWhiteSpace(line.Text));

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Notes page opened, loading notes");
        try
        {
            _notes = await NotesApiClient.GetNotesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {NoteCount} notes", _notes.Count);
    }

    private void GoToAddNote()
    {
        Logger.LogInformation("User clicked 'Add note'");
        NavigationManager.NavigateTo("/notes/new");
    }

    private void GoToEditNote(Guid noteId)
    {
        Logger.LogInformation("User clicked 'Edit' for note {NoteId}", noteId);
        NavigationManager.NavigateTo($"/notes/{noteId}");
    }

    /// <summary>
    /// Saves the pin and reflects it locally rather than reloading the whole list: nothing else about
    /// the note changed, and a reload here would throw away the reader's scroll position.
    /// </summary>
    private async Task SetPinnedAsync(NoteDto note, bool isPinned)
    {
        Logger.LogInformation("User clicked '{Action}' for note {NoteId}", isPinned ? "Pin" : "Unpin", note.Id);
        try
        {
            if (!await NotesApiClient.SetPinnedAsync(note.Id, isPinned))
            {
                return;
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to pin note {NoteId}", note.Id);
            return;
        }

        _notes = _notes!
            .Select(existingNote => existingNote.Id == note.Id ? existingNote with { IsPinned = isPinned } : existingNote)
            .ToList();
    }

    /// <summary>Which note is being deleted right now, so a second press cannot ask twice.</summary>
    private Guid? _deletingNoteId;

    /// <summary>What to say about the last delete - empty while nothing needs saying.</summary>
    private string? _deleteMessage;

    private async Task DeleteNoteAsync(NoteDto note)
    {
        if (_deletingNoteId is not null)
        {
            return;
        }

        Logger.LogInformation("User clicked 'Delete' for note {NoteId}", note.Id);
        _deleteMessage = null;
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            note.IsShared
                ? T.Format("Remove \"{0}\" from your list? The owner keeps it.", note.Title)
                : T.Format("Delete note \"{0}\"?", note.Title));
        if (!confirmed)
        {
            return;
        }

        _deletingNoteId = note.Id;
        try
        {
            await NotesApiClient.DeleteNoteAsync(note.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            // Already gone - deleted from another tab, or on a device that has since synced. The row was
            // being left on screen, so pressing Delete again asked about a note that no longer existed
            // and was refused again, for as long as anybody kept pressing.
            Logger.LogInformation("Note {NoteId} was already gone; taking it off the list", note.Id);
            _notes = _notes!.Where(existingNote => existingNote.Id != note.Id).ToList();
            _deleteMessage = T["That note was already gone. The list has been brought up to date."];
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete note {NoteId}", note.Id);
            _deleteMessage = T["Couldn't delete that note. Try again."];
            return;
        }
        finally
        {
            _deletingNoteId = null;
        }

        _notes = _notes!.Where(existingNote => existingNote.Id != note.Id).ToList();
        Logger.LogInformation("Note {NoteId} deleted", note.Id);
    }
}
