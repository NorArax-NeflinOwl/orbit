@page "/tasks"
@attribute [Authorize]
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Core.Tasks
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject TaskListArrangement Arrangement
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Tasks> Logger
@inject Translations T

<PageTitle>@T["Orbit — Tasks"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@T["Tasks"]</h1>
        <p class="page-subtitle">@T["Every list you own or someone shared with you."]</p>
    </div>
    <div class="page-header-actions">
        <button type="button" class="btn-primary" @onclick="GoToAddTaskList">@T["Add task list"]</button>
        @* The order these cards come in is something a reader sets once and then reads by, so it lives
           behind the menu rather than in a control taking up the top of every visit. Stays open while
           they try one order and then another - see OverflowMenu.StaysOpen. *@
        <OverflowMenu StaysOpen="true">
            <span class="overflow-menu-heading">@T["Sort"]</span>
            @foreach (var sortOrder in Enum.GetValues<TaskListSortOrder>())
            {
                <button type="button" class="avatar-dropdown-item @(sortOrder == Arrangement.SortOrder ? "chosen" : "")"
                        @onclick="() => SetSortOrderAsync(sortOrder)">
                    <span class="card-filter-mark">@(sortOrder == Arrangement.SortOrder ? "✓" : "")</span>
                    @DescribeSortOrder(sortOrder)
                </button>
            }
        </OverflowMenu>
    </div>
</div>

@if (_taskLists is null)
{
    <p>@T["Loading…"]</p>
}
else if (_taskLists.Count == 0)
{
    <p class="empty-hint">@T["No task lists yet."]</p>
}
else
{
    <div class="list-controls">
        <div class="list-filters">
            @* "All" is a filter like the rest rather than a way of clearing them, so there is always
               exactly one answer to "what am I looking at". *@
            <button type="button" class="filter-chip @(_filter == TaskListFilter.All ? "on" : "")"
                    @onclick="() => SetFilter(TaskListFilter.All)">@T["All"]<span class="filter-chip-count">@_taskLists.Count</span>
            </button>
            @foreach (var filter in SelectableFilters)
            {
                <button type="button" class="filter-chip @(_filter == filter ? "on" : "")"
                        @onclick="() => SetFilter(filter)">
                    @DescribeFilter(filter) <span class="filter-chip-count">@CountMatching(filter)</span>
                </button>
            }
        </div>
    </div>

    @if (VisibleTaskLists.Count == 0)
    {
        <p class="empty-hint">@T.Format("No lists are {0}.", DescribeFilter(_filter).ToLowerInvariant())</p>
    }

    <div class="card-grid">
        @foreach (var taskList in VisibleTaskLists)
        {
            <div class="card task-list-card @(_cardOrder.IsDragging(taskList) ? "dragging" : "")" @key="taskList.Id"
                 @ondragover:preventDefault="true" @ondrop="() => DropCardOnAsync(taskList)">
                <div class="card-header">
                    <span class="card-title">
                        @* Only where dragging means something: in every other order the cards are
                           arranged by an answer, and moving one by hand would not survive a redraw. *@
                        @if (Arrangement.SortOrder == TaskListSortOrder.Manual)
                        {
                            <span class="drag-handle" draggable="true" title="@(T["Drag to reorder"])"
                                  aria-label="@(T["Drag to reorder"])"
                                  @ondragstart="() => _cardOrder.Start(taskList)" @ondragend="_cardOrder.Finish">
                                <svg width="12" height="16" viewBox="0 0 12 16" fill="currentColor" aria-hidden="true">
                                    <circle cx="4" cy="4" r="1.3" /><circle cx="8" cy="4" r="1.3" />
                                    <circle cx="4" cy="8" r="1.3" /><circle cx="8" cy="8" r="1.3" />
                                    <circle cx="4" cy="12" r="1.3" /><circle cx="8" cy="12" r="1.3" />
                                </svg>
                            </span>
                        }
                        @Written(taskList.Title)
                        @if (taskList.IsGroup)
                        {
                            <span class="card-badge">@T["Group"]</span>
                        }
                        @if (taskList.IsShared)
                        {
                            <span class="card-badge">@T["Shared"]</span>
                        }
                        @if (taskList.Priority != "Normal")
                        {
                            <span class="card-badge card-badge-priority-@taskList.Priority.ToLowerInvariant()">@DescribePriority(ParsePriority(taskList))</span>
                        }
                        <span class="card-badge card-badge-status-@taskList.Status.ToLowerInvariant()">@DescribeStatus(ParseStatus(taskList))</span>
                        @if (taskList.IsPinned)
                        {
                            <span class="card-badge card-badge-pinned">@T["Pinned"]</span>
                        }
                    </span>
                    <span class="card-header-end">
                        <span class="card-count">@CompletionSummary(taskList)</span>
                        @* Only for a list you own: pinning moves the card on its owner's page, so a
                           recipient pinning a shared list would be rearranging someone else's. *@
                        @if (!taskList.IsShared)
                        {
                            <PinButton IsPinned="taskList.IsPinned" OnPinnedChanged="_ => TogglePinnedAsync(taskList)" />
                        }
                    </span>
                </div>

                @* Where a calendar list happens - the one thing that kind of list carries beyond its
                   entries, and the thing you would want to see without opening it. *@
                @if (taskList.Location.Length > 0)
                {
                    <p class="row-meta">@taskList.Location</p>
                }

                @* A preview rather than the whole list: enough to recognise what is on it, with the
                   checklist view one click away for working through it. *@
                @foreach (var item in taskList.Items.Take(PreviewItemCount))
                {
                    <div class="list-row task-preview-row @(item.IsCompleted ? "completed" : "")">
                        <span class="task-preview-mark">@(item.IsCompleted ? "✓" : "")</span>
                        <span class="row-title">@Written(item.Description)</span>
                        @if (item.LinkedTaskListId is not null)
                        {
                            <span class="row-meta">@T["follows another list"]</span>
                        }
                        else if (item.DueDateUtc is { } dueDate)
                        {
                            <span class="row-meta">@dueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>

                    @* What a row that only points at another list actually stands for. Without it a
                       group list's card is a stack of titles, which says nothing about the work. *@
                    @if (item.LinkedTaskListId is { } linkedTaskListId)
                    {
                        @foreach (var linkedItem in LinkedItems(linkedTaskListId))
                        {
                            <div class="list-row task-preview-row task-preview-row-linked @(linkedItem.IsCompleted ? "completed" : "")">
                                <span class="task-preview-mark">@(linkedItem.IsCompleted ? "✓" : "")</span>
                                <span class="row-title">@Written(linkedItem.Description)</span>
                            </div>
                        }
                        @if (LinkedItemCount(linkedTaskListId) > LinkedPreviewItemCount)
                        {
                            <div class="list-row task-preview-row-linked">
                                <span class="row-meta">@T.Format("and {0} more…", LinkedItemCount(linkedTaskListId) - LinkedPreviewItemCount)</span>
                            </div>
                        }
                    }
                }
                @if (taskList.Items.Count > PreviewItemCount)
                {
                    <div class="list-row">
                        <span class="row-meta">@T.Format("and {0} more…", taskList.Items.Count - PreviewItemCount)</span>
                    </div>
                }
                @if (taskList.Items.Count == 0)
                {
                    <p class="empty-hint">@T["No items on this list."]</p>
                }

                <div class="card-actions">
                    <button type="button" class="btn-primary" @onclick="() => GoToChecklist(taskList.Id)">@T["Open checklist"]</button>
                    <button type="button" class="btn-secondary" @onclick="() => GoToEditTaskList(taskList.Id)">@T["Edit"]</button>
                    <button type="button" class="btn-secondary" @onclick="() => DeleteTaskListAsync(taskList)">@T["Delete"]</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<TaskDto>? _taskLists;

    /// <summary>What the chips offer, in the order a list moves through its statuses - with "shared" after them, since it is about where a list came from rather than how far along it is.</summary>
    private static readonly TaskListFilter[] SelectableFilters =
        [TaskListFilter.New, TaskListFilter.Pending, TaskListFilter.Overdue, TaskListFilter.Completed, TaskListFilter.Shared];

    private TaskListFilter _filter = TaskListFilter.All;

    /// <summary>The card being dragged to a new place, while one is - see DragReordering.</summary>
    private readonly DragReordering<TaskDto> _cardOrder = new();

    /// <summary>
    /// Filtering and sorting happen here rather than on the server: the page already has every list it
    /// owns, so asking again would be a round trip to rearrange what is already on screen.
    /// </summary>
    private IReadOnlyList<TaskDto> VisibleTaskLists
    {
        get
        {
            var visible = (_taskLists ?? []).Where(taskList => Matches(taskList, _filter)).ToList();
            return Sort(visible, Arrangement);
        }
    }

    /// <summary>
    /// A status chip matches the status the list is in; "Shared" matches where it came from instead. The
    /// two are compared by name because the chips are one list, and the statuses are the other.
    /// </summary>
    private static bool Matches(TaskDto taskList, TaskListFilter filter) => filter switch
    {
        TaskListFilter.All => true,
        TaskListFilter.Shared => taskList.IsShared,
        _ => ParseStatus(taskList).ToString() == filter.ToString()
    };

    /// <summary>
    /// Pinned lists lead whatever the reader is sorting by - that is what pinning is for, and a pin that
    /// only held under one sort order would not be worth setting. The order the reader dragged the cards
    /// into is the exception: it already says where every card goes, and pinning would contradict it.
    /// </summary>
    private static IReadOnlyList<TaskDto> Sort(IReadOnlyList<TaskDto> taskLists, TaskListArrangement arrangement)
        => arrangement.SortOrder == TaskListSortOrder.Manual
            ? [.. AsArranged(taskLists, arrangement.ManualOrder)]
            : [.. SortWithinPinning(taskLists, arrangement.SortOrder).OrderByDescending(taskList => taskList.IsPinned)];

    /// <summary>
    /// The reader's own order, with anything they have not placed yet - a list made or shared since the
    /// last drag - after it rather than at the front, where it would push their arrangement about.
    /// </summary>
    private static IEnumerable<TaskDto> AsArranged(IReadOnlyList<TaskDto> taskLists, IReadOnlyList<Guid> manualOrder)
    {
        var placeById = manualOrder
            .Select((taskListId, place) => (taskListId, place))
            .ToDictionary(entry => entry.taskListId, entry => entry.place);
        return taskLists.OrderBy(taskList => placeById.GetValueOrDefault(taskList.Id, int.MaxValue));
    }

    private static IEnumerable<TaskDto> SortWithinPinning(IReadOnlyList<TaskDto> taskLists, TaskListSortOrder sortOrder) => sortOrder switch
    {
        // Within a priority, newest first: two lists that matter equally are most usefully ordered by
        // which was touched last.
        TaskListSortOrder.Priority => taskLists
            .OrderByDescending(ParsePriority)
            .ThenByDescending(taskList => taskList.UpdatedAtUtc),
        TaskListSortOrder.LeastImportantFirst => taskLists
            .OrderBy(ParsePriority)
            .ThenByDescending(taskList => taskList.UpdatedAtUtc),
        TaskListSortOrder.Newest => taskLists.OrderByDescending(taskList => taskList.CreatedAtUtc),
        TaskListSortOrder.Oldest => taskLists.OrderBy(taskList => taskList.CreatedAtUtc),
        TaskListSortOrder.Alphabetical => taskLists.OrderBy(taskList => taskList.Title, StringComparer.CurrentCultureIgnoreCase),
        _ => taskLists.OrderByDescending(taskList => taskList.Title, StringComparer.CurrentCultureIgnoreCase)
    };

    private int CountMatching(TaskListFilter filter)
        => (_taskLists ?? []).Count(taskList => Matches(taskList, filter));

    /// <summary>
    /// Re-reads the lists afterwards rather than editing the one in hand: the server decides what a list
    /// looks like now, and the page has to re-sort around the change anyway.
    /// </summary>
    private async Task TogglePinnedAsync(TaskDto taskList)
    {
        Logger.LogInformation(
            "User clicked '{Action}' for task list {TaskListId}", taskList.IsPinned ? "Unpin" : "Pin", taskList.Id);
        try
        {
            if (await TasksApiClient.SetPinnedAsync(taskList.Id, !taskList.IsPinned))
            {
                _taskLists = await TasksApiClient.GetTaskListsAsync();
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to change whether task list {TaskListId} is pinned", taskList.Id);
        }
    }

    private void SetFilter(TaskListFilter filter)
    {
        _filter = filter;
        Logger.LogInformation("Task list filter set to {Filter}", filter);
    }

    private async Task SetSortOrderAsync(TaskListSortOrder sortOrder)
    {
        await Arrangement.SetSortOrderAsync(sortOrder);
        Logger.LogInformation("Task lists sorted by {SortOrder}", sortOrder);
    }

    /// <summary>
    /// Where a card was dropped is where it belongs. The whole visible order is written back rather than
    /// the one card that moved: a stored order that named only the cards somebody had touched would put
    /// the rest wherever they happened to fall.
    /// </summary>
    private async Task DropCardOnAsync(TaskDto target)
    {
        var arranged = VisibleTaskLists.ToList();
        if (!_cardOrder.DropOn(arranged, target))
        {
            _cardOrder.Finish();
            return;
        }

        _cardOrder.Finish();
        await Arrangement.SetManualOrderAsync([.. arranged.Select(taskList => taskList.Id)]);
        Logger.LogInformation("User dragged task list {TaskListId} to a new place", target.Id);
    }

    /// <summary>An unrecognised status reads as New - a status this client doesn't know yet is not one it should invent a meaning for.</summary>
    private static TaskListStatus ParseStatus(TaskDto taskList)
        => Enum.TryParse<TaskListStatus>(taskList.Status, out var status) ? status : TaskListStatus.New;

    private static ItemPriority ParsePriority(TaskDto taskList)
        => Enum.TryParse<ItemPriority>(taskList.Priority, out var priority) ? priority : ItemPriority.Normal;

    /// <summary>Mirrors TaskEditor's own priority dropdown, so a list reads the same in both places.</summary>
    private string DescribePriority(ItemPriority priority) => priority switch
    {
        ItemPriority.Low => T["Low"],
        ItemPriority.High => T["High"],
        _ => T["Normal"]
    };

    private string DescribeFilter(TaskListFilter filter) => filter switch
    {
        TaskListFilter.Pending => T["In progress"],
        TaskListFilter.Completed => T["Done"],
        TaskListFilter.Overdue => T["Overdue"],
        TaskListFilter.Shared => T["Shared"],
        TaskListFilter.All => T["All"],
        _ => T["Not started"]
    };

    private string DescribeStatus(TaskListStatus status) => status switch
    {
        TaskListStatus.Pending => T["In progress"],
        TaskListStatus.Completed => T["Done"],
        TaskListStatus.Overdue => T["Overdue"],
        _ => T["Not started"]
    };

    private string DescribeSortOrder(TaskListSortOrder sortOrder) => sortOrder switch
    {
        TaskListSortOrder.Priority => T["Most important first"],
        TaskListSortOrder.LeastImportantFirst => T["Least important first"],
        TaskListSortOrder.Newest => T["Newest first"],
        TaskListSortOrder.Oldest => T["Oldest first"],
        TaskListSortOrder.Alphabetical => T["A to Z"],
        TaskListSortOrder.ReverseAlphabetical => T["Z to A"],
        _ => T["The way I arranged them"]
    };

    /// <summary>
    /// What a card can be narrowed down to: where a list has got to, or - for Shared - where it came
    /// from. One list rather than two controls, because a reader is only ever asking one of them.
    /// </summary>
    private enum TaskListFilter
    {
        All,
        New,
        Pending,
        Overdue,
        Completed,
        Shared
    }

    /// <summary>How much of a list to show on its card before falling back to "and N more" - a card is for recognising a list, not working through it.</summary>
    private const int PreviewItemCount = 4;

    /// <summary>How much of a linked list to show under the row that points at it - less than the card's own preview, since it is standing in for one line of it.</summary>
    private const int LinkedPreviewItemCount = 3;

    /// <summary>The work a linked row actually stands for, as far as the card has room for.</summary>
    private IEnumerable<TaskItemDto> LinkedItems(Guid linkedTaskListId)
        => LinkedTaskList(linkedTaskListId)?.Items.Take(LinkedPreviewItemCount) ?? [];

    private int LinkedItemCount(Guid linkedTaskListId) => LinkedTaskList(linkedTaskListId)?.Items.Count ?? 0;

    private TaskDto? LinkedTaskList(Guid linkedTaskListId)
        => (_taskLists ?? []).FirstOrDefault(candidate => candidate.Id == linkedTaskListId);

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(T, name);

    private static string CompletionSummary(TaskDto taskList)
        => taskList.Items.Count == 0 ? "empty" : $"{taskList.Items.Count(item => item.IsCompleted)}/{taskList.Items.Count}";

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Tasks page opened, loading task lists");
        await Arrangement.InitializeAsync();
        try
        {
            _taskLists = await TasksApiClient.GetTaskListsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {TaskListCount} task lists", _taskLists.Count);
    }

    private void GoToAddTaskList()
    {
        Logger.LogInformation("User clicked 'Add task list'");
        NavigationManager.NavigateTo("/tasks/new");
    }

    /// <summary>The deep editing level, which has to be asked for by name - see TaskEditor.razor.</summary>
    private void GoToEditTaskList(Guid taskListId)
    {
        Logger.LogInformation("User clicked 'Edit' for task list {TaskListId}", taskListId);
        NavigationManager.NavigateTo($"/tasks/{taskListId}/edit");
    }

    /// <summary>What opening a list means, here and everywhere else - see TaskListChecklist.razor.</summary>
    private void GoToChecklist(Guid taskListId)
    {
        Logger.LogInformation("User clicked 'Open checklist' for task list {TaskListId}", taskListId);
        NavigationManager.NavigateTo($"/tasks/{taskListId}");
    }

    private async Task DeleteTaskListAsync(TaskDto taskList)
    {
        Logger.LogInformation("User clicked 'Delete' for task list {TaskListId}", taskList.Id);
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete task list \"{taskList.Title}\"?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await TasksApiClient.DeleteTaskListAsync(taskList.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete task list {TaskListId}", taskList.Id);
            return;
        }

        _taskLists = _taskLists!.Where(existingTaskList => existingTaskList.Id != taskList.Id).ToList();
        Logger.LogInformation("Task list {TaskListId} deleted", taskList.Id);
    }
}
