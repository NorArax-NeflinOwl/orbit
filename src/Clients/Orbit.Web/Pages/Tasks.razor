@page "/tasks"
@attribute [Authorize]
@implements IDisposable
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Core.Tasks
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject TaskListArrangement Arrangement
@inject NotificationFeedState NotificationFeedState
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Tasks> Logger
@inject Translations T

<PageTitle>@T["Orbit — Tasks"]</PageTitle>

<PageHeader>
    <LeadingAction>
        @* The one thing this page is for, left of what the page is called - the same plus every list
           carries, in the same place. *@
        <button type="button" class="icon-btn page-add" title="@(T["Add task list"])"
                aria-label="@(T["Add task list"])" @onclick="GoToAddTaskList">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
        </button>
    </LeadingAction>
    <Title>@T["Tasks"]</Title>
    <Actions>
        @* The order these cards come in is something a reader sets once and then reads by, so it lives
           behind the menu rather than in a control taking up the top of every visit. Stays open while
           they try one order and then another - see OverflowMenu.StaysOpen. *@
        <OverflowMenu StaysOpen="true">
            @* How much of each list to show. One answer for the whole page, remembered by this browser -
               the question is "how am I reading this today", not one about any particular list. *@
            <span class="overflow-menu-heading">@T["Card view"]</span>
            @foreach (var view in Enum.GetValues<TaskListView>())
            {
                <button type="button" class="avatar-dropdown-item @(view == Arrangement.View ? "chosen" : "")"
                        @onclick="() => SetViewAsync(view)">
                    <span class="card-filter-mark">@(view == Arrangement.View ? "✓" : "")</span>
                    @DescribeView(view)
                </button>
            }

            <span class="overflow-menu-heading">@T["Sort"]</span>
            @foreach (var sortOrder in Enum.GetValues<TaskListSortOrder>())
            {
                <button type="button" class="avatar-dropdown-item @(sortOrder == Arrangement.SortOrder ? "chosen" : "")"
                        @onclick="() => SetSortOrderAsync(sortOrder)">
                    <span class="card-filter-mark">@(sortOrder == Arrangement.SortOrder ? "✓" : "")</span>
                    @DescribeSortOrder(sortOrder)
                </button>
            }
        </OverflowMenu>
    </Actions>
</PageHeader>

@if (_taskLists is null)
{
    <p>@T["Loading…"]</p>
}
else if (_taskLists.Count == 0)
{
    <p class="empty-hint">@T["No task lists yet."]</p>
}
else
{
    @* What the reader is looking for, above the chips that say which lists are on offer at all: a word
       from an entry, and the categories entries are filed under. Both narrow to lists that still hold
       something worth reading, and the cards then show what matched rather than their first few rows -
       a list shown for a match nobody can see reads as a bug. *@
    <div class="task-search">
        <input type="search" value="@_itemFilter.Search"
               @oninput="changeArgs => _itemFilter.Search = changeArgs.Value?.ToString() ?? string.Empty"
               placeholder="@(T["Find an entry on any list"])" aria-label="@(T["Find an entry on any list"])" />
        @if (_itemFilter.IsActive)
        {
            <button type="button" class="btn-secondary" @onclick="_itemFilter.Clear">@T["Clear"]</button>
        }
    </div>

    @if (KnownCategories.Count > 0)
    {
        <div class="list-controls">
            <div class="list-filters">
                @foreach (var category in KnownCategories)
                {
                    <button type="button" class="filter-chip @(_itemFilter.IsChosen(category) ? "on" : "")"
                            @onclick="() => _itemFilter.Toggle(category)">
                        @category <span class="filter-chip-count">@CountEntriesIn(category)</span>
                    </button>
                }
            </div>
            @* Only worth asking once two are chosen: with one, "any of them" and "all of them" are the
               same question. *@
            @if (_itemFilter.Categories.Count > 1)
            {
                <label class="task-category-rule">
                    <input type="checkbox" checked="@_itemFilter.MatchesEveryCategory"
                           @onchange="changeArgs => _itemFilter.MatchesEveryCategory = changeArgs.Value is true" />
                    @T["Entries in every chosen category"]
                </label>
            }
        </div>
    }

    <div class="list-controls">
        <div class="list-filters">
            @* "All" is a filter like the rest rather than a way of clearing them, so there is always
               exactly one answer to "what am I looking at". *@
            <button type="button" class="filter-chip @(_filter == TaskListFilter.All ? "on" : "")"
                    @onclick="() => SetFilter(TaskListFilter.All)">@T["All"]<span class="filter-chip-count">@_taskLists.Count</span>
            </button>
            @foreach (var filter in SelectableFilters)
            {
                <button type="button" class="filter-chip @(_filter == filter ? "on" : "")"
                        @onclick="() => SetFilter(filter)">
                    @DescribeFilter(filter) <span class="filter-chip-count">@CountMatching(filter)</span>
                </button>
            }
        </div>
    </div>

    @if (VisibleTaskLists.Count == 0)
    {
        @* Which of the two narrowed everything away, since they say different things about what to do
           next: a chip is changed by pressing another one, a search by typing something else. *@
        @if (_itemFilter.IsActive)
        {
            <p class="empty-hint">@T["Nothing on any list matches that."]</p>
        }
        else
        {
            <p class="empty-hint">@T.Format("No lists are {0}.", DescribeFilter(_filter).ToLowerInvariant())</p>
        }
    }

    <div class="task-card-grid">
        @foreach (var taskList in VisibleTaskLists)
        {
            <div @key="taskList.Id" class="@(_cardOrder.IsDragging(taskList) ? "dragging" : "")"
                 @ondragover:preventDefault="true" @ondrop="() => DropCardOnAsync(taskList)">
                @* The rows of what is on the list open it as well as its name does: they sit above the
                   overlay that makes the rest of the card pressable, so without OnBodySelected the one
                   part of the card a reader actually points at was the one part that did nothing. *@
                <ItemCard Name="@Written(taskList.Title)"
                          OnNameSelected="() => GoToChecklist(taskList.Id)"
                          OnBodySelected="() => GoToChecklist(taskList.Id)"
                          HasUnseenAction="@(UnreadCountFor(taskList) > 0)"
                          IsCollapsed="Arrangement.IsCollapsed(taskList.Id)"
                          OnCollapseToggled="() => ToggleCollapsedAsync(taskList)"
                          ExtraClass="@(taskList.IsPinned ? "item-card-pinned" : null)">
                    @* Only where dragging means something: in every other order the cards are
                       arranged by an answer, and moving one by hand would not survive a redraw. *@
                    <Handle>
                        @if (Arrangement.SortOrder == TaskListSortOrder.Manual)
                        {
                            <ReorderControls OnDragStart="() => _cardOrder.Start(taskList)" OnDragEnd="_cardOrder.Finish"
                                             OnMoveUp="() => MoveCardAsync(taskList, -1)"
                                             OnMoveDown="() => MoveCardAsync(taskList, 1)"
                                             CanMoveUp="CanMoveCard(taskList, -1)" CanMoveDown="CanMoveCard(taskList, 1)" />
                        }
                    </Handle>
                    @* Only for a list you own: pinning moves the card on its owner's page, so a
                       recipient pinning a shared list would be rearranging someone else's. *@
                    <Pin>
                        @if (!taskList.IsShared)
                        {
                            <PinButton IsPinned="taskList.IsPinned" OnPinnedChanged="_ => TogglePinnedAsync(taskList)" />
                        }
                    </Pin>
                    <Menu>
                        @* Somebody else's shared list is not this reader's to delete - the same rule
                           the note and warehouse cards already follow. *@
                        <ObjectMenu EditLabel="@T["Edit"]" OnEdit="() => GoToEditTaskList(taskList.Id)"
                                    DeleteLabel="@(!taskList.IsShared ? T["Delete"] : null)" OnDelete="() => DeleteTaskListAsync(taskList)" />
                    </Menu>
                    <Tags>
                        @if (taskList.IsGroup)
                        {
                            <span class="card-badge">@T["Group"]</span>
                        }
                        @if (taskList.IsShared)
                        {
                            <span class="card-badge">@T["Shared"]</span>
                        }
                        @if (taskList.Priority != "Normal")
                        {
                            <span class="card-badge card-badge-priority-@taskList.Priority.ToLowerInvariant()">@DescribePriority(ParsePriority(taskList))</span>
                        }
                        <span class="card-badge card-badge-status-@taskList.Status.ToLowerInvariant()">@DescribeStatus(ParseStatus(taskList))</span>
                        @* Kept as a tag as well as an outline: the pin control is only offered on a
                           list you own, so on a shared one the tag is the only thing that says so. *@
                        @if (taskList.IsPinned)
                        {
                            <span class="card-badge card-badge-pinned">@T["Pinned"]</span>
                        }
                    </Tags>
                    @* How far along, always at the end of the tag row - see ItemCard. *@
                    <Extras>
                        <span class="card-count">@CompletionSummary(taskList)</span>
                    </Extras>
                    <CollapsedBody>
                @if (Arrangement.IsCollapsed(taskList.Id))
                {
                    @* One line, and the one worth having: what is still to be done on this list. A folded
                       card is somebody saying "not this week" - the row is there to remind them what the
                       list is about, not to be worked from. *@
                    @if (NextThingLeftToDo(taskList) is { } next)
                    {
                        <div class="list-row task-preview-row">
                            <span class="task-preview-mark"></span>
                            <span class="row-title">@Written(next.Description)</span>
                            @if (next.OnList is { } onList)
                            {
                                @* Which member list it is on. Without it, a group's folded card names
                                   an errand with no hint of where it came from. *@
                                <span class="row-meta">@Written(onList)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="list-row">
                            <span class="row-meta">@(taskList.Items.Count == 0 ? T["No items on this list."] : T["Nothing left to do."])</span>
                        </div>
                    }
                }
                    </CollapsedBody>
                    <Body>
                @* A preview rather than the whole list: enough to recognise what is on it, with the
                   checklist view one click away for working through it. What is previewed narrows with
                   the page - see EntriesToShow. *@
                @{ var entries = EntriesToShow(taskList); }
                @foreach (var item in entries.Take(RowsToShow(entries.Count, PreviewLimitFor(taskList))))
                {
                    <div class="list-row task-preview-row @(item.IsCompleted ? "completed" : "")">
                        <span class="task-preview-mark">@(item.IsCompleted ? "✓" : "")</span>
                        <span class="row-title">@Written(item.Description)</span>
                        @* What the entry is filed under, on the row itself: the chips above filter by
                           these, and a filter whose subject is invisible on what it returns leaves the
                           reader to take the page's word for it. *@
                        @foreach (var category in item.AllCategories)
                        {
                            <span class="row-category @(_itemFilter.IsChosen(category) ? "on" : "")">@category</span>
                        }
                        @if (item.AllLinkedTaskListIds.Count > 0)
                        {
                            <span class="row-meta">@T["follows another list"]</span>
                        }
                        @* A day to be done by belongs to a checklist entry - an appointment says when it
                           is in the calendar, and a restock errand is about an amount. Same rule as the
                           editor, which only asks a checklist entry for one. *@
                        else if (IsAChecklistEntry(item) && item.DueDateUtc is { } dueDate)
                        {
                            <span class="row-meta">@dueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>

                    @* What a row that only points at another list actually stands for. Without it a
                       group list's card is a stack of titles, which says nothing about the work. *@
                    @foreach (var linkedTaskListId in item.AllLinkedTaskListIds)
                    {
                        @foreach (var linkedItem in LinkedItems(linkedTaskListId))
                        {
                            <div class="list-row task-preview-row task-preview-row-linked @(linkedItem.IsCompleted ? "completed" : "")">
                                <span class="task-preview-mark">@(linkedItem.IsCompleted ? "✓" : "")</span>
                                <span class="row-title">@Written(linkedItem.Description)</span>
                            </div>
                        }
                        @if (LinkedItemCount(linkedTaskListId) > RowsToShow(LinkedItemCount(linkedTaskListId), LinkedPreviewItemCount))
                        {
                            <div class="list-row task-preview-row-linked">
                                <span class="row-meta">@T.Format("and {0} more…", LinkedItemCount(linkedTaskListId) - RowsToShow(LinkedItemCount(linkedTaskListId), LinkedPreviewItemCount))</span>
                            </div>
                        }
                    }
                }
                @if (entries.Count > RowsToShow(entries.Count, PreviewLimitFor(taskList)))
                {
                    <div class="list-row">
                        <span class="row-meta">@T.Format("and {0} more…", entries.Count - RowsToShow(entries.Count, PreviewLimitFor(taskList)))</span>
                    </div>
                }
                @if (taskList.Items.Count == 0)
                {
                    <p class="empty-hint">@T["No items on this list."]</p>
                }
                    </Body>
                </ItemCard>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<TaskDto>? _taskLists;

    /// <summary>What the reader is looking for among the entries themselves - see TaskItemFilter.</summary>
    private readonly TaskItemFilter _itemFilter = new();

    /// <summary>Every category anything on this page is filed under, in the order a reader reads them.</summary>
    private IReadOnlyList<string> KnownCategories
        => [.. (_taskLists ?? [])
            .SelectMany(taskList => taskList.Items.SelectMany(item => item.AllCategories))
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(category => category, StringComparer.CurrentCultureIgnoreCase)];

    /// <summary>How many entries carry a category, which is what makes a chip worth pressing or not.</summary>
    private int CountEntriesIn(string category)
        => (_taskLists ?? [])
            .SelectMany(taskList => taskList.Items)
            .Count(item => item.AllCategories.Contains(category, StringComparer.CurrentCultureIgnoreCase));

    /// <summary>
    /// The entries a card shows: what matched while something is being looked for, and simply what is
    /// on the list otherwise.
    /// </summary>
    private IReadOnlyList<TaskItemDto> EntriesToShow(TaskDto taskList)
        => _itemFilter.IsActive ? [.. taskList.Items.Where(_itemFilter.Matches)] : taskList.Items;

    /// <summary>What the chips offer, in the order a list moves through its statuses - with "shared" after them, since it is about where a list came from rather than how far along it is.</summary>
    private static readonly TaskListFilter[] SelectableFilters =
    [
        TaskListFilter.New, TaskListFilter.Pending, TaskListFilter.Overdue, TaskListFilter.Completed,
        TaskListFilter.Shared, TaskListFilter.Group
    ];

    private TaskListFilter _filter = TaskListFilter.All;

    /// <summary>The card being dragged to a new place, while one is - see RowArrangement.</summary>
    private readonly RowArrangement<TaskDto> _cardOrder = new();

    /// <summary>
    /// Filtering and sorting happen here rather than on the server: the page already has every list it
    /// owns, so asking again would be a round trip to rearrange what is already on screen.
    /// </summary>
    private IReadOnlyList<TaskDto> VisibleTaskLists
    {
        get
        {
            var visible = (_taskLists ?? [])
                .Where(taskList => Matches(taskList, _filter) && _itemFilter.HasAMatch(taskList))
                .ToList();
            return Sort(visible, Arrangement);
        }
    }

    /// <summary>
    /// A status chip matches the status the list is in; "Shared" matches where it came from and "Group"
    /// what kind of list it is. The status ones are compared by name because the chips are one list, and
    /// the statuses are the other.
    /// </summary>
    private static bool Matches(TaskDto taskList, TaskListFilter filter) => filter switch
    {
        TaskListFilter.All => true,
        TaskListFilter.Shared => taskList.IsShared,
        TaskListFilter.Group => taskList.IsGroup,
        _ => ParseStatus(taskList).ToString() == filter.ToString()
    };

    /// <summary>
    /// Pinned lists lead whatever the reader is sorting by - that is what pinning is for, and a pin that
    /// only held under one sort order would not be worth setting. The order the reader dragged the cards
    /// into is the exception: it already says where every card goes, and pinning would contradict it.
    /// </summary>
    private static IReadOnlyList<TaskDto> Sort(IReadOnlyList<TaskDto> taskLists, TaskListArrangement arrangement)
        => arrangement.SortOrder == TaskListSortOrder.Manual
            ? [.. AsArranged(taskLists, arrangement.ManualOrder)]
            : [.. SortWithinPinning(taskLists, arrangement.SortOrder).OrderByDescending(taskList => taskList.IsPinned)];

    /// <summary>
    /// The reader's own order, with anything they have not placed yet - a list made or shared since the
    /// last drag - after it rather than at the front, where it would push their arrangement about.
    /// </summary>
    private static IEnumerable<TaskDto> AsArranged(IReadOnlyList<TaskDto> taskLists, IReadOnlyList<Guid> manualOrder)
    {
        var placeById = manualOrder
            .Select((taskListId, place) => (taskListId, place))
            .ToDictionary(entry => entry.taskListId, entry => entry.place);
        return taskLists.OrderBy(taskList => placeById.GetValueOrDefault(taskList.Id, int.MaxValue));
    }

    private static IEnumerable<TaskDto> SortWithinPinning(IReadOnlyList<TaskDto> taskLists, TaskListSortOrder sortOrder) => sortOrder switch
    {
        // Within a priority, newest first: two lists that matter equally are most usefully ordered by
        // which was touched last.
        TaskListSortOrder.Priority => taskLists
            .OrderByDescending(ParsePriority)
            .ThenByDescending(taskList => taskList.UpdatedAtUtc),
        TaskListSortOrder.LeastImportantFirst => taskLists
            .OrderBy(ParsePriority)
            .ThenByDescending(taskList => taskList.UpdatedAtUtc),
        TaskListSortOrder.Newest => taskLists.OrderByDescending(taskList => taskList.CreatedAtUtc),
        TaskListSortOrder.Oldest => taskLists.OrderBy(taskList => taskList.CreatedAtUtc),
        TaskListSortOrder.Alphabetical => taskLists.OrderBy(taskList => taskList.Title, StringComparer.CurrentCultureIgnoreCase),
        _ => taskLists.OrderByDescending(taskList => taskList.Title, StringComparer.CurrentCultureIgnoreCase)
    };

    private int CountMatching(TaskListFilter filter)
        => (_taskLists ?? []).Count(taskList => Matches(taskList, filter));

    /// <summary>
    /// Re-reads the lists afterwards rather than editing the one in hand: the server decides what a list
    /// looks like now, and the page has to re-sort around the change anyway.
    /// </summary>
    private async Task TogglePinnedAsync(TaskDto taskList)
    {
        Logger.LogInformation(
            "User clicked '{Action}' for task list {TaskListId}", taskList.IsPinned ? "Unpin" : "Pin", taskList.Id);
        try
        {
            if (await TasksApiClient.SetPinnedAsync(taskList.Id, !taskList.IsPinned))
            {
                _taskLists = await TasksApiClient.GetTaskListsAsync();
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to change whether task list {TaskListId} is pinned", taskList.Id);
        }
    }

    private void SetFilter(TaskListFilter filter)
    {
        _filter = filter;
        Logger.LogInformation("Task list filter set to {Filter}", filter);
    }

    /// <summary>
    /// How many unread notifications are about this list - an overdue item on it, or its daily reminder.
    /// They all point at the list's own page (see OverdueTaskPushContent), which is what makes them
    /// countable per card.
    /// </summary>
    private int UnreadCountFor(TaskDto taskList) => NotificationFeedState.CountForSection($"/tasks/{taskList.Id}");

    private async Task ToggleCollapsedAsync(TaskDto taskList)
    {
        // Expanding a card while the whole page is folded away is a request to see things again, so it
        // leaves the minimal view rather than unfolding one card the view says is folded. The page goes
        // back to whatever it was before it was folded - see TaskListArrangement.LeaveMinimalViewAsync.
        if (Arrangement.View == TaskListView.Minimal)
        {
            Logger.LogInformation("User left the minimal view by expanding a card");
            await Arrangement.LeaveMinimalViewAsync();
            return;
        }

        var isCollapsed = !Arrangement.IsCollapsed(taskList.Id);
        Logger.LogInformation(
            "User {Action} the card for task list {TaskListId}", isCollapsed ? "minimised" : "expanded", taskList.Id);
        await Arrangement.SetCollapsedAsync(taskList.Id, isCollapsed);
    }

    /// <summary>What a folded card says is still to be done.</summary>
    /// <param name="OnList">The member list it sits on, when it was found through a link - null when it is the card's own.</param>
    private sealed record ThingLeftToDo(string Description, string? OnList);

    /// <summary>
    /// The one row a folded card shows: what is still to be done. A row that only points at another list
    /// is not work itself, so what it stands for is looked up on the list it points at. A group's card is
    /// nothing but such rows, and used to fold down to "Nothing left to do." with six errands still open.
    /// </summary>
    private ThingLeftToDo? NextThingLeftToDo(TaskDto taskList)
    {
        foreach (var item in taskList.Items.Where(item => !item.IsCompleted))
        {
            if (item.AllLinkedTaskListIds.Count == 0)
            {
                return new ThingLeftToDo(item.Description, OnList: null);
            }

            // An entry standing for several lists is looked through in order, so what comes back is the
            // first outstanding thing on the first list that still has one.
            foreach (var linkedTaskListId in item.AllLinkedTaskListIds)
            {
                // A member list this reader cannot see, or one not loaded: the row's own name is that
                // list's title, which still says more than nothing.
                if (LinkedTaskList(linkedTaskListId) is not { } linkedTaskList)
                {
                    return new ThingLeftToDo(item.Description, OnList: null);
                }

                if (linkedTaskList.Items.FirstOrDefault(linked => !linked.IsCompleted) is { } linkedItem)
                {
                    return new ThingLeftToDo(linkedItem.Description, linkedTaskList.Title);
                }
            }
        }

        return null;
    }

    private async Task SetSortOrderAsync(TaskListSortOrder sortOrder)
    {
        await Arrangement.SetSortOrderAsync(sortOrder);
        Logger.LogInformation("Task lists sorted by {SortOrder}", sortOrder);
    }

    /// <summary>
    /// Where a card was dropped is where it belongs. The whole visible order is written back rather than
    /// the one card that moved: a stored order that named only the cards somebody had touched would put
    /// the rest wherever they happened to fall.
    /// </summary>
    private async Task DropCardOnAsync(TaskDto target)
    {
        var arranged = VisibleTaskLists.ToList();
        if (!_cardOrder.DropOn(arranged, target))
        {
            _cardOrder.Finish();
            return;
        }

        _cardOrder.Finish();
        await Arrangement.SetManualOrderAsync([.. arranged.Select(taskList => taskList.Id)]);
        Logger.LogInformation("User dragged task list {TaskListId} to a new place", target.Id);
    }

    /// <summary>
    /// The same move a drag makes, one card at a time - what a keyboard can ask for, and a finger,
    /// which raises no drag events at all. Saved exactly as the drop above saves it.
    /// </summary>
    private async Task MoveCardAsync(TaskDto taskList, int offset)
    {
        var arranged = VisibleTaskLists.ToList();
        if (!RowArrangement<TaskDto>.Move(arranged, taskList, offset))
        {
            return;
        }

        await Arrangement.SetManualOrderAsync([.. arranged.Select(card => card.Id)]);
        Logger.LogInformation("User moved task list {TaskListId} by {Offset}", taskList.Id, offset);
    }

    private bool CanMoveCard(TaskDto taskList, int offset)
        => RowArrangement<TaskDto>.CanMove(VisibleTaskLists.ToList(), taskList, offset);

    /// <summary>An unrecognised status reads as New - a status this client doesn't know yet is not one it should invent a meaning for.</summary>
    private static TaskListStatus ParseStatus(TaskDto taskList)
        => Enum.TryParse<TaskListStatus>(taskList.Status, out var status) ? status : TaskListStatus.New;

    private static ItemPriority ParsePriority(TaskDto taskList)
        => Enum.TryParse<ItemPriority>(taskList.Priority, out var priority) ? priority : ItemPriority.Normal;

    /// <summary>Mirrors TaskEditor's own priority dropdown, so a list reads the same in both places.</summary>
    private string DescribePriority(ItemPriority priority) => priority switch
    {
        ItemPriority.Low => T["Low"],
        ItemPriority.High => T["High"],
        _ => T["Normal view"]
    };

    private string DescribeFilter(TaskListFilter filter) => filter switch
    {
        TaskListFilter.Pending => T["In progress"],
        TaskListFilter.Completed => T["Done"],
        TaskListFilter.Overdue => T["Overdue"],
        TaskListFilter.Shared => T["Shared"],
        TaskListFilter.Group => T["Group"],
        TaskListFilter.All => T["All"],
        _ => T["Not started"]
    };

    private string DescribeStatus(TaskListStatus status) => status switch
    {
        TaskListStatus.Pending => T["In progress"],
        TaskListStatus.Completed => T["Done"],
        TaskListStatus.Overdue => T["Overdue"],
        _ => T["Not started"]
    };

    private string DescribeSortOrder(TaskListSortOrder sortOrder) => sortOrder switch
    {
        TaskListSortOrder.Priority => T["Most important first"],
        TaskListSortOrder.LeastImportantFirst => T["Least important first"],
        TaskListSortOrder.Newest => T["Newest first"],
        TaskListSortOrder.Oldest => T["Oldest first"],
        TaskListSortOrder.Alphabetical => T["A to Z"],
        TaskListSortOrder.ReverseAlphabetical => T["Z to A"],
        _ => T["The way I arranged them"]
    };

    /// <summary>
    /// What a card can be narrowed down to: where a list has got to, or - for Shared - where it came
    /// from. One list rather than two controls, because a reader is only ever asking one of them.
    /// </summary>
    private enum TaskListFilter
    {
        All,
        New,
        Pending,
        Overdue,
        Completed,
        Shared,

        /// <summary>A list that gathers other lists - see TaskList.IsGroup.</summary>
        Group
    }

    /// <summary>
    /// How much of a linked list to show under the row that points at it. Three whatever the view, which
    /// is what makes a group list's card readable: the row naming the member list, three of its items,
    /// and a fifth line that is either "and N more…" or - when there are exactly four - the fourth item
    /// itself. Five lines per member is what lets four of them sit on one card.
    /// </summary>
    private const int LinkedPreviewItemCount = 3;

    /// <summary>Five, which is what a card can carry without becoming the list it stands in for.</summary>
    private const int NormalPreviewItemCount = 5;

    /// <summary>As much as a card can carry before it stops being a card. The full view's answer for an ordinary list.</summary>
    private const int FullPreviewItemCount = 20;

    /// <summary>
    /// The full view's answer for a group list, counted in member lists rather than in rows: each one
    /// brings five lines with it (see <see cref="LinkedPreviewItemCount"/>), so four of them is already
    /// twenty lines - the same height an ordinary list gets.
    /// </summary>
    private const int FullGroupPreviewCount = 4;

    /// <summary>
    /// How many of a card's own rows to draw. It depends on the view and on what the list is: a group
    /// list's rows are not items but other lists, and each one costs five lines rather than one.
    /// </summary>
    private int PreviewLimitFor(TaskDto taskList)
        => Arrangement.View == TaskListView.Full
            ? taskList.IsGroup ? FullGroupPreviewCount : FullPreviewItemCount
            : NormalPreviewItemCount;

    /// <summary>
    /// How many rows to actually draw. One over the limit is drawn in full: the line saying "and 1 more…"
    /// takes exactly the room the row it stands for would have taken, so hiding that row saves nothing
    /// and costs the reader the one thing it was hiding.
    /// </summary>
    private static int RowsToShow(int itemCount, int limit) => itemCount <= limit + 1 ? itemCount : limit;

    /// <summary>How much of each list is on show, in the reader's language.</summary>
    private string DescribeView(TaskListView view) => view switch
    {
        TaskListView.Minimal => T["Minimal"],
        TaskListView.Full => T["Full"],
        _ => T["Normal"]
    };

    private async Task SetViewAsync(TaskListView view)
    {
        Logger.LogInformation("User switched the tasks page to the {View} view", view);
        await Arrangement.SetViewAsync(view);
    }

    /// <summary>The work a linked row actually stands for, as far as the card has room for.</summary>
    private IEnumerable<TaskItemDto> LinkedItems(Guid linkedTaskListId)
        => LinkedTaskList(linkedTaskListId)?.Items.Take(RowsToShow(LinkedItemCount(linkedTaskListId), LinkedPreviewItemCount)) ?? [];

    private int LinkedItemCount(Guid linkedTaskListId) => LinkedTaskList(linkedTaskListId)?.Items.Count ?? 0;

    private TaskDto? LinkedTaskList(Guid linkedTaskListId)
        => (_taskLists ?? []).FirstOrDefault(candidate => candidate.Id == linkedTaskListId);

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    /// <summary>Whether this entry is ordinary work rather than an appointment or a restock errand.</summary>
    private static bool IsAChecklistEntry(TaskItemDto item) => item.Kind == nameof(TaskItemKind.Checklist);

    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    private static string CompletionSummary(TaskDto taskList)
        => taskList.Items.Count == 0 ? "empty" : $"{taskList.Items.Count(item => item.IsCompleted)}/{taskList.Items.Count}";

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Tasks page opened, loading task lists");
        // MainLayout owns the polling; this only listens, so a reminder arriving while the page is open
        // lights the card it is about without this page fetching anything of its own.
        NotificationFeedState.Changed += OnNotificationsChanged;
        await Arrangement.InitializeAsync();
        try
        {
            _taskLists = await TasksApiClient.GetTaskListsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {TaskListCount} task lists", _taskLists.Count);
    }

    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => NotificationFeedState.Changed -= OnNotificationsChanged;

    private void GoToAddTaskList()
    {
        Logger.LogInformation("User clicked 'Add task list'");
        NavigationManager.NavigateTo("/tasks/new");
    }

    /// <summary>The deep editing level, which has to be asked for by name - see TaskEditor.razor.</summary>
    private void GoToEditTaskList(Guid taskListId)
    {
        Logger.LogInformation("User clicked 'Edit' for task list {TaskListId}", taskListId);
        NavigationManager.NavigateTo($"/tasks/{taskListId}/edit");
    }

    /// <summary>What opening a list means, here and everywhere else - see TaskListChecklist.razor.</summary>
    private void GoToChecklist(Guid taskListId)
    {
        Logger.LogInformation("User clicked 'Open checklist' for task list {TaskListId}", taskListId);
        NavigationManager.NavigateTo($"/tasks/{taskListId}");
    }

    private async Task DeleteTaskListAsync(TaskDto taskList)
    {
        Logger.LogInformation("User clicked 'Delete' for task list {TaskListId}", taskList.Id);
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete task list \"{taskList.Title}\"?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await TasksApiClient.DeleteTaskListAsync(taskList.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete task list {TaskListId}", taskList.Id);
            return;
        }

        _taskLists = _taskLists!.Where(existingTaskList => existingTaskList.Id != taskList.Id).ToList();
        Logger.LogInformation("Task list {TaskListId} deleted", taskList.Id);
    }
}
