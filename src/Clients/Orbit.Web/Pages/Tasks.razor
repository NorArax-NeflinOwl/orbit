@page "/tasks"
@attribute [Authorize]
@using Orbit.Contracts.Tasks
@using Orbit.Core.Tasks
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Tasks> Logger
@inject Translations T

<PageTitle>Orbit — Tasks</PageTitle>

<div class="page-header">
    <div>
        <h1>@T["Tasks"]</h1>
        <p class="page-subtitle">@T["Every list you own or someone shared with you."]</p>
    </div>
    <div class="page-header-actions">
        <button type="button" class="btn-primary" @onclick="GoToAddTaskList">@T["Add task list"]</button>
    </div>
</div>

@if (_taskLists is null)
{
    <p>@T["Loading…"]</p>
}
else if (_taskLists.Count == 0)
{
    <p class="empty-hint">@T["No task lists yet."]</p>
}
else
{
    <div class="list-controls">
        <div class="list-filters">
            @* "All" is a filter like the rest rather than a way of clearing them, so there is always
               exactly one answer to "what am I looking at". *@
            <button type="button" class="filter-chip @(_statusFilter is null ? "on" : "")"
                    @onclick="() => SetStatusFilter(null)">@T["All"]<span class="filter-chip-count">@_taskLists.Count</span>
            </button>
            @foreach (var status in StatusFilters)
            {
                <button type="button" class="filter-chip @(_statusFilter == status ? "on" : "")"
                        @onclick="() => SetStatusFilter(status)">
                    @DescribeStatus(status) <span class="filter-chip-count">@CountWithStatus(status)</span>
                </button>
            }
        </div>
        <label class="list-sort">
            @T["Sort"]
            <select @bind="_sortOrder" @bind:after="OnSortChanged">
                <option value="@TaskListSortOrder.Priority">@T["Priority"]</option>
                <option value="@TaskListSortOrder.Newest">@T["Newest first"]</option>
                <option value="@TaskListSortOrder.Oldest">@T["Oldest first"]</option>
                <option value="@TaskListSortOrder.Alphabetical">@T["A to Z"]</option>
                <option value="@TaskListSortOrder.ReverseAlphabetical">@T["Z to A"]</option>
            </select>
        </label>
    </div>

    @if (VisibleTaskLists.Count == 0)
    {
        <p class="empty-hint">No lists are @DescribeStatus(_statusFilter!.Value).ToLowerInvariant().</p>
    }

    <div class="card-grid">
        @foreach (var taskList in VisibleTaskLists)
        {
            <div class="card task-list-card">
                <div class="card-header">
                    <span class="card-title">
                        @taskList.Title
                        @if (taskList.IsGroup)
                        {
                            <span class="card-badge">@T["Group"]</span>
                        }
                        @if (taskList.IsShared)
                        {
                            <span class="card-badge">@T["Shared"]</span>
                        }
                        @if (taskList.Priority != "Normal")
                        {
                            <span class="card-badge card-badge-priority-@taskList.Priority.ToLowerInvariant()">@taskList.Priority</span>
                        }
                        <span class="card-badge card-badge-status-@taskList.Status.ToLowerInvariant()">@DescribeStatus(ParseStatus(taskList))</span>
                    </span>
                    <span class="card-count">@CompletionSummary(taskList)</span>
                </div>

                @* A preview rather than the whole list: enough to recognise what is on it, with the
                   checklist view one click away for working through it. *@
                @foreach (var item in taskList.Items.Take(PreviewItemCount))
                {
                    <div class="list-row task-preview-row @(item.IsCompleted ? "completed" : "")">
                        <span class="task-preview-mark">@(item.IsCompleted ? "✓" : "")</span>
                        <span class="row-title">@item.Description</span>
                        @if (item.LinkedTaskListId is not null)
                        {
                            <span class="row-meta">follows another list</span>
                        }
                        else if (item.DueDateUtc is { } dueDate)
                        {
                            <span class="row-meta">@dueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>
                }
                @if (taskList.Items.Count > PreviewItemCount)
                {
                    <div class="list-row">
                        <span class="row-meta">and @(taskList.Items.Count - PreviewItemCount) more…</span>
                    </div>
                }
                @if (taskList.Items.Count == 0)
                {
                    <p class="empty-hint">@T["No items on this list."]</p>
                }

                <div class="card-actions">
                    <button type="button" class="btn-primary" @onclick="() => GoToChecklist(taskList.Id)">@T["Open checklist"]</button>
                    <button type="button" class="btn-secondary" @onclick="() => GoToEditTaskList(taskList.Id)">@T["Edit"]</button>
                    <button type="button" class="btn-secondary" @onclick="() => DeleteTaskListAsync(taskList)">@T["Delete"]</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<TaskDto>? _taskLists;

    /// <summary>Which statuses the filter row offers, in the order a list moves through them.</summary>
    private static readonly TaskListStatus[] StatusFilters =
        [TaskListStatus.New, TaskListStatus.Pending, TaskListStatus.Overdue, TaskListStatus.Completed];

    /// <summary>Null means every list - see the "All" chip, which is a filter like the others rather than a way of clearing them.</summary>
    private TaskListStatus? _statusFilter;

    private TaskListSortOrder _sortOrder = TaskListSortOrder.Priority;

    /// <summary>
    /// Filtering and sorting happen here rather than on the server: the page already has every list it
    /// owns, so asking again would be a round trip to rearrange what is already on screen.
    /// </summary>
    private IReadOnlyList<TaskDto> VisibleTaskLists
    {
        get
        {
            var visible = _taskLists ?? [];
            if (_statusFilter is { } status)
            {
                visible = visible.Where(taskList => ParseStatus(taskList) == status).ToList();
            }

            return Sort(visible, _sortOrder);
        }
    }

    private static IReadOnlyList<TaskDto> Sort(IReadOnlyList<TaskDto> taskLists, TaskListSortOrder sortOrder) => sortOrder switch
    {
        // Within a priority, newest first: two lists that matter equally are most usefully ordered by
        // which was touched last.
        TaskListSortOrder.Priority => taskLists
            .OrderByDescending(taskList => ParsePriority(taskList))
            .ThenByDescending(taskList => taskList.UpdatedAtUtc)
            .ToList(),
        TaskListSortOrder.Newest => taskLists.OrderByDescending(taskList => taskList.CreatedAtUtc).ToList(),
        TaskListSortOrder.Oldest => taskLists.OrderBy(taskList => taskList.CreatedAtUtc).ToList(),
        TaskListSortOrder.Alphabetical => taskLists.OrderBy(taskList => taskList.Title, StringComparer.CurrentCultureIgnoreCase).ToList(),
        _ => taskLists.OrderByDescending(taskList => taskList.Title, StringComparer.CurrentCultureIgnoreCase).ToList()
    };

    private int CountWithStatus(TaskListStatus status)
        => _taskLists?.Count(taskList => ParseStatus(taskList) == status) ?? 0;

    private void SetStatusFilter(TaskListStatus? status)
    {
        _statusFilter = status;
        Logger.LogInformation("Task list filter set to {StatusFilter}", status?.ToString() ?? "All");
    }

    private void OnSortChanged() => Logger.LogInformation("Task lists sorted by {SortOrder}", _sortOrder);

    /// <summary>An unrecognised status reads as New - a status this client doesn't know yet is not one it should invent a meaning for.</summary>
    private static TaskListStatus ParseStatus(TaskDto taskList)
        => Enum.TryParse<TaskListStatus>(taskList.Status, out var status) ? status : TaskListStatus.New;

    private static TaskListPriority ParsePriority(TaskDto taskList)
        => Enum.TryParse<TaskListPriority>(taskList.Priority, out var priority) ? priority : TaskListPriority.Normal;

    private static string DescribeStatus(TaskListStatus status) => status switch
    {
        TaskListStatus.Pending => "In progress",
        TaskListStatus.Completed => "Done",
        TaskListStatus.Overdue => "Overdue",
        _ => "Not started"
    };

    /// <summary>The orders the sort dropdown offers - Priority first, since it is the one the reader set themselves.</summary>
    private enum TaskListSortOrder
    {
        Priority,
        Newest,
        Oldest,
        Alphabetical,
        ReverseAlphabetical
    }

    /// <summary>How much of a list to show on its card before falling back to "and N more" - a card is for recognising a list, not working through it.</summary>
    private const int PreviewItemCount = 4;

    private static string CompletionSummary(TaskDto taskList)
        => taskList.Items.Count == 0 ? "empty" : $"{taskList.Items.Count(item => item.IsCompleted)}/{taskList.Items.Count}";

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Tasks page opened, loading task lists");
        try
        {
            _taskLists = await TasksApiClient.GetTaskListsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }
        Logger.LogInformation("Loaded {TaskListCount} task lists", _taskLists.Count);
    }

    private void GoToAddTaskList()
    {
        Logger.LogInformation("User clicked 'Add task list'");
        NavigationManager.NavigateTo("/tasks/new");
    }

    private void GoToEditTaskList(Guid taskListId)
    {
        Logger.LogInformation("User clicked 'Edit' for task list {TaskListId}", taskListId);
        NavigationManager.NavigateTo($"/tasks/{taskListId}");
    }

    /// <summary>Opens the shallow editing level - see TaskListChecklist.razor.</summary>
    private void GoToChecklist(Guid taskListId)
    {
        Logger.LogInformation("User clicked 'Open checklist' for task list {TaskListId}", taskListId);
        NavigationManager.NavigateTo($"/tasks/{taskListId}/checklist");
    }

    private async Task DeleteTaskListAsync(TaskDto taskList)
    {
        Logger.LogInformation("User clicked 'Delete' for task list {TaskListId}", taskList.Id);
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete task list \"{taskList.Title}\"?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await TasksApiClient.DeleteTaskListAsync(taskList.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete task list {TaskListId}", taskList.Id);
            return;
        }

        _taskLists = _taskLists!.Where(existingTaskList => existingTaskList.Id != taskList.Id).ToList();
        Logger.LogInformation("Task list {TaskListId} deleted", taskList.Id);
    }
}
