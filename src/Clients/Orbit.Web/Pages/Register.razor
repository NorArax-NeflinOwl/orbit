@page "/register"
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@using Orbit.Web.Services.Logging
@inject AuthApiClient AuthApiClient
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<Register> Logger
@inject Translations T

<PageTitle>@T["Orbit — Register"]</PageTitle>

@* TODO(Orbit.Web.UI): still plain unstyled <div>/<label>/<input> - see Login.razor's matching TODO,
   same dedicated auth-card layout should cover both pages together rather than being built twice. *@
<h1>@T["Register"]</h1>

<EditForm Model="_formModel" OnValidSubmit="SubmitAsync" class="editor-form">
    <div class="field">
        <label>@T["Email"]</label>
        <InputText id="email" @bind-Value="_formModel.Email" />
    </div>
    <div class="field">
        <label>@T["Username"]</label>
        <InputText id="userName" @bind-Value="_formModel.UserName" />
    </div>
    <div class="field">
        <label>@T["Display name"]</label>
        <InputText id="displayName" @bind-Value="_formModel.DisplayName" />
    </div>
    <div class="field">
        <label>@T["Password"]</label>
        <!-- InputText always renders type="text" regardless of splatted attributes, so a real masked
             password field needs a plain <input> with a manual two-way binding instead. -->
        <input type="password" id="password" @bind="_formModel.Password" />
    </div>
    <div class="field">
        <label>@T["Repeat password"]</label>
        <input type="password" id="repeatPassword" @bind="_formModel.RepeatPassword" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary" disabled="@_isSubmitting">@T["Register"]</button>
    </div>
</EditForm>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<GoogleSignInButton OnCredential="SignInWithGoogleAsync" ShowDivider="true" />

<p>@T["Already have an account? "]<a href="/login">@T["Log in"]</a></p>

@code {
    private readonly RegisterFormModel _formModel = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        // Checked here rather than server-side: it guards against a typo in this form, which is a
        // property of the form, not of the account being created.
        if (_formModel.Password != _formModel.RepeatPassword)
        {
            _errorMessage = T["The two passwords don't match."];
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        AuthResult result;
        try
        {
            result = await AuthApiClient.RegisterAsync(
                _formModel.Email, _formModel.UserName, _formModel.DisplayName, _formModel.Password);
        }
        catch (Exception exception)
        {
            // Covers a missing HTTP response (server unreachable, DNS failure, ...) as well as anything
            // AuthApiClient itself can't turn into an AuthOutcome - a malformed response body or a
            // client-side timeout, for instance - so a failure here always shows the same inline error
            // message instead of crashing the whole page.
            Logger.LogActionFailed(ClientActionCategory.Registration, "Registration", exception);
            _errorMessage = T["Failed to connect to the server. Check your connection and try again."];
            _isSubmitting = false;
            return;
        }

        if (result.Outcome == AuthOutcome.Success)
        {
            Logger.LogActionCompleted(ClientActionCategory.Registration, "Registration");
            // Resolved before Notify, not after: Notify is what makes MainLayout's own (fire-and-forget,
            // best-effort) key-publishing attempt run, and that attempt throws EncryptionKeyLockedException
            // for a browser with no local key yet - which every brand-new registration is, until this call
            // finishes. Running this first means that attempt always finds a key already there.
            await TryUnlockEncryptionKeyAsync(_formModel.Password);
            AuthenticationStateProvider.NotifyAuthenticationStateChanged();
            NavigationManager.NavigateTo("/");
            return;
        }

        _errorMessage = result.Outcome switch
        {
            AuthOutcome.EmailOrUserNameAlreadyTaken => T["That email or username is already taken."],
            _ => T["An error occurred while registering. Try again."]
        };
        _isSubmitting = false;
    }

    /// <summary>
    /// Generates this browser's E2EE private key and backs it up under the account password now, while
    /// it's still on hand (see OwnEncryptionKeyProvider.UnlockOrCreateAsync) - a brand-new account never
    /// has an existing key or backup to restore, so this always takes the "generate" path. Best-effort,
    /// like MainLayout's own attempt on every page load: a failure here just leaves the key unresolved
    /// until the user opens Chat.razor, which has a dedicated way to recover from that.
    /// </summary>
    private async Task TryUnlockEncryptionKeyAsync(string password)
    {
        try
        {
            await OwnEncryptionKeyProvider.UnlockOrCreateAsync(password);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to generate or publish the local E2EE key after registering");
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "End-to-end encryption is unavailable in this browsing context");
        }
    }

    private sealed class RegisterFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string RepeatPassword { get; set; } = string.Empty;
    }

    /// <summary>
    /// One handler for both signing in and registering with Google: the browser gesture is identical and
    /// the server decides whether this identity is new (see SignInWithGoogleCommandHandler).
    /// </summary>
    private async Task SignInWithGoogleAsync(string idToken)
    {
        _errorMessage = null;
        AuthResult result;
        try
        {
            result = await AuthApiClient.SignInWithGoogleAsync(idToken);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Google sign-in failed");
            _errorMessage = T["Couldn't sign in with Google. Try again."];
            return;
        }

        if (result.Outcome != AuthOutcome.Success)
        {
            _errorMessage = T["Couldn't sign in with Google. Try again."];
            return;
        }

        // Deliberately no UnlockOrCreateAsync here, unlike the password paths: a Google account may have
        // no password at all, so there is nothing to wrap a chat key with yet. Chat asks for one when it
        // is actually needed - see Chat.razor's password gate.
        AuthenticationStateProvider.NotifyAuthenticationStateChanged();
        NavigationManager.NavigateTo("/");
    }
}
