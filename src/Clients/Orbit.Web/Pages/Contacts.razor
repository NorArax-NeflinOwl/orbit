@page "/contacts"
@attribute [Authorize]
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Users
@using Orbit.Core.Users
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject ChatApiClient ChatApiClient
@inject UsersApiClient UsersApiClient
@inject NavigationManager NavigationManager
@inject ILogger<Contacts> Logger
@inject UserPermissionState Permissions
@inject Translations T

<PageTitle>@T["Orbit — Contacts"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@T["Contacts"]</h1>
        <p class="page-subtitle">@T["Search for someone and start a conversation."]</p>
    </div>
</div>

@if (!Permissions.Has(ApplicationPermission.Contacts))
{
    @* Above the search box, not below it: an account that cannot look anybody up should not be handed
       a search box that answers every query with a refusal. *@
    <FeatureLocked Explanation="@(T["Finding other people, and being found by them. Everything below needs this first."])" />
}
else
{

    <div class="field-row" style="margin-bottom:24px;">
        <input @bind="_searchIdentifier" @bind:event="oninput" placeholder="@(T["Email address or login"])" />
        <button type="button" class="btn-primary" @onclick="SearchAsync" disabled="@_isSearching">@T["Search"]</button>
    </div>

    @if (_loadError is not null)
    {
        <p class="error">
            @_loadError
            <button type="button" class="btn-secondary" @onclick="LoadContactsAsync">@T["Retry"]</button>
        </p>
    }

    @if (_searchError is not null)
    {
        <p class="error">@_searchError</p>
    }

    @if (_searchResult is not null)
    {
        <div class="card" style="margin-bottom:24px;">
            <div class="chat-list-item" style="cursor:default;">
                <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(_searchResult.Id)">@AvatarHelper.GetInitials(_searchResult.DisplayName)</span>
                <span class="chat-list-meta">
                    <span class="chat-list-name">@_searchResult.DisplayName</span>
                    <span class="chat-list-preview">@_searchResult.UserName</span>
                </span>
                <button type="button" class="btn-secondary" @onclick="() => OpenContactInfo(_searchResult.Id)">@T["Info"]</button>
                <button type="button" class="btn-secondary" @onclick="() => OpenChat(_searchResult.Id)">@T["Open chat"]</button>
            </div>
        </div>
    }

    @if (_contacts is not null && _pendingRequests.Any())
    {
        <h2>@T["New requests"]</h2>
        <div class="card" style="margin-bottom:24px;">
            @foreach (var contact in _pendingRequests)
            {
                <button type="button" class="chat-list-item" @onclick="() => OpenChat(contact.UserId)">
                    <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<PresenceDot Status="Conversation.PresenceOf(contact)" /></span>
                    <span class="chat-list-meta">
                        <span class="chat-list-name">@contact.DisplayName</span>
                        <span class="chat-list-preview">@contact.UserName</span>
                    </span>
                    <span class="chat-request-badge">@T["New request"]</span>
                </button>
            }
        </div>
    }

    @if (_groups.Count > 0)
    {
        <h2>@T["Groups"]</h2>
        <div class="card" style="margin-bottom:24px;">
            @foreach (var group in _groups)
            {
                <button type="button" class="chat-list-item" @onclick="() => OpenGroup(group.Id)">
                    <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(group.Id)">@AvatarHelper.GetInitials(group.Name)</span>
                    <span class="chat-list-meta">
                        <span class="chat-list-name">@group.Name</span>
                        <span class="chat-list-preview">@T.Format("{0} in it", group.Members.Count)</span>
                    </span>
                </button>
            }
        </div>
    }

    <h2>@T["Chats"]</h2>

    @if (_contacts is null)
    {
        <p>@T["Loading…"]</p>
    }
    else if (!_establishedChats.Any())
    {
        <p>@T["No chats. Search for a user by email address or login to start a conversation."]</p>
    }
    else
    {
        <div class="card">
            @* Two things to do with a name here, so two controls rather than one row that has to guess:
               the row opens the conversation, and "Info" opens the person's card. *@
            @foreach (var contact in _establishedChats)
            {
                <div class="contact-row">
                    @* Marked as unread the same way the chat page's own list marks it: this is the other
                       place somebody looks for "who is waiting on me", and a page that knows and does
                       not say reads as nobody waiting. *@
                    <button type="button" class="chat-list-item @(contact.UnreadCount > 0 ? "unread" : "")"
                            @onclick="() => OpenChat(contact.UserId)">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)<UnreadBadge Count="contact.UnreadCount" /><PresenceDot Status="Conversation.PresenceOf(contact)" /></span>
                        <span class="chat-list-meta">
                            <span class="chat-list-name">@contact.DisplayName</span>
                            <span class="chat-list-preview">@contact.UserName</span>
                        </span>
                    </button>
                    <button type="button" class="btn-secondary contact-row-info" @onclick="() => OpenContactInfo(contact.UserId)">@T["Info"]</button>
                </div>
            }
        </div>
    }

}

@code {
    private string _searchIdentifier = string.Empty;
    private bool _isSearching;
    private string? _searchError;
    private string? _loadError;
    private UserSearchResultDto? _searchResult;
    private IReadOnlyList<ContactDto>? _contacts;

    /// <summary>
    /// Chat requests someone else sent that the current user hasn't approved yet - see
    /// ChatConversationAccess. Shown separately from established chats, with a "new request" badge,
    /// instead of mixed into the regular chat list.
    ///
    /// None at all for an account without Chat: approving one is the only thing to do with it, and that
    /// is exactly what such an account cannot do - so being shown them is being shown a dead end.
    /// </summary>
    private IEnumerable<ContactDto> _pendingRequests
        => Permissions.Has(ApplicationPermission.Chat)
            ? (_contacts ?? []).Where(contact => contact.RequiresApprovalFromCurrentUser)
            : [];

    private IEnumerable<ContactDto> _establishedChats
        => (_contacts ?? []).Where(contact => !contact.RequiresApprovalFromCurrentUser);

    /// <summary>The groups this account is in - conversations too, and listed here for that reason.</summary>
    private IReadOnlyList<ChatGroupDto> _groups = [];

    protected override async Task OnInitializedAsync()
    {
        // Waits for the first permission read, so this page never decides it is locked before it
        // has been told - see UserPermissionState.EnsureLoadedAsync.
        await Permissions.EnsureLoadedAsync();
        // Nothing below is reachable without this, and the page draws its locked notice instead - so it
        // does not ask and get turned away, which only fills the console with refusals that are not news.
        if (!Permissions.Has(ApplicationPermission.Contacts))
        {
            return;
        }

        await LoadContactsAsync();
    }

    /// <summary>
    /// Loads the contact list, also used as a "Retry" action after a failed load. A plain
    /// HttpRequestException here (e.g. "Failed to fetch" - a DNS lookup, TLS handshake, or dropped
    /// connection failing before a response ever comes back, so there's no status code to catch on) used
    /// to propagate out of OnInitializedAsync unhandled, crashing the whole component instead of leaving
    /// the page usable - this keeps that failure local to the page with a retry instead.
    /// </summary>
    private async Task LoadContactsAsync()
    {
        _loadError = null;
        try
        {
            _contacts = await ChatApiClient.GetContactsAsync();
            // A group is a conversation like any other on this page - leaving them off meant the one
            // page headed "Contacts" was the only place in the app that pretended they did not exist.
            // Not asked for without Chat, which is what a group is: the API would refuse it anyway.
            _groups = Permissions.Has(ApplicationPermission.Chat) ? await ChatApiClient.GetGroupsAsync() : [];
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to load contacts");
            _loadError = T["Failed to load contacts. Check your connection and try again."];
        }
    }

    private async Task SearchAsync()
    {
        _searchError = null;
        _searchResult = null;

        var identifier = _searchIdentifier.Trim();
        if (identifier.Length == 0)
        {
            return;
        }

        _isSearching = true;
        try
        {
            _searchResult = await UsersApiClient.SearchUserAsync(identifier);
            if (_searchResult is null)
            {
                _searchError = T["No user found with that email address or login."];
            }
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void OpenChat(Guid userId)
    {
        Logger.LogInformation("User opening chat with {ContactUserId}", userId);
        NavigationManager.NavigateTo($"/chat/{userId}");
    }

    private void OpenContactInfo(Guid userId)
    {
        Logger.LogInformation("User opening the contact card of {ContactUserId}", userId);
        NavigationManager.NavigateTo($"/contacts/{userId}");
    }

    private void OpenGroup(Guid groupId)
    {
        Logger.LogInformation("User opening group chat {GroupId}", groupId);
        NavigationManager.NavigateTo($"/chat/groups/{groupId}");
    }
}
