@page "/notifications"
@attribute [Authorize]
@using Orbit.Contracts.Notifications
@using Orbit.Web.Services
@inject NotificationsApiClient NotificationsApiClient
@inject ClientFlagsApiClient ClientFlagsApiClient
@inject NotificationFeedState NotificationFeedState
@inject ClientExceptionLog ClientExceptionLog
@inject NavigationManager NavigationManager
@inject ILogger<Notifications> Logger
@inject Translations T

<PageTitle>@T["Orbit — Notifications"]</PageTitle>

@* The full record, not just the panel's view: this lists entries already cleared out of the panel too,
   so clearing is somewhere to put things rather than somewhere they are destroyed. Reached from the
   panel's "See all" link on any screen, and it is the whole notifications UI on phones, where the popup
   would be unreadably cramped (see MainLayout.ToggleNotificationsMenuAsync). *@
<div class="page-header">
    <div>
        <h1>@T["Notifications"]</h1>
        <p class="page-subtitle">
            @T.Format(
                "Everything from the last {0}, newest first — cleared ones included. Older than that and they are deleted; change how long in",
                $"{_retentionDays} {(_retentionDays == 1 ? T["day"] : T["days"])}")
            <a href="/options">@T["Options"]</a>.
        </p>
    </div>
    <button class="btn-secondary" disabled="@_isClearing" @onclick="ClearAsync">@T["Clear"]</button>
</div>

<div class="notifications-page">
    <NotificationList IsLoading="_isLoading" Entries="_entries" ExceptionEntries="_exceptionEntries"
                      OnEntrySelected="OpenEntry" ShowsDismissed="true" />
</div>

@code {
    private bool _isLoading = true;
    private bool _isClearing;
    private int _retentionDays = 3;
    private IReadOnlyList<NotificationEntryDto> _entries = [];
    private IReadOnlyList<ClientLogEntry> _exceptionEntries = [];

    /// <summary>Opening the page counts as seeing the notifications, exactly as opening the desktop popup does.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entries = await NotificationsApiClient.GetHistoryAsync();
            await LoadExceptionEntriesAsync();
            await NotificationsApiClient.MarkAllReadAsync();
            NotificationFeedState.Clear();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to load notifications");
        }

        _isLoading = false;
    }

    /// <summary>
    /// Gated on both the server's environment flag and this user's own ShowExceptionDetails preference,
    /// so a Production deployment never shows stack traces regardless of what an account has stored -
    /// see NotificationSettings' class comment.
    /// </summary>
    private async Task LoadExceptionEntriesAsync()
    {
        var settings = await NotificationsApiClient.GetSettingsAsync();
        _retentionDays = settings.RetentionDays;
        var allowedByServer = await ClientFlagsApiClient.GetExceptionDetailsAllowedAsync();
        _exceptionEntries = allowedByServer && settings.ShowExceptionDetails
            ? await ClientExceptionLog.GetRecentErrorsAsync()
            : [];
    }

    private void OpenEntry(NotificationEntryDto entry)
    {
        if (entry.Url is not null)
        {
            NavigationManager.NavigateTo(entry.Url);
        }
    }

    /// <summary>Mirrors MainLayout's own Clear - see NotificationEntry.Dismiss for what clearing actually does.</summary>
    private async Task ClearAsync()
    {
        _isClearing = true;
        try
        {
            await NotificationsApiClient.ClearAsync();
            await ClientExceptionLog.ClearAsync();

            // Re-read rather than emptied: clearing marks entries as cleared, and this page is the one
            // place that still shows them - they just move from "new" to "cleared".
            _entries = await NotificationsApiClient.GetHistoryAsync();
            _exceptionEntries = [];
            NotificationFeedState.Clear();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to clear notifications");
        }
        finally
        {
            _isClearing = false;
        }
    }
}
