    /// Where an item was dropped is where it belongs: the list is saved in the order it is written in,
    /// so arranging it here is what the checklist reads back - see TaskRepository, which numbers the
    /// items by their place in this collection.
    /// </summary>

    /// <summary>
    /// The same move a drag makes, one row at a time - what a keyboard can ask for, and a finger, which
    /// raises no drag events at all. The list itself is what gets saved, so nothing else has to happen.
    /// </summary>
    private void MoveItem(TaskItemFormModel item, int offset)
        => RowArrangement<TaskItemFormModel>.Move(_formModel.Items, item, offset);

