    /// with Enter can be typed into straight away, which is the whole point of adding it that way.
    /// </summary>
    private InputText? _lastItemDescription;
    private bool _isWaitingToFocusTheNewItem;

    /// <summary>
    /// Focuses the row Add item just appended, once it has actually been rendered - there is nothing to
    /// focus until then.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isWaitingToFocusTheNewItem || _lastItemDescription?.Element is not { } element)
