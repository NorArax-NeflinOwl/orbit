    /// <summary>
    /// The pin was confirmed. Its address fills the box when the box is empty, and is left out when
    /// somebody has written a name of their own there - "the back entrance" is the whole reason that
    /// box is typed into, and replacing it with a street every time a pin is confirmed is what made
    /// correcting it feel impossible. The place itself is set either way.
    /// </summary>
    private void UseThePickedPlace(string address)
    {
        if (_itemBeingPlacedOnTheMap is { } item)
