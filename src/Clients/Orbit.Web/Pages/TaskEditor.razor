    /// id is at least something to recognise it by after a save fails.
    /// </summary>
    private string TitleOfTaskList(Guid taskListId)
        => _linkableTaskLists.FirstOrDefault(candidate => candidate.Id == taskListId)?.Title
            ?? _moveTargetTaskLists.FirstOrDefault(candidate => candidate.Id == taskListId)?.Title
