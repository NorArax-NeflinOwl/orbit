    /// </summary>
    private string LinkedEventLocation(TaskItemFormModel item)
    {
        var linked = _linkableEvents.FirstOrDefault(candidate => candidate.Id.ToString() == item.LinkedCalendarEventId);
        return linked?.Details.Location?.Address is { Length: > 0 } address ? address : T["somewhere the event does not say"];
