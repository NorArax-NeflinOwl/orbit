    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync()
                ?? throw new HttpRequestException("No signed-in user.", null, HttpStatusCode.Unauthorized);

            // Best-effort: gates which notification-channel options are selectable (see
            // NotificationChannelOption.IsDisabledBy) - a failure here just leaves every option enabled
            // rather than blocking the rest of the page from loading.
            try
            {
                _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Failed to load notification settings");
            }

            // Who a calendar entry on this list can invite. Read for a list being made as well as for one
            // being edited: it used to be fetched only alongside an existing list, so a Calendar entry on
            // a brand new list said there was nobody to invite and offered no picker - which is not the
            // same thing as having no contacts. Answers empty rather than throwing for an account that
            // has not unlocked chat, so there is nothing to guard here - see GetContactsAsync.
            _contacts = await ChatApiClient.GetContactsAsync();

            // Populates the "link to another list" dropdown - excludes the list being edited itself, since
            // an item can't link to the list it belongs to (see TaskListLinkValidator on the API side).
            var allTaskLists = await TasksApiClient.GetTaskListsAsync();
            // Best-effort: an entry can be tied to an event, but a calendar that will not load is no
            // reason for the task editor not to.
            try
            {
                _linkableEvents = await CalendarApiClient.GetCalendarEventsAsync();
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Failed to load the events a task entry could be tied to");
            }
            // Somewhere to move a row to is any list but this one - moving is not linking, and carries
            // none of linking's rules.
            _moveTargetTaskLists = Id is { } movingFromId
                ? [.. allTaskLists.Where(taskList => taskList.Id != movingFromId)]
                : allTaskLists;

            // Every category already in use anywhere, so filing a second entry under an existing name is
            // picking it rather than remembering how it was spelled last time.
            _knownCategories = [.. allTaskLists
                .SelectMany(taskList => taskList.Items.SelectMany(item => item.AllCategories))
                .Distinct(StringComparer.CurrentCultureIgnoreCase)
                .OrderBy(category => category, StringComparer.CurrentCultureIgnoreCase)];

            // Linking is narrower: a list that links back here, however long the chain, would close a
            // loop and the save would refuse it - see TaskListLinkCycle. Left out of the dropdown rather
            // than offered and then rejected, which is how every other rule the server enforces is
            // handled on this side.
            _linkableTaskLists = Id is { } currentTaskListId
                ? [.. allTaskLists.Where(taskList => !TaskListLinkCycle.WouldClose(allTaskLists, currentTaskListId, taskList.Id))]
                : allTaskLists;

            if (Id is { } taskListId)
            {
                Logger.LogInformation("Task list editor opened for task list {TaskListId}", taskListId);
                var taskList = await TasksApiClient.GetTaskListByIdAsync(taskListId);
                if (taskList is not null)
                {
                    _linkedInventoryId = taskList.LinkedInventoryId;
                    _linkedInventoryName = await NameOfTheLinkedInventoryAsync();
                    await LoadTheInventoriesAsync();
                    _inventoriesMeasuredByAnotherList =
                    [
                        .. allTaskLists
                            .Where(other => other.Id != taskListId && other.LinkedInventoryId is not null)
                            .Select(other => other.LinkedInventoryId!.Value)
                    ];
                    _formModel = new TaskListFormModel
                    {
                        Title = taskList.Title,
                        Description = taskList.Description,
                        IsGroup = taskList.IsGroup,
                        IsPrivate = taskList.IsPrivate,
                        Priority = taskList.Priority,
                        Items = taskList.Items
                            .Select(item => new TaskItemFormModel
                            {
                                Id = item.Id,
                                Description = item.Description,
                                DueDate = item.DueDateUtc is { } dueDateUtc ? DateOnly.FromDateTime(dueDateUtc.LocalDateTime) : null,
                                DueTime = item.DueDateUtc is { } dueTimeUtc ? TimeOnly.FromDateTime(dueTimeUtc.LocalDateTime) : null,
                                IsCompleted = item.IsCompleted,
                                Kind = item.Kind,
                                Location = item.Location,
                                LinkedInventoryItemId = item.LinkedInventoryItemId,
                                LinkedCalendarEventId = item.LinkedCalendarEventId?.ToString() ?? string.Empty,
                                LinkedTaskListIds = [.. item.AllLinkedTaskListIds],
                                Categories = [.. item.AllCategories],
                                OverdueNotificationChannel = item.OverdueNotificationChannel,
                                RemindDaily = item.RemindDaily,
                                DailyReminderNotificationChannel = item.DailyReminderNotificationChannel,
                                // Midnight reads as "never set". The wire carries a plain TimeOnly and so
                                // cannot say "none"; an entry reminded daily at exactly 00:00 is far more
                                // likely to be one nobody chose an hour for than one somebody wanted at
                                // midnight - and being asked is a smaller cost than a reminder arriving
                                // while everybody is asleep. See WhatIsWrongWithTheItems.
                                DailyReminderTimeOfDay =
                                    item.RemindDaily && item.DailyReminderTimeOfDay == default
                                        ? null
                                        : item.DailyReminderTimeOfDay
                            })
                            .ToList()
                    };
                    _isShared = taskList.IsShared;
                    _access = SharedItemAccess.For(taskList.IsShared, taskList.AccessLevel);
                    _isSharedReadOnly = taskList.IsShared && !_access.CanEdit;
                    _canShare = _access.CanShare;
                    _canGrantCanEdit = _access.CanGrantCanEdit;
                    _canGrantEditOnly = _access.CanGrantEditOnly;
                    _originalOwnerUserId = taskList.OriginalOwnerUserId;
                    _sharedByUserName = taskList.SharedByUserName;

                    if (!_isSharedReadOnly)
                    {
                        await AcquireLockAsync(taskListId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(taskListId);
                        }
                    }
                }

            }
            else
            {
                Logger.LogInformation("Task list editor opened for a new task list");
                StartFromTheChosenPlaceIfThereIsOne();
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadTheShelvesAsync();
        ReadTheEventsBack();
        OpenTheRequestedItem();
        _isLoading = false;
    }

    /// <summary>
    /// Opens a new list on one calendar entry already standing at the place somebody pointed at, when
    /// the map sent them here (see ChosenPlace and MapPage). The place is the whole reason they came,
    /// so the entry is a calendar one - the only kind that has anywhere to be - and it opens expanded,
    /// because an entry whose place is filled in and whose day is not is not finished.
    ///
    /// Taken rather than read, so coming back to a new list later starts blank.
    /// </summary>
    private void StartFromTheChosenPlaceIfThereIsOne()
    {
        if (ChosenPlace.Take() is not { } place)
        {
            return;
        }

        var entry = new TaskItemFormModel
        {
            Kind = nameof(TaskItemKind.Calendar),
            Location = place.Address,
            LocationLatitude = place.Latitude,
            LocationLongitude = place.Longitude
        };

        _formModel.Items.Add(entry);
        _expandedItem = entry;
    }

    /// <summary>
    /// Which entry to open on, when somewhere else sent the reader here to change one rather than the
    /// list as a whole - see TaskListChecklist's GoToEditItem and TaskItemSummary's GoToEditor. Absent
    /// when the editor was opened for the list itself.
    /// </summary>
    [Parameter]
    public Guid? ItemToOpen { get; set; }

    /// <summary>
    /// Unfolds the entry the caller asked for, once the list it is on has actually loaded. Silent when
    /// it names one that is not here any more: arriving at the list is still the right answer, and an
    /// error about a row nobody chose to open is noise.
    /// </summary>
    private void OpenTheRequestedItem()
    {
        if (ItemToOpen is not { } itemId)
        {
            return;
        }

        _expandedItem = _formModel.Items.FirstOrDefault(item => item.Id == itemId);
    }

    private bool IsExpanded(TaskItemFormModel item) => ReferenceEquals(_expandedItem, item);

    private void ToggleExpanded(TaskItemFormModel item) => _expandedItem = IsExpanded(item) ? null : item;

    /// <summary>The shelf side of this list's inventory errands while it is being edited - see ShelfPicker.</summary>
    private readonly ShelfPicker _shelves = new();

    /// <summary>What the storage this list is measured against is called, for the line under the form.</summary>
    private string _linkedInventoryName = string.Empty;

    /// <summary>Every storage this account has, for the picker - see the "About this list" section.</summary>
    private IReadOnlyList<InventoryDto> _inventories = [];

    /// <summary>
    /// The ones some other list already measures. Still on offer - a store may serve several lists -
    /// and named as shared in the picker, because what it costs is that the shelf is split between them.
    /// </summary>
    private HashSet<Guid> _inventoriesMeasuredByAnotherList = [];

    /// <summary>
    /// Measures this list against a storage, or against none. Saved on the spot rather than with the
    /// list: it is a relationship between two things rather than a field of one, and the entries below
    /// need to know the answer before they can describe a product to put on it.
    /// </summary>
    private async Task OnInventoryChangedAsync(ChangeEventArgs args)
    {
        var chosen = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : (Guid?)null;
        if (Id is not { } taskListId)
        {
            return;
        }

        _isWorkingOnInventory = true;
        _inventoryMessage = null;
        try
        {
            if (!await TasksApiClient.LinkInventoryAsync(taskListId, chosen))
            {
                // The picker leaves out what is already spoken for, so this is a shelf that was taken
                // between the page loading and the choice being made. Said out loud rather than left as
                // a select that snaps back for no visible reason.
                _inventoryMessage = T["That storage is already measured against another list."];
                return;
            }

            _linkedInventoryId = chosen;
            _linkedInventoryName = await NameOfTheLinkedInventoryAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't measure task list {TaskListId} against a storage", taskListId);
            _inventoryMessage = T["Something went wrong. Try again."];
        }
        finally
        {
            _isWorkingOnInventory = false;
        }
    }

    /// <summary>
    /// The product an inventory entry is about, when there is one to show. Two ways there can be:
    /// a restock errand already stands for something on a shelf, and an entry on a list that is
    /// measured against a storage describes something to put on it.
    ///
    /// The second is built here, the first time it is asked for, rather than when the entry is made:
    /// an entry becomes an inventory one by a dropdown that can be changed at any time, and building
    /// it on the way past is what keeps "what kind is this" and "what does it need" in step without a
    /// handler watching for the change.
    /// </summary>
    private InventoryFieldsFormModel? ShelfFieldsFor(TaskItemFormModel item)
    {
        if (_shelves.FieldsFor(item) is { } known)
        {
            return known;
        }

        if (item.Kind != nameof(TaskItemKind.Inventory) || _linkedInventoryId is not { } inventoryId)
        {
            return null;
        }

        return _shelves.DescribeNewProduct(item, inventoryId, _linkedInventoryName);
    }

    /// <summary>
    /// Reads the inventories an errand could be about, and the shelf item each errand on this list
    /// already names. Best effort throughout: an editor that would not open because an inventory could
    /// not be reached is worse than one whose inventory fields are missing.
    /// </summary>
    private async Task LoadTheShelvesAsync()
    {
        _shelves.Clear();
        if (Id is not { } taskListId)
        {
            return;
        }

        try
        {
            foreach (var reference in await TasksApiClient.GetInventoryReferencesAsync(taskListId))
            {
                if (_formModel.Items.FirstOrDefault(candidate => candidate.Id == reference.TaskItemId) is not { } item)
                {
                    continue;
                }

                await LoadTheShelfAsync(reference.InventoryId);
                if (_shelves.ShelfOf(reference.InventoryId)
                        .FirstOrDefault(product => product.Id == reference.InventoryItemId) is { } onTheShelf)
                {
                    _shelves.ChooseProduct(item, reference.InventoryId, onTheShelf, reference.InventoryName);
                }
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            // An editor that would not open because an inventory could not be read - or answered
            // something unreadable - is worse than one whose inventory fields are missing.
            Logger.LogWarning(exception, "Couldn't load the shelf items behind task list {TaskListId}", taskListId);
        }
    }

    /// <summary>Reads one inventory's shelf, once. Already-read shelves are left alone.</summary>
    private async Task LoadTheShelfAsync(Guid inventoryId)
    {
        if (_shelves.HasShelf(inventoryId))
        {
            return;
        }

        try
        {
            _shelves.RememberShelf(inventoryId, await InventoryApiClient.GetInventoryItemsAsync(inventoryId) ?? []);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            Logger.LogWarning(exception, "Couldn't read what is on the shelf in inventory {InventoryId}", inventoryId);
            _shelves.RememberShelf(inventoryId, []);
        }
    }

    /// <summary>
    /// Fills each calendar entry's fields from the event it already has. Without this, opening a list
    /// and saving it again would rewrite every appointment to whatever the empty form said - which is
    /// the one way this feature could quietly destroy something.
    ///
    /// Read from the events already loaded for this account, so it costs no extra request. An entry
    /// pointing at an event that is gone keeps its empty fields and is treated as a new one.
    /// </summary>
    private void ReadTheEventsBack()
    {
        foreach (var item in _formModel.Items.Where(candidate => candidate.Kind == nameof(TaskItemKind.Calendar)))
        {
            if (!Guid.TryParse(item.LinkedCalendarEventId, out var eventId)
                || _linkableEvents.FirstOrDefault(candidate => candidate.Id == eventId) is not { } linked)
            {
                continue;
            }

            var details = linked.Details;

            // Every field, through the one mapping the calendar's own editor uses. Field by field is
            // how the place went missing once already: each save then sent whatever the incomplete
            // copy held, and an entry whose event had a place had it erased by somebody editing
            // something else entirely.
            item.Event = EventFormModel.FromDto(details);
        }
    }

    /// <summary>
    /// Brings each calendar entry's event into being, or into step, before the list itself is saved.
    /// Before, not after, because the entry has to carry the event's id when the list is written - one
    /// save rather than two, and no window where the entry exists and the appointment does not.
    ///
    /// Returns false when something could not be written, so the caller can stop rather than save a list
    /// whose entries point at events that were never made.
    /// </summary>
    private async Task<bool> SaveTheCalendarAsync()
    {
        foreach (var item in _formModel.Items.Where(candidate => candidate.Kind == nameof(TaskItemKind.Calendar)))
        {
            try
            {
                var details = EventDetailsFor(item);
                if (Guid.TryParse(item.LinkedCalendarEventId, out var eventId))
                {
                    await CalendarApiClient.UpdateCalendarEventAsync(eventId, new UpdateCalendarEventRequest(details));
                    await InviteTheGuestsAsync(item, eventId);
                    continue;
                }

                var created = await CalendarApiClient.CreateCalendarEventAsync(new CreateCalendarEventRequest(details));
                item.LinkedCalendarEventId = created.ToString();
                Logger.LogInformation("A task entry created calendar event {EventId}", created);
                await InviteTheGuestsAsync(item, created);
            }
            catch (HttpRequestException exception)
            {
                Logger.LogError(exception, "Couldn't put a task entry's appointment in the calendar");
                _saveErrorMessage = T.Format("\"{0}\" couldn't be put in the calendar, so nothing was saved.", item.Description);
                return false;
            }
        }

        return true;
    }

    /// <summary>
    /// Who has been invited to which entry's event, and as what, while the list is being written. Held
    /// here rather than on the entry because it is not the entry's business: an invitation is a share,
    /// and a share needs an event id, which a new event does not have until it is saved.
    /// </summary>
    private readonly Dictionary<TaskItemFormModel, List<(Guid UserId, string AccessLevel)>> _invitationsByItem = [];

    /// <summary>
    /// The control has already put the guest on the event; this records what they were invited as, so
    /// the share can be sent once the event exists.
    /// </summary>
    private void InviteToTheEvent(TaskItemFormModel item, (Guid UserId, string AccessLevel) invitation)
    {
        if (!_invitationsByItem.TryGetValue(item, out var invitations))
        {
            invitations = [];
            _invitationsByItem[item] = invitations;
        }

        invitations.Add(invitation);
    }

    private void UninviteFromTheEvent(TaskItemFormModel item, Guid userId)
    {
        if (_invitationsByItem.TryGetValue(item, out var invitations))
        {
            invitations.RemoveAll(invitation => invitation.UserId == userId);
        }
    }

    private string GuestAccessLabelFor(TaskItemFormModel item, Guid userId)
        => _invitationsByItem.TryGetValue(item, out var invitations)
            && invitations.FirstOrDefault(invitation => invitation.UserId == userId) is { AccessLevel: { } level }
            ? level
            : string.Empty;

    /// <summary>What to call a guest - their login, or the raw id if they are no longer a contact.</summary>
    private string GuestName(Guid userId)
        => _contacts.FirstOrDefault(contact => contact.UserId == userId)?.UserName ?? userId.ToString();

    /// <summary>
    /// Sends the shares this session's invitations mean, now that the event has an id. A failure here
    /// does not undo the save: the event is real and the entry points at it, and the guest simply was
    /// not invited - which is why it is said out loud rather than logged and forgotten.
    /// </summary>
    private async Task InviteTheGuestsAsync(TaskItemFormModel item, Guid calendarEventId)
    {
        if (!_invitationsByItem.TryGetValue(item, out var invitations) || invitations.Count == 0)
        {
            return;
        }

        foreach (var (userId, accessLevel) in invitations)
        {
            try
            {
                await CalendarApiClient.ShareCalendarEventAsync(calendarEventId, userId, accessLevel);
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Couldn't invite a guest to a task entry's event");
                _saveErrorMessage = T.Format("{0} couldn't be invited to \"{1}\".", GuestName(userId), item.Description);
            }
        }

        invitations.Clear();
    }

    /// <summary>
    /// The entry, said in the shape the calendar takes. Its own words are the event's title, and
    /// everything else comes from the same model and the same mapping the calendar's own editor uses -
    /// see EventFormModel.ToRequest.
    /// </summary>
    private static CalendarEventDetailsRequest EventDetailsFor(TaskItemFormModel item)
        => item.Event.ToRequest(item.Description);


    /// <summary>
    /// Writes back whatever was changed on the shelf, one inventory at a time, and then rebuilds each
    /// inventory's restock list - a corrected amount can settle an errand or raise one, and leaving the
    /// list saying the old thing would make the edit look like it did not take.
    ///
    /// Runs after the list itself is saved. If it fails, the list is still saved: the shelf is a second
    /// thing this screen touches, not the thing it is for.
    /// </summary>
    /// <summary>
    /// What the storage this list is measured against is called. Best effort like everything else the
    /// editor reads about the shelf: a name that could not be read costs the sentence under the form
    /// and nothing else.
    /// </summary>
    /// <summary>
    /// Every storage this account has, for the picker. Best effort: a list can be written and saved
    /// without one, so a inventories call that fails costs the picker and nothing else.
    /// </summary>
    private async Task LoadTheInventoriesAsync()
    {
        try
        {
            _inventories = await InventoryApiClient.GetInventoriesAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't read the storages this list could be measured against");
        }
    }

    private async Task<string> NameOfTheLinkedInventoryAsync()
    {
        if (_linkedInventoryId is not { } inventoryId)
        {
            return string.Empty;
        }

        try
        {
            return (await InventoryApiClient.GetInventoryByIdAsync(inventoryId))?.Name ?? string.Empty;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't read the name of inventory {InventoryId}", inventoryId);
            return string.Empty;
        }
    }

    private async Task SaveTheShelfAsync()
    {
        if (_shelves.Fields.Count == 0)
        {
            return;
        }

        foreach (var byInventory in _shelves.Fields.GroupBy(product => product.InventoryId))
        {
            try
            {
                var inventory = await InventoryApiClient.GetInventoryByIdAsync(byInventory.Key);
                var shelf = await InventoryApiClient.GetInventoryItemsAsync(byInventory.Key);
                if (inventory is null || shelf is null)
                {
                    continue;
                }

                // A product reached from a restock errand is already on the shelf and has an id. One
                // an entry describes on a list measured against this storage has none yet - it is
                // being put there by this save, and its name is the entry's own words, which is what
                // the stock check matches the two by.
                var edited = byInventory
                    .Where(entry => entry.Product.Id is not null)
                    .ToDictionary(entry => entry.Product.Id!.Value);
                var items = shelf
                    .Select(product => edited.TryGetValue(product.Id, out var changed)
                        ? changed.Product.ToDto()
                        : new InventoryItemRequest(
                            product.Id, product.Name, product.ProductType, product.Category, product.Quantity,
                            product.MinimumQuantity, product.Unit, product.ExpiryDate, product.ExpiryNotificationChannel))
                    .ToList();

                var alreadyThere = shelf.Select(product => product.Name.Trim()).ToHashSet(StringComparer.CurrentCultureIgnoreCase);
                foreach (var (entry, fields) in _shelves.NewProductsIn(byInventory.Key))
                {
                    var name = entry.Description.Trim();
                    // Nothing to add for an entry that has stopped being an inventory one - its fields
                    // stay behind so switching back and forth does not lose what was typed - nor for one
                    // nobody has named yet, nor twice: a shelf already holding the thing is what the
                    // entry was asking for.
                    if (entry.Kind != nameof(TaskItemKind.Inventory) || name.Length == 0 || !alreadyThere.Add(name))
                    {
                        continue;
                    }

                    fields.Product.Name = name;
                    items.Add(fields.Product.ToDto());
                }

                await InventoryApiClient.UpdateInventoryAsync(
                    byInventory.Key, new SaveInventoryRequest(inventory.Name, items, inventory.IsPrivate));
                await InventoryApiClient.RefreshRestockListAsync(byInventory.Key);
            }
            catch (HttpRequestException exception)
            {
                Logger.LogError(exception, "Couldn't save the shelf behind inventory {InventoryId}", byInventory.Key);
                _saveErrorMessage = T["The list was saved, but the shelf couldn't be updated. Open the inventory and check it."];
            }
        }
    }

    /// <summary>
    /// One shelf item while it is being edited from a task list, and which inventory it belongs to.
    /// The item itself is the model the inventory editor uses, so both screens offer the same fields -
    /// see InventoryFields.razor.
    /// </summary>
    /// <param name="InventoryName">Shown to say where the change will land, and nothing else.</param>
    private sealed record InventoryFieldsFormModel(
        Guid InventoryId, string InventoryName, InventoryItemFormModel Product)
    {
        public static InventoryFieldsFormModel From(InventoryItemDto product, Guid inventoryId, string inventoryName)
            => new(inventoryId, inventoryName, InventoryItemFormModel.FromDto(product));
    }

    /// <summary>
    /// The shelf item behind each inventory errand on this list, while somebody is editing it. Only a
    /// restock list puts one there: an entry of that kind otherwise just names something the work needs,
    /// and the shelf is built from those names rather than picked from an existing one - see
    /// GenerateInventoryFromTaskListCommandHandler.
    ///
    /// Keyed by the entry rather than by its id, so an entry added in this sitting is no different from
    /// one that was already here.
    ///
    /// State only. The requests belong to the page, which is where a failed one is reported.
    /// </summary>
    private sealed class ShelfPicker
    {
        private readonly Dictionary<Guid, IReadOnlyList<InventoryItemDto>> _shelfByInventoryId = [];
        private readonly Dictionary<TaskItemFormModel, InventoryFieldsFormModel> _fieldsByItem = [];

        /// <summary>What each errand on this list is about, for the save that writes the shelves back.</summary>
        public IReadOnlyCollection<InventoryFieldsFormModel> Fields => _fieldsByItem.Values;

        public InventoryFieldsFormModel? FieldsFor(TaskItemFormModel item) => _fieldsByItem.GetValueOrDefault(item);

        public IReadOnlyList<InventoryItemDto> ShelfOf(Guid inventoryId)
            => _shelfByInventoryId.GetValueOrDefault(inventoryId, []);

        public bool HasShelf(Guid inventoryId) => _shelfByInventoryId.ContainsKey(inventoryId);

        public void RememberShelf(Guid inventoryId, IReadOnlyList<InventoryItemDto> shelf)
            => _shelfByInventoryId[inventoryId] = shelf;

        public void ChooseProduct(
            TaskItemFormModel item, Guid inventoryId, InventoryItemDto product, string inventoryName)
            => _fieldsByItem[item] = InventoryFieldsFormModel.From(product, inventoryId, inventoryName);

        /// <summary>
        /// Fields for a product this entry describes and the shelf does not hold yet. No id, because
        /// there is nothing there to have one - saving the list is what puts it on the shelf, under the
        /// entry's own name (see TaskEditor.SaveTheShelfAsync). Remembered against the entry like any
        /// other, so what is typed survives a redraw.
        /// </summary>
        public InventoryFieldsFormModel DescribeNewProduct(
            TaskItemFormModel item, Guid inventoryId, string inventoryName)
        {
            // Starts where generating a storage from a list would put it: one of the thing wanted, none
            // of it there yet, counted in pieces. An entry asking for something is asking for one of it
            // until it says otherwise - see GenerateInventoryFromTaskListCommandHandler, where the same
            // entry written twice asks for two. The unit is the model's own default and is named here
            // only because the two answers have to be the same answer.
            var fields = new InventoryFieldsFormModel(
                inventoryId, inventoryName,
                new InventoryItemFormModel { MinimumQuantity = 1, Unit = InventoryUnitOption.Default.Value });
            _fieldsByItem[item] = fields;
            return fields;
        }

        /// <summary>The entries on one storage that describe something not on its shelf yet, with their fields.</summary>
        public IEnumerable<(TaskItemFormModel Entry, InventoryFieldsFormModel Fields)> NewProductsIn(Guid inventoryId)
            => _fieldsByItem
                .Where(pair => pair.Value.InventoryId == inventoryId && pair.Value.Product.Id is null)
                .Select(pair => (pair.Key, pair.Value));

        public void Clear()
        {
            _shelfByInventoryId.Clear();
            _fieldsByItem.Clear();
        }
    }

    /// <summary>
    /// What stops this list being saved, or null when nothing does. Refused here rather than quietly
    /// corrected: a daily reminder with no hour would be sent at midnight, and an hour nobody chose is
    /// worse than being asked for one.
    /// </summary>
    private string? WhatIsWrongWithTheItems()
    {
        var withoutAnHour = _formModel.Items.FirstOrDefault(item =>
            item.Kind == nameof(TaskItemKind.Checklist) && item.RemindDaily && item.DailyReminderTimeOfDay is null);
        if (withoutAnHour is not null)
        {
            return T.Format("\"{0}\" is reminded daily, so it needs a time to be reminded at.", withoutAnHour.Description);
        }

        // An entry that made an event and is no longer a calendar entry is a conflict Orbit cannot
        // settle on its own: deleting the event would throw away something that may since have been
        // edited in the calendar, and keeping it silently leaves an appointment nothing points at. The
        // save stops and hands the choice back - "Detach from the event" is the way through.
        var changedAwayFromItsEvent = _formModel.Items.FirstOrDefault(item =>
            item.Kind != nameof(TaskItemKind.Calendar) && !string.IsNullOrEmpty(item.LinkedCalendarEventId));
        if (changedAwayFromItsEvent is not null)
        {
            return T.Format(
                "\"{0}\" already has an event in the calendar, so its type can't be changed. Detach it from the event first, then decide what to do with the event itself.",
                changedAwayFromItsEvent.Description);
        }

        var withoutWhenItHappens = _formModel.Items.FirstOrDefault(item =>
            item.Kind == nameof(TaskItemKind.Calendar) && item.Event.StartDate is null);
        if (withoutWhenItHappens is not null)
        {
            return T.Format("\"{0}\" is a calendar entry, so it needs a day to happen on.", withoutWhenItHappens.Description);
        }

        var endingBeforeItStarts = _formModel.Items.FirstOrDefault(item =>
            item.Kind == nameof(TaskItemKind.Calendar) && EventEndsBeforeItStarts(item));
        return endingBeforeItStarts is null
            ? null
            : T.Format("\"{0}\" ends before it starts.", endingBeforeItStarts.Description);
    }

    /// <summary>
    /// Checked here as well as on the server, which refuses it too - an inline answer beats a request
    /// that is bound to fail, and the calendar's own editor does the same.
    /// </summary>
    private static bool EventEndsBeforeItStarts(TaskItemFormModel item)
    {
        var details = item.Event.ToRequest(item.Description);
        return details.EndUtc < details.StartUtc;
    }

    /// <summary>
    /// Stops an entry being this event's, without touching the event. Whoever made it decides what
    /// happens to it, in the calendar, where they can see what they are deleting.
    /// </summary>
    private void DetachFromTheEvent(TaskItemFormModel item)
    {
        Logger.LogInformation("User detached a task entry from its calendar event");
        item.LinkedCalendarEventId = string.Empty;
    }

    /// <summary>
    /// When this entry is due, in one short phrase, or null when nothing is set. Read on the row now
    /// that the two boxes that set it live behind the toggle - a row that showed neither would leave
    /// somebody opening every item to find the one with a date on it.
    /// </summary>
    private string? WhenItIsDue(TaskItemFormModel item)
    {
        if (item.DueDate is not { } dueDate)
        {
            return null;
        }

        return item.DueTime is { } dueTime
            ? T.Format("due {0}", dueDate.ToDateTime(dueTime).ToString("dd.MM.yyyy HH:mm"))
            : T.Format("due {0}", dueDate.ToString("dd.MM.yyyy"));
    }

    /// <summary>What kind of entry this is, said on the row for anything that is not the ordinary one.</summary>
    private string DescribeKind(string kind) => kind switch
    {
        nameof(TaskItemKind.Calendar) => T["Calendar"],
        nameof(TaskItemKind.Inventory) => T["Inventory"],
        _ => T["Checklist"]
    };

