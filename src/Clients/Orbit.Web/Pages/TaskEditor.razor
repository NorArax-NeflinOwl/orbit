@page "/tasks/new"
@* The deep level has to be asked for by name. "/tasks/{id}" is the checklist - see TaskListChecklist,
   and see Tasks.razor's card for the two ways in. *@
@page "/tasks/{Id:guid}/edit"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Inventory
@using Orbit.Contracts.Notifications
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Core.Tasks
@using Orbit.Core.Suggestions
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject InventoryApiClient InventoryApiClient
@inject ChatApiClient ChatApiClient
@inject CalendarApiClient CalendarApiClient
@inject NotificationsApiClient NotificationsApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<TaskEditor> Logger
@inject Translations T

<PageTitle>@(IsNewTaskList ? T["New task list"] : T["Edit task list"])</PageTitle>

<div class="page-header">
    <div>
        <h1>@(IsNewTaskList ? T["New task list"] : T["Edit task list"])</h1>
    </div>
    @* Only for a list that exists: nothing here can act on one that has never been saved. *@
    @if (!IsNewTaskList && Id is { } menuTaskListId)
    {
        <div class="page-header-actions">
            <OverflowMenu>
                <button type="button" class="avatar-dropdown-item" disabled="@_isWorkingOnInventory"
                        @onclick="() => GenerateInventoryAsync(menuTaskListId)">
                    @T["Generate inventory"]
                </button>
                @* Nothing to recalculate until there is a warehouse to recalculate against. *@
                <button type="button" class="avatar-dropdown-item"
                        disabled="@(_isWorkingOnInventory || _linkedWarehouseId is null)"
                        @onclick="() => RecalculateAsync(menuTaskListId)">
                    @T["Recalculate against the inventory"]
                </button>
            </OverflowMenu>
        </div>
    }
</div>

@if (_inventoryMessage is not null)
{
    <p class="info">@_inventoryMessage</p>
}

@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else
{
    @if (_isShared)
    {
        <p class="shared-task-list-banner">@T["This task list was shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
        @if (_access.CanAskToEdit && _originalOwnerUserId is { } ownerUserId)
        {
            <RequestEditAccessButton ItemType="TaskList" ItemId="Id!.Value" ItemTitle="_formModel.Title"
                                     OwnerUserId="ownerUserId" OwnUserId="_ownUserId"
                                     OwnerDisplayName="@(_sharedByUserName ?? "them")" />
        }
    }

    @if (_lockedByUserName is not null)
    {
        <p class="lock-banner">
            @T.Format("{0} is currently editing this task list - you can't edit it right now.", _lockedByUserName)
        </p>
    }

    @* Submitting this form adds a row rather than saving it. Enter is what somebody writing a list
       presses between items, and it used to save the list and leave the page instead - so the form's
       default button is "Add item", and Save is a click of its own. *@
    <EditForm Model="_formModel" OnValidSubmit="AddItem" class="editor-form">
    <fieldset disabled="@(_isSharedReadOnly || _lockedByUserName is not null || _isSaving)">
        <div class="field">
            <label>@T["Title"]</label>
            @* oninput as well as the default onchange, so the suggestions below see the title as it is
               being typed rather than only once the field is left. *@
            <InputText @bind-Value="_formModel.Title"
                       @oninput="args => _formModel.Title = args.Value?.ToString() ?? string.Empty" />
            <NameSuggestions Kind="NameSuggestionKind.TaskListTitle" Value="_formModel.Title"
                             OnChosen="chosen => _formModel.Title = chosen" />
        </div>

        @* Only the owner may turn this on: a list reached through a share belongs to someone else,
           and "private" means private to its creator. *@
        @if (!_isShared)
        {
            <div class="field">
                <label>
                    <InputCheckbox @bind-Value="_formModel.IsPrivate" />@T["Private"]</label>
                <small>
                    @T["Encrypted in this browser, so Orbit can't read it. It can't be shared, gets no reminders, and losing your password loses it."]
                </small>
            </div>
        }

        <div class="field">
            <label>
                <InputCheckbox @bind-Value="_formModel.IsGroup" />@T["Group View"]</label>
            <small>
                @T["A group list's checklist also shows every list it gathers, so the whole group fits on one screen."]
            </small>
        </div>

        <div class="field">
            <label for="taskListPrioritySelect">@T["Priority"]</label>
            <InputSelect id="taskListPrioritySelect" @bind-Value="_formModel.Priority">
                <option value="Low">@T["Low"]</option>
                <option value="Normal">@T["Normal"]</option>
                <option value="High">@T["High"]</option>
            </InputSelect>
            <small>@T["Sorts this list against the others. Its progress is worked out from its items."]</small>
        </div>

        <h2>@T["Items"]</h2>
        @foreach (var item in _formModel.Items)
        {
            <div class="editor-item @(_itemOrder.IsDragging(item) ? "dragging" : "")" @key="item"
                 @ondragover:preventDefault="true" @ondrop="() => DropItemOn(item)">
                @* One line per item: what it says, when it's due, whether it's done. Everything else is
                   a click away, so a list of any length still fits on a screen. *@
                <div class="editor-item-summary">
                @* Only the handle is draggable: a row full of text boxes would otherwise start a drag
                   whenever somebody selected what they had typed. *@
                <ReorderControls OnDragStart="() => _itemOrder.Start(item)" OnDragEnd="_itemOrder.Finish"
                                 OnMoveUp="() => MoveItem(item, -1)" OnMoveDown="() => MoveItem(item, 1)"
                                 CanMoveUp="CanMoveItem(item, -1)" CanMoveDown="CanMoveItem(item, 1)" />
                    @if (string.IsNullOrEmpty(item.LinkedTaskListId))
                    {
                        <InputCheckbox @bind-Value="item.IsCompleted" title="@(T["Completed"])" />
                    }
                    else
                    {
                        <input type="checkbox" checked="@item.IsCompleted" disabled
                               title="@(T["Completed - follows the linked list, can't be set by hand"])" />
                    }
                    @* Reassigned on every row, so it holds the last one by the time the loop ends - which
                       is the row Add item just appended, and the one the cursor belongs in. *@
                    <InputText class="editor-item-main" @ref="_lastItemDescription" @bind-Value="item.Description"
                               placeholder="@(T["Item description"])"
                               @oninput="args => item.Description = args.Value?.ToString() ?? string.Empty" />
                    <NameSuggestions Kind="NameSuggestionKind.TaskItemDescription" Value="item.Description"
                                     OnChosen="chosen => item.Description = chosen" />
                    <span class="editor-item-aside">
                        @* What the row reports rather than what it sets: when this is due, if anything,
                           and what kind of entry it is. Everything editable now waits behind the toggle,
                           so a list of thirty items is thirty readable lines instead of a wall of boxes. *@
                        @if (WhenItIsDue(item) is { } due)
                        {
                            <span class="row-meta">@due</span>
                        }
                        @if (item.Kind != nameof(TaskItemKind.Checklist))
                        {
                            <span class="card-badge">@DescribeKind(item.Kind)</span>
                        }
                        <button type="button" class="editor-item-toggle @(IsExpanded(item) ? "open" : "")"
                                title="@(IsExpanded(item) ? T["Hide this item's other settings"] : T["Show this item's other settings"])"
                                aria-expanded="@(IsExpanded(item) ? "true" : "false")"
                                @onclick="() => ToggleExpanded(item)">
                            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
                        </button>
                    </span>
                </div>

                @if (IsExpanded(item))
                {
                    <div class="editor-item-details">
                        @* Four fields every entry has, whatever it is: what it is, when it is due, where
                           it could go instead, and the way to take it off the list. Everything after them
                           depends on the type - see TaskItemKind. *@
                        <label>@T["Type"]<select @bind="item.Kind">
                                <option value="@nameof(TaskItemKind.Checklist)">@T["Checklist"]</option>
                                <option value="@nameof(TaskItemKind.Calendar)">@T["Calendar"]</option>
                                <option value="@nameof(TaskItemKind.Inventory)">@T["Inventory"]</option>
                            </select>
                        </label>
                        <label>@T["Due date"]<DateField @bind-Value="item.DueDate" AriaLabel="@(T["Due date"])" />
                        </label>
                        <label>@T["Due time"]<TimeField @bind-Value="item.DueTime" AriaLabel="@(T["Due time"])" />
                        </label>
                        @if (item.Id is { } persistedItemId && _moveTargetTaskLists.Count > 0)
                        {
                            <label>@T["Move to list"]<select @onchange="@(changeArgs => MoveItemAsync(item, persistedItemId, changeArgs.Value))" disabled="@_isMovingItem">
                                    <option value="">@T["Move to…"]</option>
                                    @foreach (var targetTaskList in _moveTargetTaskLists)
                                    {
                                        <option value="@targetTaskList.Id">@Written(targetTaskList.Title)</option>
                                    }
                                </select>
                            </label>
                        }
                        @if (item.Kind == nameof(TaskItemKind.Calendar))
                        {
                            <label>@T["Calendar event"]<select @bind="item.LinkedCalendarEventId">
                                    <option value="">@T["None"]</option>
                                    @foreach (var linkableEvent in _linkableEvents)
                                    {
                                        <option value="@linkableEvent.Id">@linkableEvent.Details.Title</option>
                                    }
                                </select>
                            </label>
                            @* One place, not two. Tied to an event, the event holds it - so the box is
                               replaced by what the event says rather than offering a second answer that
                               could drift from the first. *@
                            @if (string.IsNullOrEmpty(item.LinkedCalendarEventId))
                            {
                                <label>@T["Location"]<InputText @bind-Value="item.Location"
                                                                placeholder="@(T["Where this happens"])" />
                                </label>
                                @* The name is the reader's to write. Confirming a pin fills an empty box
                                   and leaves a name they chose alone - see UseThePickedPlace. *@
                                <span class="field-break"></span>
                                <small>@T["The name is yours to write - the pin below keeps its exact position either way."]</small>
                                @* Typing an address is one way; pointing at it is the other, and the
                                   one that works when nobody knows what the street is called. *@
                                <button type="button" class="btn-secondary" @onclick="() => OpenTheMapFor(item)">@T["Show map"]</button>
                            }
                            else
                            {
                                <span class="field-break"></span>
                                <small>@T.Format("Happens at {0}, which the event decides.", LinkedEventLocation(item))</small>
                            }
                        }
                        @* A restock errand edits the shelf it is about, right here. That is the point of
                           giving these entries a kind and a link: the row already knows which product it
                           means, so correcting the amount should not mean opening the warehouse in
                           another tab and finding it again. Saved back with the list - see SaveAsync. *@
                        @if (item.Kind == nameof(TaskItemKind.Inventory))
                        {
                            @if (InventoryFieldsFor(item) is { } product)
                            {
                                <label>@T["Item name"]<InputText @bind-Value="product.Name" placeholder="@(T["Item name"])" />
                                </label>
                                <label title="@(T["How much of it there is"])">@T["Amount"]
                                    <InputNumber TValue="decimal" @bind-Value="product.Quantity" step="0.01" />
                                </label>
                                <label title="@(T["Restock once the amount drops below this"])">@T["Min"]
                                    <InputNumber TValue="decimal?" @bind-Value="product.MinimumQuantity" step="0.01" />
                                </label>
                                <label title="@(T["What this is counted in"])">@T["Unit"]
                                    <select @bind="product.Unit" aria-label="@(T["Unit"])">
                                        @foreach (var option in InventoryUnitOption.All)
                                        {
                                            <option value="@option.Value" title="@T[option.Name]">@T[option.ShortName]</option>
                                        }
                                    </select>
                                </label>
                                <label>@T["Product type"]<InputText @bind-Value="product.ProductType" placeholder="@(T["Product type"])" />
                                </label>
                                <label>@T["Category"]<InputText @bind-Value="product.Category" placeholder="@(T["Category"])" />
                                </label>
                                <label>@T["Expires in"]<ExpiresInField Value="product.ExpiryDate"
                                                                      ValueChanged="expiresOn => product.ExpiryDate = expiresOn" />
                                </label>
                                <label>@T["Expiry notification"]<select @bind="product.ExpiryNotificationChannel">
                                        @foreach (var option in NotificationChannelOption.All)
                                        {
                                            <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                                        }
                                    </select>
                                </label>
                                <span class="field-break"></span>
                                <small>@T.Format("On the shelf in {0}. Saving this list saves the change there too.", product.WarehouseName)</small>
                            }
                            else
                            {
                                <span class="field-break"></span>
                                <small>@T["This entry isn't tied to a product yet, so there is nothing to edit here."]</small>
                            }
                        }
                        else if (item.Kind == nameof(TaskItemKind.Checklist))
                        {
                            <label>@T["Link to list"]<select @bind="item.LinkedTaskListId">
                                    <option value="">@T["None"]</option>
                                    @foreach (var linkableTaskList in _linkableTaskLists)
                                    {
                                        <option value="@linkableTaskList.Id">@Written(linkableTaskList.Title)</option>
                                    }
                                </select>
                            </label>
                            <label>@T["Overdue notification"]<select @bind="item.OverdueNotificationChannel">
                                    @foreach (var option in NotificationChannelOption.All)
                                    {
                                        <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <InputCheckbox @bind-Value="item.RemindDaily" />@T["Remind daily"]</label>
                            @if (item.RemindDaily)
                            {
                                <label>@T["Daily reminder channel"]<select @bind="item.DailyReminderNotificationChannel">
                                        @foreach (var option in NotificationChannelOption.All)
                                        {
                                            <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                                        }
                                    </select>
                                </label>
                                @* Required, not optional: a daily reminder with no hour has nothing to
                                   arrive at, and the scheduler would send it at midnight - see
                                   ValidateItems, which refuses the save rather than picking an hour
                                   nobody asked for. *@
                                <label>@T["Daily reminder time"]<TimeField @bind-Value="item.DailyReminderTimeOfDay" AriaLabel="@(T["Daily reminder time"])" />
                                </label>
                            }
                            @if (!string.IsNullOrEmpty(item.LinkedTaskListId))
                            {
                                <span class="field-break"></span>
                                <small>@T["Completion follows the linked list, so it can't be ticked by hand."]</small>
                            }
                        }
                        @if (_moveErrorMessage is not null && item.Id is { } movedItemId && _moveErrorMessageForItemId == movedItemId)
                        {
                            <span class="field-break"></span>
                            <p class="error">@_moveErrorMessage</p>
                        }
                    </div>
                }
            </div>
        }
        <div>
            @* The form's only submit button, and so the one Enter presses - see the EditForm above. *@
            <button type="submit" class="btn-secondary">@T["Add item"]</button>
        </div>

        @if (_saveErrorMessage is not null)
        {
            <p class="error">@_saveErrorMessage</p>
        }
        <div class="form-actions">
            <button type="button" class="btn-primary" @onclick="SaveAsync">@T["Save"]</button>
            <button type="button" class="btn-secondary" @onclick="CancelAsync">@T["Cancel"]</button>
        </div>
    </fieldset>
    </EditForm>

    @if (!IsNewTaskList && !_formModel.IsPrivate && Id is { } taskListId)
    {
        <h2>@T["Link"]</h2>
        <ShareLinkButton ItemType="TaskList" ItemId="taskListId" />
    }

    @if (!IsNewTaskList && _canShare && !_formModel.IsPrivate)
    {
        <h2>@T["Sharing"]</h2>
        @if (_shareableContacts.Count == 0)
        {
            <p>@T["No contacts. A contact will appear here once you start a chat with someone."]</p>
        }
        else
        {
            <div class="field-row">
                <select id="shareContactSelect" @bind="_selectedContactUserId">
                    <option value="">@T["-- select a contact --"]</option>
                    @foreach (var contact in _shareableContacts)
                    {
                        <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                    }
                </select>
                <select id="shareAccessLevelSelect" @bind="_selectedAccessLevel">
                    <option value="ReadOnly">@T["Read-only"]</option>
                    <option value="Share">@T["Can share"]</option>
                    @if (_canGrantEditOnly)
                    {
                        <option value="EditOnly">@T["Can edit, but not share editing"]</option>
                    }
                    @if (_canGrantCanEdit)
                    {
                        <option value="CanEdit">@T["Can edit"]</option>
                    }
                </select>
                <button type="button" id="shareTaskListButton" class="btn-primary" disabled="@_isSharing" @onclick="ShareAsync">@T["Share"]</button>
            </div>
        }
        @if (_shareErrorMessage is not null)
        {
            <p class="error">@_shareErrorMessage</p>
        }
        @if (_shareInfoMessage is not null)
        {
            <p class="info">@_shareInfoMessage</p>
        }
    }
}

@if (_itemBeingPlacedOnTheMap is { } itemOnTheMap)
{
    <LocationPickerOverlay Address="@itemOnTheMap.Location" OnPicked="UseThePickedPlace" OnCancelled="CloseTheMap" />
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewTaskList => Id is null;

    /// <summary>
    /// The warehouse this list is measured against, if any, and what the last calculation said. The
    /// editor shows the answer in a line rather than a table - the checklist screen is where the detail
    /// belongs, and this is the screen for changing the list itself.
    /// </summary>
    private Guid? _linkedWarehouseId;
    private bool _isWorkingOnInventory;
    private string? _inventoryMessage;

    private async Task GenerateInventoryAsync(Guid taskListId)
    {
        _isWorkingOnInventory = true;
        _inventoryMessage = null;
        Logger.LogInformation("User generated an inventory from task list {TaskListId}", taskListId);
        try
        {
            if (await TasksApiClient.GenerateInventoryAsync(taskListId) is not { } warehouseId)
            {
                return;
            }

            _linkedWarehouseId = warehouseId;
            _inventoryMessage = T["Inventory generated from this list."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to generate an inventory from task list {TaskListId}", taskListId);
            _inventoryMessage = T["Couldn't generate an inventory from this list."];
        }
        finally
        {
            _isWorkingOnInventory = false;
        }
    }

    /// <summary>Runs the count again and says how it came out - the detail is on the checklist screen.</summary>
    private async Task RecalculateAsync(Guid taskListId)
    {
        _isWorkingOnInventory = true;
        _inventoryMessage = null;
        Logger.LogInformation("User recalculated the stock check for task list {TaskListId}", taskListId);
        try
        {
            var check = await TasksApiClient.GetStockCheckAsync(taskListId);
            _inventoryMessage = check is null
                ? T["This list isn't measured against an inventory."]
                : check.IsAchievable
                    ? T["Everything this list needs is on the shelf."]
                    : T.Format("{0} of what this needs is short.", check.Requirements.Count(requirement => requirement.Missing > 0));
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to recalculate the stock check for task list {TaskListId}", taskListId);
            _inventoryMessage = T["Couldn't recalculate against the inventory."];
        }
        finally
        {
            _isWorkingOnInventory = false;
        }
    }
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSharing;
    private bool _isMovingItem;
    private string? _moveErrorMessage;
    private Guid? _moveErrorMessageForItemId;
    private TaskListFormModel _formModel = new();

    /// <summary>The row being dragged to a new place, while one is - see RowArrangement.</summary>
    private readonly RowArrangement<TaskItemFormModel> _itemOrder = new();

    /// <summary>
    /// Which item currently has its extra settings open, if any. One at a time on purpose: the point of
    /// folding them away is that the list stays readable, which a page full of open items would undo.
    /// </summary>
    private TaskItemFormModel? _expandedItem;
    /// <summary>The lists an item may link to - see TaskListLinkCycle for what is left out and why.</summary>
    private IReadOnlyList<TaskDto> _linkableTaskLists = [];

    /// <summary>The lists a row may be moved to, which is any but this one.</summary>
    private IReadOnlyList<TaskDto> _moveTargetTaskLists = [];
    private bool _isShared;
    private bool _isSharedReadOnly;
    private bool _canShare;
    private bool _canGrantCanEdit;
    private bool _canGrantEditOnly;
    private SharedItemAccess _access = new(IsShared: false, ShareAccessLevel.CanEdit);
    private Guid? _originalOwnerUserId;
    private string? _sharedByUserName;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private string? _shareErrorMessage;
    private string? _shareInfoMessage;
    private string? _saveErrorMessage;
    private Guid _ownUserId;
    private NotificationSettingsDto _notificationSettings = new(true, true, true, true, true, BannerVisibleSeconds: 5, BannerMinimumGapSeconds: 5);

    /// <summary>Mirrors NoteEditor's field of the same name - see its comment.</summary>
    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private IReadOnlyList<ContactDto> _shareableContacts
        => _originalOwnerUserId is { } originalOwnerUserId
            ? _contacts.Where(contact => contact.UserId != originalOwnerUserId).ToList()
            : _contacts;

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private string SharedAccessDescription => T[_access.Description];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync()
                ?? throw new HttpRequestException("No signed-in user.", null, HttpStatusCode.Unauthorized);

            // Best-effort: gates which notification-channel options are selectable (see
            // NotificationChannelOption.IsDisabledBy) - a failure here just leaves every option enabled
            // rather than blocking the rest of the page from loading.
            try
            {
                _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Failed to load notification settings");
            }

            // Populates the "link to another list" dropdown - excludes the list being edited itself, since
            // an item can't link to the list it belongs to (see TaskListLinkValidator on the API side).
            var allTaskLists = await TasksApiClient.GetTaskListsAsync();
            // Best-effort: an entry can be tied to an event, but a calendar that will not load is no
            // reason for the task editor not to.
            try
            {
                _linkableEvents = await CalendarApiClient.GetCalendarEventsAsync();
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Failed to load the events a task entry could be tied to");
            }
            // Somewhere to move a row to is any list but this one - moving is not linking, and carries
            // none of linking's rules.
            _moveTargetTaskLists = Id is { } movingFromId
                ? [.. allTaskLists.Where(taskList => taskList.Id != movingFromId)]
                : allTaskLists;

            // Linking is narrower: a list that links back here, however long the chain, would close a
            // loop and the save would refuse it - see TaskListLinkCycle. Left out of the dropdown rather
            // than offered and then rejected, which is how every other rule the server enforces is
            // handled on this side.
            _linkableTaskLists = Id is { } currentTaskListId
                ? [.. allTaskLists.Where(taskList => !TaskListLinkCycle.WouldClose(allTaskLists, currentTaskListId, taskList.Id))]
                : allTaskLists;

            if (Id is { } taskListId)
            {
                Logger.LogInformation("Task list editor opened for task list {TaskListId}", taskListId);
                var taskList = await TasksApiClient.GetTaskListByIdAsync(taskListId);
                if (taskList is not null)
                {
                    _linkedWarehouseId = taskList.LinkedWarehouseId;
                    _formModel = new TaskListFormModel
                    {
                        Title = taskList.Title,
                        IsGroup = taskList.IsGroup,
                        IsPrivate = taskList.IsPrivate,
                        Priority = taskList.Priority,
                        Items = taskList.Items
                            .Select(item => new TaskItemFormModel
                            {
                                Id = item.Id,
                                Description = item.Description,
                                DueDate = item.DueDateUtc is { } dueDateUtc ? DateOnly.FromDateTime(dueDateUtc.LocalDateTime) : null,
                                DueTime = item.DueDateUtc is { } dueTimeUtc ? TimeOnly.FromDateTime(dueTimeUtc.LocalDateTime) : null,
                                IsCompleted = item.IsCompleted,
                                Kind = item.Kind,
                                Location = item.Location,
                                LinkedCalendarEventId = item.LinkedCalendarEventId?.ToString() ?? string.Empty,
                                LinkedTaskListId = item.LinkedTaskListId?.ToString() ?? string.Empty,
                                OverdueNotificationChannel = item.OverdueNotificationChannel,
                                RemindDaily = item.RemindDaily,
                                DailyReminderNotificationChannel = item.DailyReminderNotificationChannel,
                                DailyReminderTimeOfDay = item.DailyReminderTimeOfDay
                            })
                            .ToList()
                    };
                    _isShared = taskList.IsShared;
                    _access = SharedItemAccess.For(taskList.IsShared, taskList.AccessLevel);
                    _isSharedReadOnly = taskList.IsShared && !_access.CanEdit;
                    _canShare = _access.CanShare;
                    _canGrantCanEdit = _access.CanGrantCanEdit;
                    _canGrantEditOnly = _access.CanGrantEditOnly;
                    _originalOwnerUserId = taskList.OriginalOwnerUserId;
                    _sharedByUserName = taskList.SharedByUserName;

                    if (!_isSharedReadOnly)
                    {
                        await AcquireLockAsync(taskListId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(taskListId);
                        }
                    }
                }

                _contacts = await ChatApiClient.GetContactsAsync();
            }
            else
            {
                Logger.LogInformation("Task list editor opened for a new task list");
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadInventoryFieldsAsync();
        _isLoading = false;
    }

    private bool IsExpanded(TaskItemFormModel item) => ReferenceEquals(_expandedItem, item);

    private void ToggleExpanded(TaskItemFormModel item) => _expandedItem = IsExpanded(item) ? null : item;

    /// <summary>
    /// <summary>
    /// The shelf item behind each inventory errand on this list, keyed by the entry's id, while somebody
    /// is editing it. Loaded once when the editor opens: an entry names its product, and the point of
    /// naming it is being able to correct it from here.
    /// </summary>
    private readonly Dictionary<Guid, InventoryFieldsFormModel> _inventoryFieldsByTaskItemId = [];

    private InventoryFieldsFormModel? InventoryFieldsFor(TaskItemFormModel item)
        => item.Id is { } itemId ? _inventoryFieldsByTaskItemId.GetValueOrDefault(itemId) : null;

    /// <summary>
    /// Reads the shelf items this list's errands are about. Best effort: an editor that would not open
    /// because a warehouse could not be reached is worse than one whose inventory fields are missing.
    /// </summary>
    private async Task LoadInventoryFieldsAsync()
    {
        _inventoryFieldsByTaskItemId.Clear();
        if (Id is not { } taskListId)
        {
            return;
        }

        try
        {
            var references = await TasksApiClient.GetInventoryReferencesAsync(taskListId);
            foreach (var byWarehouse in references.GroupBy(reference => reference.WarehouseId))
            {
                var shelf = await InventoryApiClient.GetInventoryItemsAsync(byWarehouse.Key) ?? [];
                foreach (var reference in byWarehouse)
                {
                    if (shelf.FirstOrDefault(product => product.Id == reference.InventoryItemId) is { } product)
                    {
                        _inventoryFieldsByTaskItemId[reference.TaskItemId] =
                            InventoryFieldsFormModel.From(product, byWarehouse.Key, reference.WarehouseName);
                    }
                }
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            // An editor that would not open because a warehouse could not be read - or answered
            // something unreadable - is worse than one whose inventory fields are missing.
            Logger.LogWarning(exception, "Couldn't load the shelf items behind task list {TaskListId}", taskListId);
        }
    }

    /// <summary>
    /// Writes back whatever was changed on the shelf, one warehouse at a time, and then rebuilds each
    /// warehouse's restock list - a corrected amount can settle an errand or raise one, and leaving the
    /// list saying the old thing would make the edit look like it did not take.
    ///
    /// Runs after the list itself is saved. If it fails, the list is still saved: the shelf is a second
    /// thing this screen touches, not the thing it is for.
    /// </summary>
    private async Task SaveTheShelfAsync()
    {
        if (_inventoryFieldsByTaskItemId.Count == 0)
        {
            return;
        }

        foreach (var byWarehouse in _inventoryFieldsByTaskItemId.Values.GroupBy(product => product.WarehouseId))
        {
            try
            {
                var warehouse = await InventoryApiClient.GetWarehouseByIdAsync(byWarehouse.Key);
                var shelf = await InventoryApiClient.GetInventoryItemsAsync(byWarehouse.Key);
                if (warehouse is null || shelf is null)
                {
                    continue;
                }

                var edited = byWarehouse.ToDictionary(product => product.Id);
                var items = shelf
                    .Select(product => edited.TryGetValue(product.Id, out var changed)
                        ? changed.ToDto()
                        : new WarehouseItemDto(
                            product.Id, product.Name, product.ProductType, product.Category, product.Quantity,
                            product.MinimumQuantity, product.Unit, product.ExpiryDate, product.ExpiryNotificationChannel))
                    .ToList();

                await InventoryApiClient.UpdateWarehouseAsync(
                    byWarehouse.Key, new SaveWarehouseRequest(warehouse.Name, items, warehouse.IsPrivate));
                await InventoryApiClient.RefreshRestockListAsync(byWarehouse.Key);
            }
            catch (HttpRequestException exception)
            {
                Logger.LogError(exception, "Couldn't save the shelf behind warehouse {WarehouseId}", byWarehouse.Key);
                _saveErrorMessage = T["The list was saved, but the shelf couldn't be updated. Open the warehouse and check it."];
            }
        }
    }

    /// <summary>One shelf item while it is being edited from a task list, plus where it lives.</summary>
    private sealed class InventoryFieldsFormModel
    {
        public Guid Id { get; init; }
        public Guid WarehouseId { get; init; }
        public string WarehouseName { get; init; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string ProductType { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal? MinimumQuantity { get; set; }
        public string Unit { get; set; } = InventoryUnitOption.Default.Value;
        public DateTimeOffset? ExpiryDate { get; set; }
        public string ExpiryNotificationChannel { get; set; } = NotificationChannelOption.All[0].Value;

        public static InventoryFieldsFormModel From(InventoryItemDto product, Guid warehouseId, string warehouseName)
            => new()
            {
                Id = product.Id,
                WarehouseId = warehouseId,
                WarehouseName = warehouseName,
                Name = product.Name,
                ProductType = product.ProductType,
                Category = product.Category,
                Quantity = product.Quantity,
                MinimumQuantity = product.MinimumQuantity,
                Unit = InventoryUnitOption.For(product.Unit).Value,
                ExpiryDate = product.ExpiryDate,
                ExpiryNotificationChannel = product.ExpiryNotificationChannel
            };

        public WarehouseItemDto ToDto()
            => new(Id, Name, ProductType, Category, Quantity, MinimumQuantity, Unit, ExpiryDate, ExpiryNotificationChannel);
    }

    /// <summary>
    /// What stops this list being saved, or null when nothing does. Refused here rather than quietly
    /// corrected: a daily reminder with no hour would be sent at midnight, and an hour nobody chose is
    /// worse than being asked for one.
    /// </summary>
    private string? WhatIsWrongWithTheItems()
    {
        var withoutAnHour = _formModel.Items.FirstOrDefault(item =>
            item.Kind == nameof(TaskItemKind.Checklist) && item.RemindDaily && item.DailyReminderTimeOfDay is null);

        return withoutAnHour is null
            ? null
            : T.Format("\"{0}\" is reminded daily, so it needs a time to be reminded at.", withoutAnHour.Description);
    }

    /// <summary>
    /// When this entry is due, in one short phrase, or null when nothing is set. Read on the row now
    /// that the two boxes that set it live behind the toggle - a row that showed neither would leave
    /// somebody opening every item to find the one with a date on it.
    /// </summary>
    private string? WhenItIsDue(TaskItemFormModel item)
    {
        if (item.DueDate is not { } dueDate)
        {
            return null;
        }

        return item.DueTime is { } dueTime
            ? T.Format("due {0}", dueDate.ToDateTime(dueTime).ToString("dd.MM.yyyy HH:mm"))
            : T.Format("due {0}", dueDate.ToString("dd.MM.yyyy"));
    }

    /// <summary>What kind of entry this is, said on the row for anything that is not the ordinary one.</summary>
    private string DescribeKind(string kind) => kind switch
    {
        nameof(TaskItemKind.Calendar) => T["Calendar"],
        nameof(TaskItemKind.Inventory) => T["Inventory"],
        _ => T["Checklist"]
    };

