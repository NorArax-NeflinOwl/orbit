    /// Where the event an entry is tied to happens, for the line that stands in for the location box.
    /// An event that has since been deleted, or has no location of its own, reads as unsaid rather than
    /// as an error - the link is not validated, by the same rule a link to a deleted list follows.
    /// </summary>
    private string LinkedEventLocation(TaskItemFormModel item)
    {
        var linked = _linkableEvents.FirstOrDefault(candidate => candidate.Id.ToString() == item.LinkedCalendarEventId);
        return linked?.Details.Location?.Address is { Length: > 0 } address ? address : T["somewhere the event does not say"];
    }

