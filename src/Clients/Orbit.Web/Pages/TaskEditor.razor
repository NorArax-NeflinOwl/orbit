@page "/tasks/new"
@page "/tasks/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject ChatApiClient ChatApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<TaskEditor> Logger

<PageTitle>@(IsNewTaskList ? "New task list" : "Edit task list")</PageTitle>

@* TODO(Orbit.Web.UI): still plain unstyled form markup. Restyle together with Tasks.razor (see its own
   TODO) onto the .task-list-card/.checklist/.check-row pattern from the approved concept mockup - the
   checkbox/priority-dot/due-date row layout there was designed to double as this editor's item list,
   not just the summary view. *@
<h1>@(IsNewTaskList ? "New task list" : "Edit task list")</h1>

@if (_isLoading)
{
    <p>Loading…</p>
}
else
{
    @if (_isShared)
    {
        <p class="shared-task-list-banner">
            This task list was shared by <strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
    }

    @if (_lockedByUserName is not null)
    {
        <p class="lock-banner">
            <strong>@_lockedByUserName</strong> is currently editing this task list - you can't edit it right now.
        </p>
    }

    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="editor-form">
    <fieldset disabled="@(_isSharedReadOnly || _lockedByUserName is not null || _isSaving)">
        <div class="field">
            <label>Title</label>
            <InputText @bind-Value="_formModel.Title" />
        </div>

        <h2>Items</h2>
        @foreach (var item in _formModel.Items)
        {
            <div class="editor-item-card" @key="item">
                <div class="field-row">
                    <InputText @bind-Value="item.Description" placeholder="Item description" />
                    <InputDate @bind-Value="item.DueDate" />
                    <input type="time" @bind="item.DueTime" />
                </div>
                <label>
                    Link to list
                    <select @bind="item.LinkedTaskListId">
                        <option value="">None</option>
                        @foreach (var linkableTaskList in _linkableTaskLists)
                        {
                            <option value="@linkableTaskList.Id">@linkableTaskList.Title</option>
                        }
                    </select>
                </label>
                @if (string.IsNullOrEmpty(item.LinkedTaskListId))
                {
                    <label>
                        <InputCheckbox @bind-Value="item.IsCompleted" />
                        Completed
                    </label>
                }
                else
                {
                    <label>
                        <input type="checkbox" checked="@item.IsCompleted" disabled />
                        Completed (determined by the linked list, can't be set manually)
                    </label>
                }
                <label>
                    Overdue notification
                    <select @bind="item.OverdueNotificationChannel">
                        @foreach (var option in NotificationChannelOption.All)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <InputCheckbox @bind-Value="item.RemindDaily" />
                    Remind daily
                </label>
                @if (item.RemindDaily)
                {
                    <label>
                        Daily reminder channel
                        <select @bind="item.DailyReminderNotificationChannel">
                            @foreach (var option in NotificationChannelOption.All)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        Daily reminder time
                        <input type="time" @bind="item.DailyReminderTimeOfDay" />
                    </label>
                }
                <div>
                    <button type="button" class="btn-secondary" @onclick="() => RemoveItem(item)">Remove</button>
                </div>
            </div>
        }
        <div>
            <button type="button" class="btn-secondary" @onclick="AddItem">Add item</button>
        </div>

        @if (_saveErrorMessage is not null)
        {
            <p class="error">@_saveErrorMessage</p>
        }
        <div class="form-actions">
            <button type="submit" class="btn-primary">Save</button>
            <button type="button" class="btn-secondary" @onclick="CancelAsync">Cancel</button>
        </div>
    </fieldset>
    </EditForm>

    @if (!IsNewTaskList && _canShare)
    {
        <h2>Sharing</h2>
        @if (_shareableContacts.Count == 0)
        {
            <p>No contacts. A contact will appear here once you start a chat with someone.</p>
        }
        else
        {
            <div class="field-row">
                <select id="shareContactSelect" @bind="_selectedContactUserId">
                    <option value="">-- select a contact --</option>
                    @foreach (var contact in _shareableContacts)
                    {
                        <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                    }
                </select>
                <select id="shareAccessLevelSelect" @bind="_selectedAccessLevel">
                    <option value="ReadOnly">Read-only</option>
                    <option value="Share">Can share</option>
                    @if (_canGrantCanEdit)
                    {
                        <option value="CanEdit">Can edit</option>
                    }
                </select>
                <button type="button" id="shareTaskListButton" class="btn-primary" disabled="@_isSharing" @onclick="ShareAsync">Share</button>
            </div>
        }
        @if (_shareErrorMessage is not null)
        {
            <p class="error">@_shareErrorMessage</p>
        }
        @if (_shareInfoMessage is not null)
        {
            <p class="info">@_shareInfoMessage</p>
        }
    }
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewTaskList => Id is null;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSharing;
    private TaskListFormModel _formModel = new();
    private IReadOnlyList<TaskDto> _linkableTaskLists = [];
    private bool _isShared;
    private bool _isSharedReadOnly;
    private bool _canShare;
    private bool _canGrantCanEdit;
    private string _accessLevel = "ReadOnly";
    private Guid? _originalOwnerUserId;
    private string? _sharedByUserName;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private string? _shareErrorMessage;
    private string? _shareInfoMessage;
    private string? _saveErrorMessage;
    private Guid _ownUserId;

    /// <summary>Mirrors NoteEditor's field of the same name - see its comment.</summary>
    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private IReadOnlyList<ContactDto> _shareableContacts
        => _originalOwnerUserId is { } originalOwnerUserId
            ? _contacts.Where(contact => contact.UserId != originalOwnerUserId).ToList()
            : _contacts;

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private string SharedAccessDescription => _accessLevel switch
    {
        "CanEdit" => "you can edit it",
        "Share" => "you can share it further, but not edit it",
        _ => "read-only"
    };

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _ownUserId = Guid.Parse(authenticationState.User.FindFirst("sub")!.Value);

        try
        {
            // Populates the "link to another list" dropdown - excludes the list being edited itself, since
            // an item can't link to the list it belongs to (see TaskListLinkValidator on the API side).
            var allTaskLists = await TasksApiClient.GetTaskListsAsync();
            _linkableTaskLists = Id is { } currentTaskListId
                ? allTaskLists.Where(taskList => taskList.Id != currentTaskListId).ToList()
                : allTaskLists;

            if (Id is { } taskListId)
            {
                Logger.LogInformation("Task list editor opened for task list {TaskListId}", taskListId);
                var taskList = await TasksApiClient.GetTaskListByIdAsync(taskListId);
                if (taskList is not null)
                {
                    _formModel = new TaskListFormModel
                    {
                        Title = taskList.Title,
                        Items = taskList.Items
                            .Select(item => new TaskItemFormModel
                            {
                                Description = item.Description,
                                DueDate = item.DueDateUtc is { } dueDateUtc ? DateOnly.FromDateTime(dueDateUtc.LocalDateTime) : null,
                                DueTime = item.DueDateUtc is { } dueTimeUtc ? TimeOnly.FromDateTime(dueTimeUtc.LocalDateTime) : null,
                                IsCompleted = item.IsCompleted,
                                LinkedTaskListId = item.LinkedTaskListId?.ToString() ?? string.Empty,
                                OverdueNotificationChannel = item.OverdueNotificationChannel,
                                RemindDaily = item.RemindDaily,
                                DailyReminderNotificationChannel = item.DailyReminderNotificationChannel,
                                DailyReminderTimeOfDay = item.DailyReminderTimeOfDay
                            })
                            .ToList()
                    };
                    _isShared = taskList.IsShared;
                    _isSharedReadOnly = taskList.IsShared && taskList.AccessLevel != "CanEdit";
                    _canShare = !taskList.IsShared || taskList.AccessLevel is "CanEdit" or "Share";
                    _canGrantCanEdit = !taskList.IsShared || taskList.AccessLevel == "CanEdit";
                    _accessLevel = taskList.AccessLevel;
                    _originalOwnerUserId = taskList.OriginalOwnerUserId;
                    _sharedByUserName = taskList.SharedByUserName;

                    if (!_isSharedReadOnly)
                    {
                        await AcquireLockAsync(taskListId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(taskListId);
                        }
                    }
                }

                _contacts = await ChatApiClient.GetContactsAsync();
            }
            else
            {
                Logger.LogInformation("Task list editor opened for a new task list");
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }

        _isLoading = false;
    }

    private void AddItem()
    {
        _formModel.Items.Add(new TaskItemFormModel());
    }

    private void RemoveItem(TaskItemFormModel item)
    {
        _formModel.Items.Remove(item);
    }

    private async Task SaveAsync()
    {
        Logger.LogInformation(
            "User clicked 'Save' ({Mode}, TaskListId={TaskListId})", IsNewTaskList ? "create" : "update", Id);
        _saveErrorMessage = null;

        var items = _formModel.Items
            .Select(item => new TaskItemRequest(
                item.Description,
                ToDueDateUtc(item),
                item.IsCompleted,
                ToLinkedTaskListId(item),
                item.OverdueNotificationChannel,
                item.RemindDaily,
                item.DailyReminderNotificationChannel,
                item.DailyReminderTimeOfDay))
            .ToList();

        // Blocks the button for the duration of the save (see the button above), so a second click or a
        // double Enter-press can't fire this again while the first request is still in flight and create
        // a duplicate task list.
        _isSaving = true;
        try
        {
            if (IsNewTaskList)
            {
                var newTaskListId = await TasksApiClient.CreateTaskListAsync(new CreateTaskRequest(_formModel.Title, items));
                Logger.LogInformation("Task list {TaskListId} created", newTaskListId);
            }
            else
            {
                var outcome = await TasksApiClient.UpdateTaskListAsync(Id!.Value, new UpdateTaskRequest(_formModel.Title, items));
                if (outcome.Kind == EditOutcomeKind.Locked)
                {
                    _lockedByUserName = outcome.LockedByUserName;
                    StopLockHeartbeat();
                    _saveErrorMessage = $"{outcome.LockedByUserName} is currently editing this task list - try again in a moment.";
                    return;
                }

                if (outcome.Kind == EditOutcomeKind.NotFound)
                {
                    _saveErrorMessage = "Failed to save the task list. Try again.";
                    return;
                }

                Logger.LogInformation("Task list {TaskListId} updated", Id);
                await ReleaseLockAsync(Id.Value);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to {Mode} task list {TaskListId}", IsNewTaskList ? "create" : "update", Id);
            _saveErrorMessage = "Failed to save the task list. Try again.";
            return;
        }
        finally
        {
            _isSaving = false;
        }

        NavigationManager.NavigateTo("/tasks");
    }

    private async Task CancelAsync()
    {
        Logger.LogInformation("User clicked 'Cancel'");
        if (Id is { } taskListId)
        {
            await ReleaseLockAsync(taskListId);
        }

        NavigationManager.NavigateTo("/tasks");
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task AcquireLockAsync(Guid taskListId)
    {
        try
        {
            var outcome = await TasksApiClient.AcquireTaskListLockAsync(taskListId);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task ReleaseLockAsync(Guid taskListId)
    {
        StopLockHeartbeat();
        if (_isSharedReadOnly)
        {
            return;
        }

        try
        {
            await TasksApiClient.ReleaseTaskListLockAsync(taskListId);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat(Guid taskListId)
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(taskListId, _lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(Guid taskListId, CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync(taskListId);
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (Id is { } taskListId)
        {
            await ReleaseLockAsync(taskListId);
        }
        else
        {
            StopLockHeartbeat();
        }
    }

    /// <summary>
    /// Shares the already-saved task list with the selected contact and notifies them with an encrypted
    /// chat message carrying an "Accept" action (see TaskListShareMessagePayload) - mirrors
    /// NoteEditor.ShareAsync.
    /// </summary>
    private async Task ShareAsync()
    {
        if (!Guid.TryParse(_selectedContactUserId, out var recipientUserId) || Id is not { } taskListId)
        {
            return;
        }

        _shareErrorMessage = null;
        _shareInfoMessage = null;
        _isSharing = true;
        try
        {
            var result = await TasksApiClient.ShareTaskListAsync(taskListId, recipientUserId, _selectedAccessLevel);
            if (result is null)
            {
                _shareErrorMessage = "Failed to share the task list.";
                return;
            }

            var payloadJson = JsonSerializer.Serialize(new TaskListShareMessagePayload(result.ShareId, _formModel.Title));
            await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson);
            _shareInfoMessage = result.AlreadyShared ? "Already shared with that contact - sent a reminder." : null;
            _selectedContactUserId = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to share task list {TaskListId} with user {RecipientUserId}", taskListId, recipientUserId);
            _shareErrorMessage = "Failed to share the task list.";
        }
        finally
        {
            _isSharing = false;
        }
    }

    /// <summary>
    /// Combines the separately-edited date and time-of-day into the single timestamp the API
    /// expects, defaulting to midnight when a date was picked without a specific time.
    /// </summary>
    private static DateTimeOffset? ToDueDateUtc(TaskItemFormModel item)
        => item.DueDate is { } dueDate
            ? new DateTimeOffset(dueDate.ToDateTime(item.DueTime ?? TimeOnly.MinValue, DateTimeKind.Local)).ToUniversalTime()
            : null;

    private static Guid? ToLinkedTaskListId(TaskItemFormModel item)
        => string.IsNullOrEmpty(item.LinkedTaskListId) ? null : Guid.Parse(item.LinkedTaskListId);

    private sealed class TaskListFormModel
    {
        public string Title { get; set; } = string.Empty;
        public List<TaskItemFormModel> Items { get; set; } = [];
    }

    private sealed class TaskItemFormModel
    {
        public string Description { get; set; } = string.Empty;
        public DateOnly? DueDate { get; set; }
        public TimeOnly? DueTime { get; set; }
        public bool IsCompleted { get; set; }
        public string LinkedTaskListId { get; set; } = string.Empty;
        public string OverdueNotificationChannel { get; set; } = "Push";
        public bool RemindDaily { get; set; }
        public string DailyReminderNotificationChannel { get; set; } = "Push";
        public TimeOnly DailyReminderTimeOfDay { get; set; }
    }
}
