@page "/tasks/new"
@* The deep level has to be asked for by name. "/tasks/{id}" is the checklist - see TaskListChecklist,
   and see Tasks.razor's card for the two ways in. *@
@page "/tasks/{Id:guid}/edit"
@* An entry's own address, so opening one to change it is a link like every other object's rung 4 -
   see TaskItemSummary and TaskListChecklist.GoToEditItem, the two places that land here. Still the
   list's own form under it: an entry is not something this app edits apart from the list it is on,
   only something it can now be asked to open already unfolded. *@
@page "/tasks/{Id:guid}/items/{ItemToOpen:guid}/edit"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Inventories
@using Orbit.Contracts.Notifications
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Core.Tasks
@using Orbit.Core.Suggestions
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject InventoryApiClient InventoryApiClient
@inject ChatApiClient ChatApiClient
@inject CalendarApiClient CalendarApiClient
@inject NotificationsApiClient NotificationsApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<TaskEditor> Logger
@inject Translations T
@inject ChosenPlace ChosenPlace

<PageTitle>@(IsNewTaskList ? T["New task list"] : T["Edit task list"])</PageTitle>

@* Every category this account already uses, offered to each entry's box - one list for the page rather
   than one per entry, which would be the same names repeated as many times as the list is long. *@
<datalist id="taskItemCategories">
    @foreach (var category in _knownCategories)
    {
        <option value="@category"></option>
    }
</datalist>

@* Two panels: the form on the left, which scrolls, and the panel on the right, which does not - see
   EditorRail. On a narrow screen the right one becomes a bar along the foot of the window. *@
<div class="editor-page">
<div class="editor-page-body">

<PageHeader>
    <Title>@(IsNewTaskList ? T["New task list"] : T["Edit task list"])</Title>
</PageHeader>

@if (_inventoryMessage is not null)
{
    <p class="info">@_inventoryMessage</p>
}

@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else
{
    @if (_isShared)
    {
        <p class="shared-task-list-banner">@T["This task list was shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
        @if (_access.CanAskToEdit && _originalOwnerUserId is { } ownerUserId)
        {
            <RequestEditAccessButton ItemType="TaskList" ItemId="Id!.Value" ItemTitle="_formModel.Title"
                                     OwnerUserId="ownerUserId" OwnUserId="_ownUserId"
                                     OwnerDisplayName="@(_sharedByUserName ?? "them")" />
        }
    }

    @* Submitting this form adds a row rather than saving it. Enter is what somebody writing a list
       presses between items, and it used to save the list and leave the page instead - so the form's
       default button is "Add item", and Save is a click of its own. *@
    <EditForm Model="_formModel" OnValidSubmit="AddItem" class="editor-form">
    <fieldset disabled="@(_isSharedReadOnly || _lockedByUserName is not null || _isSaving)">
        <div class="field">
            @* Typed rather than committed on leaving the field, so the suggestions underneath keep up
               with what is being written. *@
            <TitledDescription Title="@_formModel.Title" TitleChanged="value => _formModel.Title = value"
                               Description="@_formModel.Description"
                               DescriptionChanged="value => _formModel.Description = value"
                               TitleLabel="@(T["Title"])"
                               IsReadOnly="@(_isSharedReadOnly || _lockedByUserName is not null)">
                <Suggestions>
                    <NameSuggestions Kind="NameSuggestionKind.TaskListTitle" Value="_formModel.Title"
                                     OnChosen="chosen => _formModel.Title = chosen" />
                </Suggestions>
            </TitledDescription>
        </div>

        <h2>@T["Items"]</h2>
        @foreach (var item in _formModel.Items)
        {
            <div class="editor-item @(_itemOrder.IsDragging(item) ? "dragging" : "")" @key="item"
                 @ondragover:preventDefault="true" @ondrop="() => DropItemOn(item)">
                @* One line per item: what it says, when it's due, whether it's done. Everything else is
                   a click away, so a list of any length still fits on a screen. *@
                <div class="editor-item-summary">
                @* Only the handle is draggable: a row full of text boxes would otherwise start a drag
                   whenever somebody selected what they had typed. *@
                <ReorderControls OnDragStart="() => _itemOrder.Start(item)" OnDragEnd="_itemOrder.Finish"
                                 OnMoveUp="() => MoveItem(item, -1)" OnMoveDown="() => MoveItem(item, 1)"
                                 CanMoveUp="CanMoveItem(item, -1)" CanMoveDown="CanMoveItem(item, 1)" />
                    @if (!item.IsALinkToOtherLists)
                    {
                        <InputCheckbox @bind-Value="item.IsCompleted" title="@(T["Completed"])" />
                    }
                    else
                    {
                        <input type="checkbox" checked="@item.IsCompleted" disabled
                               title="@(T["Completed - follows the linked list, can't be set by hand"])" />
                    }
                    @* Reassigned on every row, so it holds the last one by the time the loop ends - which
                       is the row Add item just appended, and the one the cursor belongs in. *@
                    @* A single-line box, like the name it is a sibling of on InventoryEditor's own row
                       (both share .editor-item-main): an entry is a name, not a paragraph, and a text
                       area let somebody paste one in with line breaks still in it. type="text" also
                       makes Enter here do what Enter already does everywhere else in this form - submit
                       it, which is "Add item" (see the EditForm above) - so typing an entry and pressing
                       Enter chains straight into the next blank row, which is the whole point of
                       _lastItemDescription's auto-focus below. *@
                    <input type="text" class="editor-item-main" @ref="_lastItemDescription"
                           placeholder="@(T["Item description"])" value="@item.Description"
                           @oninput="args => item.Description = args.Value?.ToString() ?? string.Empty" />
                    <NameSuggestions Kind="NameSuggestionKind.TaskItemDescription" Value="item.Description"
                                     OnChosen="chosen => item.Description = chosen" />
                    <span class="editor-item-aside">
                        @* What the row reports rather than what it sets: when this is due, if anything,
                           and what kind of entry it is. Everything editable now waits behind the toggle,
                           so a list of thirty items is thirty readable lines instead of a wall of boxes. *@
                        @if (item.Kind == nameof(TaskItemKind.Checklist) && WhenItIsDue(item) is { } due)
                        {
                            <span class="row-meta">@due</span>
                        }
                        @if (item.Kind != nameof(TaskItemKind.Checklist))
                        {
                            <span class="card-badge">@DescribeKind(item.Kind)</span>
                        }
                        <button type="button" class="editor-item-toggle @(IsExpanded(item) ? "open" : "")"
                                title="@(IsExpanded(item) ? T["Hide this item's other settings"] : T["Show this item's other settings"])"
                                aria-expanded="@(IsExpanded(item) ? "true" : "false")"
                                @onclick="() => ToggleExpanded(item)">
                            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
                        </button>
                    </span>
                </div>

                @if (IsExpanded(item))
                {
                    <div class="editor-item-details">
                        @* Two fields every entry has, whatever it is: what it is, and where it could go
                           instead. Everything after them depends on the type - see TaskItemKind. *@
                        <label>@T["Type"]<select @bind="item.Kind">
                                <option value="@nameof(TaskItemKind.Checklist)">@T["Checklist"]</option>
                                <option value="@nameof(TaskItemKind.Calendar)">@T["Calendar"]</option>
                                <option value="@nameof(TaskItemKind.Inventory)">@T["Inventory"]</option>
                            </select>
                        </label>
                        @* What the entry is about, whatever kind it is - a shelf item's category box,
                           holding as many as apply rather than making somebody pick the truest one.
                           The list under it is every category already in use on this account, so the
                           second entry about the car is filed under the same word as the first. *@
                        <label>@T["Categories"]<input list="taskItemCategories" class="form-control"
                                                      placeholder="@(T["Separate them with commas"])"
                                                      aria-label="@(T["Categories"])"
                                                      value="@item.CategoriesText"
                                                      @onchange="changeArgs => item.CategoriesText = changeArgs.Value?.ToString() ?? string.Empty" />
                        </label>
                        @* A day to be done by is a checklist entry's question and nobody else's: an
                           appointment already says when it is, in the event's own start and end below,
                           and a restock errand is about an amount rather than a date. Asking all three
                           for it left two answers about when a Calendar entry happens. *@
                        @if (item.Kind == nameof(TaskItemKind.Checklist))
                        {
                            <label>@T["Due date"]<DateField @bind-Value="item.DueDate" AriaLabel="@(T["Due date"])" />
                            </label>
                            <label>@T["Due time"]<TimeField @bind-Value="item.DueTime" AriaLabel="@(T["Due time"])" />
                            </label>
                        }
                        @* Offered for every saved entry, including one this account has nowhere to move -
                           the control saying so is an answer, where leaving it out looked like a setting
                           that had gone missing. *@
                        @if (item.Id is { } persistedItemId)
                        {
                            var moveTargets = MoveTargetsFor(item);
                            <label>@T["Move to list"]<select @onchange="@(changeArgs => MoveItemAsync(item, persistedItemId, changeArgs.Value))"
                                                             disabled="@(_isMovingItem || moveTargets.Count == 0)">
                                    <option value="">@(moveTargets.Count == 0 ? T["No other list yet"] : T["Move to…"])</option>
                                    @foreach (var targetTaskList in moveTargets)
                                    {
                                        <option value="@targetTaskList.Id">@Written(targetTaskList.Title)</option>
                                    }
                                </select>
                            </label>
                        }
                        @* A Calendar entry is an appointment rather than a pointer at one. Its fields are
                           the event's own, and saving the list is what makes the event - nothing has to
                           be linked by hand. See SaveTheCalendarAsync. *@
                        @if (item.Kind == nameof(TaskItemKind.Calendar))
                        {
                            @* The event form itself, the same control the calendar's own editor uses -
                               see EventFields.razor. The entry's own words are the event's title, so
                               there is no title box here. *@
                            <span class="field-break"></span>
                            <EventFields Model="item.Event" NotificationSettings="_notificationSettings"
                                         OnMapRequested="() => OpenTheMapFor(item)"
                                         IdPrefix="@($"item{_formModel.Items.IndexOf(item)}")"
                                         CanInviteGuests="true" Contacts="_contacts"
                                         CanGrantEditOnly="true" CanGrantCanEdit="true"
                                         GuestDisplayName="GuestName"
                                         GuestAccessLabel="userId => GuestAccessLabelFor(item, userId)"
                                         OnGuestAdded="invitation => InviteToTheEvent(item, invitation)"
                                         OnGuestRemoved="userId => UninviteFromTheEvent(item, userId)" />
                            <span class="field-break"></span>

                            @if (!string.IsNullOrEmpty(item.LinkedCalendarEventId))
                            {
                                <span class="field-break"></span>
                                @* The way out of the refusal below: an entry can stop being an event
                                   without the event being destroyed. Whoever made it decides what
                                   happens to it, in the calendar, where they can see it. The sentence
                                   goes under the button rather than beside it, so the two read in the
                                   order they are meant to: what this does, then what it means. *@
                                <div class="field-with-note">
                                    <button type="button" class="btn-secondary" @onclick="() => DetachFromTheEvent(item)">@T["Detach from the event"]</button>
                                    <small>@T["This entry has an event in the calendar. Saving keeps the two in step."]</small>
                                </div>
                            }
                        }
                        @* A restock errand edits the shelf it is about, right here. That is the point of
                           giving these entries a kind and a link: the row already knows which product it
                           means, so correcting the amount should not mean opening the inventory in
                           another tab and finding it again. Saved back with the list - see SaveAsync. *@
                        @if (item.Kind == nameof(TaskItemKind.Inventory))
                        {
                            @* An entry of this kind names something the work needs, and naming it is the
                               whole of it: the shelf is built from these names rather than picked from an
                               existing one - see GenerateInventoryFromTaskListCommandHandler, which makes
                               one row per distinct thing the list calls for.

                               A picker for an existing product used to sit here. It had the relationship
                               backwards: a list of work describes what it needs, and the inventory comes
                               from it, not the other way round. *@
                            @if (ShelfFieldsFor(item) is { } product)
                            {
                                @* Two cases, one form. A restock list's errand already stands for a
                                   product on a shelf, and correcting it here saves it there. An entry
                                   somebody writes on a list that is measured against a storage
                                   describes a product to put on it - the entry's own words are its
                                   name, so the form asks everything except that. Both save with the
                                   list; see SaveTheShelfAsync. *@
                                <span class="field-break"></span>
                                <InventoryFields Model="product.Product" NotificationSettings="_notificationSettings"
                                                 ShowsName="@(product.Product.Id is not null)" ShowsAmounts="true" />
                                <span class="field-break"></span>
                                <small>
                                    @(product.Product.Id is null
                                        ? T.Format("Goes on the shelf in {0} when this list is saved, named after this entry.", product.InventoryName)
                                        : T.Format("On the shelf in {0}. Saving this list saves the change there too.", product.InventoryName))
                                </small>
                            }
                            else
                            {
                                <span class="field-break"></span>
                                @* Only for a list with no storage behind it: there is nothing to put a
                                   product on yet, and this is where one comes from. Says the rule as
                                   well as the fact - nobody could guess either half of it from a form
                                   with nothing on it. *@
                                <small>@T["Naming it is the whole of it: \"Generate inventory\" in the menu above makes one product per distinct name, counted in pieces, and the same name twice asks for two of it."]</small>
                            }
                        }
                        else if (item.Kind == nameof(TaskItemKind.Checklist))
                        {
                            @* An entry can stand for several lists - "the flat is ready" is the kitchen
                               and the bathroom and the hall. Written as one step rather than three
                               entries saying the same thing, and done only when all of them are. *@
                            <span class="field-break"></span>
                            <label>@T["Stands for these lists"]
                                <select value="" @onchange="args => LinkToTheList(item, args.Value)"
                                        aria-label="@(T["Stands for these lists"])">
                                    <option value="">@(item.IsALinkToOtherLists ? T["Add another…"] : T["None"])</option>
                                    @foreach (var linkableTaskList in LinkableListsFor(item))
                                    {
                                        <option value="@linkableTaskList.Id">@Written(linkableTaskList.Title)</option>
                                    }
                                </select>
                            </label>
                            @if (item.IsALinkToOtherLists)
                            {
                                <span class="field-break"></span>
                                <ul class="linked-list-chips">
                                    @foreach (var linkedId in item.LinkedTaskListIds)
                                    {
                                        <li>
                                            <span>@Written(TitleOfTaskList(linkedId))</span>
                                            <button type="button" class="icon-btn" title="@(T["Remove"])"
                                                    aria-label="@(T["Remove"])"
                                                    @onclick="() => UnlinkFromTheList(item, linkedId)">✕</button>
                                        </li>
                                    }
                                </ul>
                            }
                            <label>@T["Overdue notification"]<select @bind="item.OverdueNotificationChannel">
                                    @foreach (var option in NotificationChannelOption.All)
                                    {
                                        <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <InputCheckbox @bind-Value="item.RemindDaily" />@T["Remind daily"]</label>
                            @if (item.RemindDaily)
                            {
                                <label>@T["Daily reminder channel"]<select @bind="item.DailyReminderNotificationChannel">
                                        @foreach (var option in NotificationChannelOption.All)
                                        {
                                            <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                                        }
                                    </select>
                                </label>
                                @* Required, not optional: a daily reminder with no hour has nothing to
                                   arrive at, and the scheduler would send it at midnight - see
                                   ValidateItems, which refuses the save rather than picking an hour
                                   nobody asked for. *@
                                <label>@T["Daily reminder time"]<TimeField @bind-Value="item.DailyReminderTimeOfDay" AriaLabel="@(T["Daily reminder time"])" />
                                </label>
                            }
                            @if (item.IsALinkToOtherLists)
                            {
                                <span class="field-break"></span>
                                <small>@T["Completion follows the linked lists, so it can't be ticked by hand."]</small>
                            }
                        }
                        @if (_moveErrorMessage is not null && item.Id is { } movedItemId && _moveErrorMessageForItemId == movedItemId)
                        {
                            <span class="field-break"></span>
                            <p class="error">@_moveErrorMessage</p>
                        }
                        @* Last, and behind the toggle with everything else: taking an entry off the list
                           is not something to have one click away from the box somebody is typing in. *@
                        <span class="field-break"></span>
                        <button type="button" class="btn-secondary" @onclick="() => RemoveItem(item)">@T["Remove"]</button>
                    </div>
                }
            </div>
        }
        <div>
            @* The form's only submit button, and so the one Enter presses - see the EditForm above. *@
            <button type="submit" class="btn-secondary">@T["Add item"]</button>
        </div>

    </fieldset>
    </EditForm>

    @* What the list is rather than what is on it - who may read it, how it is shown, how much it
       matters, and how it is reached. Together under the items instead of above them: a page opened
       to write a list on began with three questions about a list that did not exist yet. *@
    <h2>@T["About this list"]</h2>
    <div class="task-editor-settings">
        @* Only the owner may turn this on: a list reached through a share belongs to someone else,
           and "private" means private to its creator. *@
        @if (!_isShared)
        {
            <div class="field">
                <label>
                    <InputCheckbox @bind-Value="_formModel.IsPrivate" />@T["Private"]</label>
                <small>
                    @T["Encrypted in this browser, so Orbit can't read it. It can't be shared, gets no reminders, and losing your password loses it."]
                </small>
            </div>
        }

        <div class="field">
            <label>
                <InputCheckbox @bind-Value="_formModel.IsGroup" />@T["Group View"]</label>
            <small>
                @T["A group list's checklist also shows every list it gathers, so the whole group fits on one screen."]
            </small>
        </div>

        @* Which storage this list is measured against. Here rather than only on the checklist, and for
           any list rather than only a group: an entry of the inventory kind describes a product, and
           the only way to say which shelf it goes on is to say which shelf this list is about. A list
           that has never been saved has nothing to link yet - the same rule the menu above follows. *@
        @if (!IsNewTaskList)
        {
            <div class="field">
                <label for="taskListInventorySelect">@T["Storage this list is measured against"]</label>
                <select id="taskListInventorySelect" value="@(_linkedInventoryId?.ToString() ?? string.Empty)"
                        disabled="@_isWorkingOnInventory" @onchange="OnInventoryChangedAsync">
                    <option value="">@T["Not measured against a inventory"]</option>
                    @* Every storage, including the ones other lists already measure: a store serves as
                       many jobs as it holds things for. What that costs is said under the picker rather
                       than hidden by leaving them out - the shelf is split between the lists asking for
                       it, and each is told its own share. *@
                    @foreach (var inventory in _inventories)
                    {
                        <option value="@inventory.Id">
                            @(_inventoriesMeasuredByAnotherList.Contains(inventory.Id)
                                ? T.Format("{0} (shared with another list)", inventory.Name)
                                : inventory.Name)
                        </option>
                    }
                </select>
                <small>@T["An inventory entry then describes a product to put on that shelf."]</small>
            </div>
        }

        <div class="field">
            <label for="taskListPrioritySelect">@T["Priority"]</label>
            <InputSelect id="taskListPrioritySelect" @bind-Value="_formModel.Priority">
                <option value="Low">@T["Low"]</option>
                <option value="Normal">@T["Normal"]</option>
                <option value="High">@T["High"]</option>
            </InputSelect>
            <small>@T["Sorts this list against the others. Its progress is worked out from its items."]</small>
        </div>

    </div>

    @if (!IsNewTaskList && !_formModel.IsPrivate && Id is { } taskListId)
    {
        <h2>@T["Link"]</h2>
        <ShareLinkButton ItemType="TaskList" ItemId="taskListId" />
    }

    @if (!IsNewTaskList && _canShare && !_formModel.IsPrivate)
    {
        <h2>@T["Sharing"]</h2>
        @if (_shareableContacts.Count == 0)
        {
            <p>@T["No contacts. A contact will appear here once you start a chat with someone."]</p>
        }
        else
        {
            <div class="field-row">
                <select id="shareContactSelect" @bind="_selectedContactUserId">
                    <option value="">@T["-- select a contact --"]</option>
                    @foreach (var contact in _shareableContacts)
                    {
                        <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                    }
                </select>
                <select id="shareAccessLevelSelect" @bind="_selectedAccessLevel">
                    <option value="ReadOnly">@T["Read-only"]</option>
                    <option value="Share">@T["Can share"]</option>
                    @if (_canGrantEditOnly)
                    {
                        <option value="EditOnly">@T["Can edit, but not share editing"]</option>
                    }
                    @if (_canGrantCanEdit)
                    {
                        <option value="CanEdit">@T["Can edit"]</option>
                    }
                </select>
                <button type="button" id="shareTaskListButton" class="btn-primary" disabled="@_isSharing" @onclick="ShareAsync">@T["Share"]</button>
            </div>
        }
        @if (_shareErrorMessage is not null)
        {
            <p class="error">@_shareErrorMessage</p>
        }
        @if (_shareInfoMessage is not null)
        {
            <p class="info">@_shareInfoMessage</p>
        }
    }
}

</div>
@if (!_isLoading)
{
    <EditorRail OnSave="SaveAsync" OnCancel="CancelAsync"
                SaveDisabled="@(_isSharedReadOnly || _lockedByUserName is not null || _isSaving)">
        @* Beside the button that failed, rather than at the end of a form that is taller than the
           screen: a save that did not happen and a list somebody else is holding are both answers to
           "why has Save done nothing", and an answer nobody scrolls to is not one. *@
        <Extras>
            @if (_lockedByUserName is not null)
            {
                <p class="lock-banner">
                    @T.Format("{0} is currently editing this task list - you can't edit it right now.", _lockedByUserName)
                </p>
            }
            @if (_saveErrorMessage is not null)
            {
                <p class="error">@_saveErrorMessage</p>
            }
        </Extras>
        <ChildContent>
            @* Only for a list that exists: nothing in the menu can act on one that has never been saved. *@
            @if (!IsNewTaskList && Id is { } menuTaskListId)
            {
                <OverflowMenu>
                    @* A list already measured against a storage has nowhere to put a second one: this
                       would build it and quietly move the list onto it, leaving the first behind with
                       nothing pointing at it. What such a list wants instead is a product on the shelf
                       it already has - which is what an inventory entry offers there. *@
                    <button type="button" class="avatar-dropdown-item"
                            disabled="@(_isWorkingOnInventory || _linkedInventoryId is not null)"
                            title="@(_linkedInventoryId is null ? null : T["This list already has a storage."])"
                            @onclick="() => GenerateInventoryAsync(menuTaskListId)">
                        @T["Generate inventory"]
                    </button>
                    @* Nothing to recalculate until there is an inventory to recalculate against. *@
                    <button type="button" class="avatar-dropdown-item"
                            disabled="@(_isWorkingOnInventory || _linkedInventoryId is null)"
                            @onclick="() => RecalculateAsync(menuTaskListId)">
                        @T["Recalculate against the inventory"]
                    </button>
                </OverflowMenu>
            }
        </ChildContent>
    </EditorRail>
}
</div>

@if (_itemBeingPlacedOnTheMap is { } itemOnTheMap)
{
    <LocationPickerOverlay Address="@itemOnTheMap.Location" OnPicked="UseThePickedPlace" OnCancelled="CloseTheMap" />
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewTaskList => Id is null;

    /// <summary>
    /// The inventory this list is measured against, if any, and what the last calculation said. The
    /// editor shows the answer in a line rather than a table - the checklist screen is where the detail
    /// belongs, and this is the screen for changing the list itself.
    /// </summary>
    private Guid? _linkedInventoryId;
    private bool _isWorkingOnInventory;
    private string? _inventoryMessage;

    private async Task GenerateInventoryAsync(Guid taskListId)
    {
        _isWorkingOnInventory = true;
        _inventoryMessage = null;
        Logger.LogInformation("User generated an inventory from task list {TaskListId}", taskListId);
        try
        {
            if (await TasksApiClient.GenerateInventoryAsync(taskListId) is not { } inventoryId)
            {
                return;
            }

            _linkedInventoryId = inventoryId;
            _inventoryMessage = T["Inventory generated from this list."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to generate an inventory from task list {TaskListId}", taskListId);
            _inventoryMessage = T["Couldn't generate an inventory from this list."];
        }
        finally
        {
            _isWorkingOnInventory = false;
        }
    }

    /// <summary>Runs the count again and says how it came out - the detail is on the checklist screen.</summary>
    private async Task RecalculateAsync(Guid taskListId)
    {
        _isWorkingOnInventory = true;
        _inventoryMessage = null;
        Logger.LogInformation("User recalculated the stock check for task list {TaskListId}", taskListId);
        try
        {
            var check = await TasksApiClient.GetStockCheckAsync(taskListId);
            _inventoryMessage = check is null
                ? T["This list isn't measured against an inventory."]
                : check.IsAchievable
                    ? T["Everything this list needs is on the shelf."]
                    : T.Format("{0} of what this needs is short.", check.Requirements.Count(requirement => requirement.Missing > 0));
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to recalculate the stock check for task list {TaskListId}", taskListId);
            _inventoryMessage = T["Couldn't recalculate against the inventory."];
        }
        finally
        {
            _isWorkingOnInventory = false;
        }
    }
