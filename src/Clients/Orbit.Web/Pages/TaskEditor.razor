    /// <summary>
    /// The events an entry can be tied to. Read once with the lists, since the dropdown offering them
    /// has to be filled before anybody opens an entry rather than after.
    /// </summary>
    private IReadOnlyList<CalendarEventDto> _linkableEvents = [];

    /// <summary>The entry whose place is being pointed at on the map, while one is - see LocationPickerOverlay.</summary>
    private TaskItemFormModel? _itemBeingPlacedOnTheMap;

    private void OpenTheMapFor(TaskItemFormModel item) => _itemBeingPlacedOnTheMap = item;

    /// <summary>
    /// The pin was confirmed. Its address fills the box when the box is empty, and is left out when
    /// somebody has written a name of their own there - "the back entrance" is the whole reason that
    /// box is typed into, and replacing it with a street every time a pin is confirmed is what made
    /// correcting it feel impossible. The place itself is set either way.
    /// </summary>
    private void UseThePickedPlace(PickedPlace place)
    {
        if (_itemBeingPlacedOnTheMap is { } item)
        {
            Logger.LogInformation("User set an entry's location from the map");

            // Always, whatever the box says. This is the half that was missing: the words are the
            // reader's to choose, but where the place is was decided by the pin, and keeping only the
            // words meant a confirmed pin reached the calendar as nothing at all.
            item.LocationLatitude = place.Latitude;
            item.LocationLongitude = place.Longitude;

            if (item.Location.Trim().Length == 0)
            {
                item.Location = place.Address;
            }
        }

        _itemBeingPlacedOnTheMap = null;
    }

    private void CloseTheMap() => _itemBeingPlacedOnTheMap = null;

    /// <summary>
    /// Where the event an entry is tied to happens, for the line that stands in for the location box.
    /// An event that has since been deleted, or has no location of its own, reads as unsaid rather than
