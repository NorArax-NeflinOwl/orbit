@page "/inventory/new"
@page "/inventory/{Id:guid}"
@attribute [Authorize]
@using Orbit.Contracts.Inventory
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject InventoryApiClient InventoryApiClient
@inject NavigationManager NavigationManager
@inject ILogger<InventoryEditor> Logger

<PageTitle>@(IsNewItem ? "New inventory item" : "Edit inventory item")</PageTitle>

<h1>@(IsNewItem ? "New inventory item" : "Edit inventory item")</h1>

@if (_isLoading)
{
    <p>Loading…</p>
}
else
{
    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="editor-form">
        <fieldset disabled="@_isSaving">
            <div class="field">
                <label>Name</label>
                <InputText @bind-Value="_formModel.Name" />
            </div>
            <div class="field">
                <label>Product type</label>
                <InputText @bind-Value="_formModel.ProductType" />
            </div>
            <div class="field">
                <label>Category</label>
                <InputText @bind-Value="_formModel.Category" />
            </div>
            <div class="field">
                <label>Quantity</label>
                <InputNumber TValue="decimal" @bind-Value="_formModel.Quantity" step="0.01" />
            </div>
            <div class="field">
                <label>Minimum quantity (optional)</label>
                <InputNumber TValue="decimal?" @bind-Value="_formModel.MinimumQuantity" step="0.01" />
            </div>
            <div class="field">
                <label>Expiry date (optional)</label>
                <InputDate @bind-Value="_formModel.ExpiryDate" />
            </div>
            <div class="field">
                <label>Expiry notification</label>
                <select @bind="_formModel.ExpiryNotificationChannel">
                    @foreach (var option in NotificationChannelOption.All)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
            </div>

            @if (_saveErrorMessage is not null)
            {
                <p class="error">@_saveErrorMessage</p>
            }
            <div class="form-actions">
                <button type="submit" class="btn-primary">Save</button>
                <button type="button" class="btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </fieldset>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewItem => Id is null;
    private bool _isLoading = true;
    private bool _isSaving;
    private InventoryItemFormModel _formModel = new();
    private string? _saveErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } itemId)
        {
            try
            {
                var item = await InventoryApiClient.GetInventoryItemByIdAsync(itemId);
                if (item is not null)
                {
                    _formModel = new InventoryItemFormModel
                    {
                        Name = item.Name,
                        ProductType = item.ProductType,
                        Category = item.Category,
                        Quantity = item.Quantity,
                        MinimumQuantity = item.MinimumQuantity,
                        ExpiryDate = item.ExpiryDate?.LocalDateTime,
                        ExpiryNotificationChannel = item.ExpiryNotificationChannel
                    };
                }
            }
            catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }
        }

        _isLoading = false;
    }

    private async Task SaveAsync()
    {
        _saveErrorMessage = null;
        _isSaving = true;
        try
        {
            if (IsNewItem)
            {
                await InventoryApiClient.CreateInventoryItemAsync(ToCreateRequest(_formModel));
            }
            else
            {
                var outcome = await InventoryApiClient.UpdateInventoryItemAsync(Id!.Value, ToUpdateRequest(_formModel));
                if (outcome.Kind == EditOutcomeKind.NotFound)
                {
                    _saveErrorMessage = "Failed to save the item. Try again.";
                    return;
                }
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to {Mode} inventory item {ItemId}", IsNewItem ? "create" : "update", Id);
            _saveErrorMessage = "Failed to save the item. Try again.";
            return;
        }
        finally
        {
            _isSaving = false;
        }

        NavigationManager.NavigateTo("/inventory");
    }

    private void Cancel() => NavigationManager.NavigateTo("/inventory");

    private static CreateInventoryItemRequest ToCreateRequest(InventoryItemFormModel model)
        => new(
            model.Name, model.ProductType, model.Category, model.Quantity, model.MinimumQuantity,
            ToExpiryDateUtc(model), model.ExpiryNotificationChannel);

    private static UpdateInventoryItemRequest ToUpdateRequest(InventoryItemFormModel model)
        => new(
            model.Name, model.ProductType, model.Category, model.Quantity, model.MinimumQuantity,
            ToExpiryDateUtc(model), model.ExpiryNotificationChannel);

    /// <summary>
    /// Npgsql only accepts a DateTimeOffset with Offset=0 for a "timestamp with time zone" column - a
    /// local offset (e.g. +02:00 for the browser's own time zone) throws on save. ToUniversalTime()
    /// converts the picked local midnight to its equivalent UTC instant rather than just re-labeling it,
    /// which is what the API expects everywhere else (see NoteEditor.razor's SaveAsync, etc.).
    /// </summary>
    private static DateTimeOffset? ToExpiryDateUtc(InventoryItemFormModel model)
        => model.ExpiryDate is { } expiryDate ? new DateTimeOffset(expiryDate, TimeZoneInfo.Local.GetUtcOffset(expiryDate)).ToUniversalTime() : null;

    private sealed class InventoryItemFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string ProductType { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal? MinimumQuantity { get; set; }
        public DateTime? ExpiryDate { get; set; }
        public string ExpiryNotificationChannel { get; set; } = "Push";
    }
}
