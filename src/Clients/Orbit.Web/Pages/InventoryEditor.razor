@* One click further in than the shelf itself, the way a task list's editor is - see
   InventorySummary.razor, which is what opening an inventory lands on. *@
@page "/inventory/{InventoryId:guid}/edit"
@page "/inventory/new"
@attribute [Authorize]
@implements IAsyncDisposable
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Inventories
@using Orbit.Contracts.Tasks
@using Orbit.Contracts.Notifications
@using Orbit.Core.Abstractions
@using Orbit.Core.Folders
@using Orbit.Core.Inventories
@using Orbit.Core.Suggestions
@using Orbit.Web.Services
@using Orbit.Core.Text
@inject FolderState Folders
@inject InventoryApiClient InventoryApiClient
@inject TasksApiClient TasksApiClient
@inject NotificationsApiClient NotificationsApiClient
@inject ChatApiClient ChatApiClient
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NameSuggestionsApiClient NameSuggestionsApiClient
@inject NavigationManager NavigationManager
@inject NavigationTrail NavigationTrail
@inject ILogger<InventoryEditor> Logger
@inject Translations T

<PageTitle>@PageHeading</PageTitle>

@if (_isLoading)
{
    <Loading />
}
else
{
@* Two panels: the form on the left, which scrolls, and the panel on the right, which does not - see
   EditorRail. On a narrow screen the right one becomes a bar along the foot of the window. *@
@* A sealed inventory is behind the account's PIN here as well as on the tab it is under - see
   BehindThePin, and TaskEditor, which carries the same wrapper for the same reason. *@
<BehindThePin Applies="_formModel.IsPrivate" OnGaveUp="LeaveTheSealedInventory">
<div class="editor-page">
<div class="editor-page-body">

    <PageHeader>
        <Title>@PageHeading</Title>
        <Description>@T["Everything in this inventory, edited together - a low item still raises a restock task."]</Description>
    </PageHeader>

    @if (_isShared)
    {
        <p class="shared-note-banner">@T["Shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.</p>
        @* Under the banner, as it is on a note's form, a task list's and an event's. The shelf was the
           one shared thing with no way to ask, although the owner's side has always known how to
           answer for one - the "_ =>" branch of Chat.razor's BuildEditAccessRequestNotice is this. *@
        @if (_access.CanAskToEdit && _originalOwnerUserId is { } ownerUserId)
        {
            <RequestEditAccessButton ItemType="Inventory" ItemId="InventoryId!.Value" ItemTitle="@_formModel.Name"
                                     OwnerUserId="ownerUserId" OwnUserId="_ownUserId"
                                     OwnerDisplayName="@(_sharedByUserName ?? "them")" />
        }
    }

    @* Submitting this form adds a row rather than saving it. Enter is what somebody filling a shelf
       presses between items, and it used to save the inventory and leave the page instead - so the
       form's default button is "Add item", and Save is a click of its own. *@
    <EditForm Model="_formModel" OnValidSubmit="AddItem" class="editor-form">
        <fieldset disabled="@(_isReadOnly || _lockedByUserName is not null || _isSaving)">
            <div class="field">
                @* Typed rather than committed on leaving the field: the suggestions underneath have to
                   keep up with what is being written. *@
                <TitledDescription Title="@_formModel.Name" TitleChanged="value => _formModel.Name = value"
                                   Description="@_formModel.Description"
                                   DescriptionChanged="value => _formModel.Description = value"
                                   TitleLabel="@(T["Name"])"
                                   IsReadOnly="@(_isReadOnly || _lockedByUserName is not null)">
                    <Suggestions>
                        <NameSuggestions Kind="NameSuggestionKind.InventoryName" Value="@_formModel.Name"
                                         OnChosen="chosen => _formModel.Name = chosen" />
                    </Suggestions>
                </TitledDescription>
            </div>

            @* Where it will be found. Only the owner files a shelf: one reached through a share sits in
               its owner's folder on their page, and this reader's tabs are their own. *@
            @if (!_isShared)
            {
                <FolderField Page="FolderPage.Inventories" Value="_folderId" ValueChanged="folderId => _folderId = folderId"
                             Hint="@(T["Without one it is in Public, or in Private when it is sealed."])" />
            }

            <h2 class="options-heading">@T["Items"]</h2>

            @* Narrows what is on screen, never what is saved: the whole list still goes back on Save,
               hidden rows included - see InventoryFormModel.ToRequest, which reads Items and not this. *@
            @if (_formModel.Items.Count > 0)
            {
                <div class="inventory-filters">
                    @* The two are picked from what is on the shelf, so neither is offered where nothing
                       is filed under it - a filter with one empty answer is a dead end. Searching by
                       name has no such condition: a name is typed, and every item has one. *@
                    @if (ProductTypesOnTheShelf.Count > 0)
                    {
                        <label>
                            @T["Product type"]
                            <select @bind="_filter.ProductType" aria-label="@(T["Product type"])">
                                <option value="">@T["Any type"]</option>
                                @foreach (var productType in ProductTypesOnTheShelf)
                                {
                                    <option value="@productType">@productType</option>
                                }
                            </select>
                        </label>
                    }
                    @if (CategoriesOnTheShelf.Count > 0)
                    {
                        <label>
                            @T["Category"]
                            <select @bind="_filter.Category" aria-label="@(T["Category"])">
                                <option value="">@T["Any category"]</option>
                                @foreach (var category in CategoriesOnTheShelf)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="inventory-filters-search">
                        @T["Search"]
                        @* Narrows as it is typed rather than on Enter: the list is already on screen, so
                           there is nothing to wait for. *@
                        <input type="search" @bind="_filter.Name" @bind:event="oninput"
                               placeholder="@(T["Item name"])" aria-label="@(T["Search items by name"])" />
                    </label>
                    @if (_filter.IsActive)
                    {
                        <button type="button" class="btn-secondary" @onclick="ClearFilters">@T["Show everything"]</button>
                    }
                </div>
            }

            @if (_formModel.Items.Count == 0)
            {
                <p>@T["No items yet."]</p>
            }
            else if (VisibleItems.Count == 0)
            {
                <p class="empty-hint empty-list">@T["Nothing here matches that. The rest of the inventory is still there - clear the filter to see it."]</p>
            }
            else
            {
                @if (_filter.IsActive)
                {
                    @* Said out loud so nobody saves an inventory thinking the rows they cannot see are gone. *@
                    <p class="empty-hint">@T.Format("Showing {0} of {1} items. Saving keeps all of them.", VisibleItems.Count, _formModel.Items.Count)</p>
                }
                @foreach (var item in VisibleItems)
                {
                    <div class="editor-item @(_itemOrder.IsDragging(item) ? "dragging" : "") @(Highlight is { } highlighted && item.Id == highlighted ? "highlighted" : "")" @key="item"
                         @ondragover:preventDefault="true" @ondrop="() => DropItemOn(item)">
                        @* Name and the two numbers that decide whether it needs restocking stay on the
                           row; everything else waits behind the toggle so a full inventory is readable. *@
                        <div class="editor-item-summary">
                            @* Only the handle is draggable: a row full of boxes would otherwise start a
                               drag whenever somebody selected what they had typed. *@
                            <ReorderControls OnDragStart="() => _itemOrder.Start(item)" OnDragEnd="_itemOrder.Finish"
                                             OnMoveUp="() => MoveItem(item, -1)" OnMoveDown="() => MoveItem(item, 1)"
                                             CanMoveUp="CanMoveItem(item, -1)" CanMoveDown="CanMoveItem(item, 1)" />
                            @* Reassigned on every row, so it holds the last one by the time the loop
                               ends - which is the row Add item just appended. *@
                            <InputText class="editor-item-main" @ref="_lastItemName"
                                       placeholder="@(T["Item name"])" @bind-Value="item.Name"
                                       @oninput="args => item.Name = args.Value?.ToString() ?? string.Empty" />
                            <NameSuggestions Kind="NameSuggestionKind.InventoryItemName" Value="@item.Name"
                                             OnChosen="chosen => item.Name = chosen" />
                            <span class="editor-item-aside">
                                @if (NeedsRestocking(item))
                                {
                                    <span class="item-warning" title="@(T["There is less of this than the minimum you set"])">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20"
                                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                             role="img" aria-label="@(T["Running low"])">
                                            <path d="M10 2.8 18.2 17H1.8L10 2.8Z" />
                                            <path d="M10 8v3.6" />
                                            <path d="M10 14.2h.01" />
                                        </svg>
                                    </span>
                                }
                                <label>
                                    @T["Amount"]<FieldHint>@T["How much of it there is"]</FieldHint>
                                    <InputNumber TValue="decimal" @bind-Value="item.Quantity" step="0.01" />
                                </label>
                                <label>
                                    @T["Min"]<FieldHint>@T["Restock once the amount drops below this"]</FieldHint>
                                    <InputNumber TValue="decimal?" @bind-Value="item.MinimumQuantity" step="0.01" />
                                    @* What the task lists ask for, which the minimum is never kept below - see
                                       InventoryItem.Usage. Said as a warning while the typed minimum is lower. *@
                                    @if (item.Usage > 0)
                                    {
                                        @* Which lists, not only how many of them: changing this number
                                           reaches them, and somebody deciding what to type here is
                                           deciding for those lists - see ShelfDemand. Said the moment
                                           the row is read rather than only when Save stops to ask. *@
                                        <FieldHint Warns="@((item.MinimumQuantity ?? 0) < item.Usage)">@(ListsAskingFor(item) is { Count: > 0 } asking
                                            ? T.Format("{0} ask for {1} of this, so it is never kept below that.", string.Join(", ", asking), item.Usage.ToString("0.##"))
                                            : T.Format("Your lists ask for {0} of this, so it is never kept below that.", item.Usage.ToString("0.##")))</FieldHint>
                                    }
                                </label>
                                @* The unit reads on the row it qualifies - "2" and "2 kg" are different
                                   amounts - but it is set behind the toggle with the rest of the fields,
                                   because choosing it is a thing done once and read every time. *@
                                <span class="editor-item-unit-label" title="@(T["What this is counted in"])">
                                    @T[InventoryUnitOption.For(item.Unit).ShortName]
                                </span>
                                <button type="button" class="editor-item-toggle @(IsExpanded(item) ? "open" : "")"
                                        title="@(IsExpanded(item) ? T["Hide this item's other settings"] : T["Show this item's other settings"])"
                                        aria-expanded="@(IsExpanded(item) ? "true" : "false")"
                                        @onclick="() => ToggleExpanded(item)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
                                </button>
                            </span>
                        </div>

                        @if (IsExpanded(item))
                        {
                            <div class="editor-item-details">
                                <InventoryFields Model="item" NotificationSettings="_notificationSettings"
                                                 KnownProductTypes="_knownProductTypes"
                                                 KnownCategories="_knownCategories" />
                                @* Taking a row off the shelf is not something to have one click away from
                                   the amount somebody came to correct. Behind the toggle, at the end,
                                   where it is found on purpose rather than by accident. *@
                                <span class="field-break"></span>
                                <button type="button" class="btn-secondary" @onclick="() => RemoveItem(item)">@T["Remove"]</button>
                            </div>
                        }
                    </div>
                }
            }

            @* The form's only submit button, and so the one Enter presses - see the EditForm above. *@
            <button type="submit" class="btn-secondary">@T["Add item"]</button>

        </fieldset>
    </EditForm>

    @if (!_formModel.IsPrivate)
    {
        <h2>@T["About this inventory"]</h2>
        <div class="inventory-editor-settings">
            <fieldset disabled="@(_isReadOnly || _lockedByUserName is not null || _isSaving)">
                @* Only the owner may turn this on: an inventory reached through a share belongs to someone
                   else, and "private" means private to its creator. *@
                @if (!_isShared)
                {
                    <div class="field">
                        <label>
                                <InputCheckbox @bind-Value="_formModel.IsPrivate" />@T["Private"]<FieldHint>@T["Encrypted in this browser, so Orbit can't read it. It can't be shared, raises no restock or expiry reminders, and losing your password loses it."]</FieldHint></label>
                    </div>
                }
            </fieldset>
        </div>
    }

    @* Both of these are about a shelf that already exists - what asks for it, and what it asks back -
       so neither means anything yet for one still being named. They appear the moment Save has made
       one of it: opening the new inventory's own edit page again offers both. *@
    @if (!IsNewInventory)
    {
    @* What this shelf gathers. A group is one entry on the list of inventories holding smaller ones
       inside it, each of which can go on answering to a different task list - which is the point of it:
       a kitchen made of a fridge, a freezer and a pantry is read as one thing and stocked as three.

       A member is not moved into the group. It keeps its own rows, its own restock list and its own tie
       to a list, and it stays on the list of inventories where it was - the group is a way of reading
       several at once. Taking one out again leaves it exactly as it was. *@
    <h2>@T["Inventories gathered here"]<FieldHint>@T["A group shelf holds smaller shelves. Each keeps its own items and its own tie to a list; this only decides what is read together."]</FieldHint></h2>
    @* Named, because this page now has two lists of ticks about two different ties and a test - or a
       stylesheet - reaching for "a check row on the inventory editor" would get whichever came first. *@
    <div class="card inventory-gathers-card">
        @if (_couldBeGathered.Count == 0)
        {
            <p class="empty-hint empty-list">@T["There are no other inventories to gather."]</p>
        }
        else
        {
            @foreach (var candidate in _couldBeGathered)
            {
                <CheckRow Title="@candidate.Name"
                          IsTicked="@_gathered.Contains(candidate.Id)"
                          IsDisabled="@(_isReadOnly || _isGathering)"
                          AriaLabel="@T.Format("Gather {0} into this inventory", candidate.Name)"
                          OnTicked="ticked => GatherAsync(candidate, ticked)">
                    <Trailing>
                        @* Which list it answers to, since that is the whole reason for keeping the
                           smaller shelves apart - see the heading above. *@
                        @if (ListMeasuredAgainst(candidate.Id) is { } answersTo)
                        {
                            <span class="row-meta row-meta-prose">@T.Format("answers to {0}", answersTo)</span>
                        }
                        @if (candidate.IsGroup)
                        {
                            <span class="card-badge">@T["Group"]</span>
                        }
                    </Trailing>
                </CheckRow>
            }
        }
        @if (_gatheringMessage is not null)
        {
            <p class="error">@_gatheringMessage</p>
        }
    </div>

    @* Which lists are measured against this shelf. The same tie a task list's own editor offers from
       its end - said from here as well because a store is opened as often as a list is, and somebody
       standing in the pantry is thinking about which jobs it serves rather than the other way round.

       Several lists may share it. What that costs is behind the heading's mark rather than discovered
       later: the shelf is split between everything asking for it, so a second list asking for the same
       flour leaves both of them short. *@
    <h2>@T["Lists measured against this inventory"]<FieldHint>@T["A shelf several lists ask for is split between them, so each is told its own share."]</FieldHint></h2>
    <div class="card inventory-measured-lists-card">
        @if (_taskLists.Count == 0)
        {
            <p class="empty-hint empty-list">@T["No task lists yet."]</p>
        }
        else
        {
            @foreach (var taskList in _taskLists)
            {
                @* A list reached because a group list above it is measured here. Ticked, because it is
                   asking this shelf for what its entries need - that is what gathering it means - but
                   not untickable on its own: the tie belongs to the list at the top of the tree, and
                   letting somebody clear one child would make a promise this page cannot keep. See
                   MeasuredThroughAParent. *@
                var throughParent = MeasuredThrough(taskList);
                <CheckRow Title="@taskList.Title"
                          IsTicked="@(taskList.LinkedInventoryId == InventoryId || throughParent is not null)"
                          IsDisabled="@(_isReadOnly || _isLinkingTaskLists || throughParent is not null)"
                          AriaLabel="@T.Format("Measure {0} against this inventory", taskList.Title)"
                          OnTicked="ticked => MeasureAsync(taskList, ticked)">
                    <Trailing>
                        @if (throughParent is { } gatheredBy)
                        {
                            <span class="row-meta">@T.Format("through {0}", gatheredBy)</span>
                        }
                        @* A list already measured against another store: ticking it here moves it, so
                           which store it would leave is named rather than left to be noticed after. *@
                        else if (taskList.LinkedInventoryId is { } elsewhere && elsewhere != InventoryId)
                        {
                            <span class="row-meta">@T.Format("now measured against {0}", NameOfInventory(elsewhere))</span>
                        }
                    </Trailing>
                </CheckRow>
            }
        }
        @if (_linkingMessage is not null)
        {
            <p class="error">@_linkingMessage</p>
        }
    </div>

    @* At the very bottom, because it is about the list this inventory keeps rather than about the shelf
       somebody came here to edit - see RestockListSettings. *@
    <h2>@T["Restock list"]</h2>
    <div class="card restock-settings-card">
        @* The switch the rest of the section hangs off. Everything below it is greyed out while it is
           off, rather than hidden: a reader deciding whether to turn it back on should be able to see
           what they would be turning on. Saved with the rest of the form - see SaveAsync. *@
        <label class="field-checkbox" for="restockEnabledInput">
            <input id="restockEnabledInput" type="checkbox" @bind="_restockSettings.IsEnabled" />
            @* A "!" while off: that sentence is what turning it off costs, not what the switch is for. *@
            <span>@T["Keep a restock list for this inventory"]<FieldHint Warns="@(!_restockSettings.IsEnabled)">@(_restockSettings.IsEnabled
                ? T["Orbit keeps a \"Restock supplies\" list for this shelf and puts what is running low on it."]
                : T["Turning this off deletes the restock list and everything on it. Turning it back on builds a new one."])</FieldHint></span>
        </label>

        <fieldset class="restock-settings-fields" disabled="@(!_restockSettings.IsEnabled)">
            <label class="field-checkbox" for="onlyLinkedWithDueDateInput">
                <input id="onlyLinkedWithDueDateInput" type="checkbox" @bind="_restockSettings.OnlyLinkedWithDueDate" />
                <span>@T["Only what a dated task is waiting on"]<FieldHint>@(_restockSettings.OnlyLinkedWithDueDate
                    ? T["The list asks for products some task with a due date needs. What is running low but nothing is waiting on is left off."]
                    : T["The list asks for everything on this shelf that has dropped below its own minimum."])</FieldHint></span>
            </label>

            @* The blunter narrowing of the two, and the one for a shelf nobody counts: the list becomes
               a round rather than a report - see RestockListSettings.OnlyCheckedRegularly. *@
            <label class="field-checkbox" for="onlyCheckedRegularlyInput">
                <input id="onlyCheckedRegularlyInput" type="checkbox" @bind="_restockSettings.OnlyCheckedRegularly" />
                <span>@T["Only the products marked \"Check every round\""]<FieldHint>@(_restockSettings.OnlyCheckedRegularly
                    ? T["The list asks only about the products marked to look at every round. What is running low but not marked is left off."]
                    : T["The list asks about everything it would otherwise ask about, marked or not."])</FieldHint></span>
            </label>

            <div class="field">
                <label for="restockPrioritySelect">@T["Priority of the restock list"]<FieldHint>@T["How much the generated \"Restock supplies\" list matters, next to your own lists."]</FieldHint></label>
                <select id="restockPrioritySelect" @bind="_restockSettings.ListPriority">
                    <option value="@ItemPriority.Low">@T["Low"]</option>
                    <option value="@ItemPriority.Normal">@T["Normal"]</option>
                    <option value="@ItemPriority.High">@T["High"]</option>
                </select>
            </div>

            @* The reminder and the hour it arrives at are one decision, so the switch sits beside the
               field it governs rather than above the section: turning it off leaves the list alone and
               only stops the standing entry. *@
            <div class="field">
                <label class="field-checkbox" for="restockRemindDailyInput">
                    <input id="restockRemindDailyInput" type="checkbox" @bind="_restockSettings.RemindDaily" />
                    <span>@T["Remind me to update stock levels"]</span>
                    <FieldHint>
                        @(_restockSettings.RemindDaily
                            ? T["The standing \"Update stock levels\" entry comes back every day at this hour, and shows on the calendar for that day."]
                            : T["Nothing arrives each day. Products dropping below their minimum still raise their own errands."])
                    </FieldHint>
                </label>
                <fieldset class="restock-reminder-time" disabled="@(!_restockSettings.RemindDaily)">
                    <label for="restockRefreshTimeInput">@T["Comes round at"]</label>
                    <TimeField Value="_restockSettings.RefreshTimeOfDay"
                               ValueChanged="time => _restockSettings.RefreshTimeOfDay = time ?? RestockListSettings.DefaultRefreshTimeOfDay"
                               AriaLabel="@(T["Comes round at"])" />
                    @* Where it is said, beside when it arrives: the two are one decision, and a reminder
                       nobody chose a channel for went out on the phone whether or not that was wanted. *@
                    <label for="restockReminderChannelSelect">@T["Said on"]</label>
                    <select id="restockReminderChannelSelect" @bind="_restockSettings.ReminderChannel">
                        @foreach (var option in NotificationChannelOption.All)
                        {
                            <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                        }
                    </select>
                </fieldset>
            </div>
        </fieldset>
    </div>
    }

</div>
<EditorRail OnSave="SaveAsync" OnCancel="GoBack"
            Notice="@(_lockedByUserName is null ? null : T.Format("{0} is currently editing this inventory - you can't edit it right now.", _lockedByUserName))"
            ErrorMessage="@_saveErrorMessage"
            SaveDisabled="@(_isReadOnly || _lockedByUserName is not null || _isSaving || _formModel.Name.Trim().Length == 0)">
    @* Beside the button that failed rather than at the end of a shelf that is taller than the screen:
       a save that did not happen and an inventory somebody else is holding are both answers to "why has
       Save done nothing", and an answer nobody scrolls to is not one. *@
    <ChildContent>
        @* Handing the shelf on, from inside the shelf - to a contact, or as a link anybody can read.
           Each opens over the page; they used to be two sections under the form, below everything else
           on a long shelf. Offered on the same terms as then: only for a shelf that has been saved and
           is not sealed, and sharing only where this reader's own access allows passing it on. See
           ShareInventoryPanel, the same panel the card on the list opens. *@
        @if (CanOfferSharing || CanOfferALink)
        {
            <OverflowMenu>
                @if (CanOfferSharing)
                {
                    <button type="button" class="avatar-dropdown-item" @onclick="() => _isSharingOpen = true">@T["Share"]</button>
                }
                @if (CanOfferALink)
                {
                    <button type="button" class="avatar-dropdown-item" @onclick="() => _isShareLinkOpen = true">@T["Share link"]</button>
                }
            </OverflowMenu>
        }
    </ChildContent>
</EditorRail>
</div>
</BehindThePin>

@if (_isSharingOpen && CanOfferSharing && _inventory is { } inventory)
{
    <Dialog Title="@T["Share"]" OnClosed="() => _isSharingOpen = false">
        <ShareInventoryPanel Inventory="inventory" Contacts="_contacts" OwnUserId="_ownUserId" />
    </Dialog>
}

@if (_isShareLinkOpen && CanOfferALink)
{
    <Dialog Title="@T["Share link"]" OnClosed="() => _isShareLinkOpen = false">
        <ShareLinkButton ItemType="Inventory" ItemId="InventoryId!.Value" />
    </Dialog>
}

@* The one thing a save of the shelf cannot decide on its own. An amount only one list asks for is
   written straight into it; an amount two lists ask for divides between them in a way only the reader
   knows - one of the two recipes got bigger, not both a little. So the lists are named, and the reader
   either splits it equally or goes and changes the one that actually moved. Closing the panel is the
   second answer: the shelf still saves, and nothing on any list is touched. See ShelfDemand. *@
@if (_sharedRowsInQuestion.Count > 0)
{
    <Dialog Title="@T["More than one list asks for this"]" OnClosed="() => AnswerAboutSharedRowsAsync(false)">
        <ChildContent>
            <p>@T["Several of your lists ask for these, so Orbit can't tell which one you changed."]</p>
            <ul class="shared-shelf-rows">
                @foreach (var row in _sharedRowsInQuestion)
                {
                    <li>
                        <strong>@(row.Name.Trim().Length > 0 ? row.Name : T["Item name"])</strong>
                        @* Prose rather than a value, so the list names wrap instead of being cut off - see .row-meta-prose. *@
                        <span class="row-meta row-meta-prose">@T.Format("now {0}, asked for by {1}", (row.MinimumQuantity ?? 0).ToString("0.##"), string.Join(", ", ListsAskingFor(row)))</span>
                    </li>
                }
            </ul>
            <p class="field-hint">@T["Split evenly divides each amount equally between the entries asking for it. Leaving the lists alone saves the shelf and changes nothing on them."]</p>
        </ChildContent>
        <Footer>
            <button type="button" class="btn-primary" @onclick="() => AnswerAboutSharedRowsAsync(true)">@T["Split evenly"]</button>
            <button type="button" class="btn-secondary" @onclick="() => AnswerAboutSharedRowsAsync(false)">@T["I'll change the lists myself"]</button>
        </Footer>
    </Dialog>
}
}

@code {
    [Parameter]
    public Guid? InventoryId { get; set; }

    /// <summary>
    /// The page that sent the reader here, so finishing returns them to it rather than to /inventory -
