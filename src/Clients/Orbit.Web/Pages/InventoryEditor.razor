    /// Where an item was dropped is where it belongs: the shelf is saved in the order it is written in
    /// - see InventoryItem.Position - so arranging it here is the order it is read back in.
    /// </summary>

    /// <summary>
    /// The same move a drag makes, one row at a time - what a keyboard can ask for, and a finger, which
    /// raises no drag events at all. The list itself is what gets saved, so nothing else has to happen.
    /// </summary>
    private void MoveItem(InventoryItemFormModel item, int offset)
        => RowArrangement<InventoryItemFormModel>.Move(_formModel.Items, item, offset);

    private bool CanMoveItem(InventoryItemFormModel item, int offset)
        => RowArrangement<InventoryItemFormModel>.CanMove(_formModel.Items, item, offset);
    private void DropItemOn(InventoryItemFormModel target)
    {
        _itemOrder.DropOn(_formModel.Items, target);
