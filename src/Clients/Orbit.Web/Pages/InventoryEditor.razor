    /// <summary>
    /// The rows whose minimum this reader actually moved. Not "what the boxes say": after typing, every
    /// box says something, and only a number somebody changed is a reason to rewrite a task list - see
    /// _minimumsAsLoaded. A cleared minimum is left out too, for the reason
    /// UpdateInventoryCommandHandler.WriteTheAmountsBackToTheListsAsync gives.
    /// </summary>
    private IReadOnlyList<InventoryItemFormModel> RowsWhoseMinimumMoved()
        => [.. _formModel.Items.Where(item =>
            item.Id is { } id
            && item.MinimumQuantity is not null
            && _minimumsAsLoaded.TryGetValue(id, out var before)
            && before != item.MinimumQuantity)];

    /// <summary>Which of this reader's entries ask for one shelf row - see ShelfDemand.</summary>
    private IReadOnlyList<ShelfClaimDto> WhatAsksFor(InventoryItemFormModel item)
        => item.Id is { } id ? [.. _shelfDemand.Where(claim => claim.InventoryItemId == id)] : [];

    /// <summary>
    /// The changed rows more than one entry asks for - the ones a save cannot divide on its own, and so
    /// the ones the reader is asked about. A row exactly one entry asks for needs no question: that entry
    /// is the whole of the demand and the server writes the new amount straight into it.
    /// </summary>
    private IReadOnlyList<InventoryItemFormModel> SharedRowsBeingChanged()
        => [.. RowsWhoseMinimumMoved().Where(item => WhatAsksFor(item).Count > 1)];

    /// <summary>
    /// The lists asking for a row, named and said once each: two entries of one list asking for the same
    /// flour is still one list to go and change.
    /// </summary>
    private IReadOnlyList<string> ListsAskingFor(InventoryItemFormModel item)
        => [.. WhatAsksFor(item).Select(claim => claim.TaskListName).Distinct(StringComparer.CurrentCultureIgnoreCase)];

    /// <summary>
    /// Save, stopping first to ask about any amount several lists are asking for - see ShelfDemand for
    /// why it cannot be divided without being told how. Everything else saves straight through, the
    /// single-list rows included: those are written back without a word, which is what "a change on the
    /// shelf reaches the list" means.
    /// </summary>
    private async Task SaveAsync()
    {
        if (SharedRowsBeingChanged() is { Count: > 0 } shared)
        {
            _sharedRowsInQuestion = shared;
            return;
        }

        await SaveNowAsync();
    }

    /// <summary>
    /// The reader's answer to that question: split what they typed equally between the entries asking, or
    /// leave the lists alone and go and change the one that actually moved. Either way the shelf itself
    /// saves - the amount they typed is what they meant for the shelf.
    /// </summary>
    private async Task AnswerAboutSharedRowsAsync(bool splitEvenly)
    {
        _splitTheSharedRowsEvenly = splitEvenly;
        _sharedRowsInQuestion = [];
        await SaveNowAsync();
    }

    private async Task SaveNowAsync()
    {
        _saveErrorMessage = null;
        _isSaving = true;
        try
        {
            if (IsNewInventory)
            {
                // Said in the server's own words when it refuses. "Try again" is the wrong thing to
                // tell somebody about a request that will be refused identically every time.
                var creation = await InventoryApiClient.CreateInventoryAsync(_formModel.ToRequest(_folderId));
                if (!creation.WasCreated)
                {
                    _saveErrorMessage = creation.RefusedBecause;
                    return;
                }

                _savedFolderId = _folderId;
            }
            else
            {
                var outcome = await InventoryApiClient.UpdateInventoryAsync(
                    InventoryId!.Value, _formModel.ToRequest(_folderId, SharedRowsToSplit()));
                if (outcome.Kind == EditOutcomeKind.Locked)
                {
                    _lockedByUserName = outcome.LockedByUserName;
                    return;
                }

                if (outcome.Kind == EditOutcomeKind.NotFound)
                {
                    _saveErrorMessage = T["Failed to save the inventory. Try again."];
                    return;
                }

                // The restock list's settings go with the shelf they belong to, rather than behind a
                // Save of their own: this form already has one Save and one Cancel, and a section with
                // a second pair of them left somebody who pressed the page's Save wondering why the
                // switch they had just moved had not taken. Only for an inventory that exists - a new
                // one has no list to configure until it has been created.
                await InventoryApiClient.SaveRestockListSettingsAsync(InventoryId!.Value, _restockSettings.ToDto());

                // Filing travels separately from the inventory itself - see MoveToFolderRequest - so it
                // is sent only when it actually changed, and a refusal is said out loud: the shelf is
                // saved, and only the tab it was meant for is not.
                if (_folderId != _savedFolderId)
                {
                    if (await InventoryApiClient.MoveToFolderAsync(InventoryId!.Value, _folderId))
                    {
                        _savedFolderId = _folderId;
                    }
                    else
                    {
                        Logger.LogWarning(
                            "Inventory {InventoryId} was saved but could not be filed under folder {FolderId}",
                            InventoryId, _folderId);
                        _saveErrorMessage = T["The inventory was saved, but it couldn't be filed under that folder. Choose it again."];
                        return;
                    }
                }
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to save inventory {InventoryId}", InventoryId);
            _saveErrorMessage = T["Failed to save the inventory. Try again."];
            return;
        }
        finally
        {
            _isSaving = false;
            // Put back, so a second save from the same page asks again rather than quietly splitting
            // whatever was edited next.
            _splitTheSharedRowsEvenly = false;
        }

        await GoBack();
    }

    /// <summary>
    /// The shelf rows whose new amount the server may divide equally - only when the reader said so, and
    /// only the rows they were actually asked about. Empty otherwise, which leaves every shared row's
    /// lists exactly as they are. See ShelfDemand.
    /// </summary>
    private IReadOnlyList<Guid> SharedRowsToSplit()
        => _splitTheSharedRowsEvenly
            ? [.. SharedRowsBeingChanged().Select(item => item.Id!.Value)]
            : [];

    private async Task AcquireLockAsync()
    {
        try
        {
            var outcome = await InventoryApiClient.AcquireInventoryLockAsync(InventoryId!.Value);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Mirrors TaskEditor's method of the same name - see its comment.</summary>
    private async Task ReleaseLockAsync()
    {
        StopLockHeartbeat();
        if (IsNewInventory || _isReadOnly)
        {
            return;
        }

        try
        {
            await InventoryApiClient.ReleaseInventoryLockAsync(InventoryId!.Value);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat()
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(_lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync();
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public async ValueTask DisposeAsync() => await ReleaseLockAsync();

    private sealed class InventoryFormModel
    {
        public string Name { get; set; } = string.Empty;

        /// <summary>What this inventory is for, written under its name. Usually empty.</summary>
        public string Description { get; set; } = string.Empty;

        public List<InventoryItemFormModel> Items { get; set; } = [];

        /// <summary>Encrypt this inventory so only its owner can read it - see PrivateContentSealer.</summary>
        public bool IsPrivate { get; set; }

        public static InventoryFormModel FromDto(InventoryDto inventory, IReadOnlyList<InventoryItemDto> items)
            => new()
            {
                Name = inventory.Name,
                Description = inventory.Description,
                IsPrivate = inventory.IsPrivate,
                Items = [.. items.Select(InventoryItemFormModel.FromDto)]
            };

        /// <summary>
        /// The body a save sends. <paramref name="folderId"/> is read by the server only when the
        /// inventory is being made - filing one that exists is its own request - see SaveInventoryRequest.
        /// <paramref name="splitEvenlyAcross"/> is the reader's answer about the rows several lists ask
        /// for - see ShelfDemand.
        /// </summary>
        public SaveInventoryRequest ToRequest(Guid? folderId = null, IReadOnlyList<Guid>? splitEvenlyAcross = null)
            => new(
                Name, [.. Items.Select(item => item.ToDto())], IsPrivate, Description: Description,
                FolderId: folderId, SplitEvenlyAcross: splitEvenlyAcross);
    }

}
