    protected override async Task OnInitializedAsync()
    {
        // Best-effort: gates which notification-channel options are selectable (see
        // NotificationChannelOption.IsDisabledBy) - a failure here just leaves every option enabled
        // rather than blocking the rest of the page from loading.
        // Same best-effort footing: the two boxes on every item row offer what this account already
        // files things under, and a list that could not be read leaves them plain boxes.
        _knownProductTypes = await NameSuggestionsApiClient.UsedValuesAsync(UsedValueKind.InventoryItemProductType);
        _knownCategories = await NameSuggestionsApiClient.UsedValuesAsync(UsedValueKind.InventoryItemCategory);

        try
        {
            _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to load notification settings");
        }

        // Nothing below means anything yet: there is no inventory to read, lock, share, or measure a
        // list against - see PageHeading and every "!IsNewInventory" section below for what waits for
        // the first Save.
        if (IsNewInventory)
        {
            // Made where the reader is standing, as a new note is - see NoteEditor. From Private what
            // carries over is the thing that puts a shelf there: it starts sealed, rather than being
            // written in the open and landing under Public.
            await Folders.EnsureLoadedAsync();
            var chosen = Folders.ChosenOn(FolderPage.Inventories);
            _folderId = chosen.FolderId;
            _formModel.IsPrivate = chosen == FolderKey.Of(BuiltInFolder.Private);
            _isLoading = false;
            return;
        }

        try
        {
            var inventory = await InventoryApiClient.GetInventoryByIdAsync(InventoryId!.Value);
            if (inventory is null)
            {
                await NavigationTrail.FinishAsync(WhenFinished);
                return;
            }

            _inventory = inventory;
            _isShared = inventory.IsShared;
            _sharedByUserName = inventory.SharedByUserName;
            _originalOwnerUserId = inventory.OriginalOwnerUserId;
            _access = SharedItemAccess.For(inventory.IsShared, inventory.AccessLevel);
            _isReadOnly = !_access.CanEdit;

            // Best-effort, like the notification settings above: without them the share panel says it
            // has nobody to offer, which is the truth of what it can do rather than a broken page.
            try
            {
                _contacts = await ChatApiClient.GetContactsAsync();
                _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync() ?? Guid.Empty;
            }
            catch (HttpRequestException contactsException)
            {
                Logger.LogWarning(contactsException, "Failed to load contacts for sharing inventory {InventoryId}", InventoryId);
            }

            var items = await InventoryApiClient.GetInventoryItemsAsync(InventoryId.Value) ?? [];
            _formModel = InventoryFormModel.FromDto(inventory, items);
            _folderId = inventory.FolderId;
            _savedFolderId = inventory.FolderId;

            // What every row's minimum was when the page opened, and which entries ask for it. Together
            // they are what a save needs to know: which minimums this reader actually moved, and whether
            // moving one reaches a list - see AmountsThatMoved and ShelfDemand.
            _minimumsAsLoaded = items.ToDictionary(item => item.Id, item => item.MinimumQuantity);
            _shelfDemand = await InventoryApiClient.GetShelfDemandAsync(InventoryId.Value);

            if (!_isReadOnly)
            {
                await AcquireLockAsync();
                if (_lockedByUserName is null)
                {
                    StartLockHeartbeat();
                }
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadRestockSettingsAsync();
        await LoadTaskListsAsync();
        _isLoading = false;
    }

    /// <summary>
    /// Every list of this account's, and every inventory, so the boxes can be ticked and a list already
    /// measured against another store can say which. Best effort, like the settings above: an inventory
    /// that opens without the tie is more use than one that will not open.
    /// </summary>
    private async Task LoadTaskListsAsync()
    {
        try
        {
            _taskLists = await TasksApiClient.GetTaskListsAsync();
            var everyInventory = await InventoryApiClient.GetInventoriesAsync() ?? [];
            _inventoryNames = everyInventory.ToDictionary(inventory => inventory.Id, inventory => inventory.Name);
            // What this one could gather: the reader's own shelves, not itself, and not one somebody
            // shared with them - a group is an arrangement of shelves its owner has - see
            // GatherInventoriesCommandHandler.
            _couldBeGathered = [.. everyInventory.Where(candidate =>
                candidate.Id != InventoryId && !candidate.IsShared)];
            _gathered = [.. everyInventory.FirstOrDefault(candidate => candidate.Id == InventoryId)?.AllGathered ?? []];
            WorkOutWhatIsMeasuredThroughAGroup();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't read which lists are measured against inventory {InventoryId}", InventoryId);
        }
    }

    /// <summary>
    /// Re-read after anything that changes which lists are tied here directly, since every tie brings
    /// its whole tree with it - ticking one group can light up a dozen rows below it.
    /// </summary>
    private void WorkOutWhatIsMeasuredThroughAGroup()
        => _measuredThroughAParent = MeasuredThroughAParent.Reach(
            _taskLists,
            _taskLists
                .Where(taskList => taskList.LinkedInventoryId == InventoryId)
                .Select(taskList => taskList.Id)
                .ToHashSet());

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    /// <summary>
    /// Ties a list to this inventory, or lets it go. One list at a time and written straight away: a
    /// tick here is the whole decision, and holding it until Save would put it behind a button that is
    /// about the shelf rather than about this.
    /// </summary>
    private async Task MeasureAsync(TaskDto taskList, bool isMeasured)
    {
        _isLinkingTaskLists = true;
        _linkingMessage = null;
        try
        {
            if (!await TasksApiClient.LinkInventoryAsync(taskList.Id, isMeasured ? InventoryId : null))
            {
                _linkingMessage = T.Format("Couldn't measure \"{0}\" against this inventory. Try again.", taskList.Title);
                return;
            }

            await LoadTaskListsAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't tie task list {TaskListId} to inventory {InventoryId}", taskList.Id, InventoryId);
            _linkingMessage = T.Format("Couldn't measure \"{0}\" against this inventory. Try again.", taskList.Title);
        }
        finally
        {
            _isLinkingTaskLists = false;
        }
    }

    /// <summary>
    /// Which gathered list this one is measured through, or null when it stands on its own. Worked out
    /// once per render rather than per row: the walk is over every list this reader has, and asking it
    /// again for each of thirty rows would be thirty walks of the same tree.
    /// </summary>
    private IReadOnlyDictionary<Guid, Guid> _measuredThroughAParent = new Dictionary<Guid, Guid>();

    /// <summary>The name of the list gathering this one, for the row to say - null when nothing does.</summary>
    private string? MeasuredThrough(TaskDto taskList)
        => _measuredThroughAParent.TryGetValue(taskList.Id, out var gatheredById)
            && _taskLists.FirstOrDefault(candidate => candidate.Id == gatheredById) is { } gatheredBy
            ? Written(gatheredBy.Title)
            : null;

    /// <summary>
    /// The list measured against one of the shelves this group could gather, in the reader's words, or
    /// null where nothing is. Said once each, since a shelf answering to two lists is a row about two
    /// things and the first is the one that fits.
    /// </summary>
    private string? ListMeasuredAgainst(Guid inventoryId)
        => _taskLists.FirstOrDefault(taskList => taskList.LinkedInventoryId == inventoryId) is { } measured
            ? Written(measured.Title)
            : null;

    /// <summary>What another store is called, or its id where this browser has not got it.</summary>
    private string NameOfInventory(Guid inventoryId)
        => _inventoryNames.TryGetValue(inventoryId, out var name) ? name : inventoryId.ToString();

    /// <summary>Every list of this account's, with the inventory each is measured against.</summary>
    private IReadOnlyList<TaskDto> _taskLists = [];

    /// <summary>The shelves this one could gather - the reader's own, other than itself. See Gather.</summary>
    private IReadOnlyList<InventoryDto> _couldBeGathered = [];

    /// <summary>The ones it does gather, as the server last answered - see Orbit.Core.Inventories.Inventory.GathersInventoryIds.</summary>
    private List<Guid> _gathered = [];

    private bool _isGathering;

    /// <summary>What went wrong with a tick in the group's list, said beside the boxes it was made in.</summary>
    private string? _gatheringMessage;

    /// <summary>
    /// Puts a shelf in this group, or takes it out. One at a time and written straight away, for the
    /// reason MeasureAsync is: a tick here is the whole decision, and holding it until Save would put it
    /// behind a button that is about what is on the shelf rather than about this.
    ///
    /// The whole membership goes up each time, because that is what the server takes - see
    /// GatherInventoriesRequest, which says why it is not an add and a remove.
    /// </summary>
    private async Task GatherAsync(InventoryDto candidate, bool isGathered)
    {
        _isGathering = true;
        _gatheringMessage = null;
        var wanted = isGathered
            ? [.. _gathered, candidate.Id]
            : _gathered.Where(gathered => gathered != candidate.Id).ToList();
        try
        {
            if (!await InventoryApiClient.GatherAsync(InventoryId!.Value, wanted))
            {
                // The one rule a reader can trip over from here: a shelf that already gathers this one,
                // directly or further down, cannot also be gathered by it - see InventoryGroups.
                _gatheringMessage = T.Format(
                    "Couldn't put \"{0}\" in this group. It may already gather this one.", candidate.Name);
                return;
            }

            _gathered = wanted;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(
                exception, "Couldn't gather inventory {GatheredId} into {InventoryId}", candidate.Id, InventoryId);
            _gatheringMessage = T.Format("Couldn't put \"{0}\" in this group. Try again.", candidate.Name);
        }
        finally
        {
            _isGathering = false;
        }
    }

