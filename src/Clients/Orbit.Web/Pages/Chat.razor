    private async Task DecryptAndCacheAsync(ChatMessageDto message)
    {
        if (_otherUser?.PublicKeyBase64 is null || _cryptoModule is null)
        {
            return;
        }

        var plainText = await _cryptoModule.InvokeAsync<string?>(
            "decryptMessage", _ownUserId, _otherUser.PublicKeyBase64, message.CiphertextBase64, message.NonceBase64);
        if (plainText is null)
        {
            return;
        }

        if (TryParseShare(plainText) is { } shareNotice)
        {
            _shareNoticeByMessageId[message.Id] = shareNotice;
            _decryptedContentByMessageId[message.Id] = shareNotice.Description;
            // Reflects an acceptance that may have happened in an earlier session (or after a reload),
            // so the button doesn't misleadingly offer "Accept" again for something already accepted.
            // Skipped for a share this user sent themselves - the status endpoint is scoped to the
            // recipient, so it would just be a guaranteed-404 lookup for those.
            if (message.SenderUserId != _ownUserId && await shareNotice.GetStatusAsync() == true)
            {
                _acceptedShareIds.Add(shareNotice.ShareId);
            }

            return;
        }

        // No ShareId and nothing to accept, so it never becomes a ShareNotice: a shared position is
        // already visible on the map to whoever it was sealed for. It reads as what happened.
        if (TryDeserialize<LocationShareMessagePayload>(plainText) is { Type: LocationShareMessagePayload.MessageType } locationShare)
        {
            _decryptedContentByMessageId[message.Id] = locationShare.IsContinuous
                ? T["Shared their location, and keeps it up to date."]
                : T["Shared where they are right now."];
            return;
        }

        if (TryDeserialize<ReplyMessagePayload>(plainText) is { Type: ReplyMessagePayload.MessageType } reply)
        {
            _decryptedContentByMessageId[message.Id] = reply.Content;
            _replyToByMessageId[message.Id] = new QuotedMessage(reply.ReplyToMessageId, reply.ReplyToPreview);
            return;
        }

        if (TryDeserialize<EditAccessRequestPayload>(plainText) is { Type: EditAccessRequestPayload.MessageType } editAccessRequest)
        {
            _editAccessRequestByMessageId[message.Id] = BuildEditAccessRequestNotice(editAccessRequest, message.SenderUserId);
            _decryptedContentByMessageId[message.Id] = _editAccessRequestByMessageId[message.Id].Description;
            return;
        }

        if (TryDeserialize<ForwardedMessagePayload>(plainText) is { Type: ForwardedMessagePayload.MessageType } forwarded)
        {
            _decryptedContentByMessageId[message.Id] = forwarded.Content;
            _forwardedFromByMessageId[message.Id] = forwarded.OriginalAuthorDisplayName;
            return;
        }

        _decryptedContentByMessageId[message.Id] = plainText;
    }

    /// <summary>
    /// A decrypted message's plaintext is ordinary user-typed text unless it happens to parse as one of
    /// the four structured share shapes (see EventShareMessagePayload/NoteShareMessagePayload/
    /// TaskListShareMessagePayload/WarehouseShareMessagePayload) - anything else, including JSON that just doesn't match any of them,
    /// is treated as plain text rather than surfacing a parse error.
    /// </summary>
    private ShareNotice? TryParseShare(string plainText)
    {
        if (TryDeserialize<EventShareMessagePayload>(plainText) is { Type: EventShareMessagePayload.MessageType } eventShare)
        {
            return new ShareNotice(
                eventShare.ShareId, $"Shared an event: {eventShare.EventTitle}",
                () => CalendarApiClient.GetCalendarEventShareStatusAsync(eventShare.ShareId),
                () => CalendarApiClient.AcceptCalendarEventShareAsync(eventShare.ShareId));
        }

        if (TryDeserialize<NoteShareMessagePayload>(plainText) is { Type: NoteShareMessagePayload.MessageType } noteShare)
        {
            return new ShareNotice(
                noteShare.ShareId, $"Shared a note: {noteShare.NoteTitle}",
                () => NotesApiClient.GetNoteShareStatusAsync(noteShare.ShareId),
                () => NotesApiClient.AcceptNoteShareAsync(noteShare.ShareId));
        }

        if (TryDeserialize<TaskListShareMessagePayload>(plainText) is { Type: TaskListShareMessagePayload.MessageType } taskListShare)
        {
            return new ShareNotice(
                taskListShare.ShareId, $"Shared a task list: {taskListShare.TaskListTitle}",
                () => TasksApiClient.GetTaskListShareStatusAsync(taskListShare.ShareId),
                () => TasksApiClient.AcceptTaskListShareAsync(taskListShare.ShareId));
        }

        if (TryDeserialize<WarehouseShareMessagePayload>(plainText) is { Type: WarehouseShareMessagePayload.MessageType } warehouseShare)
        {
            return new ShareNotice(
                warehouseShare.ShareId, $"Shared a warehouse: {warehouseShare.WarehouseName}",
                () => InventoryApiClient.GetWarehouseShareStatusAsync(warehouseShare.ShareId),
                () => InventoryApiClient.AcceptWarehouseShareAsync(warehouseShare.ShareId));
        }

        return null;
    }

    /// <summary>
    /// Granting is an ordinary share at EditOnly: they asked to edit, not to decide who else can, and
    /// the owner can still hand out more from the sharing form if they mean to. Sharing something
    /// already shared raises what the existing offer grants rather than creating a second one - see
    /// ShareOutcome.AccessLevelRaised.
    /// </summary>
    private EditAccessRequestNotice BuildEditAccessRequestNotice(EditAccessRequestPayload request, Guid requesterUserId)
    {
        var description = $"Asked to edit {DescribeItemType(request.ItemType)}: {request.ItemTitle}";

        return new EditAccessRequestNotice(description, () => request.ItemType switch
        {
            "Note" => GrantAsync(NotesApiClient.ShareNoteAsync(request.ItemId, requesterUserId, "EditOnly")),
            "TaskList" => GrantAsync(TasksApiClient.ShareTaskListAsync(request.ItemId, requesterUserId, "EditOnly")),
            "CalendarEvent" => GrantAsync(CalendarApiClient.ShareCalendarEventAsync(request.ItemId, requesterUserId, "EditOnly")),
            _ => GrantAsync(InventoryApiClient.ShareWarehouseAsync(request.ItemId, requesterUserId, "EditOnly"))
        });
    }

    private static async Task<bool> GrantAsync<T>(Task<T?> shareTask) where T : class => await shareTask is not null;

    private string DescribeItemType(string itemType) => itemType switch
    {
        "Note" => T["a note"],
        "TaskList" => T["a task list"],
        "CalendarEvent" => T["an event"],
        _ => T["a warehouse"]
    };

    private async Task GrantEditAccessAsync(Guid messageId, EditAccessRequestNotice notice)
    {
        _grantingEditAccessMessageIds.Add(messageId);
        try
        {
            if (await notice.GrantAsync())
            {
                _grantedEditAccessMessageIds.Add(messageId);
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to grant edit access from a chat request");
        }
        finally
        {
            _grantingEditAccessMessageIds.Remove(messageId);
        }
    }

    private static T? TryDeserialize<T>(string plainText) where T : class
    {
        try
        {
            return JsonSerializer.Deserialize<T>(plainText);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private async Task AcceptShareAsync(ShareNotice shareNotice)
    {
        _acceptingShareIds.Add(shareNotice.ShareId);
        try
        {
            if (await shareNotice.AcceptAsync())
            {
                _acceptedShareIds.Add(shareNotice.ShareId);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // Left off _acceptedShareIds, so the "Accept" button just reappears - that absence is the
            // only feedback the user gets that this didn't go through (see the class-level note on why
            // this mechanism logs rather than showing a dedicated failure message).
            Logger.LogError(exception, "Failed to accept share {ShareId}", shareNotice.ShareId);
        }
        finally
        {
            _acceptingShareIds.Remove(shareNotice.ShareId);
        }
    }

    /// <summary>
    /// One of the three kinds of share a chat message can carry, normalized to a single shape so the
    /// message-rendering loop and AcceptShareAsync don't need to know which kind they're looking at - see
    /// TryParseShare.
    /// </summary>
    private sealed record ShareNotice(
        Guid ShareId, string Description, Func<Task<bool?>> GetStatusAsync, Func<Task<bool>> AcceptAsync);

    /// <summary>
    /// Somebody asking the owner to let them edit something (see EditAccessRequestPayload). Unlike a
    /// ShareNotice there is nothing to accept - the owner grants it by sharing again at a higher level,
    /// which is what GrantAsync does.
    /// </summary>
    private sealed record EditAccessRequestNotice(string Description, Func<Task<bool>> GrantAsync);

    private async Task OnDraftKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftMessage) || _otherUser?.PublicKeyBase64 is null || _cryptoModule is null)
        {
            return;
        }

        _isSending = true;
        try
        {
            // A reply travels as a structured payload carrying what it answers; anything else goes as
            // the plain text it is, so an ordinary message costs no JSON on either end.
            var contentToSend = _replyingTo is { } replyingTo
                ? JsonSerializer.Serialize(new ReplyMessagePayload(
                    replyingTo.Id,
                    ReplyMessagePayload.Preview(_decryptedContentByMessageId.GetValueOrDefault(replyingTo.Id) ?? string.Empty),
                    _draftMessage))
                : _draftMessage;

            var payload = await _cryptoModule.InvokeAsync<EncryptedPayload>(
                "encryptMessage", _ownUserId, _otherUser.PublicKeyBase64, contentToSend);
            var sent = await ChatApiClient.SendMessageAsync(
                new SendMessageRequest(UserId, payload.CiphertextBase64, payload.NonceBase64));

            // A poll tick that overlapped this send may already have picked the message up: the server
            // had stored it before this await returned, so both paths can hold it. Adding it blind is
            // what showed the first message of a conversation twice, where an empty list makes the poll
            // fetch everything and the overlap is near-certain.
            AddMessageIfNew(sent);
            _decryptedContentByMessageId[sent.Id] = _draftMessage;
            if (_replyingTo is { } answered)
            {
                _replyToByMessageId[sent.Id] = new QuotedMessage(
                    answered.Id, ReplyMessagePayload.Preview(_decryptedContentByMessageId.GetValueOrDefault(answered.Id) ?? string.Empty));
                _replyingTo = null;
            }

            _draftMessage = string.Empty;
            // Sending always follows your own message down, regardless of where you had scrolled to.
            _scrollToNewestOnNextRender = true;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // The draft is deliberately left in _draftMessage (not cleared) and nothing is appended to
            // _messages - that's the only signal the user gets that the message wasn't sent, so they can
            // just retry instead of retyping it.
            Logger.LogError(exception, "Failed to send a chat message to user {RecipientUserId}", UserId);
        }
        finally
        {
            _isSending = false;
        }
    }

    /// <summary>Matches MainLayout's own badge formatting - 1-9 as-is, "9+" above that.</summary>
    /// <summary>
    /// Unread messages waiting from this contact. Comes from the conversation itself (ContactDto), so
    /// it survives clearing the notification panel and disappears only once the conversation is opened.
    /// The one exception is the conversation on screen, which the poll loop is marking read as it goes -
    /// showing a count beside it would flicker against a list refreshed a moment later.
    /// </summary>
    private int UnreadFrom(ContactDto contact) => contact.UserId == UserId ? 0 : contact.UnreadCount;

    /// <summary>
    /// Everything this reader can open, as one list - see ConversationList. Sorted by when something
    /// last happened, people and groups against each other: that is the order somebody scanning for a
    /// conversation looks in, and it is what they expect of a list that holds both. Groups used to
    /// follow in a block of their own, sorted by name, because a group carried no such time - it does
    /// now (see ChatGroup.LastMessageAtUtc), so the two no longer answer different questions.
    /// </summary>
    private IReadOnlyList<Conversation> Conversations =>
    [
        .. _matchingChats
            .Select(contact => (
                When: contact.LastMessageAtUtc,
                Conversation: new Conversation(
                    contact.UserId, contact.DisplayName, IsGroup: false, UnreadFrom(contact),
                    Conversation.PresenceOf(contact),
                    UnreadFrom(contact) > 0 ? T.Format("{0} new", UnreadFrom(contact)) : null)))
            .Concat(_matchingGroups.Select(group => (
                When: group.LastMessageAtUtc,
                Conversation: new Conversation(
                    group.Id, group.Name, IsGroup: true, UnreadCount: 0, Presence: null,
                    T.Format("{0} members", group.Members.Count)))))
            .OrderByDescending(row => row.When)
            .Select(row => row.Conversation)
    ];

    /// <summary>
    /// The groups left after the same search box the people are filtered by. Unsorted: Conversations
    /// above puts these in among the people by when something last happened, and sorting them by name
    /// first would only be undone there.
    /// </summary>
    private IEnumerable<ChatGroupDto> _matchingGroups
        => _chatSearch.Trim() is { Length: > 0 } query
            ? _groups.Where(group => group.Name.Contains(query, StringComparison.CurrentCultureIgnoreCase))
            : _groups;

    private void OpenConversation(Conversation conversation)
    {
        if (conversation.IsGroup)
        {
            _isDrawerOpen = false;
            _isCreatingGroup = false;
            NavigationManager.NavigateTo($"/chat/groups/{conversation.Id}");
            return;
        }

        SwitchContact(conversation.Id);
    }

