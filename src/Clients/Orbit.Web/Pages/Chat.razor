@page "/chat/{userId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Users
@using Orbit.Web.Services
@inject ChatApiClient ChatApiClient
@inject CalendarApiClient CalendarApiClient
@inject NotesApiClient NotesApiClient
@inject TasksApiClient TasksApiClient
@inject UsersApiClient UsersApiClient
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject AuthApiClient AuthApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<Chat> Logger

<PageTitle>Orbit — Chat</PageTitle>

<div class="page-header">
    <div>
        <h1>Messages</h1>
        <p class="page-subtitle">End-to-end encrypted conversations.</p>
    </div>
</div>

@if (_encryptionUnavailable)
{
    <p>
        Chat requires a secure connection (an address starting with "https://", or "http://localhost").
        Open Orbit at such an address and try again.
    </p>
}
else if (_encryptionKeyLocked)
{
    <p>
        This browser doesn't have a local copy of your encryption key - most likely because the key was
        generated in a different browser, or local data was cleared. Log in again to recover it from your
        password-encrypted backup.
        <button type="button" class="btn-secondary" @onclick="ReauthenticateAsync">Log out and log back in</button>
    </p>
}
else if (_otherUser is null)
{
    <p>Loading…</p>
}
else
{
    <div class="chat-layout">
        <div class="chat-list-backdrop @(_isDrawerOpen ? "open" : "")" @onclick="CloseDrawer"></div>
        <div class="chat-list @(_isDrawerOpen ? "open" : "") @(_isContactListCollapsed ? "collapsed" : "")">
            <div class="chat-list-header">
                <button type="button" class="icon-btn" title="@(_isContactListCollapsed ? "Show names" : "Hide names")" @onclick="ToggleContactListCollapsed">
                    @if (_isContactListCollapsed)
                    {
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5L13 10l-5.5 5.5" /></svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12.5 4.5L7 10l5.5 5.5" /></svg>
                    }
                </button>
            </div>
            @foreach (var contact in _establishedChats)
            {
                <button type="button" class="chat-list-item @(contact.UserId == UserId ? "active" : "")" title="@contact.DisplayName" @onclick="() => SwitchContact(contact.UserId)">
                    <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(contact.UserId)">@AvatarHelper.GetInitials(contact.DisplayName)</span>
                    <span class="chat-list-meta">
                        <span class="chat-list-name">@contact.DisplayName</span>
                    </span>
                </button>
            }
        </div>

        <div class="chat-thread">
            <div class="chat-thread-header">
                <button type="button" class="icon-btn chat-list-toggle" title="Conversations" @onclick="ToggleDrawer">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
                </button>
                <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(_otherUser.Id);width:34px;height:34px;font-size:12.5px;">@AvatarHelper.GetInitials(_otherUser.DisplayName)</span>
                <div>
                    <div class="chat-thread-name">@_otherUser.DisplayName</div>
                </div>
            </div>

            @if (_otherUser.PublicKeyBase64 is null)
            {
                <p>
                    @_otherUser.DisplayName hasn't set up encryption yet - they need to log in in their own
                    browser first before you can message them.
                </p>
            }
            else
            {
                @if (RequiresApprovalFromMe)
                {
                    <p class="chat-request-banner">
                        @_otherUser.DisplayName wants to chat with you.
                        <button type="button" class="btn-primary" disabled="@_isApprovingConversation" @onclick="ApproveConversationAsync">
                            Allow chatting
                        </button>
                    </p>
                }
                else if (IsPendingApprovalFromOtherParty)
                {
                    <p class="chat-request-banner">Message is waiting for @_otherUser.DisplayName to approve.</p>
                }

                <div class="chat-messages" @onclick="CloseMessageMenu">
                    @foreach (var message in _messages)
                    {
                        var canEdit = message.SenderUserId == _ownUserId && !_shareNoticeByMessageId.ContainsKey(message.Id)
                            && _decryptedContentByMessageId.ContainsKey(message.Id);

                        <div class="chat-bubble-row @(message.SenderUserId == _ownUserId ? "own" : "theirs")">
                            @if (_editingMessageId == message.Id)
                            {
                                <div class="chat-bubble-edit" @onclick:stopPropagation="true">
                                    <input class="chat-input" @bind="_editDraftText" @bind:event="oninput" />
                                    <div class="chat-bubble-edit-actions">
                                        <button type="button" class="btn-secondary" @onclick="CancelEdit">Cancel</button>
                                        <button type="button" class="btn-primary" disabled="@(_isSavingEdit || _editDraftText.Trim().Length == 0)"
                                                @onclick="() => SaveEditAsync(message)">
                                            Save
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="chat-bubble-wrap">
                                    <p class="chat-bubble">@(_decryptedContentByMessageId.GetValueOrDefault(message.Id) ?? "[couldn't decrypt]")</p>
                                    @if (canEdit)
                                    {
                                        <div class="chat-bubble-menu">
                                            <button type="button" class="icon-btn chat-bubble-menu-trigger" title="Message options"
                                                    @onclick="() => ToggleMessageMenu(message.Id)" @onclick:stopPropagation="true">
                                                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><circle cx="4" cy="10" r="1.6" /><circle cx="10" cy="10" r="1.6" /><circle cx="16" cy="10" r="1.6" /></svg>
                                            </button>
                                            @if (_openMessageMenuId == message.Id)
                                            {
                                                <div class="chat-bubble-menu-dropdown" @onclick:stopPropagation="true">
                                                    <button type="button" class="avatar-dropdown-item" @onclick="() => StartEdit(message)">Edit</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <span class="chat-bubble-meta">
                                    @message.SentAtUtc.ToLocalTime().ToString("HH:mm")
                                    @if (message.IsEdited)
                                    {
                                        <text> · Edited</text>
                                    }
                                    @if (message.SenderUserId == _ownUserId)
                                    {
                                        @(IsReadByOtherParty(message) ? " · Read" : " · Sent")
                                    }
                                </span>
                            }
                        </div>
                        @if (message.SenderUserId != _ownUserId && _shareNoticeByMessageId.TryGetValue(message.Id, out var shareNotice))
                        {
                            @if (_acceptedShareIds.Contains(shareNotice.ShareId))
                            {
                                <p class="event-share-status">Accepted - added to your account.</p>
                            }
                            else
                            {
                                <button type="button" class="btn-secondary" disabled="@_acceptingShareIds.Contains(shareNotice.ShareId)"
                                        @onclick="() => AcceptShareAsync(shareNotice)">
                                    Accept
                                </button>
                            }
                        }
                    }
                </div>

                <div class="chat-input-bar">
                    <input class="chat-input" @bind="_draftMessage" @bind:event="oninput" @onkeydown="OnDraftKeyDownAsync" placeholder="Write a message…"
                           disabled="@RequiresApprovalFromMe" />
                    <button type="button" class="btn-primary" @onclick="SendMessageAsync" disabled="@(_isSending || RequiresApprovalFromMe)">Send</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private Guid _ownUserId;
    private Guid _loadedUserId;
    private UserSearchResultDto? _otherUser;
    private readonly List<ChatMessageDto> _messages = [];
    private readonly Dictionary<Guid, string> _decryptedContentByMessageId = [];
    private IReadOnlyList<ContactDto> _contacts = [];
    private bool _isDrawerOpen;

    /// <summary>Desktop-only: collapses the contact list to just avatars (see .chat-list.collapsed in app.css) - independent of _isDrawerOpen, which is the mobile off-canvas open/closed state.</summary>
    private bool _isContactListCollapsed;

    /// <summary>Which own message's "..." dropdown (currently just "Edit") is open, if any.</summary>
    private Guid? _openMessageMenuId;

    /// <summary>Which own message is currently showing its inline edit box instead of its normal bubble, if any.</summary>
    private Guid? _editingMessageId;
    private string _editDraftText = string.Empty;
    private bool _isSavingEdit;

    /// <summary>The drawer's contact list - already-established conversations only, most recently active first (matches Contacts.razor's own "Chats" filter).</summary>
    private IEnumerable<ContactDto> _establishedChats
        => _contacts.Where(contact => !contact.RequiresApprovalFromCurrentUser).OrderByDescending(contact => contact.LastMessageAtUtc);

    /// <summary>
    /// Populated for a message that decrypts to one of the three share payload shapes (calendar event,
    /// note, or task list - see EventShareMessagePayload/NoteShareMessagePayload/TaskListShareMessagePayload),
    /// with whichever ApiClient call accepting that particular kind of share already bound in - see
    /// DecryptAndCacheAsync. This is what lets the single AcceptShareAsync/rendering block below handle
    /// all three kinds without three near-identical copies of the accept/status-tracking logic.
    /// </summary>
    private readonly Dictionary<Guid, ShareNotice> _shareNoticeByMessageId = [];

    /// <summary>
    /// Shares known to be accepted - seeded from the matching ApiClient's GetXShareStatusAsync when a
    /// share message is first decrypted (see DecryptAndCacheAsync), and updated immediately when the user
    /// clicks "Accept" rather than waiting on a re-fetch. Keeping this cache is what lets the message list
    /// avoid a status round-trip on every render. Shared across all three share kinds since each share id
    /// is an independently generated Guid - collisions across domains are not a realistic concern.
    /// </summary>
    private readonly HashSet<Guid> _acceptedShareIds = [];
    private readonly HashSet<Guid> _acceptingShareIds = [];
    private DateTimeOffset? _otherPartyReadUpToUtc;
    private ChatConversationAccessDto? _conversationAccess;
    private string _draftMessage = string.Empty;
    private bool _isSending;
    private bool _isApprovingConversation;
    private bool _encryptionUnavailable;
    private bool _encryptionKeyLocked;
    private IJSObjectReference? _cryptoModule;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCancellation;

    /// <summary>True when the other party started this conversation and it's still waiting on this user's "Allow" click.</summary>
    private bool RequiresApprovalFromMe
        => _conversationAccess is { IsApproved: false } access && access.InitiatedByUserId != _ownUserId;

    /// <summary>True when this user started the conversation and it's still waiting on the other party's approval.</summary>
    private bool IsPendingApprovalFromOtherParty
        => _conversationAccess is { IsApproved: false } access && access.InitiatedByUserId == _ownUserId;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _ownUserId = Guid.Parse(authenticationState.User.FindFirst("sub")!.Value);

        try
        {
            await OwnEncryptionKeyProvider.EnsurePublicKeyAsync();
            _cryptoModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/e2eeChat.js");
            _contacts = await ChatApiClient.GetContactsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (JSException exception)
        {
            // crypto.subtle (which e2eeChat.js needs for every key/encrypt/decrypt operation) is only
            // exposed by browsers in a secure context - HTTPS, or the special-cased
            // "localhost"/"127.0.0.1" hosts (see README.md's "Accessing Orbit.Web from another device
            // on your network"). Unlike MainLayout's best-effort key publishing, chat genuinely cannot
            // work without this, so rather than silently continuing into a broken chat window, this
            // stops here and renders a dedicated explanation instead (see the markup above).
            Logger.LogError(exception, "End-to-end encryption is unavailable in this browsing context");
            _encryptionUnavailable = true;
            return;
        }
        catch (EncryptionKeyLockedException)
        {
            // This browser has no local private key for the signed-in user - unlike MainLayout's
            // best-effort publishing, this genuinely blocks chatting, so it's surfaced with a dedicated
            // explanation and a way out (see the markup above and ReauthenticateAsync below) instead of
            // silently generating a fresh key pair here, which would orphan any existing backup.
            _encryptionKeyLocked = true;
            return;
        }

        await LoadConversationForCurrentUserAsync();
    }

    /// <summary>
    /// The drawer (see the markup above) lets the user switch contacts without leaving this page, which
    /// Blazor's router treats as a parameter change on the same component instance rather than a fresh
    /// page load - so unlike a normal navigation-in from Dashboard/Contacts, OnInitializedAsync does NOT
    /// run again. This re-runs the same per-contact setup whenever UserId actually changes.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_encryptionUnavailable || _encryptionKeyLocked || UserId == _loadedUserId)
        {
            return;
        }

        await LoadConversationForCurrentUserAsync();
    }

    private async Task LoadConversationForCurrentUserAsync()
    {
        StopPolling();
        _loadedUserId = UserId;
        _isDrawerOpen = false;
        _otherUser = null;
        _messages.Clear();
        _decryptedContentByMessageId.Clear();
        _shareNoticeByMessageId.Clear();
        _acceptedShareIds.Clear();
        _acceptingShareIds.Clear();
        _otherPartyReadUpToUtc = null;
        _conversationAccess = null;
        _draftMessage = string.Empty;

        try
        {
            _otherUser = await UsersApiClient.GetUserAsync(UserId);
            if (_otherUser is null)
            {
                NavigationManager.NavigateTo("/contacts");
                return;
            }

            await LoadConversationAccessAsync();
            await LoadNewMessagesAsync();
            await SyncReadStateAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        StartPolling();
    }

    /// <summary>
    /// Signs the user out and sends them back to the login page, where a fresh sign-in runs
    /// OwnEncryptionKeyProvider.UnlockOrCreateAsync with the password needed to restore this browser's
    /// private key from its server-side backup.
    /// </summary>
    private async Task ReauthenticateAsync()
    {
        await AuthApiClient.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    private void ToggleDrawer() => _isDrawerOpen = !_isDrawerOpen;

    private void ToggleContactListCollapsed() => _isContactListCollapsed = !_isContactListCollapsed;

    private void ToggleMessageMenu(Guid messageId) => _openMessageMenuId = _openMessageMenuId == messageId ? null : messageId;

    /// <summary>Bound to a click anywhere in the message list, so opening one message's menu closes any other and clicking elsewhere closes it - same outside-click pattern as MainLayout's avatar dropdown.</summary>
    private void CloseMessageMenu()
    {
        if (_openMessageMenuId is not null)
        {
            _openMessageMenuId = null;
        }
    }

    private void StartEdit(ChatMessageDto message)
    {
        _openMessageMenuId = null;
        _editingMessageId = message.Id;
        _editDraftText = _decryptedContentByMessageId.GetValueOrDefault(message.Id) ?? string.Empty;
    }

    private void CancelEdit()
    {
        _editingMessageId = null;
        _editDraftText = string.Empty;
    }

    private async Task SaveEditAsync(ChatMessageDto message)
    {
        var newText = _editDraftText.Trim();
        if (newText.Length == 0 || _otherUser?.PublicKeyBase64 is null || _cryptoModule is null)
        {
            return;
        }

        _isSavingEdit = true;
        try
        {
            var payload = await _cryptoModule.InvokeAsync<EncryptedPayload>(
                "encryptMessage", _ownUserId, _otherUser.PublicKeyBase64, newText);
            var updated = await ChatApiClient.EditMessageAsync(message.Id, new EditMessageRequest(payload.CiphertextBase64, payload.NonceBase64));

            var index = _messages.FindIndex(existing => existing.Id == message.Id);
            if (index >= 0)
            {
                _messages[index] = updated;
            }
            _decryptedContentByMessageId[message.Id] = newText;
            _editingMessageId = null;
            _editDraftText = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // Left in edit mode (not cleared) so the user's edit isn't lost and they can just retry -
            // mirrors SendMessageAsync's handling of the same failure.
            Logger.LogError(exception, "Failed to edit chat message {MessageId}", message.Id);
        }
        finally
        {
            _isSavingEdit = false;
        }
    }

    private void CloseDrawer() => _isDrawerOpen = false;

    private void SwitchContact(Guid userId)
    {
        _isDrawerOpen = false;
        if (userId != UserId)
        {
            Logger.LogInformation("User switched conversations from the drawer ({ContactUserId})", userId);
            NavigationManager.NavigateTo($"/chat/{userId}");
        }
    }


    private void StartPolling()
    {
        _pollCancellation = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = PollAsync(_pollCancellation.Token);
    }

    private void StopPolling()
    {
        _pollCancellation?.Cancel();
        _pollCancellation?.Dispose();
        _pollCancellation = null;
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await PollOnceAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away, the user switches contacts, or DisposeAsync cancels polling.
        }
        catch (ObjectDisposedException)
        {
            // The timer was disposed by StopPolling (contact switch) between a tick starting and this
            // loop checking again - same "stop quietly" handling as the cancellation above.
        }
    }

    /// <summary>
    /// A single poll tick's worth of work, isolated so a transient failure (a brief server hiccup, or
    /// the session having just expired) only gives up on this one tick instead of silently killing the
    /// whole poll loop - and with it, live updates - for the rest of the time this chat window stays open.
    /// </summary>
    private async Task PollOnceAsync()
    {
        try
        {
            // Refreshed on every tick (not just once on load) so a "chat request" banner or a disabled
            // compose box clears itself as soon as the other party approves, without needing a reload.
            await LoadConversationAccessAsync();
            await LoadNewMessagesAsync();
            await SyncReadStateAsync();
            // Keeps the drawer's contact list current - most relevantly, this is what makes a
            // conversation started just now (the contact only exists server-side after its first
            // message - see ChatMessageHandler) show up in the drawer without a full page reload.
            _contacts = await ChatApiClient.GetContactsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Session expired while this chat window was already open and polling - same handling as
            // the initial load in OnInitializedAsync, just reached from the background poll loop instead.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to poll for new messages with user {OtherUserId}", UserId);
        }
    }

    private async Task LoadNewMessagesAsync()
    {
        var sinceUtc = _messages.Count > 0 ? _messages[^1].SentAtUtc : (DateTimeOffset?)null;
        var newMessages = await ChatApiClient.GetConversationAsync(UserId, sinceUtc);
        foreach (var message in newMessages)
        {
            // GetConversationAsync's "since" filter can re-return the very message that was just added
            // optimistically by SendMessageAsync (same SentAtUtc as the "since" cursor) - skipping an
            // id already present keeps a poll tick from duplicating it in the list.
            if (_messages.Any(existing => existing.Id == message.Id))
            {
                continue;
            }

            _messages.Add(message);
            await DecryptAndCacheAsync(message);
        }
    }

    /// <summary>
    /// Treats "this chat window is open and actively polling" as "read" - a coarse stand-in for the
    /// other party's messages actually being seen (it fires even with the browser tab backgrounded).
    /// TODO: replace with real on-screen visibility tracking (tab focus / scroll position) once the
    /// chat has a way to push that signal to the server instead of relying on this poll loop.
    /// </summary>
    private async Task SyncReadStateAsync()
    {
        await ChatApiClient.MarkConversationAsReadAsync(UserId);
        _otherPartyReadUpToUtc = await ChatApiClient.GetReadReceiptAsync(UserId);
    }

    /// <summary>True once the other party has read up to at least this own message's send time.</summary>
    private bool IsReadByOtherParty(ChatMessageDto message)
        => _otherPartyReadUpToUtc is { } readUpToUtc && message.SentAtUtc <= readUpToUtc;

    private async Task LoadConversationAccessAsync()
    {
        _conversationAccess = await ChatApiClient.GetConversationAccessAsync(UserId);
    }

    private async Task ApproveConversationAsync()
    {
        _isApprovingConversation = true;
        try
        {
            await ChatApiClient.ApproveConversationAsync(UserId);
            await LoadConversationAccessAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to approve chatting with user {OtherUserId}", UserId);
        }
        finally
        {
            _isApprovingConversation = false;
        }
    }

    private async Task DecryptAndCacheAsync(ChatMessageDto message)
    {
        if (_otherUser?.PublicKeyBase64 is null || _cryptoModule is null)
        {
            return;
        }

        var plainText = await _cryptoModule.InvokeAsync<string?>(
            "decryptMessage", _ownUserId, _otherUser.PublicKeyBase64, message.CiphertextBase64, message.NonceBase64);
        if (plainText is null)
        {
            return;
        }

        if (TryParseShare(plainText) is { } shareNotice)
        {
            _shareNoticeByMessageId[message.Id] = shareNotice;
            _decryptedContentByMessageId[message.Id] = shareNotice.Description;
            // Reflects an acceptance that may have happened in an earlier session (or after a reload),
            // so the button doesn't misleadingly offer "Accept" again for something already accepted.
            // Skipped for a share this user sent themselves - the status endpoint is scoped to the
            // recipient, so it would just be a guaranteed-404 lookup for those.
            if (message.SenderUserId != _ownUserId && await shareNotice.GetStatusAsync() == true)
            {
                _acceptedShareIds.Add(shareNotice.ShareId);
            }

            return;
        }

        _decryptedContentByMessageId[message.Id] = plainText;
    }

    /// <summary>
    /// A decrypted message's plaintext is ordinary user-typed text unless it happens to parse as one of
    /// the three structured share shapes (see EventShareMessagePayload/NoteShareMessagePayload/
    /// TaskListShareMessagePayload) - anything else, including JSON that just doesn't match any of them,
    /// is treated as plain text rather than surfacing a parse error.
    /// </summary>
    private ShareNotice? TryParseShare(string plainText)
    {
        if (TryDeserialize<EventShareMessagePayload>(plainText) is { Type: EventShareMessagePayload.MessageType } eventShare)
        {
            return new ShareNotice(
                eventShare.ShareId, $"Shared an event: {eventShare.EventTitle}",
                () => CalendarApiClient.GetCalendarEventShareStatusAsync(eventShare.ShareId),
                () => CalendarApiClient.AcceptCalendarEventShareAsync(eventShare.ShareId));
        }

        if (TryDeserialize<NoteShareMessagePayload>(plainText) is { Type: NoteShareMessagePayload.MessageType } noteShare)
        {
            return new ShareNotice(
                noteShare.ShareId, $"Shared a note: {noteShare.NoteTitle}",
                () => NotesApiClient.GetNoteShareStatusAsync(noteShare.ShareId),
                () => NotesApiClient.AcceptNoteShareAsync(noteShare.ShareId));
        }

        if (TryDeserialize<TaskListShareMessagePayload>(plainText) is { Type: TaskListShareMessagePayload.MessageType } taskListShare)
        {
            return new ShareNotice(
                taskListShare.ShareId, $"Shared a task list: {taskListShare.TaskListTitle}",
                () => TasksApiClient.GetTaskListShareStatusAsync(taskListShare.ShareId),
                () => TasksApiClient.AcceptTaskListShareAsync(taskListShare.ShareId));
        }

        return null;
    }

    private static T? TryDeserialize<T>(string plainText) where T : class
    {
        try
        {
            return JsonSerializer.Deserialize<T>(plainText);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private async Task AcceptShareAsync(ShareNotice shareNotice)
    {
        _acceptingShareIds.Add(shareNotice.ShareId);
        try
        {
            if (await shareNotice.AcceptAsync())
            {
                _acceptedShareIds.Add(shareNotice.ShareId);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // Left off _acceptedShareIds, so the "Accept" button just reappears - that absence is the
            // only feedback the user gets that this didn't go through (see the class-level note on why
            // this mechanism logs rather than showing a dedicated failure message).
            Logger.LogError(exception, "Failed to accept share {ShareId}", shareNotice.ShareId);
        }
        finally
        {
            _acceptingShareIds.Remove(shareNotice.ShareId);
        }
    }

    /// <summary>
    /// One of the three kinds of share a chat message can carry, normalized to a single shape so the
    /// message-rendering loop and AcceptShareAsync don't need to know which kind they're looking at - see
    /// TryParseShare.
    /// </summary>
    private sealed record ShareNotice(
        Guid ShareId, string Description, Func<Task<bool?>> GetStatusAsync, Func<Task<bool>> AcceptAsync);

    private async Task OnDraftKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftMessage) || _otherUser?.PublicKeyBase64 is null || _cryptoModule is null)
        {
            return;
        }

        _isSending = true;
        try
        {
            var payload = await _cryptoModule.InvokeAsync<EncryptedPayload>(
                "encryptMessage", _ownUserId, _otherUser.PublicKeyBase64, _draftMessage);
            var sent = await ChatApiClient.SendMessageAsync(
                new SendMessageRequest(UserId, payload.CiphertextBase64, payload.NonceBase64));

            _messages.Add(sent);
            _decryptedContentByMessageId[sent.Id] = _draftMessage;
            _draftMessage = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // The draft is deliberately left in _draftMessage (not cleared) and nothing is appended to
            // _messages - that's the only signal the user gets that the message wasn't sent, so they can
            // just retry instead of retyping it.
            Logger.LogError(exception, "Failed to send a chat message to user {RecipientUserId}", UserId);
        }
        finally
        {
            _isSending = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        StopPolling();
        if (_cryptoModule is not null)
        {
            await _cryptoModule.DisposeAsync();
        }
    }

    /// <summary>Shape returned by e2eeChat.js's encryptMessage - matched by camelCase property name.</summary>
    private sealed record EncryptedPayload(string CiphertextBase64, string NonceBase64);
}
