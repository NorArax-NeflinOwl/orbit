@page "/chat/{userId:guid}"
@* A group is a conversation like any other, so it opens on the same page rather than on one of its
   own - same list down the side, same thread, same header. It used to be a separate screen, which made
   switching between a person and a group a change of page and left two places to look for "who have I
   been talking to". See GroupConversation for the part that is genuinely different about a group. *@
@page "/chat/groups"
@page "/chat/groups/{GroupId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Users
@using Orbit.Core.Users
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject ChatApiClient ChatApiClient
@inject CalendarApiClient CalendarApiClient
@inject NotesApiClient NotesApiClient
@inject TasksApiClient TasksApiClient
@inject InventoryApiClient InventoryApiClient
@inject NotificationFeedState NotificationFeedState
@inject PageVisibility PageVisibility
@inject PanelPreferences Panels
@inject NotificationsApiClient NotificationsApiClient
@inject UsersApiClient UsersApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject AuthApiClient AuthApiClient
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<Chat> Logger
@inject UserPermissionState Permissions
@inject Translations T
@inject LiveUpdatesConnection LiveUpdates

<PageTitle>@T["Orbit — Chat"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@T["Messages"]</h1>
        <p class="page-subtitle">@T["End-to-end encrypted conversations."]</p>
    </div>
</div>

@if (!Permissions.Has(ApplicationPermission.Chat))
{
    <FeatureLocked Explanation="@(T["Conversations, with one person or with several."])" />
}
else
{

    @if (_loadErrorMessage is not null)
    {
        <p class="error">@_loadErrorMessage</p>
        <button type="button" class="btn-secondary" @onclick="GoToContacts">@T["Contacts"]</button>
    }
    else if (_encryptionUnavailable)
    {
        <p>
            @T["Chat requires a secure connection (an address starting with \"https://\", or \"http://localhost\"). Open Orbit at such an address and try again."]
        </p>
    }
    else if (_encryptionKeyLocked)
    {
        @* Replaces what used to be a dead end ("log out and log back in"): the password is all that's needed
           to restore the key, so it's asked for here instead of sending the user around the login page. *@
        <ChatPasswordGate OnUnlocked="OnEncryptionKeyUnlockedAsync" />
    }
    else if (!IsGroupMode && _otherUser is null)
    {
        <p>@T["Loading…"]</p>
    }
    else
    {
        <div class="chat-layout">
            <div class="chat-list-backdrop @(_isDrawerOpen ? "open" : "")" @onclick="CloseDrawer"></div>
            <ConversationList Conversations="Conversations" ActiveId="ActiveConversationId" IsOpen="_isDrawerOpen"
                              IsCollapsed="_isContactListCollapsed" OnToggleCollapsed="ToggleContactListCollapsedAsync"
                              Search="@_chatSearch" SearchChanged="value => _chatSearch = value"
                              OnSelected="OpenConversation" OnNewGroup="StartCreatingGroup" />

            <div class="chat-thread">
                @if (ActiveConversationName is { } activeName)
                {
                    <div class="chat-thread-header">
                        <button type="button" class="icon-btn chat-list-toggle" title="@(T["Conversations"])" @onclick="ToggleDrawer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
                        </button>
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(ActiveConversationId);width:34px;height:34px;font-size:12.5px;">@AvatarHelper.GetInitials(activeName)</span>
                        <div>
                            <div class="chat-thread-name">@activeName</div>
                        </div>
                        @* Everything about the conversation itself, behind one trigger in the corner -
                           the same shape a message's own menu uses, so the two read as one idea. *@
                        <div class="chat-thread-menu">
                            <button type="button" class="icon-btn chat-thread-menu-trigger" title="@(T["Conversation options"])"
                                    @onclick="ToggleConversationMenu" @onclick:stopPropagation="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><circle cx="10" cy="4" r="1.7" /><circle cx="10" cy="10" r="1.7" /><circle cx="10" cy="16" r="1.7" /></svg>
                            </button>
                            @if (_isConversationMenuOpen)
                            {
                                <div class="chat-bubble-menu-dropdown chat-thread-menu-dropdown" @onclick:stopPropagation="true">
                                    @if (IsGroupMode)
                                    {
                                        <button type="button" class="avatar-dropdown-item" @onclick="GoToGroupMembers">@T["Members"]</button>
                                        <button type="button" class="avatar-dropdown-item" @onclick="GoToGroupInfo">@T["Info"]</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="avatar-dropdown-item" @onclick="GoToContactInfo">@T["Info"]</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (IsGroupMode)
                {
                    @if (_isCreatingGroup)
                    {
                        <div class="card group-create-card">
                            <div class="field">
                                <label for="groupNameInput">@T["Group name"]</label>
                                <input id="groupNameInput" @bind="_newGroupName" @bind:event="oninput" placeholder="@(T["Weekend trip"])" />
                            </div>
                            <div class="field">
                                <label>@T["Who's in it"]</label>
                                @if (_contacts.Count == 0)
                                {
                                    <p class="empty-hint">@T["You need at least one contact to start a group."]</p>
                                }
                                else
                                {
                                    @foreach (var contact in _establishedChats)
                                    {
                                        <label class="check-row">
                                            <input type="checkbox" checked="@_newGroupMemberIds.Contains(contact.UserId)"
                                                   @onchange="args => ToggleNewGroupMember(contact.UserId, (bool)args.Value!)" />
                                            <span class="check-row-text">@contact.DisplayName</span>
                                        </label>
                                    }
                                }
                            </div>
                            @if (_groupErrorMessage is not null)
                            {
                                <p class="error">@_groupErrorMessage</p>
                            }
                            <div class="form-actions">
                                <button type="button" class="btn-primary" disabled="@(_isCreatingGroupBusy || _newGroupName.Trim().Length == 0)"
                                        @onclick="CreateGroupAsync">@T["Create"]</button>
                                <button type="button" class="btn-secondary" @onclick="CancelCreatingGroup">@T["Cancel"]</button>
                            </div>
                        </div>
                    }
                    else if (_selectedGroup is { } selectedGroup)
                    {
                        <GroupConversation Group="selectedGroup" OwnUserId="_ownUserId" Contacts="_contacts" />
                    }
                    else if (GroupId is not null && !_areConversationsLoaded)
                    {
                        @* Opening a group's own address directly: the list it is looked up in is still
                           on its way, and "pick one" would be answering a question nobody asked. *@
                        <p>@T["Loading…"]</p>
                    }
                    else
                    {
                        <p class="empty-hint">@T["Pick a conversation from the list, or start a new group."]</p>
                    }
                }
                else if (_otherUser is null)
                {
                    <p>@T["Loading…"]</p>
                }
                else
                {
                @if (_otherUser.PublicKeyBase64 is null)
                {
                    <p>
                        @T.Format("{0} hasn't set up encryption yet - they need to log in in their own browser first before you can message them.", _otherUser.DisplayName)
                    </p>
                }
                else
                {
                    @if (RequiresApprovalFromMe)
                    {
                        <p class="chat-request-banner">
                            @T.Format("{0} wants to chat with you.", _otherUser.DisplayName)
                            <button type="button" class="btn-primary" disabled="@_isApprovingConversation" @onclick="ApproveConversationAsync">@T["Allow chatting"]</button>
                        </p>
                    }
                    else if (IsPendingApprovalFromOtherParty)
                    {
                        <p class="chat-request-banner">@T.Format("Message is waiting for {0} to approve.", _otherUser.DisplayName)</p>
                    }

                    <div class="chat-messages" @ref="_messageListElement" @onclick="CloseMessageMenu">
                        @{ DateTime? previousMessageDate = null; }
                        @foreach (var message in _messages)
                        {
                            var isShareNotice = _shareNoticeByMessageId.ContainsKey(message.Id);
                            var hasContent = _decryptedContentByMessageId.ContainsKey(message.Id);
                            var canEdit = message.SenderUserId == _ownUserId && !isShareNotice
                                && !_forwardedFromByMessageId.ContainsKey(message.Id) && hasContent;
                            var canForward = !isShareNotice && hasContent;
                            var messageDate = message.SentAtUtc.ToLocalTime().Date;
                            var showDaySeparator = previousMessageDate != messageDate;
                            previousMessageDate = messageDate;

                            @if (showDaySeparator)
                            {
                                <div class="chat-day-separator"><span>@FormatDaySeparatorLabel(messageDate)</span></div>
                            }

                            <div class="chat-bubble-row @(message.SenderUserId == _ownUserId ? "own" : "theirs")">
                                @if (_editingMessageId == message.Id)
                                {
                                    <div class="chat-bubble-edit" @onclick:stopPropagation="true">
                                        <input class="chat-input" @bind="_editDraftText" @bind:event="oninput" />
                                        <div class="chat-bubble-edit-actions">
                                            <button type="button" class="btn-secondary" @onclick="CancelEdit">@T["Cancel"]</button>
                                            <button type="button" class="btn-primary" disabled="@(_isSavingEdit || _editDraftText.Trim().Length == 0)"
                                                    @onclick="() => SaveEditAsync(message)">@T["Save"]</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="chat-bubble-wrap">
                                        <p class="chat-bubble @(_highlightedMessageId == message.Id ? "highlighted" : "")"
                                           id="@MessageElementId(message.Id)">
                                            @if (_forwardedFromByMessageId.TryGetValue(message.Id, out var forwardedFromDisplayName))
                                            {
                                                <span class="chat-bubble-forwarded-label">@T.Format("Forwarded from {0}", forwardedFromDisplayName)</span>
                                            }
                                            @if (_replyToByMessageId.TryGetValue(message.Id, out var quoted))
                                            {
                                                @* Clickable: the reference is what makes a reply readable in a long
                                                   conversation, and it is only worth carrying if it takes you there. *@
                                                <button type="button" class="chat-bubble-quote"
                                                        @onclick="() => ScrollToQuotedMessageAsync(quoted.MessageId)"
                                                        @onclick:stopPropagation="true">
                                                    @quoted.Preview
                                                </button>
                                            }
                                            @(_decryptedContentByMessageId.GetValueOrDefault(message.Id) ?? T["[couldn't decrypt]"])
                                        </p>
                                        @if (canEdit || canForward)
                                        {
                                            <div class="chat-bubble-menu"
                                                 @onfocusout="CloseTheMessageMenuIfFocusLeftAsync"
                                                 @onfocusin="() => _menuKeptFocus = true">
                                                <button type="button" class="icon-btn chat-bubble-menu-trigger" title="@(T["Message options"])"
                                                        @onclick="() => ToggleMessageMenu(message.Id)" @onclick:stopPropagation="true">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><circle cx="4" cy="10" r="1.6" /><circle cx="10" cy="10" r="1.6" /><circle cx="16" cy="10" r="1.6" /></svg>
                                                </button>
                                                @if (_openMessageMenuId == message.Id)
                                                {
                                                    <div class="chat-bubble-menu-dropdown" @ref="_openMenuElement"
                                                         @onclick:stopPropagation="true">
                                                        @if (canEdit)
                                                        {
                                                            <button type="button" class="avatar-dropdown-item" @onclick="() => StartEdit(message)">@T["Edit"]</button>
                                                        }
                                                        @if (canForward)
                                                        {
                                                            <button type="button" class="avatar-dropdown-item" @onclick="() => StartReply(message)">@T["Reply"]</button>
                                                            <button type="button" class="avatar-dropdown-item" @onclick="() => StartForward(message)">@T["Forward"]</button>
                                                        }
                                                    </div>
                                                }
                                                @if (_forwardingMessageId == message.Id)
                                                {
                                                    <div class="chat-bubble-menu-dropdown chat-forward-picker" @ref="_openMenuElement"
                                                         @onclick:stopPropagation="true">
                                                        <div class="chat-forward-picker-title">@T["Forward to…"]</div>
                                                        @foreach (var forwardTarget in _forwardableContacts)
                                                        {
                                                            <button type="button" class="avatar-dropdown-item" disabled="@_isForwarding"
                                                                    @onclick="() => ForwardMessageAsync(message, forwardTarget)">
                                                                @forwardTarget.DisplayName
                                                            </button>
                                                        }
                                                        @if (!_forwardableContacts.Any())
                                                        {
                                                            <span class="chat-forward-picker-empty">@T["No other chats yet."]</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <span class="chat-bubble-meta">
                                        @message.SentAtUtc.ToLocalTime().ToString("HH:mm")
                                        @if (message.IsEdited)
                                        {
                                            <text>@T["· Edited"]</text>
                                        }
                                        @if (message.SenderUserId == _ownUserId)
                                        {
                                            @(IsReadByOtherParty(message) ? T[" · Read"] : T[" · Sent"])
                                        }
                                    </span>
                                    @if (_forwardErrorMessage is not null && _forwardErrorMessageForMessageId == message.Id)
                                    {
                                        <span class="chat-bubble-meta chat-forward-error">@_forwardErrorMessage</span>
                                    }
                                }
                            </div>
                            @if (message.SenderUserId != _ownUserId && _editAccessRequestByMessageId.TryGetValue(message.Id, out var editAccessRequest))
                            {
                                @if (_grantedEditAccessMessageIds.Contains(message.Id))
                                {
                                    <p class="event-share-status">@T["They can edit it now."]</p>
                                }
                                else
                                {
                                    <button type="button" class="btn-secondary" disabled="@_grantingEditAccessMessageIds.Contains(message.Id)"
                                            @onclick="() => GrantEditAccessAsync(message.Id, editAccessRequest)">@T["Allow editing"]</button>
                                }
                            }
                            @if (message.SenderUserId != _ownUserId && _shareNoticeByMessageId.TryGetValue(message.Id, out var shareNotice))
                            {
                                @if (_acceptedShareIds.Contains(shareNotice.ShareId))
                                {
                                    <p class="event-share-status">@T["Accepted - added to your account."]</p>
                                }
                                else
                                {
                                    <button type="button" class="btn-secondary" disabled="@_acceptingShareIds.Contains(shareNotice.ShareId)"
                                            @onclick="() => AcceptShareAsync(shareNotice)">@T["Accept"]</button>
                                }
                            }
                        }
                        @if (_isJumpToNewestVisible)
                        {
                            <button type="button" class="chat-jump-to-newest" title="@(T["Jump to newest message"])"
                                    @onclick="ScrollToNewestMessageAsync" @onclick:stopPropagation="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10 4v12M5 11l5 5 5-5" />
                                </svg>
                            </button>
                        }
                    </div>

                    @if (_replyingTo is { } replyTarget)
                    {
                        <div class="chat-reply-strip">
                            <span class="chat-reply-strip-label">@T["Replying to"]</span>
                            <span class="chat-reply-strip-preview">
                                @ReplyMessagePayload.Preview(_decryptedContentByMessageId.GetValueOrDefault(replyTarget.Id) ?? string.Empty)
                            </span>
                            <button type="button" class="icon-btn" title="@(T["Stop replying"])" @onclick="CancelReply">✕</button>
                        </div>
                    }

                    <div class="chat-input-bar">
                        <input class="chat-input" @bind="_draftMessage" @bind:event="oninput" @onkeydown="OnDraftKeyDownAsync" placeholder="@(T["Write a message…"])"
                               disabled="@RequiresApprovalFromMe" />
                        <button type="button" class="btn-primary" @onclick="SendMessageAsync" disabled="@(_isSending || RequiresApprovalFromMe)">@T["Send"]</button>
                    </div>
                }
                }
            </div>
        </div>
    }

}

@code {



    [Parameter]
    public Guid UserId { get; set; }

    /// <summary>The group on screen, when this page was reached by one of the /chat/groups routes.</summary>
    [Parameter]
    public Guid? GroupId { get; set; }

    /// <summary>
    /// Whether the page is showing groups rather than a person. True for /chat/groups even with no group
    /// named: that is the conversation list with nothing opened yet, not a conversation with nobody.
    /// </summary>
    private bool IsGroupMode => NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
        .StartsWith("chat/groups", StringComparison.OrdinalIgnoreCase);

    private ChatGroupDto? _selectedGroup => GroupId is { } groupId
        ? _groups.FirstOrDefault(group => group.Id == groupId)
        : null;

    /// <summary>Which row in the conversation list is the open one - a group's id or a person's.</summary>
    private Guid ActiveConversationId => IsGroupMode ? GroupId ?? Guid.Empty : UserId;

    /// <summary>What the thread is headed with, or null when nothing is open yet.</summary>
    private string? ActiveConversationName
        => IsGroupMode ? _selectedGroup?.Name : _otherUser?.DisplayName;

    /// <summary>Whether the conversation's own menu (Info, and a group's Members) is showing.</summary>
    private bool _isConversationMenuOpen;

    /// <summary>Whether the people and groups have arrived - what tells "no such group" apart from "not yet".</summary>
    private bool _areConversationsLoaded;

    private bool _isCreatingGroup;
    private bool _isCreatingGroupBusy;
    private string _newGroupName = string.Empty;
    private readonly HashSet<Guid> _newGroupMemberIds = [];
    private string? _groupErrorMessage;

    private Guid _ownUserId;
    private Guid _loadedUserId;
    private UserSearchResultDto? _otherUser;
    private readonly List<ChatMessageDto> _messages = [];
    private readonly Dictionary<Guid, string> _decryptedContentByMessageId = [];
    private IReadOnlyList<ContactDto> _contacts = [];

    /// <summary>The groups this reader is in - rows in the same list as the people, see ConversationList.</summary>
    private IReadOnlyList<ChatGroupDto> _groups = [];
    private bool _isDrawerOpen;

    /// <summary>
    /// Desktop-only: collapses the contact list to just avatars (see .chat-list.collapsed in app.css) -
    /// independent of _isDrawerOpen, which is the mobile off-canvas open/closed state. Defaults to
    /// collapsed so the message thread gets the extra width by default on a typical visit; the toggle
    /// button in .chat-list-header lets the user expand it back to full names.
    /// </summary>
    /// <summary>
    /// Whether the conversation list is folded to initials. Starts folded, and is remembered on the
    /// device once somebody says otherwise - see PanelPreferences: unfolding it on every visit to a
    /// page somebody lives in is a chore, not a default.
    /// </summary>
    private bool _isContactListCollapsed = true;

    /// <summary>
    /// The scrollable message list, needed because scroll position can only be read/set from JS (see
    /// wwwroot/js/chatScroll.js).
    /// </summary>
    private ElementReference _messageListElement;

    /// <summary>Set whenever the next render should land on the newest message - opening a conversation, and receiving a message while already at the bottom.</summary>
    private bool _scrollToNewestOnNextRender;

    /// <summary>Whether the "jump to newest" button shows, i.e. the user has scrolled up far enough that new messages would arrive off-screen.</summary>
    private bool _isJumpToNewestVisible;

    /// <summary>Kept alive for as long as chatScroll.js holds the scroll listener that calls back into OnMessageListScrolled.</summary>
    private DotNetObjectReference<Chat>? _scrollObserverReference;

    private bool _isScrollObserverAttached;

    /// <summary>Which message's "..." dropdown ("Edit" and/or "Forward") is open, if any.</summary>
    private Guid? _openMessageMenuId;

    /// <summary>Which own message is currently showing its inline edit box instead of its normal bubble, if any.</summary>
    private Guid? _editingMessageId;
    private string _editDraftText = string.Empty;
    private bool _isSavingEdit;

    /// <summary>Which message is currently showing its "Forward to…" contact picker in place of the Edit/Forward menu, if any.</summary>
    private Guid? _forwardingMessageId;

    /// <summary>The message the draft is answering, if any - see ReplyMessagePayload.</summary>
    private ChatMessageDto? _replyingTo;

    /// <summary>What each reply is answering, keyed by the reply's own id. Kept apart from the decrypted text the same way share notices are.</summary>
    private readonly Dictionary<Guid, QuotedMessage> _replyToByMessageId = [];

    /// <summary>Briefly marks the message a quote just jumped to, so the eye lands on it.</summary>
    private Guid? _highlightedMessageId;

    /// <param name="Preview">Carried by the reply rather than read back from the original, which may have been edited or deleted since.</param>
    private sealed record QuotedMessage(Guid MessageId, string Preview);
    private bool _isForwarding;
    private string? _forwardErrorMessage;
    private Guid? _forwardErrorMessageForMessageId;

    /// <summary>
    /// The identity of whoever originally wrote a message this user received as a forward, keyed by the
    /// forwarded message's own id - populated in DecryptAndCacheAsync from ForwardedMessagePayload. Kept
    /// separate from _decryptedContentByMessageId (which holds just the forwarded text itself) the same
    /// way _shareNoticeByMessageId is kept separate, so the plain-text rendering path doesn't need to
    /// know about either special case.
    /// </summary>
    private readonly Dictionary<Guid, string> _forwardedFromByMessageId = [];

    /// <summary>Every established chat except the one currently open - forwarding into the same conversation would be a no-op.</summary>
    private IEnumerable<ContactDto> _forwardableContacts => _establishedChats.Where(contact => contact.UserId != UserId);

    /// <summary>The drawer's contact list - already-established conversations only, most recently active first (matches Contacts.razor's own "Chats" filter).</summary>
    private IEnumerable<ContactDto> _establishedChats
        => _contacts.Where(contact => !contact.RequiresApprovalFromCurrentUser).OrderByDescending(contact => contact.LastMessageAtUtc);

    /// <summary>What the reader has typed into the drawer's search box.</summary>
    private string _chatSearch = string.Empty;

    /// <summary>
    /// The conversations left after the search box. Filtered here rather than on the server: the drawer
    /// already holds every contact, and a list short enough to scroll is short enough to filter.
    /// Matches the display name and the login, since either is what someone might type.
    /// </summary>
    private IEnumerable<ContactDto> _matchingChats
    {
        get
        {
            var query = _chatSearch.Trim();
            if (query.Length == 0)
            {
                return _establishedChats;
            }

            return _establishedChats.Where(contact =>
                contact.DisplayName.Contains(query, StringComparison.CurrentCultureIgnoreCase)
                || contact.UserName.Contains(query, StringComparison.CurrentCultureIgnoreCase));
        }
    }

    /// <summary>
    /// Populated for a message that decrypts to one of the three share payload shapes (calendar event,
    /// note, or task list - see EventShareMessagePayload/NoteShareMessagePayload/TaskListShareMessagePayload),
    /// with whichever ApiClient call accepting that particular kind of share already bound in - see
    /// DecryptAndCacheAsync. This is what lets the single AcceptShareAsync/rendering block below handle
    /// all three kinds without three near-identical copies of the accept/status-tracking logic.
    /// </summary>
    private readonly Dictionary<Guid, ShareNotice> _shareNoticeByMessageId = [];
    private readonly Dictionary<Guid, EditAccessRequestNotice> _editAccessRequestByMessageId = [];
    private readonly HashSet<Guid> _grantedEditAccessMessageIds = [];
    private readonly HashSet<Guid> _grantingEditAccessMessageIds = [];

    /// <summary>
    /// Shares known to be accepted - seeded from the matching ApiClient's GetXShareStatusAsync when a
    /// share message is first decrypted (see DecryptAndCacheAsync), and updated immediately when the user
    /// clicks "Accept" rather than waiting on a re-fetch. Keeping this cache is what lets the message list
    /// avoid a status round-trip on every render. Shared across all three share kinds since each share id
    /// is an independently generated Guid - collisions across domains are not a realistic concern.
    /// </summary>
    private readonly HashSet<Guid> _acceptedShareIds = [];
    private readonly HashSet<Guid> _acceptingShareIds = [];
    private DateTimeOffset? _otherPartyReadUpToUtc;
    private ChatConversationAccessDto? _conversationAccess;
    private string _draftMessage = string.Empty;
    private bool _isSending;
    private bool _isApprovingConversation;
    private bool _encryptionUnavailable;
    private string? _loadErrorMessage;
    private bool _encryptionKeyLocked;
    private IJSObjectReference? _cryptoModule;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCancellation;

    /// <summary>
    /// How many message polls pass between reads of the conversation list. Ten seconds at the poll's
    /// own one-second tick - the same interval MainLayout already refreshes its notification feed on,
    /// which is the other thing on screen that answers "has anything changed elsewhere".
    /// </summary>
    private const int TicksBetweenListReads = 10;

    /// <summary>Starts at the limit so the first tick reads the list rather than waiting ten seconds for it.</summary>
    private int _ticksSinceTheListWasRead = TicksBetweenListReads;

    /// <summary>True when the other party started this conversation and it's still waiting on this user's "Allow" click.</summary>
    private bool RequiresApprovalFromMe
        => _conversationAccess is { IsApproved: false } access && access.InitiatedByUserId != _ownUserId;

    /// <summary>True when this user started the conversation and it's still waiting on the other party's approval.</summary>
    private bool IsPendingApprovalFromOtherParty
        => _conversationAccess is { IsApproved: false } access && access.InitiatedByUserId == _ownUserId;

    protected override async Task OnInitializedAsync()
    {
        // Waits for the first permission read, so this page never decides it is locked before it
        // has been told - see UserPermissionState.EnsureLoadedAsync.
        await Permissions.EnsureLoadedAsync();
        await Panels.InitializeAsync();
        _isContactListCollapsed = !Panels.IsOpen(PanelPreferences.Panel.ChatConversationList);
        // Nothing below is reachable without this, and the page draws its locked notice instead - so it
        // does not ask and get turned away, which only fills the console with refusals that are not news.
        if (!Permissions.Has(ApplicationPermission.Chat))
        {
            return;
        }

        // MainLayout's poll owns the unread set; subscribing keeps this contact list's badges in step
        // with the avatar's without a second poll of its own.
        NotificationFeedState.Changed += OnNotificationFeedChanged;
        // The connection itself is opened by MainLayout and shared; this page only listens while it is here.
        LiveUpdates.ChatChanged += OnChatAnnounced;
        LiveUpdates.ConnectionStateChanged += OnLiveConnectionStateChanged;

        try
        {
            _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync()
                ?? throw new HttpRequestException("No signed-in user.", null, HttpStatusCode.Unauthorized);

            await OwnEncryptionKeyProvider.EnsurePublicKeyAsync();
            _cryptoModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/e2eeChat.js");
            _contacts = await ChatApiClient.GetContactsAsync();
            _groups = await ChatApiClient.GetGroupsAsync();
            _areConversationsLoaded = true;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            // No status code at all (API unreachable, DNS, a dropped connection, ...) - the poll loop
            // (see PollOnceAsync's own catch) already treats this as transient rather than fatal; the
            // initial load should too, instead of crashing the whole WASM renderer over what a retry
            // might resolve on its own.
            Logger.LogError(exception, "Failed to load chat");
            _loadErrorMessage = T["Couldn't load chat. Check your connection and try again."];
            return;
        }
        catch (JSException exception)
        {
            // crypto.subtle (which e2eeChat.js needs for every key/encrypt/decrypt operation) is only
            // exposed by browsers in a secure context - HTTPS, or the special-cased
            // "localhost"/"127.0.0.1" hosts (see README.md's "Accessing Orbit.Web from another device
            // on your network"). Unlike MainLayout's best-effort key publishing, chat genuinely cannot
            // work without this, so rather than silently continuing into a broken chat window, this
            // stops here and renders a dedicated explanation instead (see the markup above).
            Logger.LogError(exception, "End-to-end encryption is unavailable in this browsing context");
            _encryptionUnavailable = true;
            return;
        }
        catch (EncryptionKeyLockedException)
        {
            // This browser has no local private key for the signed-in user - unlike MainLayout's
            // best-effort publishing, this genuinely blocks chatting, so it's surfaced with a dedicated
            // explanation and a way out (see the markup above and ReauthenticateAsync below) instead of
            // silently generating a fresh key pair here, which would orphan any existing backup.
            _encryptionKeyLocked = true;
            return;
        }

        // "New group" is offered from the conversation list, and asks for it by coming here.
        if (IsGroupMode && GroupId is null && NavigationManager.Uri.Contains("new=1", StringComparison.Ordinal))
        {
            StartCreatingGroup();
        }

        if (!IsGroupMode)
        {
            await LoadConversationForCurrentUserAsync();
        }
    }

    /// <summary>
    /// The drawer (see the markup above) lets the user switch conversations without leaving this page,
    /// which Blazor's router treats as a parameter change on the same component instance rather than a
    /// fresh page load - so unlike a normal navigation-in from Dashboard/Contacts, OnInitializedAsync
    /// does NOT run again. This re-runs the same per-conversation setup whenever the open one changes.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_encryptionUnavailable || _encryptionKeyLocked)
        {
            return;
        }

        _isConversationMenuOpen = false;

        // A group's messages are GroupConversation's to load; what this page holds for a person has to
        // go, or the poll loop keeps running against a conversation that is no longer on screen.
        if (IsGroupMode)
        {
            await CloseOneToOneConversationAsync();
            return;
        }

        _isCreatingGroup = false;
        if (UserId == _loadedUserId)
        {
            return;
        }

        await LoadConversationForCurrentUserAsync();
    }

    /// <summary>Leaves the one-to-one conversation this page was showing, so a group can take the thread.</summary>
    private async Task CloseOneToOneConversationAsync()
    {
        StopPolling();
        _loadedUserId = Guid.Empty;
        _otherUser = null;
        _isDrawerOpen = false;
        _messages.Clear();
        _decryptedContentByMessageId.Clear();
        await DetachScrollObserverAsync();
    }

    private async Task LoadConversationForCurrentUserAsync()
    {
        StopPolling();
        _loadedUserId = UserId;
        _isDrawerOpen = false;
        _otherUser = null;
        _messages.Clear();
        _decryptedContentByMessageId.Clear();
        _shareNoticeByMessageId.Clear();
        _editAccessRequestByMessageId.Clear();
        _acceptedShareIds.Clear();
        _acceptingShareIds.Clear();
        _forwardedFromByMessageId.Clear();
        _forwardingMessageId = null;
        _forwardErrorMessage = null;
        _forwardErrorMessageForMessageId = null;
        _otherPartyReadUpToUtc = null;
        _conversationAccess = null;
        _draftMessage = string.Empty;
        _isJumpToNewestVisible = false;
        // Opening a conversation always lands on its newest message (see OnAfterRenderAsync). Switching
        // contacts re-creates the message list element, so the scroll listener has to be re-attached.
        _scrollToNewestOnNextRender = true;
        await DetachScrollObserverAsync();

        try
        {
            _otherUser = await UsersApiClient.GetUserAsync(UserId);
            if (_otherUser is null)
            {
                // Nothing came back for somebody whose conversation is on this reader's own list. Sending
                // them back to Contacts without a word was indistinguishable from a click that did not
                // register - the only sign anything happened was a 404 in the browser's own console.
                Logger.LogWarning(
                    "Couldn't open the conversation with {UserId}: the API returned no such account", UserId);
                _loadErrorMessage = T["Orbit can't reach that account, so this conversation can't be opened right now."];
                return;
            }

            await LoadConversationAccessAsync();
            await LoadNewMessagesAsync();
            await SyncReadStateAsync();
            await ClearNotificationsForThisConversationAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            // Mirrors OnInitializedAsync's own catch above - no status code at all (API unreachable,
            // DNS, a dropped connection, ...) shouldn't crash the page when switching contacts either.
            Logger.LogError(exception, "Failed to load conversation with {UserId}", UserId);
            _loadErrorMessage = T["Couldn't load this conversation. Check your connection and try again."];
            return;
        }

        StartPolling();
    }

    /// <summary>
    /// Signs the user out and sends them back to the login page, where a fresh sign-in runs
    /// OwnEncryptionKeyProvider.UnlockOrCreateAsync with the password needed to restore this browser's
    /// private key from its server-side backup.
    /// </summary>
    /// <summary>
    /// Called by the password gate once this browser holds a usable key again - clears the lock and lets
    /// the normal load path run, so the user lands straight in the conversation instead of reloading.
    /// </summary>
    private async Task OnEncryptionKeyUnlockedAsync()
    {
        _encryptionKeyLocked = false;
        // Cleared so the guard in LoadConversationForCurrentUserAsync doesn't treat this conversation as
        // already loaded and skip the load that the lock previously aborted.
        _loadedUserId = Guid.Empty;
        await LoadConversationForCurrentUserAsync();
    }

    private async Task ReauthenticateAsync()
    {
        await AuthApiClient.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    /// <summary>
    /// Scroll position can only be applied once the message list has actually rendered, so both the
    /// open-a-conversation jump and the follow-along jump after a new message are deferred to here via
    /// _scrollToNewestOnNextRender rather than being attempted from the loading code itself.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureScrollObserverAsync();
        await AnchorTheOpenMenuAsync();

        // Loading a conversation renders several times before the messages themselves arrive (the awaits
        // in LoadConversationForCurrentUserAsync each trigger one). Scrolling an empty list would do
        // nothing while still clearing the flag, so the request is held until there's something to
        // scroll to. Instant rather than smooth: an animated scroll competing with the poll loop's own
        // re-renders gets cancelled part-way and leaves the list stranded mid-history.
        if (!_scrollToNewestOnNextRender || _messages.Count == 0)
        {
            return;
        }

        _scrollToNewestOnNextRender = false;
        await ScrollMessageListToBottomAsync();
    }

    /// <summary>
    /// Puts an open message menu where it fits. It hangs off a bubble inside a scrolling list, so left
    /// to CSS it opened downwards into - and behind - the composer, losing half its entries to it.
    /// menuAnchor.js measures the trigger and the panel and flips it above when there is no room
    /// below, which is what it was written for.
    /// </summary>
    private async Task AnchorTheOpenMenuAsync()
    {
        if (_openMessageMenuId is null && _forwardingMessageId is null)
        {
            return;
        }

        try
        {
            _menuAnchoring ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/menuAnchor.js");
            await _menuAnchoring.InvokeVoidAsync(
                "anchorToTrigger", _openMenuElement, ".chat-bubble-menu-trigger");
        }
        catch (JSException)
        {
            // The menu is still usable where CSS put it; this only improves where that is.
        }
        catch (JSDisconnectedException)
        {
            // The page is going away mid-open.
        }
    }

    /// <summary>
    /// Registers the JS-side scroll listener once the message list exists (see chatScroll.js's
    /// observeScroll for why the listener can't just be an @onscroll attribute).
    /// </summary>
    private async Task EnsureScrollObserverAsync()
    {
        if (_isScrollObserverAttached || _messages.Count == 0)
        {
            return;
        }

        _scrollObserverReference ??= DotNetObjectReference.Create(this);
        try
        {
            await JSRuntime.InvokeVoidAsync("OrbitChatScroll.observeScroll", _messageListElement, _scrollObserverReference);
            _isScrollObserverAttached = true;
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Failed to observe the message list scroll position");
        }
    }

    /// <summary>
    /// Called from chatScroll.js on every scroll of the message list. Public and [JSInvokable] only
    /// because JS interop requires it - nothing in C# calls this directly.
    /// </summary>
    [JSInvokable]
    public void OnMessageListScrolled(bool isNearBottom)
    {
        if (isNearBottom == _isJumpToNewestVisible)
        {
            _isJumpToNewestVisible = !isNearBottom;
            StateHasChanged();
        }
    }

    private async Task ScrollToNewestMessageAsync()
    {
        await ScrollMessageListToBottomAsync();
        _isJumpToNewestVisible = false;
    }

    private async Task ScrollMessageListToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("OrbitChatScroll.scrollToBottom", _messageListElement);
        }
        catch (JSException exception)
        {
            // Scrolling is a convenience, never worth breaking the conversation over - the message list
            // itself renders fine whether or not the browser honoured this.
            Logger.LogWarning(exception, "Failed to scroll the message list");
        }
    }

    /// <summary>
    /// Whether the user is following the live end of the conversation - decides if an incoming message
    /// auto-scrolls (see LoadNewMessagesAsync), so someone reading history is never yanked away from it.
    /// Treated as "following" when it can't be determined, matching the pre-scroll-tracking behaviour.
    /// </summary>
    private async Task<bool> IsMessageListNearBottomAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("OrbitChatScroll.isScrolledNearBottom", _messageListElement);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Failed to read the message list scroll position");
            return true;
        }
    }

    private void ToggleDrawer() => _isDrawerOpen = !_isDrawerOpen;

    private async Task ToggleContactListCollapsedAsync()
    {
        _isContactListCollapsed = !_isContactListCollapsed;
        await Panels.SetOpenAsync(PanelPreferences.Panel.ChatConversationList, !_isContactListCollapsed);
    }

    /// <summary>
    /// The open panel, so it can be placed inside the window - see menuAnchor.js. Only one is ever
    /// rendered, so this always holds the one on screen rather than the last message's.
    /// </summary>
    private ElementReference _openMenuElement;

    private IJSObjectReference? _menuAnchoring;

    /// <summary>Set by focus arriving anywhere inside the menu, and read by the focusout below.</summary>
    private bool _menuKeptFocus;

    /// <summary>
    /// Closes the menu once focus has actually left it, rather than on the way between its own
    /// entries. focusout fires before the matching focusin, so this waits a turn and then asks whether
    /// anything inside took the focus in between.
    /// </summary>
    private async Task CloseTheMessageMenuIfFocusLeftAsync()
    {
        _menuKeptFocus = false;
        await Task.Yield();

        if (_menuKeptFocus)
        {
            return;
        }

        CloseMessageMenu();
        StateHasChanged();
    }

    private void ToggleMessageMenu(Guid messageId) => _openMessageMenuId = _openMessageMenuId == messageId ? null : messageId;

    /// <summary>Bound to a click anywhere in the message list, so opening one message's menu closes any other and clicking elsewhere closes it - same outside-click pattern as MainLayout's avatar dropdown.</summary>
    private void CloseMessageMenu()
    {
        _openMessageMenuId = null;
        _forwardingMessageId = null;
    }

    private void StartEdit(ChatMessageDto message)
    {
        _openMessageMenuId = null;
        _editingMessageId = message.Id;
        _editDraftText = _decryptedContentByMessageId.GetValueOrDefault(message.Id) ?? string.Empty;
    }

    private void CancelEdit()
    {
        _editingMessageId = null;
        _editDraftText = string.Empty;
    }

    private async Task SaveEditAsync(ChatMessageDto message)
    {
        var newText = _editDraftText.Trim();
        if (newText.Length == 0 || _otherUser?.PublicKeyBase64 is null || _cryptoModule is null)
        {
            return;
        }

        _isSavingEdit = true;
        try
        {
            var payload = await _cryptoModule.InvokeAsync<EncryptedPayload>(
                "encryptMessage", _ownUserId, _otherUser.PublicKeyBase64, newText);
            var updated = await ChatApiClient.EditMessageAsync(message.Id, new EditMessageRequest(payload.CiphertextBase64, payload.NonceBase64));

            var index = _messages.FindIndex(existing => existing.Id == message.Id);
            if (index >= 0)
            {
                _messages[index] = updated;
            }
            _decryptedContentByMessageId[message.Id] = newText;
            _editingMessageId = null;
            _editDraftText = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            // Left in edit mode (not cleared) so the user's edit isn't lost and they can just retry -
            // mirrors SendMessageAsync's handling of the same failure.
            Logger.LogError(exception, "Failed to edit chat message {MessageId}", message.Id);
        }
        finally
        {
            _isSavingEdit = false;
        }
    }

    /// <summary>
    /// Answering a particular message rather than the conversation in general. The draft box grows a
    /// strip naming what is being answered, and sending carries the reference along - see
    /// ReplyMessagePayload.
    /// </summary>
    private void StartReply(ChatMessageDto message)
    {
        _openMessageMenuId = null;
        _replyingTo = message;
    }

    private void CancelReply() => _replyingTo = null;

    /// <summary>
    /// Scrolls the quoted message into view. The reference is what makes a reply readable in a long
    /// conversation, and it is only worth carrying if it takes you there.
    /// </summary>
    private async Task ScrollToQuotedMessageAsync(Guid messageId)
    {
        _highlightedMessageId = messageId;
        await JSRuntime.InvokeVoidAsync("OrbitChatScroll.scrollToMessage", MessageElementId(messageId));
    }

    private static string MessageElementId(Guid messageId) => $"chat-message-{messageId}";

    private void StartForward(ChatMessageDto message)
    {
        _openMessageMenuId = null;
        _forwardErrorMessage = null;
        _forwardErrorMessageForMessageId = null;
        _forwardingMessageId = message.Id;
    }

    private void CancelForward() => _forwardingMessageId = null;

    /// <summary>
    /// Re-encrypts message's already-decrypted content under targetContact's key and sends it as a new
    /// message in that (separate) conversation. A message the caller wrote themselves is forwarded as
    /// plain, unwrapped text - indistinguishable from typing it again - since there is no "original
    /// author" worth naming beyond the caller. A message someone else sent is wrapped in
    /// ForwardedMessagePayload instead, naming that original sender, since simply resending it would
    /// otherwise make it look like the caller's own words.
    /// </summary>
    private async Task ForwardMessageAsync(ChatMessageDto message, ContactDto targetContact)
    {
        if (!_decryptedContentByMessageId.TryGetValue(message.Id, out var content))
        {
            return;
        }

        _isForwarding = true;
        try
        {
            string contentToSend;
            if (message.SenderUserId == _ownUserId)
            {
                contentToSend = content;
            }
            else
            {
                var originalAuthorDisplayName = _forwardedFromByMessageId.GetValueOrDefault(message.Id) ?? _otherUser!.DisplayName;
                var payload = new ForwardedMessagePayload(message.SenderUserId, originalAuthorDisplayName, content);
                contentToSend = JsonSerializer.Serialize(payload);
            }

            await EncryptedChatMessageSender.SendAsync(_ownUserId, targetContact.UserId, contentToSend);
            _forwardingMessageId = null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(
                exception, "Failed to forward chat message {MessageId} to user {TargetUserId}", message.Id, targetContact.UserId);
            _forwardErrorMessage = T["Couldn't forward the message."];
            _forwardErrorMessageForMessageId = message.Id;
        }
        finally
        {
            _isForwarding = false;
        }
    }

    private void CloseDrawer() => _isDrawerOpen = false;

    private void SwitchContact(Guid userId)
    {
        _isDrawerOpen = false;
        if (userId != UserId)
        {
            Logger.LogInformation("User switched conversations from the drawer ({ContactUserId})", userId);
            NavigationManager.NavigateTo($"/chat/{userId}");
        }
    }


    /// <summary>
    /// How often to ask when nothing announces changes - what this page always did, and still does on a
    /// network or a proxy that will not carry a live connection.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    /// <summary>
    /// How often to ask while the live connection is up. A message, a receipt and an approval are all
    /// announced now, so this is only the net under the things that are not: a group somebody added
    /// this account to, a contact whose presence aged out of "available" by nothing happening at all.
    ///
    /// Not removed entirely, and that is the point of keeping it slow rather than deleting it: an
    /// announcement is best-effort, and a chat that silently stopped updating because one was dropped
    /// would be a far worse bug than one that takes twenty seconds in a rare case.
    /// </summary>
    private static readonly TimeSpan ConnectedPollInterval = TimeSpan.FromSeconds(20);

    private void StartPolling()
    {
        _pollCancellation = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(LiveUpdates.IsConnected ? ConnectedPollInterval : PollInterval);
        _ = PollAsync(_pollCancellation.Token);
    }

    /// <summary>
    /// Reads once, now, because something said there is something to read. Through InvokeAsync because
    /// this arrives on the connection's callback rather than the renderer's dispatcher - touching
    /// component state from there corrupts the render tree, and the damage surfaces on an unrelated page.
    /// </summary>
    private void OnChatAnnounced()
        => _ = InvokeAsync(async () =>
        {
            // The same rule the timer follows: nothing is read behind thirty other tabs. An
            // announcement for a page nobody is looking at is still not a reason to fetch.
            if (!await PageVisibility.IsPageVisibleAsync())
            {
                return;
            }

            await PollOnceAsync();
            StateHasChanged();
        });

    private void OnLiveConnectionStateChanged()
        => _ = InvokeAsync(() =>
        {
            // Only the pace changes - the loop itself keeps running, so a dropped connection puts the
            // old responsiveness back without this page having to notice or restart anything.
            if (_pollTimer is not null)
            {
                _pollTimer.Period = LiveUpdates.IsConnected ? ConnectedPollInterval : PollInterval;
            }

            return Task.CompletedTask;
        });

    private void StopPolling()
    {
        _pollCancellation?.Cancel();
        _pollCancellation?.Dispose();
        _pollCancellation = null;
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                // Nothing is read behind thirty other tabs, so nothing is asked for there either - the
                // same rule the presence heartbeat follows. Five requests a second for a page nobody is
                // looking at is not diligence.
                if (!await PageVisibility.IsPageVisibleAsync())
                {
                    continue;
                }

                await PollOnceAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page navigates away, the user switches contacts, or DisposeAsync cancels polling.
        }
        catch (ObjectDisposedException)
        {
            // The timer was disposed by StopPolling (contact switch) between a tick starting and this
            // loop checking again - same "stop quietly" handling as the cancellation above.
        }
    }

    /// <summary>
    /// A single poll tick's worth of work, isolated so a transient failure (a brief server hiccup, or
    /// the session having just expired) only gives up on this one tick instead of silently killing the
    /// whole poll loop - and with it, live updates - for the rest of the time this chat window stays open.
    /// </summary>
    private async Task PollOnceAsync()
    {
        try
        {
            // Refreshed on every tick (not just once on load) so a "chat request" banner or a disabled
            // compose box clears itself as soon as the other party approves, without needing a reload.
            await LoadConversationAccessAsync();
            await LoadNewMessagesAsync();
            await SyncReadStateAsync();
            // Keeps the drawer's conversation list current - most relevantly, this is what makes a
            // conversation started just now (the contact only exists server-side after its first
            // message - see ChatMessageHandler) show up in the drawer without a full page reload.
            //
            // Not every tick, though. A message wants the second it takes to arrive; who is on the list
            // changes on the scale of days, and asking for the whole roster and every group once a
            // second was two thirds of this loop's traffic spent on an answer that had not changed.
            if (++_ticksSinceTheListWasRead >= TicksBetweenListReads)
            {
                _ticksSinceTheListWasRead = 0;
                _contacts = await ChatApiClient.GetContactsAsync();
                _groups = await ChatApiClient.GetGroupsAsync();
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Session expired while this chat window was already open and polling - same handling as
            // the initial load in OnInitializedAsync, just reached from the background poll loop instead.
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to poll for new messages with user {OtherUserId}", UserId);
        }
    }

    /// <summary>
    /// Appends a message unless the list already holds it, and says whether it did. The one place that
    /// decides this: sending and polling can each learn about the same message first, and either
    /// adding it without asking puts it on screen twice.
    /// </summary>
    private bool AddMessageIfNew(ChatMessageDto message)
    {
        if (_messages.Any(existing => existing.Id == message.Id))
        {
            return false;
        }

        _messages.Add(message);
        return true;
    }

    private async Task LoadNewMessagesAsync()
    {
        var sinceUtc = _messages.Count > 0 ? _messages[^1].SentAtUtc : (DateTimeOffset?)null;
        var newMessages = await ChatApiClient.GetConversationAsync(UserId, sinceUtc);
        // Checked before the new messages are added, so this reflects where the user was reading rather
        // than where the list happens to sit after growing.
        var wasFollowingConversation = _messages.Count == 0 || await IsMessageListNearBottomAsync();
        var addedAnyMessage = false;
        foreach (var message in newMessages)
        {
            // GetConversationAsync's "since" filter can re-return the very message that was just added
            // by SendMessageAsync (same SentAtUtc as the "since" cursor).
            if (!AddMessageIfNew(message))
            {
                continue;
            }

            addedAnyMessage = true;
            await DecryptAndCacheAsync(message);
        }

        if (addedAnyMessage && wasFollowingConversation)
        {
            _scrollToNewestOnNextRender = true;
        }
    }

    /// <summary>
    /// Treats "this chat window is open and actively polling" as "read" - a coarse stand-in for the
    /// other party's messages actually being seen. Skipping polls behind other tabs made it less coarse
    /// than it was, but a thread open in a visible window nobody is sitting at still reports everything
    /// as read.
    /// TODO: replace with real on-screen visibility tracking (tab focus / scroll position) once the
    /// chat has a way to push that signal to the server instead of relying on this poll loop.
    /// </summary>
    private async Task SyncReadStateAsync()
    {
        await ChatApiClient.MarkConversationAsReadAsync(UserId);
        _otherPartyReadUpToUtc = await ChatApiClient.GetReadReceiptAsync(UserId);
    }

    /// <summary>
    /// Clears the notifications about this conversation while its window is open. Arriving here already
    /// clears whatever was waiting (see MainLayout's own navigation handling), but a message that lands
    /// while the reader is sitting in the window records a fresh entry that nothing would clear - so the
    /// badge counts up beside a conversation being read as it happens.
    ///
    /// Skipped unless something is actually unread for this route, so a poll every second doesn't become
    /// a request every second.
    /// </summary>
    private async Task ClearNotificationsForThisConversationAsync()
    {
        var conversationUrl = $"/chat/{UserId}";
        if (!NotificationFeedState.HasUnreadFor(conversationUrl))
        {
            return;
        }

        if (await NotificationsApiClient.MarkReadAtUrlAsync(conversationUrl))
        {
            NotificationFeedState.MarkReadFor(conversationUrl);
        }
    }

    /// <summary>True once the other party has read up to at least this own message's send time.</summary>
    private bool IsReadByOtherParty(ChatMessageDto message)
        => _otherPartyReadUpToUtc is { } readUpToUtc && message.SentAtUtc <= readUpToUtc;

    /// <summary>The label shown on a day-separator row between messages sent on different calendar days - "Today" / "Yesterday" / a weekday name within the last week / a full date otherwise.</summary>
    private string FormatDaySeparatorLabel(DateTime localDate)
    {
        var today = DateTime.Today;
        if (localDate == today)
        {
            return T["Today"];
        }
        if (localDate == today.AddDays(-1))
        {
            return T["Yesterday"];
        }
        if (localDate > today.AddDays(-7))
        {
            return localDate.ToString("dddd", T.DisplayCulture);
        }
        return localDate.ToString("d MMMM yyyy", T.DisplayCulture);
    }

