        NavigationManager.NavigateTo($"/chat/groups/{GroupId}/info");
    }

    /// <summary>
    /// Opens the "new group" form in the thread. Starting one is a conversation-shaped act, so it
    /// happens where the conversation would be rather than on a page of its own.
    /// </summary>
    private void StartCreatingGroup()
    {
        _isDrawerOpen = false;
        _newGroupName = string.Empty;
        _newGroupMemberIds.Clear();
        _groupErrorMessage = null;
        _isCreatingGroup = true;

        if (!IsGroupMode)
        {
            NavigationManager.NavigateTo("/chat/groups?new=1");
        }
    }

    private void CancelCreatingGroup()
    {
        _isCreatingGroup = false;
        _groupErrorMessage = null;
    }

    private void ToggleNewGroupMember(Guid contactUserId, bool isSelected)
    {
        if (isSelected)
        {
            _newGroupMemberIds.Add(contactUserId);
        }
        else
        {
            _newGroupMemberIds.Remove(contactUserId);
        }
    }

    private async Task CreateGroupAsync()
    {
        _isCreatingGroupBusy = true;
        _groupErrorMessage = null;
        try
        {
            var groupId = await ChatApiClient.CreateGroupAsync(_newGroupName.Trim(), [.. _newGroupMemberIds]);
            _groups = await ChatApiClient.GetGroupsAsync();
            _isCreatingGroup = false;
            NavigationManager.NavigateTo($"/chat/groups/{groupId}");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to create a chat group");
            _groupErrorMessage = T["That didn't work. Reload the group and try again."];
        }
        finally
        {
            _isCreatingGroupBusy = false;
        }
    }

    private void GoToContacts() => NavigationManager.NavigateTo("/contacts");

    private static string FormatUnreadCount(int count) => count > 9 ? "9+" : count.ToString(CultureInfo.InvariantCulture);

    private void OnNotificationFeedChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        NotificationFeedState.Changed -= OnNotificationFeedChanged;
        LiveUpdates.ChatChanged -= OnChatAnnounced;
        LiveUpdates.ConnectionStateChanged -= OnLiveConnectionStateChanged;
        StopPolling();
        await DetachScrollObserverAsync();
        _scrollObserverReference?.Dispose();
        if (_cryptoModule is not null)
        {
            await _cryptoModule.DisposeAsync();
        }
    }

    private async ValueTask DetachScrollObserverAsync()
    {
        if (!_isScrollObserverAttached)
        {
            return;
        }

        _isScrollObserverAttached = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("OrbitChatScroll.unobserveScroll", _messageListElement);
        }
        catch (JSException)
        {
            // The element is already gone (navigating away tears the DOM down first) - nothing to detach.
        }
    }

    /// <summary>Shape returned by e2eeChat.js's encryptMessage - matched by camelCase property name.</summary>
    private sealed record EncryptedPayload(string CiphertextBase64, string NonceBase64);
}
