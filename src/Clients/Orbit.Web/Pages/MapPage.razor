@page "/map"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Users
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject UsersApiClient UsersApiClient
@inject GeocodingApiClient GeocodingApiClient
@inject ChatApiClient ChatApiClient
@inject SharedLocationSender SharedLocationSender
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject EncryptedChatMessageReader EncryptedChatMessageReader
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject IJSRuntime JSRuntime
@inject DevicePreferences DevicePreferences
@inject NavigationManager NavigationManager
@inject ILogger<MapPage> Logger
@inject UserPermissionState Permissions
@inject Translations T

<PageTitle>@T["Orbit — Map"]</PageTitle>

<div class="map-page">
    <div class="page-header">
        <div>
            <h1>@T["Map"]</h1>
            <p class="page-subtitle">@T["The one location you've recorded for yourself, and where it is."]</p>
        </div>
        <div class="page-header-actions">
            <button type="button" class="btn-primary" disabled="@_isBusy" @onclick="RecordCurrentLocationAsync">
                @(_location is null ? T["Record where I am"] : T["Update to where I am now"])
            </button>
            @if (_location is not null)
            {
                <button type="button" class="btn-secondary" disabled="@_isBusy" @onclick="ClearLocationAsync">@T["Forget it"]</button>
            }
        </div>
    </div>

    @if (!Permissions.Has(ApplicationPermission.Location))
    {
        <FeatureLocked Explanation="@(T["Recording where you are, sharing it, and seeing where others are."])" />
    }
    else
    {

        @if (_message is not null)
        {
            <p class="@(_hasFailed ? "error" : "info")">@_message</p>
        }

        @if (_contacts.Count > 0)
        {
            <div class="card share-location-card">
                <div class="card-header">
                    <span class="card-title">@T["Share where you are"]</span>
                    @if (_ownShares.Count > 0)
                    {
                        <span class="card-count">@T.Format("{0} sharing", _ownShares.Count)</span>
                    }
                </div>
                <div class="field-row">
                    <select @bind="_shareWithUserId">
                        <option value="">@T["Pick a contact…"]</option>
                        @foreach (var contact in _contacts)
                        {
                            <option value="@contact.UserId">@contact.DisplayName</option>
                        }
                    </select>
                    <button type="button" class="btn-secondary" disabled="@_isBusy" @onclick="() => ShareAsync(isContinuous: false)">@T["Send once"]</button>
                    <button type="button" class="btn-primary" disabled="@_isBusy" @onclick="() => ShareAsync(isContinuous: true)">@T["Keep sharing"]</button>
                </div>

                @foreach (var share in _ownShares)
                {
                    <div class="list-row">
                        <span class="row-title">@DisplayNameFor(share.SharerUserId == _ownUserId ? share.RecipientUserId : share.SharerUserId)</span>
                        <span class="row-meta">@(share.IsContinuous ? T["live"] : T["sent once"]) · @FormatRecordedAt(share.UpdatedAtUtc)</span>
                        <button type="button" class="btn-secondary" disabled="@_isBusy" @onclick="() => StopSharingAsync(share.RecipientUserId)">@T["Stop"]</button>
                    </div>
                }

                @if (_isLiveSharing)
                {
                    <p class="empty-hint">
                        @T["Your position goes out every minute while this page is open. Ending a share deletes it from Orbit."]
                    </p>
                }
            </div>
        }

        @if (!_isLoading && _receivedPositions.Count > 0)
        {
            @* Who is on the map, written out. The name was only ever inside a pin's own popup, so a map
               with two pins on it said nothing about whose they were until one was clicked - and when the
               reader has recorded a position of their own, everyone shares the one map. *@
            <div class="card location-card">
                <div class="card-header">
                    <span class="card-title">@T["Shared with you"]</span>
                    <span class="card-count">@_receivedPositions.Count</span>
                </div>
                @foreach (var received in _receivedPositions)
                {
                    <div class="list-row shared-position-row">
                        <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(received.SharerUserId)">@AvatarHelper.GetInitials(DisplayNameFor(received.SharerUserId))</span>
                        <span class="row-title">@DisplayNameFor(received.SharerUserId)</span>
                        @if (received.IsContinuous)
                        {
                            <span class="card-badge">@T["live"]</span>
                        }
                        <span class="row-meta">@DescribePosition(received)</span>
                    </div>
                }
            </div>
        }

        @if (_isLoading)
        {
            <p>@T["Loading…"]</p>
        }
        else if (_location is null)
        {
            <div class="card">
                <p class="empty-hint">
                    @T["Nothing recorded yet. Orbit asks your browser for your position only when you press the button, and keeps one point with no history."]
                </p>
            </div>
            @* Somebody else's position does not wait on the reader having recorded their own. Without this
               the map was drawn only for people who had, so a notification saying someone had shared their
               location led to a page that showed nothing of it. *@
            @if (_receivedPositions.Count > 0)
            {
                <div class="card location-card">
                    <div class="location-map-frame">
                    <div id="@MapElementId" class="location-map"></div>
                    @* Sits over the map rather than inside it: Leaflet owns its container's children, and
                       the frame is what goes fullscreen, so the button stays reachable once it is. Which of
                       the two labels shows is decided by CSS :fullscreen, so leaving fullscreen with Esc or
                       the back gesture - neither of which this code sees - still leaves the button right. *@
                    <button type="button" class="map-fullscreen-button" @onclick="ToggleFullscreenAsync">
                        <span class="map-fullscreen-enter" title="@(T["Full screen"])" aria-label="@(T["Full screen"])">⤢</span>
                        <span class="map-fullscreen-exit" title="@(T["Leave full screen"])" aria-label="@(T["Leave full screen"])">✕</span>
                    </button>
                </div>
                </div>
            }
        }
        else
        {
            <div class="card location-card">
                <div class="card-header">
                    <span class="card-title">
                    @if (_hasGoogleExtras)
                    {
                        @* The street name itself opens the place in Google Maps. *@
                        <a href="@GoogleMapsLink.ToPlace(_location.Latitude, _location.Longitude)" target="_blank" rel="noopener">@(_location.Address ?? T["Recorded location"])</a>
                    }
                    else
                    {
                        @(_location.Address ?? T["Recorded location"])
                    }
                </span>
                    <span class="card-count">@FormatRecordedAt(_location.RecordedAtUtc)</span>
                </div>
                <div class="list-row">
                    <span class="row-title">@FormatCoordinates(_location)</span>
                </div>
                @* The map itself is drawn by Leaflet into this element - see locationMap.js. *@
                <div class="location-map-frame">
                    <div id="@MapElementId" class="location-map"></div>
                    @* Sits over the map rather than inside it: Leaflet owns its container's children, and
                       the frame is what goes fullscreen, so the button stays reachable once it is. Which of
                       the two labels shows is decided by CSS :fullscreen, so leaving fullscreen with Esc or
                       the back gesture - neither of which this code sees - still leaves the button right. *@
                    <button type="button" class="map-fullscreen-button" @onclick="ToggleFullscreenAsync">
                        <span class="map-fullscreen-enter" title="@(T["Full screen"])" aria-label="@(T["Full screen"])">⤢</span>
                        <span class="map-fullscreen-exit" title="@(T["Leave full screen"])" aria-label="@(T["Leave full screen"])">✕</span>
                    </button>
                </div>
            </div>
        }
    }

</div>

@code {
    private const string MapElementId = "recordedLocationMap";

    /// <summary>Long enough for a cold GPS fix, short enough that a page waiting on nothing gives up.</summary>
    private const int PositionTimeoutMs = 15000;

    /// <summary>Matches the rest of the app's date formatting - see Dashboard.razor.</summary>
    /// <summary>
    /// Coordinates stay invariant whatever the interface language is: a Polish decimal comma turns a
    /// pair anyone might copy into a maps URL into a different place entirely. Dates beside them follow
    /// the language, through Translations.DisplayCulture.
    /// </summary>
    private static readonly CultureInfo CoordinateCulture = CultureInfo.InvariantCulture;

    private UserLocationDto? _location;
    private Guid _ownUserId;
    private IReadOnlyList<ContactDto> _contacts = [];
    private IReadOnlyList<SharedLocationDto> _ownShares = [];
    private IReadOnlyList<ReceivedPosition> _receivedPositions = [];
    private string _shareWithUserId = string.Empty;

    /// <summary>
    /// Refreshes every live share while this page is open. Deliberately tied to the page rather than
    /// running in the background: sharing a position is something someone is doing on purpose, and a
    /// timer that outlived the page would keep broadcasting after they had moved on from it.
    /// </summary>
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCancellation;
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMinutes(1);

    private bool _isLiveSharing => _ownShares.Any(share => share.IsContinuous);
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _hasFailed;
    private string? _message;

    /// <summary>The element only exists once there is something to draw, so drawing waits for the render that adds it.</summary>
    private bool _isMapDrawnFor;
    private IJSObjectReference? _mapModule;

    protected override async Task OnInitializedAsync()
    {
        // Waits for the first permission read, so this page never decides it is locked before it
        // has been told - see UserPermissionState.EnsureLoadedAsync.
        await Permissions.EnsureLoadedAsync();
        // Nothing below is reachable without this, and the page draws its locked notice instead - so it
        // does not ask and get turned away, which only fills the console with refusals that are not news.
        if (!Permissions.Has(ApplicationPermission.Location))
        {
            return;
        }

        _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync() ?? Guid.Empty;
        _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
        await LoadAsync();
        StartRefreshLoop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deliberately not keyed on firstRender: the location arrives from an HTTP call, so the render
        // that has the map element in it is never the first one.
        // Drawn as soon as there is anything to put on it - the reader's own point is one of the points,
        // not the condition for having a map at all.
        if ((_location is null && _receivedPositions.Count == 0) || _isMapDrawnFor)
        {
            return;
        }

        _isMapDrawnFor = true;
        try
        {
            _mapModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/locationMap.js");

            // One map for everyone on it: the viewer's own position plus anyone sharing with them.
            var points = new List<object>();
            if (_location is { } own)
            {
                points.Add(new { latitude = own.Latitude, longitude = own.Longitude, label = own.Address ?? T["You"] });
            }

            points.AddRange(_receivedPositions.Select(received => (object)new
            {
                latitude = received.Position.Latitude,
                longitude = received.Position.Longitude,
                label = $"{DisplayNameFor(received.SharerUserId)} · {received.Position.Address ?? T["shared a position"]}"
            }));

            await _mapModule.InvokeVoidAsync("showLocations", MapElementId, points);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Failed to draw the location map");
            _hasFailed = true;
            _message = T["The map couldn't be drawn, but your location is recorded."];
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var account = await UsersApiClient.GetAccountAsync();
            _location = account?.Location;
            _contacts = await ChatApiClient.GetContactsAsync();
            _ownShares = await UsersApiClient.GetOwnLocationSharesAsync();
            _receivedPositions = await OpenReceivedPositionsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the recorded location");
            _hasFailed = true;
            _message = T["Couldn't load your location. Try again."];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Asks the browser where it is, resolves an address for it best-effort, and saves both. The browser
    /// asks the user's permission itself; a refusal comes back as an ordinary message rather than an
    /// error, since declining is a legitimate answer.
    /// </summary>
    private async Task RecordCurrentLocationAsync() => await RecordCurrentLocationAsync(announce: true);

    private async Task RecordCurrentLocationAsync(bool announce)
    {
        if (!DevicePreferences.AllowLocation)
        {
            // Nothing is asked of the browser at all: its own permission prompt is a question worth
            // having agreed to beforehand, and reaching it without that agreement is the thing the
            // setting exists to prevent - see DevicePreferences.AllowLocation.
            _hasFailed = true;
            _message = T["Orbit isn't allowed to use your location. Turn it on in Options first."];
            return;
        }

        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await using var geolocationModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/geolocation.js");
            var position = await geolocationModule.InvokeAsync<BrowserPosition>("getCurrentPosition", PositionTimeoutMs);

            if (position.Error is { } error)
            {
                _hasFailed = true;
                _message = error;
                return;
            }

            // Best-effort: a point with no address is still worth keeping, so a failed lookup doesn't
            // stop the save.
            var address = await TryResolveAddressAsync(position.Latitude, position.Longitude);
            await UsersApiClient.SaveOwnLocationAsync(position.Latitude, position.Longitude, address);

            await RedrawAsync();
            if (announce)
            {
                _message = T["Location recorded."];
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to save the recorded location");
            _hasFailed = true;
            _message = T["Couldn't save your location. Try again."];
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Failed to read the browser's position");
            _hasFailed = true;
            _message = T["Your location couldn't be read in this browser."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<string?> TryResolveAddressAsync(double latitude, double longitude)
    {
        try
        {
            return await GeocodingApiClient.ReverseGeocodeAsync(latitude, longitude);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Reverse geocoding failed for a recorded location");
            return null;
        }
    }

    private async Task ClearLocationAsync()
    {
        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await UsersApiClient.ClearOwnLocationAsync();
            await DisposeMapAsync();
            await RedrawAsync();
            _message = T["Location forgotten."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to clear the recorded location");
            _hasFailed = true;
            _message = T["Couldn't clear your location. Try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>Reloads and lets the next render put a fresh map in place of the old one.</summary>
    private async Task RedrawAsync()
    {
        await DisposeMapAsync();
        _isMapDrawnFor = false;
        await LoadAsync();
    }

    private async Task DisposeMapAsync()
    {
        if (_mapModule is null)
        {
            return;
        }

        try
        {
            await _mapModule.InvokeVoidAsync("dispose", MapElementId);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, so there is no map left to tear down.
        }
    }


    /// <summary>
    /// Opens each position shared with this user. Each was sealed between its sharer and this reader, so
    /// the key is the pairwise one with that sharer. A position that won't open is left out rather than
    /// failing the page - most often one sealed for a key pair since replaced.
    /// </summary>
    private async Task<IReadOnlyList<ReceivedPosition>> OpenReceivedPositionsAsync()
    {
        var shared = await UsersApiClient.GetLocationsSharedWithMeAsync();
        var opened = new List<ReceivedPosition>(shared.Count);

        foreach (var share in shared)
        {
            var plainText = await EncryptedChatMessageReader.TryDecryptFromAsync(
                _ownUserId, share.SharerUserId, share.CiphertextBase64, share.NonceBase64);
            if (plainText is null)
            {
                continue;
            }

            var position = JsonSerializer.Deserialize<SharedLocationSender.SharedPosition>(plainText);
            if (position is not null)
            {
                opened.Add(new ReceivedPosition(share.SharerUserId, share.IsContinuous, position));
            }
        }

        return opened;
    }

    /// <summary>
    /// Shares the position already recorded for this user. Recording one first is deliberate: it keeps
    /// "what Orbit knows about where I am" a single thing the user set on purpose, rather than sharing
    /// silently reading the device behind a second, easier-to-miss button.
    /// </summary>
    private async Task ShareAsync(bool isContinuous)
    {
        if (!Guid.TryParse(_shareWithUserId, out var recipientUserId))
        {
            return;
        }

        if (_location is not { } location)
        {
            _hasFailed = true;
            _message = T["Record where you are first - there is nothing to share yet."];
            return;
        }

        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            // Checked before sharing, because sharing again with the same person overwrites the row
            // rather than adding one - and the chat message should mark the act of sharing, not every
            // time the position behind it moves. The refresh timer never comes through here at all.
            var isNewShare = _ownShares.All(share => share.RecipientUserId != recipientUserId);

            await SharedLocationSender.ShareAsync(
                _ownUserId, recipientUserId,
                new SharedLocationSender.SharedPosition(location.Latitude, location.Longitude, location.Address, location.RecordedAtUtc),
                isContinuous);

            if (isNewShare)
            {
                await AnnounceShareInChatAsync(recipientUserId, isContinuous);
            }

            _shareWithUserId = string.Empty;
            await LoadAsync();
            _message = isContinuous
                ? T["Sharing. Your position goes out again every minute while this page is open."]
                : T["Sent. That one position is all they can see."];
        }
        catch (InvalidOperationException exception)
        {
            // The recipient has never signed in, so there is no key to seal for them.
            Logger.LogWarning(exception, "Could not share a location");
            _hasFailed = true;
            _message = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to share a location");
            _hasFailed = true;
            _message = T["Couldn't share your location. Try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StopSharingAsync(Guid recipientUserId)
    {
        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await UsersApiClient.StopSharingLocationAsync(recipientUserId);
            await LoadAsync();
            _message = T["Stopped. Orbit no longer holds that position at all."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to stop sharing a location");
            _hasFailed = true;
            _message = T["Couldn't stop sharing. Try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// Re-records the device's position and sends it to everyone being shared with continuously, once a
    /// minute. Failures are swallowed: a minute that couldn't be sent is not worth interrupting the page
    /// for, and the next one will try again.
    /// </summary>
    private void StartRefreshLoop()
    {
        _refreshCancellation = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(RefreshInterval);
        _ = RefreshLoopAsync(_refreshCancellation.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _refreshTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshOnceAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The page was left - the loop is meant to end with it.
        }
    }

    private async Task RefreshOnceAsync()
    {
        try
        {
            var live = _ownShares.Where(share => share.IsContinuous).ToList();
            if (live.Count > 0)
            {
                await RecordCurrentLocationAsync(announce: false);
                if (_location is { } location)
                {
                    foreach (var share in live)
                    {
                        await SharedLocationSender.ShareAsync(
                            _ownUserId, share.RecipientUserId,
                            new SharedLocationSender.SharedPosition(location.Latitude, location.Longitude, location.Address, location.RecordedAtUtc),
                            isContinuous: true);
                    }
                }
            }

            _receivedPositions = await OpenReceivedPositionsAsync();
            await RedrawAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JSException or InvalidOperationException)
        {
            Logger.LogWarning(exception, "A location refresh tick did not complete");
        }
    }

    /// <summary>
    /// Puts the share in the conversation with whoever received it, the way sharing a note or an event
    /// already does. Best-effort: the position has been shared by the time this runs, and failing to
    /// mention it is not a reason to report the share itself as failed.
    /// </summary>
    private async Task AnnounceShareInChatAsync(Guid recipientUserId, bool isContinuous)
    {
        try
        {
            var payloadJson = JsonSerializer.Serialize(new LocationShareMessagePayload(isContinuous));
            await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson, isShareInvitation: true);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Shared a location but could not announce it in the chat with {RecipientUserId}", recipientUserId);
        }
    }

    /// <summary>
    /// Puts the map full screen and back. Esc and the back gesture also leave it, and neither reaches
    /// here - which is why nothing about the state is kept in this component; see the CSS that decides
    /// which half of the button shows.
    /// </summary>
    private async Task ToggleFullscreenAsync()
    {
        try
        {
            _mapModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/locationMap.js");
            var frame = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "document.querySelector", ".location-map-frame");
            await using (frame)
            {
                await _mapModule.InvokeAsync<bool>("toggleFullscreen", frame);
            }
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not put the map full screen");
        }
    }

    /// <summary>Whether to offer the Google links - see GoogleIntegrationAccess for who qualifies.</summary>
    private bool _hasGoogleExtras;

    private string DisplayNameFor(Guid userId)
        => _contacts.FirstOrDefault(contact => contact.UserId == userId)?.DisplayName ?? T["Someone"];

    /// <summary>
    /// Where somebody is and when they were last there. Falls back to the coordinates when reverse
    /// geocoding had nothing to say - a pair of numbers still tells the reader where to look.
    /// </summary>
    private string DescribePosition(ReceivedPosition received)
    {
        var place = received.Position.Address ?? FormatCoordinates(received.Position.Latitude, received.Position.Longitude);
        return $"{place} · {FormatRecordedAt(received.Position.RecordedAtUtc)}";
    }

    /// <summary>One position someone is sharing with this user, already opened.</summary>
    private sealed record ReceivedPosition(Guid SharerUserId, bool IsContinuous, SharedLocationSender.SharedPosition Position);

    private static string FormatCoordinates(UserLocationDto location)
        => FormatCoordinates(location.Latitude, location.Longitude);

    private static string FormatCoordinates(double latitude, double longitude)
        => $"{latitude.ToString("F5", CoordinateCulture)}, {longitude.ToString("F5", CoordinateCulture)}";

    private string FormatRecordedAt(DateTimeOffset recordedAtUtc)
        => recordedAtUtc.ToLocalTime().ToString("d MMM yyyy, HH:mm", T.DisplayCulture);

    public async ValueTask DisposeAsync()
    {
        // Leaving the page ends live sharing's refresh loop - see _refreshTimer's comment.
        _refreshCancellation?.Cancel();
        _refreshTimer?.Dispose();
        _refreshCancellation?.Dispose();

        await DisposeMapAsync();
        if (_mapModule is not null)
        {
            try
            {
                await _mapModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <summary>Shape returned by geolocation.js - matched by camelCase property name. Error is set instead of the coordinates when the position couldn't be had.</summary>
    private sealed record BrowserPosition(double Latitude, double Longitude, double AccuracyMetres, string? Error);
}
