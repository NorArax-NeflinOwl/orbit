@page "/map"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Places
@using Orbit.Contracts.Tasks
@using Orbit.Contracts.Users
@using Orbit.Core.Location
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject UsersApiClient UsersApiClient
@inject GeocodingApiClient GeocodingApiClient
@inject CalendarApiClient CalendarApiClient
@inject TasksApiClient TasksApiClient
@inject ChatApiClient ChatApiClient
@inject SharedLocationSender SharedLocationSender
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject EncryptedChatMessageReader EncryptedChatMessageReader
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject IJSRuntime JSRuntime
@inject ChosenPlace ChosenPlace
@inject DevicePreferences DevicePreferences
@inject MapPinVisibility MapPins
@inject MapPanelPins PanelPins
@inject PlacesApiClient PlacesApiClient
@inject NavigationManager NavigationManager
@inject ILogger<MapPage> Logger
@inject UserPermissionState Permissions
@inject NotificationFeedState NotificationFeed
@inject Translations T

<PageTitle>@T["Orbit — Map"]</PageTitle>

@* Two halves: everything to decide on down the left, and the map itself down the right, always on and
   always the whole height of the screen. The map used to be a square card at the foot of a column of
   panels, which meant scrolling past the controls to see what they were about. *@
@if (!Permissions.Has(ApplicationPermission.Location))
{
    <FeatureLocked Explanation="@(T["Recording where you are. Sharing it, or seeing somebody else's, also needs contacts."])" />
}
else
{
<div class="map-page">
    <div class="map-panel">
        <div class="map-panel-head">
            <div class="map-panel-head-row">
                @* What the page is for, behind the same mark every other page's title carries - see
                   PageHeader.Description. This page draws its own heading because the name shares a row
                   with the menu, but the sentence under it was the same kind of sentence. *@
                <h1>@T["Map"]<FieldHint>@T["Where you are, who you are sharing it with, and who is sharing theirs."]</FieldHint></h1>
                @* Everything that can only be done to a recording that already exists, at the far edge
                   of the name's own row - the same place every other page keeps its menu. Offered
                   rather than hidden while there is nothing to update or stop: what the page can do is
                   then the same list every time, and greyed says why one of them cannot be pressed. *@
                <OverflowMenu>
                    <button type="button" class="avatar-dropdown-item" disabled="@(_isBusy || _location is null)"
                            @onclick="RecordCurrentLocationAsync">@T["Update to where I am now"]</button>
                    @* A map is mostly about where somebody is going, so what has already happened is off
                       by default rather than absent - the same ✓ every other filter in Orbit is marked
                       with. *@
                    <button type="button" class="avatar-dropdown-item @(_showsPastPlaces ? "chosen" : "")"
                            @onclick="ShowOrHidePastPlacesAsync">
                        <span class="card-filter-mark">@(_showsPastPlaces ? "✓" : "")</span>
                        @T["Show places already past"]
                    </button>
                </OverflowMenu>
            </div>
        </div>

        @* The one thing this page is opened to do, as a button rather than an entry in a menu, and
           directly above whatever the page says back - what was pressed and what came of it then read
           as one thing instead of as opposite corners. Whichever of the two is true right now, in the
           one place a reader's eye already is: this used to stay Start recording and merely grey out
           once one was under way, with the way to end it buried in the menu above instead of here. *@
        <div class="map-panel-actions">
            @if (_location is null)
            {
                @* Not on a phone: neither this nor the picker below it does anything there, so the page
                   says so once instead of offering two controls that answer nothing - see
                   .map-phone-note, and the note in info/future-plan.md about finding out why. Stop is
                   left alone: a recording started elsewhere has to be endable from wherever somebody
                   is. *@
                <button type="button" class="btn-primary map-panel-start" disabled="@_isBusy"
                        @onclick="RecordCurrentLocationAsync">@T["Start"]</button>
                <p class="empty-hint map-phone-note">
                    @T["Recording where you are, and sharing it, don't work on a phone yet - open Orbit on a computer for those."]
                </p>
            }
            else
            {
                <button type="button" class="btn-secondary" disabled="@_isBusy"
                        @onclick="ClearLocationAsync">@T["Stop"]</button>
            }
        </div>

        @if (_message is not null)
        {
            <p class="@(_hasFailed ? "error" : "info")">@_message</p>
        }

        @if (_isLoading)
        {
            <Loading />
        }
        else
        {
        @* The four boxes, in a wrapper of their own so a pinned one can rise past the others without
           fighting the order the whole page is laid out in on a phone - see .map-panel-lists, and the
           order rules under @media (max-width: 680px), which are about .map-panel's own children. *@
        <div class="map-panel-lists">
        <section class="map-panel-section map-panel-share">
            <h2 class="map-panel-heading">@T["Share where you are"]</h2>
            @if (_contacts.Count == 0)
            {
                <p class="empty-hint empty-list">@T["No contacts to share with yet - start a conversation first."]</p>
            }
            else
            {
                <div class="field-row">
                    <select @bind="_shareWithUserId" aria-label="@(T["Share where you are"])">
                        <option value="">@T["Pick a contact…"]</option>
                        @foreach (var contact in _contacts)
                        {
                            <option value="@contact.UserId">@contact.DisplayName</option>
                        }
                    </select>
                    @* Adds the share as a single position. Which of the two it is afterwards belongs to
                       the row it becomes, not to the moment of adding - see its menu below. *@
                    <button type="button" class="icon-btn map-panel-add" title="@(T["Add"])" aria-label="@(T["Add"])"
                            disabled="@(_isBusy || _shareWithUserId.Length == 0)" @onclick="AddShareAsync">
                        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
                    </button>
                </div>
            }
        </section>

        @* The lists below are left out while they have nothing in them, the way an empty card is left
           off the dashboard: four headings each saying "nobody yet" was most of the panel spent on what
           is not there. The box above them stays - it is how any of them comes to have something in it. *@
        @if (_ownShares.Count > 0)
        {
        <section class="map-panel-section @PinnedClass(MapPanelPins.PanelList.YouAreSharingWith)">
            <div class="map-panel-heading-row">
                @RenderPanelPin(MapPanelPins.PanelList.YouAreSharingWith)
                @* What a live share does, behind a "!" rather than as a line under the rows: it is true
                   only while one of them is live, which makes it news about this screen rather than a
                   description of it - see FieldHint's Warns. *@
                <h2 class="map-panel-heading">@T["You are sharing with"]@if (_isLiveSharing)
                    {
                        <FieldHint Warns="true">@T["Your position goes out every minute while this page is open. Ending a share deletes it from Orbit."]</FieldHint>
                    }</h2>
            </div>
            @foreach (var share in _ownShares)
            {
                var recipientUserId = share.SharerUserId == _ownUserId ? share.RecipientUserId : share.SharerUserId;
                <div class="map-share-row">
                    <span class="row-title">@DisplayNameFor(recipientUserId)</span>
                    <span class="row-meta">@(share.IsContinuous ? T["live"] : T["sent once"])</span>
                    @* How the share is made, rather than whether it exists: the two options are the two
                       promises - one position, or every position while this page is open. *@
                    <OverflowMenu>
                        <button type="button" class="avatar-dropdown-item @(share.IsContinuous ? "" : "chosen")"
                                disabled="@_isBusy" @onclick="() => SetShareModeAsync(recipientUserId, isContinuous: false)">
                            <span class="card-filter-mark">@(share.IsContinuous ? "" : "✓")</span>
                            @T["Send once"]
                        </button>
                        <button type="button" class="avatar-dropdown-item @(share.IsContinuous ? "chosen" : "")"
                                disabled="@_isBusy" @onclick="() => SetShareModeAsync(recipientUserId, isContinuous: true)">
                            <span class="card-filter-mark">@(share.IsContinuous ? "✓" : "")</span>
                            @T["Keep sharing"]
                        </button>
                    </OverflowMenu>
                    @* The way out, on the row rather than behind the menu: ending a share is not one of
                       the ways of making one, and a share somebody cannot end is the one thing this
                       panel must not become. *@
                    <button type="button" class="icon-btn map-share-stop" disabled="@_isBusy"
                            title="@(T["Stop sharing"])" aria-label="@(T["Stop sharing"])"
                            @onclick="() => StopSharingAsync(recipientUserId)">✕</button>
                </div>
            }
        </section>
        }

        @if (_receivedPositions.Count > 0)
        {
        <section class="map-panel-section @PinnedClass(MapPanelPins.PanelList.SharingWithYou)">
            @* The pin, the name, and the eye - in the order every card in Orbit puts them: what keeps
               this list in front of the reader on the left (see MapPanelPins), what it is called in the
               middle, and what the map does with it at the far edge (see MapPinVisibility). Two
               different questions about one list, which is why they are two controls. *@
            <div class="map-panel-heading-row">
                @RenderPanelPin(MapPanelPins.PanelList.SharingWithYou)
                <h2 class="map-panel-heading">@T["Sharing with you"]</h2>
                @RenderPinToggle(MapPinVisibility.PinGroup.SharedWithYou, T["Show these on the map"], T["Hide these from the map"])
            </div>
            @foreach (var received in _receivedPositions)
            {
                @* Pressing a name is how to look at where they are - the same reason a card opens the
                   thing it names everywhere else in Orbit. The colour matches the pin on the map, which
                   is what says which pin is whose without clicking any of them. *@
                <div class="map-share-row map-share-row-opens" role="button" tabindex="0"
                     @onclick="() => OpenSharedPositionAsync(received)" @onkeydown="args => OpenOnEnterOrSpaceAsync(args, received)">
                    <span class="row-title map-sharer-name" style="color:@AvatarHelper.AvatarColor(received.SharerUserId)">
                        @DisplayNameFor(received.SharerUserId)
                    </span>
                    <span class="row-meta">@(received.IsContinuous ? T["live"] : T["sent once"])</span>
                    @* Where a shared pin becomes directions. Always offered rather than only when
                       Orbit's own map cannot help - somebody who wants to be taken there wants it
                       whatever this page can draw - and its own press, kept from the row around it.
                       Which app takes them is asked rather than guessed: see NavigationApps, and
                       MapAppHandoff for when the row itself hands the position over instead. *@
                    <button type="button" class="icon-btn map-share-open" title="@(T["Take me there"])"
                            aria-label="@(T["Take me there"])"
                            @onclick="() => AskHowToGetTo(TargetFor(received))" @onclick:stopPropagation="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true"><path d="M10 17.5s5.5-5 5.5-9a5.5 5.5 0 1 0-11 0c0 4 5.5 9 5.5 9Z" /><circle cx="10" cy="8.5" r="2" /></svg>
                    </button>
                    @* The other end of the same row. A share is an arrangement between two people, and
                       until now only one of them could end it - which left somebody's live position on
                       this map with nothing to do about it but ask them to stop. Its own press, kept
                       from the row around it - see You are sharing with's own stop button, above. *@
                    <button type="button" class="icon-btn map-share-stop" disabled="@_isBusy"
                            title="@(T["Stop receiving"])" aria-label="@(T["Stop receiving"])"
                            @onclick="() => StopReceivingAsync(received.SharerUserId)" @onclick:stopPropagation="true">✕</button>
                </div>
            }
        </section>
        }

        @* The places kept for their own sake - see Orbit.Core.Places.Place. Their own list rather than
           part of the plans below: a plan is something happening at a time, and these have no time at
           all, which is the whole point of them. Same row, same two presses: the name centres the map,
           the arrow hands the point to a map app. *@
        @if (_places.Count > 0)
        {
        <section class="map-panel-section @PinnedClass(MapPanelPins.PanelList.YourPlaces)">
            <div class="map-panel-heading-row">
                @RenderPanelPin(MapPanelPins.PanelList.YourPlaces)
                <h2 class="map-panel-heading">@T["Places you keep"]</h2>
                @RenderPinToggle(MapPinVisibility.PinGroup.YourPlaces, T["Show these on the map"], T["Hide these from the map"])
            </div>
            @foreach (var place in _places)
            {
                <div class="map-share-row map-share-row-opens" role="button" tabindex="0"
                     @onclick="() => FocusOnPlaceOnTheMapAsync(place)"
                     @onkeydown="args => FocusOnPlaceOnTheMapOnEnterOrSpaceAsync(args, place)">
                    @* The same colour as its pin, which is what says which pin is which without pressing
                       any of them - the sharers' names above are coloured for the same reason. *@
                    <span class="map-place-dot" style="background:@ColourOf(place)" aria-hidden="true"></span>
                    <span class="row-title">@place.Name</span>
                    @* Which of the two it is matters: one is a place somebody gave this reader, the other
                       is one this reader gave away. Named apart rather than both drawn as "Shared". *@
                    @if (place.IsShared)
                    {
                        <span class="card-badge">@(place.SharedByUserName is { Length: > 0 } sharer
                            ? T.Format("From {0}", sharer)
                            : T["Shared"])</span>
                    }
                    else if (place.IsSharedWithOthers)
                    {
                        <span class="card-badge">@T["Shared"]</span>
                    }
                    @if (PriorityOf(place) is { } priority)
                    {
                        <span class="card-badge card-badge-priority-@priority.ToLowerInvariant()">@DescribePriority(priority)</span>
                    }
                    <button type="button" class="icon-btn map-share-open" title="@(T["Take me there"])"
                            aria-label="@(T["Take me there"])"
                            @onclick="() => AskHowToGetTo(TargetFor(place))" @onclick:stopPropagation="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true"><path d="M17 3 3 9l6 2.2L11.2 17 17 3Z" /></svg>
                    </button>
                    @* Everything else a place can be asked, behind the same three dots every other object
                       in Orbit keeps them behind. A place is small enough that all of it fits in one
                       form, so changing one opens the form it was made in. *@
                    <span @onclick:stopPropagation="true">
                        <OverflowMenu>
                            @* "View" rather than "Edit" where this reader was given it to read: the same
                               form either way, and the word says which of the two it will be. *@
                            <button type="button" class="avatar-dropdown-item" @onclick="() => ChangeThePlace(place)">
                                @(place.AccessLevel == "CanEdit" ? T["Edit"] : T["View"])
                            </button>
                            @* Only where this reader may pass it on: a place handed over to read is not
                               theirs to hand on further - see SharedItemAccess, which the panel below
                               reads again for what level it may offer. *@
                            @* Nothing to offer for a sealed place: the server holds no readable copy to
                               hand anybody, which is what makes it sealed - and nothing to copy either,
                               because sealing is this browser's work and the server cannot do it. *@
                            @if (!place.IsPrivate && SharedItemAccess.For(place.IsShared, place.AccessLevel).CanShare)
                            {
                                <button type="button" class="avatar-dropdown-item" @onclick="() => ShareThePlace(place)">
                                    @T["Share"]
                                </button>
                            }
                            @if (!place.IsPrivate)
                            {
                                <button type="button" class="avatar-dropdown-item" @onclick="() => DuplicateThePlaceAsync(place)">
                                    @T["Duplicate"]
                                </button>
                            }
                            <button type="button" class="avatar-dropdown-item danger" @onclick="() => AskToForgetThePlace(place)">
                                @(place.IsShared ? T["Take it off my map"] : T["Delete"])
                            </button>
                        </OverflowMenu>
                    </span>
                </div>
            }
        </section>
        }

        @* Everything with an address on it, which until now the map knew nothing about: a page showing
           where people are and nothing about where the reader is going. Pressing a row centres the map
           on its pin, the same press a name in the list above answers to.

           Kept while the past is being shown even with nothing in it, because then the box holds the one
           field that can change that answer - how far back to look. *@
        @if (_placed.Count > 0 || _showsPastPlaces)
        {
        <section class="map-panel-section @PinnedClass(MapPanelPins.PanelList.YourPlans)">
            <div class="map-panel-heading-row">
                @RenderPanelPin(MapPanelPins.PanelList.YourPlans)
                <h2 class="map-panel-heading">@T["Where your plans are"]</h2>
                @RenderPinToggle(MapPinVisibility.PinGroup.YourPlans, T["Show these on the map"], T["Hide these from the map"])
            </div>
            @* Only while the past is being shown at all, because it is a question about the past: how
               far back to go. Without it, asking for what is behind you on an account with a year of
               appointments in it buries the two that were worth seeing. *@
            @if (_showsPastPlaces)
            {
                <div class="field">
                    <label for="mapPastFrom">@T["Show from"]<FieldHint>@T["Leave it empty for everything that has been and gone."]</FieldHint></label>
                    <input type="date" id="mapPastFrom" value="@(_showsPastPlacesFrom?.ToString("yyyy-MM-dd"))"
                           @onchange="OnShowPastFromChangedAsync" aria-label="@(T["Show from"])" />
                </div>
            }
            @if (_placed.Count == 0)
            {
                <p class="empty-hint empty-list">@T["Nothing in your calendar or your lists says where it happens."]</p>
            }
            @foreach (var placed in _placed)
            {
                @* The mark for a row the bell is talking about - the same outline a dashboard row takes,
                   see .row-unseen. Without it this list said what was planned and nothing about which
                   of them somebody had just been told something about. *@
                <div class="map-share-row map-share-row-opens @(HasNewsAbout(placed) ? "row-unseen" : "")"
                     role="button" tabindex="0"
                     @onclick="() => FocusOnPlaceAsync(placed)"
                     @onkeydown="args => FocusOnPlaceOnEnterOrSpaceAsync(args, placed)">
                    @* The same colour as its pin, which is what says which pin is which without
                       pressing any of them - the sharers' names above are coloured for the same reason. *@
                    <span class="map-place-dot" style="background:@placed.Color" aria-hidden="true"></span>
                    <span class="row-title @(placed.IsBehindYou ? "map-place-past" : "")">@placed.Title</span>
                    <span class="row-meta">@placed.When</span>
                    @* The same offer the shared positions carry, on the plans that are most of what
                       somebody has to get to. *@
                    <button type="button" class="icon-btn map-share-open" title="@(T["Take me there"])"
                            aria-label="@(T["Take me there"])"
                            @onclick="() => AskHowToGetTo(TargetFor(placed))" @onclick:stopPropagation="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true"><path d="M17 3 3 9l6 2.2L11.2 17 17 3Z" /></svg>
                    </button>
                    @* Where the thing itself is opened, and it comes back here afterwards - see ReturnTo. *@
                    <a class="icon-btn map-share-open" href="@placed.OpenUrl" title="@(T["Open"])"
                       aria-label="@(T["Open"])" @onclick:stopPropagation="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true"><path d="M8 4h8v8" /><path d="M16 4 8 12" /><path d="M14 12v4H4V6h4" /></svg>
                    </a>
                </div>
            }
        </section>
        }
        </div>
        }
    </div>

    @* The shape the place picker already had, opened out to fill the page: what is being looked for
       across the top, the map under it, and what to do about the pin along the bottom. *@
    <div class="map-canvas">
        <div class="map-search">
            <input class="map-search-box" @bind="_searchText" @bind:event="oninput"
                   @onkeydown="OnSearchKeyDownAsync" placeholder="@(T["Search for a place"])"
                   aria-label="@(T["Search for a place"])" />
            <button type="button" class="btn-secondary" disabled="@(_isSearching || _searchText.Trim().Length == 0)"
                    @onclick="SearchAsync">@T["Search"]</button>
        </div>

        @if (_isSearching)
        {
            <p class="map-canvas-note">@T["Searching…"]</p>
        }
        else if (_hasSearched && _matches.Count == 0)
        {
            <p class="map-canvas-note">@T["Nothing found for that. Try fewer words."]</p>
        }
        else if (_matches.Count > 1)
        {
            @* The pin is already on the best match, because that is what somebody searching expects to
               see. The rest are offered here rather than guessed between: street names repeat, and
               "Długa 4" is a real address in a dozen towns. *@
            <div class="map-canvas-matches">
                @foreach (var match in _matches.Skip(1))
                {
                    <button type="button" class="avatar-dropdown-item map-overlay-match"
                            @onclick="() => PinTheMatchAsync(match)">@match.Name</button>
                }
            </div>
        }
        @* The other way to pin a place, said out loud: the map takes a press anywhere on it, and a map
           that answers presses looks exactly like one that does not. Only while nothing is pinned - once
           there is one, the bar under the map is what the page is asking about. *@
        else if (_foundPlace is null)
        {
            <p class="map-canvas-note">@T["Click the map to drop a pin."]</p>
        }

        <div class="location-map-frame map-canvas-frame">
            <div id="@MapElementId" class="location-map"></div>
            @* Sits over the map rather than inside it: Leaflet owns its container's children, and
               the frame is what goes fullscreen, so the button stays reachable once it is. Which of
               the two labels shows is decided by CSS :fullscreen, so leaving fullscreen with Esc or
               the back gesture - neither of which this code sees - still leaves the button right. *@
            <button type="button" class="map-fullscreen-button" @onclick="ToggleFullscreenAsync">
                <span class="map-fullscreen-enter" title="@(T["Full screen"])" aria-label="@(T["Full screen"])">⤢</span>
                <span class="map-fullscreen-exit" title="@(T["Leave full screen"])" aria-label="@(T["Leave full screen"])">✕</span>
            </button>
            @* Beside it, and for when the reader wants it now: what others share is read again once a
               minute, and everything else only when the page opens. Moves the pins in place rather than
               redrawing the map, so the pan and the zoom somebody pressed it from are kept. *@
            <button type="button" class="map-refresh-button" title="@(T["Refresh the map"])"
                    aria-label="@(T["Refresh the map"])" disabled="@_isRefreshing" @onclick="RefreshTheMapAsync">
                <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 10a6 6 0 1 1-1.8-4.3" /><path d="M16 3.5v3.2h-3.2" />
                </svg>
            </button>
            @* The other corner, and the other way to keep a place: an empty form, for somewhere whose
               address is known and whose spot on the map is not obvious - a shop by name rather than a
               pin somebody has to find first. Pressing the map is still the quicker way when the place
               is on screen; this is the way in when it is not. Over the map for the same reason the
               fullscreen button is: Leaflet owns its container's children. *@
            <button type="button" class="map-add-place-button" title="@(T["Keep a place"])"
                    aria-label="@(T["Keep a place"])" @onclick="StartANewPlace">+</button>
        </div>

        @* A press on the map, waiting to be allowed. Above the bar about the pin itself, because it is
           about what would replace it - and nothing on the map has moved: see OnMapPressed. *@
        @if (_pressedPlace is { } pressed)
        {
            <div class="map-create-event map-press-asks">
                <span class="map-create-event-place">@pressed.Name</span>
                <span class="map-create-event-question">
                    @(_foundPlace is null ? T["Put a pin here?"] : T["Move the pin here?"])
                </span>
                <button type="button" class="btn-primary" @onclick="PinThePlacePressedAsync">@T["Yes"]</button>
                <button type="button" class="btn-secondary" @onclick="ForgetThePlacePressed">@T["No"]</button>
            </div>
        }

        @* Along the foot of the map, about the pin the search just dropped. Confirming it is not the
           same as knowing what to do with it - see the question that follows. *@
        @if (_foundPlace is { } found)
        {
            <div class="map-create-event">
                <span class="map-create-event-place">@found.Name</span>
                <span class="map-create-event-question">@T["Use this place?"]</span>
                <button type="button" class="btn-primary" @onclick="UseTheFoundPlace">@T["Yes, use it"]</button>
                <button type="button" class="btn-secondary" @onclick="ForgetTheFoundPlace">@T["Cancel"]</button>
            </div>
        }

        @* A route between two pins, chosen from their popups - see OnPinRoute. Along the foot of the map
           with the other questions about pins, because it is about two of them. *@
        @if (_routeStart is { } routeStart)
        {
            <div class="map-create-event map-route">
                @if (_routeEnd is { } routeEnd)
                {
                    <span class="map-create-event-place">@($"{routeStart.Address} → {routeEnd.Address}")</span>
                    @if (_route is { } route)
                    {
                        <span class="map-create-event-question">@DescribeRoute(route)</span>
                    }
                }
                else
                {
                    <span class="map-create-event-question">@T.Format("Route from {0}. Open another pin and choose where it goes.", routeStart.Address)</span>
                }
                <button type="button" class="btn-secondary" @onclick="ClearTheRouteAsync">@T["Clear the route"]</button>
            </div>
        }
    </div>
</div>
}

@* Which app takes somebody to the pin. Asked every time rather than remembered, because there is no
   right answer to remember: see NavigationApps. Over the map, like the question about what happens at a
   place, because both are about the pin under it. *@
@if (_takeMeTo is { } destination)
{
    <div class="map-overlay" @onclick="ForgetTheNavigation">
        <div class="map-overlay-panel" @onclick:stopPropagation="true">
            @* Said beside the heading, on the screen that is most careful about it: the map withholds its
               own background rather than fetch it from somebody else without being asked (see
               mapTiles.js), so a row of buttons that quietly hand an address to four companies would be
               the one place on the page that did not say so. Behind the mark rather than under the
               buttons, like every other section's own sentence; each button already names whose
               service it opens. *@
            <div class="map-overlay-header">
                <h2>@T["Take me there"]<FieldHint>@T["Only the first stays on this device. The rest open somebody else's service."]</FieldHint></h2>
            </div>
            <p class="map-overlay-hint">@destination.Label</p>
            <div class="map-overlay-confirm map-overlay-apps">
                @foreach (var app in NavigationApps.Offered(_isApplePlatform))
                {
                    <button type="button" class="@(app == NavigationApp.ThisDevice ? "btn-primary" : "btn-secondary")"
                            @onclick="() => TakeMeThereWithAsync(app)">@T[NavigationApps.NameOf(app)]</button>
                }
            </div>
            <div class="map-overlay-confirm">
                <button type="button" class="btn-secondary" @onclick="ForgetTheNavigation">@T["Cancel"]</button>
            </div>
        </div>
    </div>
}

@* Asked rather than guessed: a place, an appointment and an errand at the same address are different
   things, and only the person who pointed at it knows which they meant. Over the map, because the map is
   the page and the question is about the pin on it.

   Three answers on one picker rather than a row of three buttons, because they are three answers to one
   question and a row of buttons reads as three different ones. A place is the default because it is the
   least somebody can mean by pressing a map: it says where and nothing else, and the other two are that
   plus a time or plus a job. *@
@if (_placeToPlanFor is { } chosen)
{
    <div class="map-overlay" @onclick="ForgetTheChosenPlace">
        <div class="map-overlay-panel" @onclick:stopPropagation="true">
            <div class="map-overlay-header">
                <h2>@T["What happens here?"]</h2>
            </div>
            <p class="map-overlay-hint">@chosen.Address</p>
            <div class="field">
                <label for="mapWhatHappensHere">@T["Make it"]</label>
                <select id="mapWhatHappensHere" value="@_whatHappensHere"
                        @onchange="args => _whatHappensHere = args.Value?.ToString() ?? _whatHappensHere">
                    <option value="@nameof(PlanForAPlace.Place)">@T["A place worth keeping"]</option>
                    <option value="@nameof(PlanForAPlace.Event)">@T["An event in the calendar"]</option>
                    <option value="@nameof(PlanForAPlace.TaskList)">@T["A task list starting here"]</option>
                </select>
            </div>
            <div class="map-overlay-confirm">
                <button type="button" class="btn-primary icon-labelled" @onclick="MakeWhatWasChosen">
                    <span aria-hidden="true">✓</span> @T["Create"]
                </button>
                <button type="button" class="btn-secondary icon-labelled" @onclick="ForgetTheChosenPlace">
                    <span aria-hidden="true">✕</span> @T["Cancel"]
                </button>
            </div>
        </div>
    </div>
}

@* The form itself, opened either by the + on the map or by choosing "a place worth keeping" above. The
   pin it starts at is whichever of those two put it there - see StartANewPlace. *@
@if (_isKeepingAPlace)
{
    <PlaceForm StartsAt="_placeBeingKept" TaskLists="_taskLists"
               OnSaved="TheNewPlaceWasKeptAsync" OnCancelled="ForgetTheNewPlace" />
}

@* The same form again, on a place that already exists - see PlaceForm, which is one form for both
   because a place says the same thing whether it is being made or corrected. *@
@if (_placeBeingChanged is { } beingChanged)
{
    <PlaceForm Place="beingChanged" TaskLists="_taskLists"
               OnSaved="TheNewPlaceWasKeptAsync" OnCancelled="() => _placeBeingChanged = null" />
}

@* Handing a place to somebody, from the row it is on. Over the map like everything else this page asks,
   because the panel is a quarter of a phone and this is three questions and a message. *@
@if (_placeBeingShared is { } beingShared)
{
    <div class="map-overlay" @onclick="() => _placeBeingShared = null">
        <div class="map-overlay-panel" @onclick:stopPropagation="true">
            <div class="map-overlay-header">
                <h2>@T["Share"]</h2>
                <button type="button" class="icon-btn" title="@(T["Close"])" aria-label="@(T["Close"])"
                        @onclick="() => _placeBeingShared = null">✕</button>
            </div>
            <p class="map-overlay-hint">@beingShared.Name</p>
            <SharePlacePanel Place="beingShared" Contacts="_contacts" OwnUserId="_ownUserId"
                             OnShared="TheseSharesChangedAsync" />
            @* The other kind of sharing: a link anybody can read without an account. Only for a place
               this reader keeps - a link made from somebody else's would outlive the share it came from
               and would not be theirs to revoke (see PublicSharedItemReader.CanPublishAsync). *@
            @if (!beingShared.IsShared)
            {
                <ShareLinkButton ItemType="Place" ItemId="beingShared.Id" />
            }
        </div>
    </div>
}

@* Asked before it happens, because forgetting a place is the one thing on this panel that cannot be
   undone - a share can be started again and a pin can be redrawn. *@
@if (_placeBeingForgotten is { } beingForgotten)
{
    <div class="map-overlay" @onclick="() => _placeBeingForgotten = null">
        <div class="map-overlay-panel" @onclick:stopPropagation="true">
            <div class="map-overlay-header">
                <h2>@T["Forget this place?"]</h2>
            </div>
            <p class="map-overlay-hint">@beingForgotten.Name</p>
            <div class="map-overlay-confirm">
                <button type="button" class="btn-danger" disabled="@_isBusy"
                        @onclick="() => ForgetThePlaceAsync(beingForgotten)">@T["Delete"]</button>
                <button type="button" class="btn-secondary" @onclick="() => _placeBeingForgotten = null">@T["Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>What the reader is looking for on the map, and what came back.</summary>
    private string _searchText = string.Empty;
    private bool _isSearching;
    private IReadOnlyList<FoundPlace> _matches = [];

    /// <summary>Whether a search has been run at all - what tells "nothing found" from "nothing asked".</summary>
    private bool _hasSearched;

    /// <summary>The place the pin is currently on, which is what the corner is asking about. Null when there is no pin.</summary>
    private FoundPlace? _foundPlace;

    /// <summary>Enter searches, because a search box that only answers a button is a box people press Enter in and wait.</summary>
    private async Task OnSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    /// <summary>
    /// Looks the words up and pins the best answer. The rest of the matches stay on offer underneath -
    /// see the markup on why the first is pinned rather than chosen between.
    /// </summary>
    private async Task SearchAsync()
    {
        var query = _searchText.Trim();
        if (query.Length == 0)
        {
            return;
        }

        _isSearching = true;
        _hasSearched = true;
        _foundPlace = null;
        try
        {
            _matches = await GeocodingApiClient.SearchPlacesAsync(query);
            _foundPlace = _matches.FirstOrDefault();
        }
        catch (HttpRequestException exception)
        {
            // Somebody else's service, and not the point of the page: the map keeps whatever is on it.
            Logger.LogWarning(exception, "Could not search for a place on the map");
            _matches = [];
        }
        finally
        {
            _isSearching = false;
        }

        await RedrawAsync();
    }

    /// <summary>
    /// Where the reader pressed the map, which is the other way of pinning a place - the search names
    /// one, this points at one. Called from locationMap.js.
    ///
    /// The words are looked up because the rest of the page is about words: what the pin says is what
    /// travels to the editor and becomes an appointment's address. A point Nominatim knows nothing
    /// about - a field, the sea - keeps its coordinates and is named by them, since somebody who
    /// pressed there meant that spot whether or not it has a street.
    /// </summary>
    [JSInvokable]
    public async Task OnMapPressed(double latitude, double longitude)
    {
        // Nothing on the map moves yet. A press is easy to make by accident - a map is dragged and
        // zoomed by pressing it - so what a press produces is a question, and the pin somebody already
        // has stays where it is until that question is answered. Its own marker still needs drawing,
        // though - see MapPoints - which showLocations never did on its own; StateHasChanged only
        // repaints the banner asking the question, not the Leaflet map beside it.
        _pressedPlace = new FoundPlace(T["Looking up where that is…"], latitude, longitude);
        StateHasChanged();
        await RefreshMapMarkersAsync();

        var address = await GeocodingApiClient.ReverseGeocodeAsync(latitude, longitude);
        // Answered while the lookup was running: the reader has moved on, and the answer is about a
        // question that is no longer on screen.
        if (_pressedPlace is null)
        {
            return;
        }

        _pressedPlace = new FoundPlace(
            address is { Length: > 0 } ? address : DescribeCoordinates(latitude, longitude), latitude, longitude);
        StateHasChanged();
        await RefreshMapMarkersAsync();
    }

    /// <summary>Where the reader pressed, while the question about it is on screen - see OnMapPressed.</summary>
    private FoundPlace? _pressedPlace;

    /// <summary>"Yes" - the pin goes there, and what was searched for is no longer what is pinned.</summary>
    private async Task PinThePlacePressedAsync()
    {
        if (_pressedPlace is not { } pressed)
        {
            return;
        }

        _matches = [];
        _hasSearched = false;
        _placeToPlanFor = null;
        _foundPlace = pressed;
        _pressedPlace = null;
        await RedrawAsync();
    }

    /// <summary>"No" - the question goes, and the map is exactly as it was.</summary>
    private void ForgetThePlacePressed() => _pressedPlace = null;

    /// <summary>A place with no name of its own, said as the numbers it is - see OnMapPressed.</summary>
    private static string DescribeCoordinates(double latitude, double longitude)
        => string.Create(
            CoordinateCulture, $"{latitude:0.#####}, {longitude:0.#####}");

    /// <summary>Handed to the map so a press on it reaches this page - see OnMapPressed.</summary>
    private DotNetObjectReference<MapPage>? _pageReference;

    /// <summary>Moves the pin to one of the other matches, for when the first was the wrong Długa 4.</summary>
    private async Task PinTheMatchAsync(FoundPlace match)
    {
        _foundPlace = match;
        await RedrawAsync();
    }

    private async Task ForgetTheFoundPlace()
    {
        _foundPlace = null;
        _placeToPlanFor = null;
        _matches = [];
        _hasSearched = false;
        await RedrawAsync();
    }

    /// <summary>The confirmed pin, while the question about what to make of it is still on screen.</summary>
    private PickedPlace? _placeToPlanFor;

    /// <summary>
    /// Confirms the pin and asks what it is for. The two are separate steps because they are separate
    /// questions - "is this the place" is answered by looking at the map, and "what happens here" is not.
    /// </summary>
    private void UseTheFoundPlace()
    {
        if (_foundPlace is { } found)
        {
            _placeToPlanFor = new PickedPlace(found.Name, found.Latitude, found.Longitude);
        }
    }

    private void ForgetTheChosenPlace() => _placeToPlanFor = null;

    /// <summary>
    /// What a pressed place can become. Named rather than passed as loose strings, so a typo is a
    /// compiler error instead of a Create that quietly does nothing.
    /// </summary>
    private enum PlanForAPlace
    {
        /// <summary>Somewhere kept for its own sake - see Orbit.Core.Places.Place.</summary>
        Place,

        /// <summary>An appointment there, which is a place and a time.</summary>
        Event,

        /// <summary>A list of work starting there, whose first entry is that place - see TaskItemKind.Location.</summary>
        TaskList
    }

    /// <summary>
    /// Which of the three the picker is on. A place by default: it is the least somebody can mean by
    /// pressing a map, and the other two ask for a time or a job that nobody has mentioned yet.
    /// </summary>
    private string _whatHappensHere = nameof(PlanForAPlace.Place);

    private void MakeWhatWasChosen()
    {
        switch (_whatHappensHere)
        {
            case nameof(PlanForAPlace.Event):
                HandOverThePlaceTo("/calendar/new");
                break;
            case nameof(PlanForAPlace.TaskList):
                HandOverThePlaceTo("/tasks/new");
                break;
            default:
                KeepThisPlace();
                break;
        }
    }

    /// <summary>Whether the place form is open, whichever of the two ways opened it.</summary>
    private bool _isKeepingAPlace;

    /// <summary>The pin the form starts on, or null for the empty form the + opens.</summary>
    private PickedPlace? _placeBeingKept;

    /// <summary>
    /// The + in the corner: a form with nothing in it. Deliberately not seeded with whatever pin happens
    /// to be on the map - somebody who meant that pin has the question about it in front of them
    /// already, and starting from a place nobody asked for is how a place gets kept at the wrong one.
    /// </summary>
    private void StartANewPlace()
    {
        _placeBeingKept = null;
        _isKeepingAPlace = true;
    }

    /// <summary>The picker's own answer: the same form, opened on the pin the question was about.</summary>
    private void KeepThisPlace()
    {
        _placeBeingKept = _placeToPlanFor;
        _placeToPlanFor = null;
        _isKeepingAPlace = true;
    }

    private void ForgetTheNewPlace()
    {
        _isKeepingAPlace = false;
        _placeBeingKept = null;
    }

    /// <summary>
    /// Read back rather than added to the list here: the server decides the id and the order, and a page
    /// that guesses either would disagree with the next refresh. The map is redrawn with it, which is
    /// the whole reason somebody kept it.
    /// </summary>
    private async Task TheNewPlaceWasKeptAsync()
    {
        ForgetTheNewPlace();
        _placeBeingChanged = null;
        // The question pin has been answered: the place is on the map now under its own pin, and the red
        // one left beside it read as a second place still waiting to be kept.
        _foundPlace = null;
        _pressedPlace = null;
        _matches = [];
        _hasSearched = false;
        _places = await PlacesApiClient.GetPlacesAsync();
        await RefreshMapMarkersAsync();
    }

    /// <summary>The place whose form is open for changing, or null when none is - see PlaceForm.</summary>
    private PlaceDto? _placeBeingChanged;

    private void ChangeThePlace(PlaceDto place) => _placeBeingChanged = place;

    /// <summary>The place whose sharing panel is open, or null when none is.</summary>
    private PlaceDto? _placeBeingShared;

    private void ShareThePlace(PlaceDto place) => _placeBeingShared = place;

    /// <summary>
    /// Read back after a share so the row can say it is in somebody else's hands too. The panel stays
    /// open: sharing with a second person is an ordinary next thing to want.
    /// </summary>
    private async Task TheseSharesChangedAsync()
    {
        _places = await PlacesApiClient.GetPlacesAsync();
        _placeBeingShared = _places.FirstOrDefault(place => place.Id == _placeBeingShared?.Id);
    }

    /// <summary>
    /// A second one of the same, which is what a place that comes in pairs needs: two entrances to the
    /// same building, the near and far ends of one street. Named by the server, which is where the "copy"
    /// wording lives - see DuplicatePlaceCommand.
    /// </summary>
    private async Task DuplicateThePlaceAsync(PlaceDto place)
    {
        _isBusy = true;
        try
        {
            if (await PlacesApiClient.DuplicatePlaceAsync(place.Id) is null)
            {
                // Gone since the panel was drawn, which a refresh says better than an error does.
                _message = T["That place is not here any more."];
            }

            _places = await PlacesApiClient.GetPlacesAsync();
            await RefreshMapMarkersAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Could not duplicate a place");
            _hasFailed = true;
            _message = T["That could not be saved. Try again in a moment."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>The place the question about forgetting is about - see the overlay.</summary>
    private PlaceDto? _placeBeingForgotten;

    private void AskToForgetThePlace(PlaceDto place) => _placeBeingForgotten = place;

    private async Task ForgetThePlaceAsync(PlaceDto place)
    {
        _isBusy = true;
        try
        {
            await PlacesApiClient.DeletePlaceAsync(place.Id);
            _placeBeingForgotten = null;
            _places = await PlacesApiClient.GetPlacesAsync();
            await RefreshMapMarkersAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Could not delete a place");
            _hasFailed = true;
            _message = T["That could not be saved. Try again in a moment."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// Hands the place to the editor that makes something of it - neither an event nor a list is
    /// something this page can write, because only the person who pinned it knows when it is or what is
    /// on it. The place travels in ChosenPlace rather than in the address bar - see that class. Cleared
    /// from here as it goes, so backing out of the form and coming back does not find it waiting.
    /// </summary>
    private void HandOverThePlaceTo(string url)
    {
        if (_placeToPlanFor is not { } place)
        {
            return;
        }

        ChosenPlace.Hold(place);
        _placeToPlanFor = null;
        _foundPlace = null;
        NavigationManager.NavigateTo(url);
    }

    private const string MapElementId = "recordedLocationMap";

    /// <summary>Long enough for a cold GPS fix, short enough that a page waiting on nothing gives up.</summary>
    private const int PositionTimeoutMs = 15000;

    /// <summary>Matches the rest of the app's date formatting - see Dashboard.razor.</summary>
    /// <summary>
    /// Coordinates stay invariant whatever the interface language is: a Polish decimal comma turns a
    /// pair anyone might copy into a maps URL into a different place entirely. Dates beside them follow
    /// the language, through Translations.DisplayCulture.
    /// </summary>
    private static readonly CultureInfo CoordinateCulture = CultureInfo.InvariantCulture;

    private UserLocationDto? _location;
    private Guid _ownUserId;
    private IReadOnlyList<ContactDto> _contacts = [];
    private IReadOnlyList<SharedLocationDto> _ownShares = [];
    private IReadOnlyList<ReceivedPosition> _receivedPositions = [];
    private string _shareWithUserId = string.Empty;

    /// <summary>
    /// Names for a sharer this reader has not added as a contact - sharing a position only requires the
    /// sharer to have the recipient as a contact, not the other way round, so DisplayNameFor's usual
    /// lookup came up empty and said "Someone" for anybody who had not. Mirrors CalendarEventSummary's
    /// NameTheGuestsAsync, which resolves the same gap for a guest who is not a contact either.
    /// </summary>
    private readonly Dictionary<Guid, string> _sharerNames = [];

    /// <summary>
    /// Everything in the reader's own calendar and lists that says where it happens, soonest first, and
    /// the whole of it - what the panel shows is <see cref="_placed"/>, which is this without whatever
    /// has already been and gone. Both are kept so that changing one's mind about the past is a filter
    /// rather than another round of calls.
    /// </summary>
    private IReadOnlyList<PlacedPlan> _allPlaced = [];
    private IReadOnlyList<PlacedPlan> _placed = [];

    /// <summary>
    /// The places this reader keeps for their own sake - see Orbit.Core.Places.Place. Their own list
    /// rather than part of the plans above: a plan is something happening at a time, and these have no
    /// time at all, which is the whole point of them.
    /// </summary>
    private IReadOnlyList<PlaceDto> _places = [];

    /// <summary>
    /// Every list this account has, as the place form's "belongs to" picker needs them. Read as part of
    /// ReadWhatHasAPlaceAsync rather than on its own: that read wants them anyway, and a second request
    /// for the same answer is a second request.
    /// </summary>
    private IReadOnlyList<TaskDto> _taskLists = [];

    /// <summary>
    /// Whether what is already behind the reader is drawn as well - what has been and gone, and what
    /// has been done (see PlacedPlan.IsDone). Off, because a map is mostly about where somebody is
    /// going - and the last thing a page about that should be is a screen full of pins for places nobody
    /// is going to again.
    /// </summary>
    private bool _showsPastPlaces;

    /// <summary>
    /// The day to show the past from, while the past is being shown at all. Null is "all of it", which
    /// is what the option did before there was anywhere to say otherwise - and on an account with a year
    /// of appointments in it, that answer buried the two the reader actually wanted.
    /// </summary>
    private DateTime? _showsPastPlacesFrom;

    /// <summary>
    /// Refreshes every live share while this page is open. Deliberately tied to the page rather than
    /// running in the background: sharing a position is something someone is doing on purpose, and a
    /// timer that outlived the page would keep broadcasting after they had moved on from it.
    /// </summary>
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCancellation;
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMinutes(1);

    private bool _isLiveSharing => _ownShares.Any(share => share.IsContinuous);
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _hasFailed;
    private string? _message;

    /// <summary>The element only exists once there is something to draw, so drawing waits for the render that adds it.</summary>
    private bool _isMapDrawnFor;
    private IJSObjectReference? _mapModule;

    protected override async Task OnInitializedAsync()
    {
        // Waits for the first permission read, so this page never decides it is locked before it
        // has been told - see UserPermissionState.EnsureLoadedAsync.
        await Permissions.EnsureLoadedAsync();
        // Nothing below is reachable without this, and the page draws its locked notice instead - so it
        // does not ask and get turned away, which only fills the console with refusals that are not news.
        if (!Permissions.Has(ApplicationPermission.Location))
        {
            return;
        }

        _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync() ?? Guid.Empty;
        _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
        // Before anything is drawn, or a reader who hid a group of pins last time watches them appear
        // and then go again. The same store answers whether the past is being shown, and from when -
        // both were forgotten the moment the page was left, so the option had to be found and pressed
        // again on every visit.
        await MapPins.InitializeAsync();
        await PanelPins.InitializeAsync();
        _showsPastPlaces = MapPins.ShowsPastPlaces;
        _showsPastPlacesFrom = MapPins.PastPlacesFrom;
        await LoadAsync();
        // A live share left running from a previous visit shows whatever was last saved until the timer
        // below ticks for the first time, up to a minute away - reusing the same tick early means
        // opening the page is what freshens it, not a wait or a press on Update.
        if (_isLiveSharing)
        {
            await RefreshOnceAsync();
        }

        StartRefreshLoop();
        // MainLayout owns the poll; this only listens, so a notification arriving while the page is
        // open marks the row it is about without anything being read again.
        NotificationFeed.Changed += OnNotificationsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deliberately not keyed on firstRender: what goes on the map arrives from HTTP calls, so the
        // render that has something to draw is never the first one. Drawn even with nothing on it - the
        // map is the page, not a picture the page shows once there is a reason to.
        //
        // Gated on _isLoading too, not just _isMapDrawnFor: OnInitializedAsync awaits real HTTP calls
        // (LoadAsync), so Blazor renders once before that finishes - with the map element already in the
        // DOM (it isn't behind the _isLoading check) but _location/_receivedPositions still at their
        // default, empty values. Without this guard that first render was the one that got drawn: an
        // empty MapPoints() drew the map's own empty-state fallback (Warsaw, zoomed out, no pins) and
        // _isMapDrawnFor then stayed true, so the real data never got a redraw once it arrived - the map
        // looked broken until something else (a full reload) happened to land the loaded render first.
        if (_isMapDrawnFor || _isLoading || !Permissions.Has(ApplicationPermission.Location))
        {
            return;
        }

        _isMapDrawnFor = true;
        // Asked here rather than in OnInitializedAsync, which runs before there is a browser to ask:
        // both are plain globals loaded with the page (see viewport.js and mapTiles.js), and neither
        // answer changes while this page is open. What they decide is whether pressing a shared
        // position centres this map or opens the device's own - see MapAppHandoff.
        await ReadWhatThisDeviceCanDoAsync();
        try
        {
            _mapModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/locationMap.js");
            _pageReference ??= DotNetObjectReference.Create(this);
            await _mapModule.InvokeVoidAsync("showLocations", MapElementId, MapPoints(), _pageReference);
            // A map drawn again from scratch takes everything on it with it, a route included.
            await DrawTheRouteAsync();
            await GoToThePlaceAskedForAsync();
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Failed to draw the location map");
            _hasFailed = true;
            _message = T["The map couldn't be drawn, but your location is recorded."];
        }
    }

    /// <summary>
    /// Best effort, like everything else this page asks a browser: a call that fails leaves both answers
    /// as they are - a phone-sized screen unproven and the tiles assumed allowed - which is the pair
    /// that keeps the ordinary centring, and so changes nothing about a page that already worked.
    /// </summary>
    private async Task ReadWhatThisDeviceCanDoAsync()
    {
        try
        {
            _isPhone = await JSRuntime.InvokeAsync<bool>("OrbitViewport.isMobile");
            _mapTilesAllowed = await JSRuntime.InvokeAsync<bool>("OrbitMapTiles.areAllowed");
            // Which map app can be asked for directions, and what address asks it - see NavigationApps,
            // which decides both and needs only this one fact from the browser.
            await using var mapApp = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mapApp.js");
            _isApplePlatform = await mapApp.InvokeAsync<bool>("isApple");
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not read what this device can do with a map");
        }
    }

    /// <summary>
    /// Everything the map is showing: where the reader is, everyone sharing with them, and the pin a
    /// search just dropped. Each carries the colour it is drawn in - a sharer's is their own, the same
    /// one their name is written in beside the map, which is what ties a pin to a person without
    /// anybody having to click it - and a stable key, which is what lets locationMap.js's
    /// updateLocations move a marker that already exists instead of replacing it; see RefreshMapMarkersAsync.
    /// </summary>
    private IReadOnlyList<object> MapPoints()
    {
        var points = new List<object>();
        if (_location is { } own)
        {
            points.Add(new
            {
                // The one pin with no way to be taken to it: directions to where you are standing are
                // an app opening on a blank route.
                key = "own",
                latitude = own.Latitude,
                longitude = own.Longitude,
                label = own.Address ?? T["You"],
                color = "var(--accent)",
                canPlan = true,
                planEventLabel = T["An event here"],
                planTaskListLabel = T["A task list here"],
                routeLabel = RouteLabel
            });
        }

        // Both of the lists below can be taken off the map without being taken off the page - see
        // MapPinVisibility, and the eye on each panel's heading. A map covered in other people's pins is
        // a map the reader cannot find their own plans on, and until now the only way to clear either
        // was to stop the shares or delete the plans.
        if (MapPins.IsShown(MapPinVisibility.PinGroup.SharedWithYou))
        {
            points.AddRange(_receivedPositions.Select(received => (object)new
            {
                key = SharerMapKey(received.SharerUserId),
                latitude = received.Position.Latitude,
                longitude = received.Position.Longitude,
                label = $"{DisplayNameFor(received.SharerUserId)} · {received.Position.Address ?? T["shared a position"]}",
                color = AvatarHelper.AvatarColor(received.SharerUserId),
                canNavigate = true,
                navigateLabel = T["Take me there"],
                canPlan = true,
                planEventLabel = T["An event here"],
                planTaskListLabel = T["A task list here"],
                routeLabel = RouteLabel
            }));
        }

        // What the reader has planned, drawn in whatever colour the appointment itself is written in -
        // see PlacedPlan. Only what the panel is listing: hiding the past has to take its pins with it,
        // or the map keeps pins nothing on the page names any more.
        if (MapPins.IsShown(MapPinVisibility.PinGroup.YourPlans))
        {
            points.AddRange(_placed.Select(plan => (object)new
            {
                key = plan.Key,
                latitude = plan.Latitude,
                longitude = plan.Longitude,
                label = $"{plan.Title} · {plan.When} · {plan.Address}",
                color = plan.Color,
                canNavigate = true,
                navigateLabel = T["Take me there"],
                canPlan = true,
                planEventLabel = T["An event here"],
                planTaskListLabel = T["A task list here"],
                routeLabel = RouteLabel
            }));
        }

        // The places kept for their own sake, in whatever colour each was given - see MapPinVisibility,
        // and the eye on this list's own heading.
        if (MapPins.IsShown(MapPinVisibility.PinGroup.YourPlaces))
        {
            points.AddRange(_places.Select(place => (object)new
            {
                key = PlaceMapKey(place.Id),
                latitude = place.Where.Latitude,
                longitude = place.Where.Longitude,
                label = place.Where.Address is { Length: > 0 } address ? $"{place.Name} · {address}" : place.Name,
                color = ColourOf(place),
                canNavigate = true,
                navigateLabel = T["Take me there"],
                canPlan = true,
                planEventLabel = T["An event here"],
                planTaskListLabel = T["A task list here"],
                routeLabel = RouteLabel
            }));
        }

        if (_foundPlace is { } found)
        {
            // Its own colour, and not anybody's: this pin is a question rather than a person.
            points.Add(new
            {
                key = "found",
                latitude = found.Latitude,
                longitude = found.Longitude,
                label = found.Name,
                color = "var(--danger)",
                canNavigate = true,
                navigateLabel = T["Take me there"],
                canPlan = true,
                planEventLabel = T["An event here"],
                planTaskListLabel = T["A task list here"],
                routeLabel = RouteLabel
            });
        }

        if (_pressedPlace is { } pressed)
        {
            // Drawn alongside a found place still on screen rather than in place of it - "Move the pin
            // here?" is a question about two points, and answering it means seeing both.
            points.Add(new
            {
                key = "pressed",
                latitude = pressed.Latitude,
                longitude = pressed.Longitude,
                label = pressed.Name,
                color = "var(--danger)",
                canNavigate = true,
                navigateLabel = T["Take me there"],
                // Any spot on the map can be one end of a route: press it, and this pin is how.
                routeLabel = RouteLabel
            });
        }

        return points;
    }

    /// <summary>
    /// What colour a kept place is drawn in: the reader's own choice where they made one, and otherwise
    /// the colour a place is drawn in - the accent, so a list of them reads as one kind of thing.
    /// </summary>
    private static string ColourOf(PlaceDto place)
        => place.Colour.Length > 0 ? place.Colour : "var(--accent)";

    /// <summary>
    /// How much it matters, when that is worth saying. Normal is what everything is unless somebody said
    /// otherwise, so it is drawn as nothing rather than as a badge on every row - the same rule the
    /// dashboard's own badges follow.
    /// </summary>
    private static string? PriorityOf(PlaceDto place)
        => place.Priority is "Low" or "High" ? place.Priority : null;

    private string DescribePriority(string priority) => priority == "High" ? T["High"] : T["Low"];

    private static NavigationTarget TargetFor(PlaceDto place)
        => new(place.Name, place.Where.Latitude, place.Where.Longitude);

    /// <summary>The key its pin is drawn under - see MapPoints, and FocusOnPlaceOnTheMapAsync.</summary>
    private static string PlaceMapKey(Guid placeId) => $"place:{placeId}";

    /// <summary>
    /// A place this page was sent to look at - the dashboard's own card, where pressing a row means
    /// "show me this one" and there is no page of a place's own to send anybody to.
    ///
    /// In the address bar rather than in a scoped hand-over like ChosenPlace, and the difference is what
    /// it names: an id of this reader's own place, which is already what the link they might bookmark
    /// would say. ChosenPlace carries coordinates, which is the thing that must not sit in a URL.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "place")]
    public Guid? Place { get; set; }

    /// <summary>
    /// Centres on it once the map is actually drawn. Silent for an id this account has no place under -
    /// a link to one that has since been forgotten still arrives at the map, which is the right answer,
    /// and an error about a row nobody chose to open is noise.
    /// </summary>
    private async Task GoToThePlaceAskedForAsync()
    {
        if (_hasGoneToThePlaceAskedFor
            || Place is not { } placeId
            || _places.All(place => place.Id != placeId))
        {
            return;
        }

        // Once, however many renders follow - otherwise every redraw would drag the map back to it and
        // the reader could never look anywhere else.
        _hasGoneToThePlaceAskedFor = true;
        await FocusTheMapOnAsync(PlaceMapKey(placeId), "a kept place asked for by link");
    }

    /// <inheritdoc cref="GoToThePlaceAskedForAsync"/>
    private bool _hasGoneToThePlaceAskedFor;

    private Task FocusOnPlaceOnTheMapAsync(PlaceDto place)
        => FocusTheMapOnAsync(PlaceMapKey(place.Id), "a kept place");

    private async Task FocusOnPlaceOnTheMapOnEnterOrSpaceAsync(KeyboardEventArgs args, PlaceDto place)
    {
        if (args.Key is "Enter" or " ")
        {
            await FocusOnPlaceOnTheMapAsync(place);
        }
    }

    /// <summary>
    /// The pin on a panel's heading: whether this list is kept at the top of the panel. The same
    /// control every other list in Orbit pins with, so the gesture means one thing everywhere - and a
    /// different question from the eye beside it, which is about the map rather than about the panel.
    /// </summary>
    private RenderFragment RenderPanelPin(MapPanelPins.PanelList list)
        => @<PinButton IsPinned="PanelPins.IsPinned(list)"
                       OnPinnedChanged="pinned => SetPanelPinnedAsync(list, pinned)" />;

    /// <summary>What lifts a pinned box past the others - see .map-panel-lists, where the order lives.</summary>
    private string? PinnedClass(MapPanelPins.PanelList list)
        => PanelPins.IsPinned(list) ? "map-panel-section-pinned" : null;

    private async Task SetPanelPinnedAsync(MapPanelPins.PanelList list, bool isPinned)
    {
        Logger.LogInformation(
            "User {Action} the {List} list on the map panel", isPinned ? "pinned" : "unpinned", list);
        await PanelPins.SetPinnedAsync(list, isPinned);
    }

    /// <summary>
    /// The eye on a panel's heading: whether this list's pins are drawn. Struck through while they are
    /// not, so the button says which of the two states the map is in rather than only what pressing it
    /// will do - a lone eye is read both ways by different people.
    /// </summary>
    private RenderFragment RenderPinToggle(MapPinVisibility.PinGroup group, string showLabel, string hideLabel)
        => @<button type="button" class="icon-btn map-pin-toggle @(MapPins.IsShown(group) ? "" : "off")"
                    title="@(MapPins.IsShown(group) ? hideLabel : showLabel)"
                    aria-label="@(MapPins.IsShown(group) ? hideLabel : showLabel)"
                    aria-pressed="@(MapPins.IsShown(group) ? "true" : "false")"
                    @onclick="() => TogglePinsAsync(group)">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1.5 10S4.5 4.5 10 4.5 18.5 10 18.5 10 15.5 15.5 10 15.5 1.5 10 1.5 10Z" />
                <circle cx="10" cy="10" r="2.5" />
                @if (!MapPins.IsShown(group))
                {
                    <path d="M4 16 16 4" />
                }
            </svg>
        </button>;

    /// <summary>
    /// Pressing it. The map is redrawn rather than the page rebuilt: what is on the page has not
    /// changed, only which of it is drawn - and rebuilding would reset the pan, the zoom and any open
    /// popup, which is the thing RefreshMapMarkersAsync exists to avoid.
    /// </summary>
    private async Task TogglePinsAsync(MapPinVisibility.PinGroup group)
    {
        var isShown = !MapPins.IsShown(group);
        Logger.LogInformation("User {Action} the {Group} pins on the map", isShown ? "showed" : "hid", group);
        await MapPins.SetShownAsync(group, isShown);
        await RefreshMapMarkersAsync();
    }

    /// <summary>
    /// The day to show the past from. An unreadable or empty box is "all of it", which is what the
    /// option meant before there was anywhere to say otherwise.
    /// </summary>
    private async Task OnShowPastFromChangedAsync(ChangeEventArgs args)
    {
        _showsPastPlacesFrom = DateTime.TryParse(args.Value?.ToString(), out var from) ? from : null;
        Logger.LogInformation(
            "User asked the map for past places from {From}", _showsPastPlacesFrom?.ToString("yyyy-MM-dd") ?? "the beginning");
        await MapPins.SetPastPlacesAsync(_showsPastPlaces, _showsPastPlacesFrom);
        ChooseWhichPlacesAreShown();
        // The map draws what the list shows, so the pins for what is no longer listed have to go with it.
        _ = RefreshMapMarkersAsync();
    }

    /// <summary>The key a sharer's own marker is drawn under - see MapPoints and FocusOnAsync.</summary>
    private static string SharerMapKey(Guid sharerUserId) => $"sharer:{sharerUserId}";

    private async Task LoadAsync()
    {
        try
        {
            var account = await UsersApiClient.GetAccountAsync();
            _location = account?.Location;
            _contacts = await ChatApiClient.GetContactsAsync();
            _ownShares = await UsersApiClient.GetOwnLocationSharesAsync();
            _receivedPositions = await OpenReceivedPositionsAsync();
            await NameTheSharersAsync();
            await ReadWhatHasAPlaceAsync();
            _places = await PlacesApiClient.GetPlacesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the recorded location");
            _hasFailed = true;
            _message = T["Couldn't load your location. Try again."];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Asks the browser where it is, resolves an address for it best-effort, and saves both. The browser
    /// asks the user's permission itself; a refusal comes back as an ordinary message rather than an
    /// error, since declining is a legitimate answer.
    /// </summary>
    private async Task RecordCurrentLocationAsync() => await RecordCurrentLocationAsync(announce: true, redraw: true);

    /// <param name="redraw">
    /// False for the once-a-minute refresh: rebuilding the map from scratch there reset whatever the
    /// reader was looking at - the pan, the zoom, an open popup - every time it ticked, which made
    /// actually reading the map while a live share ran impossible. Only what moved needs redrawing then,
    /// so this instead asks RefreshMapMarkersAsync to move the markers on the map that is already there.
    /// </param>
    private async Task RecordCurrentLocationAsync(bool announce, bool redraw)
    {
        if (!DevicePreferences.AllowLocation)
        {
            // Nothing is asked of the browser at all: its own permission prompt is a question worth
            // having agreed to beforehand, and reaching it without that agreement is the thing the
            // setting exists to prevent - see DevicePreferences.AllowLocation.
            _hasFailed = true;
            _message = T["Orbit isn't allowed to use your location. Turn it on in Options first."];
            return;
        }

        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await using var geolocationModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/geolocation.js");
            var position = await geolocationModule.InvokeAsync<BrowserPosition>("getCurrentPosition", PositionTimeoutMs);

            if (position.Error is { } error)
            {
                _hasFailed = true;
                _message = error;
                return;
            }

            // Best-effort: a point with no address is still worth keeping, so a failed lookup doesn't
            // stop the save.
            var address = await TryResolveAddressAsync(position.Latitude, position.Longitude);
            await UsersApiClient.SaveOwnLocationAsync(position.Latitude, position.Longitude, address);

            if (redraw)
            {
                await RedrawAsync();
            }
            else
            {
                await LoadAsync();
                await RefreshMapMarkersAsync();
            }

            if (announce)
            {
                _message = T["Location recorded."];
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to save the recorded location");
            _hasFailed = true;
            _message = T["Couldn't save your location. Try again."];
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Failed to read the browser's position");
            _hasFailed = true;
            _message = T["Your location couldn't be read in this browser."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<string?> TryResolveAddressAsync(double latitude, double longitude)
    {
        try
        {
            return await GeocodingApiClient.ReverseGeocodeAsync(latitude, longitude);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Reverse geocoding failed for a recorded location");
            return null;
        }
    }

    private async Task ClearLocationAsync()
    {
        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await UsersApiClient.ClearOwnLocationAsync();
            await DisposeMapAsync();
            await RedrawAsync();
            _message = T["Location forgotten."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to clear the recorded location");
            _hasFailed = true;
            _message = T["Couldn't clear your location. Try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>Whether the refresh button's read is still running, so a second press waits for it.</summary>
    private bool _isRefreshing;

    /// <summary>
    /// The refresh button beside full screen: everything the page reads, read again, and the pins moved
    /// to match - see RefreshMapMarkersAsync for why the map itself is not rebuilt.
    /// </summary>
    private async Task RefreshTheMapAsync()
    {
        Logger.LogInformation("User refreshed the map");
        _isRefreshing = true;
        try
        {
            await LoadAsync();
            await RefreshMapMarkersAsync();
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    /// <summary>Reloads and lets the next render put a fresh map in place of the old one.</summary>
    private async Task RedrawAsync()
    {
        await DisposeMapAsync();
        _isMapDrawnFor = false;
        await LoadAsync();
    }

    /// <summary>
    /// Moves the markers on the map that is already there, without touching its pan or zoom - the light
    /// alternative to RedrawAsync's dispose-and-rebuild, for whatever must not reset what the reader is
    /// looking at: a live share's own once-a-minute refresh, and a press on the map that has to draw its
    /// pin without losing the view the press itself was made on. A no-op before the map exists at all -
    /// the render that follows draws it fresh with whatever is current by then, see OnAfterRenderAsync.
    /// </summary>
    private async Task RefreshMapMarkersAsync()
    {
        if (_mapModule is null)
        {
            return;
        }

        try
        {
            await _mapModule.InvokeVoidAsync("updateLocations", MapElementId, MapPoints());
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not update the markers on the location map");
        }
    }

    private async Task DisposeMapAsync()
    {
        if (_mapModule is null)
        {
            return;
        }

        try
        {
            await _mapModule.InvokeVoidAsync("dispose", MapElementId);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, so there is no map left to tear down.
        }
        catch (ObjectDisposedException)
        {
            // The page was left while this was still running - DisposeAsync got to the module first.
            // Both mean the same thing here, and taking the renderer down over a map that is already
            // gone is worse than either.
        }
    }


    /// <summary>
    /// Opens each position shared with this user. Each was sealed between its sharer and this reader, so
    /// the key is the pairwise one with that sharer. A position that won't open is left out rather than
    /// failing the page - most often one sealed for a key pair since replaced.
    /// </summary>
    private async Task<IReadOnlyList<ReceivedPosition>> OpenReceivedPositionsAsync()
    {
        var shared = await UsersApiClient.GetLocationsSharedWithMeAsync();
        var opened = new List<ReceivedPosition>(shared.Count);

        foreach (var share in shared)
        {
            var plainText = await EncryptedChatMessageReader.TryDecryptFromAsync(
                _ownUserId, share.SharerUserId, share.CiphertextBase64, share.NonceBase64);
            if (plainText is null)
            {
                continue;
            }

            var position = JsonSerializer.Deserialize<SharedLocationSender.SharedPosition>(plainText);
            if (position is not null)
            {
                opened.Add(new ReceivedPosition(share.SharerUserId, share.IsContinuous, position));
            }
        }

        return opened;
    }

    /// <summary>
    /// Names whichever sharer is not this reader's own contact - see _sharerNames. Sharing a position
    /// only requires the sharer to have the recipient as a contact, not the other way round, so this
    /// reader may never have added them at all.
    /// </summary>
    private async Task NameTheSharersAsync()
    {
        try
        {
            foreach (var sharerUserId in _receivedPositions.Select(received => received.SharerUserId).Distinct())
            {
                if (_contacts.Any(contact => contact.UserId == sharerUserId) || _sharerNames.ContainsKey(sharerUserId))
                {
                    continue;
                }

                if (await UsersApiClient.GetUserAsync(sharerUserId) is { } user)
                {
                    _sharerNames[sharerUserId] = user.DisplayName;
                }
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't name everyone sharing a position with this user");
        }
    }

    /// <summary>
    /// Shares the position already recorded for this user. Recording one first is deliberate: it keeps
    /// "what Orbit knows about where I am" a single thing the user set on purpose, rather than sharing
    /// silently reading the device behind a second, easier-to-miss button.
    /// </summary>
    private async Task AddShareAsync()
    {
        if (Guid.TryParse(_shareWithUserId, out var recipientUserId))
        {
            await ShareAsync(recipientUserId, isContinuous: false);
        }
    }

    /// <summary>
    /// Changes how somebody is being shared with. Sharing again with the same person overwrites the row
    /// rather than adding one, so this is the whole of it - see SharedLocationSender.
    /// </summary>
    private Task SetShareModeAsync(Guid recipientUserId, bool isContinuous)
        => ShareAsync(recipientUserId, isContinuous);

    private async Task ShareAsync(Guid recipientUserId, bool isContinuous)
    {
        if (_location is not { } location)
        {
            _hasFailed = true;
            _message = T["Record where you are first - there is nothing to share yet."];
            return;
        }

        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            // Checked before sharing, because sharing again with the same person overwrites the row
            // rather than adding one - and the chat message should mark the act of sharing, not every
            // time the position behind it moves. The refresh timer never comes through here at all.
            var isNewShare = _ownShares.All(share => share.RecipientUserId != recipientUserId);

            await SharedLocationSender.ShareAsync(
                _ownUserId, recipientUserId,
                new SharedLocationSender.SharedPosition(location.Latitude, location.Longitude, location.Address, location.RecordedAtUtc),
                isContinuous);

            if (isNewShare)
            {
                await AnnounceShareInChatAsync(recipientUserId, isContinuous);
            }

            _shareWithUserId = string.Empty;
            await RedrawAsync();
            _message = isContinuous
                ? T["Sharing. Your position goes out again every minute while this page is open."]
                : T["Sent. That one position is all they can see."];
        }
        catch (InvalidOperationException exception)
        {
            // The recipient has never signed in, so there is no key to seal for them.
            Logger.LogWarning(exception, "Could not share a location");
            _hasFailed = true;
            _message = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to share a location");
            _hasFailed = true;
            _message = T["Couldn't share your location. Try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StopSharingAsync(Guid recipientUserId)
    {
        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await UsersApiClient.StopSharingLocationAsync(recipientUserId);
            await RedrawAsync();
            _message = T["Stopped. Orbit no longer holds that position at all."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to stop sharing a location");
            _hasFailed = true;
            _message = T["Couldn't stop sharing. Try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// Refuses what somebody is sharing with this reader. The row is deleted, so their position is gone
    /// from Orbit rather than merely off this map - see StopReceivingLocationCommand.
    /// </summary>
    private async Task StopReceivingAsync(Guid sharerUserId)
    {
        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await UsersApiClient.StopReceivingLocationAsync(sharerUserId);
            await RedrawAsync();
            _message = T["Stopped. Orbit no longer holds that position at all."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to stop receiving a location from {SharerUserId}", sharerUserId);
            _hasFailed = true;
            _message = T["Couldn't stop sharing. Try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// Re-records the device's position and sends it to everyone being shared with continuously, once a
    /// minute. Failures are swallowed: a minute that couldn't be sent is not worth interrupting the page
    /// for, and the next one will try again.
    /// </summary>
    private void StartRefreshLoop()
    {
        _refreshCancellation = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(RefreshInterval);
        _ = RefreshLoopAsync(_refreshCancellation.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _refreshTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshOnceAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The page was left - the loop is meant to end with it.
        }
    }

    private async Task RefreshOnceAsync()
    {
        try
        {
            var live = _ownShares.Where(share => share.IsContinuous).ToList();
            if (live.Count > 0)
            {
                await RecordCurrentLocationAsync(announce: false, redraw: false);
                if (_location is { } location)
                {
                    foreach (var share in live)
                    {
                        await SharedLocationSender.ShareAsync(
                            _ownUserId, share.RecipientUserId,
                            new SharedLocationSender.SharedPosition(location.Latitude, location.Longitude, location.Address, location.RecordedAtUtc),
                            isContinuous: true);
                    }
                }
            }

            // A friend's own position can have moved since the last tick even when this reader is not
            // sharing anything back - refreshed either way, and without resetting the map the same
            // reason applies to: see RefreshMapMarkersAsync.
            _receivedPositions = await OpenReceivedPositionsAsync();
            await NameTheSharersAsync();
            await RefreshMapMarkersAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JSException or InvalidOperationException)
        {
            Logger.LogWarning(exception, "A location refresh tick did not complete");
        }
    }

    /// <summary>
    /// Puts the share in the conversation with whoever received it, the way sharing a note or an event
    /// already does. Best-effort: the position has been shared by the time this runs, and failing to
    /// mention it is not a reason to report the share itself as failed.
    /// </summary>
    private async Task AnnounceShareInChatAsync(Guid recipientUserId, bool isContinuous)
    {
        try
        {
            var payloadJson = JsonSerializer.Serialize(new LocationShareMessagePayload(isContinuous));
            await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson, isShareInvitation: true);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Shared a location but could not announce it in the chat with {RecipientUserId}", recipientUserId);
        }
    }

    /// <summary>
    /// Puts the map full screen and back. Esc and the back gesture also leave it, and neither reaches
    /// here - which is why nothing about the state is kept in this component; see the CSS that decides
    /// which half of the button shows.
    /// </summary>
    private async Task ToggleFullscreenAsync()
    {
        try
        {
            _mapModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/locationMap.js");
            var frame = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "document.querySelector", ".location-map-frame");
            await using (frame)
            {
                await _mapModule.InvokeAsync<bool>("toggleFullscreen", frame);
            }
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not put the map full screen");
        }
    }

    /// <summary>Whether to offer the Google links - see GoogleIntegrationAccess for who qualifies.</summary>
    private bool _hasGoogleExtras;

    private string DisplayNameFor(Guid userId)
        => _contacts.FirstOrDefault(contact => contact.UserId == userId)?.DisplayName
           ?? (_sharerNames.TryGetValue(userId, out var name) ? name : T["Someone"]);

    /// <summary>
    /// Pans the map to where somebody is and opens their pin, without moving anything else - see
    /// RefreshMapMarkersAsync's own reasoning for why a press here must not reset the map.
    /// </summary>
    /// <summary>
    /// Whether this browser is a phone-sized one, and whether the map may draw its background - read
    /// once, after the first render, because both are JS calls and neither changes while the page is
    /// open. Null until then, which reads as "no" and so leaves the ordinary centring in place: a page
    /// that handed off before it knew where it was would be worse than one that answered a moment late.
    /// </summary>
    private bool _isPhone;
    private bool _mapTilesAllowed = true;

    /// <summary>
    /// Pressing a shared position. Ordinarily it centres Orbit's own map on that pin; on a phone whose
    /// map cannot answer it opens the device's map app instead - see MapAppHandoff for which is which.
    /// </summary>
    private Task OpenSharedPositionAsync(ReceivedPosition received)
        => MapAppHandoff.ShouldOpenTheMapApp(_isPhone, _mapTilesAllowed, _location is not null)
            ? OpenInTheMapAppAsync(received)
            : FocusOnAsync(received);

    /// <summary>
    /// Somewhere on the map the reader has asked to be taken to, while the question of which app should
    /// take them is open. Null the rest of the time, which is what draws no overlay.
    /// </summary>
    private NavigationTarget? _takeMeTo;

    /// <summary>Whether this is an iPhone, an iPad or a Mac - read once, from mapApp.js. See NavigationApps.</summary>
    private bool _isApplePlatform;

    /// <summary>One pin, as far as being taken to it is concerned - a name to show and a point to aim at.</summary>
    private sealed record NavigationTarget(string Label, double Latitude, double Longitude);

    private NavigationTarget TargetFor(ReceivedPosition received)
        => new(
            DisplayNameFor(received.SharerUserId),
            received.Position.Latitude, received.Position.Longitude);

    private static NavigationTarget TargetFor(PlacedPlan plan)
        => new(plan.Title, plan.Latitude, plan.Longitude);

    private void AskHowToGetTo(NavigationTarget target)
    {
        Logger.LogInformation("User asked how to get to a pin on the map");
        _takeMeTo = target;
    }

    private void ForgetTheNavigation() => _takeMeTo = null;

    /// <summary>
    /// The pin's own way of asking - the button inside its popup, which reports the press by the key the
    /// marker was drawn under (see locationMap.js). Everything that carries one is looked up here rather
    /// than the coordinates being handed back through JavaScript: a key is an identity this page already
    /// keeps, and a pair of numbers arriving from the browser would be a position nothing had checked.
    ///
    /// A key nothing answers to - a marker left over from a list that has since changed - opens nothing,
    /// which is the same thing a press on a pin that is no longer there should do.
    /// </summary>
    [JSInvokable]
    public Task OnPinNavigate(string key)
    {
        if (TargetForKey(key) is { } target)
        {
            AskHowToGetTo(target);
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The popup's other two buttons: an appointment or a list of work at that pin, started straight
    /// from it rather than by pinning the same spot a second time and answering "what happens here?".
    /// The place travels the way the question's own answer sends it - see HandOverThePlaceTo.
    ///
    /// Looked up by key for the reason OnPinNavigate gives. What travels is the pin's address where it
    /// has one, because that is what an event's location field and a list's first entry are written in.
    /// </summary>
    [JSInvokable]
    public Task OnPinPlan(string key, string plan)
    {
        if (PlaceForKey(key) is not { } place)
        {
            return Task.CompletedTask;
        }

        Logger.LogInformation("User started {Plan} from a pin on the map", plan);
        _placeToPlanFor = place;
        HandOverThePlaceTo(plan == nameof(PlanForAPlace.Event) ? "/calendar/new" : "/tasks/new");
        return Task.CompletedTask;
    }

    /// <summary>Where the route being drawn starts, once a pin's popup has said so - see OnPinRoute.</summary>
    private PickedPlace? _routeStart;

    /// <summary>Where it ends, once a second pin has said so. Never set without a start.</summary>
    private PickedPlace? _routeEnd;

    /// <summary>What drawing it came back with - how far, how long, and whether it follows the roads.</summary>
    private RouteSummary? _route;

    /// <summary>
    /// What locationMap.js's showRoute answers: the distance always, the time only when the route came
    /// from the routing service, and whether it follows the roads or is a straight line between the two.
    /// </summary>
    private sealed record RouteSummary(double DistanceMetres, double? DurationSeconds, bool FollowsRoads);

    /// <summary>
    /// What the route button in a popup says: where a route starts until one has, and where it goes after.
    /// One button that changes rather than two side by side - a popup is two lines wide, and "from here"
    /// and "to here" together would be a question the reader has to answer before they have one.
    /// </summary>
    private string RouteLabel => _routeStart is null || _routeEnd is not null
        ? T["Start a route here"]
        : T["Route to here"];

    /// <summary>
    /// The route button in a pin's popup. The first press says where a route starts; the second, on
    /// another pin, where it goes, and the route is drawn. A press once both are chosen starts over from
    /// that pin, which is what somebody pressing "start a route here" on a map already showing one means.
    ///
    /// Looked up by key for the reason OnPinNavigate gives.
    /// </summary>
    [JSInvokable]
    public async Task OnPinRoute(string key)
    {
        if (PlaceForKey(key) is not { } place)
        {
            return;
        }

        if (_routeStart is null || _routeEnd is not null)
        {
            Logger.LogInformation("User started a route on the map");
            await ClearTheRouteLineAsync();
            _routeStart = place;
            _routeEnd = null;
            _route = null;
        }
        else
        {
            Logger.LogInformation("User finished a route on the map");
            _routeEnd = place;
            await DrawTheRouteAsync();
        }

        // The popups' own button says the other thing now.
        await RefreshMapMarkersAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Draws the chosen route on the map. The road route comes from a service somebody else runs, so it is
    /// asked for only where the reader lets Orbit reach other sites at all - the same answer that decides
    /// whether the map has a background (see mapTiles.js). Otherwise, and when the service does not
    /// answer, the two ends are joined in a straight line and the distance is that line's.
    /// </summary>
    private async Task DrawTheRouteAsync()
    {
        if (_mapModule is null || _routeStart is not { } start || _routeEnd is not { } end)
        {
            return;
        }

        try
        {
            _route = await _mapModule.InvokeAsync<RouteSummary?>(
                "showRoute", MapElementId,
                new { latitude = start.Latitude, longitude = start.Longitude },
                new { latitude = end.Latitude, longitude = end.Longitude },
                _mapTilesAllowed);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not draw a route on the map");
            _route = null;
        }
    }

    private async Task ClearTheRouteAsync()
    {
        await ClearTheRouteLineAsync();
        _routeStart = null;
        _routeEnd = null;
        _route = null;
        await RefreshMapMarkersAsync();
    }

    private async Task ClearTheRouteLineAsync()
    {
        if (_mapModule is null)
        {
            return;
        }

        try
        {
            await _mapModule.InvokeVoidAsync("clearRoute", MapElementId);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not take a route off the map");
        }
    }

    /// <summary>
    /// How far and how long, in the reader's own number format. A straight line says so: its distance is
    /// as the crow flies, and a reader who took it for the road would set out underestimating the trip.
    /// </summary>
    private string DescribeRoute(RouteSummary route)
    {
        var kilometres = (route.DistanceMetres / 1000).ToString("0.0", T.DisplayCulture);
        if (!route.FollowsRoads)
        {
            return $"{kilometres} km · {T["in a straight line"]}";
        }

        return route.DurationSeconds is { } seconds
            ? $"{kilometres} km · {T.Format("about {0} min", Math.Max(1, (int)Math.Round(seconds / 60)))}"
            : $"{kilometres} km";
    }

    private PickedPlace? PlaceForKey(string key)
    {
        if (key == "own" && _location is { } own)
        {
            return new PickedPlace(own.Address ?? DescribeCoordinates(own.Latitude, own.Longitude), own.Latitude, own.Longitude);
        }

        foreach (var received in _receivedPositions)
        {
            if (SharerMapKey(received.SharerUserId) == key)
            {
                return new PickedPlace(
                    received.Position.Address ?? DescribeCoordinates(received.Position.Latitude, received.Position.Longitude),
                    received.Position.Latitude, received.Position.Longitude);
            }
        }

        foreach (var plan in _placed)
        {
            if (plan.Key == key)
            {
                return new PickedPlace(plan.Address, plan.Latitude, plan.Longitude);
            }
        }

        foreach (var place in _places)
        {
            if (PlaceMapKey(place.Id) == key)
            {
                return new PickedPlace(
                    place.Where.Address is { Length: > 0 } address ? address : place.Name,
                    place.Where.Latitude, place.Where.Longitude);
            }
        }

        return TargetForKey(key) is { } target ? new PickedPlace(target.Label, target.Latitude, target.Longitude) : null;
    }

    private NavigationTarget? TargetForKey(string key)
    {
        foreach (var received in _receivedPositions)
        {
            if (SharerMapKey(received.SharerUserId) == key)
            {
                return TargetFor(received);
            }
        }

        foreach (var plan in _placed)
        {
            if (plan.Key == key)
            {
                return TargetFor(plan);
            }
        }

        foreach (var place in _places)
        {
            if (PlaceMapKey(place.Id) == key)
            {
                return TargetFor(place);
            }
        }

        return (key, _foundPlace, _pressedPlace) switch
        {
            ("found", { } found, _) => new NavigationTarget(found.Name, found.Latitude, found.Longitude),
            ("pressed", _, { } pressed) => new NavigationTarget(pressed.Name, pressed.Latitude, pressed.Longitude),
            _ => null
        };
    }

    /// <summary>
    /// Opens the directions in the app that was chosen. The overlay closes either way: a device with no
    /// app registered for the scheme does nothing at all, and leaving the question open over a map app
    /// that has just taken the whole screen is a panel to come back to and dismiss.
    /// </summary>
    private async Task TakeMeThereWithAsync(NavigationApp app)
    {
        if (_takeMeTo is not { } target)
        {
            return;
        }

        _takeMeTo = null;
        Logger.LogInformation("User asked {App} for directions to a pin on the map", app);
        try
        {
            await using var mapApp = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mapApp.js");
            await mapApp.InvokeVoidAsync(
                "openUrl", NavigationApps.RouteTo(app, _isApplePlatform, target.Latitude, target.Longitude));
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not open directions to a pin in {App}", app);
        }
    }

    /// <summary>
    /// Hands the position to whatever map app the device has - see mapApp.js for why that rather than a
    /// Google Maps URL. The name is what the pin is called once it arrives.
    /// </summary>
    private async Task OpenInTheMapAppAsync(ReceivedPosition received)
    {
        try
        {
            await using var mapApp = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mapApp.js");
            await mapApp.InvokeVoidAsync(
                "openPosition", received.Position.Latitude, received.Position.Longitude,
                DisplayNameFor(received.SharerUserId));
        }
        catch (JSException exception)
        {
            // A device with no map app registered for the scheme does nothing at all, which is not
            // something this page can fix or usefully say. The pin is still on the map behind it.
            Logger.LogWarning(exception, "Could not open a shared position in the device's map app");
        }
    }

    /// <summary>
    /// One thing in the reader's calendar or on one of their lists that says where it happens - an
    /// appointment, or the entry on a list that raised one. Everything about drawing it is worked out
    /// once, when it is read, so neither the panel nor the map has to think about where it came from.
    /// </summary>
    /// <param name="Key">
    /// What its pin is drawn under, so a refresh moves the marker it already has rather than replacing
    /// it - see MapPoints.
    /// </param>
    /// <param name="OpenUrl">
    /// Where pressing Open goes, which is the same place the calendar and the dashboard send an event:
    /// its own summary, or the entry behind it where a list raised it - see CalendarEventDestination.
    /// </param>
    /// <param name="Destination">
    /// Where pressing Open goes, without the "come back here" attached - what a notification about this
    /// plan would point at, which is not the same string as <paramref name="OpenUrl"/>.
    /// </param>
    /// <param name="NewsUrl">
    /// The other address a notification about it could carry. An appointment a task list raised is
    /// opened as that entry, but the reminder for it is the event's and says so - reading only the
    /// destination would leave exactly those rows unmarked. Mirrors Dashboard's UpcomingEntry.
    /// </param>
    /// <param name="IsDone">
    /// Whether the entry that raised it has been ticked off. An appointment a task list made is done
    /// when its entry is, whatever the clock says - the shopping was done on Tuesday for a slot booked
    /// on Friday - and the map went on drawing a pin for it until Friday came and went. Counted with
    /// what has already been and gone rather than as a fourth thing: both are "behind you", and a reader
    /// asking to see the past means both.
    /// </param>
    private sealed record PlacedPlan(
        string Key, string Title, string When, string Address, double Latitude, double Longitude,
        string Color, DateTimeOffset At, bool HasPassed, bool IsDone, string OpenUrl, string Destination, string NewsUrl)
    {
        /// <summary>Nothing more is going to happen here - see <see cref="IsDone"/>.</summary>
        public bool IsBehindYou => HasPassed || IsDone;
    }

    /// <summary>
    /// Everything with an address on it, soonest first: every appointment that names a place, and every
    /// task entry that raised one. The two are read together rather than separately because they are the
    /// same thing seen from two ends - an entry on a list keeps its appointment in the calendar - so
    /// reading only the calendar would list a shopping trip as an event nobody recognises, and reading
    /// only the lists would miss every appointment that came from the calendar itself.
    ///
    /// A repeating event is taken at its next occurrence, the way the dashboard and the calendar already
    /// draw one: the place is the same every week, and the date beside it should be the one coming.
    /// </summary>
    private async Task ReadWhatHasAPlaceAsync()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        var taskLists = await TasksApiClient.GetTaskListsAsync();
        // Kept, because the place form asks which lists a place belongs to and this is the one read that
        // already fetches them - see PlaceForm.TaskLists.
        _taskLists = taskLists;
        var placed = new List<PlacedPlan>();

        foreach (var calendarEvent in await CalendarApiClient.GetCalendarEventsAsync())
        {
            if (calendarEvent.Details.Location is not { } place)
            {
                continue;
            }

            // The occurrence to show, and the stored event when every occurrence is behind us - a
            // weekly standup that ended in June is a place somebody went to, and belongs with the rest
            // of the past rather than nowhere.
            var shown = NextOccurrenceOf(calendarEvent, nowUtc) ?? calendarEvent;
            var raisedBy = CalendarEventDestination.RaisedBy(calendarEvent.Id, taskLists);
            var destination = CalendarEventDestination.For(calendarEvent.Id, taskLists);
            placed.Add(new PlacedPlan(
                Key: $"plan:{calendarEvent.Id}",
                // Named for the list where one raised it, the way the dashboard names the same thing:
                // "Shopping: Milk" says where an entry came from, and an appointment of its own has
                // nowhere to have come from.
                Title: raisedBy is { } origin
                    ? $"{origin.List.Title}: {calendarEvent.Details.Title}"
                    : calendarEvent.Details.Title,
                When: WhenItHappens(shown.Details),
                Address: place.Address ?? T["somewhere with no street"],
                place.Latitude,
                place.Longitude,
                // Its own colour where it has one, so a pin and the chip for the same appointment in the
                // calendar are the same colour. The fallback is the colour Orbit writes work in.
                Color: string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? "var(--task)" : calendarEvent.Details.Color,
                At: shown.Details.StartUtc,
                HasPassed: shown.Details.EndUtc < nowUtc,
                // The same question the dashboard's Upcoming card asks of the same appointment - see
                // Dashboard.IsStillToDo. An event nothing raised has no entry to have been ticked off.
                IsDone: raisedBy is { Entry.IsCompleted: true },
                OpenUrl: ReturnTo.Link(destination, "/map"),
                Destination: destination,
                NewsUrl: $"/calendar/{calendarEvent.Id}"));
        }

        _allPlaced = [.. placed.OrderBy(plan => plan.At)];
        ChooseWhichPlacesAreShown();
    }

    /// <summary>
    /// The next time a repeating event happens, or the event itself when it does not repeat and has not
    /// finished. Null when everything about it is in the past - mirrors Dashboard.NextOccurrenceOf,
    /// which answers the same question for the Upcoming card.
    /// </summary>
    private static CalendarEventDto? NextOccurrenceOf(CalendarEventDto calendarEvent, DateTimeOffset nowUtc)
        => calendarEvent.Details.Recurrence is null
            ? calendarEvent.Details.EndUtc >= nowUtc ? calendarEvent : null
            : CalendarEventOccurrenceExpander
                .ExpandOccurrences(calendarEvent, nowUtc, nowUtc + OccurrenceWindow)
                .FirstOrDefault(occurrence => occurrence.Details.EndUtc >= nowUtc);

    /// <summary>How far ahead a repeat is looked for - a year, which is what the dashboard uses.</summary>
    private static readonly TimeSpan OccurrenceWindow = TimeSpan.FromDays(365);

    /// <summary>"Today 10:00" / "Tomorrow 15:30" / "Fri 12 09:00" - matches the dashboard's own rows.</summary>
    private string WhenItHappens(CalendarEventDetailsDto details)
    {
        var start = details.StartUtc.ToLocalTime();
        var today = DateTime.Today;
        var day = start.Date == today ? T["Today"]
            : start.Date == today.AddDays(1) ? T["Tomorrow"]
            : start.ToString("ddd d MMM", T.DisplayCulture);
        return details.IsAllDay ? day : $"{day} {start:HH:mm}";
    }

    /// <summary>
    /// Whether the bell is talking about this plan. Both addresses are asked, for the reason
    /// PlacedPlan.NewsUrl gives: an appointment a task list raised is opened as that entry while the
    /// reminder for it is the event's. See NotificationFeedState.HasNewsAbout, which the dashboard and
    /// every section page read the same way.
    /// </summary>
    private bool HasNewsAbout(PlacedPlan plan)
        => NotificationFeed.HasNewsAbout(plan.Destination) || NotificationFeed.HasNewsAbout(plan.NewsUrl);

    /// <summary>
    /// Something reached the bell, so the marks are drawn again. Only a redraw: what is on the map has
    /// not changed, and re-reading the calendar on every notification would be a page that reloads
    /// itself whenever anybody does anything.
    /// </summary>
    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    private async Task ShowOrHidePastPlacesAsync()
    {
        _showsPastPlaces = !_showsPastPlaces;
        await MapPins.SetPastPlacesAsync(_showsPastPlaces, _showsPastPlacesFrom);
        ChooseWhichPlacesAreShown();
        // The map draws what the list shows, so the pins for what is no longer listed have to go with
        // it - otherwise hiding the past leaves its pins behind with nothing naming them.
        _ = RefreshMapMarkersAsync();
    }

    /// <summary>
    /// What the panel lists. Everything still ahead of the reader, plus - while they have asked for the
    /// past - as much of what is behind them as the day they named lets through.
    ///
    /// Whether those become pins is a separate question, asked in MapPoints: the eye on the panel is
    /// about the map, and a list that emptied itself when somebody cleared the map would leave them
    /// nothing to press to get it back.
    /// </summary>
    private void ChooseWhichPlacesAreShown()
        => _placed = _showsPastPlaces
            ? [.. _allPlaced.Where(plan => !plan.IsBehindYou || IsRecentEnough(plan))]
            : [.. _allPlaced.Where(plan => !plan.IsBehindYou)];

    /// <summary>
    /// Whether something behind the reader is recent enough to be worth drawing. Everything, until they
    /// name a day to show from: "show me the past" with a year of it on the map is a screen full of pins
    /// nobody is going to again, which is what the option was worth turning off for in the first place.
    ///
    /// Read against the local day the reader picked, and inclusive of it - somebody who types today's
    /// date means today.
    /// </summary>
    private bool IsRecentEnough(PlacedPlan plan)
        => _showsPastPlacesFrom is not { } from || plan.At.ToLocalTime().Date >= from.Date;

    /// <summary>
    /// Pressing a plan. The same rule a shared position follows: Orbit's own map centres on it, unless
    /// this is a phone whose map cannot answer, where the device's map app can - see MapAppHandoff.
    /// </summary>
    private Task FocusOnPlaceAsync(PlacedPlan plan)
        => MapAppHandoff.ShouldOpenTheMapApp(_isPhone, _mapTilesAllowed, _location is not null)
            ? OpenPlaceInTheMapAppAsync(plan)
            : FocusTheMapOnAsync(plan.Key, "a place something happens at");

    private async Task FocusOnPlaceOnEnterOrSpaceAsync(KeyboardEventArgs args, PlacedPlan plan)
    {
        if (args.Key is "Enter" or " ")
        {
            await FocusOnPlaceAsync(plan);
        }
    }

    private async Task OpenPlaceInTheMapAppAsync(PlacedPlan plan)
    {
        try
        {
            await using var mapApp = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mapApp.js");
            await mapApp.InvokeVoidAsync("openPosition", plan.Latitude, plan.Longitude, plan.Title);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not open a plan's place in the device's map app");
        }
    }

    private Task FocusOnAsync(ReceivedPosition received)
        => FocusTheMapOnAsync(SharerMapKey(received.SharerUserId), "a shared position");

    /// <summary>
    /// Pans the map to one pin and opens it, whichever list the press came from - somebody sharing
    /// their position, or something in the reader's own calendar. <paramref name="what"/> only names it
    /// in the log, for the same reason the two callers used to have a message each.
    /// </summary>
    private async Task FocusTheMapOnAsync(string key, string what)
    {
        try
        {
            _mapModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/locationMap.js");
            await _mapModule.InvokeVoidAsync("focusOn", MapElementId, key);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not focus the map on {What}", what);
        }
    }

    /// <summary>A div given a button's role has to answer a keyboard like one - see SummaryCard's own copy of this rule.</summary>
    private async Task OpenOnEnterOrSpaceAsync(KeyboardEventArgs args, ReceivedPosition received)
    {
        if (args.Key is "Enter" or " ")
        {
            await OpenSharedPositionAsync(received);
        }
    }

    /// <summary>One position someone is sharing with this user, already opened.</summary>
    private sealed record ReceivedPosition(Guid SharerUserId, bool IsContinuous, SharedLocationSender.SharedPosition Position);

    public async ValueTask DisposeAsync()
    {
        NotificationFeed.Changed -= OnNotificationsChanged;
        // Leaving the page ends live sharing's refresh loop - see _refreshTimer's comment.
        _refreshCancellation?.Cancel();
        _refreshTimer?.Dispose();
        _refreshCancellation?.Dispose();

        await DisposeMapAsync();
        _pageReference?.Dispose();
        if (_mapModule is not null)
        {
            try
            {
                await _mapModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <summary>Shape returned by geolocation.js - matched by camelCase property name. Error is set instead of the coordinates when the position couldn't be had.</summary>
    private sealed record BrowserPosition(double Latitude, double Longitude, double AccuracyMetres, string? Error);
}
