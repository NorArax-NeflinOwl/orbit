@page "/forgot-password"
@using Orbit.Web.Services
@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager
@inject ILogger<ForgotPassword> Logger
@inject Translations T

<PageTitle>@T["Orbit — Reset your password"]</PageTitle>

<h1>@T["Reset your password"]</h1>

@* Two steps on one page: ask for the code, then use it. The phone has had this since it was built (see
   PasswordResetPage); the web had the same flow only behind the chat key gate, where it is reachable
   solely by somebody already signed in - which is the one person who does not need it. *@
@if (!_codeSent)
{
    <p>@T["Tell us the address or login you sign in with, and we'll email a code to reset the password."]</p>

    <div class="field">
        <label for="forgotIdentifier">@T["Email or login"]</label>
        @* Both events, and no @bind - a password manager fills these boxes too, see Login.razor. *@
        <input id="forgotIdentifier" value="@_identifier"
               @oninput="argument => _identifier = Typed(argument)"
               @onchange="argument => _identifier = Typed(argument)" />
    </div>
    <div class="form-actions">
        <button type="button" class="btn-primary" disabled="@(_isBusy || _identifier.Trim().Length == 0)"
                @onclick="SendCodeAsync">@T["Send code"]</button>
    </div>
}
else
{
    @* Said whatever happened, and deliberately without saying whether the account exists - the endpoint
       answers the same way either way, because anything else would let anybody ask Orbit who has an
       account here. See RequestPasswordResetCommand. *@
    <p>@T["If that account exists and its address is confirmed, a code is on its way. It is good for 15 minutes."]</p>
    <p class="chat-key-gate-warning">
        @T["A new password starts your chat over: messages under the old one stay unreadable, because Orbit never had their key."]
    </p>

    <div class="field">
        <label for="forgotCode">@T["Code from the email"]</label>
        <input id="forgotCode" inputmode="numeric" autocomplete="one-time-code" value="@_code"
               @oninput="argument => _code = Typed(argument)"
               @onchange="argument => _code = Typed(argument)" />
    </div>
    <div class="field">
        <label for="forgotPassword">@T["New password"]</label>
        <input type="password" id="forgotPassword" value="@_password"
               @oninput="argument => _password = Typed(argument)"
               @onchange="argument => _password = Typed(argument)" />
    </div>
    <div class="field">
        <label for="forgotRepeatPassword">@T["Repeat new password"]</label>
        <input type="password" id="forgotRepeatPassword" value="@_repeatPassword"
               @oninput="argument => _repeatPassword = Typed(argument)"
               @onchange="argument => _repeatPassword = Typed(argument)" />
    </div>
    <div class="form-actions">
        <button type="button" class="btn-primary" disabled="@_isBusy" @onclick="ResetAsync">@T["Set password"]</button>
        <button type="button" class="btn-secondary" disabled="@_isBusy" @onclick="SendCodeAsync">@T["Send code"]</button>
    </div>
}

@if (_message is not null)
{
    <p class="@(_hasFailed ? "error" : "info")">@_message</p>
}

<p><a href="/login">@T["Back to logging in"]</a></p>

@code {
    private string _identifier = string.Empty;
    private string _code = string.Empty;
    private string _password = string.Empty;
    private string _repeatPassword = string.Empty;
    private bool _codeSent;
    private bool _isBusy;
    private string? _message;
    private bool _hasFailed;

    /// <summary>What a field now holds, however it came to hold it - see Login.razor.</summary>
    private static string Typed(ChangeEventArgs argument) => argument.Value?.ToString() ?? string.Empty;

    private async Task SendCodeAsync()
    {
        await RunAsync(async () =>
        {
            await AuthApiClient.RequestPasswordResetAsync(_identifier);
            _codeSent = true;
        });
    }

    private async Task ResetAsync()
    {
        if (_password.Length == 0)
        {
            Refuse(T["Enter a password."]);
            return;
        }

        if (_password != _repeatPassword)
        {
            Refuse(T["The two passwords don't match."]);
            return;
        }

        await RunAsync(async () =>
        {
            if (!await AuthApiClient.ResetPasswordAsync(_identifier, _code, _password))
            {
                Refuse(T["That code isn't valid any more. Request a new one."]);
                return;
            }

            // Signing in is what unwraps the chat key with the new password, or makes a fresh one when
            // the old backup cannot be opened - see Login.TryUnlockEncryptionKeyAsync. Nothing to do
            // here but send them there.
            NavigationManager.NavigateTo("/login");
        });
    }

    /// <summary>
    /// Runs a step with the button held down for its duration, and says so when it fails rather than
    /// leaving the page looking as though nothing was pressed.
    /// </summary>
    private async Task RunAsync(Func<Task> step)
    {
        _isBusy = true;
        _message = null;
        _hasFailed = false;
        try
        {
            await step();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "A password reset step failed");
            Refuse(T["Something went wrong. Try again."]);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void Refuse(string message)
    {
        _message = message;
        _hasFailed = true;
    }
}
