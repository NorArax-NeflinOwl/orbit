@page "/calendar/new"
@page "/calendar/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Notifications
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject NotificationsApiClient NotificationsApiClient
@inject UsersApiClient UsersApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject GeocodingApiClient GeocodingApiClient
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<CalendarEventEditor> Logger
@inject Translations T

<PageTitle>@(IsNewEvent ? T["New event"] : T["Edit event"])</PageTitle>

<h1>@(IsNewEvent ? T["New event"] : T["Edit event"])</h1>

@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else
{
    @if (_isShared)
    {
        <p class="shared-event-banner">@T["This event was shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
    }

    @if (_lockedByUserName is not null)
    {
        <p class="lock-banner">
            @T.Format("{0} is currently editing this event - you can't edit it right now.", _lockedByUserName)
        </p>
    }

    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="editor-form">
    <fieldset disabled="@(!_canEditContent || _lockedByUserName is not null || _isSaving)">
        <div class="field">
            <label>@T["Title"]</label>
            <InputText @bind-Value="_formModel.Title" />
        </div>
        <div class="field">
            <label>@T["Description"]</label>
            <InputTextArea @bind-Value="_formModel.Description" />
        </div>
        <div class="field">
            <label for="eventPrioritySelect">@T["Priority"]</label>
            <InputSelect id="eventPrioritySelect" @bind-Value="_formModel.Priority">
                <option value="Low">@T["Low"]</option>
                <option value="Normal">@T["Normal"]</option>
                <option value="High">@T["High"]</option>
            </InputSelect>
            <small>@T["Sorts this event against the others, and is what the dashboard's filter reads."]</small>
        </div>
        <div class="field">
            <label>@T["Location"]</label>
            <InputText @bind-Value="_formModel.LocationAddress" placeholder="@(T["Pick a point on the map to set an address"])" />
            <div class="field-row">
                <button type="button" class="btn-secondary" @onclick="ToggleMapAsync">@(_isMapVisible ? T["Hide map"] : T["Pick on map"])</button>
                @if (_formModel.LocationLatitude is { } latitude && _formModel.LocationLongitude is { } longitude)
                {
                    <span>@T.Format("Coordinates: {0}, {1}", latitude.ToString("F5"), longitude.ToString("F5"))</span>
                    <button type="button" class="btn-secondary" @onclick="ClearLocation">@T["Remove location"]</button>
                }
            </div>
            @if (_isMapVisible)
            {
                <div id="@MapElementId" class="map-picker"></div>
            }
        </div>
        <div class="field">
            <label>@T["Color"]</label>
            <input type="color" @bind="_formModel.Color" />
        </div>
        <div class="field field-checkbox">
            <label>
                <InputCheckbox @bind-Value="_formModel.IsAllDay" />@T["All-day event"]</label>
        </div>
        <div class="field">
            <label>@T["Start"]</label>
            <div class="field-row">
                <DateField @bind-Value="_formModel.StartDate" @bind-Value:after="OnStartChanged" AriaLabel="@(T["Start"])" />
                @if (!_formModel.IsAllDay)
                {
                    <TimeField @bind-Value="_formModel.StartTime" @bind-Value:after="OnStartChanged" AriaLabel="@(T["Start"])" />
                }
            </div>
        </div>
        <div class="field">
            <label>@T["End"]</label>
            <div class="field-row">
                <DateField @bind-Value="_formModel.EndDate" @bind-Value:after="OnEndChanged" AriaLabel="@(T["End"])" />
                @if (!_formModel.IsAllDay)
                {
                    <TimeField @bind-Value="_formModel.EndTime" @bind-Value:after="OnEndChanged" AriaLabel="@(T["End"])" />
                }
            </div>
        </div>
        <div class="field field-checkbox">
            <label>
                <InputCheckbox @bind-Value="_formModel.IsRecurring" />@T["Recurring event"]</label>
        </div>
        @if (_formModel.IsRecurring)
        {
            <div class="field">
                <label>@T["Frequency"]</label>
                <InputSelect @bind-Value="_formModel.RecurrenceFrequency">
                    <option value="Daily">@T["Daily"]</option>
                    <option value="Weekly">@T["Weekly"]</option>
                    <option value="Monthly">@T["Monthly"]</option>
                </InputSelect>
            </div>
            <div class="field">
                <label>@T["Every"]</label>
                <InputNumber @bind-Value="_formModel.RecurrenceIntervalCount" />
            </div>
            <div class="field">
                <label>@T["Repeat until (optional)"]</label>
                <DateField @bind-Value="_formModel.RecurrenceUntil" AriaLabel="@(T["Repeat until (optional)"])" />
            </div>
        }
        <div class="field">
            <label>@T["Reminders"]</label>
            @if (_reminderRows.Count == 0)
            {
                <p>@T["No reminders."]</p>
            }
            else
            {
                @foreach (var row in _reminderRows)
                {
                    <div class="field-row reminder-row" id="reminderRows">
                        <select @bind="row.PresetSelection">
                            @foreach (var preset in ReminderPresets)
                            {
                                <option value="@preset.Minutes">@T[preset.Label]</option>
                            }
                            <option value="custom">@T["Custom"]</option>
                        </select>
                        @if (row.IsCustom)
                        {
                            <InputNumber @bind-Value="row.CustomAmount" @bind-Value:after="row.RecomputeFromCustom" min="1" />
                            <select @bind="row.CustomUnit" @bind:after="row.RecomputeFromCustom">
                                <option value="minutes">@T["minutes"]</option>
                                <option value="hours">@T["hours"]</option>
                                <option value="days">@T["days"]</option>
                                <option value="weeks">@T["weeks"]</option>
                            </select>
                            <span>@T["before"]</span>
                        }
                        <button type="button" class="btn-secondary" @onclick="() => RemoveReminderRow(row)">@T["Remove"]</button>
                    </div>
                }
            }
            <button type="button" class="btn-secondary" @onclick="AddReminderRow">@T["Add reminder"]</button>
        </div>
        <div class="field">
            <label>@T["Notification when the event is created"]<select @bind="_formModel.CreationNotificationChannel">
                    @foreach (var option in NotificationChannelOption.All)
                    {
                        <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                    }
                </select>
            </label>
        </div>
        <div class="field">
            <label for="reminderChannelSelect">@T["Notification as the event approaches"]</label>
            <select id="reminderChannelSelect" @bind="_formModel.ReminderNotificationChannel">
                @foreach (var option in NotificationChannelOption.All)
                {
                    <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                }
            </select>
        </div>

    </fieldset>

    @if (_canShare)
    {
        <fieldset disabled="@_isSaving">
            <div class="field">
                <label>@T["Guests"]</label>
                @if (_formModel.GuestUserIds.Count == 0)
                {
                    <p>@T["No guests."]</p>
                }
                else
                {
                    <ul id="guestList">
                        @foreach (var guestUserId in _formModel.GuestUserIds)
                        {
                            <li>
                                @GetGuestDisplayName(guestUserId)
                                <button type="button" class="btn-secondary" @onclick="() => RemoveGuest(guestUserId)">@T["Remove"]</button>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="field">
                <label>@T["Add a guest from contacts"]</label>
                @if (_shareableContacts.Count == 0)
                {
                    <p>@T["No contacts. A contact will appear here once you start a chat with someone."]</p>
                }
                else
                {
                    <div class="field-row">
                        <select id="guestContactSelect" @bind="_selectedContactUserId">
                            <option value="">@T["-- select a contact --"]</option>
                            @foreach (var contact in _shareableContacts)
                            {
                                <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                            }
                        </select>
                        <select id="guestAccessLevelSelect" @bind="_selectedAccessLevel">
                            <option value="ReadOnly">@T["Read-only"]</option>
                            <option value="Share">@T["Can share"]</option>
                            @if (_canGrantEditOnly)
                            {
                                <option value="EditOnly">@T["Can edit, but not share editing"]</option>
                            }
                            @if (_canGrantCanEdit)
                            {
                                <option value="CanEdit">@T["Can edit"]</option>
                            }
                        </select>
                        <button type="button" id="addGuestFromContactButton" class="btn-secondary" @onclick="AddSelectedContactAsGuest">@T["Add"]</button>
                    </div>
                }
            </div>
        </fieldset>
    }

    <div class="form-actions">
        <button type="submit" class="btn-primary" disabled="@_isSaving">@T["Save"]</button>
        <button type="button" class="btn-secondary" @onclick="CancelAsync">@T["Cancel"]</button>
        @if (!IsNewEvent && _canEditContent)
        {
            @* Deleting from here, not only from the calendar page: opening an event to look at it and
               deciding it should go is the moment the wish arrives. Only for an event that is actually
               yours to change - the same gate the content fieldset uses. *@
            <button type="button" class="btn-secondary form-actions-danger" disabled="@_isDeleting" @onclick="DeleteAsync">
                @T["Delete event"]
            </button>
        }
    </div>
    </EditForm>

    @if (!IsNewEvent && Id is { } calendarEventId)
    {
        <h2>@T["Link"]</h2>
        <ShareLinkButton ItemType="CalendarEvent" ItemId="calendarEventId" />
    }

    @* An event is worth having in the calendar somebody actually lives out of. The link hands Google
       what this event says and opens its own form, so what lands there is still their decision - see
       GoogleCalendarEventLink for why this is a link and not an API call. *@
    @if (!IsNewEvent && _hasGoogleExtras && _savedDetails is { } savedDetails)
    {
        <h2>@T["Google Calendar"]</h2>
        <p class="options-subtext">@T["Opens Google's own form with this event filled in. Nothing is saved there until you save it."]</p>
        <a class="btn-secondary" href="@GoogleCalendarLinkFor(savedDetails)" target="_blank" rel="noopener">
            @T["Add to Google Calendar"]
        </a>
    }

    @if (_errorMessage is not null)
    {
        <p class="error">@_errorMessage</p>
    }
}

@code {
    private const string MapElementId = "eventLocationMap";

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewEvent => Id is null;

    private string GoogleCalendarLinkFor(CalendarEventDetailsDto details)
        => GoogleCalendarEventLink.ForEvent(
            details.Title, details.StartUtc, details.EndUtc, details.IsAllDay, details.Description,
            details.Location is { } location ? LocationLabel(location) : null, details.Recurrence);

    /// <summary>What Google should show as the place: the address when there is one, coordinates otherwise.</summary>
    private static string LocationLabel(EventLocationDto location)
        => string.IsNullOrWhiteSpace(location.Address)
            ? $"{location.Latitude.ToString(CultureInfo.InvariantCulture)}, {location.Longitude.ToString(CultureInfo.InvariantCulture)}"
            : location.Address;
    private bool _isLoading = true;
    private CalendarEventFormModel _formModel = new();
    private string? _errorMessage;
    private bool _isMapVisible;
    private IJSObjectReference? _mapPickerModule;
    private DotNetObjectReference<CalendarEventEditor>? _dotNetHelper;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private Guid _ownUserId;
    private bool _isShared;
    private bool _isSharedReadOnly;

    // Default to "fully allowed" - correct as-is for a brand new event (never overwritten below, since
    // OnInitializedAsync only recomputes these when loading an *existing* event) and overwritten to the
    // real, possibly-restricted values once an existing event's IsShared/AccessLevel are known.
    private bool _canEditContent = true;
    private bool _canShare = true;
    private bool _canGrantCanEdit = true;
    private bool _canGrantEditOnly = true;
    private SharedItemAccess _access = new(IsShared: false, ShareAccessLevel.CanEdit);
    private Guid? _originalOwnerUserId;
    private string? _sharedByUserName;
    private bool _isSaving;
    private bool _isDeleting;

    /// <summary>
    /// The event as it is stored, kept for the Google Calendar link. The form model would export what is
    /// half-typed on screen instead, which is not what "add this event to my calendar" means.
    /// </summary>
    private CalendarEventDetailsDto? _savedDetails;

    /// <summary>Whether to offer the Google link at all - see GoogleIntegrationAccess for who qualifies and why.</summary>
    private bool _hasGoogleExtras;

    /// <summary>Mirrors NoteEditor's field of the same name - see its comment.</summary>
    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private IReadOnlyList<ContactDto> _shareableContacts
        => _originalOwnerUserId is { } originalOwnerUserId
            ? _contacts.Where(contact => contact.UserId != originalOwnerUserId).ToList()
            : _contacts;

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private string SharedAccessDescription => T[_access.Description];

    /// <summary>
    /// Contacts added as a guest via the picker during this editing session (not guests already present
    /// when an existing event was loaded, and not free-typed e-mail addresses, which aren't linked to a
    /// user id) - each one gets a share offer and a chat invite once the event is saved, see
    /// ShareWithNewlyAddedContactsAsync. The access level chosen in the picker at the time each contact
    /// was added travels alongside its user id.
    /// </summary>
    private readonly List<(Guid RecipientUserId, string AccessLevel)> _shareRecipients = [];

    /// <summary>
    /// Login of every guest not found among <see cref="_contacts"/> (e.g. a guest added in an earlier
    /// session who has since stopped being a contact), resolved once via UsersApiClient and cached here
    /// instead of being looked up again on every render - see ResolveMissingGuestDisplayNamesAsync.
    /// </summary>
    private readonly Dictionary<Guid, string> _resolvedGuestUserNames = [];

    /// <summary>
    /// Common reminder offsets, mirroring Google Calendar's reminder picker. Zero is one of them: an
    /// event beginning is worth hearing about, and being told only that it will begin in five minutes
    /// leaves the moment itself unannounced. EventReminderPushContent already words a zero lead time as
    /// "starts now" - the picker was the only place it could not be chosen.
    /// </summary>
    private static readonly (int Minutes, string Label)[] ReminderPresets =
    [
        (0, "When it starts"),
        (5, "5 minutes before"),
        (10, "10 minutes before"),
        (15, "15 minutes before"),
        (30, "30 minutes before"),
        (60, "1 hour before"),
        (120, "2 hours before"),
        (720, "12 hours before"),
        (1440, "1 day before"),
        (2880, "2 days before"),
        (10080, "1 week before")
    ];

    private List<ReminderRow> _reminderRows = [];

    /// <summary>
    /// The gap between start and end the last time both were valid (start on/before end) - reapplied to
    /// End whenever Start is moved past it, so an event keeps its length instead of collapsing to zero
    /// duration or being left invalid. Kept up to date by both OnStartChanged and OnEndChanged.
    /// </summary>
    private TimeSpan _lastKnownDuration = TimeSpan.FromHours(1);
    private NotificationSettingsDto _notificationSettings = new(true, true, true, true, true, BannerVisibleSeconds: 5, BannerMinimumGapSeconds: 5);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
            _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync()
                ?? throw new HttpRequestException("No signed-in user.", null, HttpStatusCode.Unauthorized);

            // Best-effort: gates which notification-channel options are selectable (see
            // NotificationChannelOption.IsDisabledBy) - a failure here just leaves every option enabled
            // rather than blocking the rest of the page from loading.
            try
            {
                _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Failed to load notification settings");
            }

            if (Id is { } eventId)
            {
                Logger.LogInformation("Calendar event editor opened for event {EventId}", eventId);
                var calendarEvent = await CalendarApiClient.GetCalendarEventByIdAsync(eventId);
                if (calendarEvent is not null)
                {
                    _formModel = CalendarEventFormModel.FromDto(calendarEvent.Details);
                    _savedDetails = calendarEvent.Details;
                    _isShared = calendarEvent.IsShared;
                    _access = SharedItemAccess.For(calendarEvent.IsShared, calendarEvent.AccessLevel);
                    _isSharedReadOnly = calendarEvent.IsShared && !_access.CanEdit;
                    _canEditContent = _access.CanEdit;
                    _canShare = _access.CanShare;
                    _canGrantCanEdit = _access.CanGrantCanEdit;
                    _canGrantEditOnly = _access.CanGrantEditOnly;
                    _canGrantEditOnly = _access.CanGrantEditOnly;
                    _originalOwnerUserId = calendarEvent.OriginalOwnerUserId;
                    _sharedByUserName = calendarEvent.SharedByUserName;

                    if (_canEditContent)
                    {
                        await AcquireLockAsync(eventId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(eventId);
                        }
                    }
                }
            }
            else
            {
                Logger.LogInformation("Calendar event editor opened for a new event");
                // A reminder to go with the channel above. Without one the channel has nothing to fire,
                // so a new event still told nobody anything - and ten minutes is what the Add button
                // reaches for too. Only for a new event: an existing one keeps whatever it was given,
                // including deliberately having none.
                _formModel.ReminderMinutesBeforeStart = [DefaultReminderMinutesBeforeStart];
            }

            _reminderRows = _formModel.ReminderMinutesBeforeStart.Select(ReminderRow.FromMinutes).ToList();
            var initialStart = ComputeStartInstant();
            var initialEnd = ComputeEndInstant();
            if (initialStart is { } start && initialEnd is { } end && end > start)
            {
                _lastKnownDuration = end - start;
            }

            _contacts = await ChatApiClient.GetContactsAsync();
            await ResolveMissingGuestDisplayNamesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }

        _isLoading = false;
    }

    private DateTime? ComputeStartInstant()
        => _formModel.StartDate?.ToDateTime(_formModel.IsAllDay ? TimeOnly.MinValue : _formModel.StartTime ?? TimeOnly.MinValue);

    private DateTime? ComputeEndInstant()
        => _formModel.EndDate?.ToDateTime(_formModel.IsAllDay ? TimeOnly.MinValue : _formModel.EndTime ?? TimeOnly.MinValue);

    /// <summary>
    /// Auto-corrects the end date/time whenever moving the start pushes it past the current end - keeps
    /// the previously-known duration (see <see cref="_lastKnownDuration"/>) instead of leaving the event
    /// end before its start or collapsed to zero length, mirroring how Google Calendar shifts the end
    /// when you drag the start past it.
    /// </summary>
    private void OnStartChanged()
    {
        var start = ComputeStartInstant();
        if (start is null)
        {
            return;
        }

        var end = ComputeEndInstant();
        if (end is null || start.Value > end.Value)
        {
            var corrected = start.Value + _lastKnownDuration;
            _formModel.EndDate = DateOnly.FromDateTime(corrected);
            _formModel.EndTime = TimeOnly.FromDateTime(corrected);
        }
        else
        {
            _lastKnownDuration = end.Value - start.Value;
        }
    }

    /// <summary>Keeps <see cref="_lastKnownDuration"/> current when the user edits End directly instead of moving Start.</summary>
    private void OnEndChanged()
    {
        var start = ComputeStartInstant();
        var end = ComputeEndInstant();
        if (start is { } startValue && end is { } endValue && endValue >= startValue)
        {
            _lastKnownDuration = endValue - startValue;
        }
    }

    private const int DefaultReminderMinutesBeforeStart = 10;

    private void AddReminderRow() => _reminderRows.Add(ReminderRow.FromMinutes(DefaultReminderMinutesBeforeStart));

    private void RemoveReminderRow(ReminderRow row) => _reminderRows.Remove(row);

    /// <summary>
    /// Adds the currently selected contact as a guest by user id. Silently ignores an already-added
    /// contact instead of creating a duplicate entry.
    /// </summary>
    private void AddSelectedContactAsGuest()
    {
        if (!Guid.TryParse(_selectedContactUserId, out var contactUserId))
        {
            return;
        }

        if (_contacts.Any(candidate => candidate.UserId == contactUserId) && !_formModel.GuestUserIds.Contains(contactUserId))
        {
            _formModel.GuestUserIds.Add(contactUserId);
            _shareRecipients.Add((contactUserId, _selectedAccessLevel));
        }

        _selectedContactUserId = string.Empty;
    }

    private void RemoveGuest(Guid guestUserId)
    {
        _formModel.GuestUserIds.Remove(guestUserId);
        _shareRecipients.RemoveAll(recipient => recipient.RecipientUserId == guestUserId);
    }

    /// <summary>
    /// Looks up guestUserId's login for display, preferring the already-loaded contact list and falling
    /// back to the id itself if the user can no longer be resolved (e.g. a deleted account).
    /// </summary>
    private string GetGuestDisplayName(Guid guestUserId)
    {
        var contact = _contacts.FirstOrDefault(candidate => candidate.UserId == guestUserId);
        if (contact is not null)
        {
            return contact.UserName;
        }

        return _resolvedGuestUserNames.TryGetValue(guestUserId, out var userName) ? userName : guestUserId.ToString();
    }

    /// <summary>
    /// A guest loaded from an existing event might not be among the current user's contacts (e.g. they
    /// were removed as a contact after being invited) - this resolves those remaining guests' logins
    /// directly via UsersApiClient so the guest list never falls back to showing a raw id.
    /// </summary>
    private async Task ResolveMissingGuestDisplayNamesAsync()
    {
        var missingGuestUserIds = _formModel.GuestUserIds
            .Where(guestUserId => _contacts.All(contact => contact.UserId != guestUserId))
            .Distinct();

        foreach (var guestUserId in missingGuestUserIds)
        {
            var user = await UsersApiClient.GetUserAsync(guestUserId);
            if (user is not null)
            {
                _resolvedGuestUserNames[guestUserId] = user.UserName;
            }
        }
    }

    /// <summary>
    /// The map is only initialized once it becomes visible, and torn down again when hidden - it isn't
    /// worth keeping a live Leaflet instance (and its tile requests) around for a panel the user closed.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isMapVisible && _mapPickerModule is null)
        {
            _mapPickerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mapPicker.js");
            _dotNetHelper = DotNetObjectReference.Create(this);
            await _mapPickerModule.InvokeVoidAsync(
                "initializeMapPicker", MapElementId, _dotNetHelper, _formModel.LocationLatitude, _formModel.LocationLongitude);
        }
    }

    private async Task ToggleMapAsync()
    {
        _isMapVisible = !_isMapVisible;
        if (!_isMapVisible)
        {
            await DisposeMapAsync();
        }
    }

    /// <summary>Called from mapPicker.js when the user clicks a point on the map.</summary>
    [JSInvokable]
    public async Task OnMapLocationPicked(double latitude, double longitude)
    {
        _formModel.LocationLatitude = latitude;
        _formModel.LocationLongitude = longitude;
        _formModel.LocationAddress = await GeocodingApiClient.ReverseGeocodeAsync(latitude, longitude) ?? _formModel.LocationAddress;
        StateHasChanged();
    }

    private void ClearLocation()
    {
        _formModel.LocationAddress = string.Empty;
        _formModel.LocationLatitude = null;
        _formModel.LocationLongitude = null;
    }

    private async Task SaveAsync()
    {
        Logger.LogInformation(
            "User clicked 'Save' ({Mode}, EventId={EventId})", IsNewEvent ? "create" : "update", Id);

        _formModel.ReminderMinutesBeforeStart = _reminderRows.Select(row => row.MinutesBeforeStart).ToList();
        var details = _formModel.ToRequest();
        if (details.EndUtc < details.StartUtc)
        {
            // Also enforced server-side (CalendarEvent.ValidateTimeRange) - this just gives the user an
            // inline message instead of letting the request fail with an unhandled 500.
            _errorMessage = T["The event's end can't be before its start."];
            return;
        }
        _errorMessage = null;

        // Locks the whole form (see the fieldset above) for the duration of the save, so a second click
        // or a double Enter-press can't fire this again while the first request is still in flight and
        // create a duplicate event.
        _isSaving = true;
        try
        {
            Guid eventId;
            try
            {
                if (IsNewEvent)
                {
                    eventId = await CalendarApiClient.CreateCalendarEventAsync(new CreateCalendarEventRequest(details));
                    Logger.LogInformation("Calendar event {EventId} created", eventId);
                }
                else
                {
                    eventId = Id!.Value;

                    // A Share-tier recipient's content fieldset is disabled (see _canEditContent), so
                    // there is nothing to update - only skip the PUT itself, since the code below still
                    // needs to run to send any guests they just added via the (separately gated) Guests
                    // fieldset. Sending the PUT anyway would fail: CalendarEvent.Update rejects it for
                    // anything short of CanEdit access.
                    if (_canEditContent)
                    {
                        var outcome = await CalendarApiClient.UpdateCalendarEventAsync(eventId, new UpdateCalendarEventRequest(details));
                        if (outcome.Kind == EditOutcomeKind.Locked)
                        {
                            _lockedByUserName = outcome.LockedByUserName;
                            StopLockHeartbeat();
                            _errorMessage = T.Format("{0} is currently editing this event - try again in a moment.", outcome.LockedByUserName);
                            return;
                        }

                        if (outcome.Kind == EditOutcomeKind.Refused)
                        {
                            _errorMessage = outcome.Reason;
                            return;
                        }

                        if (outcome.Kind == EditOutcomeKind.NotFound)
                        {
                            _errorMessage = T["Failed to save the event. Try again."];
                            return;
                        }

                        Logger.LogInformation("Calendar event {EventId} updated", eventId);
                        await ReleaseLockAsync(eventId);
                    }
                }
            }
            catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }
            catch (HttpRequestException exception)
            {
                Logger.LogError(exception, "Failed to {Mode} calendar event {EventId}", IsNewEvent ? "create" : "update", Id);
                _errorMessage = T["Failed to save the event. Try again."];
                return;
            }

            if (_shareRecipients.Count > 0)
            {
                _errorMessage = await ShareWithNewlyAddedContactsAsync(eventId, details.Title);
                if (_errorMessage is not null)
                {
                    // The event itself is already saved at this point - only the invite step failed, so this
                    // stays on the page to show which contacts weren't notified instead of navigating away
                    // and losing that information.
                    return;
                }
            }

            NavigationManager.NavigateTo("/calendar");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Offers a copy of the just-saved event to every contact added as a guest via the picker during
    /// this editing session (see AddSelectedContactAsGuest), and notifies each of them with an
    /// encrypted chat message carrying an "Accept" action (see EventShareMessagePayload). A recipient
    /// without encryption configured yet, or any other per-recipient failure, is logged and skipped
    /// rather than aborting the remaining invites - mirrors CreateCalendarEventCommandHandler's
    /// best-effort treatment of the creation e-mail. Returns a message describing who could not be
    /// notified, or null if every invite went out.
    /// </summary>
    private async Task<string?> ShareWithNewlyAddedContactsAsync(Guid eventId, string eventTitle)
    {
        var recipientsNotNotified = new List<string>();
        foreach (var (recipientUserId, accessLevel) in _shareRecipients)
        {
            var contactDisplayName = _contacts.FirstOrDefault(contact => contact.UserId == recipientUserId)?.DisplayName
                ?? recipientUserId.ToString();
            try
            {
                var result = await CalendarApiClient.ShareCalendarEventAsync(eventId, recipientUserId, accessLevel);
                if (result is null)
                {
                    recipientsNotNotified.Add(contactDisplayName);
                    continue;
                }

                // result.AlreadyShared means this contact already had a pending or accepted share of
                // this event - result.ShareId is that existing offer's id rather than a new one, so this
                // resends it as a reminder instead of creating a duplicate (see ShareCalendarEventCommandHandler).
                var payloadJson = JsonSerializer.Serialize(new EventShareMessagePayload(result.ShareId, eventTitle));
                await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson, isShareInvitation: true);
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                Logger.LogWarning(
                    exception, "Failed to share calendar event {EventId} with user {RecipientUserId}", eventId, recipientUserId);
                recipientsNotNotified.Add(contactDisplayName);
            }
        }

        return recipientsNotNotified.Count == 0
            ? null
            : $"The event was saved, but the invite couldn't be sent to: {string.Join(", ", recipientsNotNotified)}.";
    }

    /// <summary>
    /// Asks first, like the calendar page's own delete does, then goes back to the calendar - staying on
    /// the editor of something that no longer exists would only offer a Save that could not work.
    /// </summary>
    private async Task DeleteAsync()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", T["Delete this event? This can't be undone."]))
        {
            return;
        }

        _isDeleting = true;
        Logger.LogInformation("User clicked 'Delete event' (EventId={EventId})", Id);
        try
        {
            await CalendarApiClient.DeleteCalendarEventAsync(Id!.Value);
            NavigationManager.NavigateTo("/calendar");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to delete calendar event {EventId}", Id);
            _errorMessage = T["Couldn't delete the event. Try again."];
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task CancelAsync()
    {
        Logger.LogInformation("User clicked 'Cancel'");
        if (Id is { } eventId)
        {
            await ReleaseLockAsync(eventId);
        }

        NavigationManager.NavigateTo("/calendar");
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task AcquireLockAsync(Guid eventId)
    {
        try
        {
            var outcome = await CalendarApiClient.AcquireCalendarEventLockAsync(eventId);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task ReleaseLockAsync(Guid eventId)
    {
        StopLockHeartbeat();
        if (!_canEditContent)
        {
            return;
        }

        try
        {
            await CalendarApiClient.ReleaseCalendarEventLockAsync(eventId);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat(Guid eventId)
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(eventId, _lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(Guid eventId, CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync(eventId);
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task DisposeMapAsync()
    {
        if (_mapPickerModule is not null)
        {
            await _mapPickerModule.InvokeVoidAsync("disposeMapPicker", MapElementId);
            await _mapPickerModule.DisposeAsync();
            _mapPickerModule = null;
        }

        _dotNetHelper?.Dispose();
        _dotNetHelper = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeMapAsync();
        if (Id is { } eventId)
        {
            await ReleaseLockAsync(eventId);
        }
        else
        {
            StopLockHeartbeat();
        }
    }

    private sealed class CalendarEventFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string LocationAddress { get; set; } = string.Empty;
        public double? LocationLatitude { get; set; }
        public double? LocationLongitude { get; set; }
        public string Color { get; set; } = "#4a90d9";

        /// <summary>ItemPriority by name, the way the API takes it - see CalendarEventDetailsDto.Priority.</summary>
        public string Priority { get; set; } = "Normal";
        public bool IsAllDay { get; set; }
        public DateOnly? StartDate { get; set; }
        public TimeOnly? StartTime { get; set; }
        public DateOnly? EndDate { get; set; }
        public TimeOnly? EndTime { get; set; }
        public bool IsRecurring { get; set; }
        public string RecurrenceFrequency { get; set; } = "Weekly";
        public int RecurrenceIntervalCount { get; set; } = 1;
        public DateOnly? RecurrenceUntil { get; set; }
        public List<Guid> GuestUserIds { get; set; } = [];
        public List<int> ReminderMinutesBeforeStart { get; set; } = [];
        /// <summary>
        /// Confirming something the reader just did themselves is noise, so this stays off unless asked
        /// for - unlike the reminder below, which is about a moment they are not present for.
        /// </summary>
        public string CreationNotificationChannel { get; set; } = "None";

        /// <summary>
        /// Push by default, matching a task's overdue reminder and an inventory item's expiry. A new
        /// event used to arrive with no reminder and no channel, so an event created without opening
        /// either dropdown could never notify anyone - which reads, fairly, as reminders being broken.
        /// </summary>
        public string ReminderNotificationChannel { get; set; } = "Push";

        /// <summary>
        /// Defaults a new event to start now and end an hour later. Start and end are each derived from
        /// a single timestamp (rather than combining DateTime.Today with a separately-computed time) so
        /// the end date rolls over correctly when starting late enough that adding an hour crosses
        /// midnight - otherwise the end date could default to the still-current day while the end time
        /// wraps to just after midnight, putting the end before the start.
        /// </summary>
        public CalendarEventFormModel()
        {
            var start = DateTime.Now;
            var end = start.AddHours(1);
            StartDate = DateOnly.FromDateTime(start);
            StartTime = TimeOnly.FromDateTime(start);
            EndDate = DateOnly.FromDateTime(end);
            EndTime = TimeOnly.FromDateTime(end);
        }

        public static CalendarEventFormModel FromDto(CalendarEventDetailsDto details)
            => new()
            {
                Title = details.Title,
                Description = details.Description ?? string.Empty,
                LocationAddress = details.Location?.Address ?? string.Empty,
                LocationLatitude = details.Location?.Latitude,
                LocationLongitude = details.Location?.Longitude,
                Color = string.IsNullOrWhiteSpace(details.Color) ? "#4a90d9" : details.Color,
                IsAllDay = details.IsAllDay,
                StartDate = DateOnly.FromDateTime(details.StartUtc.LocalDateTime),
                StartTime = TimeOnly.FromDateTime(details.StartUtc.LocalDateTime),
                EndDate = DateOnly.FromDateTime(details.EndUtc.LocalDateTime),
                EndTime = TimeOnly.FromDateTime(details.EndUtc.LocalDateTime),
                IsRecurring = details.Recurrence is not null,
                RecurrenceFrequency = details.Recurrence?.Frequency ?? "Weekly",
                RecurrenceIntervalCount = details.Recurrence?.IntervalCount ?? 1,
                RecurrenceUntil = details.Recurrence?.UntilUtc is { } until ? DateOnly.FromDateTime(until.LocalDateTime) : null,
                GuestUserIds = details.Guests.ToList(),
                ReminderMinutesBeforeStart = details.ReminderMinutesBeforeStart.ToList(),
                CreationNotificationChannel = details.CreationNotificationChannel,
                ReminderNotificationChannel = details.ReminderNotificationChannel,
                Priority = details.Priority
            };

        public CalendarEventDetailsRequest ToRequest()
        {
            var startUtc = ToDateTimeOffset(StartDate, StartTime, IsAllDay);
            var endUtc = ToDateTimeOffset(EndDate, EndTime, IsAllDay);
            var recurrence = IsRecurring
                ? new RecurrenceRequest(RecurrenceFrequency, RecurrenceIntervalCount, ToOptionalDateTimeOffset(RecurrenceUntil))
                : null;
            var location = LocationLatitude is { } latitude && LocationLongitude is { } longitude
                ? new EventLocationRequest(string.IsNullOrWhiteSpace(LocationAddress) ? null : LocationAddress, latitude, longitude)
                : null;

            return new CalendarEventDetailsRequest(
                Title,
                string.IsNullOrWhiteSpace(Description) ? null : Description,
                location,
                Color,
                startUtc,
                endUtc,
                IsAllDay,
                recurrence,
                GuestUserIds,
                ReminderMinutesBeforeStart,
                CreationNotificationChannel,
                ReminderNotificationChannel,
                Priority);
        }

        /// <summary>
        /// Combines the separately-edited date and time-of-day into the single timestamp the API
        /// expects. All-day events are anchored to local midnight regardless of the time field.
        /// </summary>
        private static DateTimeOffset ToDateTimeOffset(DateOnly? date, TimeOnly? time, bool isAllDay)
        {
            var effectiveDate = date ?? DateOnly.FromDateTime(DateTime.Today);
            var effectiveTime = isAllDay ? TimeOnly.MinValue : time ?? TimeOnly.MinValue;
            return new DateTimeOffset(effectiveDate.ToDateTime(effectiveTime, DateTimeKind.Local)).ToUniversalTime();
        }

        private static DateTimeOffset? ToOptionalDateTimeOffset(DateOnly? date)
            => date is { } value ? new DateTimeOffset(value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local)).ToUniversalTime() : null;
    }

    /// <summary>
    /// One reminder row in the editor UI: either a picked preset (see <see cref="ReminderPresets"/>) or a
    /// custom amount+unit pair (mirrors Google Calendar's reminder picker) - either way it always
    /// resolves down to <see cref="MinutesBeforeStart"/>, the only thing the API actually stores.
    /// </summary>
    private sealed class ReminderRow
    {
        public int MinutesBeforeStart { get; set; }
        public bool IsCustom { get; set; }
        public int CustomAmount { get; set; } = 10;
        public string CustomUnit { get; set; } = "minutes";

        /// <summary>Bound to the row's &lt;select&gt; - "custom" or the preset's minutes value as a string.</summary>
        public string PresetSelection
        {
            get => IsCustom ? "custom" : MinutesBeforeStart.ToString();
            set
            {
                if (value == "custom")
                {
                    IsCustom = true;
                    RecomputeFromCustom();
                }
                else if (int.TryParse(value, out var minutes))
                {
                    IsCustom = false;
                    MinutesBeforeStart = minutes;
                }
            }
        }

        public void RecomputeFromCustom()
        {
            var unitMinutes = CustomUnit switch
            {
                "weeks" => 10080,
                "days" => 1440,
                "hours" => 60,
                _ => 1
            };
            MinutesBeforeStart = Math.Max(1, CustomAmount) * unitMinutes;
        }

        /// <summary>Builds a row for minutes, matching it to a preset when one exists exactly, custom otherwise.</summary>
        public static ReminderRow FromMinutes(int minutes)
        {
            if (ReminderPresets.Any(preset => preset.Minutes == minutes))
            {
                return new ReminderRow { MinutesBeforeStart = minutes, IsCustom = false };
            }

            var (amount, unit) = minutes switch
            {
                > 0 and _ when minutes % 10080 == 0 => (minutes / 10080, "weeks"),
                > 0 and _ when minutes % 1440 == 0 => (minutes / 1440, "days"),
                > 0 and _ when minutes % 60 == 0 => (minutes / 60, "hours"),
                _ => (minutes, "minutes")
            };
            return new ReminderRow { MinutesBeforeStart = minutes, IsCustom = true, CustomAmount = amount, CustomUnit = unit };
        }
    }
}
