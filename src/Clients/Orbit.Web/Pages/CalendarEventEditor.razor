@page "/calendar/new"
@page "/calendar/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject UsersApiClient UsersApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject GeocodingApiClient GeocodingApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<CalendarEventEditor> Logger

<PageTitle>@(IsNewEvent ? "New event" : "Edit event")</PageTitle>

@* TODO(Orbit.Web.UI): still plain unstyled form markup (this is the biggest of the three editors -
   recurrence, reminders, location/map picker, guests). Restyle together with Calendar.razor (see its own
   TODO) onto app.css's .card/.btn-primary vocabulary; the map picker (wwwroot/js/mapPicker.js/Leaflet)
   and the color swatch picker will need their own component-specific styling on top of that, not just
   class renames. *@
<h1>@(IsNewEvent ? "New event" : "Edit event")</h1>

@if (_isLoading)
{
    <p>Loading…</p>
}
else
{
    @if (_isShared)
    {
        <p class="shared-event-banner">
            This event was shared by <strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
    }

    @if (_lockedByUserName is not null)
    {
        <p class="lock-banner">
            <strong>@_lockedByUserName</strong> is currently editing this event - you can't edit it right now.
        </p>
    }

    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="editor-form">
    <fieldset disabled="@(!_canEditContent || _lockedByUserName is not null || _isSaving)">
        <div class="field">
            <label>Title</label>
            <InputText @bind-Value="_formModel.Title" />
        </div>
        <div class="field">
            <label>Description</label>
            <InputTextArea @bind-Value="_formModel.Description" />
        </div>
        <div class="field">
            <label>Location</label>
            <InputText @bind-Value="_formModel.LocationAddress" placeholder="Pick a point on the map to set an address" />
            <div class="field-row">
                <button type="button" class="btn-secondary" @onclick="ToggleMapAsync">@(_isMapVisible ? "Hide map" : "Pick on map")</button>
                @if (_formModel.LocationLatitude is { } latitude && _formModel.LocationLongitude is { } longitude)
                {
                    <span>Coordinates: @latitude.ToString("F5") , @longitude.ToString("F5")</span>
                    <button type="button" class="btn-secondary" @onclick="ClearLocation">Remove location</button>
                }
            </div>
            @if (_isMapVisible)
            {
                <div id="@MapElementId" class="map-picker"></div>
            }
        </div>
        <div class="field">
            <label>Color</label>
            <input type="color" @bind="_formModel.Color" />
        </div>
        <div class="field field-checkbox">
            <label>
                <InputCheckbox @bind-Value="_formModel.IsAllDay" />
                All-day event
            </label>
        </div>
        <div class="field">
            <label>Start</label>
            <div class="field-row">
                <InputDate @bind-Value="_formModel.StartDate" />
                @if (!_formModel.IsAllDay)
                {
                    <input type="time" @bind="_formModel.StartTime" />
                }
            </div>
        </div>
        <div class="field">
            <label>End</label>
            <div class="field-row">
                <InputDate @bind-Value="_formModel.EndDate" />
                @if (!_formModel.IsAllDay)
                {
                    <input type="time" @bind="_formModel.EndTime" />
                }
            </div>
        </div>
        <div class="field field-checkbox">
            <label>
                <InputCheckbox @bind-Value="_formModel.IsRecurring" />
                Recurring event
            </label>
        </div>
        @if (_formModel.IsRecurring)
        {
            <div class="field">
                <label>Frequency</label>
                <InputSelect @bind-Value="_formModel.RecurrenceFrequency">
                    <option value="Daily">Daily</option>
                    <option value="Weekly">Weekly</option>
                    <option value="Monthly">Monthly</option>
                </InputSelect>
            </div>
            <div class="field">
                <label>Every</label>
                <InputNumber @bind-Value="_formModel.RecurrenceIntervalCount" />
            </div>
            <div class="field">
                <label>Repeat until (optional)</label>
                <InputDate @bind-Value="_formModel.RecurrenceUntil" />
            </div>
        }
        <div class="field">
            <label>Reminders (minutes before the event, comma-separated)</label>
            <InputText @bind-Value="_formModel.RemindersText" />
        </div>
        <div class="field">
            <label>
                Notification when the event is created
                <select @bind="_formModel.CreationNotificationChannel">
                    @foreach (var option in NotificationChannelOption.All)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
            </label>
        </div>
        <div class="field">
            <label>
                Notification as the event approaches
                <select @bind="_formModel.ReminderNotificationChannel">
                    @foreach (var option in NotificationChannelOption.All)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
            </label>
        </div>

    </fieldset>

    @if (_canShare)
    {
        <fieldset disabled="@_isSaving">
            <div class="field">
                <label>Guests</label>
                @if (_formModel.GuestUserIds.Count == 0)
                {
                    <p>No guests.</p>
                }
                else
                {
                    <ul id="guestList">
                        @foreach (var guestUserId in _formModel.GuestUserIds)
                        {
                            <li>
                                @GetGuestDisplayName(guestUserId)
                                <button type="button" class="btn-secondary" @onclick="() => RemoveGuest(guestUserId)">Remove</button>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="field">
                <label>Add a guest from contacts</label>
                @if (_shareableContacts.Count == 0)
                {
                    <p>No contacts. A contact will appear here once you start a chat with someone.</p>
                }
                else
                {
                    <div class="field-row">
                        <select id="guestContactSelect" @bind="_selectedContactUserId">
                            <option value="">-- select a contact --</option>
                            @foreach (var contact in _shareableContacts)
                            {
                                <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                            }
                        </select>
                        <select id="guestAccessLevelSelect" @bind="_selectedAccessLevel">
                            <option value="ReadOnly">Read-only</option>
                            <option value="Share">Can share</option>
                            @if (_canGrantCanEdit)
                            {
                                <option value="CanEdit">Can edit</option>
                            }
                        </select>
                        <button type="button" id="addGuestFromContactButton" class="btn-secondary" @onclick="AddSelectedContactAsGuest">Add</button>
                    </div>
                }
            </div>
        </fieldset>
    }

    <div class="form-actions">
        <button type="submit" class="btn-primary" disabled="@_isSaving">Save</button>
        <button type="button" class="btn-secondary" @onclick="CancelAsync">Cancel</button>
    </div>
    </EditForm>

    @if (_errorMessage is not null)
    {
        <p class="error">@_errorMessage</p>
    }
}

@code {
    private const string MapElementId = "eventLocationMap";

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewEvent => Id is null;
    private bool _isLoading = true;
    private CalendarEventFormModel _formModel = new();
    private string? _errorMessage;
    private bool _isMapVisible;
    private IJSObjectReference? _mapPickerModule;
    private DotNetObjectReference<CalendarEventEditor>? _dotNetHelper;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private Guid _ownUserId;
    private bool _isShared;
    private bool _isSharedReadOnly;

    // Default to "fully allowed" - correct as-is for a brand new event (never overwritten below, since
    // OnInitializedAsync only recomputes these when loading an *existing* event) and overwritten to the
    // real, possibly-restricted values once an existing event's IsShared/AccessLevel are known.
    private bool _canEditContent = true;
    private bool _canShare = true;
    private bool _canGrantCanEdit = true;
    private string _accessLevel = "ReadOnly";
    private Guid? _originalOwnerUserId;
    private string? _sharedByUserName;
    private bool _isSaving;

    /// <summary>Mirrors NoteEditor's field of the same name - see its comment.</summary>
    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private IReadOnlyList<ContactDto> _shareableContacts
        => _originalOwnerUserId is { } originalOwnerUserId
            ? _contacts.Where(contact => contact.UserId != originalOwnerUserId).ToList()
            : _contacts;

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private string SharedAccessDescription => _accessLevel switch
    {
        "CanEdit" => "you can edit it",
        "Share" => "you can share it further, but not edit it",
        _ => "read-only"
    };

    /// <summary>
    /// Contacts added as a guest via the picker during this editing session (not guests already present
    /// when an existing event was loaded, and not free-typed e-mail addresses, which aren't linked to a
    /// user id) - each one gets a share offer and a chat invite once the event is saved, see
    /// ShareWithNewlyAddedContactsAsync. The access level chosen in the picker at the time each contact
    /// was added travels alongside its user id.
    /// </summary>
    private readonly List<(Guid RecipientUserId, string AccessLevel)> _shareRecipients = [];

    /// <summary>
    /// Login of every guest not found among <see cref="_contacts"/> (e.g. a guest added in an earlier
    /// session who has since stopped being a contact), resolved once via UsersApiClient and cached here
    /// instead of being looked up again on every render - see ResolveMissingGuestDisplayNamesAsync.
    /// </summary>
    private readonly Dictionary<Guid, string> _resolvedGuestUserNames = [];

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _ownUserId = Guid.Parse(authenticationState.User.FindFirst("sub")!.Value);

        try
        {
            if (Id is { } eventId)
            {
                Logger.LogInformation("Calendar event editor opened for event {EventId}", eventId);
                var calendarEvent = await CalendarApiClient.GetCalendarEventByIdAsync(eventId);
                if (calendarEvent is not null)
                {
                    _formModel = CalendarEventFormModel.FromDto(calendarEvent.Details);
                    _isShared = calendarEvent.IsShared;
                    _isSharedReadOnly = calendarEvent.IsShared && calendarEvent.AccessLevel != "CanEdit";
                    _canEditContent = !calendarEvent.IsShared || calendarEvent.AccessLevel == "CanEdit";
                    _canShare = !calendarEvent.IsShared || calendarEvent.AccessLevel is "CanEdit" or "Share";
                    _canGrantCanEdit = !calendarEvent.IsShared || calendarEvent.AccessLevel == "CanEdit";
                    _accessLevel = calendarEvent.AccessLevel;
                    _originalOwnerUserId = calendarEvent.OriginalOwnerUserId;
                    _sharedByUserName = calendarEvent.SharedByUserName;

                    if (_canEditContent)
                    {
                        await AcquireLockAsync(eventId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(eventId);
                        }
                    }
                }
            }
            else
            {
                Logger.LogInformation("Calendar event editor opened for a new event");
            }

            _contacts = await ChatApiClient.GetContactsAsync();
            await ResolveMissingGuestDisplayNamesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }

        _isLoading = false;
    }

    /// <summary>
    /// Adds the currently selected contact as a guest by user id. Silently ignores an already-added
    /// contact instead of creating a duplicate entry.
    /// </summary>
    private void AddSelectedContactAsGuest()
    {
        if (!Guid.TryParse(_selectedContactUserId, out var contactUserId))
        {
            return;
        }

        if (_contacts.Any(candidate => candidate.UserId == contactUserId) && !_formModel.GuestUserIds.Contains(contactUserId))
        {
            _formModel.GuestUserIds.Add(contactUserId);
            _shareRecipients.Add((contactUserId, _selectedAccessLevel));
        }

        _selectedContactUserId = string.Empty;
    }

    private void RemoveGuest(Guid guestUserId)
    {
        _formModel.GuestUserIds.Remove(guestUserId);
        _shareRecipients.RemoveAll(recipient => recipient.RecipientUserId == guestUserId);
    }

    /// <summary>
    /// Looks up guestUserId's login for display, preferring the already-loaded contact list and falling
    /// back to the id itself if the user can no longer be resolved (e.g. a deleted account).
    /// </summary>
    private string GetGuestDisplayName(Guid guestUserId)
    {
        var contact = _contacts.FirstOrDefault(candidate => candidate.UserId == guestUserId);
        if (contact is not null)
        {
            return contact.UserName;
        }

        return _resolvedGuestUserNames.TryGetValue(guestUserId, out var userName) ? userName : guestUserId.ToString();
    }

    /// <summary>
    /// A guest loaded from an existing event might not be among the current user's contacts (e.g. they
    /// were removed as a contact after being invited) - this resolves those remaining guests' logins
    /// directly via UsersApiClient so the guest list never falls back to showing a raw id.
    /// </summary>
    private async Task ResolveMissingGuestDisplayNamesAsync()
    {
        var missingGuestUserIds = _formModel.GuestUserIds
            .Where(guestUserId => _contacts.All(contact => contact.UserId != guestUserId))
            .Distinct();

        foreach (var guestUserId in missingGuestUserIds)
        {
            var user = await UsersApiClient.GetUserAsync(guestUserId);
            if (user is not null)
            {
                _resolvedGuestUserNames[guestUserId] = user.UserName;
            }
        }
    }

    /// <summary>
    /// The map is only initialized once it becomes visible, and torn down again when hidden - it isn't
    /// worth keeping a live Leaflet instance (and its tile requests) around for a panel the user closed.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isMapVisible && _mapPickerModule is null)
        {
            _mapPickerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mapPicker.js");
            _dotNetHelper = DotNetObjectReference.Create(this);
            await _mapPickerModule.InvokeVoidAsync(
                "initializeMapPicker", MapElementId, _dotNetHelper, _formModel.LocationLatitude, _formModel.LocationLongitude);
        }
    }

    private async Task ToggleMapAsync()
    {
        _isMapVisible = !_isMapVisible;
        if (!_isMapVisible)
        {
            await DisposeMapAsync();
        }
    }

    /// <summary>Called from mapPicker.js when the user clicks a point on the map.</summary>
    [JSInvokable]
    public async Task OnMapLocationPicked(double latitude, double longitude)
    {
        _formModel.LocationLatitude = latitude;
        _formModel.LocationLongitude = longitude;
        _formModel.LocationAddress = await GeocodingApiClient.ReverseGeocodeAsync(latitude, longitude) ?? _formModel.LocationAddress;
        StateHasChanged();
    }

    private void ClearLocation()
    {
        _formModel.LocationAddress = string.Empty;
        _formModel.LocationLatitude = null;
        _formModel.LocationLongitude = null;
    }

    private async Task SaveAsync()
    {
        Logger.LogInformation(
            "User clicked 'Save' ({Mode}, EventId={EventId})", IsNewEvent ? "create" : "update", Id);

        var details = _formModel.ToRequest();
        if (details.EndUtc < details.StartUtc)
        {
            // Also enforced server-side (CalendarEvent.ValidateTimeRange) - this just gives the user an
            // inline message instead of letting the request fail with an unhandled 500.
            _errorMessage = "The event's end can't be before its start.";
            return;
        }
        _errorMessage = null;

        // Locks the whole form (see the fieldset above) for the duration of the save, so a second click
        // or a double Enter-press can't fire this again while the first request is still in flight and
        // create a duplicate event.
        _isSaving = true;
        try
        {
            Guid eventId;
            try
            {
                if (IsNewEvent)
                {
                    eventId = await CalendarApiClient.CreateCalendarEventAsync(new CreateCalendarEventRequest(details));
                    Logger.LogInformation("Calendar event {EventId} created", eventId);
                }
                else
                {
                    eventId = Id!.Value;

                    // A Share-tier recipient's content fieldset is disabled (see _canEditContent), so
                    // there is nothing to update - only skip the PUT itself, since the code below still
                    // needs to run to send any guests they just added via the (separately gated) Guests
                    // fieldset. Sending the PUT anyway would fail: CalendarEvent.Update rejects it for
                    // anything short of CanEdit access.
                    if (_canEditContent)
                    {
                        var outcome = await CalendarApiClient.UpdateCalendarEventAsync(eventId, new UpdateCalendarEventRequest(details));
                        if (outcome.Kind == EditOutcomeKind.Locked)
                        {
                            _lockedByUserName = outcome.LockedByUserName;
                            StopLockHeartbeat();
                            _errorMessage = $"{outcome.LockedByUserName} is currently editing this event - try again in a moment.";
                            return;
                        }

                        if (outcome.Kind == EditOutcomeKind.NotFound)
                        {
                            _errorMessage = "Failed to save the event. Try again.";
                            return;
                        }

                        Logger.LogInformation("Calendar event {EventId} updated", eventId);
                        await ReleaseLockAsync(eventId);
                    }
                }
            }
            catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }
            catch (HttpRequestException exception)
            {
                Logger.LogError(exception, "Failed to {Mode} calendar event {EventId}", IsNewEvent ? "create" : "update", Id);
                _errorMessage = "Failed to save the event. Try again.";
                return;
            }

            if (_shareRecipients.Count > 0)
            {
                _errorMessage = await ShareWithNewlyAddedContactsAsync(eventId, details.Title);
                if (_errorMessage is not null)
                {
                    // The event itself is already saved at this point - only the invite step failed, so this
                    // stays on the page to show which contacts weren't notified instead of navigating away
                    // and losing that information.
                    return;
                }
            }

            NavigationManager.NavigateTo("/calendar");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Offers a copy of the just-saved event to every contact added as a guest via the picker during
    /// this editing session (see AddSelectedContactAsGuest), and notifies each of them with an
    /// encrypted chat message carrying an "Accept" action (see EventShareMessagePayload). A recipient
    /// without encryption configured yet, or any other per-recipient failure, is logged and skipped
    /// rather than aborting the remaining invites - mirrors CreateCalendarEventCommandHandler's
    /// best-effort treatment of the creation e-mail. Returns a message describing who could not be
    /// notified, or null if every invite went out.
    /// </summary>
    private async Task<string?> ShareWithNewlyAddedContactsAsync(Guid eventId, string eventTitle)
    {
        var recipientsNotNotified = new List<string>();
        foreach (var (recipientUserId, accessLevel) in _shareRecipients)
        {
            var contactDisplayName = _contacts.FirstOrDefault(contact => contact.UserId == recipientUserId)?.DisplayName
                ?? recipientUserId.ToString();
            try
            {
                var result = await CalendarApiClient.ShareCalendarEventAsync(eventId, recipientUserId, accessLevel);
                if (result is null)
                {
                    recipientsNotNotified.Add(contactDisplayName);
                    continue;
                }

                // result.AlreadyShared means this contact already had a pending or accepted share of
                // this event - result.ShareId is that existing offer's id rather than a new one, so this
                // resends it as a reminder instead of creating a duplicate (see ShareCalendarEventCommandHandler).
                var payloadJson = JsonSerializer.Serialize(new EventShareMessagePayload(result.ShareId, eventTitle));
                await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson);
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                Logger.LogWarning(
                    exception, "Failed to share calendar event {EventId} with user {RecipientUserId}", eventId, recipientUserId);
                recipientsNotNotified.Add(contactDisplayName);
            }
        }

        return recipientsNotNotified.Count == 0
            ? null
            : $"The event was saved, but the invite couldn't be sent to: {string.Join(", ", recipientsNotNotified)}.";
    }

    private async Task CancelAsync()
    {
        Logger.LogInformation("User clicked 'Cancel'");
        if (Id is { } eventId)
        {
            await ReleaseLockAsync(eventId);
        }

        NavigationManager.NavigateTo("/calendar");
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task AcquireLockAsync(Guid eventId)
    {
        try
        {
            var outcome = await CalendarApiClient.AcquireCalendarEventLockAsync(eventId);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task ReleaseLockAsync(Guid eventId)
    {
        StopLockHeartbeat();
        if (!_canEditContent)
        {
            return;
        }

        try
        {
            await CalendarApiClient.ReleaseCalendarEventLockAsync(eventId);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat(Guid eventId)
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(eventId, _lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(Guid eventId, CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync(eventId);
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task DisposeMapAsync()
    {
        if (_mapPickerModule is not null)
        {
            await _mapPickerModule.InvokeVoidAsync("disposeMapPicker", MapElementId);
            await _mapPickerModule.DisposeAsync();
            _mapPickerModule = null;
        }

        _dotNetHelper?.Dispose();
        _dotNetHelper = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeMapAsync();
        if (Id is { } eventId)
        {
            await ReleaseLockAsync(eventId);
        }
        else
        {
            StopLockHeartbeat();
        }
    }

    private sealed class CalendarEventFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string LocationAddress { get; set; } = string.Empty;
        public double? LocationLatitude { get; set; }
        public double? LocationLongitude { get; set; }
        public string Color { get; set; } = "#4a90d9";
        public bool IsAllDay { get; set; }
        public DateOnly? StartDate { get; set; }
        public TimeOnly? StartTime { get; set; }
        public DateOnly? EndDate { get; set; }
        public TimeOnly? EndTime { get; set; }
        public bool IsRecurring { get; set; }
        public string RecurrenceFrequency { get; set; } = "Weekly";
        public int RecurrenceIntervalCount { get; set; } = 1;
        public DateOnly? RecurrenceUntil { get; set; }
        public List<Guid> GuestUserIds { get; set; } = [];
        public string RemindersText { get; set; } = string.Empty;
        public string CreationNotificationChannel { get; set; } = "None";
        public string ReminderNotificationChannel { get; set; } = "None";

        /// <summary>
        /// Defaults a new event to start now and end an hour later. Start and end are each derived from
        /// a single timestamp (rather than combining DateTime.Today with a separately-computed time) so
        /// the end date rolls over correctly when starting late enough that adding an hour crosses
        /// midnight - otherwise the end date could default to the still-current day while the end time
        /// wraps to just after midnight, putting the end before the start.
        /// </summary>
        public CalendarEventFormModel()
        {
            var start = DateTime.Now;
            var end = start.AddHours(1);
            StartDate = DateOnly.FromDateTime(start);
            StartTime = TimeOnly.FromDateTime(start);
            EndDate = DateOnly.FromDateTime(end);
            EndTime = TimeOnly.FromDateTime(end);
        }

        public static CalendarEventFormModel FromDto(CalendarEventDetailsDto details)
            => new()
            {
                Title = details.Title,
                Description = details.Description ?? string.Empty,
                LocationAddress = details.Location?.Address ?? string.Empty,
                LocationLatitude = details.Location?.Latitude,
                LocationLongitude = details.Location?.Longitude,
                Color = string.IsNullOrWhiteSpace(details.Color) ? "#4a90d9" : details.Color,
                IsAllDay = details.IsAllDay,
                StartDate = DateOnly.FromDateTime(details.StartUtc.LocalDateTime),
                StartTime = TimeOnly.FromDateTime(details.StartUtc.LocalDateTime),
                EndDate = DateOnly.FromDateTime(details.EndUtc.LocalDateTime),
                EndTime = TimeOnly.FromDateTime(details.EndUtc.LocalDateTime),
                IsRecurring = details.Recurrence is not null,
                RecurrenceFrequency = details.Recurrence?.Frequency ?? "Weekly",
                RecurrenceIntervalCount = details.Recurrence?.IntervalCount ?? 1,
                RecurrenceUntil = details.Recurrence?.UntilUtc is { } until ? DateOnly.FromDateTime(until.LocalDateTime) : null,
                GuestUserIds = details.Guests.ToList(),
                RemindersText = string.Join(", ", details.ReminderMinutesBeforeStart),
                CreationNotificationChannel = details.CreationNotificationChannel,
                ReminderNotificationChannel = details.ReminderNotificationChannel
            };

        public CalendarEventDetailsRequest ToRequest()
        {
            var startUtc = ToDateTimeOffset(StartDate, StartTime, IsAllDay);
            var endUtc = ToDateTimeOffset(EndDate, EndTime, IsAllDay);
            var recurrence = IsRecurring
                ? new RecurrenceRequest(RecurrenceFrequency, RecurrenceIntervalCount, ToOptionalDateTimeOffset(RecurrenceUntil))
                : null;
            var location = LocationLatitude is { } latitude && LocationLongitude is { } longitude
                ? new EventLocationRequest(string.IsNullOrWhiteSpace(LocationAddress) ? null : LocationAddress, latitude, longitude)
                : null;

            return new CalendarEventDetailsRequest(
                Title,
                string.IsNullOrWhiteSpace(Description) ? null : Description,
                location,
                Color,
                startUtc,
                endUtc,
                IsAllDay,
                recurrence,
                GuestUserIds,
                ParseCommaSeparatedIntegers(RemindersText),
                CreationNotificationChannel,
                ReminderNotificationChannel);
        }

        /// <summary>
        /// Combines the separately-edited date and time-of-day into the single timestamp the API
        /// expects. All-day events are anchored to local midnight regardless of the time field.
        /// </summary>
        private static DateTimeOffset ToDateTimeOffset(DateOnly? date, TimeOnly? time, bool isAllDay)
        {
            var effectiveDate = date ?? DateOnly.FromDateTime(DateTime.Today);
            var effectiveTime = isAllDay ? TimeOnly.MinValue : time ?? TimeOnly.MinValue;
            return new DateTimeOffset(effectiveDate.ToDateTime(effectiveTime, DateTimeKind.Local));
        }

        private static DateTimeOffset? ToOptionalDateTimeOffset(DateOnly? date)
            => date is { } value ? new DateTimeOffset(value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local)) : null;

        private static List<int> ParseCommaSeparatedIntegers(string text)
            => text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(part => int.TryParse(part, out _))
                .Select(int.Parse)
                .ToList();
    }
}
