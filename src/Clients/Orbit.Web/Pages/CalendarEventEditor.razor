@page "/calendar/new"
@page "/calendar/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Notifications
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject CalendarApiClient CalendarApiClient
@inject TasksApiClient TasksApiClient
@inject ChatApiClient ChatApiClient
@inject NotificationsApiClient NotificationsApiClient
@inject UsersApiClient UsersApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject GeocodingApiClient GeocodingApiClient
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ChosenPlace ChosenPlace
@inject ILogger<CalendarEventEditor> Logger
@inject Translations T

<PageTitle>@(IsNewEvent ? T["New event"] : T["Edit event"])</PageTitle>

<div class="page-header">
    <div class="page-heading">
        <h1>@(IsNewEvent ? T["New event"] : T["Edit event"])</h1>
    </div>
    @if (!_isLoading)
    {
        <EditorActions OnSave="SaveAsync" OnCancel="CancelAsync" SaveDisabled="@_isSaving">
            @* Deleting from here, not only from the calendar page: opening an event to look at it and
               deciding it should go is the moment the wish arrives. In a menu rather than as a third
               button, because it is not one of the two things this page is for - and only for an event
               that is actually yours to change, the same gate the content fieldset uses. *@
            @if (!IsNewEvent && _canEditContent)
            {
                <OverflowMenu>
                    <button type="button" class="avatar-dropdown-item" disabled="@_isDeleting" @onclick="DeleteAsync">
                        @T["Delete event"]
                    </button>
                </OverflowMenu>
            }
        </EditorActions>
    }
</div>

@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else
{
    @if (_isShared)
    {
        <p class="shared-event-banner">@T["This event was shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.
        </p>
    }

    @if (_lockedByUserName is not null)
    {
        <p class="lock-banner">
            @T.Format("{0} is currently editing this event - you can't edit it right now.", _lockedByUserName)
        </p>
    }

    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="editor-form">
    <fieldset disabled="@IsLockedForEditing">
        <div class="field">
            <label for="eventTitleInput">@T["Title"]</label>
            <input id="eventTitleInput" type="text" value="@_title"
                   @oninput="args => _title = args.Value?.ToString() ?? string.Empty" />
        </div>
    </fieldset>

    @* Everything else an event is, drawn by the control the task list's calendar entry uses too - see
       EventFields.razor. One form, so the two cannot drift apart. *@
    <EventFields Model="_formModel" NotificationSettings="_notificationSettings"
                 IsReadOnly="IsLockedForEditing" OnMapRequested="OpenTheMap"
                 CanInviteGuests="_canShare" Contacts="_contacts"
                 CanGrantEditOnly="_canGrantEditOnly" CanGrantCanEdit="_canGrantCanEdit"
                 GuestDisplayName="GetGuestDisplayName" GuestAccessLabel="GetGuestAccessLabel"
                 OnGuestAdded="OnGuestAdded" OnGuestRemoved="OnGuestRemoved" />

    @* Which task list this appointment should also show up on. The list gets an entry that points at
       this event rather than a copy of it, so the two can never come to disagree about when it is or
       where - see LinkCalendarEventToTaskListCommand. Written back on Save, because an entry pointing
       at an event that was never saved would point at nothing. *@
    @if (_linkableTaskLists.Count > 0)
    {
        <fieldset disabled="@IsLockedForEditing">
            <div class="field">
                <label for="linkToTaskListSelect">@T["Link to list"]</label>
                <select id="linkToTaskListSelect" @bind="_linkToTaskListId">
                    <option value="">@T["No list"]</option>
                    @foreach (var taskList in _linkableTaskLists)
                    {
                        <option value="@taskList.Id">@Written(taskList.Title)</option>
                    }
                </select>
                <small>@T["The list gets an entry pointing at this event, not a copy of it."]</small>
            </div>
        </fieldset>
    }

    </EditForm>

    @if (!IsNewEvent && Id is { } calendarEventId)
    {
        <h2>@T["Link"]</h2>
        <ShareLinkButton ItemType="CalendarEvent" ItemId="calendarEventId" />
    }

    @* An event is worth having in the calendar somebody actually lives out of. The link hands Google
       what this event says and opens its own form, so what lands there is still their decision - see
       GoogleCalendarEventLink for why this is a link and not an API call. *@
    @if (!IsNewEvent && _hasGoogleExtras && _savedDetails is { } savedDetails)
    {
        <h2>@T["Google Calendar"]</h2>
        <p class="options-subtext">@T["Opens Google's own form with this event filled in. Nothing is saved there until you save it."]</p>
        <a class="btn-secondary" href="@GoogleCalendarLinkFor(savedDetails)" target="_blank" rel="noopener">
            @T["Add to Google Calendar"]
        </a>
    }

    @if (_errorMessage is not null)
    {
        <p class="error">@_errorMessage</p>
    }
}

@if (_isMapVisible)
{
    <LocationPickerOverlay Address="@_formModel.LocationAddress" OnPicked="UseThePickedPlace" OnCancelled="CloseTheMap" />
}

@code {
    private const string MapElementId = "eventLocationMap";

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNewEvent => Id is null;

    /// <summary>
    /// The lists this event could be put on. Narrowed to the ones an entry can actually be added to: a
    /// private list keeps its entries sealed where only its owner's browser can reach them, and a list
    /// held through a read-only share is not this reader's to add to. Left out of the picker rather
    /// than offered and then refused, which is how every other rule the server enforces is handled on
    /// this side.
    /// </summary>
    private IReadOnlyList<TaskDto> _linkableTaskLists = [];

    /// <summary>Which of them was chosen, if any. Acted on by the save - see LinkToTheTaskListAsync.</summary>
    private string _linkToTaskListId = string.Empty;

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    private string GoogleCalendarLinkFor(CalendarEventDetailsDto details)
        => GoogleCalendarEventLink.ForEvent(new GoogleCalendarEvent(details.Title, details.StartUtc, details.EndUtc)
        {
            IsAllDay = details.IsAllDay,
            Description = details.Description,
            Location = details.Location is { } location ? LocationLabel(location) : null,
            Recurrence = details.Recurrence,
            TaskListTitle = TheListThisEventIsOn() is { } taskList ? Written(taskList.Title) : null,
            GuestEmailAddresses = GoogleGuestAddresses(details.Guests),
            ReminderMinutesBeforeStart = details.ReminderMinutesBeforeStart,
            NotifyAtStart = details.NotifyAtStart
        });

    /// <summary>The list holding an entry that points at this event, if any - see LinkCalendarEventToTaskListCommand.</summary>
    private TaskDto? TheListThisEventIsOn()
        => Id is { } calendarEventId
            ? _linkableTaskLists.FirstOrDefault(taskList =>
                taskList.Items.Any(item => item.LinkedCalendarEventId == calendarEventId))
            : null;

    /// <summary>
    /// The guests Google can actually invite. An address Google has not verified is one it cannot
    /// match to an account, so the invitation would go nowhere - see ContactDto.HasGoogleVerifiedEmail.
    /// </summary>
    private IReadOnlyList<string> GoogleGuestAddresses(IReadOnlyList<Guid> guests)
        => [.. _contacts
            .Where(contact => contact.HasGoogleVerifiedEmail && guests.Contains(contact.UserId))
            .Select(contact => contact.Email)];

    /// <summary>What Google should show as the place: the address when there is one, coordinates otherwise.</summary>
    private static string LocationLabel(EventLocationDto location)
        => string.IsNullOrWhiteSpace(location.Address)
            ? $"{location.Latitude.ToString(CultureInfo.InvariantCulture)}, {location.Longitude.ToString(CultureInfo.InvariantCulture)}"
            : location.Address;
    private bool _isLoading = true;
    private EventFormModel _formModel = new();

    /// <summary>The event's name. Its own field rather than the shared control's - see EventFields.razor.</summary>
    private string _title = string.Empty;

    /// <summary>Locked, read-only, or mid-save: three reasons the event itself must not move under anybody.</summary>
    private bool IsLockedForEditing => !_canEditContent || _lockedByUserName is not null || _isSaving;
    private string? _errorMessage;
    private bool _isMapVisible;
    private IJSObjectReference? _mapPickerModule;
    private DotNetObjectReference<CalendarEventEditor>? _dotNetHelper;
    private IReadOnlyList<ContactDto> _contacts = [];
    private Guid _ownUserId;
    private bool _isShared;
    private bool _isSharedReadOnly;

    // Default to "fully allowed" - correct as-is for a brand new event (never overwritten below, since
    // OnInitializedAsync only recomputes these when loading an *existing* event) and overwritten to the
    // real, possibly-restricted values once an existing event's IsShared/AccessLevel are known.
    private bool _canEditContent = true;
    private bool _canShare = true;
    private bool _canGrantCanEdit = true;
    private bool _canGrantEditOnly = true;
    private SharedItemAccess _access = new(IsShared: false, ShareAccessLevel.CanEdit);
    private Guid? _originalOwnerUserId;
    private string? _sharedByUserName;
    private bool _isSaving;
    private bool _isDeleting;

    /// <summary>
    /// The event as it is stored, kept for the Google Calendar link. The form model would export what is
    /// half-typed on screen instead, which is not what "add this event to my calendar" means.
    /// </summary>
    private CalendarEventDetailsDto? _savedDetails;

    /// <summary>Whether to offer the Google link at all - see GoogleIntegrationAccess for who qualifies and why.</summary>
    private bool _hasGoogleExtras;

    /// <summary>Mirrors NoteEditor's field of the same name - see its comment.</summary>
    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private IReadOnlyList<ContactDto> _shareableContacts
        => _originalOwnerUserId is { } originalOwnerUserId
            ? _contacts.Where(contact => contact.UserId != originalOwnerUserId).ToList()
            : _contacts;

    /// <summary>Mirrors NoteEditor's property of the same name - see its comment.</summary>
    private string SharedAccessDescription => T[_access.Description];

    /// <summary>
    /// Contacts added as a guest via the picker during this editing session (not guests already present
    /// when an existing event was loaded, and not free-typed e-mail addresses, which aren't linked to a
    /// user id) - each one gets a share offer and a chat invite once the event is saved, see
    /// ShareWithNewlyAddedContactsAsync. The access level chosen in the picker at the time each contact
    /// was added travels alongside its user id.
    /// </summary>
    private readonly List<(Guid RecipientUserId, string AccessLevel)> _shareRecipients = [];

    /// <summary>
    /// Login of every guest not found among <see cref="_contacts"/> (e.g. a guest added in an earlier
    /// session who has since stopped being a contact), resolved once via UsersApiClient and cached here
    /// instead of being looked up again on every render - see ResolveMissingGuestDisplayNamesAsync.
    /// </summary>
    private readonly Dictionary<Guid, string> _resolvedGuestUserNames = [];

    /// <summary>
    /// Common reminder offsets, mirroring Google Calendar's reminder picker. Zero is one of them: an
    /// event beginning is worth hearing about, and being told only that it will begin in five minutes
    /// leaves the moment itself unannounced. EventReminderPushContent already words a zero lead time as
    /// "starts now" - the picker was the only place it could not be chosen.
    /// </summary>
    private NotificationSettingsDto _notificationSettings = new(true, true, true, true, true, BannerVisibleSeconds: 5, BannerMinimumGapSeconds: 5);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
            _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync()
                ?? throw new HttpRequestException("No signed-in user.", null, HttpStatusCode.Unauthorized);

            // Best-effort: gates which notification-channel options are selectable (see
            // NotificationChannelOption.IsDisabledBy) - a failure here just leaves every option enabled
            // rather than blocking the rest of the page from loading.
            try
            {
                _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Failed to load notification settings");
            }

            // Best-effort: an event can be saved without being put on a list, so a tasks call that fails
            // costs the picker and nothing else.
            try
            {
                _linkableTaskLists = [.. (await TasksApiClient.GetTaskListsAsync()).Where(CanTakeAnEntry)];
                // Whichever list already holds an entry for this event, so reopening it shows the link
                // that exists rather than "No list" - which read as the choice never having been saved.
                _linkToTaskListId = TheListThisEventIsOn()?.Id.ToString() ?? string.Empty;
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Failed to load the task lists this event could be put on");
            }

            // A place chosen on the map, if this editor was opened from there. Taken rather than read,
            // so returning to a new event later starts empty instead of somewhere you looked at once.
            if (IsNewEvent && ChosenPlace.Take() is { } place)
            {
                _formModel.LocationAddress = place.Address;
                _formModel.LocationLatitude = place.Latitude;
                _formModel.LocationLongitude = place.Longitude;
            }

            if (Id is { } eventId)
            {
                Logger.LogInformation("Calendar event editor opened for event {EventId}", eventId);
                var calendarEvent = await CalendarApiClient.GetCalendarEventByIdAsync(eventId);
                if (calendarEvent is not null)
                {
                    _formModel = EventFormModel.FromDto(calendarEvent.Details);
                    _title = calendarEvent.Details.Title;
                    _savedDetails = calendarEvent.Details;
                    _isShared = calendarEvent.IsShared;
                    _access = SharedItemAccess.For(calendarEvent.IsShared, calendarEvent.AccessLevel);
                    _isSharedReadOnly = calendarEvent.IsShared && !_access.CanEdit;
                    _canEditContent = _access.CanEdit;
                    _canShare = _access.CanShare;
                    _canGrantCanEdit = _access.CanGrantCanEdit;
                    _canGrantEditOnly = _access.CanGrantEditOnly;
                    _originalOwnerUserId = calendarEvent.OriginalOwnerUserId;
                    _sharedByUserName = calendarEvent.SharedByUserName;

                    if (_canEditContent)
                    {
                        await AcquireLockAsync(eventId);
                        if (_lockedByUserName is null)
                        {
                            StartLockHeartbeat(eventId);
                        }
                    }
                }
            }
            else
            {
                Logger.LogInformation("Calendar event editor opened for a new event");
                // A reminder to go with the channel above. Without one the channel has nothing to fire,
                // so a new event still told nobody anything - and ten minutes is what the Add button
                // reaches for too. Only for a new event: an existing one keeps whatever it was given,
                // including deliberately having none.
                _formModel.Reminders = [ReminderRow.FromMinutes(DefaultReminderMinutesBeforeStart)];
            }

            _contacts = await ChatApiClient.GetContactsAsync();
            await ResolveMissingGuestDisplayNamesAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The access token expired and AuthorizationMessageHandler's automatic refresh-and-retry
            // also failed (e.g. the refresh token itself expired or was revoked) - the session is no
            // longer valid, so send the user back to sign in instead of leaving the page stuck loading.
            NavigationManager.NavigateTo("/login");
            return;
        }

        _isLoading = false;
    }

    private const int DefaultReminderMinutesBeforeStart = 10;

    /// <summary>
    /// An invitation is two things: a guest on the event, which the control has already added, and a
    /// share carrying what they are allowed to do, which is sent when the event is saved - see
    /// ShareWithRecipientsAsync. Only then, because a share needs an event id and a new event has none.
    /// </summary>
    private void OnGuestAdded((Guid UserId, string AccessLevel) invitation)
        => _shareRecipients.Add((invitation.UserId, invitation.AccessLevel));

    private void OnGuestRemoved(Guid guestUserId)
        => _shareRecipients.RemoveAll(recipient => recipient.RecipientUserId == guestUserId);

    /// <summary>What this guest was invited as, where this session is the one that invited them.</summary>
    private string GetGuestAccessLabel(Guid guestUserId)
        => _shareRecipients.FirstOrDefault(recipient => recipient.RecipientUserId == guestUserId) is { AccessLevel: { } level }
            ? level
            : string.Empty;

    /// <summary>
    /// Looks up guestUserId's login for display, preferring the already-loaded contact list and falling
    /// back to the id itself if the user can no longer be resolved (e.g. a deleted account).
    /// </summary>
    private string GetGuestDisplayName(Guid guestUserId)
    {
        var contact = _contacts.FirstOrDefault(candidate => candidate.UserId == guestUserId);
        if (contact is not null)
        {
            return contact.UserName;
        }

        return _resolvedGuestUserNames.TryGetValue(guestUserId, out var userName) ? userName : guestUserId.ToString();
    }

    /// <summary>
    /// A guest loaded from an existing event might not be among the current user's contacts (e.g. they
    /// were removed as a contact after being invited) - this resolves those remaining guests' logins
    /// directly via UsersApiClient so the guest list never falls back to showing a raw id.
    /// </summary>
    private async Task ResolveMissingGuestDisplayNamesAsync()
    {
        var missingGuestUserIds = _formModel.GuestUserIds
            .Where(guestUserId => _contacts.All(contact => contact.UserId != guestUserId))
            .Distinct();

        foreach (var guestUserId in missingGuestUserIds)
        {
            var user = await UsersApiClient.GetUserAsync(guestUserId);
            if (user is not null)
            {
                _resolvedGuestUserNames[guestUserId] = user.UserName;
            }
        }
    }

    /// <summary>The entry's place is pointed at over the page, in the same overlay the task editor uses.</summary>
    private void OpenTheMap() => _isMapVisible = true;

    private void CloseTheMap() => _isMapVisible = false;

    /// <summary>
    /// The pin was confirmed. Its address fills the box when the box is empty, and is left alone when
    /// somebody wrote a name of their own there - "the back entrance" is the whole reason that box is
    /// typed into. The place itself is set either way: the words are the reader's to choose, but where
    /// it is was decided by the pin.
    /// </summary>
    private void UseThePickedPlace(PickedPlace place)
    {
        _formModel.LocationLatitude = place.Latitude;
        _formModel.LocationLongitude = place.Longitude;
        if (_formModel.LocationAddress.Trim().Length == 0)
        {
            _formModel.LocationAddress = place.Address;
        }

        _isMapVisible = false;
    }

    private static bool CanTakeAnEntry(TaskDto taskList)
        => !taskList.IsPrivate && (!taskList.IsShared || SharedItemAccess.For(true, taskList.AccessLevel).CanEdit);

    /// <summary>
    /// Puts the saved event on the chosen list. One request that appends one entry - the list is not
    /// read and written back, so nothing else on it is at risk - see LinkCalendarEventToTaskListCommand.
    ///
    /// Returns what went wrong, or null. Runs after the event is saved, so a failure here leaves the
    /// event itself saved: the reader is told which half did not happen rather than being sent away
    /// believing both did.
    /// </summary>
    private async Task<string?> LinkToTheTaskListAsync(Guid taskListId, Guid eventId)
    {
        try
        {
            var outcome = await TasksApiClient.LinkCalendarEventAsync(taskListId, eventId);
            return outcome.Kind switch
            {
                EditOutcomeKind.Success => null,
                EditOutcomeKind.Locked => T.Format(
                    "The event is saved, but {0} is editing that list - put it on the list again in a moment.",
                    outcome.LockedByUserName),
                _ => T["The event is saved, but it couldn't be put on that list."]
            };
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to put calendar event {EventId} on task list {TaskListId}", eventId, taskListId);
            return T["The event is saved, but it couldn't be put on that list."];
        }
    }

    private async Task SaveAsync()
    {
        Logger.LogInformation(
            "User clicked 'Save' ({Mode}, EventId={EventId})", IsNewEvent ? "create" : "update", Id);

        var details = _formModel.ToRequest(_title);
        if (details.EndUtc < details.StartUtc)
        {
            // Also enforced server-side (CalendarEvent.ValidateTimeRange) - this just gives the user an
            // inline message instead of letting the request fail with an unhandled 500.
            _errorMessage = T["The event's end can't be before its start."];
            return;
        }
        _errorMessage = null;

        // Locks the whole form (see the fieldset above) for the duration of the save, so a second click
        // or a double Enter-press can't fire this again while the first request is still in flight and
        // create a duplicate event.
        _isSaving = true;
        try
        {
            Guid eventId;
            try
            {
                if (IsNewEvent)
                {
                    eventId = await CalendarApiClient.CreateCalendarEventAsync(new CreateCalendarEventRequest(details));
                    Logger.LogInformation("Calendar event {EventId} created", eventId);
                }
                else
                {
                    eventId = Id!.Value;

                    // A Share-tier recipient's content fieldset is disabled (see _canEditContent), so
                    // there is nothing to update - only skip the PUT itself, since the code below still
                    // needs to run to send any guests they just added via the (separately gated) Guests
                    // fieldset. Sending the PUT anyway would fail: CalendarEvent.Update rejects it for
                    // anything short of CanEdit access.
                    if (_canEditContent)
                    {
                        var outcome = await CalendarApiClient.UpdateCalendarEventAsync(eventId, new UpdateCalendarEventRequest(details));
                        if (outcome.Kind == EditOutcomeKind.Locked)
                        {
                            _lockedByUserName = outcome.LockedByUserName;
                            StopLockHeartbeat();
                            _errorMessage = T.Format("{0} is currently editing this event - try again in a moment.", outcome.LockedByUserName);
                            return;
                        }

                        if (outcome.Kind == EditOutcomeKind.Refused)
                        {
                            _errorMessage = outcome.Reason;
                            return;
                        }

                        if (outcome.Kind == EditOutcomeKind.NotFound)
                        {
                            _errorMessage = T["Failed to save the event. Try again."];
                            return;
                        }

                        Logger.LogInformation("Calendar event {EventId} updated", eventId);
                        await ReleaseLockAsync(eventId);
                    }
                }
            }
            catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }
            catch (HttpRequestException exception)
            {
                Logger.LogError(exception, "Failed to {Mode} calendar event {EventId}", IsNewEvent ? "create" : "update", Id);
                _errorMessage = T["Failed to save the event. Try again."];
                return;
            }

            if (Guid.TryParse(_linkToTaskListId, out var taskListId))
            {
                _errorMessage = await LinkToTheTaskListAsync(taskListId, eventId);
                if (_errorMessage is not null)
                {
                    // The event is saved by now; only the list did not get it. Staying here is what
                    // lets somebody try that half again rather than wonder which half happened.
                    return;
                }
            }

            if (_shareRecipients.Count > 0)
            {
                _errorMessage = await ShareWithNewlyAddedContactsAsync(eventId, details.Title);
                if (_errorMessage is not null)
                {
                    // The event itself is already saved at this point - only the invite step failed, so this
                    // stays on the page to show which contacts weren't notified instead of navigating away
                    // and losing that information.
                    return;
                }
            }

            NavigationManager.NavigateTo("/calendar");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Offers a copy of the just-saved event to every contact added as a guest via the picker during
    /// this editing session (see AddSelectedContactAsGuest), and notifies each of them with an
    /// encrypted chat message carrying an "Accept" action (see EventShareMessagePayload). A recipient
    /// without encryption configured yet, or any other per-recipient failure, is logged and skipped
    /// rather than aborting the remaining invites - mirrors CreateCalendarEventCommandHandler's
    /// best-effort treatment of the creation e-mail. Returns a message describing who could not be
    /// notified, or null if every invite went out.
    /// </summary>
    private async Task<string?> ShareWithNewlyAddedContactsAsync(Guid eventId, string eventTitle)
    {
        var recipientsNotNotified = new List<string>();
        foreach (var (recipientUserId, accessLevel) in _shareRecipients)
        {
            var contactDisplayName = _contacts.FirstOrDefault(contact => contact.UserId == recipientUserId)?.DisplayName
                ?? recipientUserId.ToString();
            try
            {
                var result = await CalendarApiClient.ShareCalendarEventAsync(eventId, recipientUserId, accessLevel);
                if (result is null)
                {
                    recipientsNotNotified.Add(contactDisplayName);
                    continue;
                }

                // result.AlreadyShared means this contact already had a pending or accepted share of
                // this event - result.ShareId is that existing offer's id rather than a new one, so this
                // resends it as a reminder instead of creating a duplicate (see ShareCalendarEventCommandHandler).
                var payloadJson = JsonSerializer.Serialize(new EventShareMessagePayload(result.ShareId, eventTitle));
                await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson, isShareInvitation: true);
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                Logger.LogWarning(
                    exception, "Failed to share calendar event {EventId} with user {RecipientUserId}", eventId, recipientUserId);
                recipientsNotNotified.Add(contactDisplayName);
            }
        }

        return recipientsNotNotified.Count == 0
            ? null
            : $"The event was saved, but the invite couldn't be sent to: {string.Join(", ", recipientsNotNotified)}.";
    }

    /// <summary>
    /// Asks first, like the calendar page's own delete does, then goes back to the calendar - staying on
    /// the editor of something that no longer exists would only offer a Save that could not work.
    /// </summary>
    private async Task DeleteAsync()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", T["Delete this event? This can't be undone."]))
        {
            return;
        }

        _isDeleting = true;
        Logger.LogInformation("User clicked 'Delete event' (EventId={EventId})", Id);
        try
        {
            await CalendarApiClient.DeleteCalendarEventAsync(Id!.Value);
            NavigationManager.NavigateTo("/calendar");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to delete calendar event {EventId}", Id);
            _errorMessage = T["Couldn't delete the event. Try again."];
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task CancelAsync()
    {
        Logger.LogInformation("User clicked 'Cancel'");
        if (Id is { } eventId)
        {
            await ReleaseLockAsync(eventId);
        }

        NavigationManager.NavigateTo("/calendar");
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task AcquireLockAsync(Guid eventId)
    {
        try
        {
            var outcome = await CalendarApiClient.AcquireCalendarEventLockAsync(eventId);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Mirrors NoteEditor's method of the same name - see its comment.</summary>
    private async Task ReleaseLockAsync(Guid eventId)
    {
        StopLockHeartbeat();
        if (!_canEditContent)
        {
            return;
        }

        try
        {
            await CalendarApiClient.ReleaseCalendarEventLockAsync(eventId);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat(Guid eventId)
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(eventId, _lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(Guid eventId, CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync(eventId);
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task DisposeMapAsync()
    {
        if (_mapPickerModule is not null)
        {
            await _mapPickerModule.InvokeVoidAsync("disposeMapPicker", MapElementId);
            await _mapPickerModule.DisposeAsync();
            _mapPickerModule = null;
        }

        _dotNetHelper?.Dispose();
        _dotNetHelper = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeMapAsync();
        if (Id is { } eventId)
        {
            await ReleaseLockAsync(eventId);
        }
        else
        {
            StopLockHeartbeat();
        }
    }
}
