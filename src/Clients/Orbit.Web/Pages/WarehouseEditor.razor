@page "/inventory/{WarehouseId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using Orbit.Contracts.Inventory
@using Orbit.Contracts.Notifications
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject InventoryApiClient InventoryApiClient
@inject NotificationsApiClient NotificationsApiClient
@inject NavigationManager NavigationManager
@inject ILogger<WarehouseEditor> Logger
@inject Translations T

<PageTitle>@(_formModel.Name.Length > 0 ? _formModel.Name : T["Warehouse"])</PageTitle>

@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else
{
    <div class="page-header">
        <div>
            <h1>@(_formModel.Name.Length > 0 ? _formModel.Name : T["Warehouse"])</h1>
            <p class="page-subtitle">@T["Everything in this warehouse, edited together - a low item still raises a restock task."]</p>
            @if (_isShared)
            {
                <p class="shared-note-banner">@T["Shared by"]@Space<strong>@_sharedByUserName</strong> - @SharedAccessDescription.</p>
            }
        </div>
        <button class="btn-secondary" @onclick="GoToWarehouses">@T["All warehouses"]</button>
    </div>

    @if (_lockedByUserName is not null)
    {
        <p class="lock-banner">
            @T.Format("{0} is currently editing this warehouse - you can't edit it right now.", _lockedByUserName)
        </p>
    }

    @* Submitting this form adds a row rather than saving it. Enter is what somebody filling a shelf
       presses between items, and it used to save the warehouse and leave the page instead - so the
       form's default button is "Add item", and Save is a click of its own. *@
    <EditForm Model="_formModel" OnValidSubmit="AddItem" class="editor-form">
        <fieldset disabled="@(_isReadOnly || _lockedByUserName is not null || _isSaving)">
            <div class="field">
                <label>@T["Name"]</label>
                <InputText id="warehouseNameInput" @bind-Value="_formModel.Name" />
            </div>

            @* Only the owner may turn this on: a warehouse reached through a share belongs to someone
               else, and "private" means private to its creator. *@
            @if (!_isShared)
            {
                <div class="field">
                    <label>
                        <InputCheckbox @bind-Value="_formModel.IsPrivate" />@T["Private"]</label>
                    <small>
                        @T["Encrypted in this browser, so Orbit can't read it. It can't be shared, raises no restock or expiry reminders, and losing your password loses it."]
                    </small>
                </div>
            }

            <h2 class="options-heading">@T["Items"]</h2>

            @* Narrows what is on screen, never what is saved: the whole list still goes back on Save,
               hidden rows included - see WarehouseFormModel.ToRequest, which reads Items and not this. *@
            @if (_formModel.Items.Count > 0)
            {
                <div class="inventory-filters">
                    @* The two are picked from what is on the shelf, so neither is offered where nothing
                       is filed under it - a filter with one empty answer is a dead end. Searching by
                       name has no such condition: a name is typed, and every item has one. *@
                    @if (ProductTypesOnTheShelf.Count > 0)
                    {
                        <label>
                            @T["Product type"]
                            <select @bind="_filter.ProductType" aria-label="@(T["Product type"])">
                                <option value="">@T["Any type"]</option>
                                @foreach (var productType in ProductTypesOnTheShelf)
                                {
                                    <option value="@productType">@productType</option>
                                }
                            </select>
                        </label>
                    }
                    @if (CategoriesOnTheShelf.Count > 0)
                    {
                        <label>
                            @T["Category"]
                            <select @bind="_filter.Category" aria-label="@(T["Category"])">
                                <option value="">@T["Any category"]</option>
                                @foreach (var category in CategoriesOnTheShelf)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="inventory-filters-search">
                        @T["Search"]
                        @* Narrows as it is typed rather than on Enter: the list is already on screen, so
                           there is nothing to wait for. *@
                        <input type="search" @bind="_filter.Name" @bind:event="oninput"
                               placeholder="@(T["Item name"])" aria-label="@(T["Search items by name"])" />
                    </label>
                    @if (_filter.IsActive)
                    {
                        <button type="button" class="btn-secondary" @onclick="ClearFilters">@T["Show everything"]</button>
                    }
                </div>
            }

            @if (_formModel.Items.Count == 0)
            {
                <p>@T["No items yet."]</p>
            }
            else if (VisibleItems.Count == 0)
            {
                <p class="empty-hint">@T["Nothing here matches that. The rest of the warehouse is still there - clear the filter to see it."]</p>
            }
            else
            {
                @if (_filter.IsActive)
                {
                    @* Said out loud so nobody saves a warehouse thinking the rows they cannot see are gone. *@
                    <p class="empty-hint">@T.Format("Showing {0} of {1} items. Saving keeps all of them.", VisibleItems.Count, _formModel.Items.Count)</p>
                }
                @foreach (var item in VisibleItems)
                {
                    <div class="editor-item @(_itemOrder.IsDragging(item) ? "dragging" : "")" @key="item"
                         @ondragover:preventDefault="true" @ondrop="() => DropItemOn(item)">
                        @* Name and the two numbers that decide whether it needs restocking stay on the
                           row; everything else waits behind the toggle so a full warehouse is readable. *@
                        <div class="editor-item-summary">
                            @* Only the handle is draggable: a row full of boxes would otherwise start a
                               drag whenever somebody selected what they had typed. *@
                            <span class="drag-handle" draggable="true" title="@(T["Drag to reorder"])"
                                  aria-label="@(T["Drag to reorder"])"
                                  @ondragstart="() => _itemOrder.Start(item)" @ondragend="_itemOrder.Finish">
                                <svg width="12" height="16" viewBox="0 0 12 16" fill="currentColor" aria-hidden="true">
                                    <circle cx="4" cy="4" r="1.3" /><circle cx="8" cy="4" r="1.3" />
                                    <circle cx="4" cy="8" r="1.3" /><circle cx="8" cy="8" r="1.3" />
                                    <circle cx="4" cy="12" r="1.3" /><circle cx="8" cy="12" r="1.3" />
                                </svg>
                            </span>
                            @* Reassigned on every row, so it holds the last one by the time the loop
                               ends - which is the row Add item just appended. *@
                            <InputText class="editor-item-main" @ref="_lastItemName"
                                       placeholder="@(T["Item name"])" @bind-Value="item.Name" />
                            <span class="editor-item-aside">
                                @if (NeedsRestocking(item))
                                {
                                    <span class="item-warning" title="@(T["There is less of this than the minimum you set"])">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20"
                                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                             role="img" aria-label="@(T["Running low"])">
                                            <path d="M10 2.8 18.2 17H1.8L10 2.8Z" />
                                            <path d="M10 8v3.6" />
                                            <path d="M10 14.2h.01" />
                                        </svg>
                                    </span>
                                }
                                <label title="@(T["How much of it there is"])">
                                    @T["Amount"]
                                    <InputNumber TValue="decimal" @bind-Value="item.Quantity" step="0.01" />
                                </label>
                                <label title="@(T["Restock once the amount drops below this"])">
                                    @T["Min"]
                                    <InputNumber TValue="decimal?" @bind-Value="item.MinimumQuantity" step="0.01" />
                                </label>
                                @* Beside the numbers it qualifies rather than behind the toggle with the
                                   rest: "2" and "2 kg" are different amounts, and the second one is the
                                   one somebody stocking a shelf can act on. *@
                                <label title="@(T["What this is counted in"])">
                                    @T["Unit"]
                                    <select class="editor-item-unit" @bind="item.Unit" aria-label="@(T["Unit"])">
                                        @foreach (var option in InventoryUnitOption.All)
                                        {
                                            <option value="@option.Value" title="@T[option.Name]">@T[option.ShortName]</option>
                                        }
                                    </select>
                                </label>
                                <button type="button" class="editor-item-toggle @(IsExpanded(item) ? "open" : "")"
                                        title="@(IsExpanded(item) ? T["Hide this item's other settings"] : T["Show this item's other settings"])"
                                        aria-expanded="@(IsExpanded(item) ? "true" : "false")"
                                        @onclick="() => ToggleExpanded(item)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
                                </button>
                                <button type="button" class="btn-secondary" @onclick="() => RemoveItem(item)">@T["Remove"]</button>
                            </span>
                        </div>

                        @if (IsExpanded(item))
                        {
                            <div class="editor-item-details">
                                <label>@T["Product type"]<InputText placeholder="@(T["Product type"])" @bind-Value="item.ProductType" />
                                </label>
                                <label>@T["Category"]<InputText placeholder="@(T["Category"])" @bind-Value="item.Category" />
                                </label>
                                <label>@T["Expires"]<DateField @bind-Value="item.ExpiryDate" AriaLabel="@(T["Expires"])" />
                                </label>
                                <label>@T["Expiry notification"]<select @bind="item.ExpiryNotificationChannel">
                                        @foreach (var option in NotificationChannelOption.All)
                                        {
                                            <option value="@option.Value" disabled="@option.IsDisabledBy(_notificationSettings)">@T[option.Label]</option>
                                        }
                                    </select>
                                </label>
                            </div>
                        }
                    </div>
                }
            }

            @* The form's only submit button, and so the one Enter presses - see the EditForm above. *@
            <button type="submit" class="btn-secondary">@T["Add item"]</button>

            @if (_saveErrorMessage is not null)
            {
                <p class="error">@_saveErrorMessage</p>
            }
            <div class="form-actions">
                <button type="button" class="btn-primary" @onclick="SaveAsync">@T["Save"]</button>
                <button type="button" class="btn-secondary" @onclick="GoToWarehouses">@T["Cancel"]</button>
            </div>
        </fieldset>
    </EditForm>

    @if (!_formModel.IsPrivate)
    {
        <h2>@T["Link"]</h2>
        <ShareLinkButton ItemType="Warehouse" ItemId="WarehouseId" />
    }
}

@code {
    [Parameter]
    public Guid WarehouseId { get; set; }

    private bool _isLoading = true;

    /// <summary>
    /// Which item currently has its extra fields open, if any - one at a time, mirroring TaskEditor:
    /// folding them away only helps while the list stays short.
    /// </summary>
    private WarehouseItemFormModel? _expandedItem;
    private bool _isSaving;
    private WarehouseFormModel _formModel = new();

    /// <summary>The row being dragged to a new place on the shelf, while one is - see DragReordering.</summary>
    private readonly DragReordering<WarehouseItemFormModel> _itemOrder = new();

    /// <summary>What the reader has narrowed the shelf down to. Never touches what is saved - see ItemFilter.</summary>
    private readonly ItemFilter _filter = new();
    private string? _saveErrorMessage;

    private bool _isShared;
    private string? _sharedByUserName;
    private SharedItemAccess _access = new(IsShared: false, ShareAccessLevel.CanEdit);

    /// <summary>A read-only or share-only grant can look but not touch, so the whole form is disabled.</summary>
    private bool _isReadOnly;

    private string? _lockedByUserName;
    private PeriodicTimer? _lockHeartbeatTimer;
    private CancellationTokenSource? _lockHeartbeatCancellation;
    private static readonly TimeSpan LockHeartbeatInterval = TimeSpan.FromSeconds(20);

    private NotificationSettingsDto _notificationSettings = new(true, true, true, true, true, BannerVisibleSeconds: 5, BannerMinimumGapSeconds: 5);

    private string SharedAccessDescription => T[_access.Description];

    protected override async Task OnInitializedAsync()
    {
        // Best-effort: gates which notification-channel options are selectable (see
        // NotificationChannelOption.IsDisabledBy) - a failure here just leaves every option enabled
        // rather than blocking the rest of the page from loading.
        try
        {
            _notificationSettings = await NotificationsApiClient.GetSettingsAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to load notification settings");
        }

        try
        {
            var warehouse = await InventoryApiClient.GetWarehouseByIdAsync(WarehouseId);
            if (warehouse is null)
            {
                NavigationManager.NavigateTo("/inventory");
                return;
            }

            _isShared = warehouse.IsShared;
            _sharedByUserName = warehouse.SharedByUserName;
            _access = SharedItemAccess.For(warehouse.IsShared, warehouse.AccessLevel);
            _isReadOnly = !_access.CanEdit;

            var items = await InventoryApiClient.GetInventoryItemsAsync(WarehouseId) ?? [];
            _formModel = WarehouseFormModel.FromDto(warehouse, items);

            if (!_isReadOnly)
            {
                await AcquireLockAsync();
                if (_lockedByUserName is null)
                {
                    StartLockHeartbeat();
                }
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        _isLoading = false;
    }

    /// <summary>A new row opens straight to its fields - there is nothing to recognise it by yet.</summary>
    /// <summary>
    /// The rows on screen. Only ever a view: <see cref="WarehouseFormModel.Items"/> stays the list that
    /// is saved, so narrowing the shelf cannot delete what it hides.
    /// </summary>
    private IReadOnlyList<WarehouseItemFormModel> VisibleItems
        => [.. _formModel.Items.Where(_filter.Matches)];

    /// <summary>The types actually on this shelf - a filter offering one nothing is filed under is a dead end.</summary>
    private IReadOnlyList<string> ProductTypesOnTheShelf => DistinctValues(item => item.ProductType);

    private IReadOnlyList<string> CategoriesOnTheShelf => DistinctValues(item => item.Category);

    private IReadOnlyList<string> DistinctValues(Func<WarehouseItemFormModel, string> of)
        => [.. _formModel.Items
            .Select(item => of(item).Trim())
            .Where(value => value.Length > 0)
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase)];

    private void ClearFilters() => _filter.Clear();

    /// <summary>
    /// Which rows the reader wants to see. The two together because they are chosen together, cleared
    /// together, and mean nothing apart - see the "grouping variables into objects" rule.
    /// </summary>
    private sealed class ItemFilter
    {
        /// <summary>Empty means "any", which is what an untouched filter says.</summary>
        public string ProductType { get; set; } = string.Empty;

        public string Category { get; set; } = string.Empty;

        /// <summary>
        /// What the reader is looking for by name. Matched anywhere in the name rather than from the
        /// start: a shelf holds "Flour, wheat" and "Wholemeal flour", and somebody typing "flour" means
        /// both. The type and the category are picked from what is there, so they match exactly; this
        /// one is typed, so it cannot.
        /// </summary>
        public string Name { get; set; } = string.Empty;

        public bool IsActive => ProductType.Length > 0 || Category.Length > 0 || Name.Trim().Length > 0;

        public void Clear()
        {
            ProductType = string.Empty;
            Category = string.Empty;
            Name = string.Empty;
        }

        public bool Matches(WarehouseItemFormModel item)
            => Matches(ProductType, item.ProductType)
                && Matches(Category, item.Category)
                && Contains(Name, item.Name);

        private static bool Matches(string chosen, string itemValue)
            => chosen.Length == 0 || string.Equals(chosen, itemValue.Trim(), StringComparison.CurrentCultureIgnoreCase);

        private static bool Contains(string typed, string itemName)
            => typed.Trim() is not { Length: > 0 } wanted
                || itemName.Contains(wanted, StringComparison.CurrentCultureIgnoreCase);
    }

    private void AddItem()
    {
        // A row added while the shelf is narrowed would be filed under nothing and hidden the moment it
        // appeared, so the filter steps aside for it.
        _filter.Clear();
        var item = new WarehouseItemFormModel();
        _formModel.Items.Add(item);
        _expandedItem = item;
        _isWaitingToFocusTheNewItem = true;
    }

    /// <summary>
    /// The name box of the last row on the form - see where it is assigned. Held so a row added with
    /// Enter can be typed into straight away, which is the whole point of adding it that way.
    /// </summary>
    private InputText? _lastItemName;
    private bool _isWaitingToFocusTheNewItem;

    /// <summary>Focuses the row Add item just appended, once it has actually been rendered.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isWaitingToFocusTheNewItem || _lastItemName?.Element is not { } element)
        {
            return;
        }

        _isWaitingToFocusTheNewItem = false;
        try
        {
            await element.FocusAsync();
        }
        catch (JSException)
        {
            // The row is there either way; the cursor just stays where it was.
        }
    }

    /// <summary>
    /// The same condition InventoryItem.IsBelowMinimum uses to raise the restock task, said out loud
    /// while someone is looking at the row rather than only after a background service has been round.
    /// Kept identical on purpose: a warning that appeared one step earlier than the task would leave an
    /// item flagged with nothing having been raised for it, which reads as the app disagreeing with
    /// itself.
    /// </summary>
    private static bool NeedsRestocking(WarehouseItemFormModel item)
        => item.MinimumQuantity is { } minimum && item.Quantity < minimum;

    private bool IsExpanded(WarehouseItemFormModel item) => ReferenceEquals(_expandedItem, item);

    private void ToggleExpanded(WarehouseItemFormModel item) => _expandedItem = IsExpanded(item) ? null : item;

    /// <summary>
    /// Where an item was dropped is where it belongs: the shelf is saved in the order it is written in
    /// - see InventoryItem.Position - so arranging it here is the order it is read back in.
    /// </summary>
    private void DropItemOn(WarehouseItemFormModel target)
    {
        _itemOrder.DropOn(_formModel.Items, target);
        _itemOrder.Finish();
    }

    private void RemoveItem(WarehouseItemFormModel item)
    {
        if (IsExpanded(item))
        {
            _expandedItem = null;
        }

        _formModel.Items.Remove(item);
    }

    private void GoToWarehouses() => NavigationManager.NavigateTo("/inventory");

    private async Task SaveAsync()
    {
        _saveErrorMessage = null;
        _isSaving = true;
        try
        {
            var outcome = await InventoryApiClient.UpdateWarehouseAsync(WarehouseId, _formModel.ToRequest());
            if (outcome.Kind == EditOutcomeKind.Locked)
            {
                _lockedByUserName = outcome.LockedByUserName;
                return;
            }

            if (outcome.Kind == EditOutcomeKind.NotFound)
            {
                _saveErrorMessage = T["Failed to save the warehouse. Try again."];
                return;
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to save warehouse {WarehouseId}", WarehouseId);
            _saveErrorMessage = T["Failed to save the warehouse. Try again."];
            return;
        }
        finally
        {
            _isSaving = false;
        }

        NavigationManager.NavigateTo("/inventory");
    }

    private async Task AcquireLockAsync()
    {
        try
        {
            var outcome = await InventoryApiClient.AcquireWarehouseLockAsync(WarehouseId);
            _lockedByUserName = outcome.Kind == EditOutcomeKind.Locked ? outcome.LockedByUserName : null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    /// <summary>Mirrors TaskEditor's method of the same name - see its comment.</summary>
    private async Task ReleaseLockAsync()
    {
        StopLockHeartbeat();
        if (_isReadOnly)
        {
            return;
        }

        try
        {
            await InventoryApiClient.ReleaseWarehouseLockAsync(WarehouseId);
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartLockHeartbeat()
    {
        _lockHeartbeatCancellation = new CancellationTokenSource();
        _lockHeartbeatTimer = new PeriodicTimer(LockHeartbeatInterval);
        _ = LockHeartbeatLoopAsync(_lockHeartbeatCancellation.Token);
    }

    private void StopLockHeartbeat()
    {
        _lockHeartbeatCancellation?.Cancel();
        _lockHeartbeatCancellation?.Dispose();
        _lockHeartbeatCancellation = null;
        _lockHeartbeatTimer?.Dispose();
        _lockHeartbeatTimer = null;
    }

    private async Task LockHeartbeatLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _lockHeartbeatTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await AcquireLockAsync();
                StateHasChanged();
                if (_lockedByUserName is not null)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public async ValueTask DisposeAsync() => await ReleaseLockAsync();

    private sealed class WarehouseFormModel
    {
        public string Name { get; set; } = string.Empty;
        public List<WarehouseItemFormModel> Items { get; set; } = [];

        /// <summary>Encrypt this warehouse so only its owner can read it - see PrivateContentSealer.</summary>
        public bool IsPrivate { get; set; }

        public static WarehouseFormModel FromDto(WarehouseDto warehouse, IReadOnlyList<InventoryItemDto> items)
            => new()
            {
                Name = warehouse.Name,
                IsPrivate = warehouse.IsPrivate,
                Items = items
                    .Select(item => new WarehouseItemFormModel
                    {
                        Id = item.Id,
                        Name = item.Name,
                        ProductType = item.ProductType,
                        Category = item.Category,
                        Quantity = item.Quantity,
                        MinimumQuantity = item.MinimumQuantity,
                        // Read through the option list rather than taken as it comes: a private warehouse
                        // sealed before units existed has none, and the picker would then show pieces
                        // while the row held nothing - see InventoryUnitOption.For.
                        Unit = InventoryUnitOption.For(item.Unit).Value,
                        ExpiryDate = item.ExpiryDate is { } expiryDate ? DateOnly.FromDateTime(expiryDate.LocalDateTime) : null,
                        ExpiryNotificationChannel = item.ExpiryNotificationChannel
                    })
                    .ToList()
            };

        public SaveWarehouseRequest ToRequest()
            => new(
                Name,
                Items
                    .Select(item => new WarehouseItemDto(
                        item.Id, item.Name, item.ProductType, item.Category, item.Quantity, item.MinimumQuantity,
                        item.Unit, ToExpiryDateUtc(item), item.ExpiryNotificationChannel))
                    .ToList(),
                IsPrivate);

        /// <summary>
        /// Npgsql only accepts a DateTimeOffset with Offset=0 for a "timestamp with time zone" column, so
        /// the picked local date is converted to its equivalent UTC instant rather than just re-labeled.
        /// </summary>
        private static DateTimeOffset? ToExpiryDateUtc(WarehouseItemFormModel item)
        {
            if (item.ExpiryDate is not { } expiryDate)
            {
                return null;
            }

            var localMidnight = expiryDate.ToDateTime(TimeOnly.MinValue);
            return new DateTimeOffset(localMidnight, TimeZoneInfo.Local.GetUtcOffset(localMidnight)).ToUniversalTime();
        }
    }

    /// <summary>One editable row. Id is null for a row the user just added - see WarehouseItemDto.</summary>
    private sealed class WarehouseItemFormModel
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string ProductType { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal? MinimumQuantity { get; set; }

        /// <summary>What the two amounts above are counted in - see InventoryUnitOption.</summary>
        public string Unit { get; set; } = InventoryUnitOption.Default.Value;

        public DateOnly? ExpiryDate { get; set; }
        public string ExpiryNotificationChannel { get; set; } = "Push";
    }
}
