@page "/s/{Token}"
@using Orbit.Core.Abstractions
@using Orbit.Core.Notes
@using Orbit.Contracts.Sharing
@using Orbit.Web.Services
@inject PublicShareApiClient PublicShareApiClient
@inject NavigationManager NavigationManager
@inject ILogger<SharedItemPage> Logger
@inject Translations T

<PageTitle>@(_item is null ? T["Orbit — Shared"] : $"Orbit — {_item.Title}")</PageTitle>

@* Deliberately has no [Authorize]: this is the one page a reader with no account is meant to reach.
   Everything it shows comes from PublicSharedItem, which is a projection rather than the item itself -
   see its class comment for what is left out on purpose. *@
<div class="shared-item-page">
    @if (_isLoading)
    {
        <Loading />
    }
    else if (_item is null)
    {
        <div class="card shared-item-card">
            <h1>@T["This link doesn't work"]</h1>
            <p class="page-subtitle">
                @T["It may have been turned off by whoever shared it, or the thing it pointed at may be gone. Ask them for a new one."]
            </p>
        </div>
    }
    else if (_item.Items is { } inside)
    {
        @* A folder: the folder's own card saying what it is and whose, then one card per thing filed
           under it - each drawn exactly as its own link would draw it. What is sealed and what has been
           put away are not here at all; the server leaves them out (see PublicSharedItemReader). *@
        <SharedItemCard Item="_item" Token="@Token" OwnerDisplayName="@_item.OwnerDisplayName" />
        @foreach (var thing in inside)
        {
            <SharedItemCard Item="thing" Token="@Token" />
        }
        <div class="card shared-item-card">
            @* No "Save to my account" here. There is no such thing as a share of a folder - it stays
               the owner's own tab - and the button's promise is one read-only copy, where a folder
               would hand over a page of them, unfiled. Being given the folder in Orbit is the other
               half of what sharing one means, and is what this points at. *@
            <p class="page-subtitle">@T["To keep what is in here, ask them to share the folder with you in Orbit."]</p>
        </div>
    }
    else
    {
        <SharedItemCard Item="_item" Token="@Token" OwnerDisplayName="@_item.OwnerDisplayName">
            <div class="shared-item-footer">
                @if (_claimMessage is not null)
                {
                    <p class="shared-item-claimed">@_claimMessage</p>
                }
                else
                {
                    <AuthorizeView>
                        <Authorized>
                            <span class="field-with-note">
                                <button type="button" class="btn-primary" disabled="@_isClaiming" @onclick="ClaimAsync">@T["Save to my account"]</button>
                                <FieldHint>@T["You'll get your own read-only copy. Nothing you do changes theirs."]</FieldHint>
                            </span>
                        </Authorized>
                        <NotAuthorized>
                            <span class="field-with-note">
                                <button type="button" class="btn-primary" @onclick="SignInToClaim">@T["Sign in to save this"]</button>
                                <FieldHint>@T["Reading needs no account. Saving it to your own does."]</FieldHint>
                            </span>
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </div>
        </SharedItemCard>
    }
</div>
@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private PublicSharedItemDto? _item;
    private bool _isLoading = true;
    private bool _isClaiming;
    private string? _claimMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        try
        {
            _item = await PublicShareApiClient.ReadAsync(Token);
        }
        catch (HttpRequestException exception)
        {
            // Every way a link can fail already reads as one message, and a network failure is another
            // way of not being able to show it.
            Logger.LogWarning(exception, "Failed to read a shared item");
            _item = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>Comes back here afterwards rather than landing on the dashboard - see Login.DestinationAfterLogin.</summary>
    private void SignInToClaim()
        => NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/s/{Token}")}");

    private async Task ClaimAsync()
    {
        _isClaiming = true;
        try
        {
            var result = await PublicShareApiClient.ClaimAsync(Token);
            _claimMessage = result is null
                ? T["Couldn't save it. The link may have been turned off."]
                : result.AlreadyHeld
                    ? T["You already have this."]
                    : T["Saved. It's in your account now."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to claim a shared item");
            _claimMessage = T["Couldn't save it. Try again."];
        }
        finally
        {
            _isClaiming = false;
        }
    }

}
