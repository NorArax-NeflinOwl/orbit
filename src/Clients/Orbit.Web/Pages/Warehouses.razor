@page "/inventory"
@attribute [Authorize]
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Inventory
@using Orbit.Core.Inventory
@using Orbit.Web.Services
@inject InventoryApiClient InventoryApiClient
@inject ChatApiClient ChatApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Warehouses> Logger
@inject Translations T
@inject WarehouseArrangement Arrangement

<PageTitle>@T["Orbit — Inventory"]</PageTitle>

<PageHeader>
    <LeadingAction>
        <button type="button" class="icon-btn page-add" title="@(T["Add warehouse"])"
                aria-label="@(T["Add warehouse"])" @onclick="StartCreating">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
        </button>
    </LeadingAction>
    <Title>@T["Inventory"]</Title>
</PageHeader>

@if (_isCreating)
{
    <div class="card warehouse-create-row">
        <input id="newWarehouseNameInput" placeholder="@(T["Warehouse name"])" @bind="_newWarehouseName" @bind:event="oninput"
               @onkeydown="OnNewWarehouseKeyDownAsync" />
        <button class="btn-primary" disabled="@(_isSaving || _newWarehouseName.Trim().Length == 0)" @onclick="CreateWarehouseAsync">@T["Create"]</button>
        <button class="btn-secondary" @onclick="CancelCreating">@T["Cancel"]</button>
    </div>
}

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

@* "Which warehouse is the flour in?" - the one question this page could not answer, since it lists
   shelves and not what is on them. Searching one warehouse at a time is the editor's own box; this is
   the level above it. *@
@if (_warehouses is { Count: > 0 })
{
    <div class="warehouse-search">
        <input type="search" @bind="_itemSearch" @bind:event="oninput" @bind:after="SearchForItemsAsync"
               placeholder="@(T["Find an item in any warehouse"])"
               aria-label="@(T["Find an item in any warehouse"])" />
        @if (_itemSearch.Trim().Length > 0)
        {
            <button type="button" class="btn-secondary" @onclick="ClearItemSearchAsync">@T["Clear"]</button>
        }
    </div>
}

@if (_itemSearch.Trim().Length > 0)
{
    @if (_isSearchingItems)
    {
        <p>@T["Looking through your warehouses…"]</p>
    }
    else if (_itemMatches.Count == 0)
    {
        <p class="empty-hint">@T["Nothing on any shelf matches that."]</p>
    }
    else
    {
        <div class="card warehouse-search-results">
            @* Where it is comes second on the row and is the point of the whole search, so it is the
               part that is a link: the name only says what was found. *@
            @foreach (var match in _itemMatches)
            {
                <button type="button" class="list-row list-row-button" @onclick="() => OpenWarehouse(match.WarehouseId)">
                    <span class="row-title">@match.Name</span>
                    <span class="row-meta">@match.Amount</span>
                    <span class="row-meta warehouse-search-where">@match.WarehouseName</span>
                </button>
            }
        </div>
        <p class="empty-hint">@ItemMatchSummary</p>
    }
}

@if (_warehouses is null)
{
    <p>@T["Loading…"]</p>
}
else if (_warehouses.Count == 0)
{
    <p>@T["No warehouses yet. Create one to start tracking stock."]</p>
}
else
{
    <div class="item-card-list">
        @foreach (var warehouse in ArrangedWarehouses)
        {
            <div @key="warehouse.Id" class="@(_cardOrder.IsDragging(warehouse) ? "dragging" : "")"
                 @ondragover:preventDefault="true" @ondrop="() => DropCardOnAsync(warehouse)">
                <ItemCard Name="@warehouse.Name" OnNameSelected="() => OpenWarehouse(warehouse.Id)">
                    <Handle>
                        <ReorderControls OnDragStart="() => _cardOrder.Start(warehouse)" OnDragEnd="_cardOrder.Finish"
                                         OnMoveUp="() => MoveCardAsync(warehouse, -1)"
                                         OnMoveDown="() => MoveCardAsync(warehouse, 1)"
                                         CanMoveUp="CanMoveCard(warehouse, -1)" CanMoveDown="CanMoveCard(warehouse, 1)" />
                    </Handle>
                    <Menu>
                        <OverflowMenu>
                            @* The card opens the shelf to be read; changing what is on it is a named
                               press, the same as a task list's. *@
                            <button type="button" class="avatar-dropdown-item"
                                    @onclick="() => EditWarehouse(warehouse.Id)">@T["Edit"]</button>
                            @if (CanShare(warehouse))
                            {
                                <button type="button" class="avatar-dropdown-item" @onclick="() => ToggleSharePanel(warehouse.Id)">@T["Share"]</button>
                            }
                            @if (!warehouse.IsShared)
                            {
                                <button type="button" class="avatar-dropdown-item" @onclick="() => DeleteWarehouseAsync(warehouse)">@T["Delete"]</button>
                            }
                        </OverflowMenu>
                    </Menu>
                    <Tags>
                        @if (warehouse.IsPrivate)
                        {
                            <span class="card-badge" title="@(T["Private - encrypted, and only you can read it"])">@T["Private"]</span>
                        }
                        @if (warehouse.IsShared)
                        {
                            <span class="card-badge">@T.Format("Shared by {0} · {1}", warehouse.SharedByUserName, AccessDescription(warehouse.AccessLevel))</span>
                        }
                        @if (warehouse.LockedByUserName is { } lockedBy)
                        {
                            <span class="card-badge">@T.Format("{0} is editing it right now", lockedBy)</span>
                        }
                    </Tags>
                    <Body>
                @if (_sharePanelWarehouseId == warehouse.Id)
                {
                    <div class="warehouse-share-panel">
                        @if (ShareableContacts(warehouse).Count == 0)
                        {
                            <p>@T["No contacts to share with yet - start a conversation first."]</p>
                        }
                        else
                        {
                            <select id="shareContactSelect" @bind="_selectedContactUserId">
                                <option value="">@T["-- select a contact --"]</option>
                                @foreach (var contact in ShareableContacts(warehouse))
                                {
                                    <option value="@contact.UserId">@contact.DisplayName (@contact.Email)</option>
                                }
                            </select>
                            <select id="shareAccessLevelSelect" @bind="_selectedAccessLevel">
                                <option value="ReadOnly">@T["Read-only"]</option>
                                <option value="Share">@T["Can share"]</option>
                                @if (CanGrantEditOnly(warehouse))
                                {
                                    <option value="EditOnly">@T["Can edit, but not share editing"]</option>
                                }
                                @if (CanGrantCanEdit(warehouse))
                                {
                                    <option value="CanEdit">@T["Can edit"]</option>
                                }
                            </select>
                            <button id="shareWarehouseButton" class="btn-primary" disabled="@_isSharing"
                                    @onclick="() => ShareAsync(warehouse)">@T["Share"]</button>
                        }
                        @if (_shareErrorMessage is not null)
                        {
                            <p class="error">@_shareErrorMessage</p>
                        }
                        @if (_shareInfoMessage is not null)
                        {
                            <p class="info">@_shareInfoMessage</p>
                        }
                    </div>
                }
                    </Body>
                </ItemCard>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<WarehouseDto>? _warehouses;
    private IReadOnlyList<ContactDto> _contacts = [];
    private Guid _ownUserId;
    private string? _errorMessage;

    /// <summary>What the reader is looking for across every warehouse, and what was found.</summary>
    private string _itemSearch = string.Empty;
    private bool _isSearchingItems;
    private IReadOnlyList<ItemMatch> _itemMatches = [];

    /// <summary>
    /// Every warehouse's items, read once and kept for as long as the page is open - a search narrows
    /// as it is typed, and fetching a whole account's stock per keystroke would be a request storm.
    /// Null until the first search: opening this page to look at the shelves should cost nothing extra.
    /// </summary>
    private IReadOnlyList<ItemMatch>? _everythingOnEveryShelf;

    /// <summary>
    /// Warehouses whose contents could not be read, if any. Named rather than skipped: a search that
    /// quietly leaves one out answers "it is nowhere" when the truth is "I could not look there".
    /// </summary>
    private IReadOnlyList<string> _unreadableWarehouses = [];

    /// <summary>One thing found, and where it is.</summary>
    /// <param name="Amount">Already written for reading - see AmountOf.</param>
    private sealed record ItemMatch(Guid WarehouseId, string WarehouseName, string Name, string Amount);

    private bool _isCreating;
    private string _newWarehouseName = string.Empty;
    private bool _isSaving;

    /// <summary>Which warehouse's inline share panel is open, if any - only one at a time.</summary>
    private Guid? _sharePanelWarehouseId;

    private string _selectedContactUserId = string.Empty;
    private string _selectedAccessLevel = "ReadOnly";
    private bool _isSharing;
    private string? _shareErrorMessage;
    private string? _shareInfoMessage;

    protected override async Task OnInitializedAsync()
    {
        await Arrangement.InitializeAsync();
        var currentUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        _ownUserId = currentUserId.Value;

        try
        {
            _warehouses = await InventoryApiClient.GetWarehousesAsync();
            _contacts = await ChatApiClient.GetContactsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load warehouses");
            _errorMessage = T["Couldn't load your warehouses. Check your connection and try again."];
            _warehouses = [];
        }
    }

    /// <summary>
    /// Keeps the warehouse's true owner out of a re-sharer's recipient picker - sharing back to them is
    /// always rejected server-side (see ShareWarehouseCommandHandler), so offering the option would only
    /// ever produce an error. Mirrors NoteEditor's _shareableContacts.
    /// </summary>
    private IReadOnlyList<ContactDto> ShareableContacts(WarehouseDto warehouse)
        => warehouse.OriginalOwnerUserId is { } ownerUserId
            ? _contacts.Where(contact => contact.UserId != ownerUserId).ToList()
            : _contacts;

    /// <summary>Mirrors ShareWarehouseCommandHandler's own rule, so the button isn't offered for a share that would be rejected.</summary>
    /// <summary>
    /// A private warehouse can never be shared - the server refuses it, so offering the button would
    /// only lead to a refusal. Matches the same rule for notes and task lists.
    /// </summary>
    private static bool CanShare(WarehouseDto warehouse)
        => !warehouse.IsPrivate && SharedItemAccess.For(warehouse.IsShared, warehouse.AccessLevel).CanShare;

    /// <summary>A re-share can never grant more than the re-sharer holds - again matching the server.</summary>
    private static bool CanGrantCanEdit(WarehouseDto warehouse)
        => SharedItemAccess.For(warehouse.IsShared, warehouse.AccessLevel).CanGrantCanEdit;

    /// <summary>An EditOnly holder can pass on neither this nor CanEdit - see ShareAccess.CanGrant.</summary>
    private static bool CanGrantEditOnly(WarehouseDto warehouse)
        => SharedItemAccess.For(warehouse.IsShared, warehouse.AccessLevel).CanGrantEditOnly;

    private string AccessDescription(string accessLevel)
        => T[SharedItemAccess.For(isShared: true, accessLevel).Description];

    private void StartCreating()
    {
        _isCreating = true;
        _newWarehouseName = string.Empty;
    }

    private void CancelCreating()
    {
        _isCreating = false;
        _newWarehouseName = string.Empty;
    }

    private async Task OnNewWarehouseKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && _newWarehouseName.Trim().Length > 0)
        {
            await CreateWarehouseAsync();
        }
    }

    private async Task CreateWarehouseAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        try
        {
            await InventoryApiClient.CreateWarehouseAsync(new SaveWarehouseRequest(_newWarehouseName.Trim(), []));
            _warehouses = await InventoryApiClient.GetWarehousesAsync();
            CancelCreating();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to create a warehouse");
            _errorMessage = T["Failed to create the warehouse. Try again."];
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenWarehouse(Guid warehouseId) => NavigationManager.NavigateTo($"/inventory/{warehouseId}");

    private void EditWarehouse(Guid warehouseId) => NavigationManager.NavigateTo($"/inventory/{warehouseId}/edit");

    /// <summary>
    /// Answers "which warehouse is this in". Read here rather than asked of the server, because a
    /// private warehouse keeps no item rows there at all - its stock is sealed and only this browser
    /// holds the key (see InventoryApiClient.GetInventoryItemsAsync). A server-side search would leave
    /// those shelves out and call it "nowhere", which is worse than not offering the search.
    /// </summary>
    private async Task SearchForItemsAsync()
    {
        if (_itemSearch.Trim() is not { Length: > 0 } wanted)
        {
            _itemMatches = [];
            return;
        }

        _isSearchingItems = true;
        try
        {
            _everythingOnEveryShelf ??= await ReadEveryShelfAsync();
        }
        finally
        {
            _isSearchingItems = false;
        }

        // Matched anywhere in the name and without case, the same as the editor's own box: a shelf holds
        // "Flour, wheat" and somebody typing "flour" means it.
        _itemMatches = [.. _everythingOnEveryShelf
            .Where(item => item.Name.Contains(wanted, StringComparison.CurrentCultureIgnoreCase))
            .OrderBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(item => item.WarehouseName, StringComparer.CurrentCultureIgnoreCase)];
    }

    private async Task ClearItemSearchAsync()
    {
        _itemSearch = string.Empty;
        await SearchForItemsAsync();
    }

    /// <summary>
    /// Everything in every warehouse, flattened to what a result row needs. A warehouse that will not
    /// open is remembered by name rather than dropped - see _unreadableWarehouses.
    /// </summary>
    private async Task<IReadOnlyList<ItemMatch>> ReadEveryShelfAsync()
    {
        var everything = new List<ItemMatch>();
        var unreadable = new List<string>();
        foreach (var warehouse in _warehouses ?? [])
        {
            try
            {
                var items = await InventoryApiClient.GetInventoryItemsAsync(warehouse.Id) ?? [];
                everything.AddRange(items.Select(item => new ItemMatch(
                    warehouse.Id, warehouse.Name, item.Name, AmountOf(item))));
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Couldn't read warehouse {WarehouseId} while searching", warehouse.Id);
                unreadable.Add(warehouse.Name);
            }
        }

        _unreadableWarehouses = unreadable;
        return everything;
    }

    /// <summary>
    /// How much of it there is. The unit is left off for something counted one by one - "2" of a thing
    /// already means two of them - which is the rule a restock errand is written by too.
    /// </summary>
    private string AmountOf(InventoryItemDto item)
    {
        var unit = InventoryUnitOption.For(item.Unit);
        var amount = item.Quantity.ToString("0.##", CultureInfo.InvariantCulture);
        return unit.Value == nameof(InventoryUnit.Piece) ? amount : $"{amount} {T[unit.ShortName]}";
    }

    /// <summary>
    /// What was found, and - when a shelf could not be opened - that the answer is short of those.
    /// Saying only the count would let "nothing found" stand for "I could not look".
    /// </summary>
    private string ItemMatchSummary
        => _unreadableWarehouses.Count == 0
            ? T.Format("Found in {0} of {1} warehouses.", WarehousesMatched, (_warehouses ?? []).Count)
            : T.Format(
                "Found in {0} of {1} warehouses. These could not be opened, so nothing in them was searched: {2}",
                WarehousesMatched, (_warehouses ?? []).Count, string.Join(", ", _unreadableWarehouses));

    private int WarehousesMatched => _itemMatches.Select(match => match.WarehouseId).Distinct().Count();

    private void ToggleSharePanel(Guid warehouseId)
    {
        _sharePanelWarehouseId = _sharePanelWarehouseId == warehouseId ? null : warehouseId;
        _selectedContactUserId = string.Empty;
        _selectedAccessLevel = "ReadOnly";
        _shareErrorMessage = null;
        _shareInfoMessage = null;
    }

    /// <summary>
    /// Creates the share server-side, then notifies the recipient with an encrypted chat message
    /// carrying its id - exactly the flow NoteEditor.razor uses, so a warehouse share shows up in Chat
    /// with an "Accept" button like every other kind of share.
    /// </summary>
    private async Task ShareAsync(WarehouseDto warehouse)
    {
        if (!Guid.TryParse(_selectedContactUserId, out var recipientUserId))
        {
            return;
        }

        _shareErrorMessage = null;
        _shareInfoMessage = null;
        _isSharing = true;
        try
        {
            var result = await InventoryApiClient.ShareWarehouseAsync(warehouse.Id, recipientUserId, _selectedAccessLevel);
            if (result is null)
            {
                _shareErrorMessage = T["Failed to share the warehouse."];
                return;
            }

            var payloadJson = JsonSerializer.Serialize(new WarehouseShareMessagePayload(result.ShareId, warehouse.Name));
            await EncryptedChatMessageSender.SendAsync(_ownUserId, recipientUserId, payloadJson, isShareInvitation: true);
            _shareInfoMessage = result.AlreadyShared
                ? T["Already shared with that contact - sent a reminder."]
                : T["Shared - they'll see it in your chat."];
            _selectedContactUserId = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Failed to share warehouse {WarehouseId} with user {RecipientUserId}", warehouse.Id, recipientUserId);
            _shareErrorMessage = T["Failed to share the warehouse."];
        }
        finally
        {
            _isSharing = false;
        }
    }

    /// <summary>The warehouses in the order this reader put them - see WarehouseArrangement.</summary>
    private IReadOnlyList<WarehouseDto> ArrangedWarehouses
        => [.. Arrangement.Arrange(_warehouses ?? [], warehouse => warehouse.Id)];

    /// <summary>The card being dragged to a new place, while one is - see RowArrangement.</summary>
    private readonly RowArrangement<WarehouseDto> _cardOrder = new();

    /// <summary>
    /// Where a card was dropped is where it belongs. The whole visible order is written back rather
    /// than the one card that moved: a stored order naming only what somebody had touched would leave
    /// the rest wherever they happened to fall.
    /// </summary>
    private async Task DropCardOnAsync(WarehouseDto target)
    {
        var arranged = ArrangedWarehouses.ToList();
        if (!_cardOrder.DropOn(arranged, target))
        {
            _cardOrder.Finish();
            return;
        }

        _cardOrder.Finish();
        await Arrangement.SetOrderAsync([.. arranged.Select(warehouse => warehouse.Id)]);
    }

    /// <summary>The same move a drag makes, one card at a time - what a keyboard asks for, and a finger.</summary>
    private async Task MoveCardAsync(WarehouseDto warehouse, int offset)
    {
        var arranged = ArrangedWarehouses.ToList();
        if (!RowArrangement<WarehouseDto>.Move(arranged, warehouse, offset))
        {
            return;
        }

        await Arrangement.SetOrderAsync([.. arranged.Select(existing => existing.Id)]);
    }

    private bool CanMoveCard(WarehouseDto warehouse, int offset)
        => RowArrangement<WarehouseDto>.CanMove(ArrangedWarehouses.ToList(), warehouse, offset);

    private async Task DeleteWarehouseAsync(WarehouseDto warehouse)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm", T.Format("Delete \"{0}\" and everything in it?", warehouse.Name));
        if (!confirmed)
        {
            return;
        }

        try
        {
            await InventoryApiClient.DeleteWarehouseAsync(warehouse.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete warehouse {WarehouseId}", warehouse.Id);
            _errorMessage = T["Failed to delete the warehouse. Try again."];
            return;
        }

        _warehouses = _warehouses!.Where(existing => existing.Id != warehouse.Id).ToList();
    }
}
