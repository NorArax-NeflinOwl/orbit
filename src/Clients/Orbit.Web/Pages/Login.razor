@page "/login"
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@using Orbit.Web.Services.Logging
@inject AuthApiClient AuthApiClient
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<Login> Logger
@inject Translations T

<PageTitle>Orbit — Log in</PageTitle>

@* TODO(Orbit.Web.UI): still plain unstyled <div>/<label>/<input> - and unlike the other pages, this one
   also renders with the full sidebar shell next to it if a stale-but-still-valid token is already in
   localStorage (see MainLayout's AuthorizeView), which looks odd against an unstyled form. Worth a
   dedicated centered-card auth layout (logo, card, form) using app.css's .card/.btn-primary, closer to
   what a login page usually looks like than reusing the app shell's .page-header pattern. Register.razor
   is the same story. *@
<h1>@T["Log in"]</h1>

<EditForm Model="_formModel" OnValidSubmit="SubmitAsync" class="editor-form">
    <div class="field">
        <label>@T["Email or username"]</label>
        <InputText id="emailOrUserName" @bind-Value="_formModel.EmailOrUserName" />
    </div>
    <div class="field">
        <label>@T["Password"]</label>
        <!-- InputText always renders type="text" regardless of splatted attributes, so a real masked
             password field needs a plain <input> with a manual two-way binding instead. -->
        <input type="password" id="password" @bind="_formModel.Password" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary" disabled="@_isSubmitting">@T["Log in"]</button>
    </div>
</EditForm>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<GoogleSignInButton OnCredential="SignInWithGoogleAsync" ShowDivider="true" />

<p>@T["Don't have an account? "]<a href="/register">@T["Register"]</a></p>

@code {
    /// <summary>Set by whatever sent the reader here - see DestinationAfterLogin, which is what decides whether to honour it.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginFormModel _formModel = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        AuthResult result;
        try
        {
            result = await AuthApiClient.LoginAsync(_formModel.EmailOrUserName, _formModel.Password);
        }
        catch (Exception exception)
        {
            // Covers a missing HTTP response (server unreachable, DNS failure, ...) as well as anything
            // AuthApiClient itself can't turn into an AuthOutcome - a malformed response body or a
            // client-side timeout, for instance - so a failure here always shows the same inline error
            // message instead of crashing the whole page.
            Logger.LogActionFailed(ClientActionCategory.Login, "Login", exception);
            _errorMessage = "Failed to connect to the server. Check your connection and try again.";
            _isSubmitting = false;
            return;
        }

        if (result.Outcome == AuthOutcome.Success)
        {
            Logger.LogActionCompleted(ClientActionCategory.Login, "Login");
            // Resolved before Notify, not after: Notify is what makes MainLayout's own (fire-and-forget,
            // best-effort) key-publishing attempt run, and that attempt throws EncryptionKeyLockedException
            // for a browser with no local key yet - which every fresh sign-in on a new browser is, until
            // this call finishes. Running this first means that attempt always finds a key already there.
            await TryUnlockEncryptionKeyAsync(_formModel.Password);
            AuthenticationStateProvider.NotifyAuthenticationStateChanged();
            NavigationManager.NavigateTo(DestinationAfterLogin());
            return;
        }

        _errorMessage = result.Outcome switch
        {
            AuthOutcome.InvalidCredentials => "Invalid email, username, or password.",
            _ => "An error occurred while logging in. Try again."
        };
        _isSubmitting = false;
    }

    /// <summary>
    /// Restores this browser's E2EE private key from its server-side backup, or generates a fresh one if
    /// there is none - the plaintext password needed for either is only ever available right here, right
    /// after a successful login (see OwnEncryptionKeyProvider.UnlockOrCreateAsync). Best-effort, like
    /// MainLayout's own attempt on every page load: a failure here just leaves the key unresolved until
    /// the user opens Chat.razor, which has a dedicated way to recover from that.
    /// </summary>
    private async Task TryUnlockEncryptionKeyAsync(string password)
    {
        try
        {
            await OwnEncryptionKeyProvider.UnlockOrCreateAsync(password);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to restore or publish the local E2EE key after logging in");
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "End-to-end encryption is unavailable in this browsing context");
        }
    }

    private sealed class LoginFormModel
    {
        public string EmailOrUserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    /// <summary>
    /// One handler for both signing in and registering with Google: the browser gesture is identical and
    /// the server decides whether this identity is new (see SignInWithGoogleCommandHandler).
    /// </summary>
    private async Task SignInWithGoogleAsync(string idToken)
    {
        _errorMessage = null;
        AuthResult result;
        try
        {
            result = await AuthApiClient.SignInWithGoogleAsync(idToken);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Google sign-in failed");
            _errorMessage = "Couldn't sign in with Google. Try again.";
            return;
        }

        if (result.Outcome != AuthOutcome.Success)
        {
            _errorMessage = "Couldn't sign in with Google. Try again.";
            return;
        }

        // Deliberately no UnlockOrCreateAsync here, unlike the password paths: a Google account may have
        // no password at all, so there is nothing to wrap a chat key with yet. Chat asks for one when it
        // is actually needed - see Chat.razor's password gate.
        AuthenticationStateProvider.NotifyAuthenticationStateChanged();
        NavigationManager.NavigateTo(DestinationAfterLogin());
    }

    /// <summary>
    /// Where to land after signing in. Normally the dashboard, but someone who arrived from a share link
    /// came here to do one specific thing - save that item - and dropping them on the dashboard would
    /// lose it.
    ///
    /// Only ever an in-app path: ReturnUrl arrives in the address bar, so anyone can put anything in it,
    /// and following an absolute URL from there would turn this page into a redirector someone could
    /// point at their own site from a link that genuinely starts at Orbit.
    /// </summary>
    private string DestinationAfterLogin()
    {
        var returnUrl = ReturnUrl;
        return string.IsNullOrWhiteSpace(returnUrl) || !returnUrl.StartsWith('/') || returnUrl.StartsWith("//", StringComparison.Ordinal)
            ? "/"
            : returnUrl;
    }
}
