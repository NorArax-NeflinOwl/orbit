@page "/inventory"
@implements IDisposable
@attribute [Authorize]
@using System.Globalization
@using System.Text.Json
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Inventories
@using Orbit.Core.Inventories
@using Orbit.Web.Services
@using Orbit.Core.Folders
@using Orbit.Core.Text
@inject FolderState Folders
@inject InventoryApiClient InventoryApiClient
@inject ChatApiClient ChatApiClient
@inject EncryptedChatMessageSender EncryptedChatMessageSender
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Inventories> Logger
@inject NotificationFeedState NotificationFeedState
@inject Translations T
@inject InventoryArrangement Arrangement

<PageTitle>@T["Orbit — Inventory"]</PageTitle>

<PageHeader>
    <LeadingAction>
        <button type="button" class="icon-btn page-add" title="@(T["Add inventory"])"
                aria-label="@(T["Add inventory"])" @onclick="GoToAddInventory">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
        </button>
    </LeadingAction>
    <Title>@T["Inventory"]</Title>
    <Actions>
        @* Choosing several to act on at once - see PickedThings, and Notes.razor, which carries the
           same press in the same place. *@
        @if (!_picked.IsPicking)
        {
            <button type="button" class="btn-secondary" @onclick="StartPicking">@T["Select"]</button>
        }
    </Actions>
</PageHeader>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

@* "Which inventory is the flour in?" - the one question this page could not answer, since it lists
   shelves and not what is on them. Searching one inventory at a time is the editor's own box; this is
   the level above it. *@
@if (_inventories is { Count: > 0 })
{
    <div class="inventory-search">
        <input type="search" @bind="_itemSearch" @bind:event="oninput" @bind:after="SearchForItemsAsync"
               placeholder="@(T["Find an item in any inventory"])"
               aria-label="@(T["Find an item in any inventory"])" />
        @if (_itemSearch.Trim().Length > 0)
        {
            <button type="button" class="btn-secondary" @onclick="ClearItemSearchAsync">@T["Clear"]</button>
        }
    </div>
}

@if (_itemSearch.Trim().Length > 0)
{
    @if (_isSearchingItems)
    {
        <p>@T["Looking through your inventories…"]</p>
    }
    else if (_itemMatches.Count == 0)
    {
        <p class="empty-hint empty-list">@T["Nothing on any shelf matches that."]</p>
    }
    else
    {
        <div class="card inventory-search-results">
            @* Where it is comes second on the row and is the point of the whole search, so it is the
               part that is a link: the name only says what was found. *@
            @foreach (var match in _itemMatches)
            {
                <Row Title="@match.Name" OnPressed="() => OpenInventory(match.InventoryId)">
                    <Trailing>
                        <span class="row-meta">@match.Amount</span>
                        <span class="row-meta inventory-search-where">@match.InventoryName</span>
                    </Trailing>
                </Row>
            }
        </div>
        <p class="empty-hint">@ItemMatchSummary</p>
    }
}

@* Which folder is being read - the inventories' own, since a folder belongs to one page (see
   FolderScope). On a phone it folds into one Menu button. *@
<PhoneToolbar Page="FolderPage.Inventories" HasNews="@NewsIsInAFolderThatIsNotOpen">
    <FolderTabs Page="FolderPage.Inventories" CountIn="CountIn" HasNewsIn="HasNewsIn" StillHolds="StillHolds" />
</PhoneToolbar>

@* What to do with several at once, while several are chosen - see PickedThings, and Notes.razor on why it
   is outside the list. *@
<PickedThingsBar Picked="_picked" Page="FolderPage.Inventories"
                 EveryChosenOneIsAway="@EveryChosenShelfIsAway" IsWorking="@_isWorkingOnPicked"
                 OnFiled="FilePickedAsync" OnArchive="ArchivePickedAsync" OnShare="() => _isSharingPicked = true"
                 OnAllToggled="ToggleAllPicked" OnStopped="StopPicking" />
@if (_isSharingPicked)
{
    @* Only a shelf this reader owns and Orbit can read - see Notes.razor, which says why. *@
    <SharePickedDialog Things="@([.. ChosenInventories.Where(inventory => !inventory.IsShared && !inventory.IsPrivate).Select(inventory => new SharePickedDialog.ShareableThing(inventory.Id, inventory.Name))])"
                       LeftOut="@ChosenInventories.Count(inventory => inventory.IsShared || inventory.IsPrivate)"
                       ShareOne="(inventoryId, recipientUserId, accessLevel) => InventoryApiClient.ShareInventoryAsync(inventoryId, recipientUserId, accessLevel)"
                       Invitation="(shareId, name) => new InventoryShareMessagePayload(shareId, name)"
                       OnClosed="() => _isSharingPicked = false" />
}
<ObjectList IsLoading="_inventories is null" IsEmpty="_inventories is { Count: 0 }"
            EmptyMessage="@T["No inventories yet. Create one to start tracking stock."]">
    @if (_inventories is { Count: > 0 } && ArrangedInventories.Count == 0)
    {
        <p class="empty-hint empty-list">@T["Nothing in this folder."]</p>
    }
    <div class="item-card-list">
        @foreach (var inventory in ArrangedInventories)
        {
            <div @key="inventory.Id" class="@(_cardOrder.IsDragging(inventory) ? "dragging" : "")"
                 @ondragover:preventDefault="true" @ondrop="() => DropCardOnAsync(inventory)">
                @* Which storage the bell is talking about. An expiry warning names the storage it is
                   on now (InventoryExpiryPushContent), so this page can mark the card rather than
                   leaving a reader to open all of them. *@
                <ItemCard Name="@inventory.Name" OnNameSelected="() => OpenInventory(inventory.Id)"
                          OffersPicking="_picked.IsPicking" IsPicked="_picked.Holds(inventory.Id)"
                          OnPickedChanged="() => _picked.Toggle(inventory.Id)"
                          HasUnseenAction="@HasNewsAbout(inventory)">
                    <Handle>
                        <ReorderControls OnDragStart="() => _cardOrder.Start(inventory)" OnDragEnd="_cardOrder.Finish"
                                         OnMoveUp="() => MoveCardAsync(inventory, -1)"
                                         OnMoveDown="() => MoveCardAsync(inventory, 1)"
                                         CanMoveUp="CanMoveCard(inventory, -1)" CanMoveDown="CanMoveCard(inventory, 1)" />
                    </Handle>
                    <Menu>
                        @* The card opens the shelf to be read; changing what is on it is a named press,
                           the same as a task list's - unless a share below CanEdit means there is
                           nothing to press it into changing, the same question Notes.razor asks.

                           Somebody else's shelf is not this reader's to delete: pressing that takes it
                           off their own pages and leaves the owner's alone, so it says so rather than
                           "Delete" - the shape a note, a task list and an event already have. It needs
                           no archive first either, because a share cannot be put away and requiring the
                           archive would leave no way to be rid of one at all. *@
                        <ObjectMenu EditLabel="@(CanBeChanged(inventory) ? T["Edit"] : T["View"])" OnEdit="() => EditInventory(inventory.Id)"
                                    DuplicateLabel="@(!inventory.IsShared ? T["Duplicate"] : null)"
                                    OnDuplicate="() => DuplicateInventoryAsync(inventory)"
                                    ShareLabel="@(CanShare(inventory) ? T["Share"] : null)" OnShare="() => ToggleSharePanel(inventory.Id)"
                                    ArchiveLabel="@(!inventory.IsShared ? ArchiveLabelFor(inventory.IsArchived) : null)"
                                    OnArchive="() => SetArchivedAsync(inventory, !inventory.IsArchived)"
                                    IsArchived="inventory.IsArchived"
                                    DeleteNeedsTheArchive="@(!inventory.IsShared)"
                                    DeleteLabel="@(inventory.IsShared ? T["Remove from my list"] : T["Delete"])"
                                    OnDelete="() => DeleteInventoryAsync(inventory)" />
                    </Menu>
                    <Tags>
                        @if (inventory.IsGroup)
                        {
                            <span class="card-badge">@T["Group"]</span>
                        }
                        @if (inventory.IsPrivate)
                        {
                            <span class="card-badge" title="@(T["Private - encrypted, and only you can read it"])">@T["Private"]</span>
                        }
                        @if (inventory.IsShared)
                        {
                            <span class="card-badge">@T.Format("Shared by {0} · {1}", inventory.SharedByUserName, AccessDescription(inventory.AccessLevel))</span>
                        }
                        @if (inventory.LockedByUserName is { } lockedBy)
                        {
                            <span class="card-badge">@T.Format("{0} is editing it right now", lockedBy)</span>
                        }
                    </Tags>
                    <Body>
                @* What a group is made of, inside the one entry it is - see
                   Orbit.Core.Inventories.Inventory.GathersInventoryIds. Each row opens the smaller shelf
                   itself, which is still on this page in its own right: gathering reads several shelves
                   together rather than moving them into a box. *@
                @foreach (var member in Gathered(inventory))
                {
                    <Row Title="@member.Name" OnPressed="() => OpenInventory(member.Id)">
                        <Trailing>
                            @if (member.IsGroup)
                            {
                                <span class="card-badge">@T["Group"]</span>
                            }
                        </Trailing>
                    </Row>
                }
                @if (_sharePanelInventoryId == inventory.Id)
                {
                    <ShareInventoryPanel Inventory="inventory" Contacts="_contacts" OwnUserId="_ownUserId" />
                }
                    </Body>
                </ItemCard>
            </div>
        }
    </div>
</ObjectList>

@code {
    private IReadOnlyList<InventoryDto>? _inventories;
    private IReadOnlyList<ContactDto> _contacts = [];
    private Guid _ownUserId;
    private string? _errorMessage;

    /// <summary>What the reader is looking for across every inventory, and what was found.</summary>
    private string _itemSearch = string.Empty;
    private bool _isSearchingItems;
    private IReadOnlyList<ItemMatch> _itemMatches = [];

    /// <summary>
    /// Every inventory's items, read once and kept for as long as the page is open - a search narrows
    /// as it is typed, and fetching a whole account's stock per keystroke would be a request storm.
    /// Null until the first search: opening this page to look at the shelves should cost nothing extra.
    /// </summary>
    private IReadOnlyList<ItemMatch>? _everythingOnEveryShelf;

    /// <summary>
    /// Inventories whose contents could not be read, if any. Named rather than skipped: a search that
    /// quietly leaves one out answers "it is nowhere" when the truth is "I could not look there".
    /// </summary>
    private IReadOnlyList<string> _unreadableInventories = [];

    /// <summary>One thing found, and where it is.</summary>
    /// <param name="Amount">Already written for reading - see AmountOf.</param>
    private sealed record ItemMatch(Guid InventoryId, string InventoryName, string Name, string Amount);

    /// <summary>Which inventory's inline share panel is open, if any - only one at a time.</summary>
    private Guid? _sharePanelInventoryId;

    protected override async Task OnInitializedAsync()
    {
        // MainLayout owns the polling; this only listens. A storage somebody has just shared
        // is one this page has never read, so hearing about it has to mean reading again - see
        // OnNotificationsChanged.
        NotificationFeedState.Changed += OnNotificationsChanged;
        // The tabs are shared, so pressing one anywhere re-filters this page too.
        Folders.Changed += OnFoldersChanged;
        await Arrangement.InitializeAsync();
        var currentUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        _ownUserId = currentUserId.Value;

        try
        {
            _inventories = await InventoryApiClient.GetInventoriesAsync();
            _contacts = await ChatApiClient.GetContactsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load inventories");
            _errorMessage = T["Couldn't load your inventories. Check your connection and try again."];
            _inventories = [];
        }
    }

    /// <summary>Whether this reader may actually change the shelf - the owner, or a share granted at
    /// least EditOnly. Mirrors Notes.razor's own card check, which asks the same question of a note.</summary>
    private static bool CanBeChanged(InventoryDto inventory)
        => SharedItemAccess.For(inventory.IsShared, inventory.AccessLevel).CanEdit;

    /// <summary>Mirrors ShareInventoryCommandHandler's own rule, so the button isn't offered for a share that would be rejected.</summary>
    /// <summary>
    /// A private inventory can never be shared - the server refuses it, so offering the button would
    /// only lead to a refusal. Matches the same rule for notes and task lists.
    /// </summary>
    private static bool CanShare(InventoryDto inventory)
        => !inventory.IsPrivate && SharedItemAccess.For(inventory.IsShared, inventory.AccessLevel).CanShare;

    private string AccessDescription(string accessLevel)
        => T[SharedItemAccess.For(isShared: true, accessLevel).Description];

    private void GoToAddInventory() => NavigationManager.NavigateTo("/inventory/new");

    /// <summary>
    /// The shelves a group gathers, in the order they were arranged - only its own members, not what
    /// those gather in turn. A card is a division of one shelf into smaller ones, and a tree drawn on a
    /// list of cards is a list that is no longer a list; opening a member's own card shows its own.
    ///
    /// One the reader no longer has is passed over rather than drawn as a missing row: a member that was
    /// deleted reads as "nothing there", the same way a link to a deleted task list does.
    /// </summary>
    private IReadOnlyList<InventoryDto> Gathered(InventoryDto inventory)
        => [.. inventory.AllGathered
            .Select(memberId => (_inventories ?? []).FirstOrDefault(candidate => candidate.Id == memberId))
            .OfType<InventoryDto>()];

    private void OpenInventory(Guid inventoryId) => NavigationManager.NavigateTo($"/inventory/{inventoryId}");

    private void EditInventory(Guid inventoryId)
        => NavigationManager.NavigateTo(ReturnTo.Link($"/inventory/{inventoryId}/edit", "/inventory"));

    /// <summary>
    /// Answers "which inventory is this in". Read here rather than asked of the server, because a
    /// private inventory keeps no item rows there at all - its stock is sealed and only this browser
    /// holds the key (see InventoryApiClient.GetInventoryItemsAsync). A server-side search would leave
    /// those shelves out and call it "nowhere", which is worse than not offering the search.
    /// </summary>
    private async Task SearchForItemsAsync()
    {
        if (_itemSearch.Trim() is not { Length: > 0 } wanted)
        {
            _itemMatches = [];
            return;
        }

        _isSearchingItems = true;
        try
        {
            _everythingOnEveryShelf ??= await ReadEveryShelfAsync();
        }
        finally
        {
            _isSearchingItems = false;
        }

        // Matched anywhere in the name, without case and without the marks over a letter, the same as
        // the editor's own box: a shelf holds "Flour, wheat" and somebody typing "flour" means it, and
        // one holding "Żurek" is meant by somebody typing "zurek" - see LooseText.
        _itemMatches = [.. _everythingOnEveryShelf
            .Where(item => LooseText.Holds(item.Name, wanted))
            .OrderBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(item => item.InventoryName, StringComparer.CurrentCultureIgnoreCase)];
    }

    private async Task ClearItemSearchAsync()
    {
        _itemSearch = string.Empty;
        await SearchForItemsAsync();
    }

    /// <summary>
    /// Everything in every inventory, flattened to what a result row needs. An inventory that will not
    /// open is remembered by name rather than dropped - see _unreadableInventories.
    /// </summary>
    private async Task<IReadOnlyList<ItemMatch>> ReadEveryShelfAsync()
    {
        var everything = new List<ItemMatch>();
        var unreadable = new List<string>();
        foreach (var inventory in _inventories ?? [])
        {
            try
            {
                var items = await InventoryApiClient.GetInventoryItemsAsync(inventory.Id) ?? [];
                everything.AddRange(items.Select(item => new ItemMatch(
                    inventory.Id, inventory.Name, item.Name, AmountOf(item))));
            }
            catch (HttpRequestException exception)
            {
                Logger.LogWarning(exception, "Couldn't read inventory {InventoryId} while searching", inventory.Id);
                unreadable.Add(inventory.Name);
            }
        }

        _unreadableInventories = unreadable;
        return everything;
    }

    /// <summary>
    /// How much of it there is. The unit is left off for something counted one by one - "2" of a thing
    /// already means two of them - which is the rule a restock errand is written by too.
    /// </summary>
    private string AmountOf(InventoryItemDto item)
    {
        var unit = InventoryUnitOption.For(item.Unit);
        var amount = item.Quantity.ToString("0.##", CultureInfo.InvariantCulture);
        return unit.Value == nameof(InventoryUnit.Piece) ? amount : $"{amount} {T[unit.ShortName]}";
    }

    /// <summary>
    /// What was found, and - when a shelf could not be opened - that the answer is short of those.
    /// Saying only the count would let "nothing found" stand for "I could not look".
    /// </summary>
    private string ItemMatchSummary
        => _unreadableInventories.Count == 0
            ? T.Format("Found in {0} of {1} inventories.", InventoriesMatched, (_inventories ?? []).Count)
            : T.Format(
                "Found in {0} of {1} inventories. These could not be opened, so nothing in them was searched: {2}",
                InventoriesMatched, (_inventories ?? []).Count, string.Join(", ", _unreadableInventories));

    private int InventoriesMatched => _itemMatches.Select(match => match.InventoryId).Distinct().Count();

    /// <summary>
    /// Opens one card's share panel, closing whichever was open. The panel is a component now and holds
    /// its own choices, so closing and reopening starts it fresh - see ShareInventoryPanel.
    /// </summary>
    private void ToggleSharePanel(Guid inventoryId)
        => _sharePanelInventoryId = _sharePanelInventoryId == inventoryId ? null : inventoryId;

    /// <summary>
    /// The inventories under the open tab, in the order this reader put them - see InventoryArrangement.
    /// One nobody filed is still in a folder: Public, or Private when it is sealed (FolderPlacement).
    /// </summary>
    private IReadOnlyList<InventoryDto> ArrangedInventories
        => [.. Arrangement.Arrange(
            (_inventories ?? []).Where(inventory =>
                Folders.ShowsUnderTheChosenTab(FolderPage.Inventories, inventory.FolderId, inventory.IsPrivate, isFinished: false, inventory.IsArchived)),
            inventory => inventory.Id)];

    /// <summary>Which shelves are chosen to be acted on together - see PickedThings.</summary>
    private readonly PickedThings _picked = new();

    /// <summary>While a round of presses is still going out, so a second press cannot start another.</summary>
    private bool _isWorkingOnPicked;

    private void StartPicking() => _picked.Start();

    private void StopPicking()
    {
        _picked.Stop();
        _isWorkingOnPicked = false;
    }

    private void ToggleAllPicked() => _picked.ToggleAll(ArrangedInventories.Select(inventory => inventory.Id));

    /// <summary>Whether every chosen shelf is already put away, which is what names the bar's archive button.</summary>
    private bool EveryChosenShelfIsAway => _picked.HasAny && ChosenInventories.All(inventory => inventory.IsArchived);

    /// <summary>While the dialog sharing the chosen shelves is open - see SharePickedDialog.</summary>
    private bool _isSharingPicked;

    private IReadOnlyList<InventoryDto> ChosenInventories
        => [.. (_inventories ?? []).Where(inventory => _picked.Holds(inventory.Id))];

    /// <inheritdoc cref="ActOnPickedAsync"/>
    private async Task FilePickedAsync(Guid? folderId)
        => await ActOnPickedAsync(inventory => InventoryApiClient.MoveToFolderAsync(inventory.Id, folderId));

    /// <inheritdoc cref="ActOnPickedAsync"/>
    private async Task ArchivePickedAsync(bool isArchived)
        => await ActOnPickedAsync(inventory => InventoryApiClient.SetArchivedAsync(inventory.Id, isArchived));

    /// <summary>
    /// One press over every chosen shelf - see OnePressEach, and Notes.ActOnPickedAsync, which is the
    /// same round on the other page. One somebody else owns is left out: filing and putting away are
    /// decisions about the owner's own page.
    /// </summary>
    private async Task ActOnPickedAsync(Func<InventoryDto, Task<bool>> act)
    {
        if (!_picked.HasAny || _isWorkingOnPicked)
        {
            return;
        }

        _isWorkingOnPicked = true;
        try
        {
            var stillSignedIn = await OnePressEach.RunAsync(
                ChosenInventories.Where(inventory => !inventory.IsShared), inventory => act(inventory),
                Logger, "inventories");
            if (!stillSignedIn)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            _inventories = await InventoryApiClient.GetInventoriesAsync();
            _picked.KeepOnly(ArrangedInventories.Select(inventory => inventory.Id));
        }
        finally
        {
            _isWorkingOnPicked = false;
        }
    }

    /// <summary>
    /// How many shelves are under each tab, drawn on the tab itself. There is no Finished tab here - a
    /// shelf is never done with - see FolderPages.HasAFinishedTab.
    /// </summary>
    private int CountIn(FolderKey folder)
        => (_inventories ?? []).Count(inventory =>
            Folders.PlacementOn(FolderPage.Inventories, inventory.FolderId, inventory.IsPrivate, isFinished: false, inventory.IsArchived) == folder);

    /// <summary>Whether anything is still filed here - see FolderTabs.StillHolds, and Notes.StillHolds.</summary>
    private bool StillHolds(Guid folderId) => (_inventories ?? []).Any(inventory => inventory.FolderId == folderId);

    /// <summary>Where a shelf's tab is - one answer for the count above and the two questions below.</summary>
    private FolderKey PlacementOf(InventoryDto inventory)
        => Folders.PlacementOn(
            FolderPage.Inventories, inventory.FolderId, inventory.IsPrivate, isFinished: false, inventory.IsArchived);

    /// <summary>
    /// Whether a shelf under this tab holds something the reader has not seen - the mark on the tab, so
    /// somebody following a notification can see which folder holds it. See FolderTabs.HasNewsIn.
    /// </summary>
    private bool HasNewsIn(FolderKey folder)
        => (_inventories ?? []).Any(inventory => HasNewsAbout(inventory) && PlacementOf(inventory) == folder);

    /// <summary>The same question asked of the tabs a phone folds away - see PhoneToolbar.HasNews.</summary>
    private bool NewsIsInAFolderThatIsNotOpen
        => (_inventories ?? []).Any(inventory =>
            HasNewsAbout(inventory) && PlacementOf(inventory) != Folders.ChosenOn(FolderPage.Inventories));

    /// <summary>The card being dragged to a new place, while one is - see RowArrangement.</summary>
    private readonly RowArrangement<InventoryDto> _cardOrder = new();

    /// <summary>
    /// Where a card was dropped is where it belongs. The whole visible order is written back rather
    /// than the one card that moved: a stored order naming only what somebody had touched would leave
    /// the rest wherever they happened to fall.
    /// </summary>
    private async Task DropCardOnAsync(InventoryDto target)
    {
        var arranged = ArrangedInventories.ToList();
        if (!_cardOrder.DropOn(arranged, target))
        {
            _cardOrder.Finish();
            return;
        }

        _cardOrder.Finish();
        await Arrangement.SetOrderAsync([.. arranged.Select(inventory => inventory.Id)]);
    }

    /// <summary>The same move a drag makes, one card at a time - what a keyboard asks for, and a finger.</summary>
    private async Task MoveCardAsync(InventoryDto inventory, int offset)
    {
        var arranged = ArrangedInventories.ToList();
        if (!RowArrangement<InventoryDto>.Move(arranged, inventory, offset))
        {
            return;
        }

        await Arrangement.SetOrderAsync([.. arranged.Select(existing => existing.Id)]);
    }

    private bool CanMoveCard(InventoryDto inventory, int offset)
        => RowArrangement<InventoryDto>.CanMove(ArrangedInventories.ToList(), inventory, offset);

    /// <summary>
    /// A second storage holding the same things, named for the one it came from. The whole set is read
    /// again afterwards rather than the copy being appended here: the shelves are filled on the server
    /// (see DuplicateInventoryCommandHandler), and this page has no way to guess what came out of it.
    ///
    /// A sealed storage keeps its name, because that name is inside a payload the browser would have to
    /// re-seal to change - see DuplicateRequest.Name.
    /// </summary>
    /// <summary>
    /// "Archive", or "Put back" for something already put away - see
    /// Orbit.Core.Folders.BuiltInFolder.Archived. The notes page says the same thing the same way.
    /// </summary>
    private string ArchiveLabelFor(bool isArchived) => isArchived ? T["Put back"] : T["Archive"];

    /// <summary>
    /// Puts one shelf away, or brings it back - see Orbit.Core.Folders.BuiltInFolder.Archived. The card
    /// stays where it is until the page is read again: it has not moved anywhere, it is under another tab
    /// now. A refusal leaves everything as it was rather than redrawing a lie.
    /// </summary>
    private async Task SetArchivedAsync(InventoryDto inventory, bool isArchived)
    {
        Logger.LogInformation(
            "User clicked '{Action}' for inventory {Id}", isArchived ? "Archive" : "Put back", inventory.Id);
        try
        {
            if (!await InventoryApiClient.SetArchivedAsync(inventory.Id, isArchived))
            {
                return;
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to archive inventory {Id}", inventory.Id);
            return;
        }

        _inventories = _inventories!
            .Select(existing => existing.Id == inventory.Id ? existing with { IsArchived = isArchived } : existing)
            .ToList();
    }

    private async Task DuplicateInventoryAsync(InventoryDto inventory)
    {
        Logger.LogInformation("User clicked 'Duplicate' for inventory {InventoryId}", inventory.Id);
        _errorMessage = null;
        try
        {
            await InventoryApiClient.DuplicateInventoryAsync(
                inventory.Id, inventory.IsPrivate ? null : T.Format("{0} (copy)", inventory.Name));
            _inventories = await InventoryApiClient.GetInventoriesAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to duplicate inventory {InventoryId}", inventory.Id);
            _errorMessage = T["Couldn't make a copy. Try again."];
        }
    }

    private async Task DeleteInventoryAsync(InventoryDto inventory)
    {
        // Asked in the words of what will happen. A shelf somebody shared is not being destroyed -
        // the server drops this reader's grant and leaves the owner's shelf where it is, see
        // DeleteInventoryCommandHandler - so it must not be asked about as a deletion.
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            inventory.IsShared
                ? T.Format("Remove \"{0}\" from your inventories? The owner keeps it.", inventory.Name)
                : T.Format("Delete \"{0}\" and everything in it?", inventory.Name));
        if (!confirmed)
        {
            return;
        }

        try
        {
            await InventoryApiClient.DeleteInventoryAsync(inventory.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete inventory {InventoryId}", inventory.Id);
            _errorMessage = inventory.IsShared
                ? T["Couldn't take that off your inventories. Check your connection and try again."]
                : T["Failed to delete the inventory. Try again."];
            return;
        }

        _inventories = _inventories!.Where(existing => existing.Id != inventory.Id).ToList();
    }
    /// <summary>
    /// Something reached the bell, so the storages are read again. Redrawing alone would not do: a storage
    /// somebody has just shared is one this page does not hold, and a share that only appears on the
    /// next reload is a share that looks like it did not arrive.
    ///
    /// A read per notification is affordable because a notification is rare - one arrives when somebody
    /// does something, not on a timer.
    /// </summary>
    private void OnNotificationsChanged()
        => InvokeAsync(async () =>
        {
            try
            {
                _inventories = await InventoryApiClient.GetInventoriesAsync();
            }
            catch (HttpRequestException exception)
            {
                // Already drawn, and still correct about everything it knew a moment ago. Nobody asked
                // for this read, so nothing is said about its failing.
                Logger.LogWarning(exception, "Couldn't re-read the storages after a notification");
            }

            StateHasChanged();
        });

    /// <summary>
    /// Whether anything unread is about this storage - see NotificationFeedState.HasNewsAbout, matched
    /// at a path boundary, so a warning about an item on it counts as news about the storage.
    /// </summary>
    private bool HasNewsAbout(InventoryDto inventory)
        => NotificationFeedState.HasNewsAbout($"/inventory/{inventory.Id}");

    private void OnFoldersChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NotificationFeedState.Changed -= OnNotificationsChanged;
        Folders.Changed -= OnFoldersChanged;
    }

}
