@page "/chat/groups/{GroupId:guid}/members"
@attribute [Authorize]
@using System.Net
@using Orbit.Contracts.Chat
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject ChatApiClient ChatApiClient
@inject GroupHistorySharing GroupHistorySharing
@inject OrbitAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<GroupMembers> Logger
@inject UserPermissionState Permissions
@inject Translations T

@* Who is in a group, and who may change that. A page rather than a panel folded into the thread: the
   roster is one row per person with two buttons each for an admin, which above the messages left the
   conversation itself below the fold on every visit. *@
<PageTitle>@(_group?.Name ?? T["Members"])</PageTitle>

<PageHeader Subtitle="@Optional(_group?.Name)">
    <Title>@T["Members"]</Title>
</PageHeader>

@if (!Permissions.Has(ApplicationPermission.Chat))
{
    <FeatureLocked Explanation="@(T["Conversations, with one person or with several."])" />
}
else if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

@if (_group is { } group)
{
    <div class="card">
        @* Membership is only editable by an admin - see ChatGroup, which refuses it server-side too. *@
        @foreach (var member in group.Members)
        {
            <div class="list-row group-member-row">
                <span class="avatar-sm" style="background:@AvatarHelper.AvatarColor(member.UserId)">@AvatarHelper.GetInitials(DisplayNameFor(member.UserId))</span>
                <span class="row-title">@DisplayNameFor(member.UserId)</span>
                @if (member.Role == AdminRole)
                {
                    <span class="card-badge group-member-badge">@T["Admin"]</span>
                }
                @* One menu rather than a row of buttons. A roster is read down the names, and two
                   buttons per person made every row as wide as its widest control and the names the
                   narrowest thing on it - the same three-dot menu every card in the app carries.

                   What a reader may not do is drawn greyed rather than left out: an option that
                   disappears looks like an option that does not exist, and "you are not an admin here"
                   is worth saying. Each one says why it is greyed on the control itself, so the answer
                   is where the pointer already is. *@
                <span class="group-member-menu">
                    <OverflowMenu>
                        @* Promoting somebody, or taking it back. Never yourself: an admin who could
                           demote themselves could leave a group with nobody able to change it - the
                           server refuses it too, see ChatGroup. *@
                        <button type="button" class="avatar-dropdown-item"
                                disabled="@(_isBusy || !CanChangeRoleOf(member))"
                                title="@WhyRoleCannotChange(member)"
                                @onclick="() => ChangeRoleAsync(member.UserId, member.Role == AdminRole ? MemberRole : AdminRole)">
                            @(member.Role == AdminRole ? T["Demote"] : T["Make admin"])
                        </button>
                        @* Who somebody is needs no standing at all, so it is the one entry never greyed.
                           It leads to the same page a contact's own card does - a member who is not a
                           contact resolves there too, see ContactInfo. *@
                        <button type="button" class="avatar-dropdown-item"
                                @onclick="() => GoToMemberInfo(member.UserId)">@T["Info"]</button>
                        @* Showing yourself out is not the same act as removing somebody, and needs no
                           admin standing - see ChatGroup.RemoveMember - so on your own row this is the
                           way out of the group rather than a greyed "Remove". *@
                        @if (member.UserId == _ownUserId)
                        {
                            <button type="button" class="avatar-dropdown-item" disabled="@_isBusy"
                                    @onclick="LeaveGroupAsync">@T["Leave group"]</button>
                        }
                        else
                        {
                            <button type="button" class="avatar-dropdown-item"
                                    disabled="@(_isBusy || !IsOwnAdmin)"
                                    title="@(IsOwnAdmin ? null : T["Only a group admin can change who is in it."])"
                                    @onclick="() => RemoveMemberAsync(member.UserId)">@T["Remove"]</button>
                        }
                    </OverflowMenu>
                </span>
            </div>
        }

        @if (IsOwnAdmin && _addableContacts.Count > 0)
        {
            <div class="field-row">
                <select @bind="_contactToAddId">
                    <option value="">@T["Add someone…"]</option>
                    @foreach (var contact in _addableContacts)
                    {
                        <option value="@contact.UserId">@contact.DisplayName</option>
                    }
                </select>
                <button type="button" class="btn-secondary" disabled="@_isBusy" @onclick="AddMemberAsync">@T["Add"]</button>
            </div>
            @* Off unless asked for: everything said in this group so far was said to the people who were
               in it, and handing it on is a decision, not a default. *@
            <label class="field-checkbox" for="shareHistoryInput">
                <input id="shareHistoryInput" type="checkbox" @bind="_shareHistoryWithNewMember" />
                <span>@T["Also give them what was said before they joined"]</span>
            </label>
            <p class="field-hint">@T["Your device re-encrypts each message for them, so only messages it can open are passed on."]</p>
            @if (_historyShareMessage is not null)
            {
                <p class="field-hint">@_historyShareMessage</p>
            }
        }
    </div>
}

@code {
    [Parameter] public Guid GroupId { get; set; }

    private const string AdminRole = "Admin";
    private const string MemberRole = "Member";

    private Guid _ownUserId;
    private ChatGroupDto? _group;
    private IReadOnlyList<ContactDto> _contacts = [];
    private string _contactToAddId = string.Empty;
    private bool _isBusy;
    private string? _errorMessage;

    /// <summary>Whether the next person added should also be handed the conversation so far.</summary>
    private bool _shareHistoryWithNewMember;

    /// <summary>What the last share actually managed, said plainly rather than left to be guessed at.</summary>
    private string? _historyShareMessage;

    private bool IsOwnAdmin => _group?.OwnRole == AdminRole;

    /// <summary>
    /// Whether this reader may promote or demote this member. Two answers in one: an admin may, and
    /// nobody may do it to themselves - an admin who could demote themselves could leave a group with
    /// nobody able to change it, which is why the server refuses that too.
    /// </summary>
    private bool CanChangeRoleOf(ChatGroupMemberDto member) => IsOwnAdmin && member.UserId != _ownUserId;

    /// <summary>
    /// Why the entry above is greyed, on the control itself - a greyed control that does not say why is
    /// a dead end. Null when it is not greyed, so nothing is said about a control that works.
    /// </summary>
    private string? WhyRoleCannotChange(ChatGroupMemberDto member)
    {
        if (CanChangeRoleOf(member))
        {
            return null;
        }

        return member.UserId == _ownUserId
            ? T["Your own standing in a group is not yours to change."]
            : T["Only a group admin can change who is in it."];
    }

    /// <summary>Who this person is, on the same page a contact's own card opens - see ContactInfo.</summary>
    private void GoToMemberInfo(Guid userId)
    {
        Logger.LogInformation("User opened the info for group member {MemberUserId}", userId);
        NavigationManager.NavigateTo($"/contacts/{userId}");
    }

    /// <summary>Contacts not already in this group - the only people an admin can usefully add.</summary>
    private IReadOnlyList<ContactDto> _addableContacts
        => _group is { } group
            ? [.. _contacts.Where(contact => group.Members.All(member => member.UserId != contact.UserId))]
            : [];

    protected override async Task OnParametersSetAsync()
    {
        // Waits for the first permission read, so this page never decides it is locked before it has
        // been told - see UserPermissionState.EnsureLoadedAsync.
        await Permissions.EnsureLoadedAsync();
        if (!Permissions.Has(ApplicationPermission.Chat))
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _ownUserId = await AuthenticationStateProvider.TryGetCurrentUserIdAsync() ?? Guid.Empty;
            var groups = await ChatApiClient.GetGroupsAsync();
            _group = groups.FirstOrDefault(group => group.Id == GroupId);
            _contacts = await ChatApiClient.GetContactsAsync();

            if (_group is null)
            {
                _errorMessage = T["That group is no longer one you're in."];
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the members of group {GroupId}", GroupId);
            _errorMessage = T["Couldn't load your groups. Check your connection and try again."];
        }
    }

    private async Task AddMemberAsync()
    {
        if (!Guid.TryParse(_contactToAddId, out var userId))
        {
            return;
        }

        await RunAsync(async () =>
        {
            _historyShareMessage = null;
            await ChatApiClient.AddGroupMemberAsync(GroupId, userId);
            _contactToAddId = string.Empty;

            if (_shareHistoryWithNewMember)
            {
                await ShareHistoryWithAsync(userId);
            }

            await LoadAsync();
        });
    }

    /// <summary>
    /// Runs after the person is already in, not before: the copies are sealed under the key pair they
    /// have as a member, and a share that failed leaves them in the group with the history they would
    /// have had anyway rather than half-added. What went wrong is said here rather than swallowed - a
    /// silent nothing looks exactly like a checkbox that was never read.
    /// </summary>
    private async Task ShareHistoryWithAsync(Guid userId)
    {
        try
        {
            var shared = await GroupHistorySharing.ShareWithAsync(_ownUserId, GroupId, userId);
            _historyShareMessage = shared == 0
                ? T["No earlier messages could be passed on - this device can't open any of them."]
                : T.Format("Passed on {0} earlier messages.", shared);
        }
        catch (InvalidOperationException exception)
        {
            // Raised when the new member has never signed in, so there is no key to seal anything for.
            Logger.LogWarning(exception, "The history of group {GroupId} could not be shared", GroupId);
            _historyShareMessage = T["They're in the group, but the earlier messages couldn't be passed on until they've signed in once."];
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "The history of group {GroupId} could not be shared", GroupId);
            _historyShareMessage = T["They're in the group, but passing on the earlier messages didn't work."];
        }
    }

    private async Task RemoveMemberAsync(Guid userId)
        => await RunAsync(async () =>
        {
            await ChatApiClient.RemoveGroupMemberAsync(GroupId, userId);
            await LoadAsync();
        });

    /// <summary>
    /// Leaves the group and goes back to the conversation list, since the group this page was showing is
    /// no longer one this reader is in. The server refuses a sole admin who would strand the others -
    /// that comes back as a 400 naming the rule, which RunAsync surfaces.
    /// </summary>
    private async Task LeaveGroupAsync()
        => await RunAsync(async () =>
        {
            await ChatApiClient.RemoveGroupMemberAsync(GroupId, _ownUserId);
            NavigationManager.NavigateTo("/chat/groups");
        });

    private async Task ChangeRoleAsync(Guid userId, string role)
        => await RunAsync(async () =>
        {
            await ChatApiClient.ChangeGroupMemberRoleAsync(GroupId, userId, role);
            await LoadAsync();
        });

    private string DisplayNameFor(Guid userId)
        => userId == _ownUserId
            ? T["You"]
            : _contacts.FirstOrDefault(contact => contact.UserId == userId)?.DisplayName ?? T["Someone"];

    private async Task RunAsync(Func<Task> action)
    {
        _isBusy = true;
        _errorMessage = null;
        try
        {
            await action();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "A group membership change failed");
            _errorMessage = T["That didn't work. Reload the group and try again."];
        }
        finally
        {
            _isBusy = false;
        }
    }
}
