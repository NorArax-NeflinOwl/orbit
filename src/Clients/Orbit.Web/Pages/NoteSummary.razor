@page "/notes/{Id:guid}"
@attribute [Authorize]
@using System.Net
@using Orbit.Contracts.Notes
@using Orbit.Core.Abstractions
@using Orbit.Core.Notes
@using Orbit.Web.Services
@inject NotesApiClient NotesApiClient
@inject NavigationManager NavigationManager
@inject NavigationTrail NavigationTrail
@inject IJSRuntime JSRuntime
@inject ILogger<NoteSummary> Logger
@inject Translations T

@* A note read rather than written: its lines as they are, with the ones that are checklist items
   tickable. That is the whole of what somebody does with a note they are not rewriting - the checklist
   in it is a list of things to do, and opening a text editor to tick one is the same mismatch a shelf
   had before it could be counted.

   The last of the six objects to get this depth, and the same shape as the others: land on what the
   thing is, with the form a named press further in. *@
<PageTitle>@(_note is null ? T["Note"] : Written(_note.Title))</PageTitle>

@* Two panels: the note on the left, which scrolls, and the panel on the right, which does not - see
   EditorRail. On a narrow screen the right one becomes a bar along the foot of the window. *@
<div class="editor-page">
<div class="editor-page-body">

<PageHeader Subtitle="@Optional(_note is { IsShared: true, SharedByUserName: { } sharedBy } ? T.Format("Shared by {0}", sharedBy) : null)">
    <Title>@(_note is null ? T["Note"] : Written(_note.Title))</Title>
</PageHeader>

@if (_isLoading)
{
    <Loading />
}
else if (_note is null)
{
    <p>@T["That note no longer exists."]</p>
}
else
{
    @* Pressing what the note says opens it to be rewritten. Reading a note and wanting to change a word
       is one thought, and it used to take finding the menu at the other end of the page first - the same
       reason a card on the list opens the note rather than only its name does. Ticking a line is not
       that: a checklist row keeps its own press, below. *@
    <SummaryCard OnOpen="GoToEditor" AdditionalClass="checklist-card note-summary-opens">
        @if (_lines.Count == 0)
        {
            <p class="checklist-empty">@T["Nothing written here yet."]</p>
        }
        @* By position rather than over the lines themselves, because a numbered line's number is its
           place in the run above it - see NoteLineStyles.NumberOf, which the writing surface draws
           from as well so a list is numbered the same whether it is being read or written. *@
        @for (var index = 0; index < _lines.Count; index++)
        {
            var line = _lines[index];
            var number = NoteLineStyles.NumberOf(_lines.Count, index, at => _lines[at].StyleOf());

            @* A checklist line is ticked here; an ordinary one is read. Both keep the order they were
               written in, because a note is prose as often as it is a list and the two are mixed. *@
            @if (line.IsChecklistItem)
            {
                @* Its own press, kept from the card around it: a tick is what this row is for, and
                   opening the whole note to write in instead would be answering a different question.
                   CheckRow stops the press itself - see the note at the top of it. *@
                <CheckRow Title="@line.Text" State="@Ticks.Read(line.IsChecked, line.IsFailed)"
                          IsDisabled="@_isReadOnly"
                          AriaLabel="@T.Format("Done: {0}", line.Text)"
                          AdditionalClass="@LineMark(line)"
                          OnCycled="state => Tick(line, state)" />
            }
            else if (line.Text.Length > 0)
            {
                @* .note-line as well, which is where every style is drawn - a heading read back is the
                   same heading it was written as, and the mark on a list is drawn by the same rule. *@
                <p class="note-line note-summary-line" data-style="@DrawnStyle(line)" data-number="@(number > 0 ? number.ToString() : null)">
                    <TextWithLinks Text="@line.Text" />
                </p>
            }
            else
            {
                <p class="note-summary-line note-summary-break"></p>
            }
        }
    </SummaryCard>
}

</div>
@if (_note is not null)
{
    <EditorRail OnSave="SaveAsync" OnCancel="LeaveAsync" SaveDisabled="@(!_hasChanges || _isSaving)"
                ErrorMessage="@_message"
                OnEdit="GoToEditor" EditLabel="@(_isReadOnly ? T["View"] : T["Edit"])">
        @* Beside the button that failed: a save that did not happen and a note somebody else is holding
           are both answers to "why has Save done nothing", and this page is read by scrolling - an
           answer at the top of it is an answer nobody scrolls back to. *@
        <ChildContent>
            @* No Edit in here: it is a button of its own on the panel now - see EditorRail.OnEdit. *@
            <ObjectMenu AllLabel="@T["All notes"]" OnAll="GoToNotes"
                        CopyTextLabel="@(_copied ? T["Copied"] : T["Copy the text"])" OnCopyText="CopyTheTextAsync"
                        DeleteLabel="@(!_note.IsShared ? T["Delete"] : null)" OnDelete="DeleteAsync" />
        </ChildContent>
    </EditorRail>
}
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>
    /// The page that sent the reader here, which is where this page's Back returns. The form is not
    /// handed it: the form ends back on this page, to show what was saved, and this page still knows the
    /// way on from here because its own address carries this. See ReturnTo and GoToEditor.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = ReturnTo.QueryName)]
    public string? ComeBackTo { get; set; }

    private NoteDto? _note;
    private List<NoteContentLineDto> _lines = [];
    private bool _isLoading = true;
    private bool _isReadOnly;
    private bool _hasChanges;
    private bool _isSaving;
    private string? _message;

    /// <summary>Says so on the menu entry itself until the menu is left - the press has nothing else to show.</summary>
    private bool _copied;

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    /// <summary>
    /// The whole note as words, for taking it somewhere Orbit is not - an email, a message, another app.
    ///
    /// Written the way this note's own editor copies a selection out of itself (onCopy in
    /// checklistTextEditor.js): a box is "- ", and a ticked one "[x] ", which are two of the marks a
    /// paste reads back as a box (NoteSurfaceEdits.ReadPastedLine). So a note copied from here and
    /// pasted into another note arrives as the same note rather than as a page of brackets.
    ///
    /// The name is the first line, because that is what a note's name is on both clients - the first
    /// line of the writing - and a note pasted somewhere without it is a note nobody can tell from
    /// another.
    /// </summary>
    private string AsWords()
        => string.Join("\n", new[] { _note?.Title ?? string.Empty }.Concat(_lines.Select(AsALine)));

    private static string AsALine(NoteContentLineDto line)
        => line switch
        {
            { IsChecklistItem: false } => line.Text,
            { IsChecked: true } => $"[x] {line.Text}",
            _ => $"- {line.Text}"
        };

    /// <summary>
    /// A denied clipboard permission - some mobile browsers, a restricted webview - throws rather than
    /// answering, and a note that would not copy is not a reason to take the page down with it. See
    /// ShareLinkButton, which guards its own copy the same way.
    /// </summary>
    private async Task CopyTheTextAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", AsWords());
            _copied = true;
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Failed to copy the note's text to the clipboard");
            _message = T["The text could not be copied. Your browser did not allow it."];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _message = null;
        try
        {
            _note = await NotesApiClient.GetNoteByIdAsync(Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't read note {NoteId}", Id);
            _note = null;
        }
        finally
        {
            _isLoading = false;
        }

        if (_note is null)
        {
            return;
        }

        _lines = [.. _note.Content];
        _isReadOnly = _note.IsShared && !SharedItemAccess.For(_note.IsShared, _note.AccessLevel).CanEdit;
        _hasChanges = false;
    }

    /// <summary>
    /// How a line is marked: struck through when it is finished with, either way, and told apart so a
    /// line somebody gave up on does not read as one that was done - see .check-row.failed.
    /// </summary>
    private static string? LineMark(NoteContentLineDto line)
        => line.IsChecked ? "completed" : line.IsFailed ? "completed failed" : null;

    /// <summary>
    /// The style as the stylesheet names it - see .note-line[data-style] in app.css, and
    /// checklistTextEditor.js, which writes the same word onto the same lines while they are written.
    /// </summary>
    private static string DrawnStyle(NoteContentLineDto line) => line.StyleOf().ToString().ToLowerInvariant();

    /// <summary>
    /// Ticks a line, or unticks it. Nothing is written until Save: a note is read by scrolling, and a
    /// page that saved on every press would be writing while somebody is only passing through.
    /// </summary>
    private void Tick(NoteContentLineDto line, TickState state)
    {
        var at = _lines.IndexOf(line);
        if (at < 0)
        {
            return;
        }

        _lines[at] = line with { IsChecked = state.IsCompleted(), IsFailed = state.IsFailed() };
        _hasChanges = true;
        _message = null;
    }

    /// <summary>
    /// Writes the ticks back. The whole note goes, because that is the only save a note has - the title
    /// and every line travel with it, unchanged except for what was ticked, and a private note is
    /// sealed again on the way out by the client that opened it (see NotesApiClient.SealIfPrivateAsync).
    /// </summary>
    private async Task SaveAsync()
    {
        if (_note is null || _isSaving)
        {
            return;
        }

        _isSaving = true;
        _message = null;
        try
        {
            var outcome = await NotesApiClient.UpdateNoteAsync(
                Id, new UpdateNoteRequest(_note.Title, _lines, _note.IsPrivate, Priority: _note.Priority));

            if (outcome.Kind == EditOutcomeKind.Locked)
            {
                _message = T.Format("{0} is currently editing this note - you can't edit it right now.", outcome.LockedByUserName);
                return;
            }

            if (outcome.Kind != EditOutcomeKind.Success)
            {
                _message = T["Failed to save the note. Try again."];
                return;
            }

            _hasChanges = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            Logger.LogWarning(exception, "Couldn't save what was ticked on note {NoteId}", Id);
            _message = T["Failed to save the note. Try again."];
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>Asked first, and asked with the name: a note deleted by accident is gone.</summary>
    private async Task DeleteAsync()
    {
        if (_note is null
            || !await JSRuntime.InvokeAsync<bool>("confirm", T.Format("Delete \"{0}\"?", Written(_note.Title))))
        {
            return;
        }

        try
        {
            await NotesApiClient.DeleteNoteAsync(Id);
            // To the notes rather than back where it was opened from, and without this page left behind
            // it - Back would open it on "That note no longer exists". See NavigationTrail.
            await NavigationTrail.FinishAfterDeletingAsync($"/notes/{Id}", "/notes", "/notes");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't delete note {NoteId}", Id);
            _message = T["Failed to delete the note. Try again."];
        }
    }

    private void GoToNotes() => NavigationManager.NavigateTo("/notes");

    /// <summary>
    /// Back: where this page was opened from, or the notes when it was opened directly - and without
    /// leaving this page behind in the history. See NavigationTrail.
    /// </summary>
    private Task LeaveAsync() => NavigationTrail.FinishAsync(ReturnTo.Or(ComeBackTo, "/notes"));

    /// <summary>
    /// The form, told to come back to this page - its own address, returnTo and all. It used to be handed
    /// this page's returnTo instead, so saving a note opened from the dashboard skipped the note and landed
    /// on the dashboard: the one page that shows what was just saved was the one passed over.
    /// </summary>
    private void GoToEditor()
        => NavigationManager.NavigateTo(ReturnTo.Link($"/notes/{Id}/edit", NavigationTrail.Here));
}
