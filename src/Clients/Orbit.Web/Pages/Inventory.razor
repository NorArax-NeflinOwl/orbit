@page "/inventory/{WarehouseId:guid}"
@attribute [Authorize]
@using Orbit.Contracts.Inventory
@using Orbit.Web.Services
@inject InventoryApiClient InventoryApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Inventory> Logger

<PageTitle>Orbit — Inventory</PageTitle>

<div class="page-header">
    <div>
        <h1>@(_warehouse?.Name ?? "Inventory")</h1>
        <p class="page-subtitle">Track what's in stock, get a task when something runs low, and a heads-up before it expires.</p>
        @if (_warehouse is { IsShared: true } shared)
        {
            <p class="shared-note-banner">Shared by <strong>@shared.SharedByUserName</strong> - @AccessDescription(shared.AccessLevel).</p>
        }
    </div>
    <div class="page-header-actions">
        <button class="btn-secondary" @onclick="GoToWarehouses">All warehouses</button>
        @if (_canEdit)
        {
            <button class="btn-primary" @onclick="GoToAddItem">Add item</button>
        }
    </div>
</div>

@if (_items is null)
{
    <p>Loading…</p>
}
else if (_items.Count == 0)
{
    <p>No items yet.</p>
}
else
{
    <ul>
        @foreach (var item in SortedItems())
        {
            <li>
                <strong>@item.Name</strong>
                @if (!string.IsNullOrWhiteSpace(item.ProductType))
                {
                    <span> · @item.ProductType</span>
                }
                @if (!string.IsNullOrWhiteSpace(item.Category))
                {
                    <span> · @item.Category</span>
                }
                <br>
                <small>
                    Quantity: @item.Quantity
                    @if (item.MinimumQuantity is { } minimumQuantity)
                    {
                        <span> (minimum: @minimumQuantity)</span>
                    }
                </small>
                @if (item.IsBelowMinimum)
                {
                    <br>
                    <small class="error">
                        Low stock
                        @if (item.HasPendingRestockTask)
                        {
                            <span> - <a href="/tasks">a restock task was created</a></span>
                        }
                    </small>
                }
                @if (ExpiryBadge(item) is { } expiryBadge)
                {
                    <br>
                    <small class="error">@expiryBadge</small>
                }
                @if (_canEdit)
                {
                    <br>
                    <button @onclick="() => GoToEditItem(item.Id)">Edit</button>
                    <button @onclick="() => DeleteItemAsync(item)">Delete</button>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter]
    public Guid WarehouseId { get; set; }

    private IReadOnlyList<InventoryItemDto>? _items;
    private WarehouseDto? _warehouse;

    /// <summary>Read-only share recipients see the stock but get no add/edit/delete affordances - matching what the API would allow.</summary>
    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _warehouse = await InventoryApiClient.GetWarehouseByIdAsync(WarehouseId);
            if (_warehouse is null)
            {
                NavigationManager.NavigateTo("/inventory");
                return;
            }

            _canEdit = _warehouse.AccessLevel == "CanEdit";
            _items = await InventoryApiClient.GetInventoryItemsAsync(WarehouseId) ?? [];
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private static string AccessDescription(string accessLevel) => accessLevel switch
    {
        "CanEdit" => "you can edit it",
        "Share" => "you can share it further, but not edit it",
        _ => "read-only"
    };

    /// <summary>Expiring/expired items float to the top so they're the first thing the user sees - the passive UI-only side of expiry warnings (the background service handles the active push/email side).</summary>
    private IEnumerable<InventoryItemDto> SortedItems()
        => _items!.OrderBy(item => item.ExpiryDate ?? DateTimeOffset.MaxValue).ThenBy(item => item.Name);

    private static string? ExpiryBadge(InventoryItemDto item)
    {
        if (item.ExpiryDate is not { } expiryDate)
        {
            return null;
        }

        var now = DateTimeOffset.UtcNow;
        if (expiryDate <= now)
        {
            return "Expired";
        }

        return expiryDate <= now.AddDays(3) ? "Expires soon" : null;
    }

    private void GoToWarehouses() => NavigationManager.NavigateTo("/inventory");

    private void GoToAddItem() => NavigationManager.NavigateTo($"/inventory/{WarehouseId}/items/new");

    private void GoToEditItem(Guid id) => NavigationManager.NavigateTo($"/inventory/{WarehouseId}/items/{id}");

    private async Task DeleteItemAsync(InventoryItemDto item)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete \"{item.Name}\"?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await InventoryApiClient.DeleteInventoryItemAsync(WarehouseId, item.Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete inventory item {ItemId}", item.Id);
            return;
        }

        _items = _items!.Where(existingItem => existingItem.Id != item.Id).ToList();
    }
}
