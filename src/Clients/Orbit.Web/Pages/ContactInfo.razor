@page "/contacts/{UserId:guid}"
@attribute [Authorize]
@using System.Net
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Sharing
@using Orbit.Contracts.Users
@using Orbit.Core.Permissions
@using Orbit.Web.Services
@inject ChatApiClient ChatApiClient
@inject UsersApiClient UsersApiClient
@inject NavigationManager NavigationManager
@inject ILogger<ContactInfo> Logger
@inject UserPermissionState Permissions
@inject SharesApiClient SharesApiClient
@inject Translations T

@* Who somebody is, on one page: their name, how to reach them, and whether they are here right now.
   Reachable from the contact list, from the dashboard's contacts card, and from the chat thread's own
   menu - the three places somebody is already looking at a name and wanting to know more about it. *@
<PageTitle>@(_displayName.Length > 0 ? _displayName : T["Contact"])</PageTitle>

<PageHeader>
    <Title>@(_displayName.Length > 0 ? _displayName : T["Contact"])</Title>
    <Subtitle>@T["Who this is, and how to reach them."]</Subtitle>
</PageHeader>

@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else
{
    @* An account that has not unlocked Contacts is unfindable on purpose, and Orbit answers a search
       for it exactly as it answers a search for nobody - saying "found, but hidden" would be finding
       them. So this page genuinely cannot tell the two apart, and says so rather than picking one. *@
    @if (_errorMessage is not null)
    {
        <p class="error">@_errorMessage</p>
    }

    @* Drawn for the profile itself, and for a contact whose profile can no longer be read: a
       conversation outlives the profile behind it, and the row is what carries the way into it. There
       is nothing to draw only for a stranger's id that resolves to neither. *@
    @if (_errorMessage is null || _contact is not null)
    {
    <div class="card contact-info-card">
        <div class="contact-info-identity">
            <span class="avatar-sm contact-info-avatar" style="background:@AvatarHelper.AvatarColor(UserId)">
                @AvatarHelper.GetInitials(_displayName)
                @if (_contact is { } presenceContact)
                {
                    <PresenceDot Status="Conversation.PresenceOf(presenceContact)" />
                }
            </span>
            <div>
                <div class="contact-info-name">@_displayName</div>
                <div class="contact-info-login">@_userName</div>
            </div>
            @* The one thing there is to do with a person, at the end of the row their name is in. A
               word in the corner of the page said the same thing further from what it was about, and
               shared that corner with a Back button doing the browser's job. *@
            @if (Permissions.Has(ApplicationPermission.Chat) && (_contact is not null || _errorMessage is null))
            {
                <button type="button" class="icon-btn contact-info-open-chat" title="@(T["Open chat"])"
                        aria-label="@(T["Open chat"])" @onclick="GoToChat">
                    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h12v9H8l-4 3.5V4Z" />
                    </svg>
                </button>
            }
        </div>

        @* Everything a profile says about somebody. Left out when the profile is the thing that could
           not be read - the row above is then the whole card. *@
        @if (_errorMessage is not null)
        {
            @* The part worth knowing: the messages are not going anywhere. Without it the page said
               only "can't reach that account right now", which reads as a fault Orbit is having rather
               than as somebody having closed a door. *@
            <p>@T["Your conversation with them is not affected - everything in it is still there, and still readable."]</p>
        }
        else if (_contact is { } contact)
        {
            <Row Title="@T["Email address"]">
                <Trailing><span class="row-meta">@contact.Email</span></Trailing>
            </Row>
            <Row Title="@T["Status"]">
                <Trailing><span class="row-meta">@T[PresenceLabel(contact)]</span></Trailing>
            </Row>
            <Row Title="@T["Last message"]">
                <Trailing><span class="row-meta">@contact.LastMessageAtUtc.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span></Trailing>
            </Row>
            @* Said plainly rather than left to be discovered by a message that goes nowhere. *@
            @if (contact.RequiresApprovalFromCurrentUser)
            {
                <p class="empty-hint">@T["They asked to chat with you. Open the conversation to allow it."]</p>
            }
            else if (contact.IsPendingApprovalFromOtherParty)
            {
                <p class="empty-hint">@T["Waiting for them to allow this conversation."]</p>
            }
        }
        else
        {
            @* Somebody found by search rather than somebody already spoken to: there is no conversation
               behind them yet, so there is nothing to say about one. *@
            <p class="empty-hint">@T["No conversation with them yet."]</p>
        }

        @if (_errorMessage is null && !_hasEncryptionKey)
        {
            <p class="empty-hint">@T.Format("{0} hasn't set up encryption yet - they need to log in in their own browser first before you can message them.", _displayName)</p>
        }
    </div>

    @* What this reader has given them. The one page where "what have I shared with this person" is a
       question somebody actually has - until now the only way to find out was to open every note, list,
       event and shelf in turn and read its sharing panel. Drawn only once there is something to draw:
       an empty card headed "Shared with them" on every contact is a card saying nothing. *@
    @if (_shared.Count > 0)
    {
        <div class="card">
            <div class="card-header">
                <span class="card-title">@T.Format("Shared with {0}", _displayName)</span>
            </div>
            @foreach (var share in _shared)
            {
                <Row Title="@NameOf(share)" OnPressed="() => OpenShared(share)"
                     AdditionalClass="@(_revoking.Contains(share.ShareId) ? "completed" : null)">
                    <Trailing>
                        @* An offer nobody has taken up says so: it is still access given away, and it is
                           the likeliest one to be taken back. *@
                        @if (!share.IsAccepted)
                        {
                            <span class="card-badge">@T["Not taken up yet"]</span>
                        }
                        <span class="row-meta">@DescribeKind(share.Kind)</span>
                        @* Stops the press: the row opens the thing, and this takes it away - two very
                           different answers to one tap. *@
                        <span @onclick:stopPropagation="true">
                            <button type="button" class="icon-btn" disabled="@_revoking.Contains(share.ShareId)"
                                    title="@(T["Stop sharing"])" aria-label="@(T["Stop sharing"])"
                                    @onclick="() => RevokeAsync(share)">
                                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none"
                                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m5 5 10 10M15 5 5 15" /></svg>
                            </button>
                        </span>
                    </Trailing>
                </Row>
            }
            @if (_revokeErrorMessage is not null)
            {
                <p class="error">@_revokeErrorMessage</p>
            }
        </div>
    }
    }
}

@code {
    [Parameter] public Guid UserId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;
    private ContactDto? _contact;
    private string _displayName = string.Empty;
    private string _userName = string.Empty;
    private bool _hasEncryptionKey = true;

    protected override async Task OnParametersSetAsync()
    {
        await Permissions.EnsureLoadedAsync();
        _isLoading = true;
        _errorMessage = null;

        try
        {
            // The contact entry is read first, and whether or not the account itself resolves. It is
            // what says there is a conversation here - and a conversation outlives the profile behind
            // it, because the names in one are resolved without the visibility check a lookup applies
            // (see GetUsersByIdsQueryHandler). Reading it only on success left the page unable to tell
            // "somebody you talk to has closed their door" from "no such id".
            _contact = Permissions.Has(ApplicationPermission.Chat)
                ? (await ChatApiClient.GetContactsAsync()).FirstOrDefault(candidate => candidate.UserId == UserId)
                : null;

            // The account itself is what this page is about.
            var user = await UsersApiClient.GetUserAsync(UserId);
            if (user is null)
            {
                _displayName = _contact?.DisplayName ?? string.Empty;
                _userName = _contact?.UserName ?? string.Empty;
                _errorMessage = _contact is null
                    ? T["There is nothing to show for this account. Either it does not exist, or the person has made themselves unfindable - Orbit answers both the same way, on purpose."]
                    : T["This person has made themselves unfindable in Orbit, or the account is gone. Orbit answers both the same way, so there is no telling which from here."];
                return;
            }

            _displayName = user.DisplayName;
            _userName = user.UserName;
            _hasEncryptionKey = user.PublicKeyBase64 is not null;
            // After the account, and on its own try: what this reader gave them is worth showing, and
            // failing to read it is not worth losing the card over.
            await LoadWhatIsSharedAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the contact card for {UserId}", UserId);
            _errorMessage = T["Couldn't load this contact. Check your connection and try again."];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>The English label for what the presence dot is showing, translated like any other text.</summary>
    private static string PresenceLabel(ContactDto contact)
        => Conversation.PresenceOf(contact) switch
        {
            Orbit.Core.Users.PresenceStatus.Available => "Available",
            Orbit.Core.Users.PresenceStatus.Away => "Away",
            Orbit.Core.Users.PresenceStatus.DoNotDisturb => "Do not disturb",
            _ => "Offline"
        };

    private void GoToChat() => NavigationManager.NavigateTo($"/chat/{UserId}");

    /// <summary>Everything this reader has handed them, newest first. Empty is the ordinary answer.</summary>
    private IReadOnlyList<SharedWithContactDto> _shared = [];

    /// <summary>The shares whose withdrawal is in flight, so a second press does not send a second one.</summary>
    private readonly HashSet<Guid> _revoking = [];

    private string? _revokeErrorMessage;

    /// <summary>
    /// On its own try, and swallowing what it catches into a log: this list is worth having and is not
    /// worth losing the whole card over. The card is simply left out when it cannot be read.
    /// </summary>
    private async Task LoadWhatIsSharedAsync()
    {
        try
        {
            _shared = await SharesApiClient.GetSharedWithAsync(UserId);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't read what is shared with {UserId}", UserId);
            _shared = [];
        }
    }

    /// <summary>
    /// What to call it. Something deleted since it was shared, and anything private, arrives with an
    /// empty title - the server holds no readable copy of either - so those are named by kind rather
    /// than drawn as a blank row.
    /// </summary>
    private string NameOf(SharedWithContactDto share)
        => share.ItemTitle.Length > 0 ? share.ItemTitle : DescribeKind(share.Kind);

    /// <summary>
    /// What kind of thing it is, as a label rather than as part of a sentence - so the nominative keys
    /// the rest of the app already has, not the accusative ones a share notice reads with ("Anna shared
    /// a note with you"). One English string means one thing, so these are different strings.
    /// </summary>
    private string DescribeKind(string kind) => kind switch
    {
        "note" => T["Note"],
        "tasklist" => T["Task list"],
        "event" => T["Event"],
        "inventory" => T["Inventory"],
        _ => T["Shared"]
    };

    /// <summary>
    /// Opens the thing itself, where its own section reads it. The kind decides the route - the same
    /// mapping the invitation page uses, kept here rather than shared with it because the two answer
    /// different questions: that one lands where accepting leads, this one where the reader already has
    /// access.
    /// </summary>
    private void OpenShared(SharedWithContactDto share)
    {
        var section = share.Kind switch
        {
            "note" => "/notes",
            "tasklist" => "/tasks",
            "event" => "/calendar",
            "inventory" => "/inventory",
            _ => null
        };

        if (section is null)
        {
            return;
        }

        Logger.LogInformation("User opened a shared {Kind} from a contact's card", share.Kind);
        NavigationManager.NavigateTo(ReturnTo.Link($"{section}/{share.ItemId}", $"/contacts/{UserId}"));
    }

    /// <summary>
    /// Takes it back. The row goes from the list rather than being redrawn as something withdrawn: what
    /// this card lists is what they currently have, and a row for something they no longer have would be
    /// a fourth state to explain.
    /// </summary>
    private async Task RevokeAsync(SharedWithContactDto share)
    {
        _revokeErrorMessage = null;
        _revoking.Add(share.ShareId);
        try
        {
            if (await SharesApiClient.RevokeAsync(share.Kind, share.ShareId))
            {
                _shared = [.. _shared.Where(other => other.ShareId != share.ShareId)];
                Logger.LogInformation("User stopped sharing a {Kind} with {UserId}", share.Kind, UserId);
                return;
            }

            // Already gone, or never this reader's to withdraw - the server does not tell those apart.
            // Re-read rather than guess which, so the list says what is actually there.
            await LoadWhatIsSharedAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to stop sharing {ShareId} with {UserId}", share.ShareId, UserId);
            _revokeErrorMessage = T["Couldn't stop sharing that. Check your connection and try again."];
        }
        finally
        {
            _revoking.Remove(share.ShareId);
        }
    }
}
