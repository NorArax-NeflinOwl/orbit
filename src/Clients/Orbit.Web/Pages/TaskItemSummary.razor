@page "/tasks/{TaskListId:guid}/items/{ItemId:guid}"
@attribute [Authorize]
@using Orbit.Contracts.Calendar
@using Orbit.Contracts.Chat
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Core.Tasks
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject TaskItemCompletion TaskItemCompletion
@inject NewsSettler NewsSettler
@inject CalendarApiClient CalendarApiClient
@inject ChatApiClient ChatApiClient
@inject UsersApiClient UsersApiClient
@inject GeocodingApiClient GeocodingApiClient
@inject NavigationManager NavigationManager
@inject NavigationTrail NavigationTrail
@inject IJSRuntime JSRuntime
@inject ILogger<TaskItemSummary> Logger
@inject Translations T

@* One appointment, on its own page: what it is, when it is, and where. This is what a deadline with a
   place opens as from the calendar - the checklist is the right landing for something to tick off, and
   the wrong one for something you have to get to. See Calendar.razor's GoToDueTask. *@
<PageTitle>@(_item is null ? T["Task"] : Written(_item.Description))</PageTitle>

@* Two panels, as every screen that reads one object has: the entry on the left, and the panel that
   does not scroll on the right - see EditorRail. No Save: the one thing this screen changes is the tick,
   and a tick is written the moment it is made - the same rule the checklist follows. *@
<div class="editor-page">
<div class="editor-page-body">

<PageHeader Subtitle="@Optional(_taskList is not null ? Written(_taskList.Title) : null)">
    <Title>@(_item is null ? T["Task"] : Written(_item.Description))</Title>
</PageHeader>

@if (_isLoading)
{
    <Loading />
}
else if (_item is null)
{
    <p>@T["That task item no longer exists."]</p>
}
else
{
    <div class="card">
        <Row Title="@T["When"]">
            <Trailing><span class="row-meta">@WhenItIs()</span></Trailing>
        </Row>
        <Row Title="@T["Where"]">
            <Trailing><span class="row-meta">@(_place.Length > 0 ? _place : T["No place set"])</span></Trailing>
        </Row>
        @* What the entry says about itself. Every kind carries one now (TaskItem.Notes); a calendar
           entry's is its event's, and an appointment written before entries had one of their own still
           carries the answer over there, so the event is read when the entry has nothing. Above the
           map, because this is what the thing is; the map is where it is. *@
        @if (WhatItIsAbout() is { Length: > 0 } description)
        {
            <Row Title="@T["Description"]">
                <Trailing><span class="row-meta row-meta-prose"><TextWithLinks Text="@description" /></span></Trailing>
            </Row>
        }
        @if (_event is { Details.Guests.Count: > 0 } withGuests)
        {
            <Row Title="@T["Guests:"]">
                <Trailing><span class="row-meta">@string.Join(", ", withGuests.Details.Guests.Select(NameOfTheGuest))</span></Trailing>
            </Row>
        }
        @* The tick that finishes this entry, offered where the entry is read. It used to say "Already
           done." and nothing else, so the one screen about this entry was the one place it could not be
           crossed off - see TaskItemCompletion, which both this screen and the checklist tick through. *@
        @* What an entry waiting on other entries of its list answers a press with - see TaskListSteps.
           Said rather than refused silently, and only about the tick: crossing it out is giving up on
           it, which somebody held up by a step that will never happen has to be able to do. *@
        @if (_waitingOn is { Length: > 0 } waitingFor)
        {
            <Row Title="@T["Done"]">
                <Trailing><span class="row-meta">@T.Format("Waiting for {0}.", waitingFor)</span></Trailing>
            </Row>
        }
        @if (TaskItemCompletion.IsTickedElsewhere(_item))
        {
            @* No box at all: an entry standing for other lists is done when they are (see
               LinkedTaskCompletionResolver), so the row says which list the answer is on and offers to
               go there. The checklist answers a press on such a box with the same sentence. *@
            <Row Title="@T["Done"]">
                <Trailing>
                    <span class="row-meta">@T.Format("This is done when {0} is.", LinkedTaskListTitles())</span>
                    @foreach (var linked in _listsBehindTheEntry)
                    {
                        <button type="button" class="row-meta-opens"
                                @onclick="() => GoToLinkedList(linked.Id)">@Written(linked.Title)</button>
                    }
                </Trailing>
            </Row>
        }
        else
        {
            <CheckRow Title="@T["Done"]" State="@Ticks.Read(_item.IsCompleted, _item.IsFailed)"
                      IsDisabled="@(_isTicking || _isReadOnly)"
                      AriaLabel="@T.Format("Done: {0}", Written(_item.Description))"
                      OnCycled="TickAsync" />
        }
    </div>

    @* Beside the box that failed rather than at the top of the page: this screen is read by scrolling,
       and a tick that saved nothing reads as a press that never registered. *@
    @if (_tickMessage is not null)
    {
        <p class="error">@_tickMessage</p>
    }
    @if (_restockMessage is not null)
    {
        <p class="info">@_restockMessage</p>
    }

    @* Drawn only once there is somewhere to draw. An address nobody could find stays as the words
       somebody typed rather than becoming a pin in the wrong country - see GeocodingApiClient. *@
    @if (_pin is { } pin)
    {
        <PlaceMap Latitude="pin.Latitude" Longitude="pin.Longitude" Label="@_place" ElementId="taskItemMap" />
    }
    else if (_place.Length > 0)
    {
        <p class="empty-hint">@T["That place could not be found on the map."]</p>
    }
}

</div>
@* The way out is the list this entry is on, which is where it gets ticked off; everywhere else it
   leads is behind the menu. This screen had no way to change the entry at all until now - the form is
   the list's, opened on this one entry. *@
@* Edit is a button of its own on the panel - see EditorRail.OnEdit - and only once there is an entry
   for it to open. The menu keeps the two places this screen leads to. *@
<EditorRail OnCancel="LeaveAsync" OnEdit="@(_item is null ? default : EventCallback.Factory.Create(this, GoToEditor))">
    <OverflowMenu>
        <button type="button" class="avatar-dropdown-item" @onclick="GoToTaskList">@T["Show Tasks"]</button>
        <button type="button" class="avatar-dropdown-item" @onclick="GoToCalendar">@T["Back to Calendar"]</button>
    </OverflowMenu>
</EditorRail>
</div>

@code {
    [Parameter] public Guid TaskListId { get; set; }

    /// <summary>
    /// The page that sent the reader here - the calendar, usually, since an appointment a task list
    /// made opens as its entry rather than as the event - which is where this page's Back returns, and
    /// not /tasks, two sections from where they started. The form is not handed it: the form ends back
    /// on this page, whose own address carries this. See ReturnTo, and NoteSummary.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = ReturnTo.QueryName)]
    public string? ComeBackTo { get; set; }

    [Parameter] public Guid ItemId { get; set; }

    private bool _isLoading = true;
    private TaskDto? _taskList;
    private TaskItemDto? _item;

    /// <summary>
    /// Whether this list was handed over to read rather than to change. Its own field, set where the
    /// list is loaded, the way NoteSummary keeps the same answer about a note.
    /// </summary>
    private bool _isReadOnly;

    /// <summary>Whether a tick is in flight, so a second press cannot send a second save.</summary>
    private bool _isTicking;

    /// <summary>Why the last tick saved nothing. Null until one fails - see TaskItemCompletion.</summary>
    private string? _tickMessage;

    /// <summary>The steps this entry is still waiting on, named, while it has just been pressed. Null otherwise.</summary>
    private string? _waitingOn;

    /// <summary>
    /// The entries of this list it waits for that are not done. The same rule the server keeps
    /// (TaskListSteps): a step crossed out counts as not done, because that is what a cross says.
    /// </summary>
    private IReadOnlyList<TaskItemDto> WhatItWaitsFor()
        => _item is null || _taskList is null
            ? []
            : [.. _item.AllWaitsForTaskItemIds
                .Select(stepId => _taskList.Items.FirstOrDefault(candidate => candidate.Id == stepId))
                .OfType<TaskItemDto>()
                .Where(step => !step.IsCompleted)];

    /// <summary>What finishing a round of restocking did to the shelf - see TaskItemCompletion.Note.</summary>
    private string? _restockMessage;

    /// <summary>
    /// The lists this entry stands for, as they are named on /tasks. Loaded only for an entry that
    /// stands for any: every other entry would pay for a second request to learn nothing.
    /// </summary>
    private IReadOnlyList<TaskDto> _listsBehindTheEntry = [];

    /// <summary>Where this happens, in words - the event's address when one is linked, the entry's own otherwise.</summary>
    private string _place = string.Empty;

    private GeocodedPlace? _pin;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        try
        {
            _taskList = await TasksApiClient.GetTaskListByIdAsync(TaskListId);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load task list {TaskListId} for an item summary", TaskListId);
            _isLoading = false;
            return;
        }

        _item = _taskList?.Items.FirstOrDefault(candidate => candidate.Id == ItemId);
        _isReadOnly = _taskList is null || !TaskItemCompletion.CanBeTicked(_taskList);
        await NameTheListsBehindTheEntryAsync();
        await ResolveThePlaceAsync();
        _isLoading = false;
    }

    /// <summary>
    /// Reads the list again after a tick, so what the row says is what the server holds - and, for an
    /// entry on a group list, so a completion worked out from other lists arrives with it. The place is
    /// left alone: a tick moves nothing, and looking the address up again would be a second request for
    /// an answer already on screen.
    /// </summary>
    private async Task RefreshTheEntryAsync()
    {
        try
        {
            _taskList = await TasksApiClient.GetTaskListByIdAsync(TaskListId);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to re-read task list {TaskListId} after ticking an entry off", TaskListId);
            return;
        }

        _item = _taskList?.Items.FirstOrDefault(candidate => candidate.Id == ItemId);
        _isReadOnly = _taskList is null || !TaskItemCompletion.CanBeTicked(_taskList);
    }

    /// <summary>
    /// Crosses this entry off, or takes the tick back. Saved the moment it is made, as the checklist
    /// saves it - see TaskItemCompletion, which both screens tick through.
    /// </summary>
    private async Task TickAsync(TickState state)
    {
        if (_taskList is null || _item is null || _isTicking)
        {
            return;
        }

        // Only the tick is held back: an entry waiting on unfinished work can still be crossed out, which
        // is what somebody held up by a step that is never going to happen needs. See TaskListSteps.
        _waitingOn = null;
        if (state == TickState.Completed && WhatItWaitsFor() is { Count: > 0 } steps)
        {
            _waitingOn = string.Join(", ", steps.Select(step => Written(step.Description)));
            return;
        }

        _isTicking = true;
        _tickMessage = null;
        try
        {
            if (await TaskItemCompletion.TickAsync(_taskList, _item, state) == TaskItemTickOutcome.SignedOut)
            {
                return;
            }

            _tickMessage = TaskItemCompletion.FailureMessage;
            _restockMessage = TaskItemCompletion.Note ?? _restockMessage;
            // Re-read even after a failure, so a box that did not save goes back to what the server
            // actually holds rather than standing ticked on a page that saved nothing.
            await RefreshTheEntryAsync();
        }
        finally
        {
            _isTicking = false;
        }
    }

    /// <summary>
    /// What the lists this entry stands for are called. Read from /tasks rather than from the entry,
    /// which carries only their ids - the checklist names them the same way, and for the same reason.
    /// </summary>
    private async Task NameTheListsBehindTheEntryAsync()
    {
        _listsBehindTheEntry = [];
        if (_item is null || !TaskItemCompletion.IsTickedElsewhere(_item))
        {
            return;
        }

        try
        {
            var taskLists = await TasksApiClient.GetTaskListsAsync();
            _listsBehindTheEntry =
                [.. taskLists.Where(candidate => _item.AllLinkedTaskListIds.Contains(candidate.Id))];
        }
        catch (HttpRequestException exception)
        {
            // Named as "another list" below, which is what the checklist calls one it cannot name
            // either. The sentence is still worth saying: where the tick belongs is the point of it.
            Logger.LogWarning(exception, "Couldn't name the lists task item {ItemId} stands for", ItemId);
        }
    }

    /// <summary>
    /// The lists an entry stands for, named and joined - an entry naming three of them is one step, and
    /// saying so takes naming all three.
    /// </summary>
    private string LinkedTaskListTitles()
        => _item is null
            ? string.Empty
            : string.Join(
                ", ",
                _item.AllLinkedTaskListIds.Select(linkedTaskListId =>
                    _listsBehindTheEntry.FirstOrDefault(linked => linked.Id == linkedTaskListId) is { } named
                        ? Written(named.Title)
                        : T["another list"]));

    private void GoToLinkedList(Guid linkedTaskListId)
    {
        Logger.LogInformation("User opened linked task list {LinkedTaskListId} from a task entry", linkedTaskListId);
        NavigationManager.NavigateTo($"/tasks/{linkedTaskListId}");
    }

    /// <summary>
    /// Where this entry happens, and where that is on a map. An entry tied to a calendar event takes
    /// both from the event, which is the whole point of the link - it is the one place the address is
    /// stored, so there is nothing here to disagree with it. An entry with its own address has only the
    /// words, so they are looked up.
    /// </summary>
    private async Task ResolveThePlaceAsync()
    {
        if (_item is null)
        {
            return;
        }

        _event = _item.LinkedCalendarEventId is { } eventId ? await LoadEventAsync(eventId) : null;
        // Reaching this entry is reaching the appointment it stands for, and the reminder for one points
        // at the event rather than here (EventReminderPushContent) - so nothing in this page's own
        // address settles it, and pressing the event on the calendar left its notification lit. See
        // NewsSettler, which the layout uses for the address bar's own half of this.
        if (_item.LinkedCalendarEventId is { } appointmentId)
        {
            await NewsSettler.SettleAsync($"/calendar/{appointmentId}");
        }
        if (_event is { Details.Guests.Count: > 0 })
        {
            await NameTheGuestsAsync();
        }

        if (_event is { Details.Location: { } location })
        {
            _place = location.Address ?? string.Empty;
            _pin = new GeocodedPlace(location.Latitude, location.Longitude);
        }
        else
        {
            _place = _item.Location;
            _pin = await GeocodingApiClient.FindPlaceAsync(_place);
        }
    }

    /// <summary>The appointment this entry is, when it is one. Null for an entry that is only a deadline.</summary>
    private CalendarEventDto? _event;

    /// <summary>What each guest is called, by user id - see NameTheGuestsAsync.</summary>
    private readonly Dictionary<Guid, string> _guestNames = [];

    /// <summary>
    /// What to call a guest: their login. Falls back to the id, which is not useful to read but is
    /// honest about what is known - the alternative is a blank where a person should be.
    /// </summary>
    /// <summary>
    /// What this entry is about. The entry's own answer wherever there is one; for an appointment made
    /// before entries carried one, the event still holds it, and reading that is what keeps such an
    /// entry from looking as though its description had been lost.
    /// </summary>
    /// <summary>
    /// When it happens. The appointment behind the entry is asked first, because for a calendar entry
    /// that is where the day and the hour actually live - the editor writes them into the event, so the
    /// entry's own due date is empty for exactly the entries this page exists to show. Reading only the
    /// entry is how this row came to say "no date set" about an appointment that plainly had one.
    ///
    /// A deadline with no appointment behind it still has its own date, and that is what it shows.
    /// </summary>
    private string WhenItIs()
        => _event is { } appointment
            ? EventWhen.Reads(appointment.Details, T)
            : _item?.DueDateUtc is { } dueDate
                ? dueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm")
                : T["No date set"];

    private string WhatItIsAbout()
        => _item?.AllNotes is { Length: > 0 } notes ? notes : _event?.Details.Description ?? string.Empty;

    private string NameOfTheGuest(Guid guestUserId)
        => _guestNames.TryGetValue(guestUserId, out var name) ? name : guestUserId.ToString();

    /// <summary>
    /// Names the people coming: from this account's contacts first, since most guests are, and from the
    /// user itself for anyone else. Best effort throughout - a name that cannot be read leaves the id,
    /// and this page is about when and where rather than about who.
    /// </summary>
    private async Task NameTheGuestsAsync()
    {
        if (_event is null)
        {
            return;
        }

        try
        {
            foreach (var contact in await ChatApiClient.GetContactsAsync())
            {
                _guestNames[contact.UserId] = contact.UserName;
            }

            foreach (var guestUserId in _event.Details.Guests.Where(guest => !_guestNames.ContainsKey(guest)))
            {
                if (await UsersApiClient.GetUserAsync(guestUserId) is { } user)
                {
                    _guestNames[guestUserId] = user.UserName;
                }
            }
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't read who is coming to the appointment behind a task entry");
        }
    }

    /// <summary>Best-effort: a calendar that will not load leaves the entry's own words standing rather than taking the page down.</summary>
    private async Task<CalendarEventDto?> LoadEventAsync(Guid eventId)
    {
        try
        {
            return await CalendarApiClient.GetCalendarEventByIdAsync(eventId);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to read the event task item {ItemId} is tied to", ItemId);
            return null;
        }
    }


    private void GoToCalendar() => NavigationManager.NavigateTo("/calendar");

    /// <summary>The list this entry is on, at the shallow level - see TaskListChecklist.</summary>
    private void GoToTaskList() => NavigationManager.NavigateTo($"/tasks/{TaskListId}");

    /// <summary>
    /// Back: where this page was opened from, or the list the entry is on when nobody said - without
    /// leaving this page behind in the history. See NavigationTrail.
    /// </summary>
    private Task LeaveAsync() => NavigationTrail.FinishAsync(ReturnTo.Or(ComeBackTo, $"/tasks/{TaskListId}"));

    /// <summary>
    /// The form for this one entry, which is the list's form opened on it - see TaskEditor's item
    /// parameter. An entry has no editor of its own yet. Told to come back to this page, so the edit
    /// ends on the entry it changed - see NoteSummary.GoToEditor.
    /// </summary>
    private void GoToEditor()
        => NavigationManager.NavigateTo(
            ReturnTo.Link($"/tasks/{TaskListId}/items/{ItemId}/edit", NavigationTrail.Here));

    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

}
