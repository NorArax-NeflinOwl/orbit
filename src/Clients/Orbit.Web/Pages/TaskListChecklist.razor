@* Opening a task list means this, whichever way you got here: from its card, from a deadline on the
   calendar, from a dashboard row, from an overdue-task notification. Ticking something off is what
   somebody opening a list nearly always came to do, and the deep editor is one named click away (see
   TaskEditor, which lives at "/tasks/{id}/edit").

   The second route is what every link written before that was true still says. Kept so a bookmark, or a
   push notification already sitting on somebody's phone, lands here rather than nowhere. *@
@implements IDisposable
@page "/tasks/{Id:guid}"
@page "/tasks/{Id:guid}/checklist"
@attribute [Authorize]
@using Orbit.Contracts.Inventories
@using Orbit.Core.Inventories
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject NavigationManager NavigationManager
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject ChecklistViewPreference ChecklistViewPreference
@inject InventoryApiClient InventoryApiClient
@inject IJSRuntime JSRuntime
@inject ILogger<TaskListChecklist> Logger
@inject Translations T

<PageTitle>@(_sections.Count > 0 ? Written(_sections[0].TaskList.Title) : T["Checklist"])</PageTitle>

@* The shallow half of the two editing levels: the deep editor (TaskEditor.razor) can change and remove
   anything, while this view only ticks items off. Everything else about a list is read-only here, which
   is what lets the whole list - and, for a group list, every list it gathers - stay on one screen. *@
@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else if (_sections.Count == 0)
{
    <p>@T["This task list no longer exists."]</p>
    <button type="button" class="btn-secondary" @onclick="GoToTaskLists">@T["Back to task lists"]</button>
}
else
{
@* Two panels, as every screen that reads one object has: the list on the left, and the panel that does
   not scroll on the right - see EditorRail. No Save: a tick is written the moment it is made, which is
   what a checklist is for. *@
<div class="editor-page">
<div class="editor-page-body">

    <PageHeader>
        <Title>@Written(_sections[0].TaskList.Title)</Title>
        <Subtitle>
            @if (_sections[0].TaskList.IsGroup)
            {
                <text>@T.Format("Group list - {0} linked {1} shown below.", _sections.Count - 1, _sections.Count == 2 ? T["list"] : T["lists"])</text>
            }
            else
            {
                <text>@T["Tick items off; use Edit to change the list itself."]</text>
            }
        </Subtitle>
    </PageHeader>

    @if (_errorMessage is not null)
    {
        <p class="error">@_errorMessage</p>
    }

    @* What this list's work costs against an inventory. Offered where the list actually has errands
       about stock - the panel used to appear on any group list, including ones with nothing on a shelf
       to count, where it could only ever say "nothing to measure". *@
    @if (HasInventoryWork)
    {
        <ItemCard Name="@(T["Related inventory"])"
                  OnNameSelected="@(HasSomethingToUnfold ? EventCallback.Factory.Create(this, ToggleStockCheckHiddenAsync) : default)"
                  IsCollapsed="_reading.IsStockCheckHidden"
                  OnCollapseToggled="@(HasSomethingToUnfold ? EventCallback.Factory.Create(this, ToggleStockCheckHiddenAsync) : default)">
            @* Which shelf this is counted against. At the end of the meta row rather than inside the
               body, because it is how the panel gets linked in the first place - unreachable while
               folded would mean unreachable before it has anything to fold. *@
            <Extras>
                <select class="options-select" value="@_linkedInventoryId" @onchange="OnInventoryChangedAsync"
                        @onclick:stopPropagation="true">
                    <option value="">@T["Not measured against an inventory"]</option>
                    @* Every storage, the ones other lists already measure included: a store serves as
                       many jobs as it holds things for, and the shelf is split between the lists asking
                       for it - see StockRequirementCounter. Which of them are shared is said in the
                       option itself rather than by leaving it out. *@
                    @foreach (var inventory in _inventories)
                    {
                        <option value="@inventory.Id">
                            @(_inventoriesMeasuredByAnotherList.Contains(inventory.Id)
                                ? T.Format("{0} (shared with another list)", inventory.Name)
                                : inventory.Name)
                        </option>
                    }
                </select>
                @if (_inventoryMessage is not null)
                {
                    <span class="row-meta">@_inventoryMessage</span>
                }
            </Extras>
            @* Only what order things are listed in. Show/Hide left: the card's own name and its
               collapse do that now, so the menu row was a third way to say the same thing. *@
            <Menu>
                <OverflowMenu StaysOpen="true">
                    <span class="overflow-menu-heading">@T["Sort"]</span>
                    @foreach (var stockOrder in Enum.GetValues<StockCheckOrder>())
                    {
                        <button type="button" class="avatar-dropdown-item @(stockOrder == _reading.StockOrder ? "chosen" : "")"
                                @onclick="() => SetStockOrderAsync(stockOrder)">
                            <span class="card-filter-mark">@(stockOrder == _reading.StockOrder ? "✓" : "")</span>
                            @DescribeStockOrder(stockOrder)
                        </button>
                    }
                </OverflowMenu>
            </Menu>
            <Body>
            @if (_stockCheck is { } stockCheck)
            {
                <p class="options-subtext">
                    @if (stockCheck.IsAchievable)
                    {
                        <text>@T["Everything this list needs is on the shelf."]</text>
                    }
                    else
                    {
                        <text>@T.Format("{0} of what this needs is short.", stockCheck.Requirements.Count(requirement => requirement.Missing > 0))</text>
                    }
                </p>
                <table class="permissions-table">
                    <thead>
                        <tr>
                            <th scope="col">@T["What"]</th>
                            <th scope="col">@T["Needed"]</th>
                            <th scope="col">@T["On the shelf"]</th>
                            <th scope="col">@T["Short"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var requirement in RequirementsToShow(stockCheck))
                        {
                            <tr class="@(requirement.Missing > 0 ? "stock-check-short" : "")">
                                <td>@requirement.Name</td>
                                <td>@requirement.Required</td>
                                <td>@requirement.Available</td>
                                <td>@(requirement.Missing > 0 ? requirement.Missing.ToString() : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!stockCheck.IsAchievable)
                {
                    <div class="form-actions">
                        <button type="button" class="btn-primary" disabled="@_isRaisingShortfalls" @onclick="RaiseShortfallsAsync">
                            @T["Add what is missing to the restock list"]
                        </button>
                    </div>
                }
                @if (_shortfallMessage is not null)
                {
                    <p class="info">@_shortfallMessage</p>
                }
            }
            </Body>
        </ItemCard>
    }

    @if (_reading.View == ChecklistView.Flat)
    {
        @* Every piece of actual work in the tree, in the order the lists come in, with the rows that
           only point at another list left out - those are how the tree is held together, not something
           to tick. *@
        <div class="card checklist-card">
            @if (FlatItemsToShow.Count == 0)
            {
                <p class="checklist-empty">@T["No items."]</p>
            }
            @foreach (var entry in FlatItemsToShow)
            {
                <label class="check-row @(entry.Item.IsCompleted ? "completed" : "")">
                    <input type="checkbox" checked="@entry.Item.IsCompleted"
                           disabled="@IsItemLocked(entry.Section, entry.Item)"
                           @onchange="args => ToggleItemAsync(entry.Section.TaskList, entry.Item, (bool)args.Value!)" />
                    <span class="check-row-text">@Written(entry.Item.Description)</span>
                    @* What it is about, the same marks the cards on /tasks carry - see TaskItem.Categories. *@
                    @foreach (var category in entry.Item.AllCategories)
                    {
                        <span class="row-category">@category</span>
                    }
                    @* Which list it came from, since the headings are gone in this view. *@
                    <span class="row-meta">@Written(entry.Section.TaskList.Title)</span>
                    @if (IsAChecklistEntry(entry.Item) && entry.Item.DueDateUtc is { } flatDueDate)
                    {
                        <span class="row-meta">@T.Format("due {0}", flatDueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm"))</span>
                    }
                </label>
            }
        </div>
    }
    else
    {
    @foreach (var section in _sections)
    {
        <div class="card checklist-card" style="--checklist-depth: @section.Depth">
            @if (section.IsMember)
            {
                <div class="card-header">
                    <span class="card-title">@Written(section.TaskList.Title)</span>
                    <span class="card-count">@CompletionSummary(section.TaskList)</span>
                </div>
            }

            @if (section.TaskList.Items.Count == 0)
            {
                <p class="checklist-empty">@T["No items."]</p>
            }
            else
            {
                @foreach (var item in ItemsToShow(section.TaskList))
                {
                    <div class="check-row @(item.IsCompleted ? "completed" : "") @(Highlight == item.Id ? "highlighted" : "")">
                        @* An entry standing for other lists is not ticked here - it is done when they
                           are. Pressed rather than refused: the box takes the press, says which list
                           the answer is on, and offers to go there. Prevented rather than disabled,
                           because a disabled box takes no press at all and had nothing to say. *@
                        <input type="checkbox" checked="@item.IsCompleted"
                               aria-label="@T.Format("Done: {0}", Written(item.Description))"
                               disabled="@IsItemLocked(section, item)"
                               @onclick="() => AskAboutTheListsBehind(item)"
                               @onclick:preventDefault="item.AllLinkedTaskListIds.Count > 0"
                               @onchange="args => ToggleItemAsync(section.TaskList, item, (bool)args.Value!)" />
                        @* Opens the entry to be worked on rather than ticking it off. Ticking is the
                           checkbox's job, and it was doing both: the row was a <label>, so reading a
                           line by tapping it completed it. *@
                        <button type="button" class="check-row-text"
                                @onclick="() => GoToEditItem(section.TaskList.Id, item.Id)">@Written(item.Description)</button>
                        @* What it is about, the same marks the cards on /tasks carry - see TaskItem.Categories. *@
                        @foreach (var category in item.AllCategories)
                        {
                            <span class="row-category">@category</span>
                        }
                        @* An inventory errand says which shelf it is about, and - when a second list is
                           asking for the same product - where else it is being asked for. Both are links
                           rather than labels: the reason to show them is to be able to go and look. *@
                        @if (ReferenceFor(item) is { } reference)
                        {
                            <span class="check-row-references" @onclick:stopPropagation="true">
                                <a class="reference-chip" href="@InventoryHref(reference)"
                                   @onclick="() => GoTo(InventoryHref(reference))" @onclick:preventDefault="true">
                                    @T.Format("in {0}", reference.InventoryName)
                                </a>
                                @foreach (var elsewhere in reference.AlsoAskedForBy)
                                {
                                    <a class="reference-chip" href="@TaskListHref(elsewhere)"
                                       @onclick="() => GoTo(TaskListHref(elsewhere))" @onclick:preventDefault="true">
                                        @T.Format("also on {0}", Written(elsewhere.TaskListTitle))
                                    </a>
                                }
                            </span>
                        }
                        @if (item.AllLinkedTaskListIds.Count > 0)
                        {
                            @* Every list it stands for, named: "follows Kitchen, Bathroom" says what
                               the row is waiting on, where "follows another list" says only that it is
                               waiting. *@
                            <span class="row-meta">@T.Format("follows {0}", LinkedTaskListTitles(item))</span>
                        }
                        @* A day to be done by belongs to a checklist entry - an appointment says when
                           it is in the calendar, and a restock errand is about an amount. Same rule as
                           the editor, which only asks a checklist entry for one. *@
                        else if (IsAChecklistEntry(item) && item.DueDateUtc is { } dueDate)
                        {
                            <span class="row-meta">@T.Format("due {0}", dueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm"))</span>
                        }
                    </div>
                    @if (_askedAbout == item.Id)
                    {
                        @* Under the row rather than in a dialog over the page: it is about this line,
                           and a reader who meant to tick something else should be able to see which
                           one they pressed. *@
                        <div class="check-row-asks">
                            <span>@T.Format("This is done when {0} is.", LinkedTaskListTitles(item))</span>
                            @foreach (var linkedTaskListId in item.AllLinkedTaskListIds)
                            {
                                <button type="button" class="btn-secondary"
                                        @onclick="() => GoToLinkedList(linkedTaskListId)">
                                    @(item.AllLinkedTaskListIds.Count == 1
                                        ? T["Yes"]
                                        : LinkedTaskListTitle(linkedTaskListId))
                                </button>
                            }
                            <button type="button" class="btn-secondary" @onclick="() => _askedAbout = null">@T["No"]</button>
                        </div>
                    }
                }
            }
        </div>
    }
    }

</div>
@* Everything this screen offers that is not "tick something off" - one menu rather than a row of
   buttons, because none of it is what somebody came here to do. It stays open while they set how the
   page reads, and the entries that act close it. *@
<EditorRail OnCancel="GoToTaskLists">
    <OverflowMenu @ref="_menu" StaysOpen="true">
        <span class="overflow-menu-heading">@T["Sort"]</span>
        @* What order to read the items in. Offered whatever the list looks like: a single long
           list is exactly where reading it off alphabetically helps. *@
        @foreach (var order in Enum.GetValues<ChecklistOrder>())
        {
            <button type="button" class="avatar-dropdown-item @(order == _reading.Order ? "chosen" : "")"
                    @onclick="() => SetOrder(order)">
                <span class="card-filter-mark">@(order == _reading.Order ? "✓" : "")</span>
                @DescribeOrder(order)
            </button>
        }

        <span class="overflow-menu-heading">@T["This list"]</span>
        @* Only for a tree deep enough to be worth flattening. A group whose members are plain
           lists already reads as one page with headings; the choice is what a nested one needs. *@
        @if (HasNestedLists)
        {
            <button type="button" class="avatar-dropdown-item" @onclick="ToggleView">
                @(_reading.View == ChecklistView.Flat ? T["Show the lists"] : T["Show single items"])
            </button>
        }
        <button type="button" class="avatar-dropdown-item" disabled="@(_savedReading == _reading)"
                @onclick="SaveViewAsync">
            @(_savedReading == _reading ? T["View saved"] : T["Save view"])
        </button>
        <button type="button" class="avatar-dropdown-item" @onclick="GoToDeepEditor">@T["Edit"]</button>
        @* One button where "Generate inventory" and "Recalculate against the inventory" used to
           be. Both did half of something else - one made an inventory out of a list, the other
           counted a list against one - and neither answered the question somebody has in front
           of a restock list, which is "is this still what I need?". Offered only there, since
           that is the only list Orbit maintains. *@
        @if (IsARestockList)
        {
            <button type="button" class="avatar-dropdown-item" disabled="@_isWorkingOnInventory"
                    @onclick="RefreshFromTheInventoryAsync">
                @T["Refresh"]
            </button>
        }
    </OverflowMenu>
</EditorRail>
</div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>
    /// One entry to draw attention to, when this page was opened by following a reference to it. From
    /// the query string rather than the route: it is a hint about what to look at, not part of what
    /// this page is, and a link shared without it still opens the same list.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "highlight")]
    public Guid? Highlight { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;

    /// <summary>What each inventory errand on this list is about - see TasksApiClient.GetInventoryReferencesAsync.</summary>
    private IReadOnlyList<InventoryReferenceDto> _inventoryReferences = [];

    /// <summary>
    /// The list being viewed first, then - when it's a group list - every list its items link to. Kept
    /// as one flat ordered collection because the view renders them identically apart from the header.
    /// </summary>
    private IReadOnlyList<ChecklistSection> _sections = [];

    /// <summary>
    /// How this list is being read right now, and how it was saved to open. They differ while somebody
    /// is trying another view or order without having kept it.
    /// </summary>
    private ChecklistReading _reading = ChecklistReading.Default;
    private ChecklistReading? _savedReading;

    /// <summary>
    /// The header menu, held so the entries that act - rather than set how the page reads - can shut it
    /// behind them. See OverflowMenu.Close.
    /// </summary>
    private OverflowMenu? _menu;

    /// <summary>The inventories this reader could measure against, and which one is chosen.</summary>
    private IReadOnlyList<InventoryDto> _inventories = [];
    private string _linkedInventoryId = string.Empty;
    private TaskListStockCheckDto? _stockCheck;
    private bool _isRaisingShortfalls;
    private string? _shortfallMessage;
    private bool _isWorkingOnInventory;

    /// <summary>
    /// Whether anything here is nested deeply enough to be worth flattening. A group whose members are
    /// all plain lists already reads as one page with headings.
    /// </summary>
    private bool HasNestedLists => _sections.Any(section => section.Depth > 1);

    /// <summary>
    /// Every piece of actual work in the tree, each with the list it belongs to - ticking one still has
    /// to save against its own list. Rows that only point at another list are left out: they are how
    /// the tree is held together, and their state follows the list they point at anyway (see
    /// LinkedTaskCompletionResolver).
    /// </summary>
    private IReadOnlyList<FlatChecklistEntry> _flatItems =>
        [.. _sections.SelectMany(section => section.TaskList.Items
            .Where(item => item.AllLinkedTaskListIds.Count == 0)
            .Select(item => new FlatChecklistEntry(section, item)))];

    /// <summary>
    /// Every list the user can reach, kept from the same load: it's what resolves a group's members and
    /// what gives a linked item's target list a title to show.
    /// </summary>
    private IReadOnlyList<TaskDto> _allTaskLists = [];

    /// <summary>Whether to offer the Google links - see GoogleIntegrationAccess for who qualifies.</summary>
    private bool _hasGoogleExtras;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _allTaskLists = await TasksApiClient.GetTaskListsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the checklist for task list {TaskListId}", Id);
            _errorMessage = T["Couldn't load this task list. Try again."];
            _isLoading = false;
            return;
        }

        _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
        _sections = BuildSections();
        await SettleFinishedErrandsAsync();
        await LoadInventoryReferencesAsync();
        await LoadStockCheckAsync();
        // Only asked for once the sections are built, since whether the saved view still applies
        // depends on what this list turned out to hold.
        _savedReading = WhatStillApplies(await ChecklistViewPreference.GetAsync(Id));
        _reading = _savedReading ?? ChecklistReading.Default;

        _isLoading = false;
    }

    /// <summary>
    /// A group list is followed all the way down: the lists its items link to, the lists those link to,
    /// and so on, so one screen shows the whole tree rather than stopping at the first row of members.
    ///
    /// Depth-first, so a list appears directly under the one that linked to it rather than after all of
    /// its siblings' subtrees. Each list is shown once however many places link to it - the second
    /// appearance would carry the same items and the same checkboxes, and ticking one would leave the
    /// other looking untouched.
    /// </summary>
    private IReadOnlyList<ChecklistSection> BuildSections()
    {
        var taskList = _allTaskLists.FirstOrDefault(candidate => candidate.Id == Id);
        if (taskList is null)
        {
            return [];
        }

        var sections = new List<ChecklistSection>();
        AppendWithMembers(taskList, depth: 0, [], sections);
        return sections;
    }

    /// <summary>
    /// Adds one list and everything below it. <paramref name="alreadyShown"/> is what stops a list that
    /// links back to one of its own ancestors - or to itself - from unfolding forever.
    /// </summary>
    private void AppendWithMembers(
        TaskDto taskList, int depth, HashSet<Guid> alreadyShown, List<ChecklistSection> sections)
    {
        if (!alreadyShown.Add(taskList.Id))
        {
            return;
        }

        sections.Add(new ChecklistSection(taskList, IsMember: depth > 0, depth));
        if (!taskList.IsGroup)
        {
            return;
        }

        foreach (var memberId in taskList.Items.SelectMany(item => item.AllLinkedTaskListIds))
        {
            if (_allTaskLists.FirstOrDefault(candidate => candidate.Id == memberId) is { } member)
            {
                AppendWithMembers(member, depth + 1, alreadyShown, sections);
            }
        }
    }

    /// <summary>
    /// A read-only share grants no writes at all, so its boxes are shown and cannot be moved. An entry
    /// standing for other lists is not disabled: its completion still mirrors the lists it points at
    /// (see LinkedTaskCompletionResolver), but the press is worth taking - see AskAboutTheListsBehind.
    /// </summary>
    private static bool IsItemLocked(ChecklistSection section, TaskItemDto item)
        => section.TaskList.AccessLevel != nameof(ShareAccessLevel.CanEdit);

    /// <summary>The entry whose lists are being offered right now, if any - see the prompt under the row.</summary>
    private Guid? _askedAbout;

    /// <summary>
    /// Answers a press on a box that cannot be ticked here, by saying where the answer actually is. An
    /// ordinary entry says nothing: it was ticked, which is answer enough.
    /// </summary>
    private void AskAboutTheListsBehind(TaskItemDto item)
        => _askedAbout = item.AllLinkedTaskListIds.Count > 0 ? item.Id : null;

    private void GoToLinkedList(Guid linkedTaskListId)
    {
        _askedAbout = null;
        Logger.LogInformation("User opened linked task list {LinkedTaskListId} from a checklist", linkedTaskListId);
        NavigationManager.NavigateTo($"/tasks/{linkedTaskListId}");
    }

    /// <summary>
    /// The lists an entry stands for, named and joined - an entry naming three of them is one step, and
    /// saying so takes naming all three.
    /// </summary>
    private string LinkedTaskListTitles(TaskItemDto item)
        => string.Join(", ", item.AllLinkedTaskListIds.Select(LinkedTaskListTitle));

    private string LinkedTaskListTitle(Guid linkedTaskListId)
        => _allTaskLists.FirstOrDefault(candidate => candidate.Id == linkedTaskListId) is { } linked
            ? Written(linked.Title)
            : T["another list"];

    /// <summary>
    /// Whether this is the list an inventory keeps for itself. Only Orbit maintains one of those, so it
    /// is the only list where "rebuild it from what is true now" means anything.
    /// </summary>
    private bool IsARestockList
        => _sections.Count > 0 && RestockTaskNaming.IsManagedTitle(_sections[0].TaskList.Title);

    /// <summary>
    /// Rebuilds this list against the inventory behind it and the settings that inventory carries - what
    /// somebody presses when the world changed rather than the list. Re-reads afterwards, since the
    /// point of asking is to see the answer.
    /// </summary>
    private async Task RefreshFromTheInventoryAsync()
    {
        _menu?.Close();
        if (await InventoryBehindThisListAsync() is not { } inventoryId)
        {
            return;
        }

        _isWorkingOnInventory = true;
        _shortfallMessage = null;
        try
        {
            var result = await InventoryApiClient.RefreshRestockListAsync(inventoryId);
            _shortfallMessage = result.AddedCount == 0 && result.RemovedCount == 0
                ? T["The restock list already asks for exactly what it should."]
                : T.Format("Restock list updated: {0} added, {1} removed.", result.AddedCount, result.RemovedCount);
            _allTaskLists = await TasksApiClient.GetTaskListsAsync();
            _sections = BuildSections();
            await LoadInventoryReferencesAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to refresh the restock list for task list {TaskListId}", Id);
            _errorMessage = T["That didn't work. Try again."];
        }
        finally
        {
            _isWorkingOnInventory = false;
        }
    }

    /// <summary>
    /// Which inventory keeps this list. Read off the errands on it rather than from a route of its own:
    /// every one names the shelf item it is about, and every one of those is in the same inventory.
    /// </summary>
    private async Task<Guid?> InventoryBehindThisListAsync()
    {
        if (_inventoryReferences.Count > 0)
        {
            return _inventoryReferences[0].InventoryId;
        }

        // A list with nothing on it yet has no errand to read an inventory off. The one the list is
        // measured against is the next best answer, and for a restock list it is the same inventory.
        return Guid.TryParse(_linkedInventoryId, out var linked) ? linked : null;
    }

    /// <summary>
    /// Settles anything already crossed off on a restock list: each finished errand fills its shelf item
    /// and leaves the list. Asked for on opening rather than only on saving, so a list that accumulated
    /// crossed-off errands before Orbit did this clears itself the first time somebody looks at it - and
    /// the list is re-read afterwards, since it is the thing that changed.
    ///
    /// Best effort: a settle that fails leaves the list exactly as it was, which is readable, so it is
    /// not worth an error bar over the checklist somebody came here to use.
    /// </summary>
    private async Task SettleFinishedErrandsAsync()
    {
        if (_sections.Count == 0 || !RestockTaskNaming.IsManagedTitle(_sections[0].TaskList.Title))
        {
            return;
        }

        try
        {
            if (await TasksApiClient.ReconcileRestockingAsync(Id) == 0)
            {
                return;
            }

            _allTaskLists = await TasksApiClient.GetTaskListsAsync();
            _sections = BuildSections();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Couldn't settle the finished errands on task list {TaskListId}", Id);
        }
    }

    private async Task LoadInventoryReferencesAsync()
    {
        try
        {
            _inventoryReferences = await TasksApiClient.GetInventoryReferencesAsync(Id);
        }
        catch (HttpRequestException exception)
        {
            // The entries still read as what they say; they just have nothing to follow.
            Logger.LogWarning(exception, "Couldn't load the inventory references for task list {TaskListId}", Id);
            _inventoryReferences = [];
        }
    }

    private InventoryReferenceDto? ReferenceFor(TaskItemDto item)
        => _inventoryReferences.FirstOrDefault(reference => reference.TaskItemId == item.Id);

    /// <summary>
    /// The inventory this errand's product sits in, with the product itself named so the page that opens
    /// can draw attention to it rather than leaving somebody to find one row among fifty.
    /// </summary>
    private static string InventoryHref(InventoryReferenceDto reference)
        => $"/inventory/{reference.InventoryId}?highlight={reference.InventoryItemId}";

    private static string TaskListHref(InventoryReferenceElsewhereDto elsewhere)
        => $"/tasks/{elsewhere.TaskListId}?highlight={elsewhere.TaskItemId}";

    /// <summary>
    /// Follows a reference. Handled here rather than left to the browser so that going from one task
    /// list to another is a parameter change Blazor can make in place - an ordinary href would reload
    /// the whole application to arrive at the same page.
    /// </summary>
    /// <summary>
    /// Whether anything on this list is an errand about stock. The panel counts inventory work, so a
    /// list with none of it has nothing to count - it used to appear on every group list regardless,
    /// where the only thing it could say was that there was nothing to measure.
    /// </summary>
    private bool HasInventoryWork
        => _sections.Any(section => section.TaskList.Items.Any(
            item => item.Kind == nameof(Orbit.Core.Tasks.TaskItemKind.Inventory)));

    /// <summary>
    /// Whether there is a count to fold away. Asked of the count itself rather than of the inventory
    /// picker: what makes the card worth unfolding is having something inside it, and keying the
    /// offer to the link meant a card with a count in it that refused to fold.
    /// </summary>
    private bool HasSomethingToUnfold => _stockCheck is not null;

    private void GoTo(string href) => NavigationManager.NavigateTo(href);

    /// <summary>
    /// Opens the deep editor with this entry already unfolded. The checklist is for ticking things off;
    /// changing what an entry actually is - its day, its place, what it is about - is the editor's job,
    /// and this is the way there from the line itself.
    /// </summary>
    private void GoToEditItem(Guid taskListId, Guid itemId)
        => NavigationManager.NavigateTo($"/tasks/{taskListId}/items/{itemId}/edit");

    /// <summary>Whether this entry is ordinary work rather than an appointment or a restock errand.</summary>
    private static bool IsAChecklistEntry(TaskItemDto item)
        => item.Kind == nameof(Orbit.Core.Tasks.TaskItemKind.Checklist);

    /// <summary>A name Orbit wrote itself, in the reader's language - see OrbitWrittenNames.</summary>
    private string Written(string name) => OrbitWrittenNames.Translate(key => T[key], name);

    private static string CompletionSummary(TaskDto taskList)
        => $"{taskList.Items.Count(item => item.IsCompleted)}/{taskList.Items.Count}";

    /// <summary>
    /// Saves the whole list back with just this item's completion changed - the update endpoint replaces
    /// the list wholesale, so everything else has to be sent along unchanged. Items are matched by
    /// position rather than id because a save regenerates item ids (see TaskEndpoints.ToDomainItems).
    /// </summary>
    private async Task ToggleItemAsync(TaskDto taskList, TaskItemDto item, bool isCompleted)
    {
        _errorMessage = null;
        if (isCompleted && await AskedToFinishTheWholeRestockAsync(taskList, item))
        {
            return;
        }

        var toggledIndex = taskList.Items.ToList().IndexOf(item);
        // Everything as it already is, with one item's completion changed - see TaskItemRequest.From on
        // why the fields are not listed here.
        var items = taskList.Items
            .Select((existingItem, index) => TaskItemRequest.From(existingItem) with
            {
                IsCompleted = index == toggledIndex ? isCompleted : existingItem.IsCompleted
            })
            .ToList();

        try
        {
            var outcome = await TasksApiClient.UpdateTaskListAsync(
                taskList.Id, new UpdateTaskRequest(taskList.Title, items, taskList.IsGroup));
            if (outcome.Kind == EditOutcomeKind.Locked)
            {
                _errorMessage = T.Format("{0} is currently editing \"{1}\" - try again in a moment.", outcome.LockedByUserName, taskList.Title);
            }
            else if (outcome.Kind == EditOutcomeKind.NotFound)
            {
                _errorMessage = T.Format("\"{0}\" is no longer available to you.", taskList.Title);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to toggle an item on task list {TaskListId}", taskList.Id);
            _errorMessage = T["Couldn't save that change. Try again."];
        }

        // Reloads even after a failure, so a checkbox that didn't save snaps back to what the server
        // actually holds - and after a success, so a group's linked items pick up their new completion.
        await LoadAsync();

        TidyTheRestockListShortly();
    }

    /// <summary>How long a crossed-off restock errand stays on the list before a refresh clears it.</summary>
    private static readonly TimeSpan RestockTidyDelay = TimeSpan.FromMinutes(5);

    /// <summary>The pending tidy-up, while one is waiting - restarted by each tick, cancelled on leaving.</summary>
    private CancellationTokenSource? _restockTidy;

    /// <summary>
    /// Asks for the refresh that takes finished errands off the restock list, a few minutes from now.
    ///
    /// Crossing one off used to remove it in the same breath, so a row answered a tap by vanishing -
    /// and a tap on the wrong row could not be undone by untapping it, because there was nothing left
    /// to untap. The shelf is still filled at once (see RestockCompletion.TopUpFinishedAsync); only
    /// the tidying waits.
    ///
    /// Restarted on every tick rather than queued once per tick: somebody working down a list ticks
    /// six things in a minute, and six refreshes would be five more than the list needs. The wait
    /// therefore measures from the last one, which is also when they have stopped and might look back.
    /// </summary>
    private void TidyTheRestockListShortly()
    {
        _restockTidy?.Cancel();
        _restockTidy?.Dispose();
        _restockTidy = new CancellationTokenSource();
        var waiting = _restockTidy.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(RestockTidyDelay, waiting);
                await InvokeAsync(RefreshFromTheInventoryAsync);
            }
            catch (OperationCanceledException)
            {
                // Another tick came in, or the page went away. Either way this one is not wanted.
            }
            catch (Exception exception)
            {
                // Nothing here is worth interrupting somebody over: the list is correct as it stands,
                // it just has crossed-off rows still on it, and the next refresh settles them.
                Logger.LogWarning(exception, "The restock list could not be tidied up after a delay");
            }
        }, waiting);
    }

    public void Dispose()
    {
        _restockTidy?.Cancel();
        _restockTidy?.Dispose();
    }

    private void GoToDeepEditor()
    {
        _menu?.Close();
        NavigationManager.NavigateTo($"/tasks/{Id}/edit");
    }

    private void GoToTaskLists() => NavigationManager.NavigateTo("/tasks");

    /// <summary>One list rendered in this view - the list being viewed, or one of a group list's members.</summary>
    /// <param name="Depth">How far below the list being viewed this one sits - 0 for that list itself.</param>
    private sealed record ChecklistSection(TaskDto TaskList, bool IsMember, int Depth);

    /// <summary>One item in the flattened view, with the list it came from - shown beside it, and saved against.</summary>
    private sealed record FlatChecklistEntry(ChecklistSection Section, TaskItemDto Item);

    /// <summary>
    /// Reads the inventories to choose from and, when one is already chosen, what the work costs against
    /// it.
    ///
    /// For any list, not only a group one. It was group-only on the grounds that a single list's items
    /// are the work in front of you rather than a bill of materials - but the panel above only appears
    /// where a list actually holds inventory entries, and on a plain list holding some this left the
    /// picker with nothing in it and the count unread. A list with errands about stock is asking the
    /// question whether or not it gathers other lists.
    /// </summary>
    private async Task LoadStockCheckAsync()
    {
        if (_sections.Count == 0)
        {
            return;
        }

        try
        {
            _inventories = await InventoryApiClient.GetInventoriesAsync();
            _linkedInventoryId = _sections[0].TaskList.LinkedInventoryId?.ToString() ?? string.Empty;
            // Which shelves some other list already measures, so the picker can say which of them would
            // be shared - see LinkTaskListToInventoryCommandHandler, which allows the sharing.
            _inventoriesMeasuredByAnotherList =
            [
                .. (await TasksApiClient.GetTaskListsAsync())
                    .Where(taskList => taskList.Id != Id && taskList.LinkedInventoryId is not null)
                    .Select(taskList => taskList.LinkedInventoryId!.Value)
            ];
            _stockCheck = await TasksApiClient.GetStockCheckAsync(Id);
        }
        catch (HttpRequestException exception)
        {
            // The checklist itself is the point of this page; not being able to price it against a
            // inventory leaves the panel empty rather than taking the page down.
            Logger.LogWarning(exception, "Could not read the stock check for task list {TaskListId}", Id);
        }
    }

    /// <summary>
    /// Every inventory some other list of this account's already measures. Still on offer, and named as
    /// shared in the picker - see the option there.
    /// </summary>
    private HashSet<Guid> _inventoriesMeasuredByAnotherList = [];

    /// <summary>What the picker says back when a choice did not take. Null while nothing needs saying.</summary>
    private string? _inventoryMessage;

    private async Task OnInventoryChangedAsync(ChangeEventArgs args)
    {
        var chosen = args.Value?.ToString();
        _linkedInventoryId = chosen ?? string.Empty;
        _shortfallMessage = null;
        _inventoryMessage = null;
        Guid? inventoryId = Guid.TryParse(chosen, out var parsed) ? parsed : null;
        Logger.LogInformation("User measured task list {TaskListId} against inventory {InventoryId}", Id, inventoryId);

        try
        {
            if (!await TasksApiClient.LinkInventoryAsync(Id, inventoryId))
            {
                // The picker leaves out what is already spoken for, so this is a shelf that was taken
                // between the page loading and the choice being made. Said out loud rather than left as
                // a select that snaps back for no visible reason.
                _inventoryMessage = T["That storage is already measured against another list."];
                _linkedInventoryId = _sections.Count > 0
                    ? _sections[0].TaskList.LinkedInventoryId?.ToString() ?? string.Empty
                    : string.Empty;
                return;
            }

            _stockCheck = inventoryId is null ? null : await TasksApiClient.GetStockCheckAsync(Id);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to measure task list {TaskListId} against an inventory", Id);
            _inventoryMessage = T["Couldn't measure this list against that storage. Try again."];
        }
    }

    /// <summary>
    /// Puts what is short onto the inventory's standing restock list, where the daily reminder brings it
    /// up, then re-reads the check - the shelf has not changed, but what is already waiting has.
    /// </summary>
    private async Task RaiseShortfallsAsync()
    {
        _isRaisingShortfalls = true;
        _shortfallMessage = null;
        try
        {
            var added = await TasksApiClient.RaiseStockShortfallsAsync(Id);
            _shortfallMessage = added == 0
                ? T["Everything short was already on the restock list."]
                : T.Format("{0} added to the restock list.", added);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to raise stock shortfalls for task list {TaskListId}", Id);
            _shortfallMessage = T["Couldn't add those to the restock list."];
        }
        finally
        {
            _isRaisingShortfalls = false;
        }
    }

    /// <summary>
    /// Crossing off "Update stock levels" while errands are still open on the same list is either the
    /// end of a round of restocking or a tick on one reminder. Only the reader knows which, so they are
    /// asked - and answering yes finishes the rest and brings the shelf up to its minimums in one go.
    /// Answers whether it handled the tick, so the ordinary save is skipped when it did.
    /// </summary>
    private async Task<bool> AskedToFinishTheWholeRestockAsync(TaskDto taskList, TaskItemDto item)
    {
        if (item.Description != RestockTaskNaming.UpdateStockReminderDescription
            || !taskList.Items.Any(other => other.Id != item.Id && !other.IsCompleted))
        {
            return false;
        }

        if (!await JSRuntime.InvokeAsync<bool>(
                "confirm", T["Finish this list and set every item in the inventory to its minimum?"]))
        {
            return false;
        }

        try
        {
            var toppedUp = await TasksApiClient.FinishRestockingAsync(taskList.Id);
            Logger.LogInformation(
                "User finished restocking from task list {TaskListId}, topping up {ToppedUpCount} items", taskList.Id, toppedUp);
            _shortfallMessage = T.Format("{0} brought up to their minimum.", toppedUp);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to finish restocking from task list {TaskListId}", taskList.Id);
            _errorMessage = T["Couldn't finish the restocking. Try again."];
            return true;
        }

        await LoadAsync();
        return true;
    }

    private void ToggleView()
    {
        _reading = _reading with { View = _reading.View == ChecklistView.Flat ? ChecklistView.Tree : ChecklistView.Flat };
        Logger.LogInformation("User switched the checklist to the {View} view", _reading.View);
    }

    /// <summary>
    /// Puts the panel that prices this list against an inventory out of the way, or brings it back -
    /// remembered as it is set rather than waiting for "Save view", since a panel somebody keeps putting
    /// away every visit is one they have already answered about.
    /// </summary>
    private async Task ToggleStockCheckHiddenAsync()
    {
        _reading = _reading with { IsStockCheckHidden = !_reading.IsStockCheckHidden };
        Logger.LogInformation(
            "User {Action} the stock check on task list {TaskListId}", _reading.IsStockCheckHidden ? "hid" : "showed", Id);
        await RememberAsync(saved => saved with { IsStockCheckHidden = _reading.IsStockCheckHidden });
    }

    /// <summary>What order the panel lists what the work needs in - remembered the same way, and for the same reason.</summary>
    private async Task SetStockOrderAsync(StockCheckOrder stockOrder)
    {
        _reading = _reading with { StockOrder = stockOrder };
        Logger.LogInformation("User ordered the stock check by {StockOrder} on task list {TaskListId}", stockOrder, Id);
        await RememberAsync(saved => saved with { StockOrder = stockOrder });
    }

    /// <summary>
    /// Keeps one part of how this list reads without keeping the rest: somebody trying another view or
    /// order has not said they want it back tomorrow, and "Save view" is how they say that.
    /// </summary>
    private async Task RememberAsync(Func<ChecklistReading, ChecklistReading> change)
    {
        _savedReading = change(_savedReading ?? ChecklistReading.Default);
        await ChecklistViewPreference.SaveAsync(Id, _savedReading);
    }

    private void SetOrder(ChecklistOrder order)
    {
        _reading = _reading with { Order = order };
        Logger.LogInformation("User read task list {TaskListId} in {Order} order", Id, order);
    }

    private string DescribeOrder(ChecklistOrder order) => order switch
    {
        ChecklistOrder.Alphabetical => T["A to Z"],
        ChecklistOrder.UndoneFirst => T["Left to do first"],
        _ => T["In list order"]
    };

    private string DescribeStockOrder(StockCheckOrder stockOrder) => stockOrder switch
    {
        StockCheckOrder.Alphabetical => T["A to Z"],
        StockCheckOrder.ReverseAlphabetical => T["Z to A"],
        StockCheckOrder.ShortFirst => T["Short first"],
        _ => T["In list order"]
    };

    /// <summary>
    /// What the panel needs, in the order this reader asked for. "Short first" groups by whether the
    /// shelf covers a line at all, which is the only thing on this table anybody has to act on.
    /// </summary>
    private IReadOnlyList<StockRequirementDto> RequirementsToShow(TaskListStockCheckDto stockCheck) => _reading.StockOrder switch
    {
        StockCheckOrder.Alphabetical =>
            [.. stockCheck.Requirements.OrderBy(requirement => requirement.Name, StringComparer.CurrentCultureIgnoreCase)],
        StockCheckOrder.ReverseAlphabetical =>
            [.. stockCheck.Requirements.OrderByDescending(requirement => requirement.Name, StringComparer.CurrentCultureIgnoreCase)],
        StockCheckOrder.ShortFirst =>
            [.. stockCheck.Requirements
                .OrderByDescending(requirement => requirement.Missing > 0)
                .ThenBy(requirement => requirement.Name, StringComparer.CurrentCultureIgnoreCase)],
        _ => stockCheck.Requirements
    };

    /// <summary>Keeps the way this list is being read now as the way it opens next time - on this device.</summary>
    private async Task SaveViewAsync()
    {
        Logger.LogInformation(
            "User saved the {View} view in {Order} order as the default for task list {TaskListId}",
            _reading.View, _reading.Order, Id);
        await ChecklistViewPreference.SaveAsync(Id, _reading);
        _savedReading = _reading;
    }

    /// <summary>
    /// A saved reading, with the flat view dropped when there is no longer anything to flatten: a list
    /// can lose the nesting it was saved flat for, and would otherwise open in a view it can't offer.
    /// </summary>
    private ChecklistReading? WhatStillApplies(ChecklistReading? saved)
        => saved is null || HasNestedLists ? saved : saved with { View = ChecklistView.Tree };

    /// <summary>
    /// One list's items the way this reader asked for them. Alphabetical is by what each item says,
    /// which is how a shopping list gets read off in a shop; as arranged is the order the list was
    /// written in, which is what dragging items about in the editor sets.
    /// </summary>
    private IReadOnlyList<TaskItemDto> ItemsToShow(TaskDto taskList) => _reading.Order switch
    {
        ChecklistOrder.Alphabetical => [.. taskList.Items.OrderBy(item => item.Description, StringComparer.CurrentCultureIgnoreCase)],
        ChecklistOrder.UndoneFirst => [.. taskList.Items
            .OrderBy(item => item.IsCompleted)
            .ThenBy(item => item.Description, StringComparer.CurrentCultureIgnoreCase)],
        _ => taskList.Items
    };

    /// <summary>
    /// The flat view's items in the chosen order. Alphabetical runs across the whole tree here rather
    /// than list by list: the headings are gone in this view, so a list-by-list sort would look random.
    /// </summary>
    private IReadOnlyList<FlatChecklistEntry> FlatItemsToShow => _reading.Order switch
    {
        ChecklistOrder.Alphabetical => [.. _flatItems.OrderBy(entry => entry.Item.Description, StringComparer.CurrentCultureIgnoreCase)],
        ChecklistOrder.UndoneFirst => [.. _flatItems
            .OrderBy(entry => entry.Item.IsCompleted)
            .ThenBy(entry => entry.Item.Description, StringComparer.CurrentCultureIgnoreCase)],
        _ => _flatItems
    };
}
