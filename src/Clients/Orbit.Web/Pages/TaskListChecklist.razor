@page "/tasks/{Id:guid}/checklist"
@attribute [Authorize]
@using Orbit.Contracts.Tasks
@using Orbit.Core.Abstractions
@using Orbit.Web.Services
@inject TasksApiClient TasksApiClient
@inject NavigationManager NavigationManager
@inject GoogleIntegrationAccess GoogleIntegrationAccess
@inject ChecklistViewPreference ChecklistViewPreference
@inject ILogger<TaskListChecklist> Logger
@inject Translations T

<PageTitle>@(_sections.Count > 0 ? _sections[0].TaskList.Title : T["Checklist"])</PageTitle>

@* The shallow half of the two editing levels: the deep editor (TaskEditor.razor) can change and remove
   anything, while this view only ticks items off. Everything else about a list is read-only here, which
   is what lets the whole list - and, for a group list, every list it gathers - stay on one screen. *@
@if (_isLoading)
{
    <p>@T["Loading…"]</p>
}
else if (_sections.Count == 0)
{
    <p>@T["This task list no longer exists."]</p>
    <button type="button" class="btn-secondary" @onclick="GoToTaskLists">@T["Back to task lists"]</button>
}
else
{
    <div class="page-header">
        <div>
            <h1>@_sections[0].TaskList.Title</h1>
            <p class="page-subtitle">
                @if (_sections[0].TaskList.IsGroup)
                {
                    <text>@T.Format("Group list - {0} linked {1} shown below.", _sections.Count - 1, _sections.Count == 2 ? T["list"] : T["lists"])</text>
                }
                else
                {
                    <text>@T["Tick items off; use Edit to change the list itself."]</text>
                }
            </p>
        </div>
        <div class="page-header-actions">
            @* Only for a tree deep enough to be worth flattening. A group whose members are plain lists
               already reads as one page with headings; the choice is what a nested one needs. *@
            @if (HasNestedLists)
            {
                <button type="button" class="btn-secondary" @onclick="ToggleViewAsync">
                    @(_view == ChecklistView.Flat ? T["Show the lists"] : T["Show single items"])
                </button>
                <button type="button" class="btn-secondary" disabled="@(_savedView == _view)" @onclick="SaveViewAsync">
                    @(_savedView == _view ? T["View saved"] : T["Save view"])
                </button>
            }
            <button type="button" class="btn-secondary" @onclick="GoToDeepEditor">@T["Edit"]</button>
            <button type="button" class="btn-secondary" @onclick="GoToTaskLists">@T["Back"]</button>
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <p class="error">@_errorMessage</p>
    }

    @if (_view == ChecklistView.Flat)
    {
        @* Every piece of actual work in the tree, in the order the lists come in, with the rows that
           only point at another list left out - those are how the tree is held together, not something
           to tick. *@
        <div class="card checklist-card">
            @if (_flatItems.Count == 0)
            {
                <p class="checklist-empty">@T["No items."]</p>
            }
            @foreach (var entry in _flatItems)
            {
                <label class="check-row @(entry.Item.IsCompleted ? "completed" : "")">
                    <input type="checkbox" checked="@entry.Item.IsCompleted"
                           disabled="@IsItemLocked(entry.Section, entry.Item)"
                           @onchange="args => ToggleItemAsync(entry.Section.TaskList, entry.Item, (bool)args.Value!)" />
                    <span class="check-row-text">@entry.Item.Description</span>
                    @* Which list it came from, since the headings are gone in this view. *@
                    <span class="row-meta">@entry.Section.TaskList.Title</span>
                    @if (entry.Item.DueDateUtc is { } flatDueDate)
                    {
                        <span class="row-meta">@T.Format("due {0}", flatDueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm"))</span>
                    }
                </label>
            }
        </div>
    }
    else
    {
    @foreach (var section in _sections)
    {
        <div class="card checklist-card" style="--checklist-depth: @section.Depth">
            @if (section.IsMember)
            {
                <div class="card-header">
                    <span class="card-title">@section.TaskList.Title</span>
                    <span class="card-count">@CompletionSummary(section.TaskList)</span>
                </div>
            }

            @if (section.TaskList.Items.Count == 0)
            {
                <p class="checklist-empty">@T["No items."]</p>
            }
            else
            {
                @foreach (var item in section.TaskList.Items)
                {
                    <label class="check-row @(item.IsCompleted ? "completed" : "")">
                        <input type="checkbox" checked="@item.IsCompleted"
                               disabled="@IsItemLocked(section, item)"
                               @onchange="args => ToggleItemAsync(section.TaskList, item, (bool)args.Value!)" />
                        <span class="check-row-text">@item.Description</span>
                        @if (item.LinkedTaskListId is { } linkedTaskListId)
                        {
                            <span class="row-meta">@T.Format("follows {0}", LinkedTaskListTitle(linkedTaskListId))</span>
                        }
                        else if (item.DueDateUtc is { } dueDate)
                        {
                            <span class="row-meta">@T.Format("due {0}", dueDate.LocalDateTime.ToString("dd.MM.yyyy HH:mm"))</span>
                            @if (_hasGoogleExtras)
                            {
                                @* Google Calendar template links can't create a task, so a deadline
                                   becomes a short event ending at it - see GoogleCalendarEventLink. *@
                                <a class="google-link" href="@GoogleCalendarEventLink.ForTaskItem(item.Description, dueDate, section.TaskList.Title)"
                                   target="_blank" rel="noopener" @onclick:stopPropagation="true">@T["Add to Google Calendar"]</a>
                            }
                        }
                    </label>
                }
            }
        </div>
    }
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;

    /// <summary>
    /// The list being viewed first, then - when it's a group list - every list its items link to. Kept
    /// as one flat ordered collection because the view renders them identically apart from the header.
    /// </summary>
    private IReadOnlyList<ChecklistSection> _sections = [];

    /// <summary>
    /// Which way this list is being read right now, and which way it was saved to open. They differ
    /// while somebody is trying the other view without having kept it.
    /// </summary>
    private ChecklistView _view = ChecklistView.Tree;
    private ChecklistView? _savedView;

    /// <summary>
    /// Whether anything here is nested deeply enough to be worth flattening. A group whose members are
    /// all plain lists already reads as one page with headings.
    /// </summary>
    private bool HasNestedLists => _sections.Any(section => section.Depth > 1);

    /// <summary>
    /// Every piece of actual work in the tree, each with the list it belongs to - ticking one still has
    /// to save against its own list. Rows that only point at another list are left out: they are how
    /// the tree is held together, and their state follows the list they point at anyway (see
    /// LinkedTaskCompletionResolver).
    /// </summary>
    private IReadOnlyList<FlatChecklistEntry> _flatItems =>
        [.. _sections.SelectMany(section => section.TaskList.Items
            .Where(item => item.LinkedTaskListId is null)
            .Select(item => new FlatChecklistEntry(section, item)))];

    /// <summary>
    /// Every list the user can reach, kept from the same load: it's what resolves a group's members and
    /// what gives a linked item's target list a title to show.
    /// </summary>
    private IReadOnlyList<TaskDto> _allTaskLists = [];

    /// <summary>Whether to offer the Google links - see GoogleIntegrationAccess for who qualifies.</summary>
    private bool _hasGoogleExtras;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _allTaskLists = await TasksApiClient.GetTaskListsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the checklist for task list {TaskListId}", Id);
            _errorMessage = T["Couldn't load this task list. Try again."];
            _isLoading = false;
            return;
        }

        _hasGoogleExtras = await GoogleIntegrationAccess.IsAvailableAsync();
        _sections = BuildSections();
        // Only asked for once the sections are built: a list with nothing nested in it has no second
        // view to open in, whatever was saved for it before.
        if (HasNestedLists)
        {
            _savedView = await ChecklistViewPreference.GetAsync(Id);
            _view = _savedView ?? ChecklistView.Tree;
        }

        _isLoading = false;
    }

    /// <summary>
    /// A group list is followed all the way down: the lists its items link to, the lists those link to,
    /// and so on, so one screen shows the whole tree rather than stopping at the first row of members.
    ///
    /// Depth-first, so a list appears directly under the one that linked to it rather than after all of
    /// its siblings' subtrees. Each list is shown once however many places link to it - the second
    /// appearance would carry the same items and the same checkboxes, and ticking one would leave the
    /// other looking untouched.
    /// </summary>
    private IReadOnlyList<ChecklistSection> BuildSections()
    {
        var taskList = _allTaskLists.FirstOrDefault(candidate => candidate.Id == Id);
        if (taskList is null)
        {
            return [];
        }

        var sections = new List<ChecklistSection>();
        AppendWithMembers(taskList, depth: 0, [], sections);
        return sections;
    }

    /// <summary>
    /// Adds one list and everything below it. <paramref name="alreadyShown"/> is what stops a list that
    /// links back to one of its own ancestors - or to itself - from unfolding forever.
    /// </summary>
    private void AppendWithMembers(
        TaskDto taskList, int depth, HashSet<Guid> alreadyShown, List<ChecklistSection> sections)
    {
        if (!alreadyShown.Add(taskList.Id))
        {
            return;
        }

        sections.Add(new ChecklistSection(taskList, IsMember: depth > 0, depth));
        if (!taskList.IsGroup)
        {
            return;
        }

        foreach (var memberId in taskList.Items.Select(item => item.LinkedTaskListId).OfType<Guid>())
        {
            if (_allTaskLists.FirstOrDefault(candidate => candidate.Id == memberId) is { } member)
            {
                AppendWithMembers(member, depth + 1, alreadyShown, sections);
            }
        }
    }

    /// <summary>
    /// A linked item's completion mirrors the list it points at rather than being set by hand (see
    /// LinkedTaskCompletionResolver), and a read-only share grants no writes at all - both render as a
    /// checkbox that can be seen but not moved.
    /// </summary>
    private static bool IsItemLocked(ChecklistSection section, TaskItemDto item)
        => item.LinkedTaskListId is not null || section.TaskList.AccessLevel != nameof(ShareAccessLevel.CanEdit);

    private string LinkedTaskListTitle(Guid linkedTaskListId)
        => _allTaskLists.FirstOrDefault(candidate => candidate.Id == linkedTaskListId)?.Title ?? T["another list"];

    private static string CompletionSummary(TaskDto taskList)
        => $"{taskList.Items.Count(item => item.IsCompleted)}/{taskList.Items.Count}";

    /// <summary>
    /// Saves the whole list back with just this item's completion changed - the update endpoint replaces
    /// the list wholesale, so everything else has to be sent along unchanged. Items are matched by
    /// position rather than id because a save regenerates item ids (see TaskEndpoints.ToDomainItems).
    /// </summary>
    private async Task ToggleItemAsync(TaskDto taskList, TaskItemDto item, bool isCompleted)
    {
        _errorMessage = null;
        var toggledIndex = taskList.Items.ToList().IndexOf(item);
        var items = taskList.Items
            .Select((existingItem, index) => new TaskItemRequest(
                existingItem.Description,
                existingItem.Id,
                existingItem.DueDateUtc,
                index == toggledIndex ? isCompleted : existingItem.IsCompleted,
                existingItem.LinkedTaskListId,
                existingItem.OverdueNotificationChannel,
                existingItem.RemindDaily,
                existingItem.DailyReminderNotificationChannel,
                existingItem.DailyReminderTimeOfDay))
            .ToList();

        try
        {
            var outcome = await TasksApiClient.UpdateTaskListAsync(
                taskList.Id, new UpdateTaskRequest(taskList.Title, items, taskList.IsGroup));
            if (outcome.Kind == EditOutcomeKind.Locked)
            {
                _errorMessage = T.Format("{0} is currently editing \"{1}\" - try again in a moment.", outcome.LockedByUserName, taskList.Title);
            }
            else if (outcome.Kind == EditOutcomeKind.NotFound)
            {
                _errorMessage = T.Format("\"{0}\" is no longer available to you.", taskList.Title);
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to toggle an item on task list {TaskListId}", taskList.Id);
            _errorMessage = T["Couldn't save that change. Try again."];
        }

        // Reloads even after a failure, so a checkbox that didn't save snaps back to what the server
        // actually holds - and after a success, so a group's linked items pick up their new completion.
        await LoadAsync();
    }

    private void GoToDeepEditor() => NavigationManager.NavigateTo($"/tasks/{Id}");

    private void GoToTaskLists() => NavigationManager.NavigateTo("/tasks");

    /// <summary>One list rendered in this view - the list being viewed, or one of a group list's members.</summary>
    /// <param name="Depth">How far below the list being viewed this one sits - 0 for that list itself.</param>
    private sealed record ChecklistSection(TaskDto TaskList, bool IsMember, int Depth);

    /// <summary>One item in the flattened view, with the list it came from - shown beside it, and saved against.</summary>
    private sealed record FlatChecklistEntry(ChecklistSection Section, TaskItemDto Item);

    private async Task ToggleViewAsync()
    {
        _view = _view == ChecklistView.Flat ? ChecklistView.Tree : ChecklistView.Flat;
        Logger.LogInformation("User switched the checklist to the {View} view", _view);
        await Task.CompletedTask;
    }

    /// <summary>Keeps the way this list is being read now as the way it opens next time - on this device.</summary>
    private async Task SaveViewAsync()
    {
        Logger.LogInformation("User saved the {View} view as the default for task list {TaskListId}", _view, Id);
        await ChecklistViewPreference.SaveAsync(Id, _view);
        _savedView = _view;
    }
}
