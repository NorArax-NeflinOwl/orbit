@using System.Globalization

@* The Options icon, in one place because it is drawn in two (the navigation rail and the avatar menu).

   Eight teeth rather than six: six spokes across a circle read as two overlapping triangles at icon
   size, which is not what a settings button should look like. They sit outside the ring instead of
   crossing it, which is what makes it a cog rather than a star. *@
<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 20 20"
     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true">
    <circle cx="10" cy="10" r="5.1" />
    <circle cx="10" cy="10" r="2" />
    @foreach (var tooth in ToothAngles)
    {
        <rect x="8.95" y="2.5" width="2.1" height="2.6" rx="0.7" fill="currentColor" stroke="none"
              transform="@Rotation(tooth)" />
    }
</svg>

@code {
    /// <summary>Width and height in pixels - the icon is square, and every caller wants both the same.</summary>
    [Parameter] public int Size { get; set; } = 18;

    private static readonly int[] ToothAngles = [0, 45, 90, 135, 180, 225, 270, 315];

    /// <summary>
    /// Invariant on purpose: this is an SVG attribute, not text somebody reads, and a Polish decimal
    /// comma here would turn the transform into something the browser cannot parse.
    /// </summary>
    private static string Rotation(int degrees)
        => string.Create(CultureInfo.InvariantCulture, $"rotate({degrees} 10 10)");
}
