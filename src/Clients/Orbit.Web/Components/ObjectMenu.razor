@using Orbit.Core.Abstractions
@* All X · Edit-or-View · Duplicate · the copies · Share · Archive · Delete, in that order - the shape six menus wrote out by hand as
   plain avatar-dropdown-item buttons inside an OverflowMenu. A page hands each slot the label its own
   rules already chose - whether it reads "Edit" or "View", whether Share or Delete belongs at all -
   nothing here decides that; a slot left null is left out rather than drawn disabled, the same rule
   PageHeader's Subtitle follows. *@
<OverflowMenu>
    @if (AllLabel is not null)
    {
        <button type="button" class="avatar-dropdown-item" @onclick="OnAll">@AllLabel</button>
    }
    @if (EditLabel is not null)
    {
        <button type="button" class="avatar-dropdown-item" @onclick="OnEdit">@EditLabel</button>
    }
    @if (DuplicateLabel is not null)
    {
        <button type="button" class="avatar-dropdown-item" @onclick="OnDuplicate">@DuplicateLabel</button>
    }
    @foreach (var choice in CopyChoices ?? [])
    {
        <button type="button" class="avatar-dropdown-item"
                @onclick="() => OnCopy.InvokeAsync(choice.What)">@choice.Label</button>
    }
    @if (ShareLabel is not null)
    {
        <button type="button" class="avatar-dropdown-item" @onclick="OnShare">@ShareLabel</button>
    }
    @if (ArchiveLabel is not null)
    {
        <button type="button" class="avatar-dropdown-item" @onclick="OnArchive">@ArchiveLabel</button>
    }
    @if (DeleteLabel is not null && (IsArchived || !DeleteNeedsTheArchive))
    {
        <button type="button" class="avatar-dropdown-item" disabled="@DeleteDisabled" @onclick="OnDelete">@DeleteLabel</button>
    }
</OverflowMenu>

@code {
    /// <summary>The way back to every object of this kind - "All notes", "All inventories", "Calendar".
    /// Left out on a card that is already sitting on that list.</summary>
    [Parameter] public string? AllLabel { get; set; }

    [Parameter] public EventCallback OnAll { get; set; }

    /// <summary>
    /// "Edit", or "View" where the reader may look at the form but not write in it. Left out - like
    /// every other slot here - by the screens that read one object, where Edit is a button of its own on
    /// the panel rather than a line in this menu (see EditorRail.OnEdit). A card still carries it here:
    /// a card has no panel to put it on.
    /// </summary>
    [Parameter] public string? EditLabel { get; set; }

    [Parameter] public EventCallback OnEdit { get; set; }

    /// <summary>
    /// "Duplicate" - a second one of this, with everything on it. After Edit and before Share, which is
    /// the order the three are reached for: change this one, make another like it, hand it to somebody.
    /// Left out where there is nothing to duplicate - something reached through a share is somebody
    /// else's, and copying it is not this reader's to do.
    /// </summary>
    [Parameter] public string? DuplicateLabel { get; set; }

    [Parameter] public EventCallback OnDuplicate { get; set; }

    /// <summary>
    /// Putting what this thing says on the clipboard, for taking it somewhere Orbit is not. Beside
    /// Duplicate because the two are the same wish pointed at different places - a copy inside Orbit,
    /// and a copy out of it - and each label says which ("Copy the text", not "Copy").
    ///
    /// A list rather than one entry, because a copy can be of the whole thing or of one state of it -
    /// see Orbit.Core.Abstractions.WhatToCopy. The page hands over the labels its own rules chose, as
    /// every other slot here works; none at all leaves the section out.
    /// </summary>
    [Parameter] public IReadOnlyList<CopyChoice>? CopyChoices { get; set; }

    [Parameter] public EventCallback<WhatToCopy> OnCopy { get; set; }

    /// <summary>One entry in the copy section: what it says, and which part of the thing it copies.</summary>
    public sealed record CopyChoice(string Label, WhatToCopy What);

    [Parameter] public string? ShareLabel { get; set; }

    [Parameter] public EventCallback OnShare { get; set; }

    /// <summary>
    /// "Archive", or "Put back" for something already put away - see
    /// Orbit.Core.Folders.BuiltInFolder.Archived. Immediately above Delete, and deliberately: it is the
    /// other way out of a list, and somebody reaching for Delete because they want a thing gone from in
    /// front of them should meet it on the way. The two say different things - one is reversible.
    ///
    /// Left out where it is not this reader's to do: something reached through a share is somebody
    /// else's, and putting it away would take it off the owner's pages.
    /// </summary>
    [Parameter] public string? ArchiveLabel { get; set; }

    [Parameter] public EventCallback OnArchive { get; set; }

    [Parameter] public string? DeleteLabel { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    [Parameter] public bool DeleteDisabled { get; set; }

    /// <summary>
    /// Whether this thing is already put away - see Orbit.Core.Folders.BuiltInFolder.Archived.
    ///
    /// This is the one rule the menu applies itself rather than taking from the page, and deliberately:
    /// **Delete is reached in the Archived folder and nowhere else** (asked for on 2026-09-18). Archiving
    /// exists to be the way out of a list, and a Delete sitting beside it on every card made the
    /// reversible answer the harder one to find - the two presses are worth it for the one action here
    /// that cannot be undone. A page that forgets to say whether its thing is archived therefore offers
    /// no Delete at all, which is the safe direction for a rule about deleting things.
    /// </summary>
    [Parameter] public bool IsArchived { get; set; }

    /// <summary>
    /// Whether the line above is a deletion at all. False where pressing it takes somebody else's thing
    /// off this reader's own list - the owner keeps it, nothing is destroyed, and there is nothing to
    /// archive first: something shared cannot be put away, so requiring the archive would make a share
    /// impossible to be rid of.
    /// </summary>
    [Parameter] public bool DeleteNeedsTheArchive { get; set; } = true;
}
