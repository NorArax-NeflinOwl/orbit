@implements IAsyncDisposable
@using Orbit.Web.Services
@inject GeocodingApiClient GeocodingApiClient
@inject IJSRuntime JSRuntime
@inject ILogger<LocationPickerOverlay> Logger
@inject Translations T

@* A map over the page, for saying where something happens by pointing at it. Over the page rather than
   inside the form: a map needs room, and an editor row is the last place with any. Nothing is written
   back until the pin is confirmed - a stray click on a map should not silently rewrite an address
   somebody typed. See mapPicker.js, which the calendar's event editor drives the same way. *@
<div class="map-overlay" @onclick="CancelAsync">
    <div class="map-overlay-panel" @onclick:stopPropagation="true">
        <div class="map-overlay-header">
            <h2>@T["Pick a place"]</h2>
            <button type="button" class="icon-btn" title="@(T["Close"])" aria-label="@(T["Close"])" @onclick="CancelAsync">✕</button>
        </div>

        @* Two ways to the same pin: name the place, or point at it. Naming it is the one that works
           when somebody knows the address but not where it is on a map, which is most of the time. *@
        <div class="map-overlay-search">
            <input class="map-overlay-search-box" @bind="_searchText" @bind:event="oninput"
                   @onkeydown="OnSearchKeyDownAsync" placeholder="@(T["Search for an address"])"
                   aria-label="@(T["Search for an address"])" />
            <button type="button" class="btn-secondary" disabled="@(_isSearching || _searchText.Trim().Length == 0)"
                    @onclick="SearchAsync">@T["Search"]</button>
        </div>

        @if (_isSearching)
        {
            <p class="map-overlay-hint">@T["Searching…"]</p>
        }
        else if (_matches.Count > 0)
        {
            @* Every match, not just the best one: street names repeat, and "Długa 4" is a real address
               in a dozen towns. Picking one is what moves the pin. *@
            <div class="map-overlay-matches">
                @foreach (var match in _matches)
                {
                    <button type="button" class="avatar-dropdown-item map-overlay-match"
                            @onclick="() => UsePlaceAsync(match)">@match.Name</button>
                }
            </div>
        }
        else if (_hasSearched)
        {
            <p class="map-overlay-hint">@T["Nothing found for that. Try fewer words, or point at it on the map."]</p>
        }

        @* Says what a press does, which is ask rather than move: the pin follows the answer. *@
        <p class="map-overlay-hint">@T["Click the map to pick a place - it asks before the pin moves."]</p>
        <div id="@MapElementId" class="map-overlay-map"></div>

        @if (_pickedAddress is not null)
        {
            <div class="map-overlay-confirm">
                <span class="map-overlay-address">@(_pickedAddress.Length > 0 ? _pickedAddress : T["That place has no address, so only the pin says where it is."])</span>
                <span class="map-overlay-question">@T["Use this place?"]</span>
                <button type="button" class="btn-primary" disabled="@_isLookingUpTheAddress" @onclick="ConfirmAsync">@T["Yes, use it"]</button>
                <button type="button" class="btn-secondary" @onclick="CancelAsync">@T["Cancel"]</button>
            </div>
        }
        else if (_isLookingUpTheAddress)
        {
            <p class="map-overlay-hint">@T["Looking that place up…"]</p>
        }
    </div>
</div>

@code {
    /// <summary>Where the thing being edited already is, so the map opens there rather than at nothing.</summary>
    [Parameter] public string Address { get; set; } = string.Empty;

    /// <summary>The confirmed pin - where it is, and what that place is called. Raised once, and only on a confirmation.</summary>
    [Parameter] public EventCallback<PickedPlace> OnPicked { get; set; }

    [Parameter] public EventCallback OnCancelled { get; set; }

    private const string MapElementId = "locationPickerMap";

    private IJSObjectReference? _mapPickerModule;
    private DotNetObjectReference<LocationPickerOverlay>? _selfReference;

    /// <summary>Where the pin is, in words - null until one is dropped, which is what asks the question.</summary>
    private string? _pickedAddress;

    /// <summary>
    /// Where the pin actually is. Carried alongside the words rather than thrown away once an address
    /// comes back: an address on its own cannot be put on a map, and dropping a pin is precisely what
    /// somebody does when they cannot name the street.
    /// </summary>
    private double _pickedLatitude;
    private double _pickedLongitude;

    private bool _isLookingUpTheAddress;

    /// <summary>What the reader is looking for, and what came back.</summary>
    private string _searchText = string.Empty;
    private bool _isSearching;
    private IReadOnlyList<FoundPlace> _matches = [];

    /// <summary>Whether a search has been run at all - what tells "nothing found" from "nothing asked".</summary>
    private bool _hasSearched;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Where the address already points, so somebody correcting a place starts beside it rather than
        // hunting for it again. An address nobody can find just opens the map at its default view.
        var startingPoint = await GeocodingApiClient.FindPlaceAsync(Address);
        try
        {
            _mapPickerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mapPicker.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _mapPickerModule.InvokeVoidAsync(
                "initializeMapPicker", MapElementId, _selfReference, startingPoint?.Latitude, startingPoint?.Longitude);
        }
        catch (JSException exception)
        {
            // Leaflet did not load. The address box behind this overlay still works.
            Logger.LogWarning(exception, "The map could not be opened");
            await CancelAsync();
        }
    }

    /// <summary>
    /// Called from mapPicker.js when the reader presses a point on the map. Nothing moves on the map:
    /// the press puts the place and the question below it, and the pin follows the answer - see the
    /// click handler there for why a press must not move anything by itself.
    /// </summary>
    [JSInvokable]
    public async Task OnMapLocationPicked(double latitude, double longitude)
    {
        _isLookingUpTheAddress = true;
        _pickedAddress = null;
        _pickedLatitude = latitude;
        _pickedLongitude = longitude;
        StateHasChanged();

        // Words as well as the position, not instead of it. The words are what the reader is shown and
        // asked to confirm; the position is what the calendar needs, and reverse geocoding it to a
        // street and then discarding where it was is how a confirmed pin used to arrive as nothing.
        _pickedAddress = await GeocodingApiClient.ReverseGeocodeAsync(latitude, longitude) ?? string.Empty;
        _isLookingUpTheAddress = false;
        StateHasChanged();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && _searchText.Trim().Length > 0)
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        _isSearching = true;
        _matches = [];
        try
        {
            _matches = await GeocodingApiClient.SearchPlacesAsync(_searchText);
        }
        finally
        {
            _isSearching = false;
            _hasSearched = true;
        }

        // One answer is not a choice, so it is taken as one: asking somebody to confirm the only match
        // twice - once as a row, once as the question below - is asking the same thing twice.
        if (_matches is [{ } only])
        {
            await UsePlaceAsync(only);
        }
    }

    /// <summary>
    /// Moves the pin to a place the reader named. The address comes from the search rather than from a
    /// second lookup: it is the name they picked by, and looking it up again could answer differently.
    /// </summary>
    private async Task UsePlaceAsync(FoundPlace place)
    {
        _matches = [];
        _pickedAddress = place.Name;
        _pickedLatitude = place.Latitude;
        _pickedLongitude = place.Longitude;
        if (_mapPickerModule is null)
        {
            return;
        }

        try
        {
            await _mapPickerModule.InvokeVoidAsync("moveMarker", MapElementId, place.Latitude, place.Longitude);
        }
        catch (JSException exception)
        {
            // The question below still stands: the address is what gets saved, not the pin.
            Logger.LogWarning(exception, "The pin could not be moved to the place that was found");
        }
    }

    private async Task ConfirmAsync()
    {
        if (_pickedAddress is not { } address)
        {
            return;
        }

        await DisposeMapAsync();
        await OnPicked.InvokeAsync(new PickedPlace(address, _pickedLatitude, _pickedLongitude));
    }

    private async Task CancelAsync()
    {
        await DisposeMapAsync();
        await OnCancelled.InvokeAsync();
    }

    public async ValueTask DisposeAsync() => await DisposeMapAsync();

    private async ValueTask DisposeMapAsync()
    {
        if (_mapPickerModule is null)
        {
            return;
        }

        var module = _mapPickerModule;
        _mapPickerModule = null;
        try
        {
            await module.InvokeVoidAsync("disposeMapPicker", MapElementId);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is already gone, which is one of the ways this overlay ends.
        }
        finally
        {
            _selfReference?.Dispose();
            _selfReference = null;
        }
    }
}
