@using Orbit.Web.Services
@inject Translations T

@* The editing screens' second panel: everything on the left is read and filled in and scrolls away,
   and this stays where it is. What lives here is what has to be reachable from anywhere in a form -
   Save, Cancel, and whatever else that page keeps beside them - because a form has no fixed height and
   buttons at its end sit wherever the writing happens to stop, which on a long note or a full shelf is
   off the screen.

   On a narrow screen there is no room for a column beside the form, so the same three become a bar
   along the foot of the window. Anything a page keeps up here besides them folds away behind the arrow
   at the bar's other end, since a bar tall enough to hold fields as well would be most of a phone.

   One component rather than the same panel written out on six pages: it is the same panel, and it has
   to sit and behave the same on all of them. A screen that is only read carries the same panel with no
   Save in it - what leaves the screen and what else it can do belong in the same place whether or not
   there is anything to write. *@
<div class="editor-rail @(_isOpen ? "editor-rail-open" : null)">
    @* Only where a page has something to keep beside the buttons. The arrow that opens it is drawn on
       narrow screens only, where the panel is a bar and the fields are folded into it. *@
    @if (Extras is not null)
    {
        <button type="button" class="icon-btn editor-rail-toggle"
                title="@(_isOpen ? T["Minimise"] : T["Expand"])" aria-label="@(_isOpen ? T["Minimise"] : T["Expand"])"
                aria-expanded="@_isOpen.ToString().ToLowerInvariant()" @onclick="() => _isOpen = !_isOpen">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="@(_isOpen ? "m6 12 4-4 4 4" : "m6 8 4 4 4-4")" />
            </svg>
        </button>
        <div class="editor-rail-extras">@Extras</div>
    }
    <div class="editor-rail-actions">
        @* Only where the page has something to write. A screen that is read rather than filled in - an
           appointment, a checklist that saves each tick as it is made - would otherwise carry a Save
           that does nothing, and a button that does nothing is worse than no button. *@
        @if (OnSave.HasDelegate)
        {
            <button type="button" class="icon-btn page-action page-action-primary"
                    title="@T["Save"]" aria-label="@T["Save"]" disabled="@SaveDisabled" @onclick="OnSave">
                <svg viewBox="0 0 20 20" width="30" height="30" aria-hidden="true" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10.5 4 4 8-9" /></svg>
            </button>
        }
        @* Between Save and the way out, because that is the order the three are reached in: write it,
           change what it is, leave. It used to live in the overflow menu on all five screens that read
           an object - one press to open the menu and another to find it, for the single thing somebody
           is most likely to want after reading. The menu keeps everything else. *@
        @if (OnEdit.HasDelegate)
        {
            <button type="button" class="icon-btn page-action" title="@EditLabel" aria-label="@EditLabel"
                    @onclick="OnEdit">
                <svg viewBox="0 0 20 20" width="30" height="30" aria-hidden="true" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 16v-3l9-9 3 3-9 9H4Z" /><path d="m11.5 5.5 3 3" />
                </svg>
            </button>
        }
        @* An arrow rather than a cross. A cross says "discard", and this button says no such thing on
           four of the six screens that carry it: they are read rather than filled in, and it simply
           leaves. Naming it Back rather than Cancel is the same correction - what it does is go back,
           and on a form that happens to mean the writing is not kept. *@
        <button type="button" class="icon-btn page-action" title="@T["Back"]" aria-label="@T["Back"]"
                @onclick="OnCancel">
            <svg viewBox="0 0 20 20" width="30" height="30" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 10H4" /><path d="m9 5-5 5 5 5" />
            </svg>
        </button>
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// What Save writes. Left unset by a screen that is read rather than filled in, and the button is
    /// then not drawn at all.
    /// </summary>
    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>Leaving the screen: back to the list on a page that is read, out of the form on one that is filled in.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Opening the form for whatever this screen is reading. Set by the five screens that read an
    /// object and have a form one press further in; left unset by the forms themselves, which are
    /// already there.
    /// </summary>
    [Parameter] public EventCallback OnEdit { get; set; }

    /// <summary>
    /// What that button is called - "Edit", or "View" where the reader may look at the form but not
    /// change anything, which is what a read-only share gets. The pages decide it, because whether this
    /// reader may write is their question rather than this panel's.
    /// </summary>
    [Parameter] public string EditLabel { get; set; } = "Edit";

    [Parameter] public bool SaveDisabled { get; set; }

    /// <summary>Anything else that belongs beside them - the task list's overflow menu, which sits at the same edge.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// What this page keeps in view whatever the form is scrolled to, above the buttons. Left out by
    /// most pages, which have nothing that has to be readable from everywhere.
    /// </summary>
    [Parameter] public RenderFragment? Extras { get; set; }

    /// <summary>
    /// Whether the folded-away half of the bar is open. Only means anything on a narrow screen, where
    /// the panel is a bar along the foot of the window - on a wide one the extras are simply there.
    /// </summary>
    private bool _isOpen;
}
