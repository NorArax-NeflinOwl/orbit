@using Microsoft.JSInterop
@using Orbit.Web.Services
@inject PublicShareApiClient PublicShareApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<ShareLinkButton> Logger
@inject Translations T

@* Used by every editor that can publish its item, so a link means the same thing and looks the same
   whether it points at a note, a task list, an event or a warehouse. *@
<div class="share-link">
    <div class="share-link-actions">
        <button type="button" class="btn-secondary share-link-button" disabled="@_isWorking" @onclick="CreateOrCopyAsync"
                title="@(_token is null ? "Create a link anyone can open" : "Copy the link")">
            <svg class="share-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="15" height="15"
                 fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6.5 9.5 9.5 6.5" />
                <path d="M7 4.5 8.5 3a2.8 2.8 0 0 1 4 4L11 8.5" />
                <path d="M9 11.5 7.5 13a2.8 2.8 0 0 1-4-4L5 7.5" />
            </svg>
            @(_token is null ? "Share link" : _copied ? "Copied" : "Copy link")
        </button>
        @if (_token is not null)
        {
            <button type="button" class="btn-secondary share-link-revoke" disabled="@_isWorking" @onclick="RevokeAsync">@T["Stop sharing"]</button>
        }
    </div>
    @if (_token is not null)
    {
        <p class="share-link-note">
            Anyone with this link can read it without an account. They can't change it, and they can save
            their own read-only copy by signing in.
        </p>
        @* Shown as well as copied: the clipboard is denied outright in some mobile browsers and
           webviews, and a link nobody can read is no link at all. *@
        <input type="text" class="share-link-url" readonly value="@LinkUrl" />
    }
    @if (_errorMessage is not null)
    {
        <p class="error">@_errorMessage</p>
    }
</div>

@code {
    /// <summary>One of "Note", "TaskList", "CalendarEvent", "Warehouse" - see Orbit.Core.Sharing.SharedItemType.</summary>
    [Parameter]
    [EditorRequired]
    public string ItemType { get; set; } = string.Empty;

    [Parameter]
    [EditorRequired]
    public Guid ItemId { get; set; }

    private string? _token;
    private bool _isWorking;
    private bool _copied;
    private string? _errorMessage;

    private string LinkUrl => $"{NavigationManager.BaseUri.TrimEnd('/')}/s/{_token}";

    /// <summary>
    /// Asks whether a link already exists rather than making one: an editor opening must not publish
    /// anything by itself - that only happens when someone presses the button.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _token = (await PublicShareApiClient.GetLinkAsync(ItemType, ItemId))?.Token;
        }
        catch (HttpRequestException exception)
        {
            // Not worth an error message: the button still works, it just doesn't know yet whether it
            // will be creating a link or copying one.
            Logger.LogWarning(exception, "Failed to read the existing share link for {ItemType} {ItemId}", ItemType, ItemId);
        }
    }

    private async Task CreateOrCopyAsync()
    {
        _isWorking = true;
        _errorMessage = null;
        try
        {
            _token ??= (await PublicShareApiClient.CreateLinkAsync(ItemType, ItemId))?.Token;
            if (_token is null)
            {
                _errorMessage = "This can't be shared with a link. Private items stay private.";
                return;
            }

            await CopyToClipboardAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to create a share link for {ItemType} {ItemId}", ItemType, ItemId);
            _errorMessage = "Couldn't create the link. Try again.";
        }
        finally
        {
            _isWorking = false;
        }
    }

    /// <summary>
    /// A denied clipboard permission (some mobile browsers, restricted webviews) throws rather than
    /// returning false - the link is on screen to copy by hand either way, so this says nothing about
    /// it, exactly as ClientExceptionLog does.
    /// </summary>
    private async Task CopyToClipboardAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", LinkUrl);
            _copied = true;
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Failed to copy the share link to the clipboard");
        }
    }

    private async Task RevokeAsync()
    {
        _isWorking = true;
        _errorMessage = null;
        try
        {
            await PublicShareApiClient.RevokeLinkAsync(ItemType, ItemId);
            _token = null;
            _copied = false;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to revoke the share link for {ItemType} {ItemId}", ItemType, ItemId);
            _errorMessage = "Couldn't stop sharing. Try again.";
        }
        finally
        {
            _isWorking = false;
        }
    }
}
