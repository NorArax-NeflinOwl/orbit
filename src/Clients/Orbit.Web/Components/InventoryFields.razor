@using Orbit.Contracts.Notifications
@using Orbit.Web.Services
@inject Translations T

@* What a shelf item is, drawn once: by the inventory editor, and by a task list's restock errand,
   which edits the same product from the other side. Two forms asking different things about one thing
   is how an errand came to be able to set fields the inventory could not, and the other way round.

   The name and the two amounts are optional here, and optional separately, because the three screens
   put them in different places: the inventory keeps them on the row, where a full shelf is read at a
   glance; an errand about a product already on a shelf has no row of its own to keep them on; and an
   entry describing a product that does not exist yet is its own name, so asking for one again would be
   asking the same question twice - see TaskEditor.razor. *@
@if (ShowsName)
{
    <label>@T["Item name"]<InputText @bind-Value="Model.Name" placeholder="@(T["Item name"])" /></label>
}
@if (ShowsAmounts)
{
    <label title="@(T["How much of it there is"])">@T["Amount"]
        <InputNumber TValue="decimal" @bind-Value="Model.Quantity" step="0.01" />
    </label>
    <label title="@(T["Restock once the amount drops below this"])">@T["Min"]
        <InputNumber TValue="decimal?" @bind-Value="Model.MinimumQuantity" step="0.01" />
    </label>
}
<label title="@(T["What this is counted in"])">@T["Unit"]
    <select class="editor-item-unit" @bind="Model.Unit" aria-label="@(T["Unit"])">
        @foreach (var option in InventoryUnitOption.All)
        {
            <option value="@option.Value" title="@T[option.Name]">@T[option.ShortName]</option>
        }
    </select>
</label>
@* Both offer what this reader has already filed shelf items under, listed under the box rather than
   left to be remembered - the same panel a task entry's categories get, and for the same reason: the
   twenty-first thing should go under one of the twenty words already in use. See UsedValueBrowser. *@
<label>@T["Product type"]
    <SuggestedTextField Value="@Model.ProductType" ValueChanged="value => Model.ProductType = value"
                        Known="KnownProductTypes" Placeholder="@(T["Product type"])"
                        AriaLabel="@(T["Product type"])" />
</label>
@* As many as apply, the same control a task entry's categories get - a thing on a shelf is "baking"
   and "dry goods" at once, and the single box this replaced asked somebody to pick one. See TagField. *@
<div class="editor-item-tags">
    <span class="editor-item-tags-label">@T["Categories"]</span>
    <TagField Values="Model.Categories" ValuesChanged="values => Model.Categories = [.. values]"
              Known="KnownCategories" Placeholder="@(T["Add a category"])" AriaLabel="@(T["Categories"])" />
</div>
@* How long it keeps rather than the day it stops keeping - see ExpiresInField. A date is still what
   gets stored; nobody stocking a shelf knows the 14th, they know "a fortnight". *@
<label>@T["Expires in"]
    <ExpiresInField Value="Model.ExpiryDate" ValueChanged="expiresOn => Model.ExpiryDate = expiresOn" />
</label>
<label>@T["Expiry notification"]
    <select @bind="Model.ExpiryNotificationChannel">
        @foreach (var option in NotificationChannelOption.All)
        {
            <option value="@option.Value" disabled="@option.IsDisabledBy(NotificationSettings)">@T[option.Label]</option>
        }
    </select>
</label>
@* Asked for every round, whatever the count says - see InventoryItem.BelongsOnTheRestockList. *@
<label class="field-checkbox" title="@(T["Always on the restock list, however much there is"])">
    <InputCheckbox @bind-Value="Model.IsCheckedRegularly" />@T["Check every round"]
</label>

@code {
    [Parameter, EditorRequired] public InventoryItemFormModel Model { get; set; } = new();

    /// <summary>Which channels this account can actually be reached on - one it cannot is offered greyed.</summary>
    [Parameter] public NotificationSettingsDto NotificationSettings { get; set; }
        = new(true, true, true, true, ShowExceptionDetails: false, BannerVisibleSeconds: 5, BannerMinimumGapSeconds: 5);

    /// <summary>
    /// Whether this screen needs the product's name drawn here. False where something above already
    /// says it - see the comment on the markup.
    /// </summary>
    [Parameter] public bool ShowsName { get; set; }

    /// <summary>Whether it needs how much there is and how little is too little. See the markup.</summary>
    [Parameter] public bool ShowsAmounts { get; set; }

    /// <summary>
    /// What this reader has already filed shelf items under, for the two boxes that offer it. Read by
    /// whoever owns the screen rather than here: this component is drawn once per item row, and asking
    /// for the same short list once per row would be a request storm on a full shelf.
    /// </summary>
    [Parameter] public IReadOnlyList<string> KnownProductTypes { get; set; } = [];

    [Parameter] public IReadOnlyList<string> KnownCategories { get; set; } = [];
}
