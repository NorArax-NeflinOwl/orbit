@using Orbit.Contracts.Users
@using Orbit.Web.Services
@inject UsersApiClient UsersApiClient
@inject AuthApiClient AuthApiClient
@inject OwnEncryptionKeyProvider OwnEncryptionKeyProvider
@inject ILogger<ChatPasswordGate> Logger

@* Stands between a signed-in user and chat when this browser has no usable encryption key. Three cases,
   deliberately kept in one place because they differ only in which secret unlocks the key:
     - a Google account that never set a password: it creates one here, because the chat key backup is
       encrypted with the password and there is nothing to encrypt it with otherwise;
     - a password account on a new browser: it types the password, which decrypts the existing backup;
     - anyone who forgot it: a reset code by email, after which chat starts fresh - see the warning below. *@
<div class="chat-key-gate">
    @if (_account is null)
    {
        <p>Loading…</p>
    }
    else if (_mode == GateMode.Reset)
    {
        <h2>Reset your password</h2>
        @if (!_account.IsEmailVerified)
        {
            <p>
                Resetting needs a confirmed email address, and yours isn't confirmed yet. Confirm it in
                <a href="/options">Options</a> first, then come back here.
            </p>
        }
        else
        {
            <p class="chat-key-gate-warning">
                Setting a new password starts your chat over: messages encrypted under the old one stay
                unreadable, because Orbit's servers never had the key to them.
            </p>
            @if (!_codeSent)
            {
                <p>We'll email a code to <strong>@_account.Email</strong>.</p>
                <div class="form-actions">
                    <button type="button" class="btn-primary" disabled="@_isBusy" @onclick="SendResetCodeAsync">Send code</button>
                    <button type="button" class="btn-secondary" @onclick="() => SetMode(GateMode.Default)">Back</button>
                </div>
            }
            else
            {
                <div class="field">
                    <label for="resetCodeInput">Code from the email</label>
                    <input id="resetCodeInput" inputmode="numeric" autocomplete="one-time-code" @bind="_code" />
                </div>
                <div class="field">
                    <label for="resetPasswordInput">New password</label>
                    <input type="password" id="resetPasswordInput" @bind="_password" />
                </div>
                <div class="field">
                    <label for="resetRepeatInput">Repeat new password</label>
                    <input type="password" id="resetRepeatInput" @bind="_repeatPassword" />
                </div>
                <div class="form-actions">
                    <button type="button" class="btn-primary" disabled="@_isBusy" @onclick="ResetPasswordAsync">Set password</button>
                    <button type="button" class="btn-secondary" @onclick="() => SetMode(GateMode.Default)">Back</button>
                </div>
            }
        }
    }
    else if (!_account.HasPassword)
    {
        <h2>Set a password to use chat</h2>
        <p>
            Chat is end-to-end encrypted, and your key is protected with a password. Your account signs in
            with Google and doesn't have one yet, so pick one now - it's also what lets you read your
            messages on another device.
        </p>
        <p class="chat-key-gate-warning">Nobody can recover it for you: forget it and your chat history becomes unreadable.</p>
        <div class="field">
            <label for="newChatPasswordInput">Password</label>
            <input type="password" id="newChatPasswordInput" @bind="_password" />
        </div>
        <div class="field">
            <label for="repeatChatPasswordInput">Repeat password</label>
            <input type="password" id="repeatChatPasswordInput" @bind="_repeatPassword" />
        </div>
        <div class="form-actions">
            <button type="button" class="btn-primary" disabled="@_isBusy" @onclick="CreatePasswordAsync">Set password</button>
        </div>
    }
    else
    {
        <h2>Unlock chat</h2>
        <p>
            This browser doesn't have a copy of your encryption key yet. Enter your password to restore it
            from your encrypted backup - it never leaves this browser.
        </p>
        <div class="field">
            <label for="unlockPasswordInput">Password</label>
            <input type="password" id="unlockPasswordInput" @bind="_password" />
        </div>
        <div class="form-actions">
            <button type="button" class="btn-primary" disabled="@_isBusy" @onclick="UnlockAsync">Unlock</button>
            <button type="button" class="btn-secondary" @onclick="() => SetMode(GateMode.Reset)">I forgot my password</button>
        </div>
    }

    @if (_message is not null)
    {
        <p class="error">@_message</p>
    }
</div>

@code {
    /// <summary>Raised once this browser holds a usable key, so the chat page can carry on loading.</summary>
    [Parameter]
    public EventCallback OnUnlocked { get; set; }

    private enum GateMode { Default, Reset }

    private AccountDto? _account;
    private GateMode _mode = GateMode.Default;
    private string _password = string.Empty;
    private string _repeatPassword = string.Empty;
    private string _code = string.Empty;
    private bool _codeSent;
    private bool _isBusy;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _account = await UsersApiClient.GetAccountAsync();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load the account for the chat key gate");
            _message = "Couldn't load your account. Reload the page and try again.";
        }
    }

    private void SetMode(GateMode mode)
    {
        _mode = mode;
        _message = null;
        _codeSent = false;
        _password = string.Empty;
        _repeatPassword = string.Empty;
        _code = string.Empty;
    }

    /// <summary>The Google-account case: no current password to prove, so this only sets one and unlocks.</summary>
    private async Task CreatePasswordAsync()
    {
        if (!PasswordsMatch())
        {
            return;
        }

        await RunAsync(async () =>
        {
            if (!await UsersApiClient.SetPasswordAsync(_password))
            {
                _message = "This account already has a password - enter it instead.";
                _account = await UsersApiClient.GetAccountAsync();
                return;
            }

            await UnlockWithCurrentPasswordAsync();
        });
    }

    private async Task UnlockAsync() => await RunAsync(UnlockWithCurrentPasswordAsync);

    private async Task SendResetCodeAsync()
        => await RunAsync(async () =>
        {
            await AuthApiClient.RequestPasswordResetAsync(_account!.Email);
            _codeSent = true;
            _message = null;
        });

    private async Task ResetPasswordAsync()
    {
        if (!PasswordsMatch())
        {
            return;
        }

        await RunAsync(async () =>
        {
            if (!await AuthApiClient.ResetPasswordAsync(_account!.Email, _code, _password))
            {
                _message = "That code isn't valid any more. Request a new one.";
                return;
            }

            await UnlockWithCurrentPasswordAsync();
        });
    }

    /// <summary>
    /// Restores the backup when the password can open it, and generates a fresh key pair when it can't -
    /// which is exactly what happens after a reset, and why the reset path warns about losing history.
    /// </summary>
    private async Task UnlockWithCurrentPasswordAsync()
    {
        await OwnEncryptionKeyProvider.UnlockOrCreateAsync(_password);
        await OnUnlocked.InvokeAsync();
    }

    private bool PasswordsMatch()
    {
        if (_password.Length == 0)
        {
            _message = "Enter a password.";
            return false;
        }

        if (_password != _repeatPassword)
        {
            _message = "The two passwords don't match.";
            return false;
        }

        return true;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _isBusy = true;
        _message = null;
        try
        {
            await action();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "A chat key gate step failed");
            _message = "Something went wrong. Try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
