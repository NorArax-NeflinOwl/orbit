@using Orbit.Contracts.Notes
@using Orbit.Web.Services
@inject Translations T

@* What a list or an inventory is called, and what it is for, written as one thing.

   One field, not two boxes: the description is the rest of the sentence the title starts, and asking
   for it separately made it look like a setting somebody had to decide about - then made them tab out
   of one box and into another to write a sentence they were already writing. So the first line is the
   title, drawn as a heading, and everything under it is the description in ordinary text.

   The note editor is that surface, and this is the same one - see ChecklistTextEditor and
   .note-editor-titled. Reused rather than written again, because "one field whose first line is its
   title" is a thing this app has already solved, and two of them would drift. The checklist half of it
   never comes up here: nothing offers the button that makes a checkbox line. *@
<div class="titled-description">
    <ChecklistTextEditor CssClass="note-editor-content note-editor-titled titled-description-editor"
                         Lines="Lines" LinesChanged="OnLinesChangedAsync" IsReadOnly="IsReadOnly"
                         aria-label="@TitleLabel" />
    @Suggestions
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> TitleChanged { get; set; }

    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> DescriptionChanged { get; set; }

    /// <summary>
    /// What the field is called on this page - "Title" for a list, "Name" for an inventory. Read out
    /// rather than shown: the first line is a heading, and a heading with a label above it is two
    /// headings.
    /// </summary>
    [Parameter, EditorRequired] public string TitleLabel { get; set; } = string.Empty;

    /// <summary>
    /// Whether the name and description may be changed. The fieldset a page wraps this in cannot say so
    /// on its own - see ChecklistTextEditor, which is the surface underneath.
    /// </summary>
    [Parameter] public bool IsReadOnly { get; set; }

    /// <summary>For a page that puts something under the field - the name suggestions, so far.</summary>
    [Parameter] public RenderFragment? Suggestions { get; set; }

    /// <summary>
    /// The two strings as one surface reads them: the title is the first line, and the description is
    /// every line after it. Built on each render, and read once - the editor draws itself from this when
    /// it first appears and owns its own content from then on, which is why the page it sits on has to
    /// have loaded what it is editing before it renders the form at all.
    /// </summary>
    private IReadOnlyList<NoteContentLineDto> Lines =>
    [
        new(Title, IsChecklistItem: false, IsChecked: false),
        .. DescriptionLines.Select(line => new NoteContentLineDto(line, IsChecklistItem: false, IsChecked: false))
    ];

    /// <summary>
    /// An empty description is no lines rather than one empty line: a field holding only a title should
    /// open with the caret on that title, not on a blank line under it.
    /// </summary>
    private IEnumerable<string> DescriptionLines
        => Description.Length == 0 ? [] : Description.Split('\n');

    /// <summary>
    /// Splits what was written back into the two the pages store. The first line is the title however
    /// much is under it, and an editor emptied altogether still reports both - a title nobody has typed
    /// yet is an empty title, not a missing one.
    /// </summary>
    private async Task OnLinesChangedAsync(IReadOnlyList<NoteContentLineDto> lines)
    {
        var title = lines.Count > 0 ? lines[0].Text : string.Empty;
        var description = string.Join('\n', lines.Skip(1).Select(line => line.Text));

        if (title != Title)
        {
            Title = title;
            await TitleChanged.InvokeAsync(title);
        }

        if (description != Description)
        {
            Description = description;
            await DescriptionChanged.InvokeAsync(description);
        }
    }
}
