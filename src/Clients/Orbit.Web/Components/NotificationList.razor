@using System.Globalization
@using Orbit.Contracts.Notifications
@using Orbit.Web.Services
@inject ClientExceptionLog ClientExceptionLog
@inject Translations T

@* Shared by MainLayout's desktop popup and the mobile Notifications page, so the two can never drift. *@
@if (IsLoading)
{
    <Loading IsInline="true" />
}
else if (Entries.Count == 0 && ExceptionEntries.Count == 0)
{
    <p class="notifications-panel-empty">@T["Nothing yet."]</p>
}
else
{
    <ul class="notifications-panel-list">
        @foreach (var entry in Entries)
        {
            <li class="notifications-panel-item @(entry.Url is null ? "" : "notifications-panel-item-link") @(ShowsDismissed && entry.IsDismissed ? "notifications-panel-item-dismissed" : "")"
                role="@(entry.Url is null ? null : "link")"
                @onclick="() => OnEntrySelected.InvokeAsync(entry)">
                <span class="notifications-panel-item-title">
                    @Say(entry.Title, entry.TitleArguments)
                    @if (ShowsDismissed && entry.IsDismissed)
                    {
                        <span class="notifications-panel-item-tag">@T["Cleared"]</span>
                    }
                </span>
                <span class="notifications-panel-item-body">@Say(entry.Body, entry.BodyArguments)</span>
                <span class="notifications-panel-item-time">@FormatEntryTime(entry.CreatedAtUtc)</span>
            </li>
        }
        @foreach (var exceptionEntry in ExceptionEntries)
        {
            <li class="notifications-panel-item notifications-panel-item-exception">
                <span class="notifications-panel-item-title">@T["Frontend error"]</span>
                <span class="notifications-panel-item-body">@exceptionEntry.Message</span>
                <span class="notifications-panel-item-time">@FormatEntryTime(exceptionEntry.TimestampUtc)</span>
                <button type="button" class="btn-secondary" @onclick="() => ClientExceptionLog.CopyToClipboardAsync(exceptionEntry)">@T["Copy"]</button>
            </li>
        }
    </ul>
}

@code {
    /// <summary>
    /// A notification in the reader's language. The rule itself moved to NotificationWording, because
    /// it lived here and the banner along the top of the screen did not have it - so the same reminder
    /// read properly in this panel and slid past the top with its holes still in it.
    /// </summary>
    private string Say(string format, IReadOnlyList<string>? arguments)
        => NotificationWording.Say(T, format, arguments);

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public IReadOnlyList<NotificationEntryDto> Entries { get; set; } = [];

    /// <summary>Already gated by the caller on the server's environment flag and the user's own setting - see NotificationSettings.</summary>
    [Parameter]
    public IReadOnlyList<ClientLogEntry> ExceptionEntries { get; set; } = [];

    [Parameter]
    public EventCallback<NotificationEntryDto> OnEntrySelected { get; set; }

    /// <summary>
    /// Set by the notifications page, which lists entries already cleared out of the panel and marks
    /// them as such. The panel itself never receives one, so it has nothing to label.
    /// </summary>
    [Parameter]
    public bool ShowsDismissed { get; set; }

    private string FormatEntryTime(DateTimeOffset timestampUtc)
        => timestampUtc.ToLocalTime().ToString("MMM d, HH:mm", T.DisplayCulture);
}
