@using Orbit.Core.Folders
@using Orbit.Web.Services
@implements IDisposable
@inject FolderState Folders
@inject DashboardCardPreferences CardPreferences
@inject ILogger<FolderTabs> Logger
@inject Translations T

@* The row of tabs every page made of cards is read under - the dashboard, the notes and the task
   lists. Two or three of them are always there and have nothing stored behind them (see BuiltInFolder);
   the rest are whatever the reader made on this page. What the row offers is the page's own answer
   rather than one answer given three times - see FolderPages. *@
@* A row with nothing to choose between is not a row - see IsWorthDrawing. *@
@if (IsWorthDrawing)
{
<div class="folder-tabs" role="tablist" aria-label="@(T["Folders"])">
    @foreach (var tab in Tabs)
    {
        var isChosen = tab == Folders.ChosenOn(Page);
        @if (_folderBeingRenamed == tab.FolderId && tab.FolderId is not null)
        {
            <input class="folder-tab-name" @bind="_name" @bind:event="oninput"
                   @onkeydown="args => OnNamingKeyDownAsync(args)" @onblur="StopNaming"
                   aria-label="@(T["Folder name"])" @ref="_nameBox" />
        }
        else
        {
            <button type="button" role="tab" aria-selected="@(isChosen ? "true" : "false")"
                    class="folder-tab @(isChosen ? "on" : "")" @onclick="() => Choose(tab)">
                @NameOf(tab)
                @if (CountIn is not null)
                {
                    <span class="folder-tab-count">@CountIn(tab)</span>
                }
                @* Where the thing a notification is about actually is. Following one used to land on a
                   page narrowed to another folder, with nothing saying which tab held it - see
                   HasNewsIn. A dot rather than a count: the count is on the card itself, and this only
                   has to say "in here". *@
                @if (HasNewsIn?.Invoke(tab) == true)
                {
                    <span class="folder-tab-news" aria-label="@(T["Something new is in here"])"
                          title="@(T["Something new is in here"])"></span>
                }
            </button>
        }
    }

    @* Only where a folder made here would have something that could go in it. The dashboard shows
       notes and task lists at once and files neither, so it reads the other pages' tabs and offers no
       way to add to them - see FolderPages.MakesFoldersIn. *@
    @if (Page.MakesFoldersIn() is not null)
    {
        @if (_isNaming && _folderBeingRenamed is null)
        {
            <input class="folder-tab-name" placeholder="@(T["Folder name"])" @bind="_name" @bind:event="oninput"
                   @onkeydown="args => OnNamingKeyDownAsync(args)" @onblur="StopNaming"
                   aria-label="@(T["Folder name"])" @ref="_nameBox" />
        }
        else
        {
            <button type="button" class="folder-tab folder-tab-add" title="@(T["New folder"])"
                    aria-label="@(T["New folder"])" @onclick="StartNaming">
                <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
            </button>
        }

        @* Only about a folder somebody made: the built-in ones are not theirs to rename or throw away.
           Beside the row rather than on the tab itself, because a menu inside a button is neither a
           button nor a menu. On the page the folder belongs to, for the same reason as the plus above:
           the dashboard borrows these tabs and does not own them. *@
        @if (Folders.ChosenOn(Page).FolderId is { } chosenFolderId)
        {
            <OverflowMenu StaysOpen="true">
                <button type="button" class="avatar-dropdown-item" @onclick="() => StartRenaming(chosenFolderId)">
                    @T["Rename folder"]
                </button>
                @* A folder is made where the things in it are, and the dashboard borrows every one of
                   them - which is how a tab for recipes or receipts ends up between Public and Private
                   on the page somebody opens to see what is on their plate. Hiding it takes the tab off
                   the dashboard and nothing else: the folder is still here, with everything in it. Kept
                   on the device beside the cards it is put away with - see DashboardCardPreferences. *@
                <button type="button" class="avatar-dropdown-item"
                        @onclick="() => SetShownOnTheDashboardAsync(chosenFolderId, !CardPreferences.IsFolderShown(chosenFolderId))">
                    <span class="card-filter-mark">@(CardPreferences.IsFolderShown(chosenFolderId) ? "" : "✓")</span>
                    @T["Hide on the dashboard"]
                </button>
                @* Only an empty one, since 2026-09-20. Everything in Orbit is put away rather than
                   deleted, and a folder is one of the few things exempt from that - but only while
                   there is nothing in it to lose. It used to delete a full folder and put everything
                   back under Public, which is a press that quietly rearranges a page's worth of things
                   under a word that promised to remove one. Drawn and disabled rather than left out:
                   an entry that disappears teaches nobody why. *@
                <button type="button" class="avatar-dropdown-item" disabled="@(!IsEmpty(chosenFolderId))"
                        title="@(IsEmpty(chosenFolderId) ? null : T["Move what is in it somewhere else first."])"
                        @onclick="() => DeleteAsync(chosenFolderId)">
                    @T["Delete folder"]
                </button>
            </OverflowMenu>
        }
    }
</div>
}

@if (_isDeleting)
{
    @* Asked anyway, though only an empty folder reaches here: a tab is a thing somebody made and named,
       and losing one to a misread press is worth one question. *@
    <Dialog Title="@(T["Delete this folder?"])" OnClosed="() => _isDeleting = false">
        <ChildContent>
            <p>@T["There is nothing in it. The tab goes and nothing else changes."]</p>
        </ChildContent>
        <Footer>
            <button type="button" class="btn-secondary" @onclick="() => _isDeleting = false">@T["Cancel"]</button>
            <button type="button" class="btn-primary" @onclick="ConfirmDeleteAsync">@T["Delete folder"]</button>
        </Footer>
    </Dialog>
}

@code {
    /// <summary>
    /// The page this row is on. It decides which stored folders are tabs here, whether one can be made,
    /// and whether Finished is among the built-in ones - see FolderPages.
    /// </summary>
    [Parameter, EditorRequired] public FolderPage Page { get; set; }

    /// <summary>
    /// How many cards are under each tab, when the page has an answer - the notes and the task lists
    /// do, and the dashboard, which shows two kinds at once, does not. Null draws no counts at all
    /// rather than zeros, which would be a number that is not true.
    /// </summary>
    [Parameter] public Func<FolderKey, int>? CountIn { get; set; }

    /// <summary>
    /// Whether anything under a tab is something the reader has not seen yet - a share, a reminder.
    /// Null draws no marks, which is the right answer for a page whose cards carry none.
    ///
    /// It exists because following a notification is how somebody arrives here, and the page opens on
    /// whatever tab it was last left on: the thing they were sent to could be under any of them, with
    /// nothing saying which. Asked for on 2026-09-18.
    /// </summary>
    [Parameter] public Func<FolderKey, bool>? HasNewsIn { get; set; }

    /// <summary>
    /// Whether a tab has anything under it. Given, a tab that holds nothing is not drawn at all; null -
    /// which is every page but the dashboard - draws them whatever is in them.
    ///
    /// The difference is what the tabs are for. On the notes or the task lists, a folder is a place
    /// somebody files things into, so an empty one has to be reachable or nothing could ever be put
    /// there. The dashboard files nothing (FolderPages.MakesFoldersIn): it borrows the other pages'
    /// folders to narrow what it draws, and a tab that narrows the page to nothing is a tab worth
    /// nobody's press. Asked for on 2026-09-18.
    ///
    /// Asked of every tab including the built-in ones, and the answer must count what the reader has
    /// put away on this page as well - a folder is not empty because its card is hidden.
    /// </summary>
    [Parameter] public Func<FolderKey, bool>? HoldsAnything { get; set; }

    /// <summary>
    /// Whether anything at all is still filed under this folder - asked before it can be deleted, since
    /// 2026-09-20. A different question from <see cref="CountIn"/>, which counts what is under the
    /// *tab*: something put away is under Archived wherever it is filed, so a folder holding nothing
    /// but archived things counts zero and still holds them. A page that does not answer this is taken
    /// at its word that a folder can go, which is what every page did before the rule existed.
    /// </summary>
    [Parameter] public Func<Guid, bool>? StillHolds { get; set; }

    /// <summary>Whether this folder can be deleted at all - see the menu entry, and <see cref="StillHolds"/>.</summary>
    private bool IsEmpty(Guid folderId) => StillHolds is null || !StillHolds(folderId);

    /// <inheritdoc cref="FolderTabRow.IsWorthDrawing"/>
    private bool IsWorthDrawing => FolderTabRow.IsWorthDrawing(Page, Folders, CardPreferences, HoldsAnything);

    private bool _isNaming;
    private bool _isDeleting;
    private Guid? _folderBeingRenamed;
    private Guid? _folderToDelete;
    private string _name = string.Empty;
    private ElementReference? _nameBox;
    private bool _isWaitingToFocusTheNameBox;

    /// <inheritdoc cref="FolderTabRow.On"/>
    private IEnumerable<FolderKey> Tabs => FolderTabRow.On(Page, Folders, CardPreferences, HoldsAnything);

    private string NameOf(FolderKey tab) => Folders.NameOf(tab, builtIn => BuiltInFolderNames.Of(builtIn, T));

    private void Choose(FolderKey tab)
    {
        Logger.LogInformation(
            "User opened folder tab {Folder} on the {Page} page",
            tab.BuiltIn?.ToString() ?? tab.FolderId?.ToString(), Page);
        Folders.Choose(Page, tab);
    }

    private void StartNaming()
    {
        _folderBeingRenamed = null;
        _name = string.Empty;
        _isNaming = true;
        _isWaitingToFocusTheNameBox = true;
    }

    private void StartRenaming(Guid folderId)
    {
        _folderBeingRenamed = folderId;
        _name = Folders.Folders.FirstOrDefault(folder => folder.Id == folderId)?.Name ?? string.Empty;
        _isNaming = true;
        _isWaitingToFocusTheNameBox = true;
    }

    /// <summary>
    /// Enter makes or renames it, Escape leaves everything as it was. Losing the box without pressing
    /// either does the same as Escape - a name half typed and then clicked away from is not an answer.
    /// </summary>
    private async Task OnNamingKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            StopNaming();
            return;
        }

        if (args.Key != "Enter")
        {
            return;
        }

        var name = _name.Trim();
        if (name.Length == 0)
        {
            StopNaming();
            return;
        }

        if (_folderBeingRenamed is { } folderId)
        {
            Logger.LogInformation("User renamed folder {FolderId}", folderId);
            await Folders.RenameAsync(folderId, name);
        }
        else
        {
            Logger.LogInformation("User created a folder on the {Page} page", Page);
            await Folders.CreateAsync(Page, name);
        }

        StopNaming();
    }

    private void StopNaming()
    {
        _isNaming = false;
        _folderBeingRenamed = null;
        _name = string.Empty;
    }

    private void DeleteAsync(Guid folderId)
    {
        _folderToDelete = folderId;
        _isDeleting = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        _isDeleting = false;
        if (_folderToDelete is not { } folderId)
        {
            return;
        }

        Logger.LogInformation("User deleted folder {FolderId}", folderId);
        await Folders.DeleteAsync(Page, folderId);
        _folderToDelete = null;
    }

    /// <summary>
    /// Takes a folder off the dashboard's row of tabs, or puts it back. Read again on the dashboard
    /// itself, which stops drawing what is under a tab it no longer has.
    /// </summary>
    private async Task SetShownOnTheDashboardAsync(Guid folderId, bool isShown)
    {
        Logger.LogInformation(
            "User {Action} folder {FolderId} on the dashboard", isShown ? "showed" : "hid", folderId);
        await CardPreferences.SetFolderShownAsync(folderId, isShown);
    }

    protected override async Task OnInitializedAsync()
    {
        Folders.Changed += OnFoldersChanged;
        // The row asks what this device has put away, and the pages that carry this row are not all the
        // dashboard - so it is read here rather than relying on that page having been opened first.
        await CardPreferences.InitializeAsync();
        await Folders.EnsureLoadedAsync();
        LeaveATabThatIsNoLongerThere();
    }

    /// <summary>
    /// Falls back to Public where the tab that was open is a folder this row no longer draws - one
    /// hidden from the dashboard since, or deleted on another page. A page filtered to a tab nobody can
    /// see shows nothing and offers no way out of it.
    /// </summary>
    private void LeaveATabThatIsNoLongerThere()
    {
        var chosen = Folders.ChosenOn(Page);
        if (chosen.FolderId is not null && !Tabs.Contains(chosen))
        {
            Folders.Choose(Page, FolderKey.Default);
        }
    }

    /// <summary>A box that appears to be typed in and then has to be found and clicked is a box nobody uses.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isWaitingToFocusTheNameBox || _nameBox is not { } box)
        {
            return;
        }

        _isWaitingToFocusTheNameBox = false;
        await box.FocusAsync();
    }

    private void OnFoldersChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Folders.Changed -= OnFoldersChanged;
}
