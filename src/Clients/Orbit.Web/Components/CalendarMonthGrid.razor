@using Orbit.Contracts.Calendar
@using Orbit.Web.Services
@inject Translations T

<div class="calendar-month-grid @(IsCompact ? "calendar-month-grid-compact" : "")">
    <div class="calendar-month-grid-weekday-row">
        @foreach (var weekdayName in WeekdayNames)
        {
            <div class="calendar-month-grid-weekday">@weekdayName</div>
        }
    </div>
    @foreach (var week in Weeks)
    {
        <div class="calendar-month-grid-week">
            @foreach (var day in week.Days)
            {
                <div class="calendar-month-grid-day @DayCssClass(day)" @onclick="() => DaySelectedAsync(day.Date)">
                    <span class="calendar-month-grid-day-number">@day.Date.Day</span>

                    @if (IsCompact)
                    {
                        @if (day.Events.Count > 0 || day.DueTasks.Count > 0)
                        {
                            <div class="calendar-month-grid-day-dots">
                                @foreach (var calendarEvent in day.Events.Take(MaxCompactDots))
                                {
                                    <span class="calendar-month-grid-day-dot" style="background-color:@EventColor(calendarEvent);"></span>
                                }
                                @if (day.Events.Count > MaxCompactDots)
                                {
                                    <span class="calendar-month-grid-day-dot-overflow">+@(day.Events.Count - MaxCompactDots)</span>
                                }
                                @foreach (var dueTask in day.DueTasks.Take(MaxCompactDots))
                                {
                                    <span class="calendar-month-grid-day-dot calendar-month-grid-day-dot-task"></span>
                                }
                                @if (day.DueTasks.Count > MaxCompactDots)
                                {
                                    <span class="calendar-month-grid-day-dot-overflow">+@(day.DueTasks.Count - MaxCompactDots)</span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="calendar-month-grid-day-events">
                            @foreach (var calendarEvent in day.Events.Take(MaxVisibleEvents))
                            {
                                @* No time on a month cell. Seven of these across a screen leaves a chip
                                   about as wide as "00:00", so the clock was taking the room the name
                                   needed - and which day something is on is what a month is read for.
                                   The day view is where times are read. *@
                                @* A label, not a button. The cell is what opens - a month answers
                                   "which day", and the day view is where a particular entry is picked
                                   out. A button inside a clickable cell also gave two targets a
                                   keyboard had to tell apart for one thing. *@
                                <span class="calendar-event-chip @DoneClass(calendarEvent.Id)" title="@calendarEvent.Details.Title"
                                      style="border-left-color:@EventColor(calendarEvent);">
                                    <span class="calendar-event-chip-title">@RecurringPrefix(calendarEvent)@Shortened(calendarEvent.Details.Title)</span>
                                </span>
                            }
                            @if (day.Events.Count > MaxVisibleEvents)
                            {
                                <span class="calendar-month-grid-day-overflow">@T.Format("+{0} more", day.Events.Count - MaxVisibleEvents)</span>
                            }
                            @foreach (var dueTask in day.DueTasks.Take(MaxVisibleDueTasks))
                            {
                                <span class="calendar-task-chip @(dueTask.IsCompleted ? "calendar-chip-done" : "")"
                                      title="@dueTask.Label">
                                    @* What the entry says, not the list it is on. A task's label reads
                                       "Errands: buy milk", so two words of it would be the list's name
                                       and a colon - the part that fits least and tells least. The whole
                                       label is on the title above. *@
                                    <span class="calendar-event-chip-title">@Shortened(dueTask.Description)</span>
                                </span>
                            }
                            @if (day.DueTasks.Count > MaxVisibleDueTasks)
                            {
                                <span class="calendar-month-grid-day-overflow">@T.Format("+{0} more", day.DueTasks.Count - MaxVisibleDueTasks)</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private const int MaxVisibleEvents = 4;
    private const int MaxVisibleDueTasks = 4;
    private const int MaxCompactDots = 3;

    /// <summary>
    /// Day names taken from the reader's language rather than written out here - a Polish calendar
    /// headed Mo/Tu/We is the same half-translation as a Polish page dating itself in English. Starts
    /// at Monday because the grid does; ShortestDayNames is indexed by DayOfWeek, which starts at
    /// Sunday, and gives the two-letter form both languages use here.
    /// </summary>
    private IEnumerable<string> WeekdayNames
    {
        get
        {
            var shortestDayNames = T.DisplayCulture.DateTimeFormat.ShortestDayNames;
            for (var day = 0; day < 7; day++)
            {
                yield return shortestDayNames[(day + (int)DayOfWeek.Monday) % 7];
            }
        }
    }

    [Parameter, EditorRequired]
    public IReadOnlyList<MonthGridWeek> Weeks { get; set; } = [];

    /// <summary>
    /// The events whose entry on a task list has been ticked off. An event of its own has nothing to
    /// tick - only the entry that made it does - so the grid has to be told, and is told by the page
    /// that holds both (see Calendar.razor's TickedOffEventIds). Empty for a caller with no task lists
    /// in hand, which draws exactly what it drew before.
    /// </summary>
    [Parameter]
    public IReadOnlySet<Guid> TickedOffEventIds { get; set; } = new HashSet<Guid>();

    /// <summary>Whether this appointment reads as done - see TickedOffEventIds.</summary>
    private string DoneClass(Guid eventId) => TickedOffEventIds.Contains(eventId) ? "calendar-chip-done" : string.Empty;

    /// <summary>
    /// As much of a name as a month cell can hold: the first two words, and an ellipsis when there was
    /// more. Two because a cell is a seventh of the width and one word is often the least useful part
    /// of a name ("Ginekolog:" alone says less than "Ginekolog: wizyta"). The whole name is on the
    /// chip's title attribute, and the day view shows it in full.
    /// </summary>
    private static string Shortened(string title)
    {
        var words = title.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length <= 2 ? title : string.Join(' ', words.Take(2)) + "…";
    }

    /// <summary>Renders a dot per event instead of a full time/title chip - used for the 12-months-at-once year view.</summary>
    [Parameter]
    public bool IsCompact { get; set; }

    [Parameter]
    public EventCallback<DateOnly> OnDaySelected { get; set; }



    private static string DayCssClass(MonthGridDay day)
    {
        var classes = new List<string>();
        if (!day.IsInDisplayedMonth)
        {
            classes.Add("calendar-month-grid-day-outside");
        }

        if (day.Date == DateOnly.FromDateTime(DateTime.Today))
        {
            classes.Add("calendar-month-grid-day-today");
        }

        return string.Join(' ', classes);
    }

    private static string EventColor(CalendarEventDto calendarEvent)
        => string.IsNullOrWhiteSpace(calendarEvent.Details.Color) ? "#4a90d9" : calendarEvent.Details.Color;

    /// <summary>A small marker in front of a recurring event's title, distinguishing a generated occurrence from a one-off event.</summary>
    private static string RecurringPrefix(CalendarEventDto calendarEvent) => calendarEvent.Details.Recurrence is not null ? "↻ " : "";

    private Task DaySelectedAsync(DateOnly date) => OnDaySelected.InvokeAsync(date);
}
