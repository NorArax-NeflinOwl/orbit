@using Orbit.Web.Services
@inject Translations T

@* Save and Cancel at the head of the page rather than at the foot of the form. An editor's form has no
   fixed height, so buttons at its end sit wherever the writing happens to stop - which on a long note
   or a full shelf is off the screen. Icons, because two words beside the page's name would compete
   with it, and at the far edge because the thumb reaching for them is on the right.

   One component rather than the same pair written out on four pages: they are the same two actions and
   have to look and sit the same on all of them. *@
<div class="page-header-actions">
    <button type="button" class="icon-btn page-action page-action-primary"
            title="@T["Save"]" aria-label="@T["Save"]" disabled="@SaveDisabled" @onclick="OnSave">
        <svg viewBox="0 0 20 20" width="30" height="30" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10.5 4 4 8-9" /></svg>
    </button>
    <button type="button" class="icon-btn page-action" title="@T["Cancel"]" aria-label="@T["Cancel"]"
            @onclick="OnCancel">
        <svg viewBox="0 0 20 20" width="30" height="30" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m5 5 10 10M15 5 5 15" /></svg>
    </button>
    @ChildContent
</div>

@code {
    [Parameter] public EventCallback OnSave { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public bool SaveDisabled { get; set; }

    /// <summary>Anything else that belongs beside them - the task list's overflow menu, which sits at the same edge.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
