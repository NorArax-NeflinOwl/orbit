@using Orbit.Web.Services
@inject Translations T

@* One pin, used by every list that can pin something - notes, task lists, dashboard cards - so the
   control means the same thing and looks the same wherever a person meets it. The filled pin is the
   pinned state; the outlined one is the offer to pin. *@
<button type="button" class="icon-btn pin-button @(IsPinned ? "pin-button-pinned" : "")"
        title="@(IsPinned ? T["Unpin"] : T["Pin to top"])"
        aria-pressed="@IsPinned.ToString().ToLowerInvariant()"
        disabled="@IsBusy"
        @onclick="OnToggle" @onclick:stopPropagation="true">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"
         fill="@(IsPinned ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.5"
         stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.3 2.4 17.6 7.7l-2.1.6a3 3 0 0 0-1.5.9l-2.4 2.7 1 1a1 1 0 0 1-1.4 1.4L5.7 9.8a1 1 0 0 1 1.4-1.4l1 1 2.7-2.4a3 3 0 0 0 .9-1.5Z" />
        <path d="m7.4 12.6-4 4" fill="none" />
    </svg>
</button>

@code {
    [Parameter, EditorRequired] public bool IsPinned { get; set; }

    /// <summary>Raised with the state the caller should save - already flipped, so callers do not flip it again.</summary>
    [Parameter, EditorRequired] public EventCallback<bool> OnPinnedChanged { get; set; }

    /// <summary>Set while the page is saving something, so a pin cannot be clicked into a queue of pending writes.</summary>
    [Parameter] public bool IsBusy { get; set; }

    private Task OnToggle() => OnPinnedChanged.InvokeAsync(!IsPinned);
}
