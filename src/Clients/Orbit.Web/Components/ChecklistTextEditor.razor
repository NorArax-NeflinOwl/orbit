@* A single editing surface that looks and behaves like a plain multi-line textarea (free typing, Enter
   for a new line, Backspace merges lines, native cursor/selection) but lets some lines carry a real,
   clickable checkbox at their start - see wwwroot/js/checklistTextEditor.js for why this needs
   contenteditable + JS interop rather than a plain <textarea> (which can't embed an interactive child
   element in its text). Used by NoteEditor.razor for a note's Content. *@
@using System.Text.Json
@using Orbit.Contracts.Notes
@using Orbit.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject Translations T

@* A surface nobody may write to must not take writing. A disabled <fieldset> around this does nothing:
   it disables form controls, and a contenteditable div is not one - which is how a note held read-only,
   or one somebody else was editing, could be typed into with Save greyed out beside it. The tick boxes
   in it are real <input>s and are stopped by the stylesheet - see .note-editor-content-readonly. *@
<div @ref="_containerRef" class="@CssClass @(IsReadOnly ? "note-editor-content-readonly" : null)"
     contenteditable="@(IsReadOnly ? "false" : "true")" @attributes="AdditionalAttributes"></div>

@code {
    [Parameter]
    public IReadOnlyList<NoteContentLineDto> Lines { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<NoteContentLineDto>> LinesChanged { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Whether this surface may be written to. False by default: most of the places it appears are
    /// forms somebody opened to write in.
    /// </summary>
    [Parameter]
    public bool IsReadOnly { get; set; }

    /// <summary>
    /// Whether Tab indents the writing (Shift+Tab takes a level away) rather than moving to the next
    /// control. Only for a surface that is a page to write on - the note itself. False by default: the
    /// same surface is a form field elsewhere (see TitledDescription), and a form field that swallowed
    /// Tab would leave a keyboard with no way out of it.
    /// </summary>
    [Parameter]
    public bool TakesTab { get; set; }

    /// <summary>
    /// How many boxes the selection covers while a press on one of them would answer for all of them -
    /// two or more - and zero once it does not; see NoteSurfaceEdits.SelectedChecklistLines. For a page
    /// that says what that press will do.
    /// </summary>
    [Parameter]
    public EventCallback<int> SelectedTicksChanged { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChecklistTextEditor>? _dotNetRef;

    /// <summary>
    /// Undo and redo for this surface - see NoteSurfaceHistory for why the browser's own cannot be used.
    /// Every edit is recorded here: the ones made in C# as they are made, and the browser's own typing
    /// as it reports it (see AfterTyping).
    /// </summary>
    private readonly NoteSurfaceHistory _history = new(SurfaceState.CaretAt([SurfaceState.EmptyLine], new SurfacePoint(0, 0)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/checklistTextEditor.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        _history.Reset(SurfaceState.CaretAt(Lines, new SurfacePoint(0, 0)).Normalized());
        var initialLinesJson = JsonSerializer.Serialize(Lines, JsonOptions);
        // Each box's tooltip: how several of them are made to answer together, which nothing else on
        // the surface would suggest - see NoteSurfaceEdits.Cycle.
        var options = new
        {
            takesTab = TakesTab,
            tickHint = T["Shift+click to select several lines - ticking one selected box then ticks them all."]
        };
        await _module.InvokeVoidAsync("initialize", _containerRef, _dotNetRef, initialLinesJson, options);
    }

    /// <summary>
    /// Puts lines on the surface that did not come from typing in it - a suggested name taken for a
    /// task list's title, say. Asked for rather than worked out from a changed <see cref="Lines"/>,
    /// deliberately: this surface owns its content from the moment it appears, and a caller is the only
    /// one that knows whether a new value is something the reader just wrote or something set for them.
    /// Guessing that from the parameter is what quietly ate an empty line - see TitledDescription, which
    /// reports one line for a title with a blank description and is handed two back.
    ///
    /// Undo starts again from here: what was on the surface before is another note, or a value the
    /// page has just replaced, and Ctrl+Z reaching back into it would be undoing somebody else's edit.
    /// </summary>
    public async Task SetLinesAsync(IReadOnlyList<NoteContentLineDto> lines)
    {
        if (_module is null)
        {
            return;
        }

        Lines = lines;
        var placed = SurfaceState.CaretAt(lines, new SurfacePoint(int.MaxValue, int.MaxValue)).Normalized();
        _history.Reset(placed);
        await _module.InvokeVoidAsync("setLines", _containerRef, JsonSerializer.Serialize(lines, JsonOptions));
    }

    /// <summary>
    /// Makes one edit that changes the shape of the lines - see NoteSurfaceEdits - on the surface as the
    /// browser reports it, and answers what the surface should hold afterwards, caret included. Null
    /// means the edit is the browser's own to make, and it is let through. Undo and redo come here too,
    /// and answer the state they put back.
    ///
    /// Synchronous on purpose, and called with invokeMethod rather than invokeMethodAsync: a key has to
    /// be stopped or let through before its handler returns, which is only possible when the answer is
    /// back by then. Blazor WebAssembly allows a synchronous call from JS; nothing else hosts this.
    /// </summary>
    [JSInvokable]
    public string? Edit(string requestJson)
    {
        var request = JsonSerializer.Deserialize<SurfaceRequest>(requestJson, JsonOptions);
        if (request is null)
        {
            return null;
        }

        var after = request.Command switch
        {
            "undo" => _history.Undo(),
            "redo" => _history.Redo(),
            "typed" => AfterTyping(request),
            _ => Apply(request)
        };

        if (after is null)
        {
            return null;
        }

        Lines = after.Lines;
        return JsonSerializer.Serialize(after, JsonOptions);
    }

    /// <summary>
    /// The lines whose boxes a press would answer for together, for the surface to ring - see
    /// NoteSurfaceEdits.SelectedChecklistLines. Asked synchronously on every change of a selection that
    /// is more than a caret, so the rings follow a drag while it is being made.
    /// </summary>
    [JSInvokable]
    public int[] SelectedChecklistLines(string requestJson)
    {
        var request = JsonSerializer.Deserialize<SurfaceRequest>(requestJson, JsonOptions);
        return request is null ? [] : [.. NoteSurfaceEdits.SelectedChecklistLines(request.State())];
    }

    /// <summary>Told when the number of ringed boxes changes - see <see cref="SelectedTicksChanged"/>.</summary>
    [JSInvokable]
    public Task OnSelectedTicksChanged(int count) => SelectedTicksChanged.InvokeAsync(count);

    /// <summary>An edit C# makes, recorded as a step of the kind it is - see SurfaceEditKind.</summary>
    private SurfaceState? Apply(SurfaceRequest request)
    {
        var before = request.State();
        (SurfaceState? After, SurfaceEditKind Kind) edit = request.Command switch
        {
            "enter" => (NoteSurfaceEdits.Enter(before), SurfaceEditKind.Reshaping),
            "backspace" => (NoteSurfaceEdits.Backspace(before), SurfaceEditKind.Reshaping),
            "delete" => (NoteSurfaceEdits.Delete(before), SurfaceEditKind.Reshaping),
            "cut" => (NoteSurfaceEdits.DeleteSelection(before), SurfaceEditKind.Reshaping),
            "replace" => (NoteSurfaceEdits.Replace(before, request.Text ?? string.Empty, readsMarkers: false), SurfaceEditKind.Reshaping),
            "paste" => (NoteSurfaceEdits.Replace(before, request.Text ?? string.Empty, readsMarkers: true), SurfaceEditKind.Pasting),
            "indent" when TakesTab => (NoteSurfaceEdits.Indent(before), SurfaceEditKind.Reshaping),
            "outdent" when TakesTab => (NoteSurfaceEdits.Outdent(before), SurfaceEditKind.Reshaping),
            "tick" => (NoteSurfaceEdits.Cycle(before, request.Line ?? -1), SurfaceEditKind.Ticking),
            "checklistItem" => (NoteSurfaceEdits.StartChecklistItem(before), SurfaceEditKind.Reshaping),
            _ => (null, SurfaceEditKind.Reshaping)
        };

        if (edit.After is not null)
        {
            _history.Record(before, edit.After, edit.Kind, request.At);
        }

        return edit.After;
    }

    /// <summary>
    /// After the browser has put typing in - or taken some out - inside a line. It is recorded, joining
    /// the typing before it where NoteSurfaceHistory says it does; then the only thing to decide is
    /// whether it made a "[]" at the head of a line. That turn into a box is a step of its own, so the
    /// first Ctrl+Z after it gives back the brackets rather than the whole word. Not while an input
    /// method is still composing a character - the line is not what the reader means yet.
    /// </summary>
    private SurfaceState? AfterTyping(SurfaceRequest request)
    {
        var typed = request.State();
        var kind = request.InputType?.StartsWith("delete", StringComparison.Ordinal) == true
            ? SurfaceEditKind.Erasing
            : SurfaceEditKind.Typing;
        _history.Record(SurfaceBeforeTyping(request), typed, kind, request.At, request.Text);
        Lines = typed.Lines;

        if (request.Composing || request.InputType != "insertText")
        {
            return null;
        }

        var marked = NoteSurfaceEdits.ReadTypedMarker(typed);
        if (marked is null)
        {
            return null;
        }

        _history.Record(typed, marked, SurfaceEditKind.Reshaping, request.At);
        return marked;
    }

    /// <summary>
    /// The surface before the browser typed: the lines this history last knew - the browser has already
    /// changed its own - and the selection it had when the key went down, which is where undoing the
    /// typing puts the caret back.
    /// </summary>
    private SurfaceState SurfaceBeforeTyping(SurfaceRequest request)
    {
        var current = _history.Current;
        var focus = request.BeforeFocus ?? request.BeforeAnchor ?? current.Focus;
        return new SurfaceState(current.Lines, request.BeforeAnchor ?? focus, focus).Normalized();
    }

    /// <summary>
    /// What checklistTextEditor.js sends with every edit: the command, the lines and selection as they
    /// are on the surface (see its readSurface), when it happened (the browser's clock, which only goes
    /// forward - see NoteSurfaceHistory), and whatever that command needs: the text typed or pasted, the
    /// selection before typing, the line whose box was pressed.
    /// </summary>
    private sealed record SurfaceRequest(
        string Command,
        IReadOnlyList<NoteContentLineDto>? Lines,
        SurfacePoint? Anchor,
        SurfacePoint? Focus,
        SurfacePoint? BeforeAnchor,
        SurfacePoint? BeforeFocus,
        string? Text,
        string? InputType,
        bool Composing,
        int? Line,
        double At)
    {
        /// <summary>
        /// The surface this edit is made on. A selection outside the surface - the toolbar button has the
        /// focus - is read as the end of the last line, which is where a press there means.
        /// </summary>
        public SurfaceState State()
        {
            IReadOnlyList<NoteContentLineDto> lines = Lines is { Count: > 0 } ? Lines : [SurfaceState.EmptyLine];
            var focus = Focus ?? Anchor ?? new SurfacePoint(lines.Count - 1, lines[^1].Text.Length);
            return new SurfaceState(lines, Anchor ?? focus, focus).Normalized();
        }
    }

    /// <summary>Called from checklistTextEditor.js on every edit (typing, checkbox toggle, Enter/Backspace line changes).</summary>
    [JSInvokable]
    public async Task OnLinesChangedFromJs(string linesJson)
    {
        var lines = JsonSerializer.Deserialize<List<NoteContentLineDto>>(linesJson, JsonOptions) ?? [];
        Lines = lines;
        await LinesChanged.InvokeAsync(lines);
    }

    /// <summary>Ends the current line (if not empty) and starts a new checklist line - called by NoteEditor.razor's toolbar button.</summary>
    public async Task InsertChecklistItemAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("insertChecklistItem", _containerRef);
            // insertChecklistItem mutates the DOM directly (for immediate cursor placement) without
            // going through OnLinesChangedFromJs, so this pulls the resulting state back into Blazor
            // the same way a real edit would - otherwise Lines/LinesChanged would silently miss it.
            var linesJson = await _module.InvokeAsync<string>("getLinesAsJson", _containerRef);
            await OnLinesChangedFromJs(linesJson);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _containerRef);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone (page navigated away) - nothing left to clean up on the
                // JS side either.
            }

            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
}
