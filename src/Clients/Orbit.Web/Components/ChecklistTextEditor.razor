@* A single editing surface that looks and behaves like a plain multi-line textarea (free typing, Enter
   for a new line, Backspace merges lines, native cursor/selection) but lets some lines carry a real,
   clickable checkbox at their start - see wwwroot/js/checklistTextEditor.js for why this needs
   contenteditable + JS interop rather than a plain <textarea> (which can't embed an interactive child
   element in its text). Used by NoteEditor.razor for a note's Content. *@
@using System.Text.Json
@using Orbit.Contracts.Notes
@using Orbit.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@* A surface nobody may write to must not take writing. A disabled <fieldset> around this does nothing:
   it disables form controls, and a contenteditable div is not one - which is how a note held read-only,
   or one somebody else was editing, could be typed into with Save greyed out beside it. The tick boxes
   in it are real <input>s and are stopped by the stylesheet - see .note-editor-content-readonly. *@
<div @ref="_containerRef" class="@CssClass @(IsReadOnly ? "note-editor-content-readonly" : null)"
     contenteditable="@(IsReadOnly ? "false" : "true")" @attributes="AdditionalAttributes"></div>

@code {
    [Parameter]
    public IReadOnlyList<NoteContentLineDto> Lines { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<NoteContentLineDto>> LinesChanged { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Whether this surface may be written to. False by default: most of the places it appears are
    /// forms somebody opened to write in.
    /// </summary>
    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChecklistTextEditor>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/checklistTextEditor.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        var initialLinesJson = JsonSerializer.Serialize(Lines, JsonOptions);
        await _module.InvokeVoidAsync("initialize", _containerRef, _dotNetRef, initialLinesJson);
    }

    /// <summary>
    /// Puts lines on the surface that did not come from typing in it - a suggested name taken for a
    /// task list's title, say. Asked for rather than worked out from a changed <see cref="Lines"/>,
    /// deliberately: this surface owns its content from the moment it appears, and a caller is the only
    /// one that knows whether a new value is something the reader just wrote or something set for them.
    /// Guessing that from the parameter is what quietly ate an empty line - see TitledDescription, which
    /// reports one line for a title with a blank description and is handed two back.
    /// </summary>
    public async Task SetLinesAsync(IReadOnlyList<NoteContentLineDto> lines)
    {
        if (_module is null)
        {
            return;
        }

        Lines = lines;
        await _module.InvokeVoidAsync("setLines", _containerRef, JsonSerializer.Serialize(lines, JsonOptions));
    }

    /// <summary>
    /// Makes one edit that changes the shape of the lines - see NoteSurfaceEdits - on the surface as the
    /// browser reports it, and answers what the surface should hold afterwards, caret included. Null
    /// means the edit is the browser's own to make, and it is let through.
    ///
    /// Synchronous on purpose, and called with invokeMethod rather than invokeMethodAsync: a key has to
    /// be stopped or let through before its handler returns, which is only possible when the answer is
    /// back by then. Blazor WebAssembly allows a synchronous call from JS; nothing else hosts this.
    /// </summary>
    [JSInvokable]
    public string? Edit(string requestJson)
    {
        var request = JsonSerializer.Deserialize<SurfaceRequest>(requestJson, JsonOptions);
        if (request is null)
        {
            return null;
        }

        var before = request.State();
        var after = request.Command switch
        {
            "enter" => NoteSurfaceEdits.Enter(before),
            "backspace" => NoteSurfaceEdits.Backspace(before),
            "delete" => NoteSurfaceEdits.Delete(before),
            "cut" => NoteSurfaceEdits.DeleteSelection(before),
            "replace" => NoteSurfaceEdits.Replace(before, request.Text ?? string.Empty),
            "tick" => NoteSurfaceEdits.Cycle(before, request.Line ?? -1),
            "checklistItem" => NoteSurfaceEdits.StartChecklistItem(before),
            "typed" => AfterTyping(request, before),
            _ => null
        };

        if (after is null)
        {
            return null;
        }

        Lines = after.Lines;
        return JsonSerializer.Serialize(after, JsonOptions);
    }

    /// <summary>
    /// After the browser has put typing in: the only thing to decide is whether it made a "[]" at the
    /// head of a line. Not while an input method is still composing a character - the line is not what
    /// the reader means yet.
    /// </summary>
    private SurfaceState? AfterTyping(SurfaceRequest request, SurfaceState typed)
    {
        Lines = typed.Lines;
        return request.Composing || request.InputType != "insertText" ? null : NoteSurfaceEdits.ReadTypedMarker(typed);
    }

    /// <summary>
    /// What checklistTextEditor.js sends with every edit: the command, the lines and selection as they
    /// are on the surface (see its readSurface), and whatever that command needs - the text typed or
    /// pasted, the line whose box was pressed.
    /// </summary>
    private sealed record SurfaceRequest(
        string Command,
        IReadOnlyList<NoteContentLineDto>? Lines,
        SurfacePoint? Anchor,
        SurfacePoint? Focus,
        string? Text,
        string? InputType,
        bool Composing,
        int? Line)
    {
        /// <summary>
        /// The surface this edit is made on. A selection outside the surface - the toolbar button has the
        /// focus - is read as the end of the last line, which is where a press there means.
        /// </summary>
        public SurfaceState State()
        {
            IReadOnlyList<NoteContentLineDto> lines = Lines is { Count: > 0 } ? Lines : [SurfaceState.EmptyLine];
            var focus = Focus ?? Anchor ?? new SurfacePoint(lines.Count - 1, lines[^1].Text.Length);
            return new SurfaceState(lines, Anchor ?? focus, focus).Normalized();
        }
    }

    /// <summary>Called from checklistTextEditor.js on every edit (typing, checkbox toggle, Enter/Backspace line changes).</summary>
    [JSInvokable]
    public async Task OnLinesChangedFromJs(string linesJson)
    {
        var lines = JsonSerializer.Deserialize<List<NoteContentLineDto>>(linesJson, JsonOptions) ?? [];
        Lines = lines;
        await LinesChanged.InvokeAsync(lines);
    }

    /// <summary>Ends the current line (if not empty) and starts a new checklist line - called by NoteEditor.razor's toolbar button.</summary>
    public async Task InsertChecklistItemAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("insertChecklistItem", _containerRef);
            // insertChecklistItem mutates the DOM directly (for immediate cursor placement) without
            // going through OnLinesChangedFromJs, so this pulls the resulting state back into Blazor
            // the same way a real edit would - otherwise Lines/LinesChanged would silently miss it.
            var linesJson = await _module.InvokeAsync<string>("getLinesAsJson", _containerRef);
            await OnLinesChangedFromJs(linesJson);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _containerRef);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone (page navigated away) - nothing left to clean up on the
                // JS side either.
            }

            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
}
