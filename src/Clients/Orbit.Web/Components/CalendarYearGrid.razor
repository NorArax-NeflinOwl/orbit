@using System.Globalization
@using Orbit.Web.Services
@inject Translations T

<div class="calendar-year-grid">
    @foreach (var month in Months)
    {
        <div class="calendar-year-grid-month">
            <h3 class="calendar-year-grid-month-name">@MonthName(month.Month)</h3>
            <CalendarMonthGrid Weeks="month.Weeks" IsCompact="true" OnDaySelected="OnDaySelected"
                               TickedOffEventIds="TickedOffEventIds" />
        </div>
    }
</div>

@code {


    /// <summary>Passed straight to each month it draws - see CalendarMonthGrid.TickedOffEventIds.</summary>
    [Parameter]
    public IReadOnlySet<Guid> TickedOffEventIds { get; set; } = new HashSet<Guid>();

    [Parameter, EditorRequired]
    public IReadOnlyList<YearGridMonth> Months { get; set; } = [];

    [Parameter]
    public EventCallback<DateOnly> OnDaySelected { get; set; }

    private string MonthName(int month) => Capitalize(T.DisplayCulture.DateTimeFormat.GetMonthName(month));

    /// <summary>Polish writes month names lower-case; a grid of headings reads better with each capitalised, the same as the English ones already are.</summary>
    private string Capitalize(string text) => text.Length == 0 ? text : char.ToUpper(text[0], T.DisplayCulture) + text[1..];
}
