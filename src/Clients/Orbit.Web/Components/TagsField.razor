@using Orbit.Web.Services
@implements IDisposable
@inject TagColourBook TagColourBook
@inject Translations T

@* A note's or a task list's tags: the browser every short vocabulary is chosen in (ValueBrowser) - the
   words this account already uses, each with a tick and a colour well, and a box for one nothing carries
   yet. It replaced a box typed into word by word with a row of colour wells underneath: the two halves
   said one thing in two places, and the wells were about whatever the box happened to hold.

   The colour belongs to the tag for the whole account (see TagColourBook), so it is saved the moment it
   is picked rather than with the item: colouring "work" here colours it on every card, and cancelling
   the item's form is not a way of taking it back. That is said where it is chosen - inside the panel -
   because it is the one part of a private item's tags that is not sealed. *@
<div class="editor-item-tags">
    <span class="editor-item-tags-label">@T["Tags"]</span>
    <ValueBrowser Offers="@Offered" Chosen="Values" ChosenChanged="ValuesChanged"
                  OffersColours="true" CanAddNew="true" NewPlaceholder="@(T["Add a tag"])"
                  Placeholder="@(T["Add a tag"])" AriaLabel="@(T["Tags"])" IsReadOnly="IsReadOnly"
                  EmptyMessage="@(T["No tags yet - add one below."])">
        <Extra>
            <FieldHint>@T["A tag's colour is kept for your whole account, readable on the server - even for a tag only private notes and lists carry."]</FieldHint>
        </Extra>
    </ValueBrowser>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Values { get; set; } = [];

    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    /// <summary>Every tag the caller has already seen on this account's items. The coloured ones are added here.</summary>
    [Parameter] public IReadOnlyList<string> Known { get; set; } = [];

    [Parameter] public bool IsReadOnly { get; set; }

    /// <summary>
    /// What the browser offers: the tags the caller found on this account's items and the ones it has
    /// given a colour, in one alphabet. No counts - on a field being filled in, a number about how many
    /// other things carry the word is a number about something else.
    /// </summary>
    private IReadOnlyList<ValueBrowser.Offer> Offered
        => ValueBrowser.Words(Known.Concat(TagColourBook.ColouredTags)
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(tag => tag, StringComparer.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        TagColourBook.Changed += Redraw;
        await TagColourBook.LoadAsync();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => TagColourBook.Changed -= Redraw;
}
