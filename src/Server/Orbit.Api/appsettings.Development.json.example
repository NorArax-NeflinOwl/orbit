{
  "_comment": "Copy this file to appsettings.Development.json (already gitignored via '*.Development.json' - see .gitignore) and fill in real values. That file is only loaded when ASPNETCORE_ENVIRONMENT=Development, which is what the 'http'/'https' launch profiles (Properties/launchSettings.json) and VS Code's debugger set for `dotnet run`/F5. Never put real values here or in the tracked appsettings.json.",
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UserName": "your-account@example.com",
    "UseStartTls": true,
    "FromAddress": "your-account@example.com",
    "FromDisplayName": "Orbit"
  },
  "Vapid": {
    "PublicKeyBase64Url": "your-vapid-public-key",
    "PrivateKeyBase64Url": "your-vapid-private-key",
    "Subject": "mailto:you@example.com"
  },
  "Assistant": {
    "_comment": "The assistant's model. For the ollama container in docker-compose.yml use Endpoint 'http://localhost:11434/v1' when running Orbit.Api outside Docker (or 'http://ollama:11434/v1' from inside the compose network), a model already pulled with `docker exec orbit-ollama ollama pull llama3.2:3b`, and no ApiKey - Ollama authenticates nobody. For Azure AI Foundry, Endpoint and ApiKey come from the resource and Model is the deployment name. Leave empty to run without an assistant.",
    "Endpoint": "http://localhost:11434/v1",
    "ApiKey": "",
    "Model": "llama3.2:3b",
    "TimeoutSeconds": 120
  },
  "GoogleAuth": {
    "_comment": "OAuth client id for 'sign in with Google' (Google Cloud Console > Credentials > OAuth client ID, type 'Web application', with this app's origin authorized). Only the id - Orbit verifies browser-obtained ID tokens, so there is no client secret. Leave empty to hide the Google button entirely.",
    "ClientId": "",
    "_mobileComment": "The Orbit.Maui apps' own OAuth client ids (type 'iOS' and 'Android' in the same Google project). A token is accepted only if its audience is one of these three, so an app whose id is missing here cannot sign in. Leave empty until the mobile apps exist.",
    "IosClientId": "",
    "AndroidClientId": ""
  }
}
