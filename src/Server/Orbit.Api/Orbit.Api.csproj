<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orbit.Api</RootNamespace>
    <UserSecretsId>8371e0fb-2acd-4488-be9e-dff6bd269e72</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Design-time only: the EF Core Tools (`dotnet ef migrations add`, `dotnet ef database update`)
         require this on the startup project, not just on the project the DbContext lives in
         (Orbit.Data) - see the matching reference and comment there. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" />
    <!-- Sends calendar event reminder emails (see CalendarEventReminderBackgroundService) over real
         SMTP. Actively maintained, unlike the built-in System.Net.Mail.SmtpClient. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="5.0.1" />
    <!-- Sends push notifications (see VapidPushNotificationSender) via the Web Push protocol -
         implements the RFC 8291 message encryption and RFC 8292 VAPID authentication a raw HTTP POST
         would otherwise have to hand-roll. -->
    <PackageReference Include="WebPush" Version="1.0.12" />
    <!-- The assistant's model client (see AssistantChatClient). Microsoft.Extensions.AI is the
         abstraction - one IChatClient over both Ollama locally and Azure AI Foundry in production -
         and the .OpenAI package is the transport both of them speak. Semantic Kernel would solve
         orchestration problems Orbit does not have; see info/ai-assistant-plan.md. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Orbit.Core\Orbit.Core.csproj" />
    <ProjectReference Include="..\..\Shared\Orbit.Contracts\Orbit.Contracts.csproj" />
    <ProjectReference Include="..\Orbit.Data\Orbit.Data.csproj" />
    <ProjectReference Include="..\Orbit.GoogleIntegration\Orbit.GoogleIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Orbit.Api.Tests call the endpoint handlers in HealthEndpoints directly instead of only
         through HTTP, without making them part of Orbit.Api's public surface. -->
    <InternalsVisibleTo Include="Orbit.Api.Tests" />
  </ItemGroup>

</Project>
