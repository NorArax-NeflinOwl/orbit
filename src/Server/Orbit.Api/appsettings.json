{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Trace"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Orbit.Api",
    "Audience": "Orbit.Web",
    "ExpiryMinutes": 60
  },
  "HealthChecks": {
    "Database": {
      "Enabled": true
    },
    "DiskSpace": {
      "Enabled": true,
      "MinimumFreeBytes": 104857600
    },
    "ExternalServices": {
      "Enabled": true,
      "Services": []
    },
    "HostedServices": {
      "Enabled": true,
      "StaleAfterSeconds": 120
    }
  }
}
