{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  // No ConnectionStrings:Orbit entry here - it needs a real password (see docker-compose.yml's
  // POSTGRES_PASSWORD), which never belongs in a tracked file. `docker compose up` sets it via the
  // ConnectionStrings__Orbit environment variable; for `dotnet run` outside Docker against that same
  // container, `dotnet user-secrets set "ConnectionStrings:Orbit" "Host=localhost;Port=5432;
  // Database=orbit;Username=orbit;Password=<your .env's POSTGRES_PASSWORD>"` - see
  // OrbitDataServiceCollectionExtensions.cs's startup check for this exact message if it's missing.
  // Production overrides this entirely too, via a Container App secret - see info/azure-setup.md.
  "Jwt": {
    "Issuer": "Orbit.Api",
    "Audience": "Orbit.Web",
    "ExpiryMinutes": 15
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "UseStartTls": true,
    "FromAddress": "",
    "FromDisplayName": "Orbit"
  },
  // Which language model the assistant talks to (see AssistantSettings). Empty here on purpose: no
  // model is required to run Orbit, and the endpoint answers 503 until one is configured. Locally that
  // is the ollama container - Endpoint "http://ollama:11434/v1", Model e.g. "llama3.2:3b", no key. The
  // key for a hosted model is a secret and belongs in an environment variable, never here.
  "Assistant": {
    "Endpoint": "",
    "Model": "",
    "TimeoutSeconds": 120
  },
  "Vapid": {
    "PublicKeyBase64Url": "",
    "Subject": ""
  },
  // Version rules for the Orbit.Maui apps (see info/orbit-maui-plan.md's "Forced update"). Release
  // numbers and public store links, not secrets, so real values belong here rather than in an
  // environment variable. Left empty, every version is supported and the gate never fires - set
  // MinimumSupportedVersion only to retire builds the server genuinely can no longer support, since
  // it stops the app for whoever is running one.
  "MobileVersion": {
    "Ios": {
      "MinimumSupportedVersion": "",
      "LatestVersion": "",
      "UpdateUrl": ""
    },
    "Android": {
      "MinimumSupportedVersion": "",
      "LatestVersion": "",
      "UpdateUrl": ""
    }
  },
  // How long uploaded mobile diagnostic logs are kept (see DiagnosticLogSettings). Enforced on upload,
  // which is the only time entries appear and so the only time there is anything to sweep.
  "DiagnosticLogs": {
    "RetentionDays": 30
  },
  "HealthChecks": {
    "Database": {
      "Enabled": true
    },
    "DiskSpace": {
      "Enabled": true,
      "MinimumFreeBytes": 104857600
    },
    "ExternalServices": {
      "Enabled": true,
      "Services": []
    },
    "HostedServices": {
      "Enabled": true,
      "StaleAfterSeconds": 120
    }
  }
}
