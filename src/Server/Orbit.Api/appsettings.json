{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Relative to Orbit.Api's working directory (both Visual Studio's default and .vscode/launch.json
    // run with cwd = src/Server/Orbit.Api), so the SQLite file lands in the repo-root /data folder -
    // the same folder docker-compose.yml bind-mounts to /app/data - instead of next to the project
    // files. /data is gitignored; Program.cs creates it via migrations if it doesn't exist yet.
    "Orbit": "Data Source=../../../data/orbit.db"
  },
  "Jwt": {
    "Issuer": "Orbit.Api",
    "Audience": "Orbit.Web",
    "ExpiryMinutes": 15
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "UseStartTls": true,
    "FromAddress": "",
    "FromDisplayName": "Orbit"
  },
  "Vapid": {
    "PublicKeyBase64Url": "",
    "Subject": ""
  },
  "HealthChecks": {
    "Database": {
      "Enabled": true
    },
    "DiskSpace": {
      "Enabled": true,
      "MinimumFreeBytes": 104857600
    },
    "ExternalServices": {
      "Enabled": true,
      "Services": []
    },
    "HostedServices": {
      "Enabled": true,
      "StaleAfterSeconds": 120
    }
  }
}
