{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  // No ConnectionStrings:Orbit entry here - it needs a real password (see docker-compose.yml's
  // POSTGRES_PASSWORD), which never belongs in a tracked file. `docker compose up` sets it via the
  // ConnectionStrings__Orbit environment variable; for `dotnet run` outside Docker against that same
  // container, `dotnet user-secrets set "ConnectionStrings:Orbit" "Host=localhost;Port=5432;
  // Database=orbit;Username=orbit;Password=<your .env's POSTGRES_PASSWORD>"` - see
  // OrbitDataServiceCollectionExtensions.cs's startup check for this exact message if it's missing.
  // Production overrides this entirely too, via a Container App secret - see info/azure-setup.md.
  "Jwt": {
    "Issuer": "Orbit.Api",
    "Audience": "Orbit.Web",
    "ExpiryMinutes": 15
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "UseStartTls": true,
    "FromAddress": "",
    "FromDisplayName": "Orbit"
  },
  "Vapid": {
    "PublicKeyBase64Url": "",
    "Subject": ""
  },
  "HealthChecks": {
    "Database": {
      "Enabled": true
    },
    "DiskSpace": {
      "Enabled": true,
      "MinimumFreeBytes": 104857600
    },
    "ExternalServices": {
      "Enabled": true,
      "Services": []
    },
    "HostedServices": {
      "Enabled": true,
      "StaleAfterSeconds": 120
    }
  }
}
