{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Matches docker-compose.yml's "postgres" service, published on localhost:5432 for `dotnet run`
    // outside Docker to reach it too. Not a secret by itself (it's a local-only default password for a
    // container with no other network exposure) - production overrides this entirely via
    // ConnectionStrings__Orbit, see info/azure-setup.md.
    "Orbit": "Host=localhost;Port=5432;Database=orbit;Username=orbit;Password=orbit"
  },
  "Jwt": {
    "Issuer": "Orbit.Api",
    "Audience": "Orbit.Web",
    "ExpiryMinutes": 15
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "UseStartTls": true,
    "FromAddress": "",
    "FromDisplayName": "Orbit"
  },
  "Vapid": {
    "PublicKeyBase64Url": "",
    "Subject": ""
  },
  "HealthChecks": {
    "Database": {
      "Enabled": true
    },
    "DiskSpace": {
      "Enabled": true,
      "MinimumFreeBytes": 104857600
    },
    "ExternalServices": {
      "Enabled": true,
      "Services": []
    },
    "HostedServices": {
      "Enabled": true,
      "StaleAfterSeconds": 120
    }
  }
}
