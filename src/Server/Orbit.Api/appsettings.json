{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Trace"
    }
  },
  "AllowedHosts": "*",
  "HealthChecks": {
    "Database": {
      "Enabled": true
    },
    "DiskSpace": {
      "Enabled": true,
      "MinimumFreeBytes": 104857600
    },
    "ExternalServices": {
      "Enabled": true,
      "Services": []
    },
    "HostedServices": {
      "Enabled": true,
      "StaleAfterSeconds": 120
    }
  }
}
