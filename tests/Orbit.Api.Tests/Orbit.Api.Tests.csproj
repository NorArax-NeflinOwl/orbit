<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orbit.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Orbit.Api is a Microsoft.NET.Sdk.Web project; FrameworkReference doesn't flow across
         ProjectReference, so it has to be declared again here to use ASP.NET Core types (HttpContext,
         IResult, the health check abstractions) directly in tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- Test-only: DatabaseHealthCheckTests uses a plain SQLite file as a fast, no-infrastructure
         stand-in for "a reachable/unreachable database" - it's testing DatabaseHealthCheck's own
         wrapper logic (CanConnectAsync + the Enabled flag), not anything provider-specific, so it
         doesn't need to run against the same Postgres provider Orbit.Data uses in production. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Transitive override: EF Core 10.0.10 still pulls SQLitePCLRaw 2.1.11, which bundles a native
         SQLite build affected by CVE-2025-6965 (NU1903). 3.50.3 bundles a patched SQLite build. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Server\Orbit.Api\Orbit.Api.csproj" />
    <!-- The dictionary both clients read, so a test can check the server only writes sentences it
         knows how to say - see NotificationWordingTests. -->
    <ProjectReference Include="..\..\src\Shared\Orbit.Localization\Orbit.Localization.csproj" />
  </ItemGroup>

</Project>
