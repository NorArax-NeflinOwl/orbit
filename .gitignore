/.vs/
**/.vs/
/data/

# Ignore everything under .vscode except the files worth sharing across the team.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

_to_delete/

# Ephemeral Claude Code state; the project's own /.claude/CLAUDE.md instructions stay tracked.
/.claude/worktrees/
/.claude/settings.local.json

**/bin/
**/obj/

# Orbit.Api runtime artifact (Serilog file sink). Written beside the working directory the server was
# started from, which is the repository root when the built executable is run from there - see info/build.md.
/src/Server/Orbit.Api/logs/
/logs/

# Per-developer IDE settings; not shared across the team.
*.csproj.user

# Secrets and credentials - never commit these.
.env
.env.*
*.pem

# Compose reads this on top of docker-compose.yml automatically. It is where a machine says what is
# true only of itself - the folder its TLS certificate lives in, say - see info/instructions.md.
docker-compose.override.yml
*.key
*.p12
# APNs auth key, downloadable exactly once - Firebase holds it, but it lands on disk first.
*.p8
*.jks
*.tar.gz
secrets/
credentials/

# .env itself is gitignored above (it holds real secrets), but the placeholder template should be
# tracked so new clones know which variables to set.
!.env.example

*.DS_Store
*.Development.json

# Firebase config for the Android app. Not a private key, but it carries an API key and is
# deployment-specific, so it follows the same rule as GoogleAuth:ClientId - a placeholder is tracked
# (google-services.json.example) and the real file is not. Fetch it from the Firebase console, or copy
# it from secrets/ if you keep one there.
google-services.json
GoogleService-Info.plist

# The Google Maps key for the Android app, merged into the manifest at build time. Same rule again: a
# placeholder is tracked (AndroidManifestOverlay.xml.example) and the real file is not.
AndroidManifestOverlay.xml

# Deployment notes that name real accounts - see notes/permissions.local.md. Kept out of git because
# which account may do what is a deployment's own business, not the source's.
*.local.md

# Playwright, installed with `npm install --no-save` by CI and by anyone running
# ci/verify-browser-crypto.mjs locally. Nothing here is committed - there is no package.json.
node_modules/

# Test run artefacts (.trx and friends) - written by `dotnet test --logger trx`, never source.
TestResults/

# The web client serves the repository's LICENSE so the footer can link to it on this site rather than
# on GitHub. It is copied in at build time (see Orbit.Web.csproj) rather than committed twice - a second
# copy is a second thing to keep in step, and this one would go stale silently.
src/Clients/Orbit.Web/wwwroot/LICENSE.txt
